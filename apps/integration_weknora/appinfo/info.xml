<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>integration_weknora</id>
    <name>WeKnora Integration</name>
    <summary>WeKnora directory onboarding, source permissions, and processing status.</summary>
    <description>Connects Nextcloud to WeKnora workspaces, associates folders with existing or newly created knowledge bases, verifies current source permissions, and shows document and graph processing status in Files.</description>
    <version>0.8.9</version>
    <licence>Apache-2.0</licence>
    <author>WeKnora Integration</author>
    <namespace>IntegrationWeknora</namespace>
    <category>integration</category>
    <dependencies>
        <nextcloud min-version="34" max-version="34" />
    </dependencies>
    <settings>
        <admin>OCA\IntegrationWeknora\Settings\Admin</admin>
        <admin-section>OCA\IntegrationWeknora\Settings\AdminSection</admin-section>
    </settings>
    <background-jobs>
        <job>OCA\IntegrationWeknora\BackgroundJob\DirectoryPublicationJob</job>
        <job>OCA\IntegrationWeknora\BackgroundJob\DirectoryDiscoveryJob</job>
        <job>OCA\IntegrationWeknora\BackgroundJob\StageStatusJob</job>
        <job>OCA\IntegrationWeknora\BackgroundJob\OutboxRetentionJob</job>
        <job>OCA\IntegrationWeknora\BackgroundJob\EventDeliveryJob</job>
        <job>OCA\IntegrationWeknora\BackgroundJob\EventAppliedStatusJob</job>
        <job>OCA\IntegrationWeknora\BackgroundJob\EventHealthJob</job>
    </background-jobs>
    <commands>
        <command>OCA\IntegrationWeknora\Command\PollStageStatus</command>
        <command>OCA\IntegrationWeknora\Command\DiscoverDirectories</command>
        <command>OCA\IntegrationWeknora\Command\DeliverEvents</command>
        <command>OCA\IntegrationWeknora\Command\PollEventStatus</command>
        <command>OCA\IntegrationWeknora\Command\ExportRecoveryLedger</command>
        <command>OCA\IntegrationWeknora\Command\ReplayRecoveryLedger</command>
    </commands>
</info>
