<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>integration_weknora</id>
    <name>WeKnora Integration</name>
    <summary>Local WeKnora source API and publication controls.</summary>
    <description>Exposes configured Nextcloud folders to a WeKnora connector and lets administrators manage local bindings and withdrawal exclusions.</description>
    <version>0.4.0</version>
    <licence>Apache-2.0</licence>
    <author>WeKnora Integration</author>
    <namespace>IntegrationWeknora</namespace>
    <category>integration</category>
    <dependencies>
        <nextcloud min-version="34" max-version="34" />
    </dependencies>
    <settings>
        <admin>OCA\IntegrationWeknora\Settings\Admin</admin>
        <admin-section>OCA\IntegrationWeknora\Settings\AdminSection</admin-section>
    </settings>
</info>
