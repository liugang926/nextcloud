# Copy to .env and replace each CHANGE_ME value. scripts/dev-up.sh can generate
# a local .env automatically.
NEXTCLOUD_ADMIN_USER=devadmin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME
NEXTCLOUD_DB_PASSWORD=CHANGE_ME
WEKNORA_SERVICE_TOKEN=CHANGE_ME
NEXTCLOUD_HTTP_PORT=18082
# Keep disabled except while running isolated synthetic identity HTTP smokes.
WEKNORA_DEV_ALLOW_UNVERIFIED_IDENTITY=0
