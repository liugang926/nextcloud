+	t.Cleanup(func() { _ = sqlDB.Close() })
+	require.NoError(t, db.AutoMigrate(&types.Knowledge{}, &nextcloudSourceVersion{},
+		&types.DataSource{}, &NextcloudSourcePairing{}))
+	config, err := (&types.DataSourceConfig{Type: types.ConnectorTypeNextcloud,
