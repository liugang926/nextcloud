+type replayPublicationVerifier interface {
+	CheckMessagePublication(context.Context, *types.Message) error
+}
+
+func checkReplayPublication(
+	ctx context.Context, service interfaces.MessageService,
+	message *types.Message, events []interfaces.StreamEvent,
+) error {
+	verifier, ok := service.(replayPublicationVerifier)
+	if !ok || message == nil {
+		return nil
+	}
+	copy := *message
+	copy.KnowledgeReferences = append(types.References(nil), message.KnowledgeReferences...)
+	for _, event := range events {
+		if event.Type != types.ResponseTypeReferences {
+			continue
+		}
+		response := buildStreamResponse(event, message.RequestID)
+		copy.KnowledgeReferences = append(copy.KnowledgeReferences, response.KnowledgeReferences...)
+	}
+	if err := verifier.CheckMessagePublication(ctx, &copy); err != nil {
+		return err
+	}
+	// Keep references learned from earlier SSE events for every later poll.
+	// Otherwise a later source withdrawal would pass once a poll carried no
+	// new references and the persisted message had not yet been updated.
+	message.KnowledgeReferences = copy.KnowledgeReferences
+	return nil
+}
+
+func replayPublicationHTTPError(err error) error {
+	if stderrors.Is(err, access.ErrNextcloudPublicationUnavailable) {
+		return errors.NewServiceUnavailableError("Cannot verify current Nextcloud file access")
+	}
+	return errors.NewForbiddenError("Current Nextcloud file access is required")
+}
