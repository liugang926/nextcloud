+			} else if cursor == "c6" {
+				writeJSON(w, testChangesPage("c6", nil, false))
+			} else {
+				writeJSON(w, testChangesPage("c0", nil, false))
+			}
+		case apiPath + "/bindings/dev-published/manifest":
+			manifestCalls++
+			if manifestStatus != http.StatusOK {
+				http.Error(w, "unavailable", manifestStatus)
