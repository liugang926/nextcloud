+	require.NoError(t, db.Model(&types.Chunk{}).Where("id = ?", "chunk-old").Count(&chunks).Error)
+	require.NoError(t, db.Table("lite_embeddings").Where("knowledge_id = ? AND knowledge_base_id = ?", "old", "kb").Count(&embeddings).Error)
