+		t.Setenv("WEKNORA_NEXTCLOUD_ALLOWED_ORIGINS", allowed)
+		if _, err := parseConfig(source); err == nil {
+			t.Fatalf("origin %q matched different approval %q", attacker.URL, allowed)
