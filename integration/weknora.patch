+
+func TestFullReconcileIntervalIsBounded(t *testing.T) {
+	config := testConfig(t, "http://nextcloud")
+	for _, value := range []interface{}{299, 604801, "bad", 600.5} {
+		config.Settings["full_reconcile_interval_seconds"] = value
