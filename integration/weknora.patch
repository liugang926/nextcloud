+
+func TestDeleteHintIsNeverDeletionEvidence(t *testing.T) {
+	present := true
+	deleteHint := false
+	manifestCalls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
