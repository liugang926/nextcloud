+	for _, test := range []struct {
+		name       string
+		deleteFail bool
+		wantMarker string
+	}{
+		{name: "failed deletion retains checkpoint", deleteFail: true, wantMarker: "old"},
+		{name: "successful deletion advances checkpoint", wantMarker: "new"},
+	} {
