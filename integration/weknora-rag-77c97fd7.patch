+		VALUES ('missing-second', 'ds-synthetic', 'success', ?, ?)`, now.Add(4*time.Minute), now.Add(4*time.Minute)).Error)
+	require.NoError(t, repo.FinishDispatch(ctx, *second, "missing-second", now.Add(4*time.Minute)))
