+			ds := &types.DataSource{ID: "ds", TenantID: 1, KnowledgeBaseID: "kb",
+				Type: types.ConnectorTypeNextcloud, Status: types.DataSourceStatusActive,
+				LastSyncCursor: oldCursor}
