+				}}, false))
+			} else {
+				cursor := r.URL.Query().Get("cursor")
+				if cursor == "" {
+					cursor = "c0"
+				}
+				writeJSON(w, testChangesPage(cursor, nil, false))
+			}
+		case apiPath + "/bindings/dev-published/manifest":
+			manifestCalls++
