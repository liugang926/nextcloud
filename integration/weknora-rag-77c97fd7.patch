+		if tc.rangeHeader != "" {
+			req.Header.Set("Range", tc.rangeHeader)
+		}
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		require.Equal(t, tc.status, w.Code, w.Body.String())
+		require.Equal(t, tc.body, w.Body.String())
+		if tc.rangeHeader != "" {
+			require.Equal(t, "bytes 2-4/6", w.Header().Get("Content-Range"))
