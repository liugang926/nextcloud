+	}
+	owners, err := s.repo.ListKnowledgeOwnersByResource(ctx, tenantID, resourceID, canonical, physical)
+	if err != nil {
+		return nil, false, err
+	}
+	return owners, resource != nil || len(owners) > 0, nil
