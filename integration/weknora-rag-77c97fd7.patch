+			return false, nil
+		}
+		if err != nil {
+			return false, err
+		}
+		if attempts == 1 {
+			return false, errors.New("simulated crash before DB acknowledgement")
+		}
+		return true, nil
+	})
+	_, err = store.RunDue(ctx, now, 100)
