+		{ID: "ordinary-1", TenantID: 1, KnowledgeBaseID: "kb-1", Title: "first"},
+		{ID: "secret", TenantID: 1, KnowledgeBaseID: "kb-1", Channel: types.ConnectorTypeNextcloud,
