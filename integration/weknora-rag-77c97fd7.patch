+func testNextcloudEventSyncAdmission(t *testing.T, usePostgres bool) {
+	t.Helper()
+	db, _, _ := setupNextcloudDispatchTest(t, usePostgres)
+	now := time.Now().UTC()
+	require.NoError(t, db.Exec(`INSERT INTO sync_logs (id, data_source_id, status, started_at)
