+		query = query.Where("id IN (?) OR file_path IN ?", boundIDs, paths)
+	} else {
+		query = query.Where("file_path IN ?", paths)
+	}
+	var owners []*types.Knowledge
+	if err := query.Order("id ASC").Find(&owners).Error; err != nil {
+		return nil, err
+	}
+	return owners, nil
