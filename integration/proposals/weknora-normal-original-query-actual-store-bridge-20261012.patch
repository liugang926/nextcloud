+// OriginalKnowledgeQueryStore is used after CreateRetrieveEngineForKB has
+// resolved the authorized KB/store binding. It accepts only one actual vector
+// engine and does not turn registry selection into caller authorization.
+func (c *CompositeRetrieveEngine) OriginalKnowledgeQueryStore(ctx context.Context, material *apprepo.KnowledgeInputProvenanceStore, models interfaces.ModelRepository) (*apprepo.KnowledgeSQLiteEmbeddingStore, error) {
+	if ctx == nil {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if c == nil {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	var selected *engineInfo
+	for _, info := range c.engineInfos {
+		if info == nil || !slices.Contains(info.retrieverType, types.VectorRetrieverType) {
+			continue
+		}
+		if selected != nil {
+			return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		selected = info
+	}
+	if selected == nil {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	actual, ok := selected.retrieveEngine.(*KeywordsVectorHybridRetrieveEngineService)
+	if !ok || actual == nil {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return actual.OriginalKnowledgeQueryStore(ctx, material, models)
+}
