+// OriginalKnowledgeQueryStore resolves this concrete adapter's existing store.
+// The trusted material/model dependencies must belong to its actual DB pool.
+// This exposes no query result or read grant; Begin still checks the caller,
+// leased message plan, current KB/model and complete original schema.
+func OriginalKnowledgeQueryStore(ctx context.Context, engine interfaces.RetrieveEngineRepository, material *apprepo.KnowledgeInputProvenanceStore, models interfaces.ModelRepository) (*apprepo.KnowledgeSQLiteEmbeddingStore, error) {
+	if ctx == nil {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	actual, ok := engine.(*sqliteRepository)
+	if !ok || actual == nil || actual.originals == nil || actual.initErr != nil {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	// The existing constructor validates the concrete dependency identities.
+	// It performs no SQL and creates neither a lease nor an SDK capability.
+	// Return the configured adapter store, preserving its original source factory.
+	if apprepo.NewKnowledgeSQLiteEmbeddingStore(actual.db, material, models) == nil {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return actual.originals, nil
+}
