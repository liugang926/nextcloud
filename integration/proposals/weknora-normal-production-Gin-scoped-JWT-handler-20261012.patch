+func (m normalPublicHandlerModelsObserver) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	if id != m.answer {
+		return nil, errors.New("actual public handler answer selector changed")
+	}
+	if err := normalEventOriginalContextCheck(ctx, m.observations.snapshot(), m.kb, m.model); err != nil {
+		m.observations.fail(err)
+		return nil, err
+	}
+	return m.ModelService.GetChatModel(ctx, id)
+}
