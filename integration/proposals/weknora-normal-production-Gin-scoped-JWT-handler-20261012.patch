new file mode 100644
index 000000000..20759baeb
--- /dev/null
+++ b/internal/application/service/original_service_timing.go
@@ -0,0 +1,61 @@
+package service
+
+import (
+	"context"
+	"time"
+)
+
+// These fixed inclusive spans observe actual calls. Their nested durations
+// cannot be added to infer a critical path or used as an admission decision.
+type originalServiceTimingPhase uint8
+
+const (
+	originalServiceTimingGetChatBegin originalServiceTimingPhase = iota
+	originalServiceTimingSnapshot
+	originalServiceTimingConstructor
+	originalServiceTimingBindRetain
+	originalServiceTimingGetChatTotal
+	originalServiceTimingSlotBoundaryTotal
+	originalServiceTimingPhaseCount
+)
+
+// Registration exists only in package-local test fixtures. No context,
+// selector, body, SQL, error text or authorization result enters the callback.
+type originalServiceTimingObserver struct {
+	observe func(originalServiceTimingPhase, time.Duration, bool)
+}
+
+type originalServiceTimingSpan struct {
+	observer *originalServiceTimingObserver
+	phase    originalServiceTimingPhase
+	started  time.Time
+}
+
+func startOriginalServiceTiming(ctx context.Context, phase originalServiceTimingPhase) originalServiceTimingSpan {
+	if ctx == nil || phase >= originalServiceTimingPhaseCount {
+		return originalServiceTimingSpan{}
+	}
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok || slot == nil {
+		return originalServiceTimingSpan{}
+	}
+	slot.mu.Lock()
+	observer := slot.timingObserver
+	slot.mu.Unlock()
+	if observer == nil || observer.observe == nil {
+		return originalServiceTimingSpan{}
+	}
+	// The normal/default-off path above performs no clock read.
+	return originalServiceTimingSpan{observer: observer, phase: phase, started: time.Now()}
+}
+
+func (span originalServiceTimingSpan) finish(success bool) {
+	if span.observer == nil {
+		return
+	}
+	duration := time.Since(span.started)
+	// Diagnostic callbacks cannot replace a real return or panic in business
+	// code. No callback runs under the material-slot mutex.
+	defer func() { _ = recover() }()
+	span.observer.observe(span.phase, duration, success)
+}
diff --git a/internal/application/service/original_service_timing_profile_test.go b/internal/application/service/original_service_timing_profile_test.go
new file mode 100644
index 000000000..47ab6e043
--- /dev/null
+++ b/internal/application/service/original_service_timing_profile_test.go
@@ -0,0 +1,269 @@
+package service
+
+import (
+	"context"
+	"os"
+	"sync"
+	"testing"
+	"time"
+)
+
+const originalServiceTimingProfileFlag = "WEKNORA_ORIGINAL_SERVICE_TIMING_PROFILE"
+const originalServiceTimingMaxCount uint64 = 1<<32 - 1
+const originalServiceTimingMaxDuration int64 = 1<<63 - 1
+
+var originalServiceTimingPhaseNames = [originalServiceTimingPhaseCount]string{
+	"getchat_begin", "snapshot", "constructor", "bind_retain",
+	"getchat_total", "fullslot_boundary_total",
+}
+
+type originalServiceTimingAggregate struct {
+	count, successes uint64
+	duration         int64
+	saturated        bool
+}
+
+// Exactly six buckets; no unbounded records or caller-specific keys. Its
+// mutex covers local arithmetic only, never SQL, network calls or joins.
+type originalServiceTimingCollector struct {
+	mu       sync.Mutex
+	buckets  [originalServiceTimingPhaseCount]originalServiceTimingAggregate
+	slot     *messageMaterialOutputSlot
+	observer *originalServiceTimingObserver
+	sealed   bool
+}
+
+func newOriginalServiceTimingCollectorForTest() *originalServiceTimingCollector {
+	if os.Getenv(originalServiceTimingProfileFlag) != "1" {
+		return nil
+	}
+	collector := &originalServiceTimingCollector{}
+	collector.observer = &originalServiceTimingObserver{observe: collector.record}
+	return collector
+}
+
+func (collector *originalServiceTimingCollector) record(phase originalServiceTimingPhase, duration time.Duration, success bool) {
+	if phase >= originalServiceTimingPhaseCount {
+		return
+	}
+	collector.mu.Lock()
+	defer collector.mu.Unlock()
+	if collector.sealed {
+		return
+	}
+	bucket := &collector.buckets[phase]
+	if bucket.count == originalServiceTimingMaxCount {
+		bucket.saturated = true
+		return
+	}
+	bucket.count++
+	if success {
+		bucket.successes++
+	}
+	ns := duration.Nanoseconds()
+	if ns < 0 {
+		ns = 0
+	}
+	if ns > originalServiceTimingMaxDuration-bucket.duration {
+		bucket.duration = originalServiceTimingMaxDuration
+		bucket.saturated = true
+	} else {
+		bucket.duration += ns
+	}
+}
+
+func (collector *originalServiceTimingCollector) attach(ctx context.Context) {
+	collector.attachBeforeInstallForTest(ctx, nil)
+}
+
+// The optional barrier is used only by the deterministic concurrency test.
+// Real fixtures pass nil; the installation and seal share collector -> slot
+// lock order, with no lock gap allowing a late attach to revive registration.
+func (collector *originalServiceTimingCollector) attachBeforeInstallForTest(ctx context.Context, beforeInstall func()) {
+	if collector == nil {
+		return
+	}
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok || slot == nil {
+		return
+	}
+	collector.mu.Lock()
+	defer collector.mu.Unlock()
+	if collector.sealed || collector.slot != nil {
+		return
+	}
+	if beforeInstall != nil {
+		beforeInstall()
+	}
+	slot.mu.Lock()
+	if slot.timingObserver == nil {
+		slot.timingObserver = collector.observer
+		collector.slot = slot
+	}
+	slot.mu.Unlock()
+}
+
+func originalServiceTimingChannelJoined(done <-chan struct{}) bool {
+	if done == nil {
+		return false
+	}
+	select {
+	case <-done:
+		return true
+	default:
+		return false
+	}
+}
+
+// This does not wait or manufacture completion. The existing cleanup must
+// first join both genuine channels under its unchanged shared three seconds.
+func (collector *originalServiceTimingCollector) finish(t *testing.T, HTTPreturned, outerDone <-chan struct{}) {
+	if collector == nil {
+		return
+	}
+	collector.mu.Lock()
+	collector.sealed = true
+	buckets, slot := collector.buckets, collector.slot
+	collector.slot = nil
+	if slot != nil {
+		slot.mu.Lock()
+		if slot.timingObserver == collector.observer {
+			slot.timingObserver = nil
+		}
+		slot.mu.Unlock()
+	}
+	collector.mu.Unlock()
+	if !originalServiceTimingChannelJoined(HTTPreturned) || !originalServiceTimingChannelJoined(outerDone) {
+		return
+	}
+	for phase, bucket := range buckets {
+		t.Logf("original_service_timing inclusive_phase=%s count=%d success_count=%d failure_count=%d duration_ns=%d saturated=%t",
+			originalServiceTimingPhaseNames[phase], bucket.count, bucket.successes,
+			bucket.count-bucket.successes, bucket.duration, bucket.saturated)
+	}
+}
+
+func TestOriginalServiceTimingCallbackCannotReplaceRealResult(t *testing.T) {
+	observer := &originalServiceTimingObserver{observe: func(originalServiceTimingPhase, time.Duration, bool) { panic("diagnostic callback") }}
+	span := originalServiceTimingSpan{observer: observer, phase: originalServiceTimingSnapshot, started: time.Now()}
+	span.finish(false)
+	// Reaching here proves the observer panic did not escape into its caller.
+}
+
+func TestOriginalServiceTimingCollectorConcurrentBoundedAggregate(t *testing.T) {
+	collector := &originalServiceTimingCollector{}
+	var workers sync.WaitGroup
+	for phase := originalServiceTimingPhase(0); phase < originalServiceTimingPhaseCount; phase++ {
+		workers.Add(1)
+		go func(phase originalServiceTimingPhase) {
+			defer workers.Done()
+			for i := 0; i < 100; i++ {
+				collector.record(phase, time.Nanosecond, i%2 == 0)
+			}
+		}(phase)
+	}
+	workers.Wait()
+	for _, bucket := range collector.buckets {
+		if bucket.count != 100 || bucket.successes != 50 || bucket.duration != 100 || bucket.saturated {
+			t.Fatal("fixed aggregate did not preserve concurrent numeric observations")
+		}
+	}
+	collector.buckets[0] = originalServiceTimingAggregate{count: originalServiceTimingMaxCount, duration: originalServiceTimingMaxDuration}
+	collector.record(0, time.Nanosecond, true)
+	if !collector.buckets[0].saturated || collector.buckets[0].count != originalServiceTimingMaxCount {
+		t.Fatal("fixed aggregate count exceeded its bound")
+	}
+}
+
+func TestOriginalServiceTimingDefaultOffAndBoundaryCallbackAfterUnlock(t *testing.T) {
+	t.Setenv(originalServiceTimingProfileFlag, "")
+	if newOriginalServiceTimingCollectorForTest() != nil {
+		t.Fatal("default-off profile allocated a collector")
+	}
+	slot := &messageMaterialOutputSlot{}
+	ctx := context.WithValue(context.Background(), messageMaterialOutputKey{}, slot)
+	if span := startOriginalServiceTiming(ctx, originalServiceTimingSnapshot); span.observer != nil || !span.started.IsZero() {
+		t.Fatal("default-off span performed a clock read")
+	}
+	var callbackCalled, mutexReleased, succeeded bool
+	slot.timingObserver = &originalServiceTimingObserver{observe: func(phase originalServiceTimingPhase, duration time.Duration, success bool) {
+		callbackCalled = phase == originalServiceTimingSlotBoundaryTotal
+		succeeded = success
+		mutexReleased = slot.mu.TryLock()
+		if mutexReleased {
+			slot.mu.Unlock()
+		}
+	}}
+	if err := CheckMessageMaterialOutputBoundary(ctx); err != nil || !callbackCalled || !mutexReleased || !succeeded {
+		t.Fatal("boundary profile changed the return or ran under the slot mutex")
+	}
+	slot.Closed = true
+	callbackCalled, succeeded = false, true
+	if err := CheckMessageMaterialOutputBoundary(ctx); err == nil || !callbackCalled || succeeded {
+		t.Fatal("boundary refusal was replaced or recorded as successful")
+	}
+}
+
+func TestOriginalServiceTimingAttachAndFinishCannotReviveSealedObserver(t *testing.T) {
+	slot := &messageMaterialOutputSlot{}
+	ctx := context.WithValue(context.Background(), messageMaterialOutputKey{}, slot)
+	collector := &originalServiceTimingCollector{}
+	collector.observer = &originalServiceTimingObserver{observe: collector.record}
+	beforeInstall, releaseInstall := make(chan struct{}), make(chan struct{})
+	attachDone, finishDone := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	release := func() { releaseOnce.Do(func() { close(releaseInstall) }) }
+	defer release()
+	go func() {
+		defer close(attachDone)
+		collector.attachBeforeInstallForTest(ctx, func() {
+			close(beforeInstall)
+			<-releaseInstall
+		})
+	}()
+	select {
+	case <-beforeInstall:
+	case <-time.After(time.Second):
+		t.Fatal("attach did not reach the deterministic installation barrier")
+	}
+	// This assertion directly detects the old unlock-before-install gap,
+	// independent of how the finishing goroutine is scheduled.
+	if collector.mu.TryLock() {
+		collector.mu.Unlock()
+		t.Error("attach released collector ownership before observer installation")
+	}
+	finishEntered := make(chan struct{})
+	go func() {
+		defer close(finishDone)
+		close(finishEntered)
+		// Nil real-lifetime signals suppress output; finish still seals and
+		// unregisters, as it does after a failed/early cleanup.
+		collector.finish(t, nil, nil)
+	}()
+	<-finishEntered
+	release()
+	for _, joined := range []<-chan struct{}{attachDone, finishDone} {
+		select {
+		case <-joined:
+		case <-time.After(time.Second):
+			t.Fatal("attach and finish did not join")
+		}
+	}
+	collector.mu.Lock()
+	sealed, retainedSlot := collector.sealed, collector.slot
+	collector.mu.Unlock()
+	slot.mu.Lock()
+	observer := slot.timingObserver
+	slot.mu.Unlock()
+	if !sealed || retainedSlot != nil || observer != nil {
+		t.Fatal("concurrent finish left or revived a sealed observer registration")
+	}
+	// A later actual HTTP start must remain inert after finish won the seal.
+	collector.attach(ctx)
+	slot.mu.Lock()
+	observer = slot.timingObserver
+	slot.mu.Unlock()
+	if observer != nil {
+		t.Fatal("late attach revived the sealed observer")
+	}
+}
