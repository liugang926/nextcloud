+// No test invokes KnowledgeQAByEvent, creates user/assistant messages, opens a
+// material boundary or supplies a SourceLineage/query/vector/model capability.
+func TestNormalOriginalPublicHandlerActualSQLiteJWT(t *testing.T) {
+	for _, mode := range []string{"configured_summary_public_handler_completion", "unrelated_summary_public_handler_denied", "A_grant_after_query_SDK_public_handler_denied"} {
+		t.Run(mode, func(t *testing.T) {
+			var calls atomic.Int64
+			var mu sync.Mutex
+			var providerErr error
