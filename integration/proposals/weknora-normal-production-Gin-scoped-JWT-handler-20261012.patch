+			provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				var wire struct {
+					Stream   bool
+					Messages []struct{ Role, Content string }
+				}
+				if json.NewDecoder(r.Body).Decode(&wire) != nil || r.URL.Path != "/chat/completions" || !wire.Stream || r.Header.Get("Authorization") != "Bearer owned-ancestor-embedding" {
+					fail(errors.New("actual public answer SSE wire mismatch"))
+					w.WriteHeader(400)
+					return
+				}
+				text := ""
+				for _, m := range wire.Messages {
+					text += m.Content
+				}
+				if f == nil || !strings.Contains(text, f.QueryText) || !strings.Contains(text, "Original configuration influence") {
+					fail(errors.New("actual public answer input lost original source"))
+					w.WriteHeader(400)
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				if _, e := fmt.Fprint(w, "data: {\"id\":\"actual-public-answer\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"Actual normal original event answer.\"},\"finish_reason\":null}]}\n\n"); e != nil {
+					fail(e)
+					return
+				}
+				if flush, ok := w.(http.Flusher); ok {
+					flush.Flush()
+				}
+				if _, e := fmt.Fprint(w, "data: {\"id\":\"actual-public-answer\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"); e != nil {
+					fail(e)
+				}
+			}))
+			t.Cleanup(provider.Close)
+			f = service.NewNormalOriginalPublicHandlerFixtureForTest(t, provider.URL)
+			baseline := f.SDKCalls()
