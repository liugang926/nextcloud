+type normalPublicHandlerMessagesObserver struct {
+	*messageService
+	observations *normalPublicHandlerObservations
+	groups       interfaces.GroupAccessService
+	kb, model    string
+}
+
+// This observes the actual handler's existing outer worker channel. The
+// fixture cannot create or close it, and it is not a read/SDK/completion grant.
+func (m *normalPublicHandlerMessagesObserver) ObserveOriginalMessageMaterialProducer(ctx context.Context, done <-chan struct{}) {
+	if ctx == nil || done == nil {
+		m.observations.fail(errors.New("actual original HTTP outer producer lifetime missing"))
+		return
+	}
+	if slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot); !ok || slot == nil {
+		m.observations.fail(errors.New("actual outer producer lost its original HTTP owner"))
+		return
+	}
+	m.observations.timing.attach(ctx)
+	m.observations.mu.Lock()
+	defer m.observations.mu.Unlock()
+	if m.observations.outerDone != nil {
+		m.observations.errors = errors.Join(m.observations.errors, errors.New("actual outer producer lifetime was replaced"))
+		return
+	}
+	m.observations.outerDone = done
+}
+
+func (m *normalPublicHandlerMessagesObserver) UpdateMessage(ctx context.Context, message *types.Message) error {
+	if message.Role == "assistant" && message.IsCompleted {
+		if err := normalEventOriginalContextCheck(ctx, m.observations.snapshot(), m.kb, m.model); err != nil {
+			m.observations.fail(err)
+			return err
+		}
+		caller := types.CallerFromContext(ctx)
+		role, err := m.groups.EffectiveTenantRole(ctx, caller.UserID, caller.TenantID, time.Now().UTC())
+		if err != nil {
+			return err
+		}
+		// Presence is only an observation; the real UpdateMessage below must still
+		// reauthorize concrete current models/source/inputs/fulllease finalclock.
+		if role.ScopedOnly && !repository.ScopedKnowledgeModelPurposePresent(ctx) {
+			return errors.New("actual public handler lost scoped answer context")
+		}
+	}
+	err := m.messageService.UpdateMessage(ctx, message)
+	if message.Role == "assistant" && message.IsCompleted {
+		m.observations.completeOnce.Do(func() { m.observations.result <- err; close(m.observations.completed) })
+	}
+	return err
+}
+
+// No holder is made here. Only actual resources still owned by the handler's
+// material slot can establish that native retrieval preceded a refusal.
+func normalPublicHandlerActualNativeObserved(ctx context.Context) bool {
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok || slot == nil {
+		return false
+	}
+	queries := []*repository.KnowledgeQueryEmbeddingResultRead{}
+	vectors := []*repository.KnowledgeSQLiteEmbeddingVectorRead{}
+	slot.mu.Lock()
+	for _, resource := range slot.Models {
+		switch actual := resource.(type) {
+		case *knowledgeQueryBoundaryResource:
+			if actual != nil && actual.read != nil && actual.retained.Load() {
+				queries = append(queries, actual.read)
+			}
+		case *knowledgeEmbeddingBoundaryResource:
+			if actual != nil && actual.read != nil && actual.query != nil {
+				vectors = append(vectors, actual.read)
+			}
+		}
+	}
+	slot.mu.Unlock()
+	if len(queries) != 1 || len(vectors) != 1 {
+		return false
+	}
+	snapshot, err := queries[0].Snapshot()
+	if err != nil || snapshot == nil {
+		return false
+	}
+	_, actual, err := repository.WithActualKnowledgeCompletionReads(queries[0].Context(), queries, vectors)
+	return err == nil && len(actual) == 1 && actual[0].QueryReceiptID == snapshot.ReceiptID && len(actual[0].Candidates) > 0 && len(actual[0].Hits) > 0 && actual[0].SourceLineage.RequireComplete() == nil && len(actual[0].SourceLineage.Sources) == 1 && vectors[0].Recheck() == nil
+}
