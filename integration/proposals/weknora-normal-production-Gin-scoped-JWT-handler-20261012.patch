+type normalPublicHandlerSessionsObserver struct {
+	interfaces.SessionService
+	observations *normalPublicHandlerObservations
+}
+
+func (s normalPublicHandlerSessionsObserver) KnowledgeQA(ctx context.Context, req *types.QARequest, bus *event.EventBus) (err error) {
+	// Actual handler already created and attached its owned HTTP material slot.
+	s.observations.mu.Lock()
+	s.observations.ctx = ctx
+	s.observations.session = req.Session.ID
+	s.observations.assistant = req.AssistantMessageID
+	s.observations.request = req.UserMessageID
+	s.observations.mu.Unlock()
+	s.observations.beginOnce.Do(func() { close(s.observations.started) })
+	defer s.observations.endOnce.Do(func() { close(s.observations.done) })
+	err = s.SessionService.KnowledgeQA(ctx, req, bus)
+	if err != nil {
+		if observed := normalPublicHandlerActualNativeObserved(ctx); observed {
+			s.observations.mu.Lock()
+			s.observations.nativeObserved = true
+			s.observations.mu.Unlock()
+		}
+	}
+	return err
+}
+
+// The real public handler probes these production optional interfaces before
+// creating a turn. The observer must not hide them behind SessionService.
+func (s normalPublicHandlerSessionsObserver) RejectSendIfRewinding(ctx context.Context, session string) error {
+	actual, ok := s.SessionService.(*sessionService)
+	if !ok || actual == nil {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return actual.RejectSendIfRewinding(ctx, session)
+}
+func (s normalPublicHandlerSessionsObserver) HoldSandboxTurn(ctx context.Context, session, configID string) (func(), error) {
+	actual, ok := s.SessionService.(*sessionService)
+	if !ok || actual == nil {
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
