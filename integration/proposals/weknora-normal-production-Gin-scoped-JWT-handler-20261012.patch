+type normalPublicHandlerSessionsObserver struct{interfaces.SessionService;observations *normalPublicHandlerObservations}
+func (s normalPublicHandlerSessionsObserver) KnowledgeQA(ctx context.Context,req *types.QARequest,bus *event.EventBus)(err error){
+ // Actual handler already created and attached its owned HTTP material slot.
+ s.observations.mu.Lock();s.observations.ctx=ctx;s.observations.session=req.Session.ID;s.observations.assistant=req.AssistantMessageID;s.observations.request=req.UserMessageID;s.observations.mu.Unlock()
+ s.observations.beginOnce.Do(func(){close(s.observations.started)})
+ defer s.observations.endOnce.Do(func(){close(s.observations.done)})
+ err=s.SessionService.KnowledgeQA(ctx,req,bus)
+ if err!=nil{
+  if observed:=normalPublicHandlerActualNativeObserved(ctx);observed{s.observations.mu.Lock();s.observations.nativeObserved=true;s.observations.mu.Unlock()}
+ }
+ return err
+}
+// The real public handler probes these production optional interfaces before
+// creating a turn. The observer must not hide them behind SessionService.
+func (s normalPublicHandlerSessionsObserver) RejectSendIfRewinding(ctx context.Context,session string)error{
+ actual,ok:=s.SessionService.(*sessionService)
+ if !ok||actual==nil{return repository.ErrKnowledgeSQLiteEmbeddingUnknown}
+ return actual.RejectSendIfRewinding(ctx,session)
+}
+func (s normalPublicHandlerSessionsObserver) HoldSandboxTurn(ctx context.Context,session,configID string)(func(),error){
+ actual,ok:=s.SessionService.(*sessionService)
+ if !ok||actual==nil{return nil,repository.ErrKnowledgeSQLiteEmbeddingUnknown}
+ return actual.HoldSandboxTurn(ctx,session,configID)
+}
+type normalPublicHandlerModelsObserver struct{interfaces.ModelService;observations *normalPublicHandlerObservations;kb,model,answer string}
+func (m normalPublicHandlerModelsObserver) GetChatModel(ctx context.Context,id string)(chat.Chat,error){
+ if id!=m.answer{return nil,errors.New("actual public handler answer selector changed")}
+ if err:=normalEventOriginalContextCheck(ctx,m.observations.snapshot(),m.kb,m.model);err!=nil{m.observations.fail(err);return nil,err}
+ return m.ModelService.GetChatModel(ctx,id)
+}
+type normalPublicHandlerMessagesObserver struct{*messageService;observations *normalPublicHandlerObservations;groups interfaces.GroupAccessService;kb,model string}
+func (m *normalPublicHandlerMessagesObserver) UpdateMessage(ctx context.Context,message *types.Message)error{
+ if message.Role=="assistant"&&message.IsCompleted{
+  if err:=normalEventOriginalContextCheck(ctx,m.observations.snapshot(),m.kb,m.model);err!=nil{m.observations.fail(err);return err}
+  caller:=types.CallerFromContext(ctx);role,err:=m.groups.EffectiveTenantRole(ctx,caller.UserID,caller.TenantID,time.Now().UTC());if err!=nil{return err}
+  // Presence is only an observation; the real UpdateMessage below must still
+  // reauthorize concrete current models/source/inputs/fulllease finalclock.
+  if role.ScopedOnly&&!repository.ScopedKnowledgeModelPurposePresent(ctx){return errors.New("actual public handler lost scoped answer context")}
+ }
+ err:=m.messageService.UpdateMessage(ctx,message)
+ if message.Role=="assistant"&&message.IsCompleted{m.observations.completeOnce.Do(func(){m.observations.result<-err;close(m.observations.completed)})}
+ return err
+}
