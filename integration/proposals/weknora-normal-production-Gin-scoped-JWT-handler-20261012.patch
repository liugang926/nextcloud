+// No holder is made here. Only actual resources still owned by the handler's
+// material slot can establish that native retrieval preceded a refusal.
+func normalPublicHandlerActualNativeObserved(ctx context.Context)bool{
+ slot,ok:=ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot);if !ok||slot==nil{return false}
+ queries:=[]*repository.KnowledgeQueryEmbeddingResultRead{};vectors:=[]*repository.KnowledgeSQLiteEmbeddingVectorRead{}
+ slot.mu.Lock();for _,resource:=range slot.Models{switch actual:=resource.(type){case *knowledgeQueryBoundaryResource:if actual!=nil&&actual.read!=nil&&actual.retained.Load(){queries=append(queries,actual.read)};case *knowledgeEmbeddingBoundaryResource:if actual!=nil&&actual.read!=nil&&actual.query!=nil{vectors=append(vectors,actual.read)}}};slot.mu.Unlock()
+ if len(queries)!=1||len(vectors)!=1{return false}
+ snapshot,err:=queries[0].Snapshot();if err!=nil||snapshot==nil{return false}
+ _,actual,err:=repository.WithActualKnowledgeCompletionReads(queries[0].Context(),queries,vectors)
+ return err==nil&&len(actual)==1&&actual[0].QueryReceiptID==snapshot.ReceiptID&&len(actual[0].Candidates)>0&&len(actual[0].Hits)>0&&actual[0].SourceLineage.RequireComplete()==nil&&len(actual[0].SourceLineage.Sources)==1&&vectors[0].Recheck()==nil
+}
