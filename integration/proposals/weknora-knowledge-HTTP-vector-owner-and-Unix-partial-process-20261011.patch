@@ -0,0 +1,60 @@
+package interfaces
+
+import (
+	"context"
+	"errors"
+)
+
+// A consumer owns a real repository read. This interface cannot author query,
+// vector, knowledge, model, message completion or source lineage originals.
+type KnowledgeEmbeddingConsumerRead interface {
+	Context() context.Context
+	Recheck() error
+	Close() error
+}
+type knowledgeEmbeddingConsumerKey struct{}
+type knowledgeEmbeddingConsumerBoundary struct {
+	acquire func(context.Context) (context.Context, func(), func() error, error)
+	retain  func(context.Context, KnowledgeEmbeddingConsumerRead, func(), func() error) (bool, error)
+}
+
+var ErrKnowledgeEmbeddingConsumerUnavailable = errors.New("knowledge_embedding_consumer_owner_unavailable")
+
+// This is an internal owner registration, not an authorization decision.
+// Production QA must not install it until query originals and completion's
+// exact typed knowledge dependency/clock union are implemented together.
+func WithKnowledgeEmbeddingConsumerBoundary(ctx context.Context, acquire func(context.Context) (context.Context, func(), func() error, error), retain func(context.Context, KnowledgeEmbeddingConsumerRead, func(), func() error) (bool, error)) context.Context {
+	return context.WithValue(ctx, knowledgeEmbeddingConsumerKey{}, knowledgeEmbeddingConsumerBoundary{acquire, retain})
+}
+func AcquireKnowledgeEmbeddingConsumerContext(ctx context.Context) (context.Context, func(), func() error, error) {
+	if ctx == nil {
+		return ctx, nil, nil, ErrKnowledgeEmbeddingConsumerUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return ctx, nil, nil, err
+	}
+	boundary, present := ctx.Value(knowledgeEmbeddingConsumerKey{}).(knowledgeEmbeddingConsumerBoundary)
+	if !present {
+		return ctx, nil, nil, nil
+	}
+	if boundary.acquire == nil || boundary.retain == nil {
+		return ctx, nil, nil, ErrKnowledgeEmbeddingConsumerUnavailable
+	}
+	return boundary.acquire(ctx)
+}
+func RetainKnowledgeEmbeddingConsumerRead(ctx context.Context, read KnowledgeEmbeddingConsumerRead, release func(), transfer func() error) (bool, error) {
+	if ctx == nil || read == nil {
+		return false, ErrKnowledgeEmbeddingConsumerUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	boundary, present := ctx.Value(knowledgeEmbeddingConsumerKey{}).(knowledgeEmbeddingConsumerBoundary)
+	if !present {
+		return false, nil
+	}
+	if boundary.acquire == nil || boundary.retain == nil {
+		return false, ErrKnowledgeEmbeddingConsumerUnavailable
+	}
+	return boundary.retain(ctx, read, release, transfer)
+}
