+)
+
+// This exercises only the explicit pending90 constructor and real HTTP owner
+// lifecycle. It does not supply a query original or complete a QA assistant.
+func knowledgeConsumerIndexActual(t *testing.T) (*gorm.DB, context.Context, interfaces.RetrieveEngineRepository, types.RetrieveParams, *atomic.Int64) {
+	t.Helper()
+	knowledgeSQLiteOriginalVecAuto.Do(sqlite_vec.Auto)
+	store, db, ctx := jointFullSchemaBusinessFixture(t, false)
+	installKnowledgeSQLiteOriginal90ForTest(t, db)
+	modelRepo := repository.NewModelRepository(db)
+	ConfigureModelOriginalAuthority(modelRepo, store, NewGroupAccessService(repository.NewGroupAccessRepository(db)), nil)
+	models := NewModelService(modelRepo, nil, nil, nil, nil, nil)
+	calls := &atomic.Int64{}
+	var mu sync.Mutex
+	var observed error
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		var body struct {
+			Input      []string `json:"input"`
+			Dimensions int      `json:"dimensions"`
+		}
+		err := json.NewDecoder(r.Body).Decode(&body)
+		if err == nil && (r.URL.Path != "/embeddings" || r.Header.Get("Authorization") != "Bearer actual-consumer-key" || body.Dimensions != 2 || len(body.Input) != 1 || body.Input[0] != "consumer-title\nretained-original-input") {
+			err = errors.New("actual consumer SDK input/recipe mismatch")
+		}
+		mu.Lock()
+		observed = errors.Join(observed, err)
+		mu.Unlock()
+		if err != nil {
+			w.WriteHeader(400)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]interface{}{"data": []interface{}{map[string]interface{}{"index": 0, "embedding": []float32{1, 0}}}})
+	}))
+	t.Cleanup(server.Close)
+	utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+	t.Cleanup(utils.ResetSSRFWhitelistForTest)
+	model := &types.Model{ID: "actual-consumer-embedding", TenantID: 7, Name: "consumer model", Type: types.ModelTypeEmbedding, Source: types.ModelSourceRemote, Parameters: types.ModelParameters{Provider: "openai", BaseURL: server.URL, APIKey: "actual-consumer-key", EmbeddingParameters: types.EmbeddingParameters{Dimension: 2, SupportsDimensionOverride: true}}}
+	require.NoError(t, models.CreateModel(ctx, model))
+	require.NotNil(t, model.OriginalProof)
+	kb := &types.KnowledgeBase{ID: "consumer-original-kb", TenantID: 7, Name: "consumer original KB", EmbeddingModelID: model.ID, ChunkingConfig: types.ChunkingConfig{ChunkSize: 512}, IndexingStrategy: types.IndexingStrategy{VectorEnabled: true}}
+	require.NoError(t, store.CreateKnowledgeBaseWithInput(repository.WithIndependentKnowledgeInput(ctx), kb))
+	knowledge := &types.Knowledge{ID: "consumer-original-knowledge", TenantID: 7, KnowledgeBaseID: kb.ID, Type: types.KnowledgeTypeManual, Title: "consumer-title", ParseStatus: types.ParseStatusCompleted, EnableStatus: "enabled"}
+	text := "retained-original-input"
+	require.NoError(t, knowledge.SetManualMetadata(types.NewManualKnowledgeMetadata(text, types.ManualKnowledgeStatusPublish, 1)))
+	proof, err := store.CreateKnowledgeWithInput(repository.WithIndependentKnowledgeInput(ctx), knowledge, text)
+	require.NoError(t, err)
+	require.NotNil(t, proof)
+	build, err := store.RestoreKnowledgeBuildActor(ctx, proof)
+	require.NoError(t, err)
+	build = repository.WithKnowledgeBuildInputProof(build, store, proof)
+	chunk := &types.Chunk{ID: "consumer-original-chunk", TenantID: 7, KnowledgeBaseID: kb.ID, KnowledgeID: knowledge.ID, Content: text, ChunkType: types.ChunkTypeText, IsEnabled: true}
+	require.NoError(t, repository.NewChunkRepository(db).CreateChunks(build, []*types.Chunk{chunk}))
+	index := sqliteindex.NewOriginalSQLiteRetrieveEngineRepository(db, store, modelRepo)
+	engine := retriever.NewKVHybridRetrieveEngine(index, types.SQLiteRetrieverEngineType)
+	op, cancel := context.WithTimeout(build, 10*time.Second)
+	defer cancel()
+	sdk, err := models.GetEmbeddingModel(op, model.ID)
+	require.NoError(t, err)
+	info := &types.IndexInfo{Content: buildKnowledgeIndexContent(knowledge, chunk.EmbeddingContent()), SourceID: chunk.ID, SourceType: types.ChunkSourceType, ChunkID: chunk.ID, KnowledgeID: knowledge.ID, KnowledgeBaseID: kb.ID, IsEnabled: true}
+	require.NoError(t, engine.BatchIndex(op, sdk, []*types.IndexInfo{info}, []types.RetrieverType{types.VectorRetrieverType}))
+	require.EqualValues(t, 1, calls.Load())
+	mu.Lock()
+	err = observed
+	mu.Unlock()
+	require.NoError(t, err)
+	require.NotNil(t, model.Parameters.OriginalEmbedding)
+	params := types.RetrieveParams{Embedding: []float32{1, 0}, KnowledgeBaseIDs: []string{kb.ID}, TopK: 1, RetrieverType: types.VectorRetrieverType, AdditionalParams: map[string]interface{}{"embedding_space_digest": model.Parameters.OriginalEmbedding.SpaceDigest}}
+	return db, ctx, index, params, calls
+}
+
+func TestKnowledgeEmbeddingConsumerOwnerActualHTTP(t *testing.T) {
+	for _, mode := range []string{"provider_done_keeps_originals", "owner_cancellation_refuses_output", "current_actor_refuses_output", "invalid_boundary_refuses"} {
+		t.Run(mode, func(t *testing.T) {
+			db, base, index, params, calls := knowledgeConsumerIndexActual(t)
+			owner, cancelOwner := context.WithTimeout(base, 8*time.Second)
+			defer cancelOwner()
+			httpctx, attach, check, releaseHTTP := BeginMessageMaterialHTTPBoundary(owner)
+			pipeline, cancelPipeline := context.WithCancel(attach(httpctx))
+			releaseProducer := RetainMessageMaterialHTTPProducer(pipeline)
+			t.Cleanup(func() { cancelPipeline(); releaseProducer(); releaseHTTP(); cancelOwner() })
+			if mode == "invalid_boundary_refuses" {
+				broken := interfaces.WithKnowledgeEmbeddingConsumerBoundary(pipeline, nil, nil)
+				results, err := index.Retrieve(broken, params)
+				require.ErrorIs(t, err, interfaces.ErrKnowledgeEmbeddingConsumerUnavailable)
+				require.Nil(t, results)
+				var live int64
+				require.NoError(t, db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&live).Error)
+				require.Zero(t, live)
+				return
+			}
+			results, err := index.Retrieve(withKnowledgeEmbeddingConsumerOwner(pipeline), params)
+			require.NoError(t, err)
+			require.Len(t, results, 1)
+			require.Len(t, results[0].Results, 1)
+			require.Equal(t, "consumer-original-chunk", results[0].Results[0].ChunkID)
+			slot := httpctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+			slot.mu.Lock()
+			resources := append([]originalModelClientLifetime(nil), slot.Models...)
+			slot.mu.Unlock()
+			require.Len(t, resources, 1)
+			resource, ok := resources[0].(*knowledgeEmbeddingBoundaryResource)
+			require.True(t, ok)
+			require.NotNil(t, resource.read)
+			markMessageMaterialReady(httpctx)
+			require.NoError(t, check())
+			type heldTuple struct {
+				LeaseID, BodyID, OwnerID, Kind string
+				Epoch                          int64
+				ReleasedAtMS                   *int64
+			}
+			var captured []heldTuple
+			require.NoError(t, db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Order("lease_id").Find(&captured).Error)
+			require.NotEmpty(t, captured)
+			// Provider Done cancels the producer context, while the real HTTP reference
+			// still owns these exact private knowledge/model/input/result read leases.
+			cancelPipeline()
+			releaseProducer()
+			require.NoError(t, resource.read.Context().Err())
+			require.NoError(t, check())
+			require.EqualValues(t, 1, calls.Load())
+			for _, want := range captured {
+				var actual heldTuple
+				require.NoError(t, db.Table("original_body_leases").Where("lease_id=?", want.LeaseID).Take(&actual).Error)
+				require.Equal(t, want, actual)
+				require.Nil(t, actual.ReleasedAtMS)
+			}
+			if mode == "owner_cancellation_refuses_output" {
+				cancelOwner()
+				require.Error(t, check())
+			}
+			if mode == "current_actor_refuses_output" {
+				uid := types.CallerFromContext(base).UserID
+				write := db.Table("users").Where("id=? AND is_active=?", uid, true).Update("is_active", false)
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+				var active bool
+				require.NoError(t, db.Table("users").Select("is_active").Where("id=?", uid).Scan(&active).Error)
+				require.False(t, active)
+				require.Error(t, check())
+			}
+			releaseHTTP()
+			require.Error(t, resource.RecheckOriginal())
+			for _, want := range captured {
+				var actual heldTuple
+				require.NoError(t, db.Table("original_body_leases").Where("lease_id=?", want.LeaseID).Take(&actual).Error)
+				require.Equal(t, want.BodyID, actual.BodyID)
+				require.Equal(t, want.OwnerID, actual.OwnerID)
+				require.Equal(t, want.Kind, actual.Kind)
+				require.Equal(t, want.Epoch, actual.Epoch)
+				require.NotNil(t, actual.ReleasedAtMS)
+			}
+			var live int64
+			require.NoError(t, db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&live).Error)
+			require.Zero(t, live)
+		})
+	}
+}
