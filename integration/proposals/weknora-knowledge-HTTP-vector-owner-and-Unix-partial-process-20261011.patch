@@ -0,0 +1,49 @@
+package service
+
+import (
+	"context"
+	"sync"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// This concrete resource is deliberately distinct from memory consumers. The
+// current completion dispatcher rejects it: no generic checker-only resource
+// is silently omitted from a successful assistant's influencing-input union.
+type knowledgeEmbeddingBoundaryResource struct {
+	read    *repository.KnowledgeSQLiteEmbeddingVectorRead
+	release func()
+	once    sync.Once
+	err     error
+}
+
+func (r *knowledgeEmbeddingBoundaryResource) RecheckOriginal() error {
+	if r == nil || r.read == nil {
+		return interfaces.ErrKnowledgeEmbeddingConsumerUnavailable
+	}
+	return r.read.Recheck()
+}
+func (r *knowledgeEmbeddingBoundaryResource) CloseOriginal() error {
+	r.once.Do(func() {
+		r.err = r.read.Close()
+		if r.release != nil {
+			r.release()
+		}
+	})
+	return r.err
+}
+
+// Prepare only: there are no production callers in this slice. Actual query
+// and durable completion originals must be joined before normal QA binds it.
+func withKnowledgeEmbeddingConsumerOwner(ctx context.Context) context.Context {
+	return interfaces.WithKnowledgeEmbeddingConsumerBoundary(ctx, originalModelAcquisitionContext, retainKnowledgeEmbeddingConsumer)
+}
+func retainKnowledgeEmbeddingConsumer(ctx context.Context, read interfaces.KnowledgeEmbeddingConsumerRead, release func(), transfer func() error) (bool, error) {
+	actual, ok := read.(*repository.KnowledgeSQLiteEmbeddingVectorRead)
+	if !ok || actual == nil || !sameOriginalModelCaller(ctx, actual.Context()) {
+		return false, interfaces.ErrKnowledgeEmbeddingConsumerUnavailable
+	}
+	resource := &knowledgeEmbeddingBoundaryResource{read: actual, release: release}
+	return retainOriginalModelClient(ctx, resource, transfer)
+}
