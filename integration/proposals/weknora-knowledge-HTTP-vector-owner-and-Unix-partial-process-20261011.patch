+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// This fixture is authored by the original historical migration driver. Its
+// tenant and GC rows are legacy business data, not original bodies or grants.
+func peerPartialUnixProcessFixture(t *testing.T, prefix uint) (*sql.DB, string, MigrationOptions) {
+	t.Helper()
+	root := sqliteRepoRoot(t)
+	chdirAndRestore(t, root)
+	pool, dsn, options := jointLineageFixture(t, false)
+	options.AutoRecoverDirty = false
+	old := peerPrefixActualDriver(t, root, "sqlite", dsn, options)
+	closed := false
+	closeOld := func() error {
+		if closed {
+			return nil
+		}
+		closed = true
+		sourceErr, driverErr := old.Close()
+		return errors.Join(sourceErr, driverErr)
+	}
+	t.Cleanup(func() {
+		if err := closeOld(); err != nil {
+			t.Error("owned historical process fixture driver close failed")
+		}
+	})
+	require.NoError(t, old.Migrate(73))
+	require.NoError(t, memoryFullExec(pool, "sqlite", "INSERT INTO tenants(id,name,business) VALUES(7,'partial-process-owned','retained actual process data')"))
+	_, err := pool.Exec("INSERT INTO nextcloud_gc_jobs(id,tenant_id,knowledge_base_id,datasource_id,external_id,knowledge_id,reason,state,not_before,original_not_before,next_attempt_at) VALUES('owned-partial-process-gc',7,'legacy-kb','legacy-source','legacy-file','legacy-knowledge','retired','blocked',CURRENT_TIMESTAMP,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)")
+	require.NoError(t, err)
+	_, err = pool.Exec("INSERT INTO nextcloud_gc_items(job_id,kind,object_ref,state,estimated_bytes,confirmed_released_bytes,lease_token) VALUES('owned-partial-process-gc','source_file','retained legacy process object','blocked',27,3,'')")
+	require.NoError(t, err)
+	require.NoError(t, old.Migrate(prefix), "actual historical 74/75 source creates the nonempty partial ledger")
+	require.NoError(t, closeOld())
+	var journalMode string
+	require.NoError(t, pool.QueryRow("PRAGMA journal_mode=WAL").Scan(&journalMode))
+	require.Equal(t, "wal", journalMode)
+	version, dirty := jointLineageMigrationState(t, pool)
+	require.Equal(t, prefix, version)
+	require.False(t, dirty)
+	return pool, dsn, options
+}
+
+func peerPartialUnixProcessData(t *testing.T, pool *sql.DB) []string {
+	t.Helper()
+	var tenant, gc string
+	require.NoError(t, pool.QueryRow("SELECT business FROM tenants WHERE id=7").Scan(&tenant))
+	require.NoError(t, pool.QueryRow("SELECT kind||'/'||object_ref||'/'||state||'/'||estimated_bytes||'/'||confirmed_released_bytes||'/'||lease_token FROM nextcloud_gc_items WHERE job_id='owned-partial-process-gc'").Scan(&gc))
+	return []string{tenant, gc}
+}
+
+// The unchanged helper uses an independent real process and a real failed OFD
+// acquisition before public Run. PEER_OFD_BLOCKED proves that kernel probe;
+// PEER_UP_COMPLETE plus Cmd.Wait proves the public operation completed. It does
+// not purport to observe the later public acquire's exact scheduling instant.
+func TestPeerPartialUnixProcessReadinessActual(t *testing.T) {
+	for _, prefix := range []uint{74, 75} {
+		t.Run(fmtJointVersion(prefix), func(t *testing.T) {
+			for _, mode := range []string{"public_remaining_upgrade_restart", "first_migrator_then_public_restart"} {
+				t.Run(mode, func(t *testing.T) {
+					t.Logf("peer_partial_process_platform=%s", runtime.GOOS)
+					pool, dsn, options := peerPartialUnixProcessFixture(t, prefix)
+					before := memoryFullSchemaSnapshot(t, pool, "sqlite")
+					dataBefore := peerPartialUnixProcessData(t, pool)
+					ctx := context.Background()
+					require.ErrorIs(t, VerifyJointSchemaReady(ctx, dsn, options), ErrJointSchemaNotReady)
+					require.ErrorIs(t, VerifyJointSchemaReadyOnDB(ctx, pool, "sqlite"), ErrJointSchemaNotReady)
+					require.Equal(t, before, memoryFullSchemaSnapshot(t, pool, "sqlite"), "both readiness checks are read-only on the nonempty partial")
+					require.Equal(t, dataBefore, peerPartialUnixProcessData(t, pool))
+					version, dirty := jointLineageMigrationState(t, pool)
+					require.Equal(t, prefix, version)
+					require.False(t, dirty)
+					alias := filepath.Join(t.TempDir(), "actual-partial-process-alias.sqlite")
+					require.NoError(t, os.Symlink(options.SQLiteDBPath, alias))
+					originalInfo, err := os.Stat(options.SQLiteDBPath)
+					require.NoError(t, err)
+					aliasInfo, err := os.Stat(alias)
+					require.NoError(t, err)
+					require.True(t, os.SameFile(originalInfo, aliasInfo))
+					held, err := acquirePeerSQLiteMigrationExclusion(ctx, dsn, options)
+					require.NoError(t, err)
+					t.Cleanup(func() {
+						if err := held.Close(); err != nil {
+							t.Error("owned partial inode hold close failed")
+						}
+					})
+					heldContext := context.WithValue(ctx, jointPeerSQLiteMigrationContextKey{}, held)
+					captured, err := selectJointMigrationRoute(heldContext, dsn, options, prefix, false, true)
+					require.NoError(t, err)
+					require.Equal(t, jointHistoricalPeerForwardSource, captured.lineage)
+					var closeFirst func() error
+					if mode == "first_migrator_then_public_restart" {
+						first, err := newJointPeerRouteMigrate(heldContext, "file://"+filepath.ToSlash(captured.directory), dsn, options, prefix, captured)
+						require.NoError(t, err)
+						closed := false
+						closeFirst = func() error {
+							if closed {
+								return nil
+							}
+							closed = true
+							sourceErr, driverErr := first.Close()
+							return errors.Join(sourceErr, driverErr)
+						}
+						t.Cleanup(func() {
+							if err := closeFirst(); err != nil {
+								t.Error("owned first partial migrator close failed")
+							}
+						})
+						child := startPeerSQLiteProcess(t, alias, "up")
+						// On failure close the actual driver then inode descriptor before
+						// the existing child's bounded join/kill cleanup runs.
+						t.Cleanup(func() {
+							if err := errors.Join(closeFirst(), held.Close()); err != nil {
+								t.Error("owned partial migrator release failed")
+							}
+						})
+						peerSQLiteToken(t, child, "PEER_OFD_BLOCKED")
+						require.NoError(t, first.Up(), "real first migrator runs remaining historical SQL and honest 88/89 bridge")
+						require.NoError(t, closeFirst())
+						require.NoError(t, held.Close())
+						peerSQLiteToken(t, child, "PEER_UP_COMPLETE")
+						peerSQLiteJoin(t, child, true)
+					} else {
+						child := startPeerSQLiteProcess(t, alias, "up")
+						t.Cleanup(func() {
+							if err := held.Close(); err != nil {
+								t.Error("owned partial process hold release failed")
+							}
+						})
+						peerSQLiteToken(t, child, "PEER_OFD_BLOCKED")
+						require.NoError(t, held.Close())
+						peerSQLiteToken(t, child, "PEER_UP_COMPLETE")
+						peerSQLiteJoin(t, child, true)
+					}
+					version, dirty = jointLineageMigrationState(t, pool)
+					require.EqualValues(t, 89, version)
+					require.False(t, dirty)
+					require.Equal(t, dataBefore, peerPartialUnixProcessData(t, pool))
+					require.NoError(t, VerifyJointSchemaReady(ctx, dsn, options))
+					require.NoError(t, VerifyJointSchemaReadyOnDB(ctx, pool, "sqlite"))
+					aliasOptions := options
+					aliasOptions.SQLiteDBPath = alias
+					require.NoError(t, VerifyJointSchemaReady(ctx, dsn, aliasOptions))
+					ready := memoryFullSchemaSnapshot(t, pool, "sqlite")
+					require.NoError(t, RunMigrationsWithOptions(dsn, aliasOptions), "same inode honest final lineage restarts through the public router")
+					require.Equal(t, ready, memoryFullSchemaSnapshot(t, pool, "sqlite"))
+					version, dirty = jointLineageMigrationState(t, pool)
+					require.EqualValues(t, 89, version)
+					require.False(t, dirty)
+					require.Equal(t, dataBefore, peerPartialUnixProcessData(t, pool))
+					var facts int
+					require.NoError(t, pool.QueryRow("SELECT count(*) FROM memory_original_admissions").Scan(&facts))
+					require.Zero(t, facts, "migration never signs legacy data into originals")
+					require.NoError(t, pool.QueryRow("SELECT count(*) FROM model_definition_originals").Scan(&facts))
+					require.Zero(t, facts)
+				})
+			}
+		})
+	}
+}
