@@ -0,0 +1,131 @@
+package database
+
+import (
+	"context"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func runPeerPartialDownAndReadinessActual(t *testing.T, pg bool) {
+	prefixes := []uint{74, 75, 76, 77, 78, 79}
+	if pg {
+		prefixes = []uint{155, 156, 157, 158, 159, 160}
+	}
+	for _, prefix := range prefixes {
+		t.Run(fmtJointVersion(prefix), func(t *testing.T) {
+			for _, mode := range []string{"preupgrade_not_ready_no_mutation", "guarded_down_before_dirty_no_mutation"} {
+				t.Run(mode, func(t *testing.T) {
+					root := sqliteRepoRoot(t)
+					chdirAndRestore(t, root)
+					if pg {
+						require.NotEmpty(t, os.Getenv("WEKNORA_MIGRATION_TEST_POSTGRES_DSN"), "genuine owned feature PostgreSQL required; no skip")
+					}
+					pool, dsn, options := jointLineageFixture(t, pg)
+					dialect, common := "sqlite", uint(73)
+					if pg {
+						dialect, common = "versioned", 154
+						parsed, err := url.Parse(dsn)
+						require.NoError(t, err)
+						q := parsed.Query()
+						q.Set("options", strings.TrimSpace(strings.ReplaceAll(q.Get("options"), "-c app.skip_embedding=true", ""))+" -c app.skip_embedding=false")
+						parsed.RawQuery = q.Encode()
+						dsn = parsed.String()
+					}
+					old := peerPrefixActualDriver(t, root, dialect, dsn, options)
+					closed := false
+					closeOld := func() {
+						if closed {
+							return
+						}
+						closed = true
+						se, de := old.Close()
+						require.NoError(t, se)
+						require.NoError(t, de)
+					}
+					t.Cleanup(closeOld)
+					require.NoError(t, old.Migrate(common))
+					require.NoError(t, memoryFullExec(pool, dialect, "INSERT INTO tenants(id,name,business) VALUES(7,'partial-down-owned','retained actual partial downgrade data')"))
+					if pg {
+						_, err := pool.Exec("INSERT INTO embeddings(source_id,source_type,knowledge_base_id,dimension,content) VALUES('owned-partial-down',1,NULL,2,'retained actual historical vector row')")
+						require.NoError(t, err)
+					} else {
+						_, err := pool.Exec("INSERT INTO nextcloud_gc_jobs(id,tenant_id,knowledge_base_id,datasource_id,external_id,knowledge_id,reason,state,not_before,original_not_before,next_attempt_at) VALUES('owned-partial-down-gc',7,'legacy-kb','legacy-source','legacy-file','legacy-knowledge','retired','blocked',CURRENT_TIMESTAMP,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)")
+						require.NoError(t, err)
+						_, err = pool.Exec("INSERT INTO nextcloud_gc_items(job_id,kind,object_ref,state,estimated_bytes,confirmed_released_bytes,lease_token) VALUES('owned-partial-down-gc','source_file','retained legacy downgrade object','blocked',27,3,'')")
+						require.NoError(t, err)
+					}
+					require.NoError(t, old.Migrate(prefix), "the real old driver, not a fabricated partial ledger")
+					closeOld()
+					before := memoryFullSchemaSnapshot(t, pool, dialect)
+					beforeVersion, beforeDirty := jointLineageMigrationState(t, pool)
+					require.Equal(t, prefix, beforeVersion)
+					require.False(t, beforeDirty)
+					var tenantBefore string
+					require.NoError(t, pool.QueryRow("SELECT business FROM tenants WHERE id=7").Scan(&tenantBefore))
+					var retainedBefore string
+					if pg {
+						require.NoError(t, pool.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&retainedBefore))
+					} else {
+						require.NoError(t, pool.QueryRow("SELECT kind||'/'||object_ref||'/'||state||'/'||estimated_bytes||'/'||confirmed_released_bytes||'/'||lease_token FROM nextcloud_gc_items WHERE job_id='owned-partial-down-gc'").Scan(&retainedBefore))
+					}
+					ctx := context.Background()
+					if mode == "preupgrade_not_ready_no_mutation" {
+						require.ErrorIs(t, VerifyJointSchemaReady(ctx, dsn, options), ErrJointSchemaNotReady, "migration-eligible partial is not application-ready")
+						require.Equal(t, before, memoryFullSchemaSnapshot(t, pool, dialect))
+						require.ErrorIs(t, VerifyJointSchemaReadyOnDB(ctx, pool, dialect), ErrJointSchemaNotReady, "the actual partial pool is not ready either")
+					} else {
+						if !pg {
+							held, err := acquirePeerSQLiteMigrationExclusion(ctx, dsn, options)
+							require.NoError(t, err)
+							t.Cleanup(func() { require.NoError(t, held.Close()) })
+							ctx = context.WithValue(ctx, jointPeerSQLiteMigrationContextKey{}, held)
+						}
+						captured, err := selectJointMigrationRoute(ctx, dsn, options, prefix, false, true)
+						require.NoError(t, err)
+						require.Equal(t, jointHistoricalPeerForwardSource, captured.lineage)
+						guarded, err := newJointPeerRouteMigrate(ctx, "file://"+filepath.ToSlash(captured.directory), dsn, options, prefix, captured)
+						require.NoError(t, err)
+						guardedClosed := false
+						closeGuarded := func() {
+							if guardedClosed {
+								return
+							}
+							guardedClosed = true
+							se, de := guarded.Close()
+							require.NoError(t, se)
+							require.NoError(t, de)
+						}
+						t.Cleanup(closeGuarded)
+						require.ErrorIs(t, guarded.Down(), ErrJointSchemaPartialPeerDowngrade, "real migrate4.19.1 must refuse before first backward SetVersion(true), historical SQL or dirty ledger")
+						closeGuarded()
+					}
+					require.Equal(t, before, memoryFullSchemaSnapshot(t, pool, dialect), "all actual schema/data bytes survive refusal")
+					version, dirty := jointLineageMigrationState(t, pool)
+					require.Equal(t, beforeVersion, version)
+					require.Equal(t, beforeDirty, dirty)
+					var tenantAfter, retainedAfter string
+					require.NoError(t, pool.QueryRow("SELECT business FROM tenants WHERE id=7").Scan(&tenantAfter))
+					require.Equal(t, tenantBefore, tenantAfter)
+					if pg {
+						require.NoError(t, pool.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&retainedAfter))
+					} else {
+						require.NoError(t, pool.QueryRow("SELECT kind||'/'||object_ref||'/'||state||'/'||estimated_bytes||'/'||confirmed_released_bytes||'/'||lease_token FROM nextcloud_gc_items WHERE job_id='owned-partial-down-gc'").Scan(&retainedAfter))
+					}
+					require.Equal(t, retainedBefore, retainedAfter)
+				})
+			}
+		})
+	}
+}
+
+func TestPeerPartialDownAndReadinessActualSQLite(t *testing.T) {
+	runPeerPartialDownAndReadinessActual(t, false)
+}
+func TestPostgresPeerPartialDownAndReadinessActual(t *testing.T) {
+	runPeerPartialDownAndReadinessActual(t, true)
+}
