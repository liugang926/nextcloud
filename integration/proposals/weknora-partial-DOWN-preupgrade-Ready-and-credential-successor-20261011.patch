+var ErrJointSchemaPartialPeerDowngrade = errors.New("joint_schema_partial_peer_downgrade_refused")
+
+// migrate4.19.1 calls SetVersion(TargetVersion,true) BEFORE reading the SQL
+// into Driver.Run. For an exact captured historical partial, reject a backward
+// target here without changing the ledger or invoking any historical DOWN.
+// Up targets remain forward, while161/80 and the honest169+/88+ tails retain
+// their original SQL-level refusal and resulting dirty state.
+func (d *jointPeerRouteMigrationDriver) SetVersion(version int, dirty bool) error {
+	dialect := jointLineageDialect(d.dsn, d.options)
+	last := uint(161)
+	if dialect == "sqlite" {
+		last = 80
+	}
+	partial := jointPeerHistoricalPrefixVersion(dialect, d.version) && d.version != last
+	if partial && (version < 0 || uint(version) < d.version) {
+		return ErrJointSchemaPartialPeerDowngrade
+	}
+	return d.Driver.SetVersion(version, dirty)
+}
