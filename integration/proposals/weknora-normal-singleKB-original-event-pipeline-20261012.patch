+)
+
+type knowledgeOriginalQueryDependencies struct {
+	material         *repository.KnowledgeInputProvenanceStore
+	models           interfaces.ModelRepository
+	configuredEngine *repository.KnowledgeSQLiteEmbeddingStore
+}
+
+// ConfigureKnowledgeBaseOriginalQueryEngine is the separate composition step
+// for a real original backend. The legacy default registry is not adopted by
+// injecting dependencies alone. Production calls this only after that backend's
+// startup qualification; explicit original fixtures use the actual engine.
+func ConfigureKnowledgeBaseOriginalQueryEngine(base interfaces.KnowledgeBaseService, engine *retriever.CompositeRetrieveEngine) error {
+	s, ok := base.(*knowledgeBaseService)
+	if !ok || s == nil || engine == nil {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	deps := s.originalQueryDependencies()
+	if deps == nil {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	store, err := engine.OriginalKnowledgeQueryStore(context.Background(), deps.material, deps.models)
+	if err != nil {
+		return err
+	}
+	s.originalQueryMu.Lock()
+	defer s.originalQueryMu.Unlock()
+	if s.originalQueryDeps != deps || deps.configuredEngine != nil {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	s.originalQueryDeps = &knowledgeOriginalQueryDependencies{material: deps.material, models: deps.models, configuredEngine: store}
+	return nil
+}
+
+// ConfigureKnowledgeBaseOriginalQueries binds composition-root dependencies.
+// The actual engine getter checks all three SQL pools before returning its
+// existing original store. Neither these dependencies nor a query selector
+// supply a read grant.
+func ConfigureKnowledgeBaseOriginalQueries(base interfaces.KnowledgeBaseService, material *repository.KnowledgeInputProvenanceStore, models interfaces.ModelRepository) error {
+	s, ok := base.(*knowledgeBaseService)
+	if !ok || s == nil || material == nil || models == nil {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	s.originalQueryMu.Lock()
+	defer s.originalQueryMu.Unlock()
+	if s.originalQueryDeps != nil {
+		if s.originalQueryDeps.material != material || s.originalQueryDeps.models != models {
+			return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		return nil
+	}
+	s.originalQueryDeps = &knowledgeOriginalQueryDependencies{material: material, models: models}
+	return nil
+}
+
+func (s *knowledgeBaseService) originalQueryDependencies() *knowledgeOriginalQueryDependencies {
+	if s == nil {
+		return nil
+	}
+	s.originalQueryMu.RLock()
+	deps := s.originalQueryDeps
+	s.originalQueryMu.RUnlock()
+	return deps
+}
+
+type normalKnowledgeQueryTurnKey struct{}
+type normalKnowledgeQueryTurn struct {
+	base             *knowledgeBaseService
+	session, message string
+	kb, text         string
+	caller           types.Caller
+	owner            context.Context
+	answerSelector   string
+	mu               sync.Mutex
+	nativeResults    map[string]types.SearchResult
+}
+
+func normalKnowledgeQueryTurnFromContext(ctx context.Context) *normalKnowledgeQueryTurn {
+	if ctx == nil {
+		return nil
+	}
+	turn, _ := ctx.Value(normalKnowledgeQueryTurnKey{}).(*normalKnowledgeQueryTurn)
+	return turn
+}
+
+func (s *sessionService) bindNormalKnowledgeQueryTurn(ctx context.Context, req *types.QARequest, kbIDs, knowledgeIDs []string) (context.Context, bool, error) {
+	base, ok := s.knowledgeBaseService.(*knowledgeBaseService)
+	if !ok || base.originalQueryDependencies() == nil || base.originalQueryDependencies().configuredEngine == nil {
+		return ctx, false, nil
+	}
+	if ctx == nil || ctx.Err() != nil || req == nil || req.Session == nil || len(kbIDs) != 1 || len(knowledgeIDs) != 0 || req.UserMessageID == "" || req.CustomAgent != nil || req.SharedAgentReadOnly || len(req.TagScopes) != 0 || len(req.Attachments) != 0 || len(req.ImageURLs) != 0 || req.ImageDescription != "" || req.QuotedContext != "" {
+		return ctx, true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	caller := types.CallerFromContext(ctx)
+	principal, present := types.PrincipalFromContext(ctx)
+	if !present || principal.Type != types.PrincipalWebUser || principal.ID != caller.UserID || caller.UserID == "" || caller.TenantID == 0 || req.Session.TenantID != caller.TenantID || req.Session.UserID != caller.UserID {
+		return ctx, true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	parents, err := messageMaterialBoundarySnapshots(ctx)
+	if err != nil {
+		return ctx, true, err
+	}
+	if len(parents) != 1 || len(parents[0].Messages) != 1 || len(parents[0].Proofs) != 1 || parents[0].Messages[0] == nil || parents[0].Proofs[0] == nil {
+		return ctx, true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	m, proof := parents[0].Messages[0], parents[0].Proofs[0]
+	if m.ID != req.UserMessageID || m.SessionID != req.Session.ID || m.Role != "user" || !m.IsCompleted || m.Content == "" || req.Query != m.Content || proof.MessageID != m.ID || proof.SessionID != req.Session.ID || proof.TenantID != caller.TenantID || proof.AdmissionID == "" || proof.GenerationID == "" || proof.BodyDigest == "" || proof.SourceLineage == nil || proof.SourceLineage.RequireComplete() != nil || len(proof.SourceLineage.Sources) != 0 {
+		return ctx, true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	bound, err := bindKnowledgeQueryMessageOriginal(ctx, req.Session.ID, req.UserMessageID)
+	if err != nil {
+		return ctx, true, err
+	}
+	turn := &normalKnowledgeQueryTurn{base: base, session: req.Session.ID, message: req.UserMessageID, kb: kbIDs[0], text: m.Content, caller: caller, owner: ctx, answerSelector: req.SummaryModelID}
+	return context.WithValue(bound, normalKnowledgeQueryTurnKey{}, turn), true, nil
+}
+
+func checkNormalKnowledgeQueryTurn(ctx context.Context, turn *normalKnowledgeQueryTurn) error {
+	if turn == nil || turn.base == nil || turn.owner == nil || ctx == nil || ctx.Err() != nil || turn.owner.Err() != nil || types.CallerFromContext(ctx) != turn.caller || !sameKnowledgeQueryOwnedCaller(ctx, turn.owner) {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return CheckMessageMaterialOutputBoundary(ctx)
+}
+
+// OriginalKnowledgeQuerySearch is an optional concrete service boundary used by
+// the actual event plugin. Its bool reports whether an existing private turn is
+// present; it never grants access. Unsupported shapes in that turn stay closed.
+func (s *knowledgeBaseService) OriginalKnowledgeQuerySearch(ctx context.Context, cm *types.ChatManage) ([]*types.SearchResult, bool, error) {
+	turn := normalKnowledgeQueryTurnFromContext(ctx)
+	if turn == nil {
+		return nil, false, nil
+	}
+	if turn.base != s || cm == nil || cm.Query != turn.text || cm.RewriteQuery != turn.text || len(cm.SearchTargets) != 1 || cm.SearchTargets[0] == nil || cm.SearchTargets[0].Type != types.SearchTargetTypeKnowledgeBase || cm.SearchTargets[0].KnowledgeBaseID != turn.kb || cm.SearchTargets[0].TenantID != turn.caller.TenantID || len(cm.SearchTargets[0].KnowledgeIDs) != 0 || len(cm.SearchTargets[0].TagIDs) != 0 || len(cm.SearchTargets[0].ScopeTagIDs) != 0 {
+		return nil, true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := validateNormalKnowledgeQueryPipeline(ctx, cm); err != nil {
+		return nil, true, err
+	}
+	results, err := s.HybridSearch(ctx, turn.kb, types.SearchParams{QueryText: turn.text, KnowledgeBaseIDs: []string{turn.kb}, MatchCount: cm.EmbeddingTopK, VectorThreshold: cm.VectorThreshold, DisableKeywordsMatch: true, SkipContextEnrichment: true})
+	return results, true, err
+}
+
+func validateNormalKnowledgeQueryPipeline(ctx context.Context, cm *types.ChatManage) error {
+	turn := normalKnowledgeQueryTurnFromContext(ctx)
+	if turn == nil {
+		return nil
+	}
+	if err := checkNormalKnowledgeQueryTurn(ctx, turn); err != nil {
+		return err
+	}
+	if cm == nil || cm.Query != turn.text || cm.RewriteQuery != turn.text || cm.SessionID != turn.session || cm.UserMessageID != turn.message || cm.MaxRounds != 0 || len(cm.History) != 0 || cm.EnableRewrite || cm.EnableQueryExpansion || cm.WebSearchEnabled || cm.WebFetchEnabled || cm.DataAnalysisEnabled || len(cm.Images) != 0 || len(cm.Attachments) != 0 || cm.ImageDescription != "" || cm.QuotedContext != "" || len(cm.Entity) != 0 || cm.GraphResult != nil || cm.MemoryReadContext != nil || cm.MemoryPrompt != "" || len(cm.UsedMemories) != 0 || cm.RerankModelID != "" {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return nil
+}
+
+func (s *knowledgeBaseService) originalKnowledgeQuery(ctx context.Context, kb *types.KnowledgeBase, text string) (context.Context, *types.KnowledgeQueryEmbeddingVectorSnapshot, *retriever.CompositeRetrieveEngine, error) {
+	turn := normalKnowledgeQueryTurnFromContext(ctx)
+	deps := s.originalQueryDependencies()
+	if turn == nil || turn.base != s || deps == nil || kb == nil || kb.ID != turn.kb || kb.TenantID != turn.caller.TenantID || text != turn.text || !kb.IsVectorEnabled() || kb.EmbeddingModelID == "" || kb.Type == types.KnowledgeBaseTypeFAQ || kb.IndexingStrategy.GraphEnabled || kb.IndexingStrategy.GraphRequired || kb.IndexingStrategy.WikiEnabled {
+		return nil, nil, nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := checkNormalKnowledgeQueryTurn(ctx, turn); err != nil {
+		return nil, nil, nil, err
+	}
+	if err := s.authorizeKBAccess(ctx, []*types.KnowledgeBase{kb}); err != nil {
+		return nil, nil, nil, err
+	}
+	if err := s.checkSearchGroupAccess(ctx, []*types.KnowledgeBase{kb}); err != nil {
+		return nil, nil, nil, err
+	}
+	resolve, cancel := context.WithTimeout(ctx, storeResolveBudget)
+	engine, err := retriever.CreateRetrieveEngineForKB(resolve, s.retrieveEngine, s.ownership, kb.TenantID, kb.VectorStoreID)
+	cancel()
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	store, err := engine.OriginalKnowledgeQueryStore(ctx, deps.material, deps.models)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	// A precomputed float slice cannot install or replace this private result.
+	if _, _, err := knowledgeQueryOwnedContext(ctx, kb.ID, kb.EmbeddingModelID); err != nil {
+		if err = ensureNormalKnowledgeQueryUnopened(ctx); err != nil {
+			return nil, nil, nil, err
+		}
+		if _, err = EmbedOriginalKnowledgeQuery(ctx, store, s.modelService, kb.ID, kb.EmbeddingModelID); err != nil {
+			return nil, nil, nil, err
+		}
+	}
+	owned, snapshot, err := knowledgeQueryOwnedContext(ctx, kb.ID, kb.EmbeddingModelID)
+	return owned, snapshot, engine, err
+}
+
+func ensureNormalKnowledgeQueryUnopened(ctx context.Context) error {
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok || slot == nil {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	slot.mu.Lock()
+	defer slot.mu.Unlock()
+	if slot.Closed || slot.Failed != nil {
+		return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	for _, resource := range slot.Models {
+		if _, present := resource.(*knowledgeQueryBoundaryResource); present {
+			return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+	}
+	return nil
+}
+
+func (s *knowledgeBaseService) originalHybridSearch(ctx context.Context, kb *types.KnowledgeBase, kbs []*types.KnowledgeBase, params types.SearchParams, matchCount int) ([]*types.SearchResult, error) {
+	turn := normalKnowledgeQueryTurnFromContext(ctx)
+	if turn == nil || len(kbs) != 1 || len(params.KnowledgeIDs) != 0 || len(params.TagIDs) != 0 || len(params.ScopeTagIDs) != 0 || params.OnlyRecommended || params.DisableVectorMatch || !params.DisableKeywordsMatch || !params.SkipContextEnrichment {
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if len(params.QueryEmbedding) != 0 {
+		_, existing, err := knowledgeQueryOwnedContext(ctx, kb.ID, kb.EmbeddingModelID)
+		if err != nil {
+			return nil, err
+		}
+		if len(params.QueryEmbedding) != len(existing.Vector) {
+			return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		for i, value := range params.QueryEmbedding {
+			if math.Float32bits(value) != math.Float32bits(existing.Vector[i]) {
+				return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+		}
+	}
+	owned, snapshot, engine, err := s.originalKnowledgeQuery(ctx, kb, params.QueryText)
+	if err != nil {
+		return nil, err
+	}
+	// Only the actual private result supplies the native vector and space.
+	native, err := engine.Retrieve(owned, []types.RetrieveParams{{Query: turn.text, Embedding: append([]float32(nil), snapshot.Vector...), KnowledgeBaseIDs: []string{kb.ID}, TopK: matchCount, Threshold: params.VectorThreshold, RetrieverType: types.VectorRetrieverType, AdditionalParams: map[string]interface{}{"embedding_space_digest": snapshot.SpaceDigest}}})
+	if err != nil {
+		return nil, err
+	}
+	lineage, err := normalKnowledgeNativeLineage(owned)
+	if err != nil {
+		return nil, err
+	}
+	results := []*types.SearchResult{}
+	seen := map[string]bool{}
+	for _, group := range native {
+		if group == nil || group.Error != nil || group.RetrieverEngineType != types.SQLiteRetrieverEngineType || group.RetrieverType != types.VectorRetrieverType {
+			return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		for _, item := range group.Results {
+			if item == nil || item.ChunkID == "" || item.KnowledgeID == "" || item.KnowledgeBaseID != kb.ID || item.Content == "" || seen[item.ChunkID] || item.MatchType != types.MatchTypeEmbedding {
+				return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			seen[item.ChunkID] = true
+			// Plaintext is taken from the checked native reader's original input,
+			// not hydrated a second time from an unbound current chunk/DTO.
+			results = append(results, &types.SearchResult{ID: item.ChunkID, Content: item.Content, KnowledgeID: item.KnowledgeID, KnowledgeBaseID: item.KnowledgeBaseID, Score: item.Score, MatchType: item.MatchType, ChunkType: string(types.ChunkTypeText), ContentRewritten: true, SourceLineage: lineage})
+		}
+	}
+	if len(results) == 0 {
+		// Immutable absence is a different protocol; no chat fallback borrows
+		// this query receipt when the native candidate/output set is empty.
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if len(results) > params.MatchCount {
+		results = results[:params.MatchCount]
+	}
+	if _, _, err = knowledgeQueryOwnedContext(owned, kb.ID, kb.EmbeddingModelID); err != nil {
+		return nil, err
+	}
+	if err = s.authorizeKBAccess(owned, kbs); err != nil {
+		return nil, err
+	}
+	if err = s.checkSearchGroupAccess(owned, kbs); err != nil {
+		return nil, err
+	}
+	captured := map[string]types.SearchResult{}
+	for _, result := range results {
+		copy := *result
+		copy.SourceLineage, err = types.UnionSourceLineage(result.SourceLineage)
+		if err != nil {
+			return nil, err
+		}
+		captured[result.ID] = copy
+	}
+	turn.mu.Lock()
+	if turn.nativeResults != nil {
+		turn.mu.Unlock()
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	turn.nativeResults = captured
+	turn.mu.Unlock()
+	return results, nil
+}
+
+// The first event slice permits filtering/ordering of genuine native text,
+// but cannot add neighbor/history/rewritten content as a new input influence.
+func checkNormalKnowledgeQueryResults(ctx context.Context, cm *types.ChatManage) error {
+	turn := normalKnowledgeQueryTurnFromContext(ctx)
+	if turn == nil {
+		return nil
+	}
+	turn.mu.Lock()
+	captured := make(map[string]types.SearchResult, len(turn.nativeResults))
+	for id, result := range turn.nativeResults {
+		captured[id] = result
+	}
+	turn.mu.Unlock()
+	for _, results := range [][]*types.SearchResult{cm.SearchResult, cm.RerankResult, cm.MergeResult} {
+		seen := map[string]bool{}
+		for _, result := range results {
+			if result == nil || seen[result.ID] {
+				return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			want, exists := captured[result.ID]
+			if !exists || !reflect.DeepEqual(want, *result) {
+				return repository.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			seen[result.ID] = true
+		}
+	}
+	return nil
+}
+
+// OriginalKnowledgeQueryMerge selects only the already checked native output.
+// It deliberately cannot refresh a parent/neighbor body or replay history.
+func (s *knowledgeBaseService) OriginalKnowledgeQueryMerge(ctx context.Context, cm *types.ChatManage) (bool, error) {
+	turn := normalKnowledgeQueryTurnFromContext(ctx)
+	if turn == nil {
+		return false, nil
+	}
+	if turn.base != s {
+		return true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := validateNormalKnowledgeQueryPipeline(ctx, cm); err != nil {
+		return true, err
+	}
+	if err := checkNormalKnowledgeQueryResults(ctx, cm); err != nil {
+		return true, err
+	}
+	if _, err := normalKnowledgeQueryResultsContext(ctx, cm); err != nil {
+		return true, err
+	}
+	if _, err := normalKnowledgeNativeLineage(ctx); err != nil {
+		return true, err
+	}
+	if len(cm.SearchResult) == 0 || len(cm.RerankResult) != 0 {
+		return true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	cm.MergeResult = append([]*types.SearchResult(nil), cm.SearchResult...)
+	return true, nil
+}
+
+func normalKnowledgeNativeLineage(ctx context.Context) (*types.SourceLineage, error) {
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok || slot == nil {
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	queries := []*repository.KnowledgeQueryEmbeddingResultRead{}
+	vectors := []*repository.KnowledgeSQLiteEmbeddingVectorRead{}
+	slot.mu.Lock()
+	closed, failed := slot.Closed, slot.Failed
+	for _, resource := range slot.Models {
+		switch actual := resource.(type) {
+		case *knowledgeQueryBoundaryResource:
+			if actual != nil && actual.read != nil && actual.retained.Load() {
+				queries = append(queries, actual.read)
+			}
+		case *knowledgeEmbeddingBoundaryResource:
+			if actual != nil && actual.read != nil && actual.query != nil {
+				vectors = append(vectors, actual.read)
+			}
+		}
+	}
+	slot.mu.Unlock()
+	if closed || failed != nil || len(queries) != 1 || len(vectors) != 1 {
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	_, consumptions, err := repository.WithActualKnowledgeCompletionReads(ctx, queries, vectors)
+	if err != nil || len(consumptions) != 1 {
+		if err != nil {
+			return nil, err
+		}
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return types.UnionSourceLineage(consumptions[0].SourceLineage)
+}
+
+func (s *sessionService) originalKnowledgeScopedCaller(ctx context.Context) (bool, error) {
+	if normalKnowledgeQueryTurnFromContext(ctx) == nil || s.groupAccess == nil {
+		return false, nil
+	}
+	caller := types.CallerFromContext(ctx)
+	role, err := s.groupAccess.EffectiveTenantRole(ctx, caller.UserID, caller.TenantID, time.Now().UTC())
+	return err == nil && role.ScopedOnly, err
+}
+
+func normalKnowledgeQueryResultsContext(ctx context.Context, cm *types.ChatManage) (context.Context, error) {
+	turn := normalKnowledgeQueryTurnFromContext(ctx)
+	if turn == nil {
+		return ctx, nil
+	}
+	if err := validateNormalKnowledgeQueryPipeline(ctx, cm); err != nil {
+		return nil, err
+	}
+	// The actual KB model selector is loaded again, not taken from a model string
+	// in the request or from returned vector metadata.
+	kb, err := turn.base.repo.GetKnowledgeBaseByID(ctx, turn.kb)
+	if err != nil {
+		return nil, err
+	}
+	bound, _, err := knowledgeQueryOwnedContext(ctx, kb.ID, kb.EmbeddingModelID)
+	return bound, err
+}
