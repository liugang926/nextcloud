+				default:
+					t.Fatal("actual normal answer save missing")
+				}
+				var stored types.Message
+				require.NoError(t, f.DB.Where("id=? AND session_id=?", assistant.ID, session.ID).Take(&stored).Error)
+				require.True(t, stored.IsCompleted)
+				require.Equal(t, normalOriginalEventAnswer, stored.Content)
+				require.NotNil(t, stored.SourceLineage)
+				require.NoError(t, stored.SourceLineage.RequireComplete())
+				require.Len(t, stored.SourceLineage.Sources, 1)
+				require.Equal(t, f.Knowledge, stored.SourceLineage.Sources[0].KnowledgeID)
+				var manifest struct{ ManifestDigest string }
+				require.NoError(t, f.DB.Table("message_completion_input_manifests m").Select("m.manifest_digest").Joins("JOIN message_material_admissions a ON a.id=m.assistant_admission_id").Where("a.message_id=? AND a.session_id=?", assistant.ID, session.ID).Take(&manifest).Error)
+				require.NotEmpty(t, manifest.ManifestDigest)
+				require.NoError(t, check())
+				var live int64
+				require.NoError(t, f.DB.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&live).Error)
+				require.Positive(t, live, "provider Done/producer returned must not drop the live HTTP owner")
+			} else {
+				require.Equal(t, before, personalCompletionFactsForTest(t, f.DB, f.Knowledge, assistant.ID))
+			}
+		})
+	}
+}
+
+// Read-only observer delegates to the real original client and fails if the
+// true retained query/HTTP owner/caller/RAG scope did not reach answer creation.
+type normalEventOriginalModelsObserver struct {
+	interfaces.ModelService
+	expected          context.Context
+	kb, model, answer string
+	report            func(error)
+}
+
+func (m normalEventOriginalModelsObserver) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	if id != m.answer {
+		return nil, errors.New("normal answer selector changed")
+	}
+	if err := normalEventOriginalContextCheck(ctx, m.expected, m.kb, m.model); err != nil {
+		m.report(err)
+		return nil, err
+	}
+	return m.ModelService.GetChatModel(ctx, id)
+}
+func normalEventOriginalContextCheck(ctx, owner context.Context, kb, model string) error {
+	if ctx == nil || owner == nil || ctx.Err() != nil || types.CallerFromContext(ctx) != types.CallerFromContext(owner) {
+		return errors.New("normal original caller context changed")
+	}
+	actual, ok := types.PrincipalFromContext(ctx)
+	wanted, wantOK := types.PrincipalFromContext(owner)
+	if !ok || !wantOK || !reflect.DeepEqual(actual, wanted) || ctx.Value(messageMaterialOutputKey{}) == nil || ctx.Value(messageMaterialOutputKey{}) != owner.Value(messageMaterialOutputKey{}) {
+		return errors.New("normal original principal/owner absent")
+	}
+	if types.RAGSourceLineageFromContext(ctx) == nil {
+		return errors.New("normal source turn context absent")
+	}
+	query, err := repository.KnowledgeQueryEmbeddingResultFromContext(ctx)
+	if err != nil || query == nil {
+		return errors.New("normal actual query result context missing")
+	}
+	snapshot, err := query.Snapshot()
+	if err != nil {
+		return err
+	}
+	if snapshot.KnowledgeBaseID != kb || snapshot.ModelID != model || snapshot.SpaceDigest == "" || len(snapshot.Vector) != 2 {
+		return errors.New("normal actual query binding changed")
+	}
+	return nil
+}
