+}
+
+func scopedKnowledgeOpening(ctx context.Context, store *KnowledgeSQLiteEmbeddingStore, leases map[string]originalBodyLease, payloads map[string]originalBodyPayload, content []NextcloudContentLease, owned int) scopedKnowledgeModelOpening {
