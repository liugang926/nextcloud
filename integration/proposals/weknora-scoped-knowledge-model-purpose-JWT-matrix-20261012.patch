+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+// Real tenantless Register/Login -> complete directory snapshot/LinkIdentity ->
+// genuine signed source grant -> production JWT middleware. ScopedOnly is a
+// virtual Viewer entry; no tenant member or directory role is manufactured.
+func TestScopedKnowledgeOriginalModelPurposeActualSQLiteJWT(t *testing.T) {
+	for _, mode := range []string{
+		"configured_source_query_vector_answer_completion",
+		"bare_current_unrelated_model",
+		"bare_current_configured_model",
+		"bare_historical_unrelated_model",
+		"bare_historical_configured_model",
+		"other_inherited_KB_query_denied",
+		"other_source_KB_query_denied",
+		"Agent_and_unrelated_answer_override_denied",
+		"sourced_named_history_no_borrowed_purpose",
+		"query_grant_withdrawn_after_SDK",
+		"selected_history_grant_withdrawn",
+		"ordinary_direct_member_role_preserved",
+	} {
+		t.Run(mode, func(t *testing.T) {
+			f := service.NewScopedKnowledgePurposeFixtureForTest(t)
+			userRepo := repository.NewUserRepository(f.DB)
+			tokens := repository.NewAuthTokenRepository(f.DB)
+			tenants := service.NewTenantService(repository.NewTenantRepository(f.DB), repository.NewStorageBackendRepository(f.DB))
+			members := service.NewTenantMemberService(repository.NewTenantMemberRepository(f.DB), nil, userRepo, tokens)
+			users := service.NewUserService(f.Config, userRepo, tokens, tenants, members, nil, repository.NewDirectoryRepository(f.DB), f.Groups)
+			email := "a10-" + uuid.NewString() + "@example.test"
+			password := "Actual-owned-A10-passphrase-71!"
+			user, err := users.Register(context.Background(), &types.RegisterRequest{Username: "actual-a10-" + uuid.NewString()[:8], Email: email, Password: password, TenantProvisioning: types.TenantProvisioningTenantless})
+			require.NoError(t, err)
+			require.NotNil(t, user)
+			require.Zero(t, user.TenantID)
+			require.False(t, user.IsSystemAdmin)
+			// A genuinely issued JWT predates linking; password login is not retried
+			// after linking, where production properly refuses directory-managed auth.
+			login, err := users.Login(context.Background(), &types.LoginRequest{Email: email, Password: password})
+			require.NoError(t, err)
+			require.True(t, login.Success)
+			require.NotEmpty(t, login.Token)
+			var directory types.Directory
+			require.NoError(t, f.DB.Where("id=?", f.Directory).Take(&directory).Error)
+			directorySvc := service.NewDirectoryService(repository.NewDirectoryRepository(f.DB))
+			guid := "aabbccdd-0011-2233-4455-667788990011"
+			snapshot := &types.DirectorySnapshot{DirectoryID: f.Directory, ExpectedConfigVersion: directory.ConfigVersion, Complete: true, PaginationComplete: true, StartedAt: time.Now().UTC(), Identities: []types.DirectoryIdentitySnapshot{
+				{ObjectGUID: f.CreatorGUID, DN: "cn=actual-creator,ou=People,dc=example,dc=test", SAMAccountName: "actual-creator", UPN: "actual-creator@example.test", Enabled: true},
+				{ObjectGUID: guid, DN: "cn=actual-a10,ou=People,dc=example,dc=test", SAMAccountName: "actual-a10", UPN: email, Email: email, Enabled: true},
+			}}
+			applied, err := directorySvc.ApplySnapshot(f.Creator, snapshot)
+			require.NoError(t, err)
+			require.NotNil(t, applied)
+			var identity types.DirectoryIdentity
+			require.NoError(t, f.DB.Where("directory_id=? AND object_guid=? AND status=?", f.Directory, guid, types.DirectoryObjectActive).Take(&identity).Error)
+			require.Nil(t, identity.UserID)
+			require.NoError(t, directorySvc.LinkIdentity(f.Creator, identity.ID, user.ID))
+			require.NoError(t, f.DB.Where("id=?", identity.ID).Take(&identity).Error)
+			require.NotNil(t, identity.UserID)
+			require.Equal(t, user.ID, *identity.UserID)
+			require.NoError(t, f.Grant(f.Creator, guid, true))
+			var directMembers, groupRoles int64
+			require.NoError(t, f.DB.Model(&types.TenantMember{}).Where("tenant_id=? AND user_id=? AND status=? AND deleted_at IS NULL", 7, user.ID, types.TenantMemberStatusActive).Count(&directMembers).Error)
+			require.Zero(t, directMembers)
+			require.NoError(t, f.DB.Model(&types.TenantGroupRoleGrant{}).Where("tenant_id=?", 7).Count(&groupRoles).Error)
+			require.Zero(t, groupRoles)
+			effective, err := f.Groups.EffectiveTenantRole(context.Background(), user.ID, 7, time.Now().UTC())
+			require.NoError(t, err)
+			require.True(t, effective.Member)
+			require.True(t, effective.ScopedOnly)
+			require.Equal(t, types.TenantRoleViewer, effective.Role)
+			require.Nil(t, effective.DirectRole)
+			require.Empty(t, effective.GroupMatches)
+			// No test inserts a Principal/Caller. Only middleware.Auth can supply the
+			// authenticated request context handed to the private-reader fixture.
+			gin.SetMode(gin.TestMode)
+			router := gin.New()
+			router.Use(middleware.Auth(tenants, users, members, nil, f.Config, f.Groups))
+			entered := false
+			router.GET("/api/v1/a10-owned-model-purpose", func(c *gin.Context) {
+				entered = true
+				ctx := c.Request.Context()
+				caller := types.CallerFromContext(ctx)
+				principal, ok := types.PrincipalFromContext(ctx)
+				require.True(t, ok)
+				require.Equal(t, types.PrincipalWebUser, principal.Type)
+				require.Equal(t, user.ID, principal.ID)
+				require.Equal(t, user.ID, caller.UserID)
+				require.EqualValues(t, 7, caller.TenantID)
+				require.Equal(t, types.TenantRoleViewer, caller.Role)
+				current, err := f.Groups.EffectiveTenantRole(ctx, user.ID, 7, time.Now().UTC())
+				require.NoError(t, err)
+				require.True(t, current.ScopedOnly)
+				require.Nil(t, current.DirectRole)
+				f.Run(t, ctx, mode)
+				c.Status(http.StatusNoContent)
+			})
+			request := httptest.NewRequest(http.MethodGet, "/api/v1/a10-owned-model-purpose", nil)
+			request.Header.Set("Authorization", "Bearer "+login.Token)
+			request.Header.Set("X-Tenant-ID", "7")
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, request)
+			require.True(t, entered)
+			require.Equal(t, http.StatusNoContent, response.Code)
+		})
+	}
+}
