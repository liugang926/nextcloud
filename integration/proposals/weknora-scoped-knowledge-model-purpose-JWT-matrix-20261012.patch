index 0000000000000000000000000000000000000000..c2dfa84e8ef7a36c31d01b057b3e00b2c31e6a44
--- /dev/null
+++ b/internal/application/repository/knowledge_scoped_model_read_purpose.go
@@ -0,0 +1,440 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+// No public DTO constructor exists for this purpose. Query and vector
+// producers install their actual private owned reader after real scope checks.
+// A valid original model proof alone is never a scoped model-namespace grant.
+type scopedKnowledgeModelPurposeKey struct{}
+type scopedKnowledgeModelOpening struct {
+	ctx      context.Context
+	store    *KnowledgeSQLiteEmbeddingStore
+	leases   map[string]originalBodyLease
+	payloads map[string]originalBodyPayload
+	content  []NextcloudContentLease
+	owned    int
+}
+type scopedKnowledgeModelPurpose struct {
+	opening        scopedKnowledgeModelOpening
+	kind           string
+	query          *KnowledgeQueryEmbeddingRead
+	vector         *KnowledgeSQLiteEmbeddingVectorRead
+	vectors        []*KnowledgeSQLiteEmbeddingVectorRead
+	modelID, kb    string
+	configRevision uint64
+	configDigest   string
+	historical     *types.ModelOriginalProof
+}
+
+func ScopedKnowledgeModelPurposePresent(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	return ctx.Value(scopedKnowledgeModelPurposeKey{}) != nil
+}
+func scopedKnowledgeModelPurposeContext(ctx context.Context, purpose *scopedKnowledgeModelPurpose) context.Context {
+	return context.WithValue(ctx, scopedKnowledgeModelPurposeKey{}, purpose)
+}
+
+// This callback is used only after the service has refreshed actual
+// EffectiveTenantRole.ScopedOnly. Ordinary members retain their old path.
+// It intentionally does not call a model checker recursively.
+func CheckScopedKnowledgeModelReadPurposeInTx(ctx context.Context, tx *gorm.DB, proof types.ModelOriginalProof, historical bool) (freshResult context.Context, finalErr error) {
+	if ctx == nil || tx == nil || ctx.Err() != nil {
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	purpose, ok := ctx.Value(scopedKnowledgeModelPurposeKey{}).(*scopedKnowledgeModelPurpose)
+	if !ok || purpose == nil || proof.ModelID == "" || proof.ModelID != purpose.modelID {
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	var store *KnowledgeSQLiteEmbeddingStore
+	var held context.Context
+	var leases map[string]originalBodyLease
+	var payloads map[string]originalBodyPayload
+	var content []NextcloudContentLease
+	switch purpose.kind {
+	case "query", "answer":
+		if historical || purpose.query == nil {
+			return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		q := purpose.query
+		if err := q.start(); err != nil {
+			return ctx, err
+		}
+		defer func() {
+			e := q.finish(finalErr)
+			if finalErr == nil {
+				finalErr = e
+			}
+		}()
+		held = purpose.opening.ctx
+		store = purpose.opening.store
+		leases = purpose.opening.leases
+		payloads = purpose.opening.payloads
+		content = append([]NextcloudContentLease(nil), purpose.opening.content...)
+		if q.parent.Plan == nil || q.kb != purpose.kb || purpose.opening.owned == 0 {
+			return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if purpose.kind == "answer" && (q.result == nil || len(purpose.vectors) == 0) {
+			return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+	case "vector":
+		if !historical || purpose.vector == nil || purpose.historical == nil || *purpose.historical != proof {
+			return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		r := purpose.vector
+		if err := r.start(); err != nil {
+			return ctx, err
+		}
+		defer func() {
+			e := r.finish(finalErr)
+			if finalErr == nil {
+				finalErr = e
+			}
+		}()
+		held = purpose.opening.ctx
+		store = purpose.opening.store
+		leases = purpose.opening.leases
+		payloads = purpose.opening.payloads
+		content = append([]NextcloudContentLease(nil), purpose.opening.content...)
+		found := false
+		for _, input := range r.originals {
+			var expected types.ModelOriginalProof
+			if json.Unmarshal([]byte(input.ModelProofJSON), &expected) != nil {
+				return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if input.KnowledgeBaseID == purpose.kb && expected == proof {
+				receipt, has := r.receipts[scopedKnowledgeInputRowID(r, input.ID)]
+				if !has || receipt.InputID != input.ID || receipt.InputDigest != input.Digest || receipt.Dimension != input.ExpectedDimensions {
+					return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+				}
+				found = true
+			}
+		}
+		if !found || len(r.sourceContent) == 0 || r.sourceLineage == nil {
+			return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		q := purpose.query
+		if q == nil {
+			return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if e := q.start(); e != nil {
+			return ctx, e
+		}
+		defer func() {
+			e := q.finish(finalErr)
+			if finalErr == nil {
+				finalErr = e
+			}
+		}()
+		view := q.view()
+		if view.input == nil || view.result == nil || view.kb != purpose.kb || view.proof.ModelID != purpose.modelID || view.input.KBRevision != purpose.configRevision || view.input.KBConfigDigest != purpose.configDigest || !sameOriginalModelCallerInRepository(ctx, view.ctx) {
+			return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		all := map[string]originalBodyLease{}
+		for id, l := range leases {
+			all[id] = l
+		}
+		if e := mergeMemoryFinalLeaseBindings(all, view.leases); e != nil {
+			return ctx, e
+		}
+		bodies := map[string]originalBodyPayload{}
+		for id, b := range payloads {
+			bodies[id] = b
+		}
+		for id, b := range view.payloads {
+			if old, ok := bodies[id]; ok && !reflect.DeepEqual(old, b) {
+				return ctx, ErrOriginalBodyUnavailable
+			}
+			bodies[id] = b
+		}
+		leases = all
+		payloads = bodies
+		content = append(content, view.content...)
+	default:
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if store == nil || held == nil || held.Err() != nil || !sameOriginalModelCallerInRepository(ctx, held) {
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	actual, e := store.db.DB()
+	if e != nil {
+		return ctx, e
+	}
+	pool, e := tx.DB()
+	if e != nil || pool != actual {
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	authority, e := knowledgeSQLiteEmbeddingAuthority(tx, store.material)
+	if e != nil {
+		return ctx, e
+	}
+	fresh, e := authority.RefreshCurrentReadActor(ctx)
+	if e != nil {
+		return ctx, e
+	}
+	if !sameOriginalModelCallerInRepository(fresh, held) {
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	var kb types.KnowledgeBase
+	if e = tx.Where("id=? AND tenant_id=? AND deleted_at IS NULL", purpose.kb, types.CallerFromContext(fresh).TenantID).Take(&kb).Error; e != nil {
+		return ctx, e
+	}
+	selected := kb.EmbeddingModelID
+	if purpose.kind == "answer" {
+		selected = kb.SummaryModelID
+	}
+	if selected == "" || selected != purpose.modelID || !kb.IndexingStrategy.VectorEnabled {
+		return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	dummy := &KnowledgeSQLiteEmbeddingVectorRead{}
+	if e = dummy.authorizeKB(authority, fresh, &kb); e != nil {
+		return ctx, e
+	}
+	revision, e := knowledgeConfigurationControlRevision(tx, kb.ID)
+	if e != nil || revision != purpose.configRevision {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	digest, e := knowledgeConfigurationOriginDigest(&kb)
+	if e != nil || digest != purpose.configDigest {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	// The exact authenticated original selector is fixed by the real producer.
+	// A changed config/old proof cannot retarget an already admitted purpose.
+	var origin knowledgeConfigurationInputOrigin
+	if e = tx.Where("tenant_id=? AND knowledge_base_id=? AND config_revision=?", kb.TenantID, kb.ID, revision).Take(&origin).Error; e != nil {
+		return ctx, e
+	}
+	if origin.InputDigest != digest {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	var lineage types.SourceLineage
+	if json.Unmarshal([]byte(origin.SourceLineage), &lineage) != nil || lineage.RequireComplete() != nil {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	if (purpose.kind == "query" || purpose.kind == "answer") && len(lineage.Sources) != 0 {
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	if purpose.kind == "vector" {
+		r := purpose.vector
+		joined, e := types.UnionSourceLineage(&lineage, r.sourceLineage)
+		if e != nil || !reflect.DeepEqual(joined, r.sourceLineage) {
+			return ctx, types.ErrSourceLineageUnknown
+		}
+	}
+	fences := map[string]nextcloudContentFence{}
+	if purpose.kind == "vector" {
+		fences = purpose.vector.sourceKBFences
+	}
+	if purpose.kind == "answer" {
+		all := map[string]originalBodyLease{}
+		for id, l := range leases {
+			all[id] = l
+		}
+		bodies := map[string]originalBodyPayload{}
+		for id, b := range payloads {
+			bodies[id] = b
+		}
+		for _, r := range purpose.vectors {
+			if r == nil {
+				return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if e = r.start(); e != nil {
+				return ctx, e
+			}
+			joined := r
+			defer func() {
+				err := joined.finish(finalErr)
+				if finalErr == nil {
+					finalErr = err
+				}
+			}()
+			if r.query == nil || r.query.read != purpose.query || r.consumption == nil || !sameOriginalModelCallerInRepository(ctx, r.ctx) || r.ctx.Err() != nil {
+				return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if e = mergeMemoryFinalLeaseBindings(all, r.leases); e != nil {
+				return ctx, e
+			}
+			for id, b := range r.payloads {
+				if old, ok := bodies[id]; ok && !reflect.DeepEqual(old, b) {
+					return ctx, ErrOriginalBodyUnavailable
+				}
+				bodies[id] = b
+			}
+			content, e = knowledgeCompletionSourceLeaseUnion(content, fences, r)
+			if e != nil {
+				return ctx, e
+			}
+			actualLocals, _ := tx.Statement.Context.Value(scopedKnowledgeFinalSourcesKey{}).(map[*KnowledgeSQLiteEmbeddingVectorRead]*knowledgeCompletionSourceLocal)
+			local, found := actualLocals[r]
+			if !found {
+				// Per-SDK source checks may do real remote/physical IO. Final metadata
+				// authorization reuses only the genuine same-TX cap created before IO.
+				if final, ok := tx.Statement.Context.Value(scopedKnowledgeFinalSourcesKey{}).(map[*KnowledgeSQLiteEmbeddingVectorRead]*knowledgeCompletionSourceLocal); ok && final != nil {
+					return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+				}
+				local, e = r.captureCompletionSourceLocalInTx(tx.WithContext(r.ctx))
+				if e != nil {
+					return ctx, e
+				}
+			}
+			if local == nil || local.read != r || local.tx.Statement.ConnPool != tx.Statement.ConnPool {
+				return ctx, ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if e = local.recheckInTx(tx.WithContext(r.ctx)); e != nil {
+				return ctx, e
+			}
+		}
+		leases = all
+		payloads = bodies
+	}
+	if e = knowledgeQueryFinalClockWithKBFencesInTx(tx, leases, payloads, content, fences); e != nil {
+		return ctx, e
+	}
+	return fresh, nil
+}
+func scopedKnowledgeInputRowID(r *KnowledgeSQLiteEmbeddingVectorRead, inputID string) uint64 {
+	for id, input := range r.originals {
+		if input.ID == inputID {
+			return id
+		}
+	}
+	return 0
+}
+
+// Both actual reader and operation contexts are checked. Dropping a private
+// marker from the call context cannot wash a scoped model into a bare SDK.
+func CheckScopedKnowledgeQuerySDKText(ctx, reader context.Context, inputID, inputDigest, text string) (finalErr error) {
+	if !ScopedKnowledgeModelPurposePresent(ctx) && !ScopedKnowledgeModelPurposePresent(reader) {
+		return nil
+	}
+	if ctx == nil || reader == nil || ctx.Err() != nil || reader.Err() != nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	purpose, ok := reader.Value(scopedKnowledgeModelPurposeKey{}).(*scopedKnowledgeModelPurpose)
+	if !ok || purpose == nil || purpose.kind != "query" || purpose.query == nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	q := purpose.query
+	if err := q.start(); err != nil {
+		return err
+	}
+	defer func() {
+		err := q.finish(finalErr)
+		if finalErr == nil {
+			finalErr = err
+		}
+	}()
+	if !sameOriginalModelCallerInRepository(ctx, q.ctx) || q.input == nil || q.input.ID != inputID || q.input.Digest != inputDigest || q.text != text || q.input.ModelID != purpose.modelID {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return nil
+}
+
+// A current-answer purpose is made only from the genuinely retained query and
+// actual native vector consumers. Request/session/default/Agent model strings
+// cannot supply its selector. SummaryModelID comes the actual original KB.
+func BindScopedKnowledgeAnswerModelRead(ctx context.Context, query *KnowledgeQueryEmbeddingResultRead, reads []*KnowledgeSQLiteEmbeddingVectorRead) (bound context.Context, selected string, finalErr error) {
+	if ctx == nil || query == nil || query.read == nil || len(reads) == 0 {
+		return ctx, "", ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	q := query.read
+	if err := q.start(); err != nil {
+		return ctx, "", err
+	}
+	defer func() {
+		err := q.finish(finalErr)
+		if finalErr == nil {
+			finalErr = err
+		}
+	}()
+	if q.input == nil || q.result == nil || !sameOriginalModelCallerInRepository(ctx, q.ctx) {
+		return ctx, "", ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	for _, r := range reads {
+		if r == nil {
+			return ctx, "", ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := r.start(); err != nil {
+			return ctx, "", err
+		}
+		joined := r
+		defer func() {
+			err := joined.finish(finalErr)
+			if finalErr == nil {
+				finalErr = err
+			}
+		}()
+		if r.query == nil || r.query.read != q || r.consumption == nil {
+			return ctx, "", ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := RecheckKnowledgeEmbeddingConsumer(r, query); err != nil {
+			return ctx, "", err
+		}
+	}
+	var modelID, digest string
+	var revision uint64
+	err := q.store.db.WithContext(q.ctx).Transaction(func(tx *gorm.DB) error {
+		kb, e := q.kbInTx(tx, true)
+		if e != nil {
+			return e
+		}
