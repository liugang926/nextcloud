+		f.SetQueryHook(func() error { return f.Grant(f.Creator, "aabbccdd-0011-2233-4455-667788990011", false) })
+		t.Cleanup(func() { f.SetQueryHook(nil) })
+	}
+	query, err := EmbedOriginalKnowledgeQuery(call, f.original, f.Models, kb, f.Embedding.ID)
+	if mode == "other_inherited_KB_query_denied" || mode == "other_source_KB_query_denied" {
+		require.Error(t, err)
+		require.Nil(t, query)
+		require.Equal(t, baseline, f.SDKCalls())
+		return
+	}
+	if mode == "query_grant_withdrawn_after_SDK" {
+		require.Error(t, err)
+		require.Nil(t, query)
+		require.Equal(t, baseline+1, f.SDKCalls())
+		var count int64
+		require.NoError(t, f.DB.Model(&types.NextcloudSourceGrant{}).Where("operation_id=? AND object_guid=?", f.op.OperationID, "aabbccdd-0011-2233-4455-667788990011").Count(&count).Error)
+		require.Zero(t, count)
+		return
+	}
+	require.NoError(t, err)
+	require.NotNil(t, query)
+	snapshot, err := query.Snapshot()
+	require.NoError(t, err)
+	require.Equal(t, f.KB, snapshot.KnowledgeBaseID)
+	require.Equal(t, f.Embedding.Parameters.OriginalEmbedding.SpaceDigest, snapshot.SpaceDigest)
+	resultCtx := query.Context()
+	results, err := f.index.Retrieve(resultCtx, types.RetrieveParams{Embedding: append([]float32(nil), snapshot.Vector...), KnowledgeBaseIDs: []string{f.KB}, KnowledgeIDs: []string{f.Knowledge}, TopK: 1, RetrieverType: types.VectorRetrieverType, AdditionalParams: map[string]interface{}{"embedding_space_digest": snapshot.SpaceDigest}})
+	require.NoError(t, err)
+	require.Len(t, results, 1)
+	require.Len(t, results[0].Results, 1)
+	require.Equal(t, f.Knowledge, results[0].Results[0].KnowledgeID)
+	slot, ok := resultCtx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	require.True(t, ok)
+	vectors := []*repository.KnowledgeSQLiteEmbeddingVectorRead{}
+	queries := []*repository.KnowledgeQueryEmbeddingResultRead{}
+	slot.mu.Lock()
+	for _, resource := range slot.Models {
+		switch c := resource.(type) {
+		case *knowledgeEmbeddingBoundaryResource:
+			vectors = append(vectors, c.read)
+		case *knowledgeQueryBoundaryResource:
+			queries = append(queries, c.read)
+		}
+	}
+	slot.mu.Unlock()
+	require.Len(t, vectors, 1)
+	require.Len(t, queries, 1)
+	_, consumptions, err := repository.WithActualKnowledgeCompletionReads(resultCtx, queries, vectors)
+	require.NoError(t, err)
+	require.Len(t, consumptions, 1)
+	require.NoError(t, consumptions[0].SourceLineage.RequireComplete())
+	require.Len(t, consumptions[0].SourceLineage.Sources, 1)
+	if mode == "selected_history_grant_withdrawn" {
+		require.NoError(t, f.Grant(f.Creator, "aabbccdd-0011-2233-4455-667788990011", false))
+		refusal := vectors[0].Recheck()
+		require.Error(t, refusal)
+		_, _, _, err := PrepareScopedKnowledgeAnswerModel(resultCtx, f.Groups)
+		require.Error(t, err)
+		require.Equal(t, baseline+1, f.SDKCalls())
+		return
+	}
+	bound, answerID, scoped, err := PrepareScopedKnowledgeAnswerModel(resultCtx, f.Groups)
+	require.NoError(t, err)
+	require.True(t, scoped)
+	require.Equal(t, f.Answer.ID, answerID)
+	if mode == "Agent_and_unrelated_answer_override_denied" {
+		agent := &types.CustomAgent{ID: uuid.NewString(), TenantID: 7, Name: "actual unrelated scoped agent", Config: types.CustomAgentConfig{ModelID: f.Unrelated.ID}}
+		require.NoError(t, repository.NewCustomAgentRepository(f.DB).CreateAgent(f.Creator, agent))
+		selector := &sessionService{groupAccess: f.Groups, modelService: f.Models}
+		_, err = selector.resolveChatModelID(resultCtx, &types.QARequest{CustomAgent: agent, Session: session}, []string{f.KB}, nil)
+		require.Error(t, err)
+		_, err = selector.resolveChatModelID(resultCtx, &types.QARequest{SummaryModelID: f.Unrelated.ID, Session: session}, []string{f.KB}, nil)
+		require.Error(t, err)
+		other, err := f.Models.GetChatModel(bound, f.Unrelated.ID)
+		if other != nil {
+			if closed, ok := other.(interface{ CloseOriginal() error }); ok {
+				require.NoError(t, closed.CloseOriginal())
+			}
+		}
+		require.Error(t, err)
+		require.Nil(t, other)
+		require.Equal(t, baseline+1, f.SDKCalls())
+		return
+	}
+	client, err := f.Models.GetChatModel(bound, answerID)
+	require.NoError(t, err)
+	union, err := types.UnionSourceLineage(consumptions[0].SourceLineage)
+	require.NoError(t, err)
+	response, err := client.Chat(bound, []chat.Message{{Role: "user", Content: actual.Content + "\n" + results[0].Results[0].Content, SourceLineage: union}}, &chat.ChatOptions{})
+	require.NoError(t, err)
+	require.Equal(t, personalAnswerText, response.Content)
+	require.Equal(t, baseline+2, f.SDKCalls())
+	require.EqualValues(t, 1, f.ChatCalls())
+	require.NoError(t, f.CallbackError())
+	markMessageMaterialReady(httpctx)
+	require.NoError(t, check())
+	assistant.Content = response.Content
+	assistant.IsCompleted = true
+	assistant.SourceLineage = union
+	require.NoError(t, f.messages.UpdateMessage(bound, assistant))
+	require.NoError(t, check())
+	var manifest struct{ AssistantAdmissionID, ManifestDigest string }
+	require.NoError(t, f.DB.Table("message_completion_input_manifests m").Select("m.assistant_admission_id,m.manifest_digest").Joins("JOIN message_material_admissions a ON a.id=m.assistant_admission_id").Where("a.message_id=? AND a.session_id=? AND a.tenant_id=?", assistant.ID, session.ID, 7).Take(&manifest).Error)
+	require.NotEmpty(t, manifest.ManifestDigest)
+	if mode == "sourced_named_history_no_borrowed_purpose" {
+		// The source-bearing answer really completed above. A subsequent original
+		// query may not convert its historical source lineage into a new purpose.
+		historyOwner, historyCancel := context.WithTimeout(authenticated, 8*time.Second)
+		defer historyCancel()
+		historyHTTP, historyAttach, _, historyRelease := BeginMessageMaterialHTTPBoundary(historyOwner)
+		defer historyRelease()
+		historyCall := historyAttach(historyHTTP)
+		releaseHistory := RetainMessageMaterialHTTPProducer(historyCall)
+		defer releaseHistory()
+		// The existing sourced named-history reader is deliberately closed. The
+		// genuine answer/manifest above remains the positive completion prelude;
+		// rejection here does not claim sourced history replay is implemented.
+		replay, err := f.messages.GetMessage(historyCall, session.ID, assistant.ID)
+		require.Error(t, err)
+		require.Nil(t, replay)
+		require.Equal(t, baseline+2, f.SDKCalls())
+	}
+}
+func (f *ScopedKnowledgePurposeFixtureForTest) AssertNoLiveLeases(t *testing.T) {
+	t.Helper()
+	var body, content int64
+	bodyErr := f.DB.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&body).Error
+	contentErr := f.DB.Table("nextcloud_content_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&content).Error
+	if err := errors.Join(bodyErr, contentErr); err != nil {
+		t.Error(err)
+	}
+	if body != 0 || content != 0 {
+		t.Errorf("actual owned leases remain: body=%d content=%d", body, content)
+	}
+}
