+package service
+
+import (
+	"context"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// Explicit typed-reader bridge. The ordinary selector is unchanged; a scoped
+// source-only caller gets no model from request/session/default/Agent strings.
+func PrepareScopedKnowledgeAnswerModel(ctx context.Context, groups interfaces.GroupAccessService) (context.Context, string, bool, error) {
+	if ctx == nil || ctx.Err() != nil {
+		return ctx, "", true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if groups == nil {
+		return ctx, "", false, nil
+	}
+	caller := types.CallerFromContext(ctx)
+	principal, ok := types.PrincipalFromContext(ctx)
+	if !ok || principal.Type != types.PrincipalWebUser || principal.ID != caller.UserID {
+		return ctx, "", false, nil
+	}
+	role, err := groups.EffectiveTenantRole(ctx, caller.UserID, caller.TenantID, time.Now().UTC())
+	if err != nil {
+		return ctx, "", true, err
+	}
+	if !role.ScopedOnly {
+		return ctx, "", false, nil
+	}
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok || slot == nil {
+		return ctx, "", true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	queries := []*repository.KnowledgeQueryEmbeddingResultRead{}
+	vectors := []*repository.KnowledgeSQLiteEmbeddingVectorRead{}
+	slot.mu.Lock()
+	for _, resource := range slot.Models {
+		switch held := resource.(type) {
+		case *knowledgeQueryBoundaryResource:
+			if held == nil || held.read == nil {
+				slot.mu.Unlock()
+				return ctx, "", true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			queries = append(queries, held.read)
+		case *knowledgeEmbeddingBoundaryResource:
+			if held == nil || held.read == nil || held.query == nil {
+				slot.mu.Unlock()
+				return ctx, "", true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			vectors = append(vectors, held.read)
+		}
+	}
+	slot.mu.Unlock()
+	if len(queries) != 1 || len(vectors) == 0 {
+		return ctx, "", true, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	bound, model, err := repository.BindScopedKnowledgeAnswerModelRead(ctx, queries[0], vectors)
+	return bound, model, true, err
+}
