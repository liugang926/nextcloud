 	knowledgeBaseIDs []string,
 	knowledgeIDs []string,
 ) (string, error) {
+	// Until the normal QA pipeline owns actual query/vector originals, a
+	// scoped-only request stays closed here. Explicit typed callers select and
+	// bind their SummaryModelID with PrepareScopedKnowledgeAnswerModel.
+	if _, model, scoped, err := PrepareScopedKnowledgeAnswerModel(ctx, s.groupAccess); scoped {
+		if err != nil {
+			return "", err
+		}
+		if req.CustomAgent != nil || req.SummaryModelID != "" && req.SummaryModelID != model {
