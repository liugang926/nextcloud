diff --git a/internal/models/embedding/original_query_result.go b/internal/models/embedding/original_query_result.go
new file mode 100644
index 000000000..9be4a8d7c
--- /dev/null
+++ b/internal/models/embedding/original_query_result.go
@@ -0,0 +1,147 @@
+package embedding
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"math"
+	"reflect"
+	"sync"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// This structural read accepts no grant by itself. The repository additionally
+// requires the token's reader to be its own private actual model read object.
+type OriginalQueryModelRead interface {
+	Context() context.Context
+	Snapshot() (*types.Model, *types.ModelOriginalProof, error)
+	Recheck() error
+}
+type originalQuerySDKResultKey struct{}
+
+// Private fields are created only after ExecuteOriginalQuerySDK completes a
+// genuine constructor/SDK response/current recheck. No DTO/signer can fill them.
+type OriginalQuerySDKResult struct {
+	read                                          OriginalQueryModelRead
+	inputID, inputDigest, text, space, recipeJSON string
+	proof                                         types.ModelOriginalProof
+	dimensions                                    int
+	vector                                        []float32
+}
+
+func (r *OriginalQuerySDKResult) Vector() []float32 {
+	if r == nil {
+		return nil
+	}
+	return append([]float32(nil), r.vector...)
+}
+
+// Moving a real capability to its still-live parent operation is not minting
+// one. Commit still compares all private input/model/response identities.
+func (r *OriginalQuerySDKResult) Context(ctx context.Context) context.Context {
+	return context.WithValue(ctx, originalQuerySDKResultKey{}, r)
+}
+func MatchOriginalQuerySDKResult(ctx context.Context, read OriginalQueryModelRead, inputID, inputDigest, text, space string, dimensions int, proof types.ModelOriginalProof, vector []float32) error {
+	r, _ := ctx.Value(originalQuerySDKResultKey{}).(*OriginalQuerySDKResult)
+	if r == nil || r.read != read || r.inputID != inputID || r.inputDigest != inputDigest || r.text != text || r.space != space || r.dimensions != dimensions || r.proof != proof || len(r.vector) != len(vector) {
+		return errors.New("original query SDK result is unavailable")
+	}
+	for i, v := range vector {
+		if math.Float32bits(v) != math.Float32bits(r.vector[i]) {
+			return errors.New("original query SDK result bytes changed")
+		}
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	return read.Context().Err()
+}
+
+// There is no caller-supplied Embedder/HTTP transport or successful callback.
+// The held snapshot constructs the same strict original remote/local SDK. The
+// input string is unchanged by this query path; query-specific protocol fields,
+// dimension/truncate settings and all endpoint/auth facts come from its recipe.
+func ExecuteOriginalQuerySDK(ctx context.Context, read OriginalQueryModelRead, inputID, inputDigest, text string) (result *OriginalQuerySDKResult, resultErr error) {
+	if ctx == nil || read == nil || inputID == "" || inputDigest == "" || text == "" || !types.IsEmbedQuery(ctx) {
+		return nil, errors.New("original query SDK input is unavailable")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	model, proof, err := read.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	if model == nil || proof == nil || !proof.Valid() || model.Type != types.ModelTypeEmbedding || model.Parameters.OriginalEmbedding == nil {
+		return nil, errors.New("original query SDK model is unavailable")
+	}
+	recipe := model.Parameters.OriginalEmbedding
+	if err = ValidateOriginalEmbeddingDefinition(recipe); err != nil {
+		return nil, err
+	}
+	recipeWire, err := json.Marshal(recipe)
+	if err != nil {
+		return nil, err
+	}
+	provider, err := NewOriginalEmbedder(model, nil)
+	if err != nil {
+		return nil, err
+	}
+	call, cancel := context.WithCancel(ctx)
+	stopModel := context.AfterFunc(read.Context(), cancel)
+	var watcherErr error
+	var mu sync.Mutex
+	joined := make(chan struct{})
+	go func() {
+		defer close(joined)
+		ticker := time.NewTicker(100 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-call.Done():
+				return
+			case <-ticker.C:
+				if err := read.Recheck(); err != nil {
+					mu.Lock()
+					watcherErr = err
+					mu.Unlock()
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	defer func() { cancel(); stopModel(); <-joined }()
+	vector, callErr := provider.Embed(call, text)
+	cancel()
+	stopModel()
+	<-joined
+	mu.Lock()
+	watchErr := watcherErr
+	mu.Unlock()
+	if callErr != nil || watchErr != nil {
+		return nil, errors.Join(callErr, watchErr)
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err = read.Recheck(); err != nil {
+		return nil, err
+	}
+	current, currentProof, err := read.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	currentWire, err := json.Marshal(current.Parameters.OriginalEmbedding)
+	if err != nil || !reflect.DeepEqual(currentProof, proof) || string(currentWire) != string(recipeWire) || provider.GetDimensions() != recipe.ExpectedDimensions || len(vector) != recipe.ExpectedDimensions {
+		return nil, errors.New("original query SDK model or recipe changed")
+	}
+	for _, v := range vector {
+		if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+			return nil, errors.New("original query SDK response is not finite")
+		}
+	}
+	return &OriginalQuerySDKResult{read: read, inputID: inputID, inputDigest: inputDigest, text: text, space: recipe.SpaceDigest, recipeJSON: string(recipeWire), proof: *proof, dimensions: recipe.ExpectedDimensions, vector: append([]float32(nil), vector...)}, nil
+}
