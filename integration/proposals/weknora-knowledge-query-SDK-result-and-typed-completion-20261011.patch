+}
+func (q *KnowledgeQueryEmbeddingRead) checkInTx(tx *gorm.DB, result bool) error {
+	if err := q.checkPool(tx); err != nil {
+		return err
+	}
+	if err := knowledgeQuerySchemaInTx(tx); err != nil {
+		return err
+	}
+	if q.input == nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := q.clock(tx, nil); err != nil {
+		return err
+	}
+	if err := CheckCurrentModelOriginalHolds(q.model.Context(), tx.Session(&gorm.Session{NewDB: true}), q.proof); err != nil {
+		return err
+	}
+	kb, err := q.kbInTx(tx, true)
+	if err != nil {
+		return err
+	}
+	lineage, err := readKnowledgeConfigurationOrigin(tx, kb)
+	if err != nil || lineage == nil || lineage.RequireComplete() != nil || len(lineage.Sources) != 0 {
+		return ErrKnowledgeInputChanged
+	}
+	revision, err := knowledgeConfigurationControlRevision(tx, kb.ID)
+	if err != nil || revision != q.input.KBRevision {
+		return ErrKnowledgeInputChanged
+	}
+	digest, err := knowledgeConfigurationOriginDigest(kb)
+	if err != nil || digest != q.input.KBConfigDigest {
+		return ErrKnowledgeInputChanged
+	}
+	snapshot, err := q.store.material.captureMessageMaterialInTx(tx.Session(&gorm.Session{NewDB: true}), q.parent.Plan.Request)
+	if err != nil {
+		return err
+	}
+	if len(snapshot.Messages) != 1 || len(snapshot.Proofs) != 1 || snapshot.MetadataDigest != q.input.PlanDigest {
+		return ErrKnowledgeInputChanged
+	}
+	m, p := snapshot.Messages[0], snapshot.Proofs[0]
+	if m == nil || p == nil || m.ID != q.input.MessageID || m.Role != "user" || !m.IsCompleted || m.Content != q.text || p.AdmissionID != q.input.AdmissionID || p.GenerationID != q.input.GenerationID || p.BodyDigest != q.input.MessageBodyDigest {
+		return ErrKnowledgeInputChanged
+	}
+	var input types.KnowledgeQueryEmbeddingInput
+	if err = tx.Where("id=?", q.input.ID).Take(&input).Error; err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(input, *q.input) {
+		return ErrKnowledgeInputChanged
+	}
+	actualDigest, err := knowledgeQueryInputDigest(input)
+	if err != nil || actualDigest != input.Digest || bodySHA([]byte(input.InputJSON)) != input.InputSHA256 {
+		return ErrOriginalBodyUnavailable
+	}
+	if result {
+		if q.result == nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		var receipt types.KnowledgeQueryEmbeddingReceipt
+		if err = tx.Where("id=?", q.result.ID).Take(&receipt).Error; err != nil {
+			return err
+		}
+		rd, e := knowledgeQueryResultDigest(receipt)
+		if e != nil || rd != receipt.Digest || !reflect.DeepEqual(receipt, *q.result) {
+			return ErrOriginalBodyUnavailable
+		}
+		data, e := knowledgeSQLiteVectorBytes(q.vector)
+		if e != nil || bodySHA(data) != receipt.VectorSHA256 || bodySHA([]byte(receipt.VectorJSON)) != receipt.BodySHA256 {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	if err = checkOriginalBodyAvailableBatchForCapturedInTx(q.ctx, tx, q.rows, q.heads); err != nil {
+		return err
+	}
+	return q.clock(tx, nil)
+}
+func (q *KnowledgeQueryEmbeddingRead) clock(tx *gorm.DB, extra map[string]originalBodyLease) error {
+	all := map[string]originalBodyLease{}
+	if err := mergeMemoryFinalLeaseBindings(all, q.leases); err != nil {
+		return err
+	}
+	if err := mergeMemoryFinalLeaseBindings(all, extra); err != nil {
+		return err
+	}
+	if err := NewOriginalBodyRetentionStore(tx).checkJournalInTx(tx); err != nil {
+		return err
+	}
+	return knowledgeQueryFinalClockInTx(tx, all, q.payloads, q.content)
+}
+func (q *KnowledgeQueryEmbeddingRead) Snapshot() (*types.KnowledgeQueryEmbeddingInputSnapshot, error) {
+	if err := q.start(); err != nil {
+		return nil, err
+	}
+	v := q.view()
+	err := q.store.db.WithContext(q.ctx).Transaction(func(tx *gorm.DB) error { return v.checkInTx(tx, false) }, memoryWriteOptions(q.store.db))
+	if err = q.finish(err); err != nil {
+		return nil, err
+	}
+	f := v.input
+	return &types.KnowledgeQueryEmbeddingInputSnapshot{OriginalID: f.ID, OriginalDigest: f.Digest, KnowledgeBaseID: f.KnowledgeBaseID, ModelID: f.ModelID, Text: v.text, SpaceDigest: f.SpaceDigest, ExpectedDimensions: f.ExpectedDimensions}, nil
+}
+func (q *KnowledgeQueryEmbeddingRead) Recheck() error {
+	if err := q.start(); err != nil {
+		return err
+	}
+	v := q.view()
+	err := q.store.db.WithContext(q.ctx).Transaction(func(tx *gorm.DB) error { return v.checkInTx(tx, v.result != nil) }, memoryWriteOptions(q.store.db))
+	return q.finish(err)
+}
+func (q *KnowledgeQueryEmbeddingRead) Close() error {
+	q.mu.Lock()
+	if q.closed {
+		joined := q.joined
+		q.mu.Unlock()
+		<-joined
+		q.mu.Lock()
+		err := q.failed
+		q.mu.Unlock()
+		return err
+	}
+	q.closed = true
+	q.cancel()
+	q.mu.Unlock()
+	q.checks.Wait()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(q.ctx), 5*time.Second)
+	defer cancel()
+	var err error
+	ids := []string{}
+	for id := range q.owned {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		err = errors.Join(err, NewOriginalBodyRetentionStore(q.store.db).ReleaseLease(cleanup, id))
+	}
+	for _, l := range q.content {
+		err = errors.Join(err, q.store.material.ContentLeaseStore().ReleaseLease(cleanup, l.ID))
+	}
+	if q.model != nil {
+		err = errors.Join(err, q.model.Close())
+	}
+	q.mu.Lock()
+	if q.failed == nil {
+		q.failed = err
+	}
+	close(q.joined)
+	q.mu.Unlock()
+	return err
+}
