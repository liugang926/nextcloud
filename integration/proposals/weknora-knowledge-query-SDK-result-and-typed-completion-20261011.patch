+-- Independent not-yet-adopted SQLite91. Canonical/peer routes are not changed.
+CREATE TABLE knowledge_sqlite_query_inputs (
+ id TEXT PRIMARY KEY NOT NULL, tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL REFERENCES knowledge_bases(id),
+ session_id TEXT NOT NULL, message_id TEXT NOT NULL,
+ admission_id TEXT NOT NULL REFERENCES message_material_admissions(id),
+ generation_id TEXT NOT NULL REFERENCES message_generation_origins(id),
+ message_body_digest TEXT NOT NULL CHECK(length(message_body_digest)=64),
+ plan_json TEXT NOT NULL, plan_digest TEXT NOT NULL CHECK(length(plan_digest)=64),
+ kb_revision INTEGER NOT NULL CHECK(kb_revision>0), kb_config_digest TEXT NOT NULL CHECK(length(kb_config_digest)=64),
+ model_id TEXT NOT NULL, model_proof_json TEXT NOT NULL,
+ space_digest TEXT NOT NULL CHECK(length(space_digest)=64), expected_dimensions INTEGER NOT NULL CHECK(expected_dimensions BETWEEN 1 AND 65536),
+ input_json TEXT NOT NULL, input_sha256 TEXT NOT NULL CHECK(length(input_sha256)=64),
+ digest TEXT NOT NULL UNIQUE CHECK(length(digest)=64), created_at_ms INTEGER NOT NULL
+);
+CREATE TABLE knowledge_sqlite_query_receipts (
+ id TEXT PRIMARY KEY NOT NULL, input_id TEXT NOT NULL UNIQUE REFERENCES knowledge_sqlite_query_inputs(id),
+ input_digest TEXT NOT NULL CHECK(length(input_digest)=64), tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL, model_id TEXT NOT NULL, space_digest TEXT NOT NULL CHECK(length(space_digest)=64),
+ dimensions INTEGER NOT NULL CHECK(dimensions BETWEEN 1 AND 65536), vector_json TEXT NOT NULL,
+ body_sha256 TEXT NOT NULL CHECK(length(body_sha256)=64), vector_sha256 TEXT NOT NULL CHECK(length(vector_sha256)=64),
+ digest TEXT NOT NULL UNIQUE CHECK(length(digest)=64), created_at_ms INTEGER NOT NULL
+);
+CREATE TRIGGER knowledge_sqlite_query_input_update BEFORE UPDATE ON knowledge_sqlite_query_inputs BEGIN SELECT RAISE(ABORT,'knowledge_query_original_immutable'); END;
+CREATE TRIGGER knowledge_sqlite_query_input_delete BEFORE DELETE ON knowledge_sqlite_query_inputs BEGIN SELECT RAISE(ABORT,'knowledge_query_original_immutable'); END;
+CREATE TRIGGER knowledge_sqlite_query_result_update BEFORE UPDATE ON knowledge_sqlite_query_receipts BEGIN SELECT RAISE(ABORT,'knowledge_query_original_immutable'); END;
+CREATE TRIGGER knowledge_sqlite_query_result_delete BEFORE DELETE ON knowledge_sqlite_query_receipts BEGIN SELECT RAISE(ABORT,'knowledge_query_original_immutable'); END;
