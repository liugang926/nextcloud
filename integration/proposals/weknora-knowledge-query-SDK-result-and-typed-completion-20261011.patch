+func installKnowledgeQuery91Actual(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	var path string
+	require.NoError(t, db.Raw("SELECT file FROM pragma_database_list WHERE name='main'").Scan(&path).Error)
+	require.NotEmpty(t, path)
+	root, err := filepath.Abs("../../..")
+	require.NoError(t, err)
+	source := t.TempDir()
+	for _, dir := range []string{"migrations/sqlite", "migrations/pending/knowledge-sqlite-embedding-originals-000090", "migrations/pending/knowledge-query-embedding-originals-000091"} {
+		files, err := filepath.Glob(filepath.Join(root, dir, "*.sql"))
+		require.NoError(t, err)
+		require.NotEmpty(t, files)
+		for _, file := range files {
+			raw, err := os.ReadFile(file)
+			require.NoError(t, err)
+			require.NoError(t, os.WriteFile(filepath.Join(source, filepath.Base(file)), raw, 0600))
+		}
+	}
+	m, err := migrate.New("file://"+source, "sqlite3://"+path)
+	require.NoError(t, err)
+	require.NoError(t, m.Migrate(91))
+	sc, dc := m.Close()
+	require.NoError(t, sc)
+	require.NoError(t, dc)
+	var version struct {
+		Version uint
+		Dirty   bool
+	}
+	require.NoError(t, db.Table("schema_migrations").Take(&version).Error)
+	require.EqualValues(t, 91, version.Version)
+	require.False(t, version.Dirty)
+	require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(db))
+	require.NoError(t, repository.InstallOriginalBodyRetentionCallbacks(db))
+}
