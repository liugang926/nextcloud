@@ -0,0 +1,160 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	modelembedding "github.com/Tencent/WeKnora/internal/models/embedding"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+type KnowledgeQueryEmbeddingResultRead struct{ read *KnowledgeQueryEmbeddingRead }
+
+func (r *KnowledgeQueryEmbeddingResultRead) Context() context.Context { return r.read.Context() }
+func (r *KnowledgeQueryEmbeddingResultRead) Recheck() error           { return r.read.Recheck() }
+func (r *KnowledgeQueryEmbeddingResultRead) Close() error             { return r.read.Close() }
+func (r *KnowledgeQueryEmbeddingResultRead) Snapshot() (*types.KnowledgeQueryEmbeddingVectorSnapshot, error) {
+	q := r.read
+	if err := q.start(); err != nil {
+		return nil, err
+	}
+	v := q.view()
+	err := q.store.db.WithContext(q.ctx).Transaction(func(tx *gorm.DB) error { return v.checkInTx(tx, true) }, memoryWriteOptions(q.store.db))
+	if err = q.finish(err); err != nil {
+		return nil, err
+	}
+	if v.result == nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	f, s := v.input, v.result
+	return &types.KnowledgeQueryEmbeddingVectorSnapshot{OriginalID: f.ID, OriginalDigest: f.Digest, ReceiptID: s.ID, ReceiptDigest: s.Digest, KnowledgeBaseID: f.KnowledgeBaseID, ModelID: f.ModelID, SpaceDigest: f.SpaceDigest, Vector: append([]float32(nil), v.vector...)}, nil
+}
+
+// Commit requires the private input capability; it cannot author from a model
+// ID, caller text, digest or an AdditionalParams vector. Its service producer
+// must also supply the opaque actual SDK success capability; an input context
+// with caller floats cannot publish a result receipt.
+func (s *KnowledgeSQLiteEmbeddingStore) CommitKnowledgeQueryEmbedding(ctx context.Context, inputID, inputDigest string, vector []float32) (*KnowledgeQueryEmbeddingResultRead, error) {
+	if ctx == nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	q, _ := ctx.Value(knowledgeQueryReadKey{}).(*KnowledgeQueryEmbeddingRead)
+	if q == nil || q.store != s || q.input == nil || q.input.ID != inputID || q.input.Digest != inputDigest || len(vector) != q.input.ExpectedDimensions || !sameOriginalModelCallerInRepository(ctx, q.ctx) {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	binary, err := knowledgeSQLiteVectorBytes(vector)
+	if err != nil {
+		return nil, err
+	}
+	if err = modelembedding.MatchOriginalQuerySDKResult(ctx, q.model, inputID, inputDigest, q.text, q.input.SpaceDigest, q.input.ExpectedDimensions, q.proof, vector); err != nil {
+		return nil, err
+	}
+	if err = q.start(); err != nil {
+		return nil, err
+	}
+	q.mu.Lock()
+	if q.committing || q.result != nil {
+		q.mu.Unlock()
+		return nil, q.finish(ErrKnowledgeSQLiteEmbeddingUnknown)
+	}
+	q.committing = true
+	q.mu.Unlock()
+	v := q.view()
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if e := v.checkInTx(tx, false); e != nil {
+			return e
+		}
+		var count int64
+		if e := tx.Table("knowledge_sqlite_query_receipts").Where("input_id=?", inputID).Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 0 {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		raw, e := json.Marshal(vector)
+		if e != nil {
+			return e
+		}
+		now, e := nextcloudLeaseNowMS(tx)
+		if e != nil {
+			return e
+		}
+		f := v.input
+		r := &types.KnowledgeQueryEmbeddingReceipt{ID: uuid.NewString(), InputID: f.ID, InputDigest: f.Digest, TenantID: f.TenantID, KnowledgeBaseID: f.KnowledgeBaseID, ModelID: f.ModelID, SpaceDigest: f.SpaceDigest, Dimensions: len(vector), VectorJSON: string(raw), BodySHA256: bodySHA(raw), VectorSHA256: bodySHA(binary), CreatedAtMS: now}
+		r.Digest, e = knowledgeQueryResultDigest(*r)
+		if e != nil {
+			return e
+		}
+		producer := context.WithValue(ctx, knowledgeQueryProducerKey{}, knowledgeQueryProducer{r.TableName(), r.ID, r.KnowledgeBaseID, r.BodySHA256, r.TenantID})
+		if e = tx.WithContext(producer).Create(r).Error; e != nil {
+			return e
+		}
+		v.result = r
+		v.vector = append([]float32(nil), vector...)
+		if e = v.claimRows(tx, []originalBodyAvailabilityRow{{r.TableName(), r.ID}}); e != nil {
+			return e
+		}
+		return v.checkInTx(tx, true)
+	}, memoryWriteOptions(s.db))
+	q.mu.Lock()
+	if err == nil {
+		q.result = v.result
+		q.vector = v.vector
+		q.leases = v.leases
+		q.owned = v.owned
+		q.payloads = v.payloads
+		q.rows = v.rows
+		q.heads = v.heads
+	}
+	q.committing = false
+	q.mu.Unlock()
+	if err = q.finish(err); err != nil {
+		return nil, err
+	}
+	return &KnowledgeQueryEmbeddingResultRead{q}, nil
+}
+
+// Getter returns only the genuine captured result capability. It performs no
+// metadata lookup and adds no proof to a context lacking that private result.
+func KnowledgeQueryEmbeddingResultFromContext(ctx context.Context) (*KnowledgeQueryEmbeddingResultRead, error) {
+	if ctx == nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	q, _ := ctx.Value(knowledgeQueryReadKey{}).(*KnowledgeQueryEmbeddingRead)
+	if q == nil {
+		return nil, nil
+	}
+	if err := q.start(); err != nil {
+		return nil, err
+	}
+	v := q.view()
+	err := error(nil)
+	if v.result == nil || !sameOriginalModelCallerInRepository(ctx, v.ctx) {
+		err = ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err = q.finish(err); err != nil {
+		return nil, err
+	}
+	return &KnowledgeQueryEmbeddingResultRead{q}, nil
+}
+func CheckKnowledgeQueryVectorInTx(ctx context.Context, tx *gorm.DB, params types.RetrieveParams) (bool, error) {
+	result, err := KnowledgeQueryEmbeddingResultFromContext(ctx)
+	if err != nil {
+		return false, err
+	}
+	if result == nil {
+		return false, nil
+	}
+	q := result.read
+	if err = q.start(); err != nil {
+		return false, err
+	}
+	v := q.view()
+	err = v.checkInTx(tx, true)
+	space, _ := params.AdditionalParams["embedding_space_digest"].(string)
+	if err == nil && (len(params.KnowledgeBaseIDs) != 1 || params.KnowledgeBaseIDs[0] != v.input.KnowledgeBaseID || space != v.input.SpaceDigest || !KnowledgeSQLiteVectorsEqual(params.Embedding, v.vector)) {
+		err = ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return true, q.finish(err)
+}
