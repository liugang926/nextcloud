@@ -0,0 +1,93 @@
+package repository
+
+import (
+	"gorm.io/gorm"
+	"strings"
+)
+
+var knowledgeQuerySchema = []struct {
+	Table, Body, SQL string
+	Columns          []string
+}{
+	{Table: "knowledge_sqlite_query_inputs", Body: "input_json", Columns: strings.Fields("id tenant_id knowledge_base_id session_id message_id admission_id generation_id message_body_digest plan_json plan_digest kb_revision kb_config_digest model_id model_proof_json space_digest expected_dimensions input_json input_sha256 digest created_at_ms"), SQL: `CREATE TABLE knowledge_sqlite_query_inputs (
+ id TEXT PRIMARY KEY NOT NULL, tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL REFERENCES knowledge_bases(id),
+ session_id TEXT NOT NULL, message_id TEXT NOT NULL,
+ admission_id TEXT NOT NULL REFERENCES message_material_admissions(id),
+ generation_id TEXT NOT NULL REFERENCES message_generation_origins(id),
+ message_body_digest TEXT NOT NULL CHECK(length(message_body_digest)=64),
+ plan_json TEXT NOT NULL, plan_digest TEXT NOT NULL CHECK(length(plan_digest)=64),
+ kb_revision INTEGER NOT NULL CHECK(kb_revision>0), kb_config_digest TEXT NOT NULL CHECK(length(kb_config_digest)=64),
+ model_id TEXT NOT NULL, model_proof_json TEXT NOT NULL,
+ space_digest TEXT NOT NULL CHECK(length(space_digest)=64), expected_dimensions INTEGER NOT NULL CHECK(expected_dimensions BETWEEN 1 AND 65536),
+ input_json TEXT NOT NULL, input_sha256 TEXT NOT NULL CHECK(length(input_sha256)=64),
+ digest TEXT NOT NULL UNIQUE CHECK(length(digest)=64), created_at_ms INTEGER NOT NULL
+);`},
+	{Table: "knowledge_sqlite_query_receipts", Body: "vector_json", Columns: strings.Fields("id input_id input_digest tenant_id knowledge_base_id model_id space_digest dimensions vector_json body_sha256 vector_sha256 digest created_at_ms"), SQL: `CREATE TABLE knowledge_sqlite_query_receipts (
+ id TEXT PRIMARY KEY NOT NULL, input_id TEXT NOT NULL UNIQUE REFERENCES knowledge_sqlite_query_inputs(id),
+ input_digest TEXT NOT NULL CHECK(length(input_digest)=64), tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL, model_id TEXT NOT NULL, space_digest TEXT NOT NULL CHECK(length(space_digest)=64),
+ dimensions INTEGER NOT NULL CHECK(dimensions BETWEEN 1 AND 65536), vector_json TEXT NOT NULL,
+ body_sha256 TEXT NOT NULL CHECK(length(body_sha256)=64), vector_sha256 TEXT NOT NULL CHECK(length(vector_sha256)=64),
+ digest TEXT NOT NULL UNIQUE CHECK(length(digest)=64), created_at_ms INTEGER NOT NULL
+);`},
+}
+
+func knowledgeQuerySchemaInTx(tx *gorm.DB) error {
+	if tx.Dialector.Name() != "sqlite" {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	normalize := func(s string) string {
+		return strings.Join(strings.Fields(strings.TrimSuffix(strings.TrimSpace(s), ";")), " ")
+	}
+	for _, spec := range knowledgeQuerySchema {
+		var table struct{ SQL string }
+		if err := bodyInternal(tx).Raw("SELECT sql FROM sqlite_master WHERE type='table' AND name=?", spec.Table).Take(&table).Error; err != nil {
+			return err
+		}
+		if normalize(table.SQL) != normalize(spec.SQL) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		columns, err := bodyInternal(tx).Migrator().ColumnTypes(spec.Table)
+		if err != nil {
+			return err
+		}
+		if len(columns) != len(spec.Columns) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		for i, c := range columns {
+			if c.Name() != spec.Columns[i] {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+		}
+		eq := []string{}
+		for _, column := range spec.Columns {
+			if column != spec.Body {
+				eq = append(eq, "NEW."+bodyQuoted(column)+" IS OLD."+bodyQuoted(column))
+			}
+		}
+		authority := "EXISTS (SELECT 1 FROM original_body_rewrite_authorities a JOIN original_body_payloads p ON p.id=a.body_id WHERE a.source_table=" + bodySQLLiteral(spec.Table) + " AND a.row_key=CAST(OLD." + bodyQuoted("id") + " AS TEXT) AND a.column_name=" + bodySQLLiteral(spec.Body) + " AND a.old_value=OLD." + bodyQuoted(spec.Body) + " AND a.new_value=NEW." + bodyQuoted(spec.Body) + ")"
+		permit := "(" + strings.Join(eq, " AND ") + " AND " + authority + ")"
+		prefix := "knowledge_sqlite_query_input_"
+		if spec.Body == "vector_json" {
+			prefix = "knowledge_sqlite_query_result_"
+		}
+		for _, event := range []string{"update", "delete"} {
+			name := prefix + event
+			original := "CREATE TRIGGER " + name + " BEFORE " + strings.ToUpper(event) + " ON " + spec.Table + " BEGIN SELECT RAISE(ABORT,'knowledge_query_original_immutable'); END"
+			expected := original
+			if event == "update" {
+				begin := strings.Index(original, " BEGIN")
+				expected = original[:begin] + " WHEN NOT (" + permit + ")" + original[begin:]
+			}
+			var row struct{ SQL string }
+			if err = bodyInternal(tx).Raw("SELECT sql FROM sqlite_master WHERE type='trigger' AND name=? AND tbl_name=?", name, spec.Table).Take(&row).Error; err != nil {
+				return err
+			}
+			if normalize(row.SQL) != normalize(expected) && normalize(row.SQL) != normalize(original) {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+		}
+	}
+	return tx.Statement.Context.Err()
+}
