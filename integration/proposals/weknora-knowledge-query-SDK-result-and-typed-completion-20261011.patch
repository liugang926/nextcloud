+			}
+			require.NoError(t, err)
+			var completed bool
+			require.NoError(t, db.Table("messages").Select("is_completed").Where("id=?", assistant.ID).Scan(&completed).Error)
+			require.True(t, completed)
+			var raw struct{ ParentManifest string }
+			require.NoError(t, db.Table("message_completion_input_manifests").Take(&raw).Error)
+			var manifest types.MessageCompletionInputManifest
+			require.NoError(t, json.Unmarshal([]byte(raw.ParentManifest), &manifest))
+			require.Len(t, manifest.KnowledgeConsumptions, 1)
+			require.Equal(t, snapshot.ReceiptID, manifest.KnowledgeConsumptions[0].QueryReceiptID)
+			require.Len(t, manifest.KnowledgeConsumptions[0].Candidates, 1)
+			require.Len(t, manifest.KnowledgeConsumptions[0].Hits, 1)
+			require.Equal(t, c.ID, results[0].Results[0].ChunkID)
+			cancelCall()
+			releaseProducer()
+			require.NoError(t, check())
+			releaseHTTP()
+			var live int64
+			require.NoError(t, db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&live).Error)
+			require.Zero(t, live)
+			require.EqualValues(t, 1, chatCalls.Load())
+			mu.Lock()
+			err = observed
+			mu.Unlock()
+			require.NoError(t, err)
+		})
+	}
