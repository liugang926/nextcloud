+		if e := bodyInternal(tx).Where("id=?", l.BodyID).Take(&b).Error; e != nil {
+			return e
+		}
+		q.payloads[l.BodyID] = b
+	}
+	return nil
+}
+func (s *KnowledgeSQLiteEmbeddingStore) BeginKnowledgeQueryEmbedding(ctx context.Context, kbID, modelID string) (*KnowledgeQueryEmbeddingRead, error) {
