+package service
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// Prepare-only binder: a real preceding GetMessage guard supplies the selector.
+// No normal QA or registry caller is enabled until the Nextcloud union is ready.
+func bindKnowledgeQueryMessageOriginal(ctx context.Context, session, message string) (context.Context, error) {
+	if ctx == nil || ctx.Err() != nil {
+		return ctx, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok {
+		return ctx, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	slot.mu.Lock()
+	closed, failed := slot.Closed, slot.Failed
+	guards := append([]*MessageMaterialGuard(nil), slot.Guards...)
+	slot.mu.Unlock()
+	if closed || failed != nil {
+		return ctx, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	for _, g := range guards {
+		g.mu.Lock()
+		plan := g.plan
+		chosen := plan != nil && plan.Request.SessionID == session && !plan.Request.AllSession && len(plan.Request.MessageIDs) == 1 && plan.Request.MessageIDs[0] == message && g.snapshot != nil && len(g.snapshot.Messages) == 1 && g.snapshot.Messages[0] != nil && g.snapshot.Messages[0].Role == "user"
+		g.mu.Unlock()
+		if chosen {
+			marked, err := repository.WithKnowledgeQueryMessagePlan(ctx, plan, message)
+			if err != nil {
+				return ctx, err
+			}
+			return withKnowledgeEmbeddingConsumerOwner(marked), nil
+		}
+	}
+	return ctx, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+}
+
+type knowledgeQueryBoundaryResource struct {
+	read     *repository.KnowledgeQueryEmbeddingResultRead
+	release  func()
+	once     sync.Once
+	err      error
+	retained atomic.Bool
+}
+
+func (r *knowledgeQueryBoundaryResource) Context() context.Context { return r.read.Context() }
+func (r *knowledgeQueryBoundaryResource) Snapshot() (*types.KnowledgeQueryEmbeddingVectorSnapshot, error) {
+	return r.read.Snapshot()
+}
+func (r *knowledgeQueryBoundaryResource) Recheck() error         { return r.read.Recheck() }
+func (r *knowledgeQueryBoundaryResource) RecheckOriginal() error { return r.Recheck() }
+func (r *knowledgeQueryBoundaryResource) Close() error {
+	r.once.Do(func() {
+		r.err = r.read.Close()
+		if r.release != nil {
+			r.release()
+		}
+	})
+	return r.err
+}
+func (r *knowledgeQueryBoundaryResource) CloseOriginal() error            { return r.Close() }
+func (r *knowledgeQueryBoundaryResource) EmbeddingConsumerRetained() bool { return r.retained.Load() }
+
+// Exact text comes exclusively from the leased human original. The outer read
+// survives SDK timeout/provider Done, result publication and the last HTTP ref.
+func EmbedOriginalKnowledgeQuery(ctx context.Context, store *repository.KnowledgeSQLiteEmbeddingStore, models interfaces.ModelService, kb, model string) (result interfaces.KnowledgeQueryEmbeddingResultRead, resultErr error) {
+	if store == nil || models == nil {
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	owner, release, transfer, err := interfaces.AcquireKnowledgeEmbeddingConsumerContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	releaseFailure := true
+	defer func() {
+		if releaseFailure && release != nil {
+			release()
+		}
+	}()
+	input, err := store.BeginKnowledgeQueryEmbedding(logprivacy.SuppressContent(owner), kb, model)
+	if err != nil {
+		return nil, err
+	}
+	closeFailure := true
+	defer func() {
+		if closeFailure {
+			resultErr = errors.Join(resultErr, input.Close())
+			if resultErr != nil {
+				result = nil
+			}
+		}
+	}()
+	snapshot, err := input.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	provider, err := models.GetEmbeddingModel(input.Context(), snapshot.ModelID)
+	if err != nil {
+		return nil, err
+	}
+	actual, ok := provider.(*modelOriginalEmbeddingClient)
+	if !ok || actual == nil || provider.GetDimensions() != snapshot.ExpectedDimensions {
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	clientClosed := false
+	defer func() {
+		if !clientClosed {
+			resultErr = errors.Join(resultErr, actual.CloseOriginal())
+			if resultErr != nil {
+				result = nil
+			}
+		}
+	}()
+	operationCtx, operation, closeOperation, err := actual.BeginOriginalEmbeddingOperation(input.Context())
+	if err != nil {
+		return nil, err
+	}
+	queryOperation, ok := operation.(*modelOriginalEmbeddingOperation)
+	if !ok || queryOperation == nil {
+		return nil, repository.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	operationClosed := false
+	defer func() {
+		if !operationClosed {
+			resultErr = errors.Join(resultErr, closeOperation())
+			if resultErr != nil {
+				result = nil
+			}
+		}
+	}()
+	call, cancel := context.WithTimeout(types.WithEmbedQuery(operationCtx), 2*time.Second)
+	stop := context.AfterFunc(ctx, cancel)
+	evidence, err := queryOperation.executeOriginalKnowledgeQuery(call, snapshot.OriginalID, snapshot.OriginalDigest, snapshot.Text)
+	stop()
+	cancel()
+	if err != nil {
+		return nil, err
+	}
+	if err = input.Recheck(); err != nil {
+		return nil, err
+	}
+	// Actual immutable result evidence survives the short SDK context, but stays
+	// bound to this exact still-live input/model and actual returned vector bytes.
+	read, err := store.CommitKnowledgeQueryEmbedding(evidence.Context(input.Context()), snapshot.OriginalID, snapshot.OriginalDigest, evidence.Vector())
+	if err != nil {
+		return nil, err
+	}
+	err = closeOperation()
+	operationClosed = true
+	if err != nil {
+		cleanup := read.Close()
+		return nil, errors.Join(err, cleanup)
+	}
+	err = actual.CloseOriginal()
+	clientClosed = true
+	if err != nil {
+		cleanup := read.Close()
+		return nil, errors.Join(err, cleanup)
+	}
+	wrapped := &knowledgeQueryBoundaryResource{read: read, release: release}
+	closeFailure = false
+	releaseFailure = false
+	retained, err := retainOriginalModelClient(ctx, wrapped, transfer)
+	if err != nil {
+		cleanup := wrapped.Close()
+		return nil, errors.Join(err, cleanup)
+	}
+	wrapped.retained.Store(retained)
+	return wrapped, nil
+}
