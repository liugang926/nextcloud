+package repository
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+type actualKnowledgeCompletionKey struct{}
+type knowledgeCompletionClockPhaseKey struct{}
+
+func knowledgeConsumptionDigest(c *types.KnowledgeEmbeddingConsumption) (string, error) {
+	copy := *c
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func knowledgeNativeWhere(p types.RetrieveParams) (string, []interface{}) {
+	where := "(e.is_enabled IS NULL OR e.is_enabled=1) AND e.dimension=?"
+	args := []interface{}{len(p.Embedding)}
+	for _, f := range []struct {
+		column string
+		ids    []string
+	}{{"knowledge_base_id", p.KnowledgeBaseIDs}, {"knowledge_id", p.KnowledgeIDs}, {"tag_id", p.TagIDs}} {
+		if len(f.ids) > 0 {
+			where += " AND e." + f.column + " IN ?"
+			args = append(args, f.ids)
+		}
+	}
+	return where, args
+}
+
+// Replays the actual vec0 selection in the same physical transaction. DTO hit
+// lists are never accepted as a producer receipt or current read authority.
+func knowledgeNativeHitsInTx(tx *gorm.DB, r *KnowledgeSQLiteEmbeddingVectorRead, p types.RetrieveParams) ([]types.KnowledgeEmbeddingHit, error) {
+	if p.TopK < 1 || p.TopK > 4096 || math.IsNaN(p.Threshold) || math.IsInf(p.Threshold, 0) {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	where, args := knowledgeNativeWhere(p)
+	var ids []uint64
+	if err := tx.Table("lite_embeddings AS e").Select("e.id").Where(where, args...).Order("e.id").Limit(4097).Scan(&ids).Error; err != nil {
+		return nil, err
+	}
+	expected := []uint64{}
+	for id := range r.receipts {
+		expected = append(expected, id)
+	}
+	sort.Slice(expected, func(i, j int) bool { return expected[i] < expected[j] })
+	if !reflect.DeepEqual(ids, expected) {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	blob, err := knowledgeSQLiteVectorBytes(p.Embedding)
+	if err != nil {
+		return nil, err
+	}
+	nativeArgs := []interface{}{blob, p.TopK}
+	nativeArgs = append(nativeArgs, args...)
+	var hits []types.KnowledgeEmbeddingHit
+	sql := fmt.Sprintf("SELECT v.rowid AS row_id,v.distance FROM vec_embeddings_%d v WHERE v.embedding MATCH ? AND k=? AND v.rowid IN (SELECT e.id FROM lite_embeddings e WHERE %s) ORDER BY v.distance ASC", len(p.Embedding), where)
+	if err = tx.Raw(sql, nativeArgs...).Scan(&hits).Error; err != nil {
+		return nil, err
+	}
+	count := p.TopK
+	if count > len(ids) {
+		count = len(ids)
+	}
+	if len(hits) != count {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	seen := map[uint64]bool{}
+	for _, h := range hits {
+		if seen[h.RowID] || r.receipts[h.RowID].ID == "" || math.IsNaN(h.Distance) || math.IsInf(h.Distance, 0) {
+			return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		seen[h.RowID] = true
+	}
+	return hits, nil
+}
+func cloneKnowledgeSearch(p types.RetrieveParams) types.RetrieveParams {
+	p.Embedding = append([]float32(nil), p.Embedding...)
+	p.KnowledgeBaseIDs = append([]string(nil), p.KnowledgeBaseIDs...)
+	p.KnowledgeIDs = append([]string(nil), p.KnowledgeIDs...)
+	p.TagIDs = append([]string(nil), p.TagIDs...)
+	extra := map[string]interface{}{}
+	for k, v := range p.AdditionalParams {
+		extra[k] = v
+	}
+	p.AdditionalParams = extra
+	return p
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) makeConsumptionInTx(tx *gorm.DB, p types.RetrieveParams) (*types.KnowledgeEmbeddingConsumption, error) {
+	q := r.query
+	if q == nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if _, err := CheckKnowledgeQueryVectorInTx(q.Context(), tx, p); err != nil {
+		return nil, err
+	}
+	if err := r.CheckInTx(tx.Statement.Context, tx); err != nil {
+		return nil, err
+	}
+	hits, err := knowledgeNativeHitsInTx(tx, r, p)
+	if err != nil {
+		return nil, err
+	}
+	v := q.read.view()
+	f, s := v.input, v.result
+	lineage, _ := types.NewCompleteSourceLineage()
+	c := &types.KnowledgeEmbeddingConsumption{Version: 1, Recipe: "knowledge.query-native-vector-consumer.v1", QueryInputID: f.ID, QueryInputDigest: f.Digest, QueryReceiptID: s.ID, QueryReceiptDigest: s.Digest, KnowledgeBaseID: f.KnowledgeBaseID, SpaceDigest: f.SpaceDigest, TenantID: f.TenantID, Hits: hits, SourceLineage: lineage}
+	ids := []uint64{}
+	for id := range r.receipts {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	for _, id := range ids {
+		input, receipt := r.originals[id], r.receipts[id]
+		if input.KnowledgeBaseID != f.KnowledgeBaseID || input.SpaceDigest != f.SpaceDigest {
+			return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		body := r.body[id]
+		if body.Proof.SourceLineage.RequireComplete() != nil || len(body.Proof.SourceLineage.Sources) != 0 {
+			return nil, types.ErrSourceLineageUnknown
+		}
+		c.Candidates = append(c.Candidates, types.KnowledgeEmbeddingCandidate{RowID: id, InputID: input.ID, InputDigest: input.Digest, ReceiptID: receipt.ID, ReceiptDigest: receipt.Digest, ModelProofJSON: input.ModelProofJSON, Revision: receipt.Revision})
+	}
+	// Threshold, shape and exact returned material are bound alongside all
+	// selected and absence candidates. The caller cannot substitute text/hits.
+	output := []*types.IndexWithScore{}
+	for _, h := range hits {
+		score := 1 - h.Distance
+		if p.Threshold > 0 && score < p.Threshold {
+			continue
+		}
+		i := r.body[h.RowID].Info
+		output = append(output, &types.IndexWithScore{ID: fmt.Sprintf("%d", h.RowID), SourceID: i.SourceID, SourceType: i.SourceType, ChunkID: i.ChunkID, KnowledgeID: i.KnowledgeID, KnowledgeBaseID: i.KnowledgeBaseID, TagID: i.TagID, Content: i.Content, Score: score, MatchType: types.MatchTypeEmbedding, IsEnabled: i.IsEnabled})
+	}
+	c.OutputDigest, err = KnowledgeInputDigest([]*types.RetrieveResult{{Results: output, RetrieverEngineType: types.SQLiteRetrieverEngineType, RetrieverType: types.VectorRetrieverType}})
+	if err != nil {
+		return nil, err
+	}
+	c.Digest, err = knowledgeConsumptionDigest(c)
+	return c, err
+}
+func CaptureKnowledgeVectorConsumptionInTx(ctx context.Context, tx *gorm.DB, r *KnowledgeSQLiteEmbeddingVectorRead, p types.RetrieveParams) error {
+	q, err := KnowledgeQueryEmbeddingResultFromContext(ctx)
+	if err != nil {
+		return err
+	}
+	if q == nil {
+		return nil
+	}
+	if r == nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	r.mu.Lock()
+	already := r.consumption != nil
+	r.mu.Unlock()
+	if already {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	r.query = q
+	c, err := r.makeConsumptionInTx(tx, p)
+	if err != nil {
+		return err
+	}
+	r.mu.Lock()
+	r.search = cloneKnowledgeSearch(p)
+	r.consumption = c
+	r.mu.Unlock()
+	return RecheckKnowledgeEmbeddingConsumerInTx(ctx, tx, r, q)
+}
+func RecheckKnowledgeEmbeddingConsumerInTx(ctx context.Context, tx *gorm.DB, r *KnowledgeSQLiteEmbeddingVectorRead, q *KnowledgeQueryEmbeddingResultRead) error {
+	if r == nil || q == nil || !sameOriginalModelCallerInRepository(ctx, r.ctx) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := r.start(); err != nil {
+		return err
+	}
+	if err := q.read.start(); err != nil {
+		return r.finish(err)
+	}
+	v := q.read.view()
+	err := v.checkInTx(tx, true)
+	if err == nil {
+		err = r.checkInTx(tx.WithContext(r.ctx))
+	}
+	if err == nil && r.consumption != nil {
+		hits, e := knowledgeNativeHitsInTx(tx, r, r.search)
+		err = e
+		if err == nil && !reflect.DeepEqual(hits, r.consumption.Hits) {
+			err = ErrKnowledgeInputChanged
+		}
+	}
+	if err == nil {
+		err = checkOriginalBodyAvailableBatchForCapturedInTx(ctx, tx, r.rows, r.heads)
+	}
+	if err == nil {
+		all := map[string]originalBodyLease{}
+		payloads := map[string]originalBodyPayload{}
+		err = mergeMemoryFinalLeaseBindings(all, v.leases)
+		if err == nil {
+			err = mergeMemoryFinalLeaseBindings(all, r.leases)
+		}
+		for id, b := range v.payloads {
+			payloads[id] = b
+		}
+		for id, b := range r.payloads {
+			if before, ok := payloads[id]; ok && !reflect.DeepEqual(before, b) {
+				err = ErrOriginalBodyUnavailable
+			}
+			payloads[id] = b
+		}
+		if err == nil {
+			err = NewOriginalBodyRetentionStore(tx).checkJournalInTx(tx)
+		}
+		if err == nil {
+			err = knowledgeQueryFinalClockInTx(tx, all, payloads, v.content)
+		}
+	}
+	err = q.read.finish(err)
+	return r.finish(err)
+}
+func RecheckKnowledgeEmbeddingConsumer(r *KnowledgeSQLiteEmbeddingVectorRead, q *KnowledgeQueryEmbeddingResultRead) error {
+	if r == nil || q == nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return r.store.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error { return RecheckKnowledgeEmbeddingConsumerInTx(r.ctx, tx, r, q) }, memoryWriteOptions(r.store.db))
+}
+
+// Only actual concrete readers enter the current completion context. Saved
+// dependency DTOs alone cannot install this private operation capability.
+func WithActualKnowledgeCompletionReads(ctx context.Context, queries []*KnowledgeQueryEmbeddingResultRead, reads []*KnowledgeSQLiteEmbeddingVectorRead) (context.Context, []*types.KnowledgeEmbeddingConsumption, error) {
+	if len(queries) == 0 && len(reads) == 0 {
+		return ctx, nil, nil
+	}
+	if len(queries) != 1 || len(reads) == 0 || queries[0] == nil {
+		return ctx, nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	actual := []*KnowledgeSQLiteEmbeddingVectorRead{}
+	metadata := []*types.KnowledgeEmbeddingConsumption{}
+	for _, r := range reads {
+		if r == nil || r.query == nil || r.query.read != queries[0].read || r.consumption == nil || !sameOriginalModelCallerInRepository(ctx, r.ctx) {
+			return ctx, nil, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := RecheckKnowledgeEmbeddingConsumer(r, r.query); err != nil {
+			return ctx, nil, err
+		}
+		actual = append(actual, r)
+		copy := *r.consumption
+		copy.Candidates = append([]types.KnowledgeEmbeddingCandidate(nil), copy.Candidates...)
+		copy.Hits = append([]types.KnowledgeEmbeddingHit(nil), copy.Hits...)
+		metadata = append(metadata, &copy)
+	}
+	return context.WithValue(ctx, actualKnowledgeCompletionKey{}, actual), metadata, nil
+}
+func checkActualKnowledgeCompletionReadsInTx(tx *gorm.DB, captured []*types.KnowledgeEmbeddingConsumption) error {
+	reads, _ := tx.Statement.Context.Value(actualKnowledgeCompletionKey{}).([]*KnowledgeSQLiteEmbeddingVectorRead)
+	if len(reads) != len(captured) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	for i, r := range reads {
+		if r == nil || captured[i] == nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		c, err := r.makeConsumptionInTx(tx, r.search)
+		if err != nil {
+			return err
+		}
+		if !reflect.DeepEqual(c, captured[i]) || !reflect.DeepEqual(c, r.consumption) {
+			return ErrKnowledgeInputChanged
+		}
+	}
+	return nil
+}
+
+// This first supported completion is one genuinely read initial human message.
+// Extra history/steer/memory inputs must not be omitted from a successful union.
+func checkKnowledgeCompletionMessageParents(tx *gorm.DB, m *types.MessageCompletionInputManifest) error {
+	reads, _ := tx.Statement.Context.Value(actualKnowledgeCompletionKey{}).([]*KnowledgeSQLiteEmbeddingVectorRead)
+	if len(reads) == 0 {
+		if len(m.KnowledgeConsumptions) != 0 {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		return nil
+	}
+	if m.Initial == nil || len(m.Steers) != 0 || len(m.Inputs) == 0 || len(m.RecallConsumptions) != 0 || len(m.SemanticConsumptions) != 0 {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	for _, r := range reads {
+		v := r.query.read.view()
+		f := v.input
+		if m.Initial.AdmissionID != f.AdmissionID || m.Initial.GenerationID != f.GenerationID || m.Initial.MessageID != f.MessageID || m.Initial.BodyDigest != f.MessageBodyDigest || m.TenantID != f.TenantID {
+			return ErrKnowledgeInputChanged
+		}
+		for _, input := range m.Inputs {
+			if input == nil || input.MetadataDigest != f.PlanDigest || input.Request.AllSession || len(input.Request.MessageIDs) != 1 || input.Request.MessageIDs[0] != f.MessageID {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+		}
+	}
+	return nil
+}
+
+// This hook is last in the actual message producer after its native material
+// receipt, completion manifest and producer-advance writes have all finished.
+func checkActualKnowledgeCompletionFinalInTx(tx *gorm.DB) (finalErr error) {
+	reads, _ := tx.Statement.Context.Value(actualKnowledgeCompletionKey{}).([]*KnowledgeSQLiteEmbeddingVectorRead)
+	if len(reads) == 0 {
+		return nil
+	}
+	memory, _ := tx.Statement.Context.Value(actualMemoryRecallCompletionsKey{}).([]actualMemoryRecallCompletion)
+	semantic, _ := tx.Statement.Context.Value(actualMemorySemanticCompletionsKey{}).([]actualMemorySemanticCompletion)
+	if len(memory) > 0 || len(semantic) > 0 {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	all := map[string]originalBodyLease{}
+	payloads := map[string]originalBodyPayload{}
+	content := []NextcloudContentLease{}
+	contexts := []context.Context{tx.Statement.Context}
+	finishes := []func(error) error{}
+	defer func() {
+		for i := len(finishes) - 1; i >= 0; i-- {
+			err := finishes[i](finalErr)
+			if finalErr == nil {
+				finalErr = err
+			}
+		}
+	}()
+	mergePayload := func(in map[string]originalBodyPayload) error {
+		for id, b := range in {
+			if old, ok := payloads[id]; ok && !reflect.DeepEqual(old, b) {
+				return ErrOriginalBodyUnavailable
+			}
+			payloads[id] = b
+		}
+		return nil
+	}
+	for _, r := range reads {
+		if r == nil || r.query == nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := r.start(); err != nil {
+			return err
+		}
+		finishes = append(finishes, r.finish)
+		q := r.query.read
+		if err := q.start(); err != nil {
+			return err
+		}
+		finishes = append(finishes, q.finish)
+		v := q.view()
+		c, err := r.makeConsumptionInTx(tx, r.search)
+		if err != nil || !reflect.DeepEqual(c, r.consumption) {
+			return ErrKnowledgeInputChanged
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, r.leases); err != nil {
+			return err
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, v.leases); err != nil {
+			return err
+		}
+		if err = mergePayload(r.payloads); err != nil {
+			return err
+		}
+		if err = mergePayload(v.payloads); err != nil {
+			return err
+		}
+		content = append(content, v.content...)
+		contexts = append(contexts, r.ctx, q.ctx)
+	}
+	if err := checkActualModelOriginalReadsInTx(tx); err != nil {
+		return err
+	}
+	models, _ := tx.Statement.Context.Value(actualModelOriginalReadsKey{}).([]*modelOriginalRead)
+	for _, m := range models {
+		if m == nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := m.startCheck(); err != nil {
+			return err
+		}
+		finishes = append(finishes, m.finishCheck)
+		if err := mergeMemoryFinalLeaseBindings(all, m.hold.Leases); err != nil {
+			return err
+		}
+		contexts = append(contexts, m.ctx)
+		for _, body := range m.hold.Bodies {
+			var b originalBodyPayload
+			if err := bodyInternal(tx).Where("id=?", body.Head.BodyID).Take(&b).Error; err != nil {
+				return err
+			}
+			if b.TenantID != m.hold.Proof.OwnerTenantID || b.BodySHA256 != body.Receipt.BodyDigest || b.State != "live" || b.Payload != nil && (bodySHA([]byte(*b.Payload)) != b.BodySHA256 || int64(len([]byte(*b.Payload))) != b.BodyBytes) {
+				return ErrOriginalBodyUnavailable
+			}
+			if err := mergePayload(map[string]originalBodyPayload{b.ID: b}); err != nil {
+				return err
+			}
+		}
+	}
+	// ALL current captured heads and authenticated journal precede the final
+	// joined tuple/payload/content-fence/SQLclock statement. No entity IO follows.
+	for _, r := range reads {
+		if err := checkOriginalBodyAvailableBatchForCapturedInTx(r.ctx, tx, r.rows, r.heads); err != nil {
+			return err
+		}
+		v := r.query.read.view()
+		if err := checkOriginalBodyAvailableBatchForCapturedInTx(v.ctx, tx, v.rows, v.heads); err != nil {
+			return err
+		}
+	}
+	if err := NewOriginalBodyRetentionStore(tx).checkJournalInTx(tx); err != nil {
+		return err
+	}
+	if err := knowledgeQueryFinalClockInTx(tx.WithContext(context.WithValue(tx.Statement.Context, knowledgeCompletionClockPhaseKey{}, true)), all, payloads, content); err != nil {
+		return err
+	}
+	for _, ctx := range contexts {
+		if ctx == nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Fixed test observation of the genuine completion union. No names, tuples,
+// permission or lease capability are manufactured by this boolean observer.
+func KnowledgeCompletionSQLClockObserved(ctx context.Context, tx *gorm.DB) bool {
+	if ctx == nil || tx == nil {
+		return false
+	}
+	phase, _ := ctx.Value(knowledgeCompletionClockPhaseKey{}).(bool)
+	if !phase {
+		return false
+	}
+	if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+		return false
+	}
+	reads, _ := ctx.Value(actualKnowledgeCompletionKey{}).([]*KnowledgeSQLiteEmbeddingVectorRead)
+	if len(reads) == 0 {
+		return false
+	}
+	pool, err := tx.DB()
+	if err != nil {
+		return false
+	}
+	for _, r := range reads {
+		if r == nil || r.query == nil || !sameOriginalModelCallerInRepository(ctx, r.ctx) {
+			return false
+		}
+		actual, e := r.store.db.DB()
+		if e != nil || actual != pool {
+			return false
+		}
+	}
+	return true
+}
