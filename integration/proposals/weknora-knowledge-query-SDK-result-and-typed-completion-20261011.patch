+package repository
+
+import (
+	"encoding/json"
+	"reflect"
+	"sort"
+
+	"gorm.io/gorm"
+)
+
+// One final SQLite statement observes all private lease tuples, complete body
+// payloads and content fences with the same DB clock, after all previous IO.
+// Missing payload baselines are rejected, never discovered as new authority.
+func knowledgeQueryFinalClockInTx(tx *gorm.DB, all map[string]originalBodyLease, payloads map[string]originalBodyPayload, content []NextcloudContentLease) error {
+	if tx.Dialector.Name() != "sqlite" || len(all) == 0 {
+		return ErrOriginalBodyUnavailable
+	}
+	ids := []string{}
+	for id, l := range all {
+		if id == "" || l.LeaseID != id || l.Kind != "read" {
+			return ErrOriginalBodyUnavailable
+		}
+		if _, ok := payloads[l.BodyID]; !ok {
+			return ErrOriginalBodyUnavailable
+		}
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	contentIDs := []string{}
+	expectedContent := map[string]NextcloudContentLease{}
+	for _, l := range content {
+		if previous, ok := expectedContent[l.ID]; ok && previous != l {
+			return ErrNextcloudContentLeaseExpired
+		}
+		if l.ID == "" || l.Kind != NextcloudContentReadLease {
+			return ErrNextcloudContentLeaseExpired
+		}
+		if _, ok := expectedContent[l.ID]; !ok {
+			contentIDs = append(contentIDs, l.ID)
+		}
+		expectedContent[l.ID] = l
+	}
+	sort.Strings(contentIDs)
+	type row struct {
+		Domain, ID, BodyID, OwnerID, Kind, PayloadJSON, KB, Knowledge, BroadState, ExactState string
+		Tenant                                                                                uint64
+		Epoch, ExpiresAtMS, ClockMS, BroadEpoch, ExactEpoch                                   int64
+		ReleasedAtMS                                                                          *int64
+	}
+	sql := `SELECT 'body' AS domain,l.lease_id AS id,l.body_id,l.owner_id,l.kind,l.epoch,l.expires_at_ms,l.released_at_ms,0 AS tenant,'' AS kb,'' AS knowledge,'' AS broad_state,0 AS broad_epoch,'' AS exact_state,0 AS exact_epoch,
+ json_object('ID',p.id,'TenantID',p.tenant_id,'BodySHA256',p.body_sha256,'OriginDomainSHA256',p.origin_domain_sha256,'Payload',p.payload,'BodyBytes',p.body_bytes,'StorageKind',p.storage_kind,'State',p.state,'CreatedAtMS',p.created_at_ms,'LastCheckedAtMS',p.last_checked_at_ms,'RetiredAtMS',p.retired_at_ms,'BodyDeadlineMS',p.body_deadline_ms,'MetadataDeadlineMS',p.metadata_deadline_ms,'PurgeToken',p.purge_token,'PurgeEpoch',p.purge_epoch) AS payload_json,CAST((julianday('now')-2440587.5)*86400000 AS INTEGER) AS clock_ms
+ FROM original_body_leases l JOIN original_body_payloads p ON p.id=l.body_id WHERE l.lease_id IN ?
+ UNION ALL SELECT 'content' AS domain,l.lease_id AS id,'' AS body_id,l.owner_id,l.kind,l.epoch,l.expires_at_ms,l.released_at_ms,l.tenant_id AS tenant,l.knowledge_base_id AS kb,l.knowledge_id AS knowledge,b.state AS broad_state,b.epoch AS broad_epoch,COALESCE(e.state,'') AS exact_state,COALESCE(e.epoch,0) AS exact_epoch,'' AS payload_json,CAST((julianday('now')-2440587.5)*86400000 AS INTEGER) AS clock_ms
