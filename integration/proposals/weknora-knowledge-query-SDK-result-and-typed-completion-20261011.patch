+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if q.failed != nil {
+		return q.failed
+	}
+	if err := q.ctx.Err(); err != nil {
+		return err
+	}
+	q.checks.Add(1)
+	return nil
+}
+func (q *KnowledgeQueryEmbeddingRead) finish(err error) error {
+	q.mu.Lock()
+	if err == nil {
+		err = q.ctx.Err()
+	}
+	if err != nil && q.failed == nil {
+		q.failed = err
+		q.cancel()
+	}
+	q.mu.Unlock()
+	q.checks.Done()
+	return err
