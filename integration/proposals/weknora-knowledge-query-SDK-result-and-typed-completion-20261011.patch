+		// or description. Those are not body152 entity fields and are not read here.
+		query = query.Select("id,tenant_id,type,creator_id,is_temporary,embedding_model_id,summary_model_id,chunking_config,image_processing_config,vlm_config,asr_config,extract_config,faq_config,question_generation_config,auto_tag_config,profile_config,wiki_config,indexing_strategy,enrichment_templates,deleted_at")
