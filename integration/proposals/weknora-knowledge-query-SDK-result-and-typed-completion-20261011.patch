+					err := local.Raw("SELECT l.lease_id,l.body_id,l.owner_id,l.kind,l.epoch FROM original_body_leases l JOIN original_body_field_heads h ON h.body_id=l.body_id WHERE h.source_table='knowledge_sqlite_query_receipts' AND h.row_key=? AND l.released_at_ms IS NULL AND l.kind='read'", snapshot.ReceiptID).Take(&owned).Error
+					fail := func() {
+						mu.Lock()
+						expiryObserver = errors.Join(expiryObserver, errors.New("actual final owned query expiry observation failed"))
+						mu.Unlock()
+					}
+					if err != nil || owned.LeaseID == "" {
+						fail()
+						return
+					}
+					requested := false
+					for _, v := range tx.Statement.Vars {
+						if id, ok := v.(string); ok && id == owned.LeaseID {
+							requested = true
+						}
+						if ids, ok := v.([]string); ok {
+							for _, id := range ids {
+								if id == owned.LeaseID {
+									requested = true
+								}
+							}
+						}
+					}
+					if !requested {
+						return
+					}
+					if !crossed.CompareAndSwap(false, true) {
+						return
+					}
+					var now int64
+					if local.Session(&gorm.Session{NewDB: true}).Raw("SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)").Scan(&now).Error != nil {
+						fail()
+						return
+					}
+					expiry := now + 60
+					update := local.Session(&gorm.Session{NewDB: true}).Table("original_body_leases").Where("lease_id=? AND body_id=? AND owner_id=? AND kind=? AND epoch=? AND released_at_ms IS NULL", owned.LeaseID, owned.BodyID, owned.OwnerID, owned.Kind, owned.Epoch).Update("expires_at_ms", expiry)
+					if update.Error != nil || update.RowsAffected != 1 {
+						fail()
+						return
+					}
+					var after struct {
+						LeaseID, BodyID, OwnerID, Kind string
+						Epoch, ExpiresAtMS             int64
+					}
+					if local.Session(&gorm.Session{NewDB: true}).Table("original_body_leases").Where("lease_id=?", owned.LeaseID).Take(&after).Error != nil || after.LeaseID != owned.LeaseID || after.BodyID != owned.BodyID || after.OwnerID != owned.OwnerID || after.Kind != owned.Kind || after.Epoch != owned.Epoch || after.ExpiresAtMS != expiry {
+						fail()
+						return
+					}
+					time.Sleep(120 * time.Millisecond)
+					if local.Session(&gorm.Session{NewDB: true}).Raw("SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)").Scan(&now).Error != nil || now < expiry {
+						fail()
+						return
+					}
+					reached.Store(true)
+				}))
+				t.Cleanup(func() { require.NoError(t, db.Callback().Row().Remove(callback)) })
+			}
+			err = messages.UpdateMessage(resultCtx, assistant)
+			if mode == "naked_vector_completion_refuses" || mode == "late_actual_SQL_clock" {
+				if mode == "late_actual_SQL_clock" {
+					require.True(t, crossed.Load())
+					require.True(t, reached.Load())
