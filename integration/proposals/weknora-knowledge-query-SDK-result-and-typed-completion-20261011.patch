+	var rows []row
+	if err := bodyInternal(tx).Raw(sql, ids, contentIDs).Scan(&rows).Error; err != nil {
+		return err
+	}
+	if len(rows) != len(ids)+len(contentIDs) {
+		return ErrOriginalBodyUnavailable
+	}
+	seen := map[string]bool{}
+	for _, r := range rows {
+		if seen[r.Domain+r.ID] || r.ReleasedAtMS != nil || r.ExpiresAtMS <= r.ClockMS {
+			return ErrOriginalBodyUnavailable
+		}
+		seen[r.Domain+r.ID] = true
+		if r.Domain == "body" {
+			l, ok := all[r.ID]
+			if !ok || l.BodyID != r.BodyID || l.OwnerID != r.OwnerID || l.Kind != r.Kind || l.Epoch != r.Epoch {
+				return ErrOriginalBodyUnavailable
+			}
+			var b originalBodyPayload
+			if json.Unmarshal([]byte(r.PayloadJSON), &b) != nil || !reflect.DeepEqual(payloads[r.BodyID], b) || b.State != "live" || b.PurgeEpoch != r.Epoch {
+				return ErrOriginalBodyUnavailable
+			}
+		} else if r.Domain == "content" {
+			l, ok := expectedContent[r.ID]
+			if !ok || l.OwnerID != r.OwnerID || l.TenantID != r.Tenant || l.KnowledgeBaseID != r.KB || l.KnowledgeID != r.Knowledge || l.Epoch != r.Epoch || string(l.Kind) != r.Kind || r.BroadState != "open" || r.Knowledge == "" && r.BroadEpoch != r.Epoch || r.Knowledge != "" && (r.ExactState != "open" || r.ExactEpoch != r.Epoch) {
+				return ErrNextcloudContentLeaseExpired
+			}
+		} else {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
