+package types
+
+// Immutable actual human-query computation, separate from memory policy.
+type KnowledgeQueryEmbeddingInput struct {
+	ID                                                               string `gorm:"primaryKey"`
+	TenantID                                                         uint64
+	KnowledgeBaseID, SessionID, MessageID, AdmissionID, GenerationID string
+	MessageBodyDigest, PlanJSON, PlanDigest                          string
+	KBRevision                                                       uint64
+	KBConfigDigest, ModelID, ModelProofJSON, SpaceDigest             string
+	ExpectedDimensions                                               int
+	InputJSON, InputSHA256, Digest                                   string
+	CreatedAtMS                                                      int64
+}
+
+func (KnowledgeQueryEmbeddingInput) TableName() string { return "knowledge_sqlite_query_inputs" }
+
+type KnowledgeQueryEmbeddingReceipt struct {
+	ID                                           string `gorm:"primaryKey"`
+	InputID, InputDigest                         string
+	TenantID                                     uint64
+	KnowledgeBaseID, ModelID, SpaceDigest        string
+	Dimensions                                   int
+	VectorJSON, BodySHA256, VectorSHA256, Digest string
+	CreatedAtMS                                  int64
+}
+
+func (KnowledgeQueryEmbeddingReceipt) TableName() string { return "knowledge_sqlite_query_receipts" }
+
+type KnowledgeQueryEmbeddingInputSnapshot struct {
+	OriginalID, OriginalDigest, KnowledgeBaseID, ModelID, Text, SpaceDigest string
+	ExpectedDimensions                                                      int
+}
+type KnowledgeQueryEmbeddingVectorSnapshot struct {
+	OriginalID, OriginalDigest, ReceiptID, ReceiptDigest, KnowledgeBaseID, ModelID, SpaceDigest string
+	Vector                                                                                      []float32
+}
+
+// Selection metadata is an influencing-input dependency, never a read grant.
+// Current completion requires the private live query/vector readers too.
+type KnowledgeEmbeddingCandidate struct {
+	RowID                                                          uint64
+	InputID, InputDigest, ReceiptID, ReceiptDigest, ModelProofJSON string
+	Revision                                                       int64
+}
+type KnowledgeEmbeddingHit struct {
+	RowID    uint64
+	Distance float64
+}
