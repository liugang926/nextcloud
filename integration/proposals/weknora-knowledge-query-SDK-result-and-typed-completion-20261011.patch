+func WithKnowledgeQueryMessagePlan(ctx context.Context, plan *types.MessageMaterialReadPlan, message string) (context.Context, error) {
+	if ctx == nil || ctx.Err() != nil || plan == nil || plan.MetadataDigest == "" || plan.Request.AllSession || len(plan.Request.MessageIDs) != 1 || plan.Request.MessageIDs[0] != message || message == "" || plan.SourceLineage.RequireComplete() != nil || len(plan.SourceLineage.Sources) != 0 || len(plan.ParentPlans) != 0 || len(plan.RecallHistory) != 0 {
