+func (q *KnowledgeQueryEmbeddingRead) claimRows(tx *gorm.DB, rows []originalBodyAvailabilityRow) error {
+	if err := checkOriginalBodyAvailableBatchInTx(q.ctx, tx, rows); err != nil {
+		return err
