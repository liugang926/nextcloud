+
+// No lock spans SQL or a wait on the pool. The only mutable publication fields
+// are copied while the lifetime lock is held; Commit publishes after commit.
+func (q *KnowledgeQueryEmbeddingRead) view() *KnowledgeQueryEmbeddingRead {
+	q.mu.Lock()
+	defer q.mu.Unlock()
