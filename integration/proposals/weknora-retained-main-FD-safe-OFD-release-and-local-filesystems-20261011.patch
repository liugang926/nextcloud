index 0000000000000000000000000000000000000000..271a623f252dbfe69b2a43997de3cbd56c935426
--- /dev/null
+++ b/internal/database/migration_peer_sqlite_filesystem_linux_test.go
@@ -0,0 +1,60 @@
+//go:build linux
+
+package database
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+// Pure classification has no DB/permission/route capabilities. Actual Fstatfs
+// is independently checked on every retained descriptor acquisition/recheck.
+func TestPeerSQLiteLinuxFilesystemClasses(t *testing.T) {
+	cases := []struct {
+		name  string
+		kind  uint32
+		flags uint64
+		class string
+	}{
+		{"ext4", unix.EXT4_SUPER_MAGIC, 0, "ext4"},
+		{"overlay", unix.OVERLAYFS_SUPER_MAGIC, 0, "overlay"},
+		{"xfs", unix.XFS_SUPER_MAGIC, 0, "xfs"},
+		{"btrfs", unix.BTRFS_SUPER_MAGIC, 0, "btrfs"},
+		{"tmpfs", unix.TMPFS_MAGIC, 0, "tmpfs"},
+		{"nfs_closed", unix.NFS_SUPER_MAGIC, 0, ""},
+		{"cifs_closed", unix.CIFS_SUPER_MAGIC, 0, ""},
+		{"fuse_closed", unix.FUSE_SUPER_MAGIC, 0, ""},
+		{"unknown_closed", 0xffffffff, 0, ""},
+		{"readonly_local_closed", unix.EXT4_SUPER_MAGIC, unix.ST_RDONLY, ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) { require.Equal(t, c.class, peerSQLiteLinuxFilesystemClass(c.kind, c.flags)) })
+	}
+}
+func TestPeerSQLiteActualFilesystemContract(t *testing.T) {
+	dsn, options := peerSQLiteActual80(t)
+	held, err := acquirePeerSQLiteMigrationExclusion(t.Context(), dsn, options)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		if err := held.Close(); err != nil {
+			t.Error("actual FS owner unlock failed")
+		}
+	})
+	var actual unix.Statfs_t
+	require.NoError(t, unix.Fstatfs(int(held.file.Fd()), &actual))
+	class := peerSQLiteLinuxFilesystemClass(uint32(actual.Type), uint64(actual.Flags))
+	require.NotEmpty(t, class)
+	stamp, err := peerSQLiteDescriptorFilesystem(held.file)
+	require.NoError(t, err)
+	require.Equal(t, held.entry.filesystem, stamp)
+	info, err := held.file.Stat()
+	require.NoError(t, err)
+	current, err := os.Stat(options.SQLiteDBPath)
+	require.NoError(t, err)
+	require.True(t, os.SameFile(info, current))
+	require.NoError(t, held.check(t.Context()))
+	t.Logf("actual_retained_linux_filesystem_class=%s", class)
+}
