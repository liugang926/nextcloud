@@ -0,0 +1,201 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// Genuine native producers and the exact migrated schema create every fact.
+// These source-only drafts do not execute GC or treat retirement metadata as
+// deletion permission. Parent bodies must survive active descendant reads.
+func memoryRetirementCurrentSQL(t *testing.T, f *memAtomicSQLFixture, itemID string) types.MemoryDerivedPublication {
+	t.Helper()
+	var control types.MemoryDerivedControl
+	require.NoError(t, f.db.Where("tenant_id=? AND subject_id=? AND object_kind='memory_item' AND object_id=?", f.scope.TenantID, f.scope.SubjectID, itemID).Take(&control).Error)
+	var fact types.MemoryDerivedPublication
+	require.NoError(t, f.db.Where("tenant_id=? AND subject_id=? AND object_kind='memory_item' AND object_id=? AND revision=?", f.scope.TenantID, f.scope.SubjectID, itemID, control.Revision).Take(&fact).Error)
+	require.Equal(t, control.Present, fact.Present)
+	return fact
+}
+func memoryRetirementClockSQL(t *testing.T, db *gorm.DB) int64 {
+	t.Helper()
+	query := "SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)"
+	if db.Dialector.Name() == "postgres" {
+		query = "SELECT CAST(floor(extract(epoch FROM clock_timestamp())*1000) AS BIGINT)"
+	}
+	var now int64
+	require.NoError(t, db.Session(&gorm.Session{NewDB: true}).Raw(query).Scan(&now).Error)
+	return now
+}
+func assertMemoryRetirementSQL(t *testing.T, f *memAtomicSQLFixture, before, after types.MemoryDerivedPublication, low, high int64) types.MemoryDerivedRetirement {
+	t.Helper()
+	var fact types.MemoryDerivedRetirement
+	require.NoError(t, f.db.Where("previous_publication_id=?", before.ID).Take(&fact).Error)
+	var previous, successor types.MemoryDerivedBodyReceipt
+	require.NoError(t, f.db.Where("publication_id=?", before.ID).Take(&previous).Error)
+	require.NoError(t, f.db.Where("publication_id=?", after.ID).Take(&successor).Error)
+	require.Equal(t, before.ID, after.ParentPublicationID)
+	require.Equal(t, before.ID, fact.PreviousPublicationID)
+	require.Equal(t, after.ID, fact.SuccessorPublicationID)
+	require.Equal(t, before.Digest, fact.PreviousPublicationDigest)
+	require.Equal(t, after.Digest, fact.SuccessorPublicationDigest)
+	require.Equal(t, before.Revision, fact.PreviousRevision)
+	require.Equal(t, after.Revision, fact.ControlRevision)
+	require.Equal(t, after.Present, fact.ControlPresent)
+	require.Equal(t, f.scope.TenantID, fact.TenantID)
+	require.Equal(t, f.scope.SubjectID, fact.SubjectID)
+	require.Equal(t, "memory_item", fact.ObjectKind)
+	require.Equal(t, before.ObjectID, fact.ObjectID)
+	require.Equal(t, previous.Digest, fact.PreviousReceiptDigest)
+	require.Equal(t, successor.Digest, fact.SuccessorReceiptDigest)
+	require.Equal(t, previous.BodyID, fact.PreviousBodyID)
+	require.Equal(t, successor.BodyID, fact.SuccessorBodyID)
+	require.Equal(t, previous.SlotID, fact.PreviousSlotID)
+	require.Equal(t, successor.SlotID, fact.SuccessorSlotID)
+	require.Equal(t, previous.HeadRevision, fact.PreviousHeadRevision)
+	require.Equal(t, successor.HeadRevision, fact.SuccessorHeadRevision)
+	require.Equal(t, previous.SourceIdentitySHA256, fact.PreviousSourceIdentitySHA256)
+	require.Equal(t, successor.SourceIdentitySHA256, fact.SuccessorSourceIdentitySHA256)
+	require.GreaterOrEqual(t, fact.RetiredAtMS, low)
+	require.LessOrEqual(t, fact.RetiredAtMS, high)
+	unsigned := fact
+	unsigned.Digest = ""
+	digest, err := repository.KnowledgeInputDigest(unsigned)
+	require.NoError(t, err)
+	require.Equal(t, digest, fact.Digest)
+	require.Error(t, f.db.Model(&types.MemoryDerivedRetirement{}).Where("previous_publication_id=?", before.ID).Update("reason", "publication_deleted").Error)
+	require.Error(t, f.db.Where("previous_publication_id=?", before.ID).Delete(&types.MemoryDerivedRetirement{}).Error)
+	var unchanged types.MemoryDerivedRetirement
+	require.NoError(t, f.db.Where("previous_publication_id=?", before.ID).Take(&unchanged).Error)
+	require.Equal(t, fact, unchanged)
+	return fact
+}
+func memoryRetirementInsertFaultSQL(t *testing.T, f *memAtomicSQLFixture, publicationID string) {
+	t.Helper()
+	name := "retirement_fault_" + strings.ReplaceAll(uuid.NewString(), "-", "")
+	var install, remove []string
+	if f.db.Dialector.Name() == "postgres" {
+		install = []string{fmt.Sprintf("CREATE FUNCTION %s() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.previous_publication_id='%s' THEN RAISE EXCEPTION 'owned retirement insert refusal'; END IF; RETURN NEW; END; $$", name, publicationID), fmt.Sprintf("CREATE TRIGGER %s BEFORE INSERT ON memory_derived_retirements FOR EACH ROW EXECUTE FUNCTION %s()", name, name)}
+		remove = []string{"DROP TRIGGER IF EXISTS " + name + " ON memory_derived_retirements", "DROP FUNCTION IF EXISTS " + name + "()"}
+	} else {
+		install = []string{fmt.Sprintf("CREATE TRIGGER %s BEFORE INSERT ON memory_derived_retirements WHEN NEW.previous_publication_id='%s' BEGIN SELECT RAISE(ABORT,'owned retirement insert refusal'); END", name, publicationID)}
+		remove = []string{"DROP TRIGGER IF EXISTS " + name}
+	}
+	t.Cleanup(func() {
+		cleanup, cancel := context.WithTimeout(context.WithoutCancel(f.ctx), 5*time.Second)
+		defer cancel()
+		var joined error
+		for _, sql := range remove {
+			joined = errors.Join(joined, f.db.Session(&gorm.Session{NewDB: true, Context: cleanup}).Exec(sql).Error)
+		}
+		if joined != nil {
+			t.Errorf("owned retirement fault cleanup: %v", joined)
+		}
+	})
+	for _, sql := range install {
+		require.NoError(t, f.db.Session(&gorm.Session{NewDB: true}).Exec(sql).Error)
+	}
+}
+func runMemoryDerivedRetirementSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"successor_preserves_ancestor", "delete_all", "retirement_insert_rolls_back", "reversible_disable"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			item, err := f.service.Remember(f.ctx, types.MemoryItem{Kind: types.MemoryKindFact, Topic: "manual editor preference", Content: "The user's editor for daily coding is Neovim.", Importance: 5, Origin: types.MemoryOriginManual})
+			require.NoError(t, err)
+			before := memoryRetirementCurrentSQL(t, f, item.ID)
+			require.True(t, before.Present)
+			var oldReceipt types.MemoryDerivedBodyReceipt
+			require.NoError(t, f.db.Where("publication_id=?", before.ID).Take(&oldReceipt).Error)
+			beforeFacts := memAtomicSQLCount(t, f, "memory_derived_publications")
+			beforeRetirements := memAtomicSQLCount(t, f, "memory_derived_retirements")
+			var beforeBodyCount int64
+			require.NoError(t, f.db.Table("original_body_payloads").Count(&beforeBodyCount).Error)
+			low := memoryRetirementClockSQL(t, f.db)
+			switch mode {
+			case "reversible_disable":
+				require.NoError(t, f.service.SetEnabled(f.ctx, false))
+				require.NoError(t, f.service.SetEnabled(f.ctx, true))
+				require.Equal(t, before, memoryRetirementCurrentSQL(t, f, item.ID))
+				require.Equal(t, beforeRetirements, memAtomicSQLCount(t, f, "memory_derived_retirements"))
+			case "retirement_insert_rolls_back":
+				memoryRetirementInsertFaultSQL(t, f, before.ID)
+				_, err = f.service.UpdateItem(f.ctx, item.ID, "The user's editor for daily coding is VS Code.", 4)
+				require.ErrorContains(t, err, "owned retirement insert refusal", "actual native SQL trigger must fire")
+				require.Equal(t, before, memoryRetirementCurrentSQL(t, f, item.ID))
+				require.Equal(t, beforeFacts, memAtomicSQLCount(t, f, "memory_derived_publications"))
+				require.Equal(t, beforeRetirements, memAtomicSQLCount(t, f, "memory_derived_retirements"))
+				var afterBodyCount int64
+				require.NoError(t, f.db.Table("original_body_payloads").Count(&afterBodyCount).Error)
+				require.Equal(t, beforeBodyCount, afterBodyCount)
+				actual, getErr := f.repo.GetItem(f.ctx, f.scope, item.ID)
+				require.NoError(t, getErr)
+				require.NotNil(t, actual)
+				require.Equal(t, item.Content, actual.Content)
+			case "delete_all":
+				deleted, deleteErr := f.repo.DeleteAll(f.ctx, f.scope)
+				require.NoError(t, deleteErr)
+				require.EqualValues(t, 1, deleted)
+				after := memoryRetirementCurrentSQL(t, f, item.ID)
+				require.False(t, after.Present)
+				fact := assertMemoryRetirementSQL(t, f, before, after, low, memoryRetirementClockSQL(t, f.db))
+				require.Equal(t, "publication_deleted", fact.Reason)
+			case "successor_preserves_ancestor":
+				updated, updateErr := f.service.UpdateItem(f.ctx, item.ID, "The user's editor for daily coding is VS Code.", 4)
+				require.NoError(t, updateErr)
+				after := memoryRetirementCurrentSQL(t, f, item.ID)
+				fact := assertMemoryRetirementSQL(t, f, before, after, low, memoryRetirementClockSQL(t, f.db))
+				require.Equal(t, "publication_superseded", fact.Reason)
+				reader, ok := f.admissions.(interfaces.MemoryDerivedLifetimeReader)
+				require.True(t, ok)
+				read, beginErr := reader.BeginMemoryDerivedRead(f.ctx, f.scope)
+				require.NoError(t, beginErr)
+				t.Cleanup(func() {
+					if closeErr := read.Close(); closeErr != nil {
+						t.Errorf("close actual descendant read: %v", closeErr)
+					}
+				})
+				snapshot, snapshotErr := read.Snapshot()
+				require.NoError(t, snapshotErr)
+				found := false
+				for _, actual := range snapshot.Items {
+					if actual.ID == item.ID {
+						found = true
+						require.Equal(t, updated.Content, actual.Content)
+					}
+				}
+				require.True(t, found)
+				var held int64
+				require.NoError(t, f.db.Table("original_body_leases").Where("body_id=? AND kind='read' AND released_at_ms IS NULL", oldReceipt.BodyID).Count(&held).Error)
+				require.Positive(t, held, "the current descendant still leases the retired ancestor")
+				require.NoError(t, read.Recheck())
+				require.NoError(t, read.Close())
+			}
+			var unchanged types.MemoryDerivedPublication
+			require.NoError(t, f.db.Where("id=?", before.ID).Take(&unchanged).Error)
+			require.Equal(t, before, unchanged, "retirement never rewrites the original bytes or immutable graph")
+			var body struct {
+				State                       string
+				RetiredAtMS, BodyDeadlineMS *int64
+			}
+			require.NoError(t, f.db.Table("original_body_payloads").Select("state,retired_at_ms,body_deadline_ms").Where("id=?", oldReceipt.BodyID).Take(&body).Error)
+			require.Equal(t, "live", body.State)
+			require.Nil(t, body.RetiredAtMS)
+			require.Nil(t, body.BodyDeadlineMS)
+			require.Zero(t, f.model.calls)
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryDerivedRetirementActualSQLite(t *testing.T)   { runMemoryDerivedRetirementSQL(t, false) }
+func TestPostgresMemoryDerivedRetirementActual(t *testing.T) { runMemoryDerivedRetirementSQL(t, true) }
