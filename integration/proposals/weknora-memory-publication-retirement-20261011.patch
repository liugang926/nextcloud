index 00000000..53614806
--- /dev/null
+++ b/internal/application/repository/memory_derived_retirement.go
@@ -0,0 +1,107 @@
+package repository
+
+import (
+	"errors"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func memoryDerivedRetirementDigest(fact *types.MemoryDerivedRetirement) (string, error) {
+	copy := *fact
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+
+// Called only by the genuine common publication producer, after its actual
+// body receipt is stored. Existing scope writers own the real subject row;
+// the current control remains locked until this entire transaction commits.
+// No body deadline, graph edge, original fact or read grant is changed here.
+func recordMemoryDerivedRetirementInTx(tx *gorm.DB, successor *types.MemoryDerivedPublication, receipt *types.MemoryDerivedBodyReceipt) error {
+	scope := interfaces.MemoryScope{TenantID: successor.TenantID, SubjectID: successor.SubjectID}
+	control, err := memoryDerivedControlInTx(tx, scope, successor.ObjectKind, successor.ObjectID)
+	if err != nil {
+		return err
+	}
+	if control.Revision != successor.Revision || control.Present != successor.Present {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var previous types.MemoryDerivedPublication
+	err = tx.Session(&gorm.Session{NewDB: true}).Select(memoryDerivedPublicationFields).
+		Where("tenant_id=? AND subject_id=? AND object_kind=? AND object_id=? AND revision<?", scope.TenantID, scope.SubjectID, successor.ObjectKind, successor.ObjectID, successor.Revision).
+		Order("revision DESC").Take(&previous).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil // Initial/UNKNOWN material has no proven predecessor to retire.
+	}
+	if err != nil {
+		return err
+	}
+	own, _ := tx.Statement.Context.Value(memoryDerivedOwnPublicationsKey{}).(map[string]bool)
+	sameResult := successor.CommitID != "" && previous.CommitID == successor.CommitID &&
+		previous.ProducerKind == successor.ProducerKind && previous.InputAdmissionID == successor.InputAdmissionID &&
+		previous.ExecutionAdmissionID == successor.ExecutionAdmissionID
+	if previous.ID != successor.ParentPublicationID && !own[previous.ID] && !sameResult {
+		// A raw/legacy gap is not repaired by observing a later producer. A
+		// previous effect from this exact result/transaction is an actual
+		// predecessor even when its graph points to the consumed original parent.
+		return nil
+	}
+	actual, err := loadMemoryDerivedPublication(tx, previous.ID)
+	if err != nil {
+		return err
+	}
+	previousProof, previousHead, err := memoryDerivedProofInTx(tx, actual)
+	if err != nil {
+		return err
+	}
+	successorProof, successorHead, err := memoryDerivedProofInTx(tx, successor)
+	if err != nil {
+		return err
+	}
+	if actual.Revision >= control.Revision || successorProof.BodyReceiptDigest != receipt.Digest || receipt.PublicationID != successor.ID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	// Both immutable receipts must still be the exact rows selected above.
+	// These metadata locks do not replace any body lease or authorize GC.
+	for _, id := range []string{previous.ID, successor.ID} {
+		var locked types.MemoryDerivedBodyReceipt
+		if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.Locking{Strength: "SHARE"}).Where("publication_id=?", id).Take(&locked).Error; err != nil {
+			return err
+		}
+		want := previousProof.BodyReceiptDigest
+		if id == successor.ID {
+			want = successorProof.BodyReceiptDigest
+		}
+		digest, digestErr := memoryDerivedBodyReceiptDigest(&locked)
+		if digestErr != nil || digest != want || locked.Digest != want {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	reason := "publication_superseded"
+	if !control.Present {
+		reason = "publication_deleted"
+	}
+	fact := &types.MemoryDerivedRetirement{
+		PreviousPublicationID: previous.ID, SuccessorPublicationID: successor.ID,
+		TenantID: scope.TenantID, SubjectID: scope.SubjectID, ObjectKind: successor.ObjectKind, ObjectID: successor.ObjectID,
+		PreviousRevision: actual.Revision, ControlRevision: control.Revision, ControlPresent: control.Present,
+		PreviousPublicationDigest: actual.Digest, SuccessorPublicationDigest: successor.Digest,
+		PreviousReceiptDigest: previousProof.BodyReceiptDigest, SuccessorReceiptDigest: successorProof.BodyReceiptDigest,
+		PreviousSlotID: previousHead.SlotID, SuccessorSlotID: successorHead.SlotID,
+		PreviousBodyID: previousHead.BodyID, SuccessorBodyID: successorHead.BodyID,
+		PreviousHeadRevision: previousHead.Revision, SuccessorHeadRevision: successorHead.Revision,
+		PreviousSourceIdentitySHA256: previousHead.SourceIdentitySHA256, SuccessorSourceIdentitySHA256: successorHead.SourceIdentitySHA256,
+		Reason: reason, RetiredAtMS: now,
+	}
+	fact.Digest, err = memoryDerivedRetirementDigest(fact)
+	if err != nil {
+		return err
+	}
+	return tx.Session(&gorm.Session{NewDB: true}).Create(fact).Error
+}
diff --git a/internal/application/service/memory_derived_retirement_sql_actual_test.go b/internal/application/service/memory_derived_retirement_sql_actual_test.go
