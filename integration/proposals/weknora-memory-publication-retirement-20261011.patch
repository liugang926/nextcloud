diff --git a/internal/types/memory_derived_retirement.go b/internal/types/memory_derived_retirement.go
new file mode 100644
index 00000000..3fd59ea7
--- /dev/null
+++ b/internal/types/memory_derived_retirement.go
@@ -0,0 +1,34 @@
+package types
+
+// MemoryDerivedRetirement records a real producer's supersession in the same
+// transaction as its successor publication. It is not a GC eligibility proof:
+// live descendants, historical consumers and leases may still need both bodies.
+// Unknown legacy predecessors never receive a reconstructed retirement fact.
+type MemoryDerivedRetirement struct {
+	PreviousPublicationID         string `gorm:"primaryKey"`
+	SuccessorPublicationID        string
+	TenantID                      uint64
+	SubjectID                     string
+	ObjectKind                    string
+	ObjectID                      string
+	PreviousRevision              uint64
+	ControlRevision               uint64
+	ControlPresent                bool
+	PreviousPublicationDigest     string
+	SuccessorPublicationDigest    string
+	PreviousReceiptDigest         string
+	SuccessorReceiptDigest        string
+	PreviousSlotID                string
+	SuccessorSlotID               string
