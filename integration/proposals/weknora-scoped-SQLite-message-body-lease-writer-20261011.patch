diff --git a/internal/application/repository/original_body_message_scopes.go b/internal/application/repository/original_body_message_scopes.go
index 481e03943..fbe5f3039 100644
--- a/internal/application/repository/original_body_message_scopes.go
+++ b/internal/application/repository/original_body_message_scopes.go
@@ -254,6 +254,9 @@ func (s *KnowledgeInputProvenanceStore) AcquireMessageBodyReadLeases(ctx context
 	}
 	ids := []string{}
 	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if e := reserveMessageBodyLeaseWriterInTx(tx); e != nil {
+			return e
+		}
 		if e := s.checkMessageMaterialPlanInTx(tx, plan.Request); e != nil {
 			return e
 		}
@@ -351,6 +354,9 @@ func (s *OriginalBodyRetentionStore) RenewLease(ctx context.Context, id string,
 		return ErrOriginalBodyUnavailable
 	}
 	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if e := reserveMessageBodyLeaseWriterInTx(tx); e != nil {
+			return e
+		}
 		if e := s.checkJournalInTx(tx); e != nil {
 			return e
 		}
@@ -427,3 +433,27 @@ func bodyLeaseScopesComplete(rows []originalBodyLeaseScope, tenant uint64) bool
 	}
 	return false
 }
+
+// These two lease operations are writers, even though their authority/journal
+// work first reads metadata. SQLite's deferred read snapshot must not precede
+// acquiring the single writer. WHERE 1=0 changes no row and fires no row trigger;
+// it creates neither a lease nor authorization. PG keeps its existing locks.
+// A nested caller still executes this write: an old outer read snapshot may
+// refuse with actual Busy/BusySnapshot. Never assume it already owns a writer,
+// start another pool transaction, weaken checks or retry that outer snapshot.
+func reserveMessageBodyLeaseWriterInTx(tx *gorm.DB) error {
+	if tx.Dialector.Name() != "sqlite" {
+		return nil
+	}
+	if err := tx.Statement.Context.Err(); err != nil {
+		return err
+	}
+	result := bodyInternal(tx.Session(&gorm.Session{NewDB: true, Context: tx.Statement.Context})).Exec("UPDATE original_body_leases SET expires_at_ms=expires_at_ms WHERE 1=0")
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 0 {
+		return ErrOriginalBodyUnavailable
+	}
+	return nil
+}
diff --git a/internal/application/service/message_body_lease_sqlite_writer_actual_test.go b/internal/application/service/message_body_lease_sqlite_writer_actual_test.go
