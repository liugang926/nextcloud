+// The pending90 payload is applied by a real migrate driver after production
+// full87. Its future startup/catalogue routing is deliberately a separate gate.
+// No AutoMigrate, fabricated receipt, force or ledger rewrite occurs here.
+func installKnowledgeSQLiteOriginal90ForTest(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	var path string
+	require.NoError(t, db.Raw("SELECT file FROM pragma_database_list WHERE name='main'").Scan(&path).Error)
+	require.NotEmpty(t, path)
+	root, e := filepath.Abs("../../..")
+	require.NoError(t, e)
+	m, e := migrate.New("file://"+filepath.Join(root, "migrations/pending/knowledge-sqlite-embedding-originals-000090"), "sqlite3://"+path)
+	require.NoError(t, e)
+	require.NoError(t, m.Migrate(90))
+	sourceClose, databaseClose := m.Close()
+	require.NoError(t, sourceClose)
+	require.NoError(t, databaseClose)
+	var version struct {
+		Version uint
+		Dirty   bool
+	}
+	require.NoError(t, db.Table("schema_migrations").Take(&version).Error)
+	require.EqualValues(t, 90, version.Version)
+	require.False(t, version.Dirty)
+	require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(db))
+	require.NoError(t, repository.InstallOriginalBodyRetentionCallbacks(db))
+}
+func knowledgeSQLiteOriginalLeaseIdsForTest(tx *gorm.DB) []string {
+	where, ok := tx.Statement.Clauses["WHERE"].Expression.(clause.Where)
+	if !ok {
+		return nil
+	}
+	for _, expr := range where.Exprs {
+		if e, ok := expr.(clause.Expr); ok && strings.TrimSpace(e.SQL) == "lease_id IN ?" && len(e.Vars) == 1 {
+			ids, _ := e.Vars[0].([]string)
+			return ids
+		}
+	}
+	return nil
+}
+func knowledgeSQLiteOriginalLastSaveForTest() bool {
+	pc := make([]uintptr, 48)
+	n := runtime.Callers(2, pc)
+	frames := runtime.CallersFrames(pc[:n])
+	save, clock := false, false
+	for {
+		f, more := frames.Next()
+		if strings.HasSuffix(f.Function, ".CheckKnowledgeSQLiteEmbeddingSavedFinalInTx") {
+			save = true
+		}
+		if strings.HasSuffix(f.Function, ".(*KnowledgeSQLiteEmbeddingInputRead).finalClockInTx") {
+			clock = true
+		}
+		if !more {
+			break
+		}
+	}
+	return save && clock
+}
