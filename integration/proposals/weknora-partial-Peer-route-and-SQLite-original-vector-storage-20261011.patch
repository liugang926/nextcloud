+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/postgres"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+func peerPartialUpFile(t *testing.T, root, dialect string, version uint) string {
+	t.Helper()
+	var manifest jointPeerForwardAssetManifest
+	require.NoError(t, json.Unmarshal(jointPeerForwardSourceAssetJSON, &manifest))
+	path := ""
+	for _, file := range manifest.Routes[dialect].Files {
+		if file.Version == version && file.Direction == "up" {
+			require.Empty(t, path)
+			path = filepath.Join(root, filepath.FromSlash(file.Path))
+		}
+	}
+	require.NotEmpty(t, path)
+	return path
+}
+
+func peerPartialInstallWrappers(t *testing.T, db *sql.DB, pg bool) {
+	t.Helper()
+	var owned *gorm.DB
+	var err error
+	if pg {
+		owned, err = gorm.Open(postgres.New(postgres.Config{DriverName: "postgres", Conn: db}), &gorm.Config{DisableAutomaticPing: true, Logger: gormlogger.Discard})
+	} else {
+		owned, err = gorm.Open(sqlite.New(sqlite.Config{Conn: db}), &gorm.Config{DisableAutomaticPing: true, Logger: gormlogger.Discard})
+	}
+	require.NoError(t, err)
+	require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(owned), "actual common-body installer, never fake original/permission facts")
+}
+
+func runPeerPartialForwardActual(t *testing.T, pg bool) {
+	prefixes := []uint{74, 75, 76, 77, 78, 79}
+	if pg {
+		prefixes = []uint{155, 156, 157, 158, 159, 160}
+	}
+	for _, prefix := range prefixes {
+		t.Run(fmtJointVersion(prefix), func(t *testing.T) {
+			modes := []string{"nonempty_upgrade_restart", "known_wrappers_upgrade_restart", "source_changed_no_mutation", "future_module_no_mutation", "mixed_root_no_mutation", "genuine_dirty_no_force", "late_footprint_before_driver_write"}
+			if pg {
+				modes = append(modes, "known_missing_local_guard_repaired", "optional_embedding_absent_upgrade")
+			}
+			for _, mode := range modes {
+				t.Run(mode, func(t *testing.T) {
+					root := sqliteRepoRoot(t)
+					chdirAndRestore(t, root)
+					if pg {
+						require.NotEmpty(t, os.Getenv("WEKNORA_MIGRATION_TEST_POSTGRES_DSN"), "actual full-feature owned PostgreSQL required; no skip")
+					}
+					pool, dsn, options := jointLineageFixture(t, pg)
+					dialect, common, final := "sqlite", uint(73), uint(89)
+					if pg {
+						dialect, common, final = "versioned", 154, 171
+						parsed, err := url.Parse(dsn)
+						require.NoError(t, err)
+						q := parsed.Query()
+						settings := strings.TrimSpace(strings.ReplaceAll(q.Get("options"), "-c app.skip_embedding=true", ""))
+						if mode == "optional_embedding_absent_upgrade" {
+							settings += " -c app.skip_embedding=true"
+						} else {
+							settings += " -c app.skip_embedding=false"
+						}
+						q.Set("options", settings)
+						parsed.RawQuery = q.Encode()
+						dsn = parsed.String()
+					}
+					setupSource := root
+					if mode == "genuine_dirty_no_force" {
+						setupSource = peerRouteCopiedRoot(t, root, dialect)
+						file := peerPartialUpFile(t, setupSource, dialect, prefix+1)
+						actual, err := os.ReadFile(file)
+						require.NoError(t, err)
+						require.NoError(t, os.WriteFile(file, append(actual, []byte("\nSELECT * FROM owned_partial_peer_failure;\n")...), 0600))
+					}
+					old := peerPrefixActualDriver(t, setupSource, dialect, dsn, options)
+					closed := false
+					closeOld := func() {
+						if closed {
+							return
+						}
+						closed = true
+						se, de := old.Close()
+						require.NoError(t, se)
+						require.NoError(t, de)
+					}
+					t.Cleanup(closeOld)
+					// Real historical common schema and migrations author this actual
+					// ledger; these retained legacy rows are not body/auth originals.
+					require.NoError(t, old.Migrate(common))
+					require.NoError(t, memoryFullExec(pool, dialect, "INSERT INTO tenants(id,name,business) VALUES(7,'partial-peer-owned','retained actual partial peer data')"))
+					if !pg {
+						_, err := pool.Exec("INSERT INTO nextcloud_gc_jobs(id,tenant_id,knowledge_base_id,datasource_id,external_id,knowledge_id,reason,state,not_before,original_not_before,next_attempt_at) VALUES('owned-partial-gc',7,'legacy-kb','legacy-source','legacy-file','legacy-knowledge','retired','blocked',CURRENT_TIMESTAMP,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)")
+						require.NoError(t, err)
+						_, err = pool.Exec("INSERT INTO nextcloud_gc_items(job_id,kind,object_ref,state,estimated_bytes,confirmed_released_bytes,lease_token) VALUES('owned-partial-gc','source_file','retained legacy object','blocked',27,3,'')")
+						require.NoError(t, err)
+					}
+					if pg && mode != "optional_embedding_absent_upgrade" {
+						_, err := pool.Exec("INSERT INTO embeddings(source_id,source_type,knowledge_base_id,dimension,content) VALUES('owned-partial-peer',1,NULL,2,'retained actual partial embedding')")
+						require.NoError(t, err)
+					}
+					require.NoError(t, old.Migrate(prefix), "genuine partial historical source, never synthetic ledger or final80 catalogue")
+					if mode == "genuine_dirty_no_force" {
+						require.Error(t, old.Migrate(prefix+1), "real failed next historical SQL creates honest dirty state")
+					}
+					closeOld()
+					if mode == "known_wrappers_upgrade_restart" {
+						peerPartialInstallWrappers(t, pool, pg)
+					}
+					if mode == "known_missing_local_guard_repaired" {
+						_, err := pool.Exec("DROP TRIGGER nextcloud_indexed_embedding_guard ON embeddings")
+						require.NoError(t, err)
+						core, err := inspectJoint125LocalRepair(context.Background(), pool)
+						require.NoError(t, err)
+						require.Equal(t, joint125GuardMissing, core.state)
+					}
+					if mode == "mixed_root_no_mutation" {
+						file := "000074_nextcloud_withdrawal_local_registry.up.sql"
+						if pg {
+							file = "000155_nextcloud_withdrawal_local_registry.up.sql"
+						}
+						actual, err := os.ReadFile(filepath.Join(root, "migrations", dialect, file))
+						require.NoError(t, err)
+						_, err = pool.Exec(string(actual))
+						require.NoError(t, err)
+					}
+					if mode == "future_module_no_mutation" {
+						actual, err := os.ReadFile(peerPartialUpFile(t, root, dialect, prefix+1))
+						require.NoError(t, err)
+						_, err = pool.Exec(string(actual))
+						require.NoError(t, err, "actual next module introduces its real future tables/columns/functions/indexes/triggers without changing the ledger")
+					}
+					if mode == "source_changed_no_mutation" {
+						copy := peerRouteCopiedRoot(t, root, dialect)
+						file := peerPartialUpFile(t, copy, dialect, prefix+1)
+						actual, err := os.ReadFile(file)
+						require.NoError(t, err)
+						require.NoError(t, os.WriteFile(file, append(actual, []byte("\n-- changed actual future source identity\n")...), 0600))
+						chdirAndRestore(t, copy)
+					}
+					beforeVersion, beforeDirty := jointLineageMigrationState(t, pool)
+					before := memoryFullSchemaSnapshot(t, pool, dialect)
+					var tenantBefore string
+					require.NoError(t, pool.QueryRow("SELECT business FROM tenants WHERE id=7").Scan(&tenantBefore))
+					var embeddingBefore string
+					if pg && mode != "optional_embedding_absent_upgrade" {
+						require.NoError(t, pool.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&embeddingBefore))
+					}
+					var gcBefore string
+					if !pg {
+						require.NoError(t, pool.QueryRow("SELECT kind||'/'||object_ref||'/'||state||'/'||estimated_bytes||'/'||confirmed_released_bytes||'/'||lease_token FROM nextcloud_gc_items WHERE job_id='owned-partial-gc'").Scan(&gcBefore))
+					}
+					var runErr error
+					if mode == "late_footprint_before_driver_write" {
+						ctx := context.Background()
+						if !pg {
+							held, err := acquirePeerSQLiteMigrationExclusion(ctx, dsn, options)
+							require.NoError(t, err)
+							t.Cleanup(func() { require.NoError(t, held.Close()) })
+							ctx = context.WithValue(ctx, jointPeerSQLiteMigrationContextKey{}, held)
+						}
+						captured, err := selectJointMigrationRoute(ctx, dsn, options, prefix, false, true)
+						require.NoError(t, err)
+						require.Equal(t, jointHistoricalPeerForwardSource, captured.lineage)
+						guarded, err := newJointPeerRouteMigrate(ctx, "file://"+filepath.ToSlash(captured.directory), dsn, options, prefix, captured)
+						require.NoError(t, err)
+						actual, err := os.ReadFile(peerPartialUpFile(t, root, dialect, prefix+1))
+						require.NoError(t, err)
+						_, err = pool.Exec(string(actual))
+						require.NoError(t, err)
+						before = memoryFullSchemaSnapshot(t, pool, dialect)
+						runErr = guarded.Up()
+						se, de := guarded.Close()
+						require.NoError(t, se)
+						require.NoError(t, de)
+					} else {
+						runErr = RunMigrationsWithOptions(dsn, options)
+					}
+					negative := mode == "source_changed_no_mutation" || mode == "future_module_no_mutation" || mode == "mixed_root_no_mutation" || mode == "genuine_dirty_no_force" || mode == "late_footprint_before_driver_write"
+					if negative {
+						cause := ErrJointSchemaUnknown
+						if mode == "source_changed_no_mutation" {
+							cause = ErrJointSchemaSourceIdentity
+						}
+						if mode == "genuine_dirty_no_force" {
+							cause = ErrJointSchemaAmbiguousDirty
+						}
+						require.ErrorIs(t, runErr, cause)
+						require.Equal(t, before, memoryFullSchemaSnapshot(t, pool, dialect), "refusal precedes actual SetVersion/Run; fault state is not repaired")
+						version, dirty := jointLineageMigrationState(t, pool)
+						require.Equal(t, beforeVersion, version)
+						require.Equal(t, beforeDirty, dirty)
+					} else {
+						require.NoError(t, runErr, "exact cumulative catalogue runs genuine remaining historical SQL then honest bridge")
+						version, dirty := jointLineageMigrationState(t, pool)
+						require.Equal(t, final, version)
+						require.False(t, dirty)
+						require.NoError(t, VerifyJointSchemaReady(context.Background(), dsn, options))
+						require.NoError(t, VerifyJointSchemaReadyOnDB(context.Background(), pool, dialect))
+						readyBefore := memoryFullSchemaSnapshot(t, pool, dialect)
+						require.NoError(t, RunMigrationsWithOptions(dsn, options), "same honest final lineage restart")
+						require.Equal(t, readyBefore, memoryFullSchemaSnapshot(t, pool, dialect))
+						var originals int
+						require.NoError(t, pool.QueryRow("SELECT count(*) FROM memory_original_admissions").Scan(&originals))
+						require.Zero(t, originals)
+						require.NoError(t, pool.QueryRow("SELECT count(*) FROM model_definition_originals").Scan(&originals))
+						require.Zero(t, originals)
+						if pg {
+							core, err := inspectJoint125LocalRepair(context.Background(), pool)
+							require.NoError(t, err)
+							if mode == "optional_embedding_absent_upgrade" {
+								require.Equal(t, joint125OptionalAbsent, core.state)
+							} else {
+								require.Equal(t, joint125GuardCurrent, core.state)
+							}
+						}
+					}
+					var tenantAfter string
+					require.NoError(t, pool.QueryRow("SELECT business FROM tenants WHERE id=7").Scan(&tenantAfter))
+					require.Equal(t, tenantBefore, tenantAfter)
+					if pg && mode != "optional_embedding_absent_upgrade" {
+						var after string
+						require.NoError(t, pool.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&after))
+						require.Equal(t, embeddingBefore, after)
+					}
+					if !pg {
+						var after string
+						require.NoError(t, pool.QueryRow("SELECT kind||'/'||object_ref||'/'||state||'/'||estimated_bytes||'/'||confirmed_released_bytes||'/'||lease_token FROM nextcloud_gc_items WHERE job_id='owned-partial-gc'").Scan(&after))
+						require.Equal(t, gcBefore, after)
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestPeerPartialForwardEveryPrefixActualSQLite(t *testing.T) {
+	runPeerPartialForwardActual(t, false)
+}
+func TestPostgresPeerPartialForwardEveryPrefixActual(t *testing.T) {
+	runPeerPartialForwardActual(t, true)
+}
