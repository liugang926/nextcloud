@@ -0,0 +1,37 @@
+package types
+
+// Metadata identifying a genuine SDK computation. Bodies remain in the
+// immutable original tables and under original-body retention controls.
+type KnowledgeSQLiteEmbeddingInput struct {
+	ID                                                 string `gorm:"primaryKey"`
+	TenantID                                           uint64
+	KnowledgeBaseID, KnowledgeID, ChunkID, AdmissionID string
+	ModelID, ModelProofJSON, SpaceDigest               string
+	ExpectedDimensions                                 int
+	InputJSON, InputSHA256, Digest                     string
+	CreatedAtMS                                        int64
+}
+
+func (KnowledgeSQLiteEmbeddingInput) TableName() string { return "knowledge_sqlite_embedding_inputs" }
+
+type KnowledgeSQLiteEmbeddingReceipt struct {
+	ID                                                          string `gorm:"primaryKey"`
+	TenantID                                                    uint64
+	KnowledgeBaseID, KnowledgeID, ChunkID, InputID, InputDigest string
+	RowID                                                       uint64
+	Revision                                                    int64
+	Dimension                                                   int
+	VectorJSON, VectorSHA256, Digest                            string
+	CreatedAtMS                                                 int64
+}
+
+func (KnowledgeSQLiteEmbeddingReceipt) TableName() string {
+	return "knowledge_sqlite_embedding_receipts"
+}
+
+type KnowledgeSQLiteEmbeddingVector struct {
+	RowID       uint64
+	Info        IndexInfo
+	Vector      []float32
+	SpaceDigest string
+}
