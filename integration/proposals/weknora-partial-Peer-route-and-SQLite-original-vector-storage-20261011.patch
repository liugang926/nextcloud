+// Begin accepts only the actual private current model reader and original build
+// context. A model DTO, a digest, or a raw chunk cannot author an input receipt.
+// The first slice is genuine independent human knowledge. Nonempty inherited
+// source graphs require the forthcoming build/content-lease union implementation.
+func BeginKnowledgeSQLiteEmbeddingInputs(ctx context.Context, reader interfaces.ModelOriginalRead, infos []*types.IndexInfo, wire []string) (*KnowledgeSQLiteEmbeddingInputRead, error) {
+	model, ok := reader.(*modelOriginalRead)
+	if !ok || model == nil || model.download || len(infos) == 0 || len(infos) > 4096 || len(infos) != len(wire) {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if !sameOriginalModelCallerInRepository(ctx, model.ctx) {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	snapshot, proof, err := model.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	recipe := snapshot.Parameters.OriginalEmbedding
+	if snapshot.Type != types.ModelTypeEmbedding || recipe == nil || modelembedding.ValidateOriginalEmbeddingDefinition(recipe) != nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	guard, ok := ctx.Value(knowledgeBuildInputKey{}).(knowledgeBuildInputContext)
+	source, actual := guard.reader.(*KnowledgeInputProvenanceStore)
+	if !ok || !actual || guard.proof == nil || guard.admission == nil || guard.proof.SourceLineage == nil || guard.proof.SourceLineage.RequireComplete() != nil || len(guard.proof.SourceLineage.Sources) != 0 {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	h := &KnowledgeSQLiteEmbeddingInputRead{db: model.db, model: model, proof: *proof, inputs: map[string]types.KnowledgeSQLiteEmbeddingInput{}, bodies: map[string]knowledgeSQLiteEmbeddingInputBody{}, leases: map[string]originalBodyLease{}, outputs: map[string][]float32{}, base: map[string]*knowledgeSQLiteEmbeddingControl{}, payloads: map[string]originalBodyPayload{}, committed: map[string]originalBodyLease{}, joined: make(chan struct{})}
+	h.ctx, h.cancel = context.WithCancel(ctx)
+	ids := []string{}
+	for _, info := range infos {
+		if info == nil || info.SourceType != types.ChunkSourceType || info.SourceID != info.ChunkID || info.ChunkID == "" || info.KnowledgeID != guard.proof.KnowledgeID || info.KnowledgeBaseID != guard.proof.KnowledgeBaseID || !utf8.ValidString(info.Content) {
+			h.cancel()
+			return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		ids = append(ids, info.ChunkID)
+	}
+	err = h.db.WithContext(h.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := knowledgeSQLiteEmbeddingSchema(tx); err != nil {
+			return err
+		}
+		authority, err := knowledgeSQLiteEmbeddingAuthority(tx, source)
+		if err != nil {
+			return err
+		}
+		captured, err := authority.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: guard.proof.TenantID, KnowledgeBaseID: guard.proof.KnowledgeBaseID, KnowledgeID: guard.proof.KnowledgeID, ChunkIDs: ids, Expected: guard.proof}, false)
+		if err != nil {
+			return err
+		}
+		admission, _, _, err := authority.admissionInTx(tx, captured.Knowledge, captured.Proof)
+		if err != nil {
+			return err
+		}
+		if admission.OriginKind != "human" {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		fresh, err := authority.AuthorizeCurrentKnowledgeInputWrite(h.ctx, captured.KnowledgeBase)
+		if err != nil {
+			return err
+		}
+		if !sameOriginalModelCallerInRepository(fresh, model.ctx) || captured.KnowledgeBase.EmbeddingModelID != proof.ModelID {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err = authority.recheckKnowledgeWorkerActor(h.ctx, captured.Proof); err != nil {
+			return err
+		}
+		h.ctx = WithKnowledgeBuildInputProof(h.ctx, source, captured.Proof)
+		chunks := map[string]*types.Chunk{}
+		for _, c := range captured.Chunks {
+			chunks[c.ID] = c
+		}
+		h.rows = append(h.rows, originalBodyAvailabilityRow{"knowledges", captured.Knowledge.ID})
+		h.rows = append(h.rows, originalBodyAvailabilityRow{"model_definition_originals", h.proof.DefinitionID}, originalBodyAvailabilityRow{"model_credential_originals", h.proof.CredentialID})
+		now, err := nextcloudLeaseNowMS(tx)
+		if err != nil {
+			return err
+		}
+		for i, info := range infos {
+			c := chunks[info.ChunkID]
+			if c == nil || !info.IsEnabled {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			expected := c.EmbeddingContent()
+			title := strings.TrimSpace(captured.Knowledge.Title)
+			if title != "" {
+				expected = title + "\n" + expected
+			}
+			if expected != info.Content || modelembedding.OriginalIndexText(expected) != wire[i] {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if _, seen := h.inputs[info.SourceID]; seen {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			h.rows = append(h.rows, originalBodyAvailabilityRow{"chunks", c.ID})
+			body := knowledgeSQLiteEmbeddingInputBody{Info: *info, WireText: wire[i], Proof: *captured.Proof}
+			data, err := json.Marshal(body)
+			if err != nil {
+				return err
+			}
+			fact := types.KnowledgeSQLiteEmbeddingInput{ID: uuid.NewString(), TenantID: captured.Proof.TenantID, KnowledgeBaseID: info.KnowledgeBaseID, KnowledgeID: info.KnowledgeID, ChunkID: c.ID, AdmissionID: captured.Proof.AdmissionID, ModelID: proof.ModelID, SpaceDigest: recipe.SpaceDigest, ExpectedDimensions: recipe.ExpectedDimensions, InputJSON: string(data), InputSHA256: bodySHA(data), CreatedAtMS: now}
+			proofJSON, err := json.Marshal(proof)
+			if err != nil {
+				return err
+			}
+			fact.ModelProofJSON = string(proofJSON)
+			fact.Digest, err = knowledgeSQLiteEmbeddingInputDigest(fact)
+			if err != nil {
+				return err
+			}
+			var existing struct{ ID uint64 }
+			q := tx.Table("lite_embeddings").Select("id").Where("source_id=? AND source_type=?", info.SourceID, int(info.SourceType)).Take(&existing)
+			if q.Error != nil && !errors.Is(q.Error, gorm.ErrRecordNotFound) {
+				return q.Error
+			}
+			// Old indexed rows are UNKNOWN, never recovered by signing their vectors.
+			if q.Error == nil {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if err = tx.Create(&fact).Error; err != nil {
+				return err
+			}
+			h.inputs[info.SourceID] = fact
+			h.bodies[info.SourceID] = body
+			h.base[info.SourceID] = nil
+			h.order = append(h.order, info.SourceID)
+			h.rows = append(h.rows, originalBodyAvailabilityRow{fact.TableName(), fact.ID})
+		}
+		if err = checkOriginalBodyAvailableBatchInTx(h.ctx, tx, h.rows); err != nil {
+			return err
+		}
+		h.heads, err = originalBodyBatchHeads(tx, h.rows)
+		if err != nil {
+			return err
+		}
+		if len(h.heads) == 0 {
+			return ErrOriginalBodyUnavailable
+		}
+		owner := "knowledge-sqlite-embedding/" + uuid.NewString()
+		retention := NewOriginalBodyRetentionStore(tx)
+		for _, head := range h.heads {
+			if _, borrowed := h.model.hold.Leases[head.BodyID]; borrowed {
+				continue
+			}
+			if _, seen := h.leases[head.BodyID]; seen {
+				continue
+			}
+			id, err := retention.acquireLeaseInTx(tx, head.BodyID, "read", owner, 15*time.Minute)
+			if err != nil {
+				return err
+			}
+			var lease originalBodyLease
+			if err = bodyInternal(tx).Where("lease_id=?", id).Take(&lease).Error; err != nil {
+				return err
+			}
+			h.leases[head.BodyID] = lease
+		}
+		for bodyID := range h.leases {
+			var payload originalBodyPayload
+			if err = bodyInternal(tx).Where("id=?", bodyID).Take(&payload).Error; err != nil {
+				return err
+			}
+			h.payloads[bodyID] = payload
+		}
+		for bodyID := range h.model.hold.Leases {
+			var payload originalBodyPayload
+			if err = bodyInternal(tx).Where("id=?", bodyID).Take(&payload).Error; err != nil {
+				return err
+			}
+			h.payloads[bodyID] = payload
+		}
+		return h.checkInTx(tx, false)
+	}, memoryWriteOptions(h.db))
+	if err != nil {
+		h.cancel()
+		return nil, err
+	}
+	return h, nil
+}
+func (h *KnowledgeSQLiteEmbeddingInputRead) Context() context.Context {
+	return context.WithValue(h.ctx, knowledgeSQLiteEmbeddingKey{}, h)
+}
+func (h *KnowledgeSQLiteEmbeddingInputRead) start() error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if h.failed != nil {
+		return h.failed
+	}
+	if err := h.ctx.Err(); err != nil {
+		return err
+	}
+	h.checks.Add(1)
+	return nil
+}
+func (h *KnowledgeSQLiteEmbeddingInputRead) finish(err error) error {
+	h.mu.Lock()
+	if err == nil {
+		err = h.ctx.Err()
+	}
+	if err != nil && h.failed == nil {
+		h.failed = err
+		h.cancel()
+	}
+	h.mu.Unlock()
+	h.checks.Done()
+	return err
+}
