+		return nil
+	}
+	return &KnowledgeSQLiteEmbeddingStore{db, material, actual}
+}
+func (s *KnowledgeSQLiteEmbeddingStore) CheckSchema() error {
+	return knowledgeSQLiteEmbeddingSchema(s.db)
+}
+
+type KnowledgeSQLiteEmbeddingVectorRead struct {
+	store     *KnowledgeSQLiteEmbeddingStore
+	ctx       context.Context
+	cancel    context.CancelFunc
+	originals map[uint64]types.KnowledgeSQLiteEmbeddingInput
+	receipts  map[uint64]types.KnowledgeSQLiteEmbeddingReceipt
+	body      map[uint64]knowledgeSQLiteEmbeddingInputBody
+	vectors   map[uint64][]float32
+	models    map[string]*historicalModelRead
+	heads     []originalBodyFieldHead
+	rows      []originalBodyAvailabilityRow
+	leases    map[string]originalBodyLease
+	payloads  map[string]originalBodyPayload
+	mu        sync.Mutex
+	closed    bool
+	failed    error
+	checks    sync.WaitGroup
+	joined    chan struct{}
+}
+
+// Only metadata is read before authorization/leases. Bodies are hydrated below
+// from the exact immutable input/output rows under their genuine historical
+// model provider. No old model is constructed and no credential is decrypted.
+func (s *KnowledgeSQLiteEmbeddingStore) BeginVectorRead(ctx context.Context, ids []uint64) (*KnowledgeSQLiteEmbeddingVectorRead, error) {
+	if s == nil || ctx == nil || len(ids) == 0 || len(ids) > 4096 {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	r := &KnowledgeSQLiteEmbeddingVectorRead{store: s, originals: map[uint64]types.KnowledgeSQLiteEmbeddingInput{}, receipts: map[uint64]types.KnowledgeSQLiteEmbeddingReceipt{}, body: map[uint64]knowledgeSQLiteEmbeddingInputBody{}, vectors: map[uint64][]float32{}, models: map[string]*historicalModelRead{}, leases: map[string]originalBodyLease{}, payloads: map[string]originalBodyPayload{}, joined: make(chan struct{})}
+	r.ctx, r.cancel = context.WithCancel(ctx)
+	fail := func(err error) (*KnowledgeSQLiteEmbeddingVectorRead, error) { return nil, errors.Join(err, r.Close()) }
+	for _, id := range ids {
+		if id == 0 {
+			return fail(ErrKnowledgeSQLiteEmbeddingUnknown)
+		}
+		if _, seen := r.receipts[id]; seen {
+			return fail(ErrKnowledgeSQLiteEmbeddingUnknown)
+		}
+		var receipt types.KnowledgeSQLiteEmbeddingReceipt
+		if err := s.db.WithContext(r.ctx).Select("id,tenant_id,knowledge_base_id,knowledge_id,chunk_id,input_id,input_digest,row_id,revision,dimension,vector_sha256,digest,created_at_ms").Where("row_id=?", id).Take(&receipt).Error; err != nil {
+			return fail(err)
+		}
+		var input types.KnowledgeSQLiteEmbeddingInput
+		if err := s.db.WithContext(r.ctx).Select("id,tenant_id,knowledge_base_id,knowledge_id,chunk_id,admission_id,model_id,model_proof_json,space_digest,expected_dimensions,input_sha256,digest,created_at_ms").Where("id=?", receipt.InputID).Take(&input).Error; err != nil {
+			return fail(err)
+		}
+		var proof types.ModelOriginalProof
+		if json.Unmarshal([]byte(input.ModelProofJSON), &proof) != nil || !proof.Valid() || proof.ModelID != input.ModelID {
+			return fail(ErrKnowledgeSQLiteEmbeddingUnknown)
+		}
+		if _, found := r.models[proof.Digest]; !found {
+			model, err := s.models.BeginHistoricalModelOriginalRead(r.ctx, proof)
+			if err != nil {
+				return fail(err)
+			}
+			held, ok := model.(*historicalModelRead)
+			if !ok {
+				_ = model.Close()
+				return fail(ErrKnowledgeSQLiteEmbeddingUnknown)
+			}
+			r.models[proof.Digest] = held
+		}
+		r.originals[id] = input
+		r.receipts[id] = receipt
+	}
+	err := s.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := knowledgeSQLiteEmbeddingSchema(tx); err != nil {
+			return err
+		}
+		authority, err := knowledgeSQLiteEmbeddingAuthority(tx, s.material)
+		if err != nil {
+			return err
+		}
+		fresh, err := authority.RefreshCurrentReadActor(r.ctx)
+		if err != nil {
+			return err
+		}
+		for _, model := range r.models {
+			for _, lease := range model.hold.Hold.Leases {
+				r.leases[lease.LeaseID] = lease
+			}
+		}
+		owner := "knowledge-sqlite-vector-read/" + uuid.NewString()
+		// Rebind and authorize metadata in this transaction. No application body
+		// field is selected until its exact head has a real owned read lease.
+		initial := []originalBodyAvailabilityRow{}
+		for _, id := range ids {
+			expectedInput, expectedReceipt := r.originals[id], r.receipts[id]
+			var input types.KnowledgeSQLiteEmbeddingInput
+			var receipt types.KnowledgeSQLiteEmbeddingReceipt
+			if err = tx.Select("id,tenant_id,knowledge_base_id,knowledge_id,chunk_id,admission_id,model_id,model_proof_json,space_digest,expected_dimensions,input_sha256,digest,created_at_ms").Where("id=?", expectedInput.ID).Take(&input).Error; err != nil {
+				return err
+			}
+			if err = tx.Select("id,tenant_id,knowledge_base_id,knowledge_id,chunk_id,input_id,input_digest,row_id,revision,dimension,vector_sha256,digest,created_at_ms").Where("id=?", expectedReceipt.ID).Take(&receipt).Error; err != nil {
+				return err
+			}
+			if !reflect.DeepEqual(input, expectedInput) || !reflect.DeepEqual(receipt, expectedReceipt) {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if digest, e := knowledgeSQLiteEmbeddingInputDigest(input); e != nil || digest != input.Digest {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if digest, e := knowledgeSQLiteEmbeddingReceiptDigest(receipt); e != nil || digest != receipt.Digest {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if receipt.RowID != id || receipt.InputID != input.ID || receipt.InputDigest != input.Digest || receipt.TenantID != input.TenantID || receipt.KnowledgeBaseID != input.KnowledgeBaseID || receipt.KnowledgeID != input.KnowledgeID || receipt.ChunkID != input.ChunkID || receipt.Dimension != input.ExpectedDimensions {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			var kb types.KnowledgeBase
+			if err = tx.Where("id=? AND tenant_id=?", input.KnowledgeBaseID, input.TenantID).Take(&kb).Error; err != nil {
+				return err
+			}
+			if err = r.authorizeKB(authority, fresh, &kb); err != nil {
+				return err
+			}
+			if err = r.checkSourceBodyRoutingInTx(tx, input, []string{input.ChunkID}); err != nil {
+				return err
+			}
+			initial = append(initial, originalBodyAvailabilityRow{input.TableName(), input.ID}, originalBodyAvailabilityRow{receipt.TableName(), receipt.ID}, originalBodyAvailabilityRow{"knowledges", input.KnowledgeID}, originalBodyAvailabilityRow{"chunks", input.ChunkID})
+		}
+		for _, model := range r.models {
+			initial = append(initial, originalBodyAvailabilityRow{"model_definition_originals", model.hold.Hold.Proof.DefinitionID}, originalBodyAvailabilityRow{"model_credential_originals", model.hold.Hold.Proof.CredentialID})
+		}
+		if err = r.claimBodyRowsInTx(tx, initial, owner); err != nil {
+			return err
+		}
+		for _, id := range ids {
+			input := r.originals[id]
+			receipt := r.receipts[id]
+			var kb types.KnowledgeBase
+			if err = tx.Where("id=? AND tenant_id=?", input.KnowledgeBaseID, input.TenantID).Take(&kb).Error; err != nil {
+				return err
+			}
+			if err = r.authorizeKB(authority, fresh, &kb); err != nil {
+				return err
+			}
+			if err = tx.Where("id=?", input.ID).Take(&input).Error; err != nil {
+				return err
+			}
+			if err = tx.Where("id=?", receipt.ID).Take(&receipt).Error; err != nil {
+				return err
+			}
+			inputMetadata, receiptMetadata := input, receipt
+			inputMetadata.InputJSON = ""
+			receiptMetadata.VectorJSON = ""
+			if !reflect.DeepEqual(inputMetadata, r.originals[id]) || !reflect.DeepEqual(receiptMetadata, r.receipts[id]) {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if digest, e := knowledgeSQLiteEmbeddingInputDigest(input); e != nil || digest != input.Digest || input.InputSHA256 != bodySHA([]byte(input.InputJSON)) {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if digest, e := knowledgeSQLiteEmbeddingReceiptDigest(receipt); e != nil || digest != receipt.Digest {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			var body knowledgeSQLiteEmbeddingInputBody
+			if json.Unmarshal([]byte(input.InputJSON), &body) != nil || body.Proof.SourceLineage == nil || body.Proof.SourceLineage.RequireComplete() != nil || len(body.Proof.SourceLineage.Sources) != 0 {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if body.Proof.AdmissionID != input.AdmissionID || body.Info.ChunkID != input.ChunkID || body.Info.KnowledgeID != input.KnowledgeID || body.Info.KnowledgeBaseID != input.KnowledgeBaseID || body.Info.SourceID != input.ChunkID || body.Info.SourceType != types.ChunkSourceType || modelembedding.OriginalIndexText(body.Info.Content) != body.WireText {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			var vector []float32
+			if json.Unmarshal([]byte(receipt.VectorJSON), &vector) != nil {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			if receipt.InputID != input.ID || receipt.InputDigest != input.Digest || receipt.TenantID != input.TenantID || receipt.KnowledgeBaseID != input.KnowledgeBaseID || receipt.KnowledgeID != input.KnowledgeID || receipt.ChunkID != input.ChunkID || receipt.Dimension != input.ExpectedDimensions {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			data, e := knowledgeSQLiteVectorBytes(vector)
+			if e != nil || len(vector) != receipt.Dimension || bodySHA(data) != receipt.VectorSHA256 {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			r.originals[id] = input
+			r.receipts[id] = receipt
+			r.body[id] = body
+			r.vectors[id] = vector
+			r.rows = append(r.rows, originalBodyAvailabilityRow{input.TableName(), input.ID}, originalBodyAvailabilityRow{receipt.TableName(), receipt.ID}, originalBodyAvailabilityRow{"knowledges", input.KnowledgeID})
+			for _, chunk := range body.Proof.ChunkIDs {
+				r.rows = append(r.rows, originalBodyAvailabilityRow{"chunks", chunk})
+			}
+		}
+		// The now-held input JSON supplies the remaining exact influence set.
+		// Claim every additional source body before its snapshot can hydrate it.
+		for _, id := range ids {
+			if err = r.checkSourceBodyRoutingInTx(tx, r.originals[id], r.body[id].Proof.ChunkIDs); err != nil {
+				return err
+			}
+		}
+		if err = r.claimBodyRowsInTx(tx, r.rows, owner); err != nil {
+			return err
+		}
+		return r.checkInTx(tx)
+	}, memoryWriteOptions(s.db))
+	if err != nil {
+		return fail(err)
+	}
+	return r, nil
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) checkSourceBodyRoutingInTx(tx *gorm.DB, input types.KnowledgeSQLiteEmbeddingInput, chunkIDs []string) error {
+	var knowledge struct {
+		ID              string
+		TenantID        uint64
+		KnowledgeBaseID string
+	}
+	if err := tx.Table("knowledges").Select("id,tenant_id,knowledge_base_id").Where("id=? AND tenant_id=? AND knowledge_base_id=?", input.KnowledgeID, input.TenantID, input.KnowledgeBaseID).Take(&knowledge).Error; err != nil {
+		return err
+	}
+	for _, id := range chunkIDs {
+		var chunk struct {
+			ID                           string
+			TenantID                     uint64
+			KnowledgeBaseID, KnowledgeID string
+		}
+		if id == "" {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := tx.Table("chunks").Select("id,tenant_id,knowledge_base_id,knowledge_id").Where("id=? AND tenant_id=? AND knowledge_base_id=? AND knowledge_id=?", id, input.TenantID, input.KnowledgeBaseID, input.KnowledgeID).Take(&chunk).Error; err != nil {
+			return err
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) claimBodyRowsInTx(tx *gorm.DB, rows []originalBodyAvailabilityRow, owner string) error {
+	rows = knowledgeSQLiteUniqueBodyRows(rows)
+	if err := checkOriginalBodyAvailableBatchInTx(r.ctx, tx, rows); err != nil {
+		return err
+	}
+	heads, err := originalBodyBatchHeads(tx, rows)
+	if err != nil {
+		return err
+	}
+	byRow := map[originalBodyAvailabilityRow][]originalBodyFieldHead{}
+	for _, head := range heads {
+		key := originalBodyAvailabilityRow{head.SourceTable, head.RowKey}
+		byRow[key] = append(byRow[key], head)
+	}
+	for _, input := range r.originals {
+		row := originalBodyAvailabilityRow{input.TableName(), input.ID}
+		list, needed := byRow[row]
+		if needed {
+			scope := originalBodyScope{Tenant: input.TenantID, KB: input.KnowledgeBaseID, Knowledge: input.KnowledgeID, OwnerKind: input.TableName(), OwnerID: input.ID, AdmissionID: input.AdmissionID}
+			if len(list) != 1 || list[0].ColumnName != "input_json" || list[0].SourceIdentitySHA256 != bodyIdentity(input.TableName(), input.ID, "input_json", scope) {
+				return ErrOriginalBodyUnavailable
+			}
+			var payload originalBodyPayload
+			if err = bodyInternal(tx).Select("id,body_sha256").Where("id=?", list[0].BodyID).Take(&payload).Error; err != nil {
+				return err
+			}
+			if payload.BodySHA256 != input.InputSHA256 {
+				return ErrOriginalBodyUnavailable
+			}
+		}
+	}
+	for _, receipt := range r.receipts {
+		row := originalBodyAvailabilityRow{receipt.TableName(), receipt.ID}
+		list, needed := byRow[row]
+		if needed {
+			scope := originalBodyScope{Tenant: receipt.TenantID, KB: receipt.KnowledgeBaseID, Knowledge: receipt.KnowledgeID, OwnerKind: receipt.TableName(), OwnerID: receipt.ID}
+			if len(list) != 1 || list[0].ColumnName != "vector_json" || list[0].SourceIdentitySHA256 != bodyIdentity(receipt.TableName(), receipt.ID, "vector_json", scope) {
+				return ErrOriginalBodyUnavailable
+			}
+		}
+	}
+	for _, row := range rows {
+		if (row.Table == "knowledge_sqlite_embedding_inputs" || row.Table == "knowledge_sqlite_embedding_receipts") && len(byRow[row]) != 1 {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	acquired := map[string]bool{}
+	for _, lease := range r.leases {
+		acquired[lease.BodyID] = true
+	}
+	retention := NewOriginalBodyRetentionStore(tx)
+	for _, head := range heads {
+		if acquired[head.BodyID] {
+			continue
+		}
+		id, e := retention.acquireLeaseInTx(tx, head.BodyID, "read", owner, 15*time.Minute)
+		if e != nil {
+			return e
+		}
+		var lease originalBodyLease
+		if e = bodyInternal(tx).Where("lease_id=?", id).Take(&lease).Error; e != nil {
+			return e
+		}
+		r.leases[lease.LeaseID] = lease
+		acquired[head.BodyID] = true
+	}
+	for _, lease := range r.leases {
+		if _, seen := r.payloads[lease.BodyID]; seen {
+			continue
+		}
+		var payload originalBodyPayload
+		if err = bodyInternal(tx).Where("id=?", lease.BodyID).Take(&payload).Error; err != nil {
+			return err
+		}
+		r.payloads[lease.BodyID] = payload
+	}
+	existing := map[string]originalBodyFieldHead{}
+	for _, head := range r.heads {
+		existing[head.SlotID] = head
+	}
+	for _, head := range heads {
+		if previous, ok := existing[head.SlotID]; ok {
+			if previous != head {
+				return ErrOriginalBodyUnavailable
+			}
+		} else {
+			r.heads = append(r.heads, head)
+			existing[head.SlotID] = head
+		}
+	}
+	r.rows = knowledgeSQLiteUniqueBodyRows(append(r.rows, rows...))
+	return tx.Statement.Context.Err()
+}
+func knowledgeSQLiteUniqueBodyRows(rows []originalBodyAvailabilityRow) []originalBodyAvailabilityRow {
+	seen := map[originalBodyAvailabilityRow]bool{}
+	out := []originalBodyAvailabilityRow{}
+	for _, row := range rows {
+		if !seen[row] {
+			seen[row] = true
+			out = append(out, row)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Table == out[j].Table {
+			return out[i].ID < out[j].ID
+		}
+		return out[i].Table < out[j].Table
+	})
+	return out
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) authorizeKB(s *KnowledgeInputProvenanceStore, ctx context.Context, kb *types.KnowledgeBase) error {
+	if s.actorGroups == nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if _, err := access.ResolveKB(ctx, access.KBRequest{Caller: types.CallerFromContext(ctx)}, kb, types.OrgRoleViewer, s.actorShares, s.messageActorAgents); err != nil {
+		return err
+	}
+	permission, err := s.actorGroups.EffectivePermission(ctx, kb.TenantID, types.GroupResourceTypeKnowledgeBase, kb.ID, types.ResourceActionRead, time.Now().UTC())
+	if err != nil {
+		return err
+	}
+	if !permission.Allowed {
+		return access.ErrForbidden
+	}
+	return ctx.Err()
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) checkInTx(tx *gorm.DB) error {
+	if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := knowledgeSQLiteEmbeddingSchema(tx); err != nil {
+		return err
+	}
+	pool, e := tx.DB()
+	if e != nil {
+		return e
+	}
+	actual, e := r.store.db.DB()
+	if e != nil || actual != pool || !sameOriginalModelCallerInRepository(tx.Statement.Context, r.ctx) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	authority, e := knowledgeSQLiteEmbeddingAuthority(tx, r.store.material)
+	if e != nil {
+		return e
+	}
+	fresh, e := authority.RefreshCurrentReadActor(r.ctx)
+	if e != nil {
+		return e
+	}
+	controls := map[string]modelOriginalControl{}
+	for id, input := range r.originals {
+		var actualInput types.KnowledgeSQLiteEmbeddingInput
+		var receipt types.KnowledgeSQLiteEmbeddingReceipt
+		if e = tx.Where("id=?", input.ID).Take(&actualInput).Error; e != nil {
+			return e
+		}
+		if e = tx.Where("id=?", r.receipts[id].ID).Take(&receipt).Error; e != nil {
+			return e
+		}
+		if !reflect.DeepEqual(input, actualInput) || !reflect.DeepEqual(receipt, r.receipts[id]) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		body := r.body[id]
+		snap, e := authority.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: input.TenantID, KnowledgeBaseID: input.KnowledgeBaseID, KnowledgeID: input.KnowledgeID, ChunkIDs: body.Proof.ChunkIDs, Expected: &body.Proof}, true)
+		if e != nil {
+			return e
+		}
+		if e = r.authorizeKB(authority, fresh, snap.KnowledgeBase); e != nil {
+			return e
+		}
+		var proof types.ModelOriginalProof
+		if json.Unmarshal([]byte(input.ModelProofJSON), &proof) != nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		model := r.models[proof.Digest]
+		if model == nil || model.ctx.Err() != nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if e = CheckHistoricalModelOriginalHolds(model.ctx, tx.Session(&gorm.Session{NewDB: true}).WithContext(model.ctx), proof); e != nil {
+			return e
+		}
+		current, e := modelControls(tx, proof.ModelID)
+		if e != nil {
+			return e
+		}
+		controls[proof.ModelID] = current
+		facts, e := loadHistoricalModelFacts(tx.Session(&gorm.Session{NewDB: true}).WithContext(model.ctx), proof)
+		if e != nil {
+			return e
+		}
+		var definition types.ModelOriginalDefinition
+		if json.Unmarshal([]byte(facts.Definition.DefinitionJSON), &definition) != nil || definition.Type != types.ModelTypeEmbedding || definition.Parameters.OriginalEmbedding == nil {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		recipe := definition.Parameters.OriginalEmbedding
+		if modelembedding.ValidateOriginalEmbeddingDefinition(recipe) != nil || recipe.SpaceDigest != input.SpaceDigest || recipe.ExpectedDimensions != input.ExpectedDimensions {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		var control knowledgeSQLiteEmbeddingControl
+		var canonical knowledgeSQLiteEmbeddingVectorRow
+		if e = tx.Where("row_id=?", id).Take(&control).Error; e != nil {
+			return e
+		}
+		if e = tx.Where("row_id=?", id).Take(&canonical).Error; e != nil {
+			return e
+		}
+		bytes, e := knowledgeSQLiteVectorBytes(r.vectors[id])
+		if e != nil {
+			return e
+		}
+		if !control.Present || control.Revision != receipt.Revision || canonical.Dimension != receipt.Dimension || !reflect.DeepEqual(canonical.Vector, bytes) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		var row struct {
+			SourceID                                              string
+			SourceType                                            int
+			ChunkID, KnowledgeID, KnowledgeBaseID, TagID, Content string
+			Dimension                                             int
+			IsEnabled                                             *bool
+		}
+		if e = tx.Table("lite_embeddings").Where("id=?", id).Take(&row).Error; e != nil {
+			return e
+		}
+		info := body.Info
+		if row.SourceID != info.SourceID || row.SourceType != int(info.SourceType) || row.ChunkID != info.ChunkID || row.KnowledgeID != info.KnowledgeID || row.KnowledgeBaseID != info.KnowledgeBaseID || row.TagID != info.TagID || row.Content != info.Content || row.Dimension != input.ExpectedDimensions || row.IsEnabled == nil || *row.IsEnabled != info.IsEnabled {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		var native struct{ Embedding []byte }
+		table := fmt.Sprintf("vec_embeddings_%d", input.ExpectedDimensions)
+		if e = tx.Raw("SELECT embedding FROM "+table+" WHERE rowid=?", id).Take(&native).Error; e != nil {
+			return e
+		}
+		if !reflect.DeepEqual(native.Embedding, bytes) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+	}
+	if e = checkOriginalBodyAvailableBatchForCapturedInTx(r.ctx, tx, r.rows, r.heads); e != nil {
+		return e
+	}
+	// Reauthenticate after physical/journal IO, then reload the actual union and
+	// compare its one final SQL clock. Historical contexts never authorize calls.
+	fresh, e = authority.RefreshCurrentReadActor(r.ctx)
+	if e != nil {
+		return e
+	}
+	for _, input := range r.originals {
+		var kb types.KnowledgeBase
+		if e = tx.Where("id=? AND tenant_id=?", input.KnowledgeBaseID, input.TenantID).Take(&kb).Error; e != nil {
+			return e
+		}
+		if e = r.authorizeKB(authority, fresh, &kb); e != nil {
+			return e
+		}
+	}
+	return r.finalClockInTx(tx, controls)
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) finalClockInTx(tx *gorm.DB, controls map[string]modelOriginalControl) error {
+	for id, want := range controls {
+		actual, err := modelControls(tx, id)
+		if err != nil {
+			return err
+		}
+		if actual != want {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+	}
+	for id, receipt := range r.receipts {
+		if err := checkKnowledgeSQLiteVectorCurrentInTx(tx, id, receipt.Revision, receipt.Dimension, r.body[id].Info, r.vectors[id]); err != nil {
+			return err
+		}
+	}
+	keys := []string{}
+	expected := map[string]originalBodyLease{}
+	for _, l := range r.leases {
+		keys = append(keys, l.LeaseID)
+		expected[l.LeaseID] = l
+	}
+	sort.Strings(keys)
+	var leases []originalBodyLease
+	if e := bodyInternal(tx).Where("lease_id IN ?", keys).Order("lease_id").Find(&leases).Error; e != nil {
+		return e
+	}
+	if len(leases) != len(keys) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, l := range leases {
+		want := expected[l.LeaseID]
+		if l.BodyID != want.BodyID || l.OwnerID != want.OwnerID || l.Kind != want.Kind || l.Kind != "read" || l.Epoch != want.Epoch || l.ReleasedAtMS != nil {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	heads, e := originalBodyBatchHeads(tx, r.rows)
+	if e != nil {
+		return e
+	}
+	if !sameOriginalBodyHeads(r.heads, heads) {
+		return ErrOriginalBodyUnavailable
+	}
+	ids := []string{}
+	for id := range r.payloads {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	var payloads []originalBodyPayload
+	if e = bodyInternal(tx).Where("id IN ?", ids).Order("id").Find(&payloads).Error; e != nil {
+		return e
+	}
+	if len(payloads) != len(ids) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, b := range payloads {
+		want := r.payloads[b.ID]
+		if b.State != "live" || !reflect.DeepEqual(want, b) {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	if e = knowledgeSQLiteFinalLeaseClockInTx(tx, expected); e != nil {
+		return e
+	}
+	for _, m := range r.models {
+		if e = m.ctx.Err(); e != nil {
+			return e
+		}
+	}
+	return r.ctx.Err()
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) start() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if r.failed != nil {
+		return r.failed
+	}
+	if e := r.ctx.Err(); e != nil {
+		return e
+	}
+	r.checks.Add(1)
+	return nil
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) finish(e error) error {
+	r.mu.Lock()
+	if e == nil {
+		e = r.ctx.Err()
+	}
+	if e != nil && r.failed == nil {
+		r.failed = e
+		r.cancel()
+	}
+	r.mu.Unlock()
+	r.checks.Done()
+	return e
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) Context() context.Context { return r.ctx }
+func (r *KnowledgeSQLiteEmbeddingVectorRead) Recheck() error {
+	if e := r.start(); e != nil {
+		return e
+	}
+	e := r.store.db.WithContext(r.ctx).Transaction(r.checkInTx, memoryWriteOptions(r.store.db))
+	return r.finish(e)
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) Snapshot() ([]types.KnowledgeSQLiteEmbeddingVector, error) {
+	if e := r.start(); e != nil {
+		return nil, e
+	}
+	out := []types.KnowledgeSQLiteEmbeddingVector{}
+	e := r.store.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		if e := r.checkInTx(tx); e != nil {
+			return e
+		}
+		ids := []uint64{}
+		for id := range r.originals {
+			ids = append(ids, id)
+		}
+		sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+		for _, id := range ids {
+			out = append(out, types.KnowledgeSQLiteEmbeddingVector{RowID: id, Info: r.body[id].Info, Vector: append([]float32(nil), r.vectors[id]...), SpaceDigest: r.originals[id].SpaceDigest})
+		}
+		return r.ctx.Err()
+	}, memoryWriteOptions(r.store.db))
+	if e = r.finish(e); e != nil {
+		return nil, e
+	}
+	return out, nil
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) CheckInTx(ctx context.Context, tx *gorm.DB) error {
+	if e := r.start(); e != nil {
+		return e
+	}
+	if !sameOriginalModelCallerInRepository(ctx, r.ctx) {
+		return r.finish(ErrKnowledgeSQLiteEmbeddingUnknown)
+	}
+	return r.finish(r.checkInTx(tx.WithContext(ctx)))
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) Close() error {
+	r.mu.Lock()
+	if r.closed {
+		joined := r.joined
+		r.mu.Unlock()
+		<-joined
+		r.mu.Lock()
+		e := r.failed
+		r.mu.Unlock()
+		return e
+	}
+	r.closed = true
+	r.cancel()
+	r.mu.Unlock()
+	r.checks.Wait()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	var err error
+	modelLeases := map[string]bool{}
+	for _, m := range r.models {
+		for _, l := range m.hold.Hold.Leases {
+			modelLeases[l.LeaseID] = true
+		}
+	}
+	for _, l := range r.leases {
+		if modelLeases[l.LeaseID] {
+			continue
+		}
+		q := bodyInternal(r.store.db.WithContext(cleanup)).Model(&originalBodyLease{}).Where("lease_id=? AND body_id=? AND owner_id=? AND epoch=? AND kind=? AND released_at_ms IS NULL", l.LeaseID, l.BodyID, l.OwnerID, l.Epoch, l.Kind).Update("released_at_ms", time.Now().UnixMilli())
+		err = errors.Join(err, q.Error)
+	}
+	for _, m := range r.models {
+		err = errors.Join(err, m.Close())
+	}
+	r.mu.Lock()
+	if r.failed == nil {
+		r.failed = err
+	}
+	close(r.joined)
+	r.mu.Unlock()
+	return err
+}
+
+// Used by a native rank verifier after real vec0 access, never as a new grant.
+func KnowledgeSQLiteVectorsEqual(a, b []float32) bool {
+	left, e := knowledgeSQLiteVectorBytes(a)
+	right, e2 := knowledgeSQLiteVectorBytes(b)
+	return e == nil && e2 == nil && bytes.Equal(left, right)
+}
diff --git a/internal/application/repository/knowledge_sqlite_embedding_save.go b/internal/application/repository/knowledge_sqlite_embedding_save.go
new file mode 100644
index 0000000000000000000000000000000000000000..e3af97582e8afa73bf3005df6b752b7a0c3b8a2a
--- /dev/null
+++ b/internal/application/repository/knowledge_sqlite_embedding_save.go
@@ -0,0 +1,275 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+type knowledgeSQLiteEmbeddingSaveKey struct{}
+type knowledgeSQLiteEmbeddingSave struct {
+	input    *KnowledgeSQLiteEmbeddingInputRead
+	infos    map[string]types.IndexInfo
+	leases   []originalBodyLease
+	payloads map[string]originalBodyPayload
+	written  map[string]bool
+	rows     []originalBodyAvailabilityRow
+	heads    []originalBodyFieldHead
+}
+
+// Called around the actual SQL transaction, so Close joins the full transaction
+// and committed result-body leases become visible only after a successful commit.
+func BeginKnowledgeSQLiteEmbeddingSave(ctx context.Context, db *gorm.DB, infos []*types.IndexInfo, vectors [][]float32) (context.Context, func(error) error, error) {
+	h, _ := ctx.Value(knowledgeSQLiteEmbeddingKey{}).(*KnowledgeSQLiteEmbeddingInputRead)
+	if h == nil || len(infos) == 0 || len(infos) != len(vectors) || !sameOriginalModelCallerInRepository(ctx, h.ctx) {
+		return ctx, nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	pool, err := db.DB()
+	if err != nil {
+		return ctx, nil, err
+	}
+	actual, err := h.db.DB()
+	if err != nil || pool != actual {
+		return ctx, nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err = h.start(); err != nil {
+		return ctx, nil, err
+	}
+	stage := &knowledgeSQLiteEmbeddingSave{input: h, infos: map[string]types.IndexInfo{}, payloads: map[string]originalBodyPayload{}, written: map[string]bool{}}
+	h.mu.Lock()
+	for i, info := range infos {
+		if info == nil || !reflect.DeepEqual(h.bodies[info.SourceID].Info, *info) || !reflect.DeepEqual(h.outputs[info.SourceID], vectors[i]) {
+			err = ErrKnowledgeSQLiteEmbeddingUnknown
+			break
+		}
+		if _, seen := stage.infos[info.SourceID]; seen {
+			err = ErrKnowledgeSQLiteEmbeddingUnknown
+			break
+		}
+		stage.infos[info.SourceID] = *info
+	}
+	h.mu.Unlock()
+	if err != nil {
+		return ctx, nil, h.finish(err)
+	}
+	finish := func(err error) error {
+		if err == nil {
+			h.mu.Lock()
+			for _, l := range stage.leases {
+				h.committed[l.LeaseID] = l
+			}
+			h.mu.Unlock()
+		}
+		return h.finish(err)
+	}
+	return context.WithValue(ctx, knowledgeSQLiteEmbeddingSaveKey{}, stage), finish, nil
+}
+
+func CheckKnowledgeSQLiteEmbeddingSaveInTx(ctx context.Context, tx *gorm.DB) error {
+	stage, _ := ctx.Value(knowledgeSQLiteEmbeddingSaveKey{}).(*knowledgeSQLiteEmbeddingSave)
+	if stage == nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return stage.input.checkInTx(tx, true)
+}
+
+type knowledgeSQLiteEmbeddingVectorRow struct {
+	RowID     uint64 `gorm:"primaryKey"`
+	Dimension int
+	Vector    []byte
+}
+
+func (knowledgeSQLiteEmbeddingVectorRow) TableName() string {
+	return "knowledge_sqlite_embedding_vectors"
+}
+
+func RecordKnowledgeSQLiteEmbeddingVectorInTx(ctx context.Context, tx *gorm.DB, info *types.IndexInfo, rowID uint64, vector []float32) error {
+	stage, _ := ctx.Value(knowledgeSQLiteEmbeddingSaveKey{}).(*knowledgeSQLiteEmbeddingSave)
+	if stage == nil || info == nil || rowID == 0 || stage.written[info.SourceID] || !reflect.DeepEqual(stage.infos[info.SourceID], *info) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	h := stage.input
+	fact := h.inputs[info.SourceID]
+	expected, err := knowledgeSQLiteVectorBytes(vector)
+	if err != nil {
+		return err
+	}
+	h.mu.Lock()
+	equal := reflect.DeepEqual(h.outputs[info.SourceID], vector)
+	h.mu.Unlock()
+	if !equal || len(vector) != fact.ExpectedDimensions {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err = tx.Create(&knowledgeSQLiteEmbeddingVectorRow{RowID: rowID, Dimension: len(vector), Vector: expected}).Error; err != nil {
+		return err
+	}
+	var control knowledgeSQLiteEmbeddingControl
+	if err = tx.Where("row_id=?", rowID).Take(&control).Error; err != nil {
+		return err
+	}
+	// Fresh metadata insert then the one canonical vector insert. Any unexpected raw
+	// write, including restore-to-old-bytes, advances the control and is refused.
+	if control.Revision != 2 || !control.Present {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	// vec0 remains an actual native search index, not the authoritative receipt.
+	table := fmt.Sprintf("vec_embeddings_%d", len(vector))
+	var raw struct{ Embedding []byte }
+	if err = tx.Raw("SELECT embedding FROM "+table+" WHERE rowid=?", rowID).Take(&raw).Error; err != nil {
+		return err
+	}
+	if !bytes.Equal(expected, raw.Embedding) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	var row struct {
+		SourceID                                              string
+		SourceType                                            int
+		ChunkID, KnowledgeID, KnowledgeBaseID, TagID, Content string
+		Dimension                                             int
+		IsEnabled                                             *bool
+	}
+	if err = tx.Table("lite_embeddings").Where("id=?", rowID).Take(&row).Error; err != nil {
+		return err
+	}
+	if row.SourceID != info.SourceID || row.SourceType != int(info.SourceType) || row.ChunkID != info.ChunkID || row.KnowledgeID != info.KnowledgeID || row.KnowledgeBaseID != info.KnowledgeBaseID || row.TagID != info.TagID || row.Content != info.Content || row.Dimension != len(vector) || row.IsEnabled == nil || *row.IsEnabled != info.IsEnabled {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return err
+	}
+	data, err := json.Marshal(vector)
+	if err != nil {
+		return err
+	}
+	receipt := types.KnowledgeSQLiteEmbeddingReceipt{ID: uuid.NewString(), TenantID: fact.TenantID, KnowledgeBaseID: fact.KnowledgeBaseID, KnowledgeID: fact.KnowledgeID, ChunkID: fact.ChunkID, InputID: fact.ID, InputDigest: fact.Digest, RowID: rowID, Revision: control.Revision, Dimension: len(vector), VectorJSON: string(data), VectorSHA256: bodySHA(expected), CreatedAtMS: now}
+	receipt.Digest, err = knowledgeSQLiteEmbeddingReceiptDigest(receipt)
+	if err != nil {
+		return err
+	}
+	if err = tx.Create(&receipt).Error; err != nil {
+		return err
+	}
+	if err = CheckOriginalBodyAvailableInTx(ctx, tx, receipt.TableName(), receipt.ID); err != nil {
+		return err
+	}
+	heads, err := originalBodyBatchHeads(tx, []originalBodyAvailabilityRow{{receipt.TableName(), receipt.ID}})
+	if err != nil {
+		return err
+	}
+	if len(heads) != 1 {
+		return ErrOriginalBodyUnavailable
+	}
+	stage.rows = append(stage.rows, originalBodyAvailabilityRow{receipt.TableName(), receipt.ID})
+	stage.heads = append(stage.heads, heads...)
+	leaseID, err := NewOriginalBodyRetentionStore(tx).acquireLeaseInTx(tx, heads[0].BodyID, "read", "knowledge-sqlite-result/"+receipt.ID, 15*time.Minute)
+	if err != nil {
+		return err
+	}
+	var lease originalBodyLease
+	if err = bodyInternal(tx).Where("lease_id=?", leaseID).Take(&lease).Error; err != nil {
+		return err
+	}
+	var payload originalBodyPayload
+	if err = bodyInternal(tx).Where("id=?", heads[0].BodyID).Take(&payload).Error; err != nil {
+		return err
+	}
+	stage.leases = append(stage.leases, lease)
+	stage.payloads[payload.ID] = payload
+	stage.written[info.SourceID] = true
+	return nil
+}
+
+func CheckKnowledgeSQLiteEmbeddingSavedFinalInTx(ctx context.Context, tx *gorm.DB) error {
+	stage, _ := ctx.Value(knowledgeSQLiteEmbeddingSaveKey{}).(*knowledgeSQLiteEmbeddingSave)
+	if stage == nil || len(stage.written) != len(stage.infos) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := CheckKnowledgeSQLiteEmbeddingSaveInTx(ctx, tx); err != nil {
+		return err
+	}
+	for id, info := range stage.infos {
+		var receipt types.KnowledgeSQLiteEmbeddingReceipt
+		if err := tx.Where("input_id=?", stage.input.inputs[id].ID).Take(&receipt).Error; err != nil {
+			return err
+		}
+		var control knowledgeSQLiteEmbeddingControl
+		if err := tx.Where("row_id=?", receipt.RowID).Take(&control).Error; err != nil {
+			return err
+		}
+		if !control.Present || control.Revision != receipt.Revision {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		var canonical knowledgeSQLiteEmbeddingVectorRow
+		if err := tx.Where("row_id=?", receipt.RowID).Take(&canonical).Error; err != nil {
+			return err
+		}
+		if bodySHA(canonical.Vector) != receipt.VectorSHA256 || canonical.Dimension != receipt.Dimension || info.SourceID != stage.input.bodies[id].Info.SourceID {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		var cache struct{ Embedding []byte }
+		table := fmt.Sprintf("vec_embeddings_%d", receipt.Dimension)
+		if err := tx.Raw("SELECT embedding FROM "+table+" WHERE rowid=?", receipt.RowID).Take(&cache).Error; err != nil {
+			return err
+		}
+		if !bytes.Equal(cache.Embedding, canonical.Vector) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := CheckOriginalBodyAvailableInTx(ctx, tx, receipt.TableName(), receipt.ID); err != nil {
+			return err
+		}
+	}
+	// finalClockInTx reloads the same actual lease/body bindings after all source,
+	// model, journal and result-body IO. No entity/body IO follows this clock.
+	return stage.input.finalClockInTx(tx, stage.leases)
+}
+
+func checkKnowledgeSQLiteVectorCurrentInTx(tx *gorm.DB, id uint64, revision int64, dimension int, info types.IndexInfo, vector []float32) error {
+	var control knowledgeSQLiteEmbeddingControl
+	var canonical knowledgeSQLiteEmbeddingVectorRow
+	if err := tx.Where("row_id=?", id).Take(&control).Error; err != nil {
+		return err
+	}
+	if err := tx.Where("row_id=?", id).Take(&canonical).Error; err != nil {
+		return err
+	}
+	expected, err := knowledgeSQLiteVectorBytes(vector)
+	if err != nil {
+		return err
+	}
+	if !control.Present || control.Revision != revision || canonical.Dimension != dimension || !bytes.Equal(canonical.Vector, expected) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	var row struct {
+		SourceID                                              string
+		SourceType                                            int
+		ChunkID, KnowledgeID, KnowledgeBaseID, TagID, Content string
+		Dimension                                             int
+		IsEnabled                                             *bool
+	}
+	if err = tx.Table("lite_embeddings").Where("id=?", id).Take(&row).Error; err != nil {
+		return err
+	}
+	if row.SourceID != info.SourceID || row.SourceType != int(info.SourceType) || row.ChunkID != info.ChunkID || row.KnowledgeID != info.KnowledgeID || row.KnowledgeBaseID != info.KnowledgeBaseID || row.TagID != info.TagID || row.Content != info.Content || row.Dimension != dimension || row.IsEnabled == nil || *row.IsEnabled != info.IsEnabled {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	var native struct{ Embedding []byte }
+	table := fmt.Sprintf("vec_embeddings_%d", dimension)
+	if err = tx.Raw("SELECT embedding FROM "+table+" WHERE rowid=?", id).Take(&native).Error; err != nil {
+		return err
+	}
+	if !bytes.Equal(native.Embedding, expected) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return tx.Statement.Context.Err()
+}
diff --git a/internal/application/repository/knowledge_sqlite_embedding_schema.go b/internal/application/repository/knowledge_sqlite_embedding_schema.go
new file mode 100644
index 0000000000000000000000000000000000000000..bbfc18cbe3cbd71bd56a52ffd538844c2b88b023
--- /dev/null
+++ b/internal/application/repository/knowledge_sqlite_embedding_schema.go
@@ -0,0 +1,49 @@
+package repository
+
+import (
+	"gorm.io/gorm"
+	"strings"
+)
+
+// Ordinary table mutation guards are exact known statements. vec0 is a virtual
+// table and cannot supply these triggers; its bytes/hits are checked separately.
+var knowledgeSQLiteMutationGuards = []string{
+	`CREATE TRIGGER knowledge_lite_embedding_insert AFTER INSERT ON lite_embeddings BEGIN
+ INSERT INTO knowledge_sqlite_embedding_controls(row_id,revision,present) VALUES(NEW.id,1,0);
+END;`,
+	`CREATE TRIGGER knowledge_lite_embedding_update AFTER UPDATE ON lite_embeddings BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1 WHERE row_id=NEW.id;
+END;`,
+	`CREATE TRIGGER knowledge_lite_embedding_delete AFTER DELETE ON lite_embeddings BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1,present=0 WHERE row_id=OLD.id;
+END;`,
+	`CREATE TRIGGER knowledge_sqlite_vector_insert AFTER INSERT ON knowledge_sqlite_embedding_vectors BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1,present=1 WHERE row_id=NEW.row_id;
+END;`,
+	`CREATE TRIGGER knowledge_sqlite_vector_update AFTER UPDATE ON knowledge_sqlite_embedding_vectors BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1 WHERE row_id=NEW.row_id;
+END;`,
+	`CREATE TRIGGER knowledge_sqlite_vector_delete AFTER DELETE ON knowledge_sqlite_embedding_vectors BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1,present=0 WHERE row_id=OLD.row_id;
+END;`,
+}
+
+func checkKnowledgeSQLiteMutationGuards(tx *gorm.DB) error {
+	for _, expected := range knowledgeSQLiteMutationGuards {
+		parts := strings.Fields(expected)
+		if len(parts) < 3 {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		var row struct{ SQL string }
+		if err := tx.Raw("SELECT sql FROM sqlite_master WHERE type='trigger' AND name=?", parts[2]).Take(&row).Error; err != nil {
+			return err
+		}
+		normalize := func(v string) string {
+			return strings.Join(strings.Fields(strings.TrimSuffix(strings.TrimSpace(v), ";")), " ")
+		}
+		if normalize(row.SQL) != normalize(expected) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+	}
+	return tx.Statement.Context.Err()
+}
