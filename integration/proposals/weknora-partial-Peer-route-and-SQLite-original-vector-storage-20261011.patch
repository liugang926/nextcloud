+func knowledgeSQLiteEmbeddingInputDigest(v types.KnowledgeSQLiteEmbeddingInput) (string, error) {
+	v.Digest = ""
+	v.InputJSON = ""
+	data, err := json.Marshal(v)
+	return bodySHA(data), err
+}
+func knowledgeSQLiteEmbeddingReceiptDigest(v types.KnowledgeSQLiteEmbeddingReceipt) (string, error) {
+	v.Digest = ""
+	v.VectorJSON = ""
+	data, err := json.Marshal(v)
+	return bodySHA(data), err
+}
+func knowledgeSQLiteVectorBytes(v []float32) ([]byte, error) {
+	if len(v) == 0 || len(v) > 65536 {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	data := make([]byte, 4*len(v))
+	for i, n := range v {
+		if math.IsNaN(float64(n)) || math.IsInf(float64(n), 0) {
+			return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		binary.LittleEndian.PutUint32(data[i*4:], math.Float32bits(n))
+	}
+	return data, nil
+}
+func knowledgeSQLiteEmbeddingSchema(tx *gorm.DB) error {
+	if tx.Dialector.Name() != "sqlite" || !originalBodySchemaPresent(tx) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	for _, table := range []string{"knowledge_sqlite_embedding_inputs", "knowledge_sqlite_embedding_receipts", "knowledge_sqlite_embedding_controls", "knowledge_sqlite_embedding_vectors", "lite_embeddings"} {
+		if !tx.Migrator().HasTable(table) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+	}
+	return checkKnowledgeSQLiteMutationGuards(tx)
+}
+func knowledgeSQLiteEmbeddingAuthority(tx *gorm.DB, source *KnowledgeInputProvenanceStore) (*KnowledgeInputProvenanceStore, error) {
+	if source == nil || source.displayAuthorityFactory == nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	actual := source.displayAuthorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if actual == nil || actual.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return actual, nil
+}
