diff --git a/internal/models/embedding/original_index_input.go b/internal/models/embedding/original_index_input.go
new file mode 100644
index 0000000000000000000000000000000000000000..a0b616f1ef498e6dfce9c5d1e49af59817e6d05d
--- /dev/null
+++ b/internal/models/embedding/original_index_input.go
@@ -0,0 +1,39 @@
+package embedding
+
+import (
+	"context"
+	"regexp"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// OriginalIndexOperation binds the input before the SDK call and only exposes
+// outputs actually returned by that operation. It is not a caller proof DTO.
+type OriginalIndexOperation interface {
+	BeginOriginalIndexInputs(context.Context, []*types.IndexInfo, []string) (context.Context, error)
+	BindOriginalIndexOutputs(context.Context, []string, [][]float32) (context.Context, error)
+}
+type OriginalIndexStorage interface{ OriginalKnowledgeEmbeddingStorage() bool }
+
+var originalIndexImagePatterns = []*regexp.Regexp{
+	regexp.MustCompile(`(?is)<img\b[^>]*\bsrc=["']\s*data:image/[a-z0-9.+-]+;base64,[^"']+["'][^>]*>`),
+	regexp.MustCompile(`(?is)!\[[^\]]*\]\(\s*data:image/[a-z0-9.+-]+;base64,[^)]+\)`),
+	regexp.MustCompile(`(?i)data:image/[a-z0-9.+-]+;base64,[a-z0-9+/=]{200,}`),
+	regexp.MustCompile(`(?i)data:[a-z0-9.+/-]+;base64,[a-z0-9+/=]{200,}`),
+}
+
+// OriginalIndexText is the exact existing wire transform. Both the genuine
+// producer and its repository verifier use it; raw chunk text is not the wire.
+func OriginalIndexText(content string) string {
+	if strings.Contains(content, "base64,") {
+		for _, pattern := range originalIndexImagePatterns {
+			content = pattern.ReplaceAllString(content, "[image]")
+		}
+	}
+	if utf8.RuneCountInString(content) > 20000 {
+		content = string([]rune(content)[:20000])
+	}
+	return content
+}
