diff --git a/internal/application/repository/retriever/sqlite/original_vector_retrieve.go b/internal/application/repository/retriever/sqlite/original_vector_retrieve.go
new file mode 100644
index 0000000000000000000000000000000000000000..ec6dcc88081f69e0da4307bad0d58f6170e92c42
--- /dev/null
+++ b/internal/application/repository/retriever/sqlite/original_vector_retrieve.go
@@ -0,0 +1,165 @@
+package sqlite
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"sort"
+
+	apprepo "github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	sqlite_vec "github.com/asg017/sqlite-vec-go-bindings/cgo"
+	"gorm.io/gorm"
+)
+
+// vec0 remains the native index. The canonical vectors provide an integrity
+// reference for bytes, candidate completeness and scores, not a replacement
+// indexed backend or a performance/SLO claim.
+func (r *sqliteRepository) originalVectorRetrieve(ctx context.Context, params types.RetrieveParams) (result []*types.RetrieveResult, resultErr error) {
+	if r.initErr != nil {
+		return nil, r.initErr
+	}
+	if len(params.Embedding) == 0 {
+		return nil, nil
+	}
+	space, ok := params.AdditionalParams["embedding_space_digest"].(string)
+	// This is a space selection, not a caller authority token. Every original,
+	// current permission and held historical model is checked independently.
+	if !ok || len(space) != 64 || params.TopK <= 0 || params.TopK > 4096 || len(params.KnowledgeBaseIDs) == 0 {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	queryBlob, err := sqlite_vec.SerializeFloat32(params.Embedding)
+	if err != nil {
+		return nil, err
+	}
+	where := "(e.is_enabled IS NULL OR e.is_enabled=1) AND e.dimension=?"
+	args := []interface{}{len(params.Embedding)}
+	for _, filter := range buildFilterWhere(params, "e") {
+		where += " AND " + filter.clause
+		args = append(args, filter.args...)
+	}
+	var ids []uint64
+	if err = r.db.WithContext(ctx).Table("lite_embeddings AS e").Select("e.id").Where(where, args...).Order("e.id").Limit(4097).Scan(&ids).Error; err != nil {
+		return nil, err
+	}
+	if len(ids) == 0 {
+		return nil, nil
+	}
+	if len(ids) > 4096 {
+		return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	held, err := r.originals.BeginVectorRead(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		resultErr = errors.Join(resultErr, held.Close())
+		if resultErr != nil {
+			result = nil
+		}
+	}()
+	vectors, err := held.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	references := map[uint64]types.KnowledgeSQLiteEmbeddingVector{}
+	distances := map[uint64]float64{}
+	ordered := []float64{}
+	for _, v := range vectors {
+		if v.SpaceDigest != space {
+			return nil, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		distance, e := originalCosineDistance(params.Embedding, v.Vector)
+		if e != nil {
+			return nil, e
+		}
+		references[v.RowID] = v
+		distances[v.RowID] = distance
+		ordered = append(ordered, distance)
+	}
+	sort.Float64s(ordered)
+	expected := params.TopK
+	if expected > len(ids) {
+		expected = len(ids)
+	}
+	cutoff := ordered[expected-1]
+	type nativeRow struct {
+		Rowid    uint64
+		Distance float64
+	}
+	var native []nativeRow
+	err = r.db.WithContext(held.Context()).Transaction(func(tx *gorm.DB) error {
+		var currentIDs []uint64
+		if e := tx.Table("lite_embeddings AS e").Select("e.id").Where(where, args...).Order("e.id").Limit(4097).Scan(&currentIDs).Error; e != nil {
+			return e
+		}
+		if len(currentIDs) != len(ids) {
+			return apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		for i, id := range ids {
+			if currentIDs[i] != id {
+				return apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+		}
+		table := vecTableName(len(params.Embedding))
+		sql := fmt.Sprintf("SELECT v.rowid,v.distance FROM %s v WHERE v.embedding MATCH ? AND k=? AND v.rowid IN (SELECT e.id FROM lite_embeddings e WHERE %s) ORDER BY v.distance ASC", table, where)
+		nativeArgs := []interface{}{queryBlob, params.TopK}
+		nativeArgs = append(nativeArgs, args...)
+		if e := tx.Raw(sql, nativeArgs...).Scan(&native).Error; e != nil {
+			return e
+		}
+		if len(native) != expected {
+			return apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		seen := map[uint64]bool{}
+		const tolerance = 0.0001
+		for _, n := range native {
+			reference, exists := distances[n.Rowid]
+			if !exists || seen[n.Rowid] || math.IsNaN(n.Distance) || math.IsInf(n.Distance, 0) || math.Abs(reference-n.Distance) > tolerance || reference > cutoff+tolerance {
+				return apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+			seen[n.Rowid] = true
+		}
+		for id, distance := range distances {
+			if distance < cutoff-tolerance && !seen[id] {
+				return apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+		}
+		// All native/cache IO precedes the complete source/body/model final check.
+		return held.CheckInTx(held.Context(), tx)
+	})
+	if err != nil {
+		return nil, err
+	}
+	items := []*types.IndexWithScore{}
+	for _, n := range native {
+		v := references[n.Rowid]
+		score := 1 - n.Distance
+		if params.Threshold > 0 && score < params.Threshold {
+			continue
+		}
+		info := v.Info
+		items = append(items, &types.IndexWithScore{ID: fmt.Sprintf("%d", v.RowID), SourceID: info.SourceID, SourceType: info.SourceType, ChunkID: info.ChunkID, KnowledgeID: info.KnowledgeID, KnowledgeBaseID: info.KnowledgeBaseID, TagID: info.TagID, Content: info.Content, Score: score, MatchType: types.MatchTypeEmbedding, IsEnabled: info.IsEnabled})
+	}
+	return []*types.RetrieveResult{{Results: items, RetrieverEngineType: types.SQLiteRetrieverEngineType, RetrieverType: types.VectorRetrieverType}}, nil
+}
+func originalCosineDistance(a, b []float32) (float64, error) {
+	if len(a) == 0 || len(a) != len(b) {
+		return 0, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	var dot, aa, bb float64
+	for i, n := range a {
+		m := b[i]
+		if math.IsNaN(float64(n)) || math.IsInf(float64(n), 0) || math.IsNaN(float64(m)) || math.IsInf(float64(m), 0) {
+			return 0, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		dot += float64(n) * float64(m)
+		aa += float64(n) * float64(n)
+		bb += float64(m) * float64(m)
+	}
+	if aa == 0 || bb == 0 {
+		return 0, apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return 1 - dot/math.Sqrt(aa*bb), nil
+}
