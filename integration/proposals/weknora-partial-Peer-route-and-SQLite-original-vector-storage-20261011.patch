+// One last actual SQL statement reloads every captured tuple and its expiry
+// together with the database clock, after all entity/body/native-index IO.
+func knowledgeSQLiteFinalLeaseClockInTx(tx *gorm.DB, expected map[string]originalBodyLease) error {
+	keys := []string{}
+	for id := range expected {
+		keys = append(keys, id)
+	}
+	sort.Strings(keys)
+	if len(keys) == 0 {
+		return ErrOriginalBodyUnavailable
+	}
+	type finalRow struct {
+		LeaseID, BodyID, Kind, OwnerID   string
+		Epoch, ExpiresAtMS, FinalClockMS int64
+		ReleasedAtMS                     *int64
+	}
+	var rows []finalRow
+	if err := bodyInternal(tx).Table("original_body_leases").Select("lease_id,body_id,kind,owner_id,epoch,expires_at_ms,released_at_ms,CAST((julianday('now')-2440587.5)*86400000 AS INTEGER) AS final_clock_ms").Where("lease_id IN ?", keys).Order("lease_id").Find(&rows).Error; err != nil {
+		return err
+	}
+	if len(rows) != len(keys) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, row := range rows {
+		want, ok := expected[row.LeaseID]
+		if !ok || row.BodyID != want.BodyID || row.OwnerID != want.OwnerID || row.Kind != want.Kind || row.Kind != "read" || row.Epoch != want.Epoch || row.ReleasedAtMS != nil || row.ExpiresAtMS <= row.FinalClockMS {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+func (h *KnowledgeSQLiteEmbeddingInputRead) Close() error {
+	h.mu.Lock()
+	if h.closed {
+		joined := h.joined
+		h.mu.Unlock()
+		<-joined
+		h.mu.Lock()
+		err := h.failed
+		h.mu.Unlock()
+		return err
+	}
+	h.closed = true
+	h.cancel()
+	h.mu.Unlock()
+	h.checks.Wait()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(h.ctx), 5*time.Second)
+	defer cancel()
+	var err error
+	all := map[string]originalBodyLease{}
+	for _, l := range h.leases {
+		all[l.LeaseID] = l
+	}
+	for id, l := range h.committed {
+		all[id] = l
+	}
+	for _, l := range all {
+		result := bodyInternal(h.db.WithContext(cleanup)).Model(&originalBodyLease{}).Where("lease_id=? AND body_id=? AND owner_id=? AND kind=? AND epoch=? AND released_at_ms IS NULL", l.LeaseID, l.BodyID, l.OwnerID, l.Kind, l.Epoch).Update("released_at_ms", time.Now().UnixMilli())
+		err = errors.Join(err, result.Error)
+	}
+	h.mu.Lock()
+	if h.failed == nil {
+		h.failed = err
+	}
+	close(h.joined)
+	h.mu.Unlock()
+	return err
+}
