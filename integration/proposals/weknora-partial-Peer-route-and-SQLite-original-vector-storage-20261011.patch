index 0000000000000000000000000000000000000000..7fb7006e06a7f9c76419b44db9bb3d6830aa198c
--- /dev/null
+++ b/internal/database/migration_peer_partial.go
@@ -0,0 +1,147 @@
+package database
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+type jointPeerPartialCommonWitness struct {
+	Path, SHA256, Table, SourceTable, DDL, Create, Rename string
+	Version, BeforeModuleVersion                          uint
+}
+
+//go:embed migration_peer_partial_common.json
+var jointPeerPartialCommonJSON []byte
+
+func jointPeerPartialCommonWitnessFromSource() (jointPeerPartialCommonWitness, error) {
+	var value jointPeerPartialCommonWitness
+	if json.Unmarshal(jointPeerPartialCommonJSON, &value) != nil || value.Version != 41 || value.BeforeModuleVersion != 75 || value.Table != "nextcloud_gc_items" || value.SourceTable != "nextcloud_gc_items_new" || value.Path != "migrations/peer-forward/sqlite/000041_nextcloud_gc_derived_inventory.up.sql" || fmt.Sprintf("%x", sha256.Sum256([]byte(value.DDL))) != value.SHA256 {
+		return value, ErrJointSchemaSourceIdentity
+	}
+	if !strings.HasPrefix(value.Create, "CREATE TABLE "+value.SourceTable+" (") || strings.Count(value.DDL, value.Create) != 1 || value.Rename != "ALTER TABLE nextcloud_gc_items_new RENAME TO nextcloud_gc_items;" || strings.Count(value.DDL, value.Rename) != 1 {
+		return value, ErrJointSchemaSourceIdentity
+	}
+	return value, nil
+}
+
+func verifyJointPeerPartialCommonProjection(root, dialect string) error {
+	if dialect != "sqlite" {
+		return nil
+	}
+	value, err := jointPeerPartialCommonWitnessFromSource()
+	if err != nil {
+		return err
+	}
+	var manifest jointPeerForwardAssetManifest
+	if json.Unmarshal(jointPeerForwardSourceAssetJSON, &manifest) != nil {
+		return ErrJointSchemaSourceIdentity
+	}
+	matches := 0
+	for _, file := range manifest.Routes[dialect].Files {
+		if file.Version == value.Version && file.Direction == "up" && file.Path == value.Path && file.SHA256 == value.SHA256 {
+			matches++
+		}
+	}
+	actual, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(value.Path)))
+	if matches != 1 || err != nil || string(actual) != value.DDL {
+		return ErrJointSchemaSourceIdentity
+	}
+	return nil
+}
+
+// SQLite75 rebuilds a table which already existed at common41. At partial74
+// it must retain that complete old shape, rather than look like an absent future
+// table or accept the later scoped_sql_graph kind before its real migration.
+func applyJointPeerPartialCommonCatalogue(dialect string, version uint, expected jointCatalogueExpected) error {
+	if dialect != "sqlite" || version != 74 {
+		return nil
+	}
+	value, err := jointPeerPartialCommonWitnessFromSource()
+	if err != nil {
+		return err
+	}
+	expected.Tables[value.Table] = "CREATE TABLE " + value.Table + strings.TrimPrefix(value.Create, "CREATE TABLE "+value.SourceTable)
+	return nil
+}
+
+// These are physical historical module identities, not aliases of Root
+// migrations or permission/body originals. Catalogue qualification remains
+// mandatory before this candidate list can choose a source directory.
+func jointPeerHistoricalPrefixVersion(dialect string, version uint) bool {
+	var blueprint jointPeerPrefixBlueprint
+	if json.Unmarshal(jointPeerPrefixCatalogueJSON, &blueprint) != nil {
+		return false
+	}
+	versions := []uint{155, 156, 157, 158, 159, 160, 161}
+	if dialect == "sqlite" {
+		versions = []uint{74, 75, 76, 77, 78, 79, 80}
+	} else if dialect != "versioned" {
+		return false
+	}
+	modules := blueprint.Modules[dialect]
+	if len(modules) != len(versions)+1 || modules[0].Version != 0 {
+		return false
+	}
+	found := false
+	for i, expected := range versions {
+		if modules[i+1].Version != expected {
+			return false
+		}
+		if version == expected {
+			found = true
+		}
+	}
+	return found
+}
+
+// A partial prefix must lack every later Peer/Root module object, not merely
+// happen to contain one marker table. This complete typed universe includes
+// common125/44, its authentic129/48 evolution and all future bridge objects.
+func verifyJointPeerIntroducedAbsence(ctx context.Context, tx *sql.Tx, dialect string, objects map[string]bool, expected jointCatalogueExpected) error {
+	final := uint(171)
+	if dialect == "sqlite" {
+		final = 89
+	}
+	universe, err := jointExpectedPeerForwardCatalogue(dialect, final)
+	if err != nil {
+		return err
+	}
+	names := map[string]bool{}
+	for _, objects := range []map[string]string{universe.Tables, universe.Triggers, universe.Functions, universe.Indexes} {
+		for name := range objects {
+			names[name] = true
+		}
+	}
+	kinds := map[string]map[string]string{"table": expected.Tables, "trigger": expected.Triggers, "function": expected.Functions, "index": expected.Indexes, "view": nil, "relation": nil}
+	for name := range names {
+		for kind, permitted := range kinds {
+			if objects[kind+"/"+name] {
+				if _, present := permitted[name]; !present {
+					return ErrJointSchemaUnknown
+				}
+			}
+		}
+	}
+	for table, columns := range universe.Columns {
+		for column := range columns {
+			if _, already := expected.Columns[table][column]; already {
+				continue
+			}
+			present, err := peerPrefixIntroducedColumn(ctx, tx, dialect, table, column)
+			if err != nil {
+				return err
+			}
+			if present {
+				return ErrJointSchemaUnknown
+			}
+		}
+	}
+	return ctx.Err()
+}
