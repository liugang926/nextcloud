+// Bind is invoked by the private model operation only after comparing these
+// bytes with its own successful SDK result, not by the storage params decoder.
+func (h *KnowledgeSQLiteEmbeddingInputRead) Bind(texts []string, vectors [][]float32) (context.Context, error) {
+	if err := h.start(); err != nil {
+		return h.ctx, err
+	}
+	var err error
+	h.mu.Lock()
+	if len(texts) != len(h.inputs) || len(vectors) != len(texts) || len(h.outputs) != 0 {
+		err = ErrKnowledgeSQLiteEmbeddingUnknown
+	} else {
+		for i, text := range texts {
+			id := h.order[i]
+			if h.bodies[id].WireText != text || len(vectors[i]) != h.inputs[id].ExpectedDimensions {
+				err = ErrKnowledgeSQLiteEmbeddingUnknown
+				break
+			}
+			if _, e := knowledgeSQLiteVectorBytes(vectors[i]); e != nil {
+				err = e
+				break
+			}
+			h.outputs[id] = append([]float32(nil), vectors[i]...)
+		}
+	}
+	h.mu.Unlock()
+	err = h.finish(err)
+	if err != nil {
+		return h.ctx, err
+	}
+	return h.Context(), nil
+}
+func (h *KnowledgeSQLiteEmbeddingInputRead) checkInTx(tx *gorm.DB, outputs bool) error {
+	if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	pool, err := tx.DB()
+	if err != nil {
+		return err
+	}
+	original, err := h.db.DB()
+	if err != nil || pool != original || !sameOriginalModelCallerInRepository(tx.Statement.Context, h.ctx) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	guard, _ := h.ctx.Value(knowledgeBuildInputKey{}).(knowledgeBuildInputContext)
+	source, _ := guard.reader.(*KnowledgeInputProvenanceStore)
+	authority, err := knowledgeSQLiteEmbeddingAuthority(tx, source)
+	if err != nil {
+		return err
+	}
+	for id, fact := range h.inputs {
+		var actual types.KnowledgeSQLiteEmbeddingInput
+		if err = tx.Where("id=?", fact.ID).Take(&actual).Error; err != nil {
+			return err
+		}
+		if !reflect.DeepEqual(actual, fact) {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		body := h.bodies[id]
+		admission, err := validateKnowledgeInputWrite(h.ctx, tx, fact.TenantID, fact.KnowledgeBaseID, fact.KnowledgeID)
+		if err != nil {
+			return err
+		}
+		if admission == nil || admission.AdmissionID != fact.AdmissionID || admission.OriginKind != "human" {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		snap, err := authority.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: fact.TenantID, KnowledgeBaseID: fact.KnowledgeBaseID, KnowledgeID: fact.KnowledgeID, ChunkIDs: body.Proof.ChunkIDs, Expected: &body.Proof}, true)
+		if err != nil {
+			return err
+		}
+		if _, err = authority.AuthorizeCurrentKnowledgeInputWrite(h.ctx, snap.KnowledgeBase); err != nil {
+			return err
+		}
+		if outputs {
+			h.mu.Lock()
+			vector, ok := h.outputs[id]
+			h.mu.Unlock()
+			if !ok || len(vector) != fact.ExpectedDimensions {
+				return ErrKnowledgeSQLiteEmbeddingUnknown
+			}
+		}
+	}
+	if err = h.model.startCheck(); err != nil {
+		return err
+	}
+	err = h.model.checkInTx(tx.Session(&gorm.Session{NewDB: true}).WithContext(h.model.ctx))
+	if err = h.model.finishCheck(err); err != nil {
+		return err
+	}
+	if err = checkOriginalBodyAvailableBatchForCapturedInTx(h.ctx, tx, h.rows, h.heads); err != nil {
+		return err
+	}
+	return h.finalClockInTx(tx, nil)
+}
+func (h *KnowledgeSQLiteEmbeddingInputRead) finalClockInTx(tx *gorm.DB, extra []originalBodyLease) error {
+	guard, _ := h.ctx.Value(knowledgeBuildInputKey{}).(knowledgeBuildInputContext)
+	source, _ := guard.reader.(*KnowledgeInputProvenanceStore)
+	authority, err := knowledgeSQLiteEmbeddingAuthority(tx, source)
+	if err != nil {
+		return err
+	}
+	for _, fact := range h.inputs {
+		var kb types.KnowledgeBase
+		if err = tx.Where("id=? AND tenant_id=?", fact.KnowledgeBaseID, fact.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		if _, err = authority.AuthorizeCurrentKnowledgeInputWrite(h.ctx, &kb); err != nil {
+			return err
+		}
+	}
+	controls, err := modelControls(tx, h.proof.ModelID)
+	if err != nil {
+		return err
+	}
+	if controls.DefinitionRevision != h.proof.DefinitionRevision || controls.CredentialRevision != h.proof.CredentialRevision || controls.StateEpoch != h.proof.StateEpoch {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	stage, _ := tx.Statement.Context.Value(knowledgeSQLiteEmbeddingSaveKey{}).(*knowledgeSQLiteEmbeddingSave)
+	if len(extra) > 0 && stage != nil {
+		for id, info := range stage.infos {
+			var receipt types.KnowledgeSQLiteEmbeddingReceipt
+			if err = tx.Where("input_id=?", h.inputs[id].ID).Take(&receipt).Error; err != nil {
+				return err
+			}
+			if err = checkKnowledgeSQLiteVectorCurrentInTx(tx, receipt.RowID, receipt.Revision, receipt.Dimension, info, h.outputs[id]); err != nil {
+				return err
+			}
+		}
+	}
+	// All concrete source/model/body checks precede this fresh binding batch.
+	expected := map[string]originalBodyLease{}
+	for _, l := range h.leases {
+		expected[l.LeaseID] = l
+	}
+	for _, l := range h.model.hold.Leases {
+		expected[l.LeaseID] = l
+	}
+	for _, l := range extra {
+		expected[l.LeaseID] = l
+	}
+	keys := []string{}
+	for id := range expected {
+		keys = append(keys, id)
+	}
+	sort.Strings(keys)
+	var leases []originalBodyLease
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id IN ?", keys).Order("lease_id").Find(&leases).Error; err != nil {
+		return err
+	}
+	if len(leases) != len(keys) {
+		return ErrOriginalBodyUnavailable
+	}
+	bodyIDs := []string{}
+	seen := map[string]bool{}
+	for _, l := range leases {
+		want := expected[l.LeaseID]
+		if l.BodyID != want.BodyID || l.OwnerID != want.OwnerID || l.Kind != "read" || l.Kind != want.Kind || l.Epoch != want.Epoch || l.ReleasedAtMS != nil {
+			return ErrOriginalBodyUnavailable
+		}
+		if !seen[l.BodyID] {
+			seen[l.BodyID] = true
+			bodyIDs = append(bodyIDs, l.BodyID)
+		}
+	}
+	sort.Strings(bodyIDs)
+	var bodies []originalBodyPayload
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("id IN ?", bodyIDs).Order("id").Find(&bodies).Error; err != nil {
+		return err
+	}
+	if len(bodies) != len(bodyIDs) {
+		return ErrOriginalBodyUnavailable
+	}
+	actual := map[string]originalBodyPayload{}
+	for _, b := range bodies {
+		actual[b.ID] = b
+	}
+	for _, l := range leases {
+		b := actual[l.BodyID]
+		want, ok := h.payloads[l.BodyID]
+		if !ok && stage != nil {
+			want, ok = stage.payloads[l.BodyID]
+		}
+		if !ok || b.ID != l.BodyID || b.State != "live" || b.PurgeEpoch != l.Epoch || !reflect.DeepEqual(b, want) {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	rows := append([]originalBodyAvailabilityRow(nil), h.rows...)
+	wanted := append([]originalBodyFieldHead(nil), h.heads...)
+	if len(extra) > 0 && stage != nil {
+		rows = append(rows, stage.rows...)
+		wanted = append(wanted, stage.heads...)
+	}
+	heads, err := originalBodyBatchHeads(tx, rows)
+	if err != nil {
+		return err
+	}
+	if !sameOriginalBodyHeads(wanted, heads) {
+		return ErrOriginalBodyUnavailable
+	}
+	if err = knowledgeSQLiteFinalLeaseClockInTx(tx, expected); err != nil {
+		return err
+	}
+	if err = h.model.ctx.Err(); err != nil {
+		return err
+	}
+	return h.ctx.Err()
+}
