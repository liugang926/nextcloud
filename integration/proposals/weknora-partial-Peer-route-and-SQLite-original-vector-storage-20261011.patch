+
+func NewKnowledgeSQLiteEmbeddingStore(db *gorm.DB, material *KnowledgeInputProvenanceStore, models interfaces.ModelRepository) *KnowledgeSQLiteEmbeddingStore {
+	actual, ok := models.(*modelRepository)
