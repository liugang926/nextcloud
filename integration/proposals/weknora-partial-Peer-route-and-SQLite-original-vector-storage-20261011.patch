+-- Protect every fact/control before the first DROP; do not erase UNKNOWN inventory.
+CREATE TEMP TABLE knowledge_sqlite_embedding_down_guard(ok INTEGER);
+CREATE TEMP TRIGGER knowledge_sqlite_embedding_down_refuse BEFORE INSERT ON knowledge_sqlite_embedding_down_guard
+WHEN EXISTS(SELECT 1 FROM knowledge_sqlite_embedding_inputs)
+ OR EXISTS(SELECT 1 FROM knowledge_sqlite_embedding_receipts)
+ OR EXISTS(SELECT 1 FROM knowledge_sqlite_embedding_vectors)
+ OR EXISTS(SELECT 1 FROM knowledge_sqlite_embedding_controls)
+BEGIN SELECT RAISE(ABORT,'knowledge_sqlite_embedding_originals_retained'); END;
+INSERT INTO knowledge_sqlite_embedding_down_guard VALUES(1);
+DROP TRIGGER knowledge_sqlite_embedding_receipt_delete_guard;
+DROP TRIGGER knowledge_sqlite_embedding_receipt_guard;
+DROP TRIGGER knowledge_sqlite_embedding_input_delete_guard;
+DROP TRIGGER knowledge_sqlite_embedding_input_guard;
+DROP TRIGGER knowledge_sqlite_vector_delete;
+DROP TRIGGER knowledge_sqlite_vector_update;
+DROP TRIGGER knowledge_sqlite_vector_insert;
+DROP TRIGGER knowledge_lite_embedding_delete;
+DROP TRIGGER knowledge_lite_embedding_update;
+DROP TRIGGER knowledge_lite_embedding_insert;
+DROP TABLE knowledge_sqlite_embedding_receipts;
+DROP TABLE knowledge_sqlite_embedding_vectors;
+DROP TABLE knowledge_sqlite_embedding_controls;
+DROP TABLE knowledge_sqlite_embedding_inputs;
+DROP TRIGGER knowledge_sqlite_embedding_down_refuse;
+DROP TABLE knowledge_sqlite_embedding_down_guard;
+-- lite_embeddings predates this protocol and is deliberately retained.
diff --git a/migrations/pending/knowledge-sqlite-embedding-originals-000090/000090_knowledge_sqlite_embedding_originals.up.sql b/migrations/pending/knowledge-sqlite-embedding-originals-000090/000090_knowledge_sqlite_embedding_originals.up.sql
