+package repository
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/postgres"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+// Component metadata reader contract only. It creates the exact joint
+// directory-migration schema, with no invented root proof, original material,
+// actor, grant or publication. The source authorization caller is a separate
+// genuine signed HTTP gate; this test never claims this resolver grants reads.
+func rootPathModuleSQLFixture(t *testing.T, pg bool) *gorm.DB {
+	t.Helper()
+	var db *gorm.DB
+	var err error
+	if pg {
+		dsn := os.Getenv("NEXTCLOUD_ONBOARDING_TEST_POSTGRES_DSN")
+		require.NotEmpty(t, dsn, "an exact-owned PostgreSQL DSN is required")
+		db, err = gorm.Open(postgres.New(postgres.Config{DSN: dsn, PreferSimpleProtocol: true}), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	} else {
+		db, err = gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "root-module.sqlite")), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	}
+	require.NoError(t, err)
+	pool, err := db.DB()
+	require.NoError(t, err)
+	pool.SetMaxOpenConns(1)
+	pool.SetMaxIdleConns(1)
+	if pg {
+		schema := "root_path_module_" + uuid.NewString()
+		quoted := `"` + schema + `"`
+		require.NoError(t, db.Exec("CREATE SCHEMA "+quoted).Error)
+		t.Cleanup(func() {
+			if err := db.Exec("DROP SCHEMA " + quoted + " CASCADE").Error; err != nil {
+				t.Error("owned root path module schema cleanup failed")
+			}
+			_ = pool.Close()
+		})
+		require.NoError(t, db.Exec("SET search_path TO "+quoted).Error)
+	} else {
+		t.Cleanup(func() { _ = pool.Close() })
+	}
+	return db
+}
+
+func runRootPathModuleSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"installed_empty", "runtime_drop", "missing_from_start"} {
+		t.Run(mode, func(t *testing.T) {
+			db := rootPathModuleSQLFixture(t, pg)
+			if mode != "missing_from_start" {
+				name := "../../../migrations/sqlite/000083_nextcloud_directory_migrations.up.sql"
+				if pg {
+					name = "../../../migrations/versioned/000164_nextcloud_directory_migrations.up.sql"
+				}
+				ddl, err := os.ReadFile(name)
+				require.NoError(t, err, "the actual unique joint tail must be fused")
+				require.NoError(t, db.Exec(string(ddl)).Error)
+				var count int64
+				require.NoError(t, db.Table("nextcloud_root_migrations").Count(&count).Error)
+				require.Zero(t, count)
+			}
+			// The store remains the same object across a true post-startup DROP.
+			store := NewNextcloudOnboardingStore(db)
+			ctx := context.Background()
+			const oldPath = "documents/original.txt"
+			if mode != "missing_from_start" {
+				path, err := store.ResolveCurrentSourcePath(ctx, 7, "kb", "ds", oldPath)
+				require.NoError(t, err)
+				require.Equal(t, oldPath, path, "an installed empty module preserves a lawful non-onboarding root-relative path")
+			}
+			if mode == "runtime_drop" {
+				require.NoError(t, db.Exec("DROP TABLE nextcloud_root_migrations").Error)
+				var objects int64
+				query := "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='nextcloud_root_migrations'"
+				if pg {
+					query = "SELECT count(*) FROM information_schema.tables WHERE table_schema=current_schema() AND table_name='nextcloud_root_migrations'"
+				}
+				require.NoError(t, db.Raw(query).Scan(&objects).Error)
+				require.Zero(t, objects, "the actual owned DDL fault removed the module table")
+			}
+			path, err := store.ResolveCurrentSourcePath(ctx, 7, "kb", "ds", oldPath)
+			if mode == "installed_empty" {
+				require.NoError(t, err)
+				require.Equal(t, oldPath, path)
+			} else {
+				require.ErrorIs(t, err, ErrNextcloudOnboardingConflict)
+				require.Empty(t, path, fmt.Sprintf("%s cannot recover a missing module from current path bytes", mode))
+			}
+		})
+	}
+}
+
+func TestNextcloudRootPathModuleActualSQLite(t *testing.T)   { runRootPathModuleSQL(t, false) }
+func TestPostgresNextcloudRootPathModuleActual(t *testing.T) { runRootPathModuleSQL(t, true) }
