+// An authenticated legacy source upload is not an onboarding machine grant.
+// It retains its real human principal, current KB edit permission and mapped
+// directory identity; all signed source/body/build checks still apply.
+func (r *nextcloudOriginalUploadRead) checkHumanUploadActorInTx(tx *gorm.DB) error {
+	if !r.authenticatedCaller {
+		return ErrNextcloudOnboardingDenied
+	}
+	// A captured human holder is never reclassified into a newly created
+	// onboarding operation, regardless of that operation's state or scope.
+	var operation types.NextcloudOnboardingOperation
