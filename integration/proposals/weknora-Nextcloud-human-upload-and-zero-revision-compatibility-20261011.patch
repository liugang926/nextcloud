+		return ErrNextcloudOnboardingDenied
+	}
+	if err != gorm.ErrRecordNotFound {
+		return err
+	}
+	authority, err := knowledgeSQLiteEmbeddingAuthority(tx, r.store)
+	if err != nil {
+		return err
+	}
+	fresh, err := authority.RefreshCurrentReadActor(r.ctx)
+	if err != nil {
+		return err
+	}
+	if !sameOriginalModelCallerInRepository(fresh, r.ctx) {
+		return ErrNextcloudOnboardingDenied
+	}
+	caller := types.CallerFromContext(fresh)
+	principal, ok := types.PrincipalFromContext(fresh)
+	if !ok || principal.Type != types.PrincipalWebUser || principal.ID != caller.UserID || caller.TenantID != r.payload.TenantID || caller.UserID == "" || types.IsSyntheticUserID(caller.UserID) {
+		return ErrNextcloudOnboardingDenied
+	}
+	var kb types.KnowledgeBase
+	if err = tx.Where("id=? AND tenant_id=? AND deleted_at IS NULL", r.payload.KnowledgeBaseID, r.payload.TenantID).Take(&kb).Error; err != nil {
+		return err
+	}
+	if _, err = authority.authorizeKnowledgeActorWrite(fresh, &kb); err != nil {
+		return err
+	}
+	identities, snapshot, err := NewDirectoryRepository(tx).GetUserLoginSnapshot(fresh, caller.UserID)
+	if err != nil || snapshot == nil || snapshot.Directory == nil || snapshot.Identity == nil || len(identities) != 1 {
+		return ErrNextcloudOnboardingDenied
+	}
+	identity := snapshot.Identity
+	directory := snapshot.Directory
+	if identity.UserID == nil || *identity.UserID != caller.UserID || identity.DirectoryID != directory.ID || identity.Status != types.DirectoryObjectActive || identity.SnapshotVersion != directory.SnapshotVersion {
+		return ErrNextcloudOnboardingDenied
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return err
+	}
+	if err = directoryUsable(tx, directory.ID, time.UnixMilli(now).UTC()); err != nil {
+		return err
+	}
+	if r.humanDirectoryID == "" {
+		r.humanDirectoryID = identity.DirectoryID
+		r.humanObjectGUID = identity.ObjectGUID
+	} else if r.humanDirectoryID != identity.DirectoryID || r.humanObjectGUID != identity.ObjectGUID {
+		return ErrNextcloudOnboardingDenied
+	}
+	var locked types.Directory
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", directory.ID).Take(&locked).Error; err != nil {
+		return err
+	}
+	var lockedIdentity types.DirectoryIdentity
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND directory_id=? AND object_guid=? AND user_id=? AND status=? AND snapshot_version=?", identity.ID, directory.ID, identity.ObjectGUID, caller.UserID, types.DirectoryObjectActive, locked.SnapshotVersion).Take(&lockedIdentity).Error; err != nil {
+		return ErrNextcloudOnboardingDenied
+	}
+	return r.ctx.Err()
+}
