index 0000000000000000000000000000000000000000..f319b68bfbf2292356da23b8c0ed9a8902122866
--- /dev/null
+++ b/internal/database/migration_peer_partial_wal_diagnostic_test.go
@@ -0,0 +1,156 @@
+//go:build linux || darwin
+
+package database
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+const peerPartialWALDiagnosticFlag = "WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC"
+
+type peerPartialWALSidecarMetadata struct {
+	Exists         bool
+	IdentitySHA256 string
+	HeaderSHA256   string
+	HeaderBytes    int
+}
+type peerPartialWALPathMetadata struct {
+	ReadOK, Known, Dirty, Ready bool
+	Version                     uint
+	JournalMode                 string
+}
+type peerPartialWALDiagnosticMetadata struct {
+	MainIdentitySHA256                     string
+	AliasSameMain                          bool
+	Main, Alias                            peerPartialWALPathMetadata
+	WAL, SHM                               peerPartialWALSidecarMetadata
+	POSIXProbeOK, ParentSharedLockObserved bool
+	POSIXLockType                          int16
+}
+
+func peerPartialWALFileIdentity(info os.FileInfo) string {
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return ""
+	}
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(fmt.Sprint(st.Dev)+"/"+fmt.Sprint(st.Ino))))
+}
+func peerPartialWALSidecar(path string) peerPartialWALSidecarMetadata {
+	info, err := os.Stat(path)
+	if err != nil {
+		return peerPartialWALSidecarMetadata{}
+	}
+	out := peerPartialWALSidecarMetadata{Exists: true, IdentitySHA256: peerPartialWALFileIdentity(info)}
+	file, err := os.Open(path)
+	if err != nil {
+		return out
+	}
+	header := make([]byte, 32)
+	n, err := io.ReadFull(file, header)
+	closeErr := file.Close()
+	if (err == nil || err == io.ErrUnexpectedEOF || err == io.EOF) && closeErr == nil {
+		out.HeaderBytes = n
+		out.HeaderSHA256 = fmt.Sprintf("%x", sha256.Sum256(header[:n]))
+	}
+	return out
+}
+func peerPartialWALReadOnlyPath(ctx context.Context, path string) peerPartialWALPathMetadata {
+	out := peerPartialWALPathMetadata{}
+	db, _, err := openJointLineageDB("sqlite3://unused", MigrationOptions{SQLiteDBPath: path, jointReadOnly: true})
+	if err != nil {
+		return out
+	}
+	db.SetMaxOpenConns(1)
+	version, dirty, known, readErr := observeJointSchemaHistoryOnDB(ctx, db, "sqlite")
+	out.Version, out.Dirty, out.Known = version, dirty, known
+	journalErr := db.QueryRowContext(ctx, "PRAGMA journal_mode").Scan(&out.JournalMode)
+	out.Ready = VerifyJointSchemaReadyOnDB(ctx, db, "sqlite") == nil
+	closeErr := db.Close()
+	out.ReadOK = readErr == nil && journalErr == nil && closeErr == nil
+	return out
+}
+
+// Dedicated independent process: only schema/lock/sidecar metadata is read.
+// It never signs an original, opens a migrate driver, changes a pragma or writes.
+// The kernel probe closes its FD BEFORE opening any SQLite connection in this
+// probe process; that close cannot release the parent process's POSIX locks.
+func TestPeerPartialSQLiteWALDiagnosticHelper(t *testing.T) {
+	if os.Getenv("WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_HELPER") != "1" {
+		return
+	}
+	main, alias := os.Getenv("WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_MAIN"), os.Getenv("WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_ALIAS")
+	require.NotEmpty(t, main)
+	require.NotEmpty(t, alias)
+	parent, err := strconv.Atoi(os.Getenv("WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_PARENT"))
+	require.NoError(t, err)
+	require.Positive(t, parent)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	info, err := os.Stat(main)
+	require.NoError(t, err)
+	aliasInfo, err := os.Stat(alias)
+	require.NoError(t, err)
+	out := peerPartialWALDiagnosticMetadata{MainIdentitySHA256: peerPartialWALFileIdentity(info), AliasSameMain: os.SameFile(info, aliasInfo)}
+	resolved, err := filepath.EvalSymlinks(main)
+	require.NoError(t, err)
+	fd, err := unix.Open(resolved, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	require.NoError(t, err)
+	// Pinned SQLite's MAIN SHARED range is [PENDING_BYTE+2,+510).
+	lock := unix.Flock_t{Type: unix.F_WRLCK, Whence: 0, Start: 0x40000002, Len: 510}
+	probeErr := unix.FcntlFlock(uintptr(fd), unix.F_GETLK, &lock)
+	closeErr := unix.Close(fd)
+	out.POSIXProbeOK = probeErr == nil && closeErr == nil
+	if out.POSIXProbeOK {
+		out.POSIXLockType = lock.Type
+		out.ParentSharedLockObserved = lock.Type == unix.F_RDLCK && int(lock.Pid) == parent
+	}
+	out.WAL = peerPartialWALSidecar(resolved + "-wal")
+	out.SHM = peerPartialWALSidecar(resolved + "-shm")
+	out.Main = peerPartialWALReadOnlyPath(ctx, main)
+	out.Alias = peerPartialWALReadOnlyPath(ctx, alias)
+	raw, err := json.Marshal(out)
+	require.NoError(t, err)
+	fmt.Println("PEER_WAL_DIAG " + string(raw))
+}
+func peerPartialWALDiagnostic(t *testing.T, phase, main, alias string) {
+	t.Helper()
+	if os.Getenv(peerPartialWALDiagnosticFlag) != "1" {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestPeerPartialSQLiteWALDiagnosticHelper$", "-test.count=1")
+	cmd.Env = append(os.Environ(), "WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_HELPER=1", "WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_MAIN="+main, "WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_ALIAS="+alias, "WEKNORA_PEER_SQLITE_WAL_DIAGNOSTIC_PARENT="+strconv.Itoa(os.Getpid()))
+	var stdout bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stdout
+	require.NoError(t, cmd.Run(), "owned read-only diagnostic process must actually terminate")
+	var metadata peerPartialWALDiagnosticMetadata
+	seen := 0
+	for _, line := range strings.Split(stdout.String(), "\n") {
+		if strings.HasPrefix(line, "PEER_WAL_DIAG ") {
+			seen++
+			require.NoError(t, json.Unmarshal([]byte(strings.TrimPrefix(line, "PEER_WAL_DIAG ")), &metadata))
+		}
+	}
+	require.Equal(t, 1, seen)
+	raw, err := json.Marshal(metadata)
+	require.NoError(t, err)
+	t.Logf("peer_partial_wal_diagnostic_phase=%s metadata=%s", phase, string(raw))
+}
