diff --git a/internal/datasource/connector/nextcloud/publication_epoch_seal_test.go b/internal/datasource/connector/nextcloud/publication_epoch_seal_test.go
new file mode 100644
index 00000000..182340a2
--- /dev/null
+++ b/internal/datasource/connector/nextcloud/publication_epoch_seal_test.go
@@ -0,0 +1,124 @@
+package nextcloud
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+type epochSealedCapture struct {
+	nextcloudCaptureStream
+	epoch    int64
+	observed bool
+}
+
+func (h *epochSealedCapture) ObserveNextcloudPublicationEpoch(_ context.Context, instance, binding string, epoch int64) error {
+	h.epoch = epoch
+	h.observed = true
+	return nil
+}
+
+// A genuine HTTP connector response and real request HMAC produce the private
+// artifact. Explicit signed protocol-v1 epoch0 is retained; no nil metadata
+// becomes a substitute epoch or a permission/provenance capability.
+func TestNextcloudPublicationEpochSealedFromSignedBindings(t *testing.T) {
+	for _, name := range []string{"current_epoch", "explicit_signed_legacy_zero", "missing_source_epoch", "null_source_epoch"} {
+		epoch := int64(1)
+		if name == "explicit_signed_legacy_zero" {
+			epoch = 0
+		}
+		t.Run(name, func(t *testing.T) {
+			var actualCfg config
+			var signedRequests int
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				raw, err := io.ReadAll(r.Body)
+				require.NoError(t, err)
+				canonical, err := machineCanonicalRequest(r.Method, r.URL.EscapedPath(), r.URL.RawQuery, raw, r.Header.Get("X-WeKnora-Timestamp"), r.Header.Get("X-WeKnora-Nonce"), r.Header.Get("X-WeKnora-Key-Id"))
+				require.NoError(t, err)
+				key := sha256.Sum256([]byte(actualCfg.token))
+				mac := hmac.New(sha256.New, key[:])
+				_, err = mac.Write([]byte(canonical))
+				require.NoError(t, err)
+				require.Equal(t, "Bearer "+actualCfg.token, r.Header.Get("Authorization"))
+				require.Equal(t, actualCfg.keyID, r.Header.Get("X-WeKnora-Key-Id"))
+				require.Equal(t, hex.EncodeToString(mac.Sum(nil)), r.Header.Get("X-WeKnora-Signature"))
+				signedRequests++
+				switch r.URL.Path {
+				case apiPath + "/capabilities":
+					writeJSON(w, map[string]string{"protocol_version": "1", "instance_id": "instance-1"})
+				case apiPath + "/bindings":
+					entry := map[string]interface{}{"id": "dev-published", "name": "Published", "root_file_id": 7, "publication_state": "active", "publication_epoch": epoch}
+					if name == "missing_source_epoch" {
+						delete(entry, "publication_epoch")
+					}
+					if name == "null_source_epoch" {
+						entry["publication_epoch"] = nil
+					}
+					writeJSON(w, map[string]interface{}{"bindings": []map[string]interface{}{entry}})
+				case apiPath + "/bindings/dev-published/changes":
+					http.NotFound(w, r)
+				case apiPath + "/bindings/dev-published/manifest":
+					writeJSON(w, testManifest("epoch-etag"))
+				case apiPath + "/bindings/dev-published/files/41/content":
+					w.Header().Set("ETag", "epoch-etag")
+					_, err = w.Write([]byte("hello"))
+					require.NoError(t, err)
+				default:
+					http.NotFound(w, r)
+				}
+			}))
+			defer server.Close()
+			source := testConfig(t, server.URL)
+			var err error
+			actualCfg, err = parseConfig(source)
+			require.NoError(t, err)
+			handler := &epochSealedCapture{}
+			_, err = NewConnector().FetchFullStream(context.Background(), source, nil, handler)
+			if name == "missing_source_epoch" || name == "null_source_epoch" {
+				require.Error(t, err)
+				require.False(t, handler.observed)
+				require.Empty(t, handler.items)
+				require.Equal(t, 2, signedRequests, "source must close after actual capabilities/bindings before fetching a body or sealing an artifact")
+				return
+			}
+			require.NoError(t, err)
+			require.True(t, handler.observed)
+			require.Equal(t, epoch, handler.epoch)
+			require.Len(t, handler.items, 1)
+			require.GreaterOrEqual(t, signedRequests, 4)
+			item := handler.items[0]
+			artifact, err := VerifyOriginalFetchedArtifact(&item)
+			require.NoError(t, err)
+			require.NoError(t, VerifyOriginalArtifactConfiguration(source, artifact))
+			expected := "1"
+			if epoch == 0 {
+				expected = "0"
+			}
+			require.Equal(t, expected, item.Metadata["nextcloud_publication_epoch"])
+			require.Equal(t, expected, artifact.PublicationEpoch)
+			before, err := json.Marshal(item.Metadata)
+			require.NoError(t, err)
+			require.NotEmpty(t, before)
+			item.Metadata["nextcloud_publication_epoch"] = "2"
+			_, err = VerifyOriginalFetchedArtifact(&item)
+			require.Error(t, err, "observed source epoch is part of the complete immutable artifact")
+			// Restore-only ABA is not a grant: it merely confirms that no verifier
+			// secretly rewrote the opaque original when the earlier check refused.
+			item.Metadata["nextcloud_publication_epoch"] = expected
+			_, err = VerifyOriginalFetchedArtifact(&item)
+			require.NoError(t, err)
+			delete(item.Metadata, "nextcloud_publication_epoch")
+			_, err = VerifyOriginalFetchedArtifact(&item)
+			require.Error(t, err, "missing metadata never manufactures legacy zero")
+			require.True(t, strings.HasPrefix(item.ExternalID, "nextcloud:instance-1:"))
+		})
+	}
+}
