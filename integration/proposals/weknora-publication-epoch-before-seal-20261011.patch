--- /dev/null
+++ b/internal/application/service/nextcloud_publication_epoch_seal_sql_actual_test.go
@@ -0,0 +1,120 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/datasource"
+	"github.com/Tencent/WeKnora/internal/datasource/connector/nextcloud"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+	"testing"
+	"time"
+)
+
+type epochSealActualConnector struct {
+	*nextcloud.Connector
+	t                                                              *testing.T
+	mode                                                           string
+	seen, validBefore, validAfter, metadataUnchanged, faultApplied bool
+	epoch                                                          string
+}
+
+func (c *epochSealActualConnector) FetchStream(ctx context.Context, cfg *types.DataSourceConfig, cursor *types.SyncCursor, h datasource.StreamHandler) (*types.SyncCursor, error) {
+	actual, ok := h.(*streamSyncHandler)
+	require.True(c.t, ok, "the actual production Sync handler must own ingestion")
+	return c.Connector.FetchStream(ctx, cfg, cursor, &epochSealActualStream{streamSyncHandler: actual, owner: c, cfg: cfg})
+}
+func (c *epochSealActualConnector) FetchFullStream(ctx context.Context, cfg *types.DataSourceConfig, cursor *types.SyncCursor, h datasource.StreamHandler) (*types.SyncCursor, error) {
+	actual, ok := h.(*streamSyncHandler)
+	require.True(c.t, ok, "the actual production Sync handler must own ingestion")
+	return c.Connector.FetchFullStream(ctx, cfg, cursor, &epochSealActualStream{streamSyncHandler: actual, owner: c, cfg: cfg})
+}
+
+type epochSealActualStream struct {
+	*streamSyncHandler
+	owner *epochSealActualConnector
+	cfg   *types.DataSourceConfig
+}
+
+func (s *epochSealActualStream) Emit(ctx context.Context, item types.FetchedItem) error {
+	t := s.owner.t
+	s.owner.seen = true
+	artifact, err := nextcloud.VerifyOriginalFetchedArtifact(&item)
+	require.NoError(t, err, "only the real connector may issue this artifact")
+	require.NoError(t, nextcloud.VerifyOriginalArtifactConfiguration(s.cfg, artifact))
+	require.Equal(t, "1", artifact.PublicationEpoch)
+	require.Equal(t, "1", item.Metadata["nextcloud_publication_epoch"])
+	require.Equal(t, "actual-etag", artifact.ETag)
+	require.Equal(t, "source.md", artifact.Path)
+	s.owner.validBefore = true
+	s.owner.epoch = artifact.PublicationEpoch
+	if s.owner.mode == "observed_epoch_mismatch" {
+		epoch := *s.nextcloudPublicationEpoch + 1
+		s.nextcloudPublicationEpoch = &epoch
+		s.owner.faultApplied = true
+	}
+	if s.owner.mode == "sealed_metadata_mutation" {
+		item.Metadata["nextcloud_publication_epoch"] = "2"
+		s.owner.faultApplied = true
+	}
+	if s.owner.mode == "missing_sealed_epoch" {
+		delete(item.Metadata, "nextcloud_publication_epoch")
+		s.owner.faultApplied = true
+	}
+	before, err := json.Marshal(item.Metadata)
+	require.NoError(t, err)
+	emitErr := s.streamSyncHandler.Emit(ctx, item)
+	after, err := json.Marshal(item.Metadata)
+	require.NoError(t, err)
+	s.owner.metadataUnchanged = string(before) == string(after)
+	require.Equal(t, string(before), string(after), "Emit must not alter/reseal source metadata")
+	_, verifyErr := nextcloud.VerifyOriginalFetchedArtifact(&item)
+	s.owner.validAfter = verifyErr == nil
+	if s.owner.mode == "current" {
+		require.NoError(t, emitErr)
+		require.NoError(t, verifyErr)
+	} else {
+		require.Error(t, emitErr)
+		if s.owner.mode == "observed_epoch_mismatch" {
+			require.NoError(t, verifyErr)
+		} else {
+			require.Error(t, verifyErr)
+		}
+	}
+	return emitErr
+}
+func TestNextcloudPublicationEpochBeforeSealActualSQLite(t *testing.T) {
+	for _, mode := range []string{"current", "observed_epoch_mismatch", "sealed_metadata_mutation", "missing_sealed_epoch"} {
+		t.Run(mode, func(t *testing.T) {
+			// Complete migration87 + actual signed source HTTP fixture, real paired
+			// source/config/model/KB producers. The connector and actual Emit remain
+			// production methods; the wrapper only applies declared negative faults.
+			m := newMachinePipelineFixtureWithDocument(t, false, "Actual source epoch document", true, true, true)
+			connector := &epochSealActualConnector{Connector: nextcloud.NewConnector(), t: t, mode: mode}
+			registry := datasource.NewConnectorRegistry()
+			require.NoError(t, registry.Register(connector))
+			m.source.connectorRegistry = registry
+			log := &types.SyncLog{ID: "actual-sealed-epoch-sync", DataSourceID: m.ds.ID, TenantID: 7, Status: types.SyncLogStatusRunning, StartedAt: time.Now().UTC()}
+			require.NoError(t, m.source.syncLogRepo.Create(context.Background(), log))
+			operation, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+			defer cancel()
+			err := m.source.ProcessSync(operation, enrichmentTask(t, types.TypeDataSourceSync, types.DataSourceSyncPayload{DataSourceID: m.ds.ID, TenantID: 7, SyncLogID: log.ID, ForceFull: true}))
+			require.True(t, connector.seen)
+			require.True(t, connector.validBefore)
+			require.True(t, connector.metadataUnchanged)
+			require.Equal(t, "1", connector.epoch)
+			var rows int64
+			require.NoError(t, m.f.db.Model(&types.Knowledge{}).Where("channel=?", types.ConnectorTypeNextcloud).Count(&rows).Error)
+			if mode == "current" {
+				require.NoError(t, err)
+				require.EqualValues(t, 1, rows)
+				require.True(t, connector.validAfter)
+				require.False(t, connector.faultApplied)
+			} else {
+				require.Error(t, err)
+				require.Zero(t, rows)
+				require.True(t, connector.faultApplied)
+			}
+		})
+	}
+}
