+// Presence is source metadata, not a default or grant. Keep the public
+// integer wire shape for all binding consumers while distinguishing explicit
+// zero from an absent/null/invalid signed response field.
+func (b *binding) UnmarshalJSON(raw []byte) error {
+	type wireBinding binding
+	var wire wireBinding
+	if err := json.Unmarshal(raw, &wire); err != nil {
+		return err
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil {
+		return err
+	}
+	value, present := fields["publication_epoch"]
+	wire.publicationEpochPresent = present
+	wire.publicationEpochValid = present && strings.TrimSpace(string(value)) != "null" && json.Unmarshal(value, &wire.PublicationEpoch) == nil && wire.PublicationEpoch >= 0
+	*b = binding(wire)
+	return nil
 }
 
 type bindingsResponse struct {
