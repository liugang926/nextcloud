+-- Forward-only 169 component: repair the optional LOCAL guard omitted by an
+-- already-applied historical 125. Do not replay 125 or use search_path to adopt
+-- another schema's embeddings. Pending until the complete route/hash witness
+-- is wired before migrate driver creation; this file is not active Root168.
+DO $repair$
+DECLARE
+    local_schema TEXT := current_schema();
+    local_table OID;
+    captured_table OID;
+    local_function OID;
+    actual_body TEXT;
+    actual_language TEXT;
+    actual_returns TEXT;
+    actual_args INTEGER;
+    actual_security BOOLEAN;
+    actual_configured BOOLEAN;
+    actual_owner BOOLEAN;
+    actual_columns JSONB;
+    valid_shape BOOLEAN;
+    trigger_count INTEGER;
+    expected_body TEXT := $canonical$
+DECLARE
+    kb_id TEXT;
+    prior_kb TEXT;
+    next_kb TEXT;
+    safe_event_revoke BOOLEAN := FALSE;
+BEGIN
+    IF TG_TABLE_NAME = 'nextcloud_event_connections' AND TG_OP = 'UPDATE' THEN
+        -- Emergency revoke remains possible after withdrawal. No identity,
+        -- active key or secret may change; previous-key grace must be cleared.
+        safe_event_revoke := OLD.status = 'active' AND NEW.status = 'revoked'
+            AND NEW.connection_id IS NOT DISTINCT FROM OLD.connection_id
+            AND NEW.tenant_id IS NOT DISTINCT FROM OLD.tenant_id
+            AND NEW.knowledge_base_id IS NOT DISTINCT FROM OLD.knowledge_base_id
+            AND NEW.datasource_id IS NOT DISTINCT FROM OLD.datasource_id
+            AND NEW.nextcloud_instance_id IS NOT DISTINCT FROM OLD.nextcloud_instance_id
+            AND NEW.binding_id IS NOT DISTINCT FROM OLD.binding_id
+            AND NEW.datasource_base_url IS NOT DISTINCT FROM OLD.datasource_base_url
+            AND NEW.datasource_config_sha256 IS NOT DISTINCT FROM OLD.datasource_config_sha256
+            AND NEW.current_key_id IS NOT DISTINCT FROM OLD.current_key_id
+            AND NEW.current_secret_ciphertext IS NOT DISTINCT FROM OLD.current_secret_ciphertext
+            AND NEW.created_at IS NOT DISTINCT FROM OLD.created_at
+            AND NEW.previous_key_id IS NULL
+            AND NEW.previous_secret_ciphertext IS NULL
+            AND NEW.previous_valid_until IS NULL;
+    END IF;
+    IF TG_TABLE_NAME = 'sync_logs' THEN
+        IF TG_OP <> 'INSERT' THEN
+            SELECT p.knowledge_base_id INTO prior_kb FROM nextcloud_source_pairings p
+            WHERE p.datasource_id = OLD.data_source_id;
+        END IF;
+        IF TG_OP <> 'DELETE' THEN
+            SELECT p.knowledge_base_id INTO next_kb FROM nextcloud_source_pairings p
+            WHERE p.datasource_id = NEW.data_source_id;
+        END IF;
+    ELSIF TG_TABLE_NAME IN ('nextcloud_source_versions', 'nextcloud_event_connections') THEN
+        IF TG_OP <> 'INSERT' THEN
+            SELECT p.knowledge_base_id INTO prior_kb FROM nextcloud_source_pairings p
+            WHERE p.datasource_id = OLD.datasource_id;
+        END IF;
+        IF TG_OP <> 'DELETE' THEN
+            SELECT p.knowledge_base_id INTO next_kb FROM nextcloud_source_pairings p
+            WHERE p.datasource_id = NEW.datasource_id;
+        END IF;
+    ELSE
+        IF TG_OP <> 'INSERT' THEN
+            prior_kb := OLD.knowledge_base_id;
+        END IF;
+        IF TG_OP <> 'DELETE' THEN
+            next_kb := NEW.knowledge_base_id;
+        END IF;
+    END IF;
+    -- Lock both sides of a move in stable order. Otherwise an UPDATE could
+    -- move a copy out of a withdrawn source and bypass the old-scope fence.
+    FOR kb_id IN SELECT DISTINCT scope FROM (VALUES (prior_kb), (next_kb)) AS scopes(scope)
+                 WHERE scope IS NOT NULL ORDER BY scope LOOP
+        PERFORM 1 FROM knowledge_bases WHERE id = kb_id FOR UPDATE;
+        IF NOT safe_event_revoke AND EXISTS (
+            SELECT 1 FROM nextcloud_indexed_withdrawals WHERE knowledge_base_id = kb_id) THEN
+            RAISE EXCEPTION 'nextcloud_indexed_source_withdrawn' USING ERRCODE = '23514';
+        END IF;
+    END LOOP;
+    IF TG_OP = 'DELETE' THEN
+        RETURN OLD;
+    END IF;
+    RETURN NEW;
+END
+$canonical$;
+    expected_columns JSONB := $columns$[{"Name":"id","Type":"integer","NotNull":true,"Default":"SERIAL"},{"Name":"created_at","Type":"timestamp with time zone","NotNull":false,"Default":"CURRENT_TIMESTAMP"},{"Name":"updated_at","Type":"timestamp with time zone","NotNull":false,"Default":"CURRENT_TIMESTAMP"},{"Name":"source_id","Type":"character varying(64)","NotNull":true,"Default":""},{"Name":"source_type","Type":"integer","NotNull":true,"Default":""},{"Name":"chunk_id","Type":"character varying(64)","NotNull":false,"Default":""},{"Name":"knowledge_id","Type":"character varying(64)","NotNull":false,"Default":""},{"Name":"knowledge_base_id","Type":"character varying(64)","NotNull":false,"Default":""},{"Name":"content","Type":"text","NotNull":false,"Default":""},{"Name":"dimension","Type":"integer","NotNull":true,"Default":""},{"Name":"embedding","Type":"halfvec","NotNull":false,"Default":""},{"Name":"is_enabled","Type":"boolean","NotNull":false,"Default":"true"},{"Name":"tag_id","Type":"character varying(36)","NotNull":false,"Default":""}]$columns$::jsonb;
+BEGIN
+    -- Even optional-absent must retain the real canonical own write guard.
+    SELECT p.oid,p.prosrc,l.lanname,p.prorettype::regtype::text,p.pronargs,p.prosecdef,p.proconfig IS NOT NULL,pg_has_role(current_user,p.proowner,'USAGE')
+    INTO local_function,actual_body,actual_language,actual_returns,actual_args,actual_security,actual_configured,actual_owner
+    FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace JOIN pg_language l ON l.oid=p.prolang
+    WHERE n.nspname=local_schema AND p.proname='nextcloud_indexed_withdrawal_write_guard' AND p.pronargs=0;
+    IF local_function IS NULL OR actual_body IS DISTINCT FROM expected_body OR actual_language IS DISTINCT FROM 'plpgsql'
+       OR actual_returns IS DISTINCT FROM 'trigger' OR actual_args IS DISTINCT FROM 0 OR actual_security IS DISTINCT FROM FALSE
+       OR actual_configured IS DISTINCT FROM FALSE OR actual_owner IS DISTINCT FROM TRUE THEN
+        RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514';
+    END IF;
+    SELECT c.oid INTO local_table FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
+    WHERE n.nspname=local_schema AND c.relname='embeddings';
+    IF local_table IS NULL THEN RETURN; END IF;
+    captured_table := local_table;
+    EXECUTE format('LOCK TABLE %I.%I IN ACCESS EXCLUSIVE MODE',local_schema,'embeddings');
+    SELECT c.oid INTO local_table FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
+    WHERE n.nspname=local_schema AND c.relname='embeddings' AND c.relkind='r'
+      AND pg_has_role(current_user,c.relowner,'USAGE')
+      AND NOT EXISTS(SELECT 1 FROM pg_inherits WHERE inhrelid=c.oid OR inhparent=c.oid);
+    IF local_table IS DISTINCT FROM captured_table THEN
+        RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514';
+    END IF;
+    SELECT jsonb_agg(jsonb_build_object('Name',a.attname,'Type',format_type(a.atttypid,a.atttypmod),'NotNull',a.attnotnull,
+        'Default',CASE WHEN a.attname='id' THEN 'SERIAL' ELSE COALESCE(pg_get_expr(d.adbin,d.adrelid),'') END) ORDER BY a.attnum)
+      INTO actual_columns
+    FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
+    WHERE a.attrelid=local_table AND a.attnum>0 AND NOT a.attisdropped;
+    IF actual_columns IS DISTINCT FROM expected_columns OR EXISTS(
+        SELECT 1 FROM pg_attribute WHERE attrelid=local_table AND attnum>0 AND NOT attisdropped AND (attidentity<>'' OR attgenerated<>'')) THEN
+        RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514';
+    END IF;
+    SELECT EXISTS(
+ SELECT 1 FROM pg_attribute a JOIN pg_type t ON t.oid=a.atttypid JOIN pg_depend d ON d.classid='pg_type'::regclass AND d.objid=t.oid AND d.refclassid='pg_extension'::regclass AND d.deptype='e'
+ JOIN pg_extension e ON e.oid=d.refobjid WHERE a.attrelid=local_table AND a.attnum=11 AND a.attndims=0 AND a.attcollation=0
+ AND t.typname='halfvec' AND t.typtype='b' AND t.typisdefined AND t.typnamespace=e.extnamespace AND e.extname='vector') INTO valid_shape;
+    IF valid_shape IS DISTINCT FROM TRUE THEN RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514'; END IF;
+    SELECT EXISTS(
+ SELECT 1 FROM pg_attrdef d JOIN pg_depend x ON x.classid='pg_attrdef'::regclass AND x.objid=d.oid AND x.deptype='n'
+ JOIN pg_class s ON s.oid=x.refobjid AND x.refclassid='pg_class'::regclass JOIN pg_namespace sn ON sn.oid=s.relnamespace
+ JOIN pg_depend own ON own.classid='pg_class'::regclass AND own.objid=s.oid AND own.refclassid='pg_class'::regclass AND own.refobjid=d.adrelid AND own.refobjsubid=1 AND own.deptype='a'
+ WHERE d.adrelid=local_table AND d.adnum=1 AND s.relkind='S' AND sn.nspname=current_schema() AND s.relname='embeddings_id_seq'
+ AND pg_get_expr(d.adbin,d.adrelid) IN ('nextval(''embeddings_id_seq''::regclass)',format('nextval(%L::regclass)',format('%I.%I',sn.nspname,s.relname)))) INTO valid_shape;
+    IF valid_shape IS DISTINCT FROM TRUE THEN RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514'; END IF;
+    SELECT EXISTS(
+ SELECT 1 FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_am a ON a.oid=c.relam
+ WHERE i.indrelid=local_table AND n.nspname=current_schema() AND c.relname='embeddings_unique_source' AND a.amname='btree'
+ AND i.indisunique AND i.indisvalid AND i.indisready AND i.indnkeyatts=2 AND i.indnatts=2 AND i.indkey::text='4 5' AND i.indoption::text='0 0' AND i.indexprs IS NULL AND i.indpred IS NULL
+ AND i.indclass[0]=(SELECT o.oid FROM pg_opclass o JOIN pg_namespace n ON n.oid=o.opcnamespace WHERE n.nspname='pg_catalog' AND o.opcname='text_ops' AND o.opcmethod=c.relam)
+ AND i.indclass[1]=(SELECT o.oid FROM pg_opclass o JOIN pg_namespace n ON n.oid=o.opcnamespace WHERE n.nspname='pg_catalog' AND o.opcname='int4_ops' AND o.opcmethod=c.relam)
+ AND i.indcollation[0]=(SELECT oid FROM pg_collation WHERE collname='default' AND collnamespace='pg_catalog'::regnamespace) AND i.indcollation[1]=0) INTO valid_shape;
+    IF valid_shape IS DISTINCT FROM TRUE THEN RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514'; END IF;
+    SELECT count(*)=1 AND count(*) FILTER(WHERE contype='p' AND conkey::text='{1}' AND convalidated AND NOT condeferrable AND NOT condeferred)=1
+      INTO valid_shape FROM pg_constraint WHERE conrelid=local_table;
+    IF valid_shape IS DISTINCT FROM TRUE THEN RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514'; END IF;
+    SELECT count(*) INTO trigger_count FROM pg_trigger WHERE tgrelid=local_table AND NOT tgisinternal;
+    IF trigger_count=0 THEN
+        EXECUTE format('CREATE TRIGGER nextcloud_indexed_embedding_guard BEFORE INSERT OR UPDATE OR DELETE ON %I.%I FOR EACH ROW EXECUTE FUNCTION %I.nextcloud_indexed_withdrawal_write_guard()',local_schema,'embeddings',local_schema);
+    ELSIF trigger_count<>1 THEN
+        RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514';
+    END IF;
+    SELECT count(*)=1 INTO valid_shape FROM pg_trigger WHERE tgrelid=local_table AND NOT tgisinternal
+      AND tgname='nextcloud_indexed_embedding_guard' AND tgfoid=local_function AND tgtype=31 AND tgenabled='O'
+      AND tgnargs=0 AND tgqual IS NULL AND tgattr::text='' AND tgconstraint=0;
+    IF valid_shape IS DISTINCT FROM TRUE THEN RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514'; END IF;
+    -- No function replacement and no body/control/grant write occurred. Recheck
+    -- the exact function tuple after all DDL before this transaction commits.
+    IF NOT EXISTS(SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace JOIN pg_language l ON l.oid=p.prolang
+      WHERE p.oid=local_function AND n.nspname=local_schema AND p.proname='nextcloud_indexed_withdrawal_write_guard'
+      AND p.prosrc=expected_body AND l.lanname='plpgsql' AND p.prorettype='trigger'::regtype AND p.pronargs=0
+      AND NOT p.prosecdef AND p.proconfig IS NULL AND pg_has_role(current_user,p.proowner,'USAGE')) THEN
+        RAISE EXCEPTION 'joint_125_local_guard_unknown' USING ERRCODE='23514';
+    END IF;
+END
+$repair$;
