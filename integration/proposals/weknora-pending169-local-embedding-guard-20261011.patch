+package database
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/json"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/golang-migrate/migrate/v4"
+	"github.com/stretchr/testify/require"
+)
+
+// This gate exercises the exact pending 169 SQL in a real transaction. It is
+// deliberately not proof that the future early selector/171 peer route exists.
+// Local positives require real halfvec/pg_search support and canonical 002/007;
+// no fixture type/domain or hand-written local embedding schema substitutes it.
+func joint125ActualFixture(t *testing.T, local bool) (*sql.DB, string) {
+	t.Helper()
+	require.NotEmpty(t, os.Getenv("WEKNORA_MIGRATION_TEST_POSTGRES_DSN"), "owned disposable PostgreSQL is required; do not skip")
+	db, dsn, _ := jointLineageFixture(t, true)
+	if local {
+		parsed, err := url.Parse(dsn)
+		require.NoError(t, err)
+		query := parsed.Query()
+		options := strings.ReplaceAll(query.Get("options"), "-c app.skip_embedding=true", "")
+		query.Set("options", strings.TrimSpace(options)+" -c app.skip_embedding=false")
+		parsed.RawQuery = query.Encode()
+		dsn = parsed.String()
+	}
+	root := sqliteRepoRoot(t)
+	m, err := migrate.New("file://"+filepath.Join(root, "migrations/versioned"), dsn)
+	require.NoError(t, err)
+	err = m.Migrate(168)
+	sourceErr, driverErr := m.Close()
+	require.NoError(t, err, "real feature-full local gate needs vector/pg_search; missing extension is not a business pass")
+	require.NoError(t, sourceErr)
+	require.NoError(t, driverErr)
+	version, dirty := jointLineageMigrationState(t, db)
+	require.EqualValues(t, 168, version)
+	require.False(t, dirty)
+	return db, root
+}
+
+func joint125ExecuteComponent(t *testing.T, db *sql.DB, root string, down bool) error {
+	t.Helper()
+	suffix := "up"
+	if down {
+		suffix = "down"
+	}
+	body, err := os.ReadFile(filepath.Join(root, "migrations/pending/joint_125_guard_repair/versioned/000169_nextcloud_local_embedding_guard_repair."+suffix+".sql"))
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	tx, err := db.BeginTx(ctx, nil)
+	require.NoError(t, err)
+	_, execErr := tx.ExecContext(ctx, string(body))
+	if execErr != nil {
+		require.NoError(t, tx.Rollback())
+		return execErr
+	}
+	return tx.Commit()
+}
+
+func joint125ForeignFixture(t *testing.T, db *sql.DB) (string, string) {
+	t.Helper()
+	var schema string
+	require.NoError(t, db.QueryRow("SELECT current_schema()").Scan(&schema))
+	foreign := schema + "_foreign"
+	_, err := db.Exec("CREATE SCHEMA " + jointIdentifierQuoted(foreign))
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_, err := db.Exec("DROP SCHEMA " + jointIdentifierQuoted(foreign) + " CASCADE")
+		if err != nil {
+			t.Error("owned foreign fixture cleanup failed")
+		}
+	})
+	_, err = db.Exec("CREATE TABLE " + jointIdentifierQuoted(foreign) + ".embeddings(id INTEGER PRIMARY KEY,owned_marker TEXT NOT NULL)")
+	require.NoError(t, err)
+	_, err = db.Exec("INSERT INTO " + jointIdentifierQuoted(foreign) + ".embeddings VALUES(1,'retained owned foreign marker')")
+	require.NoError(t, err)
+	_, err = db.Exec("CREATE FUNCTION " + jointIdentifierQuoted(foreign) + ".nextcloud_indexed_withdrawal_write_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$")
+	require.NoError(t, err)
+	_, err = db.Exec("CREATE TRIGGER nextcloud_indexed_embedding_guard BEFORE INSERT OR UPDATE OR DELETE ON " + jointIdentifierQuoted(foreign) + ".embeddings FOR EACH ROW EXECUTE FUNCTION " + jointIdentifierQuoted(foreign) + ".nextcloud_indexed_withdrawal_write_guard()")
+	require.NoError(t, err)
+	return schema, foreign
+}
+
+func joint125ForeignFingerprint(t *testing.T, db *sql.DB, namespace string) string {
+	t.Helper()
+	var identity struct {
+		TableOID, TriggerOID, FunctionOID uint32
+		Definition, Body, Marker          string
+	}
+	query := `SELECT c.oid,t.oid,p.oid,pg_get_triggerdef(t.oid),p.prosrc,e.owned_marker
+	 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_trigger t ON t.tgrelid=c.oid JOIN pg_proc p ON p.oid=t.tgfoid
+	 JOIN ` + jointIdentifierQuoted(namespace) + `.embeddings e ON e.id=1 WHERE n.nspname=$1 AND c.relname='embeddings' AND NOT t.tgisinternal`
+	require.NoError(t, db.QueryRow(query, namespace).Scan(&identity.TableOID, &identity.TriggerOID, &identity.FunctionOID, &identity.Definition, &identity.Body, &identity.Marker))
+	encoded, err := json.Marshal(identity)
+	require.NoError(t, err)
+	return fmtJoint125SHA(encoded)
+}
+func fmtJoint125SHA(data []byte) string {
+	sum := sha256.Sum256(data)
+	const digits = "0123456789abcdef"
+	out := make([]byte, len(sum)*2)
+	for i, b := range sum {
+		out[i*2] = digits[b>>4]
+		out[i*2+1] = digits[b&15]
+	}
+	return string(out)
+}
+
+func TestPostgresJoint125GuardRepairAbsentActual(t *testing.T) {
+	for _, mode := range []string{"optional_absent_foreign_unchanged", "unknown_local_relation", "unknown_function", "down_refuses"} {
+		t.Run(mode, func(t *testing.T) {
+			db, root := joint125ActualFixture(t, false)
+			_, foreign := joint125ForeignFixture(t, db)
+			foreignBefore := joint125ForeignFingerprint(t, db, foreign)
+			if mode == "unknown_local_relation" {
+				_, err := db.Exec("CREATE TABLE embeddings(owned_unknown TEXT NOT NULL)")
+				require.NoError(t, err)
+			}
+			if mode == "unknown_function" {
+				_, err := db.Exec("CREATE OR REPLACE FUNCTION nextcloud_indexed_withdrawal_write_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$")
+				require.NoError(t, err)
+			}
+			before := memoryFullSchemaSnapshot(t, db, "versioned")
+			decision, checkErr := inspectJoint125LocalRepair(context.Background(), db)
+			err := joint125ExecuteComponent(t, db, root, mode == "down_refuses")
+			if mode == "optional_absent_foreign_unchanged" {
+				require.NoError(t, checkErr)
+				require.Equal(t, joint125OptionalAbsent, decision.state)
+				require.NoError(t, err)
+			} else if mode == "down_refuses" {
+				require.NoError(t, checkErr)
+				require.Equal(t, joint125OptionalAbsent, decision.state)
+				require.ErrorContains(t, err, "joint_125_local_guard_rollback_forbidden")
+			} else {
+				require.ErrorIs(t, checkErr, ErrJointSchemaUnknown)
+				require.ErrorContains(t, err, "joint_125_local_guard_unknown")
+			}
+			require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "versioned"))
+			require.Equal(t, foreignBefore, joint125ForeignFingerprint(t, db, foreign))
+			version, dirty := jointLineageMigrationState(t, db)
+			require.EqualValues(t, 168, version)
+			require.False(t, dirty, "component does not rewrite a ledger into a fabricated forward route")
+		})
+	}
+}
+
+func TestPostgresJoint125GuardRepairLocalActual(t *testing.T) {
+	for _, mode := range []string{"existing_local_guard", "missing_local_guard", "disabled_local_guard", "foreign_bound_guard", "extra_local_trigger", "changed_local_column", "wrong_unique_index", "wrong_sequence", "narrowing_check"} {
+		t.Run(mode, func(t *testing.T) {
+			db, root := joint125ActualFixture(t, true)
+			schema, foreign := joint125ForeignFixture(t, db)
+			foreignBefore := joint125ForeignFingerprint(t, db, foreign)
+			_, err := db.Exec("INSERT INTO embeddings(source_id,source_type,knowledge_base_id,dimension,content) VALUES('owned-source',1,NULL,2,'native source payload retained')")
+			require.NoError(t, err)
+			var rowsBefore string
+			require.NoError(t, db.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&rowsBefore))
+			switch mode {
+			case "missing_local_guard":
+				_, err = db.Exec("DROP TRIGGER nextcloud_indexed_embedding_guard ON embeddings")
+			case "disabled_local_guard":
+				_, err = db.Exec("ALTER TABLE embeddings DISABLE TRIGGER nextcloud_indexed_embedding_guard")
+			case "foreign_bound_guard":
+				_, err = db.Exec("DROP TRIGGER nextcloud_indexed_embedding_guard ON embeddings")
+				require.NoError(t, err)
+				_, err = db.Exec("CREATE TRIGGER nextcloud_indexed_embedding_guard BEFORE INSERT OR UPDATE OR DELETE ON embeddings FOR EACH ROW EXECUTE FUNCTION " + jointIdentifierQuoted(foreign) + ".nextcloud_indexed_withdrawal_write_guard()")
+			case "extra_local_trigger":
+				_, err = db.Exec("CREATE TRIGGER owned_extra_guard BEFORE UPDATE ON embeddings FOR EACH ROW EXECUTE FUNCTION nextcloud_indexed_withdrawal_write_guard()")
+			case "changed_local_column":
+				_, err = db.Exec("ALTER TABLE embeddings ADD COLUMN owned_unknown INTEGER")
+			case "wrong_unique_index":
+				_, err = db.Exec("DROP INDEX embeddings_unique_source")
+				require.NoError(t, err)
+				_, err = db.Exec("CREATE INDEX embeddings_unique_source ON embeddings(source_id,source_type)")
+			case "wrong_sequence":
+				_, err = db.Exec("ALTER TABLE embeddings ALTER COLUMN id SET DEFAULT 7")
+			case "narrowing_check":
+				_, err = db.Exec("ALTER TABLE embeddings ADD CONSTRAINT owned_narrow CHECK(dimension::smallint>0)")
+			}
+			require.NoError(t, err)
+			// Snapshot the actual fault, not the earlier clean shape. Every rejected
+			// operation must roll back without repairing an unknown object.
+			before := memoryFullSchemaSnapshot(t, db, "versioned")
+			decision, checkErr := inspectJoint125LocalRepair(context.Background(), db)
+			err = joint125ExecuteComponent(t, db, root, false)
+			positive := mode == "existing_local_guard" || mode == "missing_local_guard"
+			if positive {
+				require.NoError(t, checkErr)
+				require.Equal(t, schema, decision.schema)
+				require.NotZero(t, decision.tableOID)
+				require.NotZero(t, decision.functionOID)
+				if mode == "missing_local_guard" {
+					require.Equal(t, joint125GuardMissing, decision.state)
+				} else {
+					require.Equal(t, joint125GuardCurrent, decision.state)
+				}
+				require.NoError(t, err)
+				after, err := inspectJoint125LocalRepair(context.Background(), db)
+				require.NoError(t, err)
+				require.Equal(t, joint125GuardCurrent, after.state)
+				require.Equal(t, decision.tableOID, after.tableOID)
+				require.Equal(t, decision.functionOID, after.functionOID)
+				if mode == "existing_local_guard" {
+					require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "versioned"))
+				}
+				require.NoError(t, joint125ExecuteComponent(t, db, root, false), "second execution cannot replace a valid trigger")
+			} else {
+				require.ErrorIs(t, checkErr, ErrJointSchemaUnknown)
+				require.ErrorContains(t, err, "joint_125_local_guard_unknown")
+				require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "versioned"))
+			}
+			var rowsAfter string
+			rowQuery := "SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e"
+			if mode == "changed_local_column" {
+				rowQuery = "SELECT jsonb_agg(to_jsonb(e)-'owned_unknown' ORDER BY id)::text FROM embeddings e"
+			}
+			require.NoError(t, db.QueryRow(rowQuery).Scan(&rowsAfter))
+			require.Equal(t, rowsBefore, rowsAfter)
+			require.Equal(t, foreignBefore, joint125ForeignFingerprint(t, db, foreign))
+			version, dirty := jointLineageMigrationState(t, db)
+			require.EqualValues(t, 168, version)
+			require.False(t, dirty)
+		})
+	}
+}
