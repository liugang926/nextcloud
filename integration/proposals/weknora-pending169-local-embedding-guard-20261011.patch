+package database
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/lib/pq"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+// These are actual catalogue tuples, not content or authorization receipts.
+// The current body152 descriptor set intentionally has no legacy embeddings.
+type joint125WrapperTuple struct {
+	TableOID, TriggerOID, FunctionOID                    uint32
+	TableSchema, TableName, FunctionSchema, FunctionName string
+	Body, Language, ReturnType, Enabled, Columns         string
+	Type, Args                                           int
+	Security, Configured, HasWhen                        bool
+}
+
+func joint125ActualWrapperTuple(t *testing.T, db *sql.DB, table, trigger string) joint125WrapperTuple {
+	t.Helper()
+	var out joint125WrapperTuple
+	query := `SELECT c.oid,t.oid,p.oid,n.nspname,c.relname,f.nspname,p.proname,p.prosrc,l.lanname,p.prorettype::regtype::text,
+	 t.tgenabled,t.tgattr::text,t.tgtype,t.tgnargs,p.prosecdef,p.proconfig IS NOT NULL,t.tgqual IS NOT NULL
+	 FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace
+	 JOIN pg_proc p ON p.oid=t.tgfoid JOIN pg_namespace f ON f.oid=p.pronamespace JOIN pg_language l ON l.oid=p.prolang
+	 WHERE n.nspname=current_schema() AND c.relname=$1 AND t.tgname=$2 AND NOT t.tgisinternal`
+	require.NoError(t, db.QueryRow(query, table, trigger).Scan(&out.TableOID, &out.TriggerOID, &out.FunctionOID,
+		&out.TableSchema, &out.TableName, &out.FunctionSchema, &out.FunctionName, &out.Body, &out.Language, &out.ReturnType,
+		&out.Enabled, &out.Columns, &out.Type, &out.Args, &out.Security, &out.Configured, &out.HasWhen))
+	return out
+}
+
+func joint125RequireIssuedBodyWrapper(t *testing.T, db *sql.DB, table, trigger string, spec joint125RepairSpec) joint125WrapperTuple {
+	t.Helper()
+	expected, err := jointExpectedCatalogue("versioned", 168)
+	require.NoError(t, err)
+	descriptor, ok := expected.BodyDescriptors[table]
+	require.True(t, ok)
+	columns, err := jointCatalogueColumns(context.Background(), db, "versioned", table)
+	require.NoError(t, err)
+	known := map[string]bool{}
+	for _, column := range columns {
+		known[column.Name] = true
+	}
+	filtered := jointBodyDescriptor{Key: descriptor.Key}
+	for _, column := range descriptor.Columns {
+		if known[bodyBaseColumn125(column)] {
+			filtered.Columns = append(filtered.Columns, column)
+		}
+	}
+	body, name, err := jointGuardedFunction(spec.FunctionBody, table, trigger, filtered)
+	require.NoError(t, err)
+	actual := joint125ActualWrapperTuple(t, db, table, trigger)
+	require.NotZero(t, actual.TableOID)
+	require.NotZero(t, actual.TriggerOID)
+	require.NotZero(t, actual.FunctionOID)
+	require.Equal(t, actual.TableSchema, actual.FunctionSchema)
+	require.Equal(t, table, actual.TableName)
+	require.Equal(t, name, actual.FunctionName)
+	// The real installer adds exactly one space around the complete function
+	// body. No tokenContains/regex/semantic projection establishes this witness.
+	require.Equal(t, " "+body+" ", actual.Body)
+	require.Equal(t, "plpgsql", actual.Language)
+	require.Equal(t, "trigger", actual.ReturnType)
+	require.Equal(t, "O", actual.Enabled)
+	require.Equal(t, 31, actual.Type)
+	require.Zero(t, actual.Args)
+	require.Empty(t, actual.Columns)
+	require.False(t, actual.Security)
+	require.False(t, actual.Configured)
+	require.False(t, actual.HasWhen)
+	return actual
+}
+
+func bodyBaseColumn125(field string) string {
+	for i := range field {
+		if field[i] == '.' {
+			return field[:i]
+		}
+	}
+	return field
+}
+
+func joint125RequireOnlyTargetExclusiveLock(t *testing.T, db *sql.DB, root string, embeddings uint32, other []uint32) {
+	t.Helper()
+	body, err := os.ReadFile(filepath.Join(root, "migrations/pending/joint_125_guard_repair/versioned/000169_nextcloud_local_embedding_guard_repair.up.sql"))
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	tx, err := db.BeginTx(ctx, nil)
+	require.NoError(t, err)
+	defer func() { _ = tx.Rollback() }()
+	_, err = tx.ExecContext(ctx, string(body))
+	require.NoError(t, err)
+	var pid int
+	require.NoError(t, tx.QueryRowContext(ctx, "SELECT pg_backend_pid()").Scan(&pid))
+	var target int
+	require.NoError(t, tx.QueryRowContext(ctx, `SELECT count(*) FROM pg_locks WHERE pid=$1 AND relation=$2 AND locktype='relation' AND mode='AccessExclusiveLock' AND granted`, pid, embeddings).Scan(&target))
+	require.Equal(t, 1, target, "pending169 must lock the actual local embeddings OID")
+	for _, oid := range other {
+		var count int
+		require.NoError(t, tx.QueryRowContext(ctx, `SELECT count(*) FROM pg_locks WHERE pid=$1 AND relation=$2 AND locktype='relation'`, pid, oid).Scan(&count))
+		require.Zero(t, count, "169 must not lock unrelated known body tables or foreign embeddings")
+	}
+	require.NoError(t, tx.Commit())
+}
+
+func TestPostgresJoint125BareTargetWithIssuedBodyWrappersActual(t *testing.T) {
+	for _, mode := range []string{"known_wrappers_coexist", "only_local_target_locked", "other_table_wrapper_bound_to_embeddings", "foreign_wrapper_oid", "changed_canonical_function"} {
+		t.Run(mode, func(t *testing.T) {
+			db, root := joint125ActualFixture(t, true)
+			schema, foreign := joint125ForeignFixture(t, db)
+			foreignBefore := joint125ForeignFingerprint(t, db, foreign)
+			var spec joint125RepairSpec
+			require.NoError(t, json.Unmarshal(joint125RepairSpecJSON, &spec))
+			beforeTarget := joint125ActualWrapperTuple(t, db, "embeddings", "nextcloud_indexed_embedding_guard")
+			require.Equal(t, "nextcloud_indexed_withdrawal_write_guard", beforeTarget.FunctionName)
+			require.Equal(t, spec.FunctionBody, beforeTarget.Body)
+			// This actual fixture owns a lib/pq pool. Naming its real driver avoids
+			// GORM ColumnTypes injecting a pgx-only query-mode value as a SQL parameter.
+			require.IsType(t, &pq.Driver{}, db.Driver())
+			owned, err := gorm.Open(postgres.New(postgres.Config{DriverName: "postgres", Conn: db}), &gorm.Config{Logger: gormlogger.Discard, DisableAutomaticPing: true})
+			require.NoError(t, err)
+			// The real current production installer issues these wrappers; no test
+			// mints an embeddings descriptor or calls it a valid body capability.
+			require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(owned))
+			knowledge := joint125RequireIssuedBodyWrapper(t, db, "knowledges", "nextcloud_indexed_knowledge_guard", spec)
+			chunk := joint125RequireIssuedBodyWrapper(t, db, "chunks", "nextcloud_indexed_chunk_guard", spec)
+			afterTarget := joint125ActualWrapperTuple(t, db, "embeddings", "nextcloud_indexed_embedding_guard")
+			require.Equal(t, beforeTarget, afterTarget, "installer leaves the actual embeddings bare guard and canonical function unchanged")
+			var canonical string
+			require.NoError(t, db.QueryRow(`SELECT p.prosrc FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname=current_schema() AND p.proname='nextcloud_indexed_withdrawal_write_guard' AND p.pronargs=0`).Scan(&canonical))
+			require.Equal(t, spec.FunctionBody, canonical)
+			_, err = db.Exec("INSERT INTO embeddings(source_id,source_type,knowledge_base_id,dimension,content) VALUES('owned-body-coexist',1,NULL,2,'native payload preserved')")
+			require.NoError(t, err)
+			var dataBefore string
+			require.NoError(t, db.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&dataBefore))
+			switch mode {
+			case "other_table_wrapper_bound_to_embeddings":
+				_, err = db.Exec("DROP TRIGGER nextcloud_indexed_embedding_guard ON embeddings")
+				require.NoError(t, err)
+				_, err = db.Exec("CREATE TRIGGER nextcloud_indexed_embedding_guard BEFORE INSERT OR UPDATE OR DELETE ON embeddings FOR EACH ROW EXECUTE FUNCTION " + jointIdentifierQuoted(schema) + "." + jointIdentifierQuoted(knowledge.FunctionName) + "()")
+			case "foreign_wrapper_oid":
+				_, err = db.Exec("CREATE FUNCTION " + jointIdentifierQuoted(foreign) + "." + jointIdentifierQuoted(knowledge.FunctionName) + "() RETURNS trigger LANGUAGE plpgsql AS $owned_wrapper$" + knowledge.Body + "$owned_wrapper$")
+				require.NoError(t, err)
+				_, err = db.Exec("DROP TRIGGER nextcloud_indexed_embedding_guard ON embeddings")
+				require.NoError(t, err)
+				_, err = db.Exec("CREATE TRIGGER nextcloud_indexed_embedding_guard BEFORE INSERT OR UPDATE OR DELETE ON embeddings FOR EACH ROW EXECUTE FUNCTION " + jointIdentifierQuoted(foreign) + "." + jointIdentifierQuoted(knowledge.FunctionName) + "()")
+			case "changed_canonical_function":
+				_, err = db.Exec("CREATE OR REPLACE FUNCTION nextcloud_indexed_withdrawal_write_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$")
+			}
+			require.NoError(t, err)
+			before := memoryFullSchemaSnapshot(t, db, "versioned")
+			decision, inspectErr := inspectJoint125LocalRepair(context.Background(), db)
+			positive := mode == "known_wrappers_coexist" || mode == "only_local_target_locked"
+			if positive {
+				require.NoError(t, inspectErr)
+				require.Equal(t, joint125GuardCurrent, decision.state)
+				require.Equal(t, beforeTarget.TableOID, decision.tableOID)
+				require.Equal(t, beforeTarget.FunctionOID, decision.functionOID)
+				if mode == "only_local_target_locked" {
+					var foreignOID uint32
+					require.NoError(t, db.QueryRow(`SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=$1 AND c.relname='embeddings'`, foreign).Scan(&foreignOID))
+					joint125RequireOnlyTargetExclusiveLock(t, db, root, decision.tableOID, []uint32{knowledge.TableOID, chunk.TableOID, foreignOID})
+				} else {
+					require.NoError(t, joint125ExecuteComponent(t, db, root, false))
+				}
+				require.Equal(t, beforeTarget, joint125ActualWrapperTuple(t, db, "embeddings", "nextcloud_indexed_embedding_guard"))
+			} else {
+				require.ErrorIs(t, inspectErr, ErrJointSchemaUnknown)
+				require.ErrorContains(t, joint125ExecuteComponent(t, db, root, false), "joint_125_local_guard_unknown")
+			}
+			require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "versioned"), "169 does not degrade or repair unrelated wrappers or unknown bindings")
+			require.Equal(t, knowledge, joint125ActualWrapperTuple(t, db, "knowledges", "nextcloud_indexed_knowledge_guard"))
+			require.Equal(t, chunk, joint125ActualWrapperTuple(t, db, "chunks", "nextcloud_indexed_chunk_guard"))
+			require.Equal(t, foreignBefore, joint125ForeignFingerprint(t, db, foreign))
+			var dataAfter string
+			require.NoError(t, db.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&dataAfter))
+			require.Equal(t, dataBefore, dataAfter)
+			version, dirty := jointLineageMigrationState(t, db)
+			require.EqualValues(t, 168, version)
+			require.False(t, dirty, "component execution is not a forward-route ledger")
+		})
+	}
+}
