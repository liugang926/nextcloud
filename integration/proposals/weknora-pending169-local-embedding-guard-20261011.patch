@@ -0,0 +1,180 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+	_ "embed"
+	"encoding/json"
+	"reflect"
+)
+
+// This private decision is only a read-only bootstrap eligibility observation.
+// It grants neither source access nor original authoring. The pending 169 SQL
+// repeats the complete catalogue checks after locking the actual local table.
+// Production route selection must bind the complete source and known ledger
+// lineage before it can use this decision; that integration is a separate gate.
+type joint125RepairState uint8
+
+const (
+	joint125OptionalAbsent joint125RepairState = iota + 1
+	joint125GuardCurrent
+	joint125GuardMissing
+)
+
+type joint125RepairDecision struct {
+	state                 joint125RepairState
+	schema                string
+	tableOID, functionOID uint32
+}
+
+type joint125CatalogueReader interface {
+	QueryRowContext(context.Context, string, ...interface{}) *sql.Row
+	QueryContext(context.Context, string, ...interface{}) (*sql.Rows, error)
+}
+
+//go:embed migration_joint_125_repair_spec.json
+var joint125RepairSpecJSON []byte
+
+type joint125RepairColumn struct {
+	Name, Type, Default string
+	NotNull             bool
+}
+type joint125RepairSpec struct {
+	Root125SHA256, Embedding2SHA256, Embedding7SHA256 string
+	FunctionBody                                      string
+	Columns                                           []joint125RepairColumn
+}
+
+func inspectJoint125LocalRepair(ctx context.Context, db joint125CatalogueReader) (joint125RepairDecision, error) {
+	var out joint125RepairDecision
+	if err := ctx.Err(); err != nil {
+		return out, err
+	}
+	var spec joint125RepairSpec
+	if json.Unmarshal(joint125RepairSpecJSON, &spec) != nil || spec.FunctionBody == "" || len(spec.Columns) != 13 {
+		return out, ErrJointSchemaSourceIdentity
+	}
+	var body, language, returns string
+	var args int
+	var security, configured, owner bool
+	query := `SELECT n.nspname,p.oid,p.prosrc,l.lanname,p.prorettype::regtype::text,p.pronargs,p.prosecdef,p.proconfig IS NOT NULL,pg_has_role(current_user,p.proowner,'USAGE')
+	 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace JOIN pg_language l ON l.oid=p.prolang
+	 WHERE n.nspname=current_schema() AND p.proname='nextcloud_indexed_withdrawal_write_guard' AND p.pronargs=0`
+	if db.QueryRowContext(ctx, query).Scan(&out.schema, &out.functionOID, &body, &language, &returns, &args, &security, &configured, &owner) != nil {
+		return out, ErrJointSchemaUnknown
+	}
+	if body != spec.FunctionBody || language != "plpgsql" || returns != "trigger" || args != 0 || security || configured || !owner {
+		return out, ErrJointSchemaUnknown
+	}
+	var oid sql.NullInt64
+	tableErr := db.QueryRowContext(ctx, `SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=current_schema() AND c.relname='embeddings'`).Scan(&oid)
+	if tableErr == sql.ErrNoRows {
+		out.state = joint125OptionalAbsent
+		return finishJoint125RepairObservation(ctx, db, out, spec.FunctionBody)
+	}
+	if tableErr != nil {
+		if err := ctx.Err(); err != nil {
+			return out, err
+		}
+		return out, ErrJointSchemaUnavailable
+	}
+	if !oid.Valid || oid.Int64 <= 0 {
+		return out, ErrJointSchemaUnknown
+	}
+	out.tableOID = uint32(oid.Int64)
+	var kind string
+	var inherited, tableOwner bool
+	if db.QueryRowContext(ctx, `SELECT c.relkind::text,EXISTS(SELECT 1 FROM pg_inherits WHERE inhrelid=c.oid OR inhparent=c.oid),pg_has_role(current_user,c.relowner,'USAGE') FROM pg_class c WHERE c.oid=$1`, out.tableOID).Scan(&kind, &inherited, &tableOwner) != nil || kind != "r" || inherited || !tableOwner {
+		return out, ErrJointSchemaUnknown
+	}
+	rows, err := db.QueryContext(ctx, `SELECT a.attname,format_type(a.atttypid,a.atttypmod),a.attnotnull,CASE WHEN a.attname='id' THEN 'SERIAL' ELSE COALESCE(pg_get_expr(d.adbin,d.adrelid),'') END,a.attidentity::text,a.attgenerated::text
+	 FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attrelid=$1 AND a.attnum>0 AND NOT a.attisdropped ORDER BY a.attnum`, out.tableOID)
+	if err != nil {
+		return out, ErrJointSchemaUnavailable
+	}
+	actual := []joint125RepairColumn{}
+	for rows.Next() {
+		var column joint125RepairColumn
+		var identity, generated string
+		if rows.Scan(&column.Name, &column.Type, &column.NotNull, &column.Default, &identity, &generated) != nil {
+			rows.Close()
+			return out, ErrJointSchemaUnavailable
+		}
+		if identity != "" || generated != "" {
+			rows.Close()
+			return out, ErrJointSchemaUnknown
+		}
+		actual = append(actual, column)
+	}
+	rowErr, closeErr := rows.Err(), rows.Close()
+	if rowErr != nil || closeErr != nil {
+		return out, ErrJointSchemaUnavailable
+	}
+	if !reflect.DeepEqual(actual, spec.Columns) {
+		return out, ErrJointSchemaUnknown
+	}
+	var serial, primary, unique, halfvec bool
+	if db.QueryRowContext(ctx, joint125HalfvecIdentitySQL, out.tableOID).Scan(&halfvec) != nil || !halfvec {
+		return out, ErrJointSchemaUnknown
+	}
+	if db.QueryRowContext(ctx, joint125SerialIdentitySQL, out.tableOID).Scan(&serial) != nil || !serial {
+		return out, ErrJointSchemaUnknown
+	}
+	if db.QueryRowContext(ctx, `SELECT count(*)=1 AND count(*) FILTER(WHERE contype='p' AND conkey::text='{1}' AND convalidated AND NOT condeferrable AND NOT condeferred)=1 FROM pg_constraint WHERE conrelid=$1`, out.tableOID).Scan(&primary) != nil || !primary {
+		return out, ErrJointSchemaUnknown
+	}
+	if db.QueryRowContext(ctx, joint125UniqueIdentitySQL, out.tableOID).Scan(&unique) != nil || !unique {
+		return out, ErrJointSchemaUnknown
+	}
+	var count int
+	if db.QueryRowContext(ctx, `SELECT count(*) FROM pg_trigger WHERE tgrelid=$1 AND NOT tgisinternal`, out.tableOID).Scan(&count) != nil {
+		return out, ErrJointSchemaUnavailable
+	}
+	if count == 0 {
+		out.state = joint125GuardMissing
+		return finishJoint125RepairObservation(ctx, db, out, spec.FunctionBody)
+	}
+	if count != 1 {
+		return out, ErrJointSchemaUnknown
+	}
+	var current bool
+	if db.QueryRowContext(ctx, `SELECT count(*)=1 FROM pg_trigger WHERE tgrelid=$1 AND NOT tgisinternal AND tgname='nextcloud_indexed_embedding_guard' AND tgfoid=$2 AND tgtype=31 AND tgenabled='O' AND tgnargs=0 AND tgqual IS NULL AND tgattr::text='' AND tgconstraint=0`, out.tableOID, out.functionOID).Scan(&current) != nil || !current {
+		return out, ErrJointSchemaUnknown
+	}
+	out.state = joint125GuardCurrent
+	return finishJoint125RepairObservation(ctx, db, out, spec.FunctionBody)
+}
+
+func finishJoint125RepairObservation(ctx context.Context, db joint125CatalogueReader, out joint125RepairDecision, body string) (joint125RepairDecision, error) {
+	var current bool
+	query := `SELECT count(*)=1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace JOIN pg_language l ON l.oid=p.prolang
+	 WHERE p.oid=$1 AND n.nspname=$2 AND n.nspname=current_schema() AND p.proname='nextcloud_indexed_withdrawal_write_guard' AND p.prosrc=$3
+	 AND l.lanname='plpgsql' AND p.prorettype='trigger'::regtype AND p.pronargs=0 AND NOT p.prosecdef AND p.proconfig IS NULL AND pg_has_role(current_user,p.proowner,'USAGE')`
+	if db.QueryRowContext(ctx, query, out.functionOID, out.schema, body).Scan(&current) != nil || !current {
+		if err := ctx.Err(); err != nil {
+			return out, err
+		}
+		return out, ErrJointSchemaUnknown
+	}
+	return out, ctx.Err()
+}
+
+const joint125SerialIdentitySQL = `SELECT EXISTS(
+ SELECT 1 FROM pg_attrdef d JOIN pg_depend x ON x.classid='pg_attrdef'::regclass AND x.objid=d.oid AND x.deptype='n'
+ JOIN pg_class s ON s.oid=x.refobjid AND x.refclassid='pg_class'::regclass JOIN pg_namespace sn ON sn.oid=s.relnamespace
+ JOIN pg_depend own ON own.classid='pg_class'::regclass AND own.objid=s.oid AND own.refclassid='pg_class'::regclass AND own.refobjid=d.adrelid AND own.refobjsubid=1 AND own.deptype='a'
+ WHERE d.adrelid=$1 AND d.adnum=1 AND s.relkind='S' AND sn.nspname=current_schema() AND s.relname='embeddings_id_seq'
+ AND pg_get_expr(d.adbin,d.adrelid) IN ('nextval(''embeddings_id_seq''::regclass)',format('nextval(%L::regclass)',format('%I.%I',sn.nspname,s.relname))))`
+
+const joint125UniqueIdentitySQL = `SELECT EXISTS(
+ SELECT 1 FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_am a ON a.oid=c.relam
+ WHERE i.indrelid=$1 AND n.nspname=current_schema() AND c.relname='embeddings_unique_source' AND a.amname='btree'
+ AND i.indisunique AND i.indisvalid AND i.indisready AND i.indnkeyatts=2 AND i.indnatts=2 AND i.indkey::text='4 5' AND i.indoption::text='0 0' AND i.indexprs IS NULL AND i.indpred IS NULL
+ AND i.indclass[0]=(SELECT o.oid FROM pg_opclass o JOIN pg_namespace n ON n.oid=o.opcnamespace WHERE n.nspname='pg_catalog' AND o.opcname='text_ops' AND o.opcmethod=c.relam)
+ AND i.indclass[1]=(SELECT o.oid FROM pg_opclass o JOIN pg_namespace n ON n.oid=o.opcnamespace WHERE n.nspname='pg_catalog' AND o.opcname='int4_ops' AND o.opcmethod=c.relam)
+ AND i.indcollation[0]=(SELECT oid FROM pg_collation WHERE collname='default' AND collnamespace='pg_catalog'::regnamespace) AND i.indcollation[1]=0)`
+
+const joint125HalfvecIdentitySQL = `SELECT EXISTS(
+ SELECT 1 FROM pg_attribute a JOIN pg_type t ON t.oid=a.atttypid JOIN pg_depend d ON d.classid='pg_type'::regclass AND d.objid=t.oid AND d.refclassid='pg_extension'::regclass AND d.deptype='e'
+ JOIN pg_extension e ON e.oid=d.refobjid WHERE a.attrelid=$1 AND a.attnum=11 AND a.attndims=0 AND a.attcollation=0
+ AND t.typname='halfvec' AND t.typtype='b' AND t.typisdefined AND t.typnamespace=e.extnamespace AND e.extname='vector')`
