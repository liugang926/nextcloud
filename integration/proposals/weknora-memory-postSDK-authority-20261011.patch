@@ -0,0 +1,10 @@
+package interfaces
+
+import "context"
+
+// A successful SDK return is not a grant or a completion receipt. The actual
+// admission repository verifies held immutable inputs/execution and current
+// authority in one transaction before the result can be consumed or committed.
+type MemoryOriginalPostModelVerifier interface {
+	VerifyMemoryOriginalPostModel(ctx context.Context, inputID, inputDigest, executionID, executionDigest, workerLeaseID string) error
+}
