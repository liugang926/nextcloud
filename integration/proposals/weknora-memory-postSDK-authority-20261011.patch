+func (s *Service) verifyMemoryOriginalPostModel(ctx context.Context) error {
+	owner := memoryOriginalOwnerFromContext(ctx)
+	control, _ := ctx.Value(memoryExecutionControlKey{}).(*memoryExecutionControl)
+	if owner == nil || owner.input == nil || control == nil || control.original == nil || control.workerLeaseID == "" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	verifier, ok := s.admissions.(interfaces.MemoryOriginalPostModelVerifier)
+	if !ok {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return verifier.VerifyMemoryOriginalPostModel(ctx, owner.input.ID, owner.input.Digest, control.original.ID, control.original.Digest, control.workerLeaseID)
+}
