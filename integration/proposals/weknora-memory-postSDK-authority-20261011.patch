+package repository
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+type memoryPostModelTransactionKey struct{}
+type memoryPostModelTransactionObservation struct{ pool gorm.ConnPool }
+
+// Read-only observation of an actual private verification transaction. This
+// accessor cannot create its token, acquire authority or fabricate an SQL fact.
+func MemoryOriginalPostModelTransactionObserved(tx *gorm.DB) bool {
+	if tx == nil || tx.Statement == nil || tx.Statement.Context == nil {
+		return false
+	}
+	owned, ok := tx.Statement.Context.Value(memoryPostModelTransactionKey{}).(memoryPostModelTransactionObservation)
+	_, actualTx := tx.Statement.ConnPool.(gorm.TxCommitter)
+	return ok && actualTx && owned.pool == tx.Statement.ConnPool
+}
+
+func (r *memoryOriginalAdmissionRepository) VerifyMemoryOriginalPostModel(ctx context.Context, inputID, inputDigest, executionID, executionDigest, workerLeaseID string) error {
+	if r == nil || r.db == nil || r.authorityFactory == nil || ctx == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if inputID == "" || inputDigest == "" || executionID == "" || executionDigest == "" || workerLeaseID == "" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	hold, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if hold == nil || hold.Historical || hold.Manifest.Digest == "" || hold.Manifest.TenantID == 0 || hold.Manifest.SubjectID == "" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	scope := interfaces.MemoryScope{TenantID: hold.Manifest.TenantID, SubjectID: hold.Manifest.SubjectID}
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		marked := context.WithValue(ctx, memoryPostModelTransactionKey{}, memoryPostModelTransactionObservation{pool: tx.Statement.ConnPool})
+		tx = tx.Session(&gorm.Session{NewDB: true, Context: marked})
+		// Reserve the actual SQLite writer before reads so concurrent lease
+		// renewals cannot invalidate this transaction's read-to-write snapshot.
+		// Identity comes from the actual private derived hold, never a raw row.
+		if tx.Dialector.Name() == "sqlite" {
+			if err := tx.Exec("UPDATE memory_subjects SET updated_at=updated_at WHERE tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Error; err != nil {
+				return err
+			}
+		}
+		input, err := loadMemoryOriginal(tx, inputID)
+		if err != nil {
+			return err
+		}
+		q := input.Request
+		if input.ID != inputID || input.Digest != inputDigest || q.TenantID != scope.TenantID || q.SubjectID != scope.SubjectID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var subject types.MemorySubject
+		if err = tx.Clauses(forUpdateClause()).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Take(&subject).Error; err != nil {
+			return err
+		}
+		if !subject.Enabled || !validExtractionLease(&subject, workerLeaseID) {
+			return types.ErrMemoryExtractionLeaseLost
+		}
+		progress, err := memoryOriginalProgress(tx.Clauses(forUpdateClause()), scope, q.SessionID)
+		if err != nil {
+			return err
+		}
+		if progress == nil || !progress.Pending || progress.OriginalAdmissionID != inputID || progress.Revision != q.PendingRevision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		// Same lock order and authority path as CommitMemoryOriginalResult.
+		if err = r.lockMemoryDerivedAuthorityInTx(marked, tx, hold, input); err != nil {
+			return err
+		}
+		if err = r.lockMemoryOriginalFence(marked, tx, input); err != nil {
+			return err
+		}
+		if err = r.checkMemoryOriginalInTx(marked, tx, input); err != nil {
+			return err
+		}
+		execution, err := loadMemoryExecution(tx, executionID, executionDigest)
+		if err != nil {
+			return err
+		}
+		if err = checkMemoryExecutionInTx(tx, input, execution); err != nil {
+			return err
+		}
+		if execution.DerivedInputsDigest != hold.Manifest.Digest {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = r.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		// No facts/effects/cursor/receipt are written. All native/body/journal,
+		// actor/source/model/policy IO precedes the one final captured union.
+		if err = checkMemoryWorkerFinalClockInTx(marked, tx); err != nil {
+			return err
+		}
+		if !validExtractionLease(&subject, workerLeaseID) {
+			return types.ErrMemoryExtractionLeaseLost
+		}
+		return marked.Err()
+	}, memoryWriteOptions(r.db))
+}
