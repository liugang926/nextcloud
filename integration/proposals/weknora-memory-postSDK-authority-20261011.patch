diff --git a/internal/application/service/memory_post_model_authority_sql_actual_test.go b/internal/application/service/memory_post_model_authority_sql_actual_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4121d4a1ef008e84ece0c2655ada63dd7283c396
--- /dev/null
+++ b/internal/application/service/memory_post_model_authority_sql_actual_test.go
@@ -0,0 +1,207 @@
+package service
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// The existing genuine producer fixture authors model/policy/message originals,
+// Schedule commits admission+intent, and the actual relay emits the task. Only
+// the SDK transport is bounded. No test creates a proof, execution or receipt.
+func runMemoryPostModelAuthoritySQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"current", "actor_after_sdk", "model_after_sdk", "late_actual_model_lease_expiry"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			relayMemAtomicSQLScheduled(t, f)
+			faultApplied, readback := false, false
+			if mode == "actor_after_sdk" || mode == "model_after_sdk" {
+				f.model.afterCall = func() error {
+					clean := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx})
+					if mode == "actor_after_sdk" {
+						id := types.CallerFromContext(f.ctx).UserID
+						result := clean.Model(&types.User{}).Where("id=? AND is_active=?", id, true).Update("is_active", false)
+						if result.Error != nil {
+							return result.Error
+						}
+						if result.RowsAffected != 1 {
+							return fmt.Errorf("actual actor fault changed no row")
+						}
+						faultApplied = true
+						var user types.User
+						if err := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Where("id=?", id).Take(&user).Error; err != nil {
+							return err
+						}
+						readback = !user.IsActive
+					} else {
+						id := f.model.GetModelID()
+						result := clean.Model(&types.Model{}).Where("id=? AND status=?", id, types.ModelStatusActive).Update("status", types.ModelStatusDownloadFailed)
+						if result.Error != nil {
+							return result.Error
+						}
+						if result.RowsAffected != 1 {
+							return fmt.Errorf("actual model fault changed no row")
+						}
+						faultApplied = true
+						var model types.Model
+						if err := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Where("id=?", id).Take(&model).Error; err != nil {
+							return err
+						}
+						readback = model.Status == types.ModelStatusDownloadFailed
+					}
+					if !readback {
+						return fmt.Errorf("actual post-SDK fault readback failed")
+					}
+					return nil
+				}
+			}
+			postReads, finalBefore, finalAfter := 0, false, false
+			reachedActualExpiry := false
+			var target string
+			var expiry int64
+			fresh := func(tx *gorm.DB) *gorm.DB {
+				return tx.Session(&gorm.Session{NewDB: true, Context: tx.Statement.Context})
+			}
+			clock := func(tx *gorm.DB) (int64, error) {
+				query := "SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)"
+				if pg {
+					query = "SELECT CAST(EXTRACT(EPOCH FROM clock_timestamp())*1000 AS BIGINT)"
+				}
+				var now int64
+				err := fresh(tx).Raw(query).Scan(&now).Error
+				return now, err
+			}
+			isFinal := func(tx *gorm.DB) bool {
+				value, ok := tx.Statement.Settings.Load("memory:final_lease_clock_union")
+				return repository.MemoryOriginalPostModelTransactionObserved(tx) && ok && value == true && tx.Statement.Table == "original_body_leases"
+			}
+			name := "test:actual-post-model-authority"
+			require.NoError(t, f.db.Callback().Query().Before("gorm:query").Register(name+"-before", func(tx *gorm.DB) {
+				if repository.MemoryOriginalPostModelTransactionObserved(tx) && tx.Statement.Table == "memory_original_admissions" {
+					postReads++
+				}
+				if !isFinal(tx) || finalBefore {
+					return
+				}
+				finalBefore = true
+				if mode != "late_actual_model_lease_expiry" {
+					return
+				}
+				ids, err := repository.ModelOriginalLeaseIDs(tx.Statement.Context)
+				if err != nil {
+					tx.AddError(err)
+					return
+				}
+				if len(ids) != 2 {
+					tx.AddError(fmt.Errorf("actual model did not hold its two original leases"))
+					return
+				}
+				target = ids[0]
+				now, err := clock(tx)
+				if err != nil {
+					tx.AddError(err)
+					return
+				}
+				expiry = now + 25
+				// Fresh statements, exact genuinely acquired ID, real SQL CAS,
+				// and independent same-TX readback precede the actual deadline.
+				result := fresh(tx).Table("original_body_leases").Where("lease_id=? AND kind='read' AND released_at_ms IS NULL", target).Update("expires_at_ms", expiry)
+				if result.Error != nil {
+					tx.AddError(result.Error)
+					return
+				}
+				if result.RowsAffected != 1 {
+					tx.AddError(fmt.Errorf("actual lease expiry CAS changed no row"))
+					return
+				}
+				faultApplied = true
+				var actual struct {
+					LeaseID     string
+					ExpiresAtMS int64
+				}
+				if err = fresh(tx).Table("original_body_leases").Select("lease_id,expires_at_ms").Where("lease_id=?", target).Take(&actual).Error; err != nil {
+					tx.AddError(err)
+					return
+				}
+				readback = actual.LeaseID == target && actual.ExpiresAtMS == expiry
+				if !readback {
+					tx.AddError(fmt.Errorf("actual lease expiry readback mismatch"))
+				}
+			}))
+			require.NoError(t, f.db.Callback().Query().After("gorm:query").Register(name+"-after", func(tx *gorm.DB) {
+				if !isFinal(tx) || finalAfter || tx.Error != nil {
+					return
+				}
+				finalAfter = true
+				if mode != "late_actual_model_lease_expiry" {
+					return
+				}
+				// Actual database clock crosses the read-back deadline. No
+				// clock replacement or earlier SDK callback expiry is used.
+				for {
+					if err := tx.Statement.Context.Err(); err != nil {
+						tx.AddError(err)
+						return
+					}
+					now, err := clock(tx)
+					if err != nil {
+						tx.AddError(err)
+						return
+					}
+					if now >= expiry {
+						reachedActualExpiry = true
+						return
+					}
+				}
+			}))
+			t.Cleanup(func() {
+				if err := f.db.Callback().Query().Remove(name + "-before"); err != nil {
+					t.Error(err)
+				}
+				if err := f.db.Callback().Query().Remove(name + "-after"); err != nil {
+					t.Error(err)
+				}
+			})
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			err := f.service.Handle(ctx, f.queue.task)
+			cancel()
+			require.Equal(t, 1, f.model.calls)
+			require.Positive(t, postReads, "a genuine private, same-pool authority transaction must follow the SDK return")
+			if mode == "current" {
+				require.True(t, finalBefore)
+				require.True(t, finalAfter)
+				require.NoError(t, err)
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+				after := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+				require.False(t, after.Pending)
+				require.True(t, after.Cursor.After(before.Cursor))
+			} else {
+				require.True(t, faultApplied)
+				require.True(t, readback)
+				if mode == "late_actual_model_lease_expiry" {
+					require.NotEmpty(t, target)
+					require.Positive(t, expiry)
+					require.True(t, finalBefore)
+					require.True(t, finalAfter)
+					require.True(t, reachedActualExpiry, "actual SQL clock must cross the read-back acquired lease expiry before refusal")
+				}
+				require.Error(t, err)
+				assertMemAtomicSQLNoEffects(t, f, before)
+			}
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryPostModelAuthorityActualSQLite(t *testing.T) { runMemoryPostModelAuthoritySQL(t, false) }
+func TestPostgresMemoryPostModelAuthorityActual(t *testing.T) {
+	runMemoryPostModelAuthoritySQL(t, true)
+}
