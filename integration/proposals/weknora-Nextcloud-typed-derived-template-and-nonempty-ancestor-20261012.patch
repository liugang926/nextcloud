+					defer ticker.Stop()
+					for {
+						if e := tx.Session(&gorm.Session{NewDB: true, Context: tx.Statement.Context}).Raw("SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)").Scan(&now).Error; e != nil {
+							fail(e)
+							return
+						}
+						if now >= expiry {
+							reachedExpiry.Store(true)
+							return
+						}
+						select {
+						case <-tx.Statement.Context.Done():
+							fail(tx.Statement.Context.Err())
+							return
+						case <-ticker.C:
+						}
+					}
+				}))
+				t.Cleanup(func() {
+					if e := f.db.Callback().Row().Remove(clockObserver); e != nil {
+						t.Error(e)
+					}
+				})
+			}
+			negative := mode != "published_A_derived_template_B_native_save"
+			indexErr := ownedAncestorWriteIndex(t, m, b, models, &negative)
+			if negative {
+				require.True(t, faultApplied.Load())
+				require.Error(t, indexErr)
+				if mode == "ancestor_content_last_SQL_clock" {
+					require.True(t, reachedExpiry.Load())
+				}
+			} else {
+				require.NoError(t, indexErr)
+			}
+			require.EqualValues(t, 2, calls.Load())
+			mu.Lock()
+			actualWire := append([][]string(nil), transmitted...)
+			observed := callbackErr
+			mu.Unlock()
+			require.NoError(t, observed)
+			require.Equal(t, [][]string{a.wire, b.wire}, actualWire)
+			var aReceipts, bReceipts, bVectors int64
+			require.NoError(t, f.db.Table("knowledge_sqlite_embedding_receipts").Where("knowledge_id=?", aKnowledge.ID).Count(&aReceipts).Error)
+			require.NoError(t, f.db.Table("knowledge_sqlite_embedding_receipts").Where("knowledge_id=?", bKnowledge.ID).Count(&bReceipts).Error)
+			require.NoError(t, f.db.Table("knowledge_sqlite_embedding_vectors v").Joins("JOIN lite_embeddings e ON e.id=v.row_id").Where("e.source_id IN ?", func() []string {
+				ids := []string{}
+				for _, c := range b.chunks {
+					ids = append(ids, c.ID)
+				}
+				return ids
+			}()).Count(&bVectors).Error)
+			require.EqualValues(t, len(a.chunks), aReceipts)
+			if negative {
+				require.Zero(t, bReceipts)
+				require.Zero(t, bVectors)
+			} else {
+				require.EqualValues(t, len(b.chunks), bReceipts)
+				require.EqualValues(t, len(b.chunks), bVectors)
+				require.NoError(t, b.read.Recheck())
+			}
+			require.NoError(t, b.read.Close())
+			b.closed = true
+			require.NoError(t, a.read.Close())
+			a.closed = true
+			var live, usersAfter, membersAfter int64
+			require.NoError(t, f.db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&live).Error)
+			require.Zero(t, live)
+			require.NoError(t, f.db.Model(&types.User{}).Count(&usersAfter).Error)
+			require.NoError(t, f.db.Model(&types.TenantMember{}).Count(&membersAfter).Error)
+			require.Equal(t, usersBefore, usersAfter)
+			require.Equal(t, membersBefore, membersAfter)
+			require.Positive(t, sourceRequests.Load())
+			require.NoError(t, sourceErr())
+		})
+	}
+}
