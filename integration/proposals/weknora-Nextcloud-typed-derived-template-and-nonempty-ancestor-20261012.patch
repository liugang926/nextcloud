+)
+
+// UpdateKnowledgeBaseFromOriginalNextcloudBuild is a deterministic configuration
+// producer under an actual original upload/build holder. It preserves every
+// authentic source input and adds no machine configuration-authoring purpose.
+// The target is a separately authored template, not the source's own config.
+func (s *KnowledgeInputProvenanceStore) UpdateKnowledgeBaseFromOriginalNextcloudBuild(ctx context.Context, kb *types.KnowledgeBase) (err error) {
+	if s == nil || s.db == nil || ctx == nil || kb == nil || kb.ID == "" || ctx.Err() != nil {
+		return ErrKnowledgeInputChanged
+	}
+	r := nextcloudOriginalUploadInContext(ctx)
+	guard, ok := ctx.Value(knowledgeBuildInputKey{}).(knowledgeBuildInputContext)
+	source, actual := guard.reader.(*KnowledgeInputProvenanceStore)
+	proof := guard.proof
+	if r == nil || r.store != s || !ok || !actual || source != s || guard.admission == nil || guard.admission.Err() != nil || proof == nil || !r.authenticatedCaller || proof.TenantID != r.payload.TenantID || proof.KnowledgeBaseID != r.payload.KnowledgeBaseID || proof.KnowledgeID != r.payload.KnowledgeID || proof.BuildGeneration != uint64(r.build.lease.Epoch) || kb.TenantID != r.payload.TenantID || kb.ID == r.payload.KnowledgeBaseID || len(proof.ChunkIDs) != 0 {
+		return ErrKnowledgeInputChanged
+	}
+	if _, nested := s.db.Statement.ConnPool.(gorm.TxCommitter); nested {
+		return ErrKnowledgeInputChanged
+	}
+	if err = r.start(); err != nil {
+		return err
+	}
+	defer func() { err = r.finish(err) }()
+	ownRows := []originalBodyAvailabilityRow{{"knowledges", r.payload.KnowledgeID}}
+	var ownHeads []originalBodyFieldHead
+	ownLeases := map[string]originalBodyLease{}
+	ownPayloads := map[string]originalBodyPayload{}
+	strictPayloads := map[string]bool{}
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := reserveMessageBodyLeaseWriterInTx(tx); err != nil {
+			return err
+		}
+		if err := r.samePool(tx); err != nil {
+			return err
+		}
+		if err := r.checkInTx(tx, true); err != nil {
+			return err
+		}
+		authority, err := knowledgeSQLiteEmbeddingAuthority(tx, s)
+		if err != nil {
+			return err
+		}
+		fresh, err := authority.RefreshCurrentReadActor(ctx)
+		if err != nil {
+			return err
+		}
+		principal, present := types.PrincipalFromContext(fresh)
+		if !present || principal.Type != types.PrincipalWebUser || !sameNextcloudUploadCaller(fresh, ctx) {
+			return ErrNextcloudOnboardingDenied
+		}
+		var old types.KnowledgeBase
+		if err = tx.Where("id=? AND tenant_id=? AND deleted_at IS NULL", kb.ID, kb.TenantID).Take(&old).Error; err != nil {
+			return err
+		}
+		// A's holder cannot authorize or hydrate an unrelated target dependency C.
+		// This narrowly scoped producer requires an authentic independent template.
+		targetLineage, err := nextcloudConfigurationLineageMetadataInTx(tx, &old)
+		if err != nil {
+			return err
+		}
+		if len(targetLineage.Sources) != 0 {
+			return ErrKnowledgeInputChanged
+		}
+		fresh, err = authority.authorizeKnowledgeActorWrite(fresh, &old)
+		if err != nil {
+			return err
+		}
+		// A processing successor's current heads are not granted by the initial
+		// predecessor lease. Capture current metadata, acquire actual new holds,
+		// and check physical/journal availability before the full source snapshot.
+		ownHeads, err = originalBodyBatchHeads(tx, ownRows)
+		if err != nil {
+			return err
+		}
+		if len(ownHeads) == 0 {
+			return ErrOriginalBodyUnavailable
+		}
+		owner := "nextcloud-configuration-current/" + uuid.NewString()
+		for _, head := range ownHeads {
+			id, err := NewOriginalBodyRetentionStore(tx).acquireLeaseInTx(tx, head.BodyID, "read", owner, 15*time.Minute)
+			if err != nil {
+				return err
+			}
+			var lease originalBodyLease
+			if err = bodyInternal(tx).Where("lease_id=?", id).Take(&lease).Error; err != nil {
+				return err
+			}
+			ownLeases[id] = lease
+			var payload originalBodyPayload
+			if err = bodyInternal(tx).Where("id=?", head.BodyID).Take(&payload).Error; err != nil {
+				return err
+			}
+			ownPayloads[head.BodyID] = payload
+			strictPayloads[head.BodyID] = true
+		}
+		if err = checkOriginalBodyAvailableBatchForCapturedInTx(ctx, tx, ownRows, ownHeads); err != nil {
+			return err
+		}
+		if err = r.finalClockWithStrictPayloadsInTx(tx, ownLeases, ownPayloads, strictPayloads); err != nil {
+			return err
+		}
+		// This full source read follows the real holder's original body preflight.
+		// Its admission and immutable material must match the original build proof;
+		// caller-provided lineage never reaches the producer below.
+		snapshot, err := authority.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: proof.TenantID, KnowledgeBaseID: proof.KnowledgeBaseID, KnowledgeID: proof.KnowledgeID, Expected: proof}, false)
+		if err != nil {
+			return err
+		}
+		if snapshot == nil || snapshot.Proof == nil || snapshot.Proof.SourceLineage == nil || snapshot.Proof.SourceLineage.RequireComplete() != nil {
+			return ErrKnowledgeInputChanged
+		}
+		if err = verifyKnowledgeInheritedSources(tx, snapshot.Proof.SourceLineage); err != nil {
+			return err
+		}
+		derived, err := WithDerivedKnowledgeInput(fresh, snapshot.Proof.SourceLineage)
+		if err != nil {
+			return err
+		}
+		// The original public producer executes as a nested transaction on this
+		// exact ConnPool. A final refusal rolls back configuration and its origin.
+		authority.displayAuthorityFactory = s.displayAuthorityFactory
+		if err = authority.UpdateKnowledgeBaseWithInput(derived, kb); err != nil {
+			return err
+		}
+		// All actor/source/body/journal IO precedes this holder's last union clock.
+		if err = guard.admission.Err(); err != nil {
+			return err
+		}
+		if err = r.checkInTx(tx, true); err != nil {
+			return err
+		}
+		// Match writer order and lock the exact current heads until commit. Every
+		// physical/journal operation completes before fresh full payload tuples and
+		// the final SQL clock over original+current body and all content holds.
+		slots := []string{}
+		for _, head := range ownHeads {
+			slots = append(slots, head.SlotID)
+		}
+		sort.Strings(slots)
+		var currentHeads []originalBodyFieldHead
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("slot_id IN ?", slots).Order("slot_id").Find(&currentHeads).Error; err != nil {
+			return err
+		}
+		if !sameOriginalBodyHeads(ownHeads, currentHeads) {
+			return ErrOriginalBodyUnavailable
+		}
+		if err = checkOriginalBodyAvailableBatchForCapturedInTx(ctx, tx, ownRows, ownHeads); err != nil {
+			return err
+		}
+		for bodyID, want := range ownPayloads {
+			var current originalBodyPayload
+			if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", bodyID).Take(&current).Error; err != nil {
+				return err
+			}
+			if !reflect.DeepEqual(current, want) {
+				return ErrOriginalBodyUnavailable
+			}
+		}
+		// These checks are fresh after the additional current-body journal IO;
+		// no cached actor/grant decision becomes a configuration write authority.
+		if err = r.checkActorInTx(tx); err != nil {
+			return err
+		}
+		fresh, err = authority.RefreshCurrentReadActor(ctx)
+		if err != nil {
+			return err
+		}
+		if !sameNextcloudUploadCaller(fresh, ctx) {
+			return ErrNextcloudOnboardingDenied
+		}
+		if _, err = authority.authorizeKnowledgeActorWrite(fresh, kb); err != nil {
+			return err
+		}
+		for _, source := range r.lineage.Sources {
+			if err = r.checkInheritedGUIDGrantInTx(tx, source); err != nil {
+				return err
+			}
+		}
+		if err = guard.admission.Err(); err != nil {
+			return err
+		}
+		return r.finalClockWithStrictPayloadsInTx(tx, ownLeases, ownPayloads, strictPayloads)
+	}, memoryWriteOptions(s.db))
+	if err == nil {
+		// These actual leases survive commit and are cleanup-only here. Other reader
+		// checks do not acquire any authority from this map. Close first waits for
+		// this joined operation, then releases every exact newly captured tuple.
+		r.mu.Lock()
+		if r.configurationCleanupLeases == nil {
+			r.configurationCleanupLeases = map[string]originalBodyLease{}
+		}
+		for id, lease := range ownLeases {
+			r.configurationCleanupLeases[id] = lease
+		}
+		r.mu.Unlock()
+	}
+	return err
+}
