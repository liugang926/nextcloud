+func ownedAncestorBeginBuild(t *testing.T, m *machinePipelineFixture, ds *types.DataSource, k *types.Knowledge, text string, parent context.Context, marker *int, registry interfaces.RetrieveEngineRegistry) *ownedAncestorBuild {
+	t.Helper()
+	f := m.f
+	var payload types.DocumentProcessPayload
+	found := false
+	for _, task := range f.queue.tasks {
+		if task.Type() == types.TypeDocumentProcess {
+			var candidate types.DocumentProcessPayload
+			require.NoError(t, json.Unmarshal(task.Payload(), &candidate))
+			if candidate.KnowledgeID == k.ID {
+				payload = candidate
+				found = true
+				break
+			}
+		}
+	}
+	require.True(t, found)
+	metadata := k.GetMetadata()
+	scope := repository.NextcloudContentScope{TenantID: 7, KnowledgeBaseID: k.KnowledgeBaseID, KnowledgeID: k.ID, DataSourceID: ds.ID, ExternalID: metadata["external_id"]}
+	operation, cancel := context.WithTimeout(parent, 10*time.Second)
+	t.Cleanup(cancel)
+	content := repository.NewNextcloudContentLeaseStore(f.db)
+	lease, err := content.AcquireKnowledge(operation, scope, repository.NextcloudContentBuildLease, "owned-ancestor-build/"+uuid.NewString(), time.Minute)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		cleanup, done := context.WithTimeout(context.WithoutCancel(operation), 5*time.Second)
+		defer done()
+		if e := content.ReleaseLease(cleanup, lease.ID); e != nil {
+			t.Error(e)
+		}
+	})
+	operation = repository.WithNextcloudBuildLease(operation, content, lease, scope)
+	require.NoError(t, content.WaitForCurrentSourceVersion(operation, scope, lease, "actual-etag", time.Second))
+	read, err := f.store.BeginNextcloudOriginalUploadRead(operation, payload)
+	require.NoError(t, err)
+	held := &ownedAncestorBuild{knowledge: k, payload: payload, scope: scope, lease: lease, read: read}
+	t.Cleanup(func() {
+		if !held.closed {
+			if e := read.Close(); e != nil {
+				t.Error(e)
+			}
+		}
+	})
+	require.NoError(t, f.store.VerifyNextcloudOriginalDocumentTask(read.Context(), payload))
+	file, err := m.files.GetFile(read.Context(), payload.FilePath)
+	require.NoError(t, err)
+	actual, err := io.ReadAll(file)
+	closeErr := file.Close()
+	require.NoError(t, err)
+	require.NoError(t, closeErr)
+	require.Equal(t, []byte(text), actual)
+	proof, err := f.store.AdmitNextcloudBuildInputsFromOriginalUpload(read.Context(), actual, payload.FilePath)
+	require.NoError(t, err)
+	require.NotNil(t, proof)
+	held.proof = proof
+	held.bytes = actual
+	held.ctx = repository.WithKnowledgeBuildInputProof(read.Context(), f.store, proof)
+	parsed, err := (&docparser.SimpleFormatReader{}).Read(held.ctx, &types.ReadRequest{FileContent: actual, FileName: payload.FileName, FileType: payload.FileType})
+	require.NoError(t, err)
+	split := chunker.SplitText(parsed.MarkdownContent, chunker.SplitterConfig{ChunkSize: 512, ChunkOverlap: 0})
+	require.NotEmpty(t, split)
+	// Match processChunks' real ordering: resolve current tenant/KB in the
+	// actual registry and record its selected backend before the first chunk.
+	var currentTenant types.Tenant
+	require.NoError(t, f.db.WithContext(held.ctx).Where("id=?", scope.TenantID).Take(&currentTenant).Error)
+	var currentKB types.KnowledgeBase
+	require.NoError(t, f.db.WithContext(held.ctx).Where("id=? AND tenant_id=?", scope.KnowledgeBaseID, scope.TenantID).Take(&currentKB).Error)
+	held.ctx = context.WithValue(held.ctx, types.TenantInfoContextKey, &currentTenant)
+	selected, err := retriever.CreateRetrieveEngineForKB(held.ctx, registry, f.s.ownership, currentTenant.ID, currentKB.VectorStoreID)
+	require.NoError(t, err)
+	require.NotNil(t, selected)
+	require.Equal(t, []types.RetrieverEngineType{types.SQLiteRetrieverEngineType}, selected.SelectedBackendTypes())
+	require.NoError(t, repository.RecordNextcloudDerivedBackendSelection(held.ctx, selected.SelectedBackendTypes()))
+	held.engine = selected
+	for _, part := range split {
+		held.chunks = append(held.chunks, &types.Chunk{ID: uuid.NewString(), TenantID: 7, KnowledgeBaseID: k.KnowledgeBaseID, KnowledgeID: k.ID, Content: part.Content, ContextHeader: part.ContextHeader, ChunkType: types.ChunkTypeText, IsEnabled: true})
+	}
+	require.NoError(t, repository.NewChunkRepository(f.db).CreateChunks(held.ctx, held.chunks))
+	for _, c := range held.chunks {
+		content := buildKnowledgeIndexContent(k, c.EmbeddingContent())
+		held.infos = append(held.infos, &types.IndexInfo{Content: content, SourceID: c.ID, SourceType: types.ChunkSourceType, ChunkID: c.ID, KnowledgeID: k.ID, KnowledgeBaseID: k.KnowledgeBaseID, IsEnabled: true})
+		held.wire = append(held.wire, embedding.OriginalIndexText(content))
+	}
+	return held
+}
+func ownedAncestorWriteIndex(t *testing.T, m *machinePipelineFixture, held *ownedAncestorBuild, models interfaces.ModelService, negative *bool) error {
+	t.Helper()
+	originals, ok := models.(interfaces.ModelOriginalLifetimeReader)
+	require.True(t, ok)
+	var kb types.KnowledgeBase
+	require.NoError(t, m.f.db.Where("id=? AND tenant_id=?", held.scope.KnowledgeBaseID, 7).Take(&kb).Error)
+	modelRead, err := originals.BeginModelOriginalRead(held.ctx, kb.EmbeddingModelID, nil)
+	require.NoError(t, err)
+	closed := false
+	t.Cleanup(func() {
+		if !closed {
+			if e := modelRead.Close(); e != nil {
+				t.Error(e)
+			}
+		}
+	})
+	_, proof, err := modelRead.Snapshot()
+	require.NoError(t, err)
+	require.True(t, proof.Valid())
+	sdk, err := models.GetEmbeddingModel(modelRead.Context(), kb.EmbeddingModelID)
+	require.NoError(t, err)
+	client, ok := sdk.(interfaces.ModelOriginalClientLifetime)
+	require.True(t, ok)
+	clientClosed := false
+	t.Cleanup(func() {
+		if !clientClosed {
+			if e := client.CloseOriginal(); e != nil {
+				t.Error(e)
+			}
+		}
+	})
+	require.NotNil(t, held.engine)
+	result := held.engine.BatchIndex(modelRead.Context(), sdk, held.infos)
+	if negative == nil || !*negative {
+		require.NoError(t, result)
+	}
+	require.NoError(t, client.CloseOriginal())
+	clientClosed = true
+	require.NoError(t, modelRead.Close())
+	closed = true
+	return result
+}
+func ownedAncestorRequestedLeaseIDs(vars []any) []string {
+	result := []string{}
+	var collect func(any)
+	collect = func(value any) {
+		switch v := value.(type) {
+		case string:
+			var decoded any
+			if len(v) > 0 && (v[0] == '[' || v[0] == '{') && json.Unmarshal([]byte(v), &decoded) == nil {
+				collect(decoded)
+			} else {
+				result = append(result, v)
+			}
+		case []string:
+			for _, s := range v {
+				collect(s)
+			}
+		case []any:
+			for _, s := range v {
+				collect(s)
+			}
+		case map[string]any:
+			for _, s := range v {
+				collect(s)
+			}
+		}
+	}
+	for _, value := range vars {
+		collect(value)
+	}
+	return result
+}
