+func ownedAncestorSignedSource(t *testing.T, aText, bText string, aEpoch *atomic.Int64) (*httptest.Server, *atomic.Bool, *atomic.Int64, func() error) {
+	t.Helper()
+	allow := &atomic.Bool{}
+	allow.Store(true)
+	count := &atomic.Int64{}
+	var mu sync.Mutex
+	var observed error
+	nonces := map[string]bool{}
+	record := func(e error) { mu.Lock(); observed = errors.Join(observed, e); mu.Unlock() }
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+		if err != nil {
+			record(errors.New("actual source body read failed"))
+			w.WriteHeader(400)
+			return
+		}
+		r.Body = io.NopCloser(bytes.NewReader(raw))
+		stamp, err := strconv.ParseInt(r.Header.Get("X-WeKnora-Timestamp"), 10, 64)
+		nonce := r.Header.Get("X-WeKnora-Nonce")
+		decoded, e := hex.DecodeString(nonce)
+		if r.Header.Get("Authorization") != "Bearer isolated-machine" || r.Header.Get("X-WeKnora-Key-Id") != "local-key" || err != nil || stamp < time.Now().Unix()-60 || stamp > time.Now().Unix()+60 || e != nil || len(decoded) != 16 {
+			record(errors.New("actual source credential/timestamp/nonce invalid"))
+			w.WriteHeader(401)
+			return
+		}
+		canonicalQuery, err := ownedMachineCanonicalQuery(r.URL.RawQuery)
+		if err != nil {
+			record(err)
+			w.WriteHeader(400)
+			return
+		}
+		body := sha256.Sum256(raw)
+		canonical := strings.Join([]string{"weknora-hmac-sha256-v1", strings.ToUpper(r.Method), r.URL.EscapedPath(), canonicalQuery, hex.EncodeToString(body[:]), r.Header.Get("X-WeKnora-Timestamp"), nonce, "local-key"}, "\n")
+		key := sha256.Sum256([]byte("isolated-machine"))
+		mac := hmac.New(sha256.New, key[:])
+		_, _ = mac.Write([]byte(canonical))
+		signature, err := hex.DecodeString(r.Header.Get("X-WeKnora-Signature"))
+		if err != nil || !hmac.Equal(mac.Sum(nil), signature) {
+			record(errors.New("actual source signed bytes mismatch"))
+			w.WriteHeader(401)
+			return
+		}
+		mu.Lock()
+		replay := nonces[nonce]
+		nonces[nonce] = true
+		mu.Unlock()
+		if replay {
+			record(errors.New("actual source nonce replay"))
+			w.WriteHeader(401)
+			return
+		}
+		count.Add(1)
+		b := strings.Contains(r.URL.Path, "owned-ancestor-b")
+		fileID := int64(177)
+		text := aText
+		if b {
+			fileID = 277
+			text = bText
+		}
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/capabilities"):
+			fmt.Fprint(w, `{"protocol_version":"1","instance_id":"owned-ancestor-instance"}`)
+		case strings.HasSuffix(r.URL.Path, "/bindings"):
+			fmt.Fprintf(w, `{"bindings":[{"id":"owned-ancestor-a","name":"actual source A","root_file_id":107,"publication_state":"active","publication_epoch":%d},{"id":"owned-ancestor-b","name":"actual source B","root_file_id":207,"publication_state":"active","publication_epoch":1}]}`, aEpoch.Load())
+		case strings.HasSuffix(r.URL.Path, "/manifest"):
+			fmt.Fprintf(w, `{"generation":"actual-generation","complete":true,"next_cursor":null,"items":[{"file_id":%d,"etag":"actual-etag","name":"source.md","path":"source.md","mime_type":"text/markdown","size":%d,"mtime":1700000000}]}`, fileID, len(text))
+		case strings.HasSuffix(r.URL.Path, "/changes"):
+			http.NotFound(w, r)
+		case strings.HasSuffix(r.URL.Path, "/content"):
+			if r.Header.Get("If-Match") != `"actual-etag"` {
+				record(errors.New("actual source content ETag mismatch"))
+				w.WriteHeader(412)
+				return
+			}
+			w.Header().Set("ETag", `"actual-etag"`)
+			w.Header().Set("Content-Type", "text/markdown")
+			_, _ = io.WriteString(w, text)
+		case strings.HasSuffix(r.URL.Path, "/publication-check"):
+			var p struct {
+				InstanceID      string `json:"instance_id"`
+				ETag            string `json:"etag"`
+				Path            string `json:"path"`
+				ContentRevision string `json:"content_revision"`
+			}
+			expectedPath := "/files/" + strconv.FormatInt(fileID, 10) + "/publication-check"
+			if json.Unmarshal(raw, &p) != nil || !strings.HasSuffix(r.URL.Path, expectedPath) || p.InstanceID != "owned-ancestor-instance" || p.ETag != "actual-etag" || p.Path != "source.md" || p.ContentRevision != "0" {
+				record(errors.New("actual publication current identity mismatch"))
+				w.WriteHeader(400)
+				return
+			}
+			if fileID == 177 && !allow.Load() {
+				w.WriteHeader(403)
+				return
+			}
+			w.WriteHeader(204)
+		case strings.HasSuffix(r.URL.Path, "/authorize"):
+			var p struct {
+				DirectoryID     string `json:"directory_id"`
+				ObjectGUID      string `json:"object_guid"`
+				FileID          int64  `json:"file_id"`
+				ContentRevision string `json:"content_revision"`
+			}
+			if json.Unmarshal(raw, &p) != nil {
+				record(errors.New("actual source authorization wire invalid"))
+				w.WriteHeader(400)
+				return
+			}
+			permitted := p.DirectoryID == "machine-ad" && (p.ObjectGUID == "00112233-4455-6677-8899-aabbccddeeff" || p.ObjectGUID == "aabbccdd-0011-2233-4455-667788990011") && (p.FileID == 177 || p.FileID == 277) && p.ContentRevision == "0" && (p.FileID != 177 || allow.Load())
+			reason := "withdrawn"
+			if permitted {
+				reason = "authorized"
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"allow": permitted, "reason": reason, "policy_revision": "actual-policy-1", "source_etag": "actual-etag", "source_content_revision": "0", "checked_at": time.Now().Unix()})
+		default:
+			record(errors.New("unexpected actual source endpoint"))
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(server.Close)
+	return server, allow, count, func() error { mu.Lock(); defer mu.Unlock(); return observed }
+}
