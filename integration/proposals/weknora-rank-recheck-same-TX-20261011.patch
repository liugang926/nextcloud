+				}
+				matched := false
+				for _, part := range where.Exprs {
+					expressions := []clause.Expression{part}
+					if nested, ok := part.(clause.OrConditions); ok {
+						expressions = nested.Exprs
+					}
+					for _, expression := range expressions {
+						e, ok := expression.(clause.Expr)
+						if !ok || e.SQL != "source_table=? AND row_key IN ?" || len(e.Vars) != 2 || e.Vars[0] != "model_definition_originals" {
+							continue
+						}
+						ids, ok := e.Vars[1].([]string)
+						if !ok {
+							continue
+						}
+						for _, id := range ids {
+							matched = matched || id == proof.DefinitionID
+						}
+					}
+				}
+				if !matched {
+					return
+				}
+				batchQueries.Add(1)
+				observedContext = tx.Statement.Context
+				observedPool = tx.Statement.ConnPool
+				if testMode == "current" || testMode == "foreign_transaction" || !triggered.CompareAndSwap(false, true) {
+					return
+				}
+				fresh := func() *gorm.DB { return tx.Session(&gorm.Session{NewDB: true}) }
+				if testMode == "last_head_mutation" {
+					update := fresh().Table("original_body_field_heads").Where("slot_id=? AND body_id=? AND revision=?", head.SlotID, head.BodyID, head.Revision).Update("revision", head.Revision+1)
+					require.NoError(t, update.Error)
+					require.EqualValues(t, 1, update.RowsAffected)
+					var after struct {
+						BodyID   string
+						Revision int64
+					}
+					require.NoError(t, fresh().Table("original_body_field_heads").Select("body_id,revision").Where("slot_id=?", head.SlotID).Take(&after).Error)
+					require.Equal(t, head.BodyID, after.BodyID)
+					require.Equal(t, head.Revision+1, after.Revision)
+				} else {
+					update := fresh().Table("original_body_payloads").Where("id=? AND state='live'", queryHead.BodyID).Update("state", "purged")
+					require.NoError(t, update.Error)
+					require.EqualValues(t, 1, update.RowsAffected)
+					var after struct{ ID, State string }
+					require.NoError(t, fresh().Table("original_body_payloads").Select("id,state").Where("id=?", queryHead.BodyID).Take(&after).Error)
+					require.Equal(t, queryHead.BodyID, after.ID)
+					require.Equal(t, "purged", after.State)
+				}
+			}))
+			t.Cleanup(func() { _ = f.db.Callback().Query().Remove(callback) })
+			err = rank.Recheck()
+			require.Positive(t, batchQueries.Load(), "the outer rank scope flushes all captured physical heads")
+			require.Positive(t, vectorChecks.Load(), "the full vector authorization still runs")
+			require.Positive(t, queryChecks.Load(), "the full query authorization still runs")
+			require.NotEmpty(t, counts, "the receipt observer must see actual SQL")
+			if testMode == "current" || testMode == "foreign_transaction" {
+				require.NoError(t, err)
+				keys := []string{}
+				for id := range counts {
+					keys = append(keys, id)
+				}
+				sort.Strings(keys)
+				for _, id := range keys {
+					require.Equal(t, 1, counts[id], "a validated immutable receipt is queried once in the actual transaction")
+				}
+				if testMode == "foreign_transaction" {
+					require.NotNil(t, observedContext)
+					_ = f.db.Callback().Query().Remove(callback)
+					update := f.db.Table("original_body_payloads").Where("id=? AND state='live'", head.BodyID).Update("state", "purged")
+					require.NoError(t, update.Error)
+					require.EqualValues(t, 1, update.RowsAffected)
+					err = f.db.WithContext(observedContext).Transaction(func(tx *gorm.DB) error {
+						require.True(t, tx.Statement.ConnPool != observedPool)
+						require.False(t, repository.MemoryRankRecheckScope(tx))
+						return repository.CheckOriginalBodyAvailableInTx(observedContext, tx, "model_definition_originals", proof.DefinitionID)
+					})
+					require.Error(t, err)
+				}
+			} else {
+				require.True(t, triggered.Load())
+				require.Error(t, err)
+			}
+			_ = rank.Close()
+			_ = query.Close()
+			CloseMessageMaterialOutputBoundary(writer)
+			assertMemAtomicSQLLeasesClosed(t, f)
+			require.EqualValues(t, 2, calls.Load(), "rechecks never construct or invoke another provider")
+		})
+	}
+}
+
+func TestMemoryRankRecheckBodyScopeActualSQLite(t *testing.T) {
+	runRankRecheckAvailabilityScopeSQL(t, false)
+}
+func TestPostgresMemoryRankRecheckBodyScopeActual(t *testing.T) {
+	runRankRecheckAvailabilityScopeSQL(t, true)
+}
