 type originalBodyAvailabilityScopeKey struct{}
 
+// Copy only the active operation's private availability scope into an actual
+// reader context. Original actor, cancellation and held capabilities remain
+// that reader's values. A foreign/closed scope never enables a cache hit.
+func withOriginalBodyAvailabilityScope(tx *gorm.DB, ctx context.Context) context.Context {
+	if tx == nil || tx.Statement == nil || tx.Statement.Context == nil || ctx == nil {
+		return ctx
+	}
+	scope, _ := tx.Statement.Context.Value(originalBodyAvailabilityScopeKey{}).(*originalBodyAvailabilityScope)
+	if scope == nil || scope.pool != tx.Statement.ConnPool {
+		return ctx
+	}
+	scope.mu.Lock()
+	closed := scope.closed
+	scope.mu.Unlock()
+	if closed {
+		return ctx
+	}
+	return context.WithValue(ctx, originalBodyAvailabilityScopeKey{}, scope)
+}
