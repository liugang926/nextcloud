diff --git a/internal/application/repository/nextcloud_original_publication_epoch_freshness_test.go b/internal/application/repository/nextcloud_original_publication_epoch_freshness_test.go
new file mode 100644
index 000000000..2ed777924
--- /dev/null
+++ b/internal/application/repository/nextcloud_original_publication_epoch_freshness_test.go
@@ -0,0 +1,37 @@
+package repository
+
+import (
+	"errors"
+	"math"
+	"testing"
+)
+
+// This pure arithmetic oracle invokes the actual final-row validator. It does
+// not construct a read grant, status producer, SQL clock or original body.
+func TestNextcloudPublicationEpochFinalFreshnessDoesNotOverflow(t *testing.T) {
+	const clock = int64(1900000000123)
+	reader := &nextcloudOriginalUploadRead{actual: nextcloudOriginalUploadActual{PairOperation: "arithmetic-pair"}}
+	for _, test := range []struct {
+		name     string
+		verified int64
+		allowed  bool
+	}{
+		{"current", clock / 1000, true},
+		{"stale", clock/1000 - 301, false},
+		{"future", clock/1000 + 1, false},
+		{"overflow", math.MaxInt64/1000 + 1, false},
+		{"max_int64", math.MaxInt64, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			observed := nextcloudOriginalPublicationEpoch{ConnectionID: "arithmetic-connection", PairOperationID: "arithmetic-pair", PublicationEpoch: 1, VerifiedAt: test.verified}
+			actual := nextcloudOriginalFinalRow{PublicationConnectionID: observed.ConnectionID, PublicationPairOperationID: observed.PairOperationID, PublicationEpoch: observed.PublicationEpoch, PublicationVerifiedAt: observed.VerifiedAt, FinalClockMS: clock}
+			err := reader.checkPublicationFinalRow(actual, observed)
+			if test.allowed && err != nil {
+				t.Fatal("current arithmetic timestamp refused")
+			}
+			if !test.allowed && !errors.Is(err, ErrNextcloudOnboardingDenied) {
+				t.Fatal("invalid arithmetic timestamp was not denied")
+			}
+		})
+	}
+}
diff --git a/internal/application/repository/nextcloud_original_upload_epoch.go b/internal/application/repository/nextcloud_original_upload_epoch.go
new file mode 100644
index 000000000..30b483f3a
--- /dev/null
+++ b/internal/application/repository/nextcloud_original_upload_epoch.go
@@ -0,0 +1,138 @@
+package repository
+
+import (
+	"strconv"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type nextcloudOriginalPublicationEpoch struct {
+	ConnectionID     string
+	PairOperationID  string
+	PublicationEpoch int64
+	VerifiedAt       int64
+	Legacy           bool
+}
+
+// The artifact is already authenticated and leased before this method. This
+// captures its original epoch, never normalizes or re-signs the stored body.
+func (r *nextcloudOriginalUploadRead) capturePublicationEpochInTx(tx *gorm.DB) error {
+	var pair NextcloudSourcePairing
+	if err := tx.Where("operation_id=? AND tenant_id=? AND knowledge_base_id=? AND datasource_id=? AND state='active'", r.actual.PairOperation, r.payload.TenantID, r.payload.KnowledgeBaseID, r.receipt.DataSourceID).Take(&pair).Error; err != nil {
+		return err
+	}
+	raw := r.actual.Artifact.PublicationEpoch
+	if raw == "" {
+		// The old authenticated human protocol has the actual immutable pairing
+		// agreement. A headless purpose cannot infer a missing original epoch.
+		if r.purposeMode != "human" || pair.PublicationEpoch < 0 {
+			return ErrNextcloudOnboardingDenied
+		}
+		r.publicationEpoch = pair.PublicationEpoch
+	} else {
+		epoch, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil || epoch < 0 || strconv.FormatInt(epoch, 10) != raw {
+			return ErrNextcloudOnboardingDenied
+		}
+		r.publicationEpoch = epoch
+	}
+	observed, err := r.observePublicationEpochInTx(tx)
+	if err != nil {
+		return err
+	}
+	r.publicationConnection = observed.ConnectionID
+	r.publicationLegacy = observed.Legacy
+	r.publicationCaptured = true
+	_, err = r.checkPublicationEpochInTx(tx)
+	return err
+}
+
+// Only metadata is selected. Both the active connection and the current epoch
+// belong to the exact paired source; an absent status is not a current grant.
+func (r *nextcloudOriginalUploadRead) observePublicationEpochInTx(tx *gorm.DB) (nextcloudOriginalPublicationEpoch, error) {
+	var pair NextcloudSourcePairing
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("operation_id=? AND tenant_id=? AND knowledge_base_id=? AND datasource_id=? AND state='active'", r.actual.PairOperation, r.payload.TenantID, r.payload.KnowledgeBaseID, r.receipt.DataSourceID).Take(&pair).Error; err != nil {
+		return nextcloudOriginalPublicationEpoch{}, err
+	}
+	if pair.InstanceID != r.actual.Artifact.InstanceID || pair.BindingID != r.actual.Artifact.BindingID || pair.BaseURL != r.actual.BaseURL || pair.ConfigSHA != r.actual.ConfigSHA {
+		return nextcloudOriginalPublicationEpoch{}, ErrKnowledgeInputChanged
+	}
+	var connections []struct {
+		ConnectionID                                                              string
+		TenantID                                                                  uint64
+		KnowledgeBaseID                                                           string
+		DataSourceID                                                              string `gorm:"column:datasource_id"`
+		NextcloudInstanceID, BindingID, DatasourceBaseURL, DatasourceConfigSHA256 string
+	}
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Table("nextcloud_event_connections").Select("connection_id,tenant_id,knowledge_base_id,datasource_id,nextcloud_instance_id,binding_id,datasource_base_url,datasource_config_sha256").Where("datasource_id=? AND status='active'", r.receipt.DataSourceID).Find(&connections).Error; err != nil {
+		return nextcloudOriginalPublicationEpoch{}, err
+	}
+	if len(connections) == 0 {
+		if r.purposeMode != "human" {
+			return nextcloudOriginalPublicationEpoch{}, ErrNextcloudOnboardingDenied
+		}
+		return nextcloudOriginalPublicationEpoch{PairOperationID: pair.OperationID, PublicationEpoch: pair.PublicationEpoch, Legacy: true}, nil
+	}
+	if len(connections) != 1 {
+		return nextcloudOriginalPublicationEpoch{}, ErrNextcloudOnboardingDenied
+	}
+	c := connections[0]
+	if c.ConnectionID == "" || c.TenantID != pair.TenantID || c.KnowledgeBaseID != pair.KnowledgeBaseID || c.DataSourceID != pair.DataSourceID || c.NextcloudInstanceID != pair.InstanceID || c.BindingID != pair.BindingID || c.DatasourceBaseURL != pair.BaseURL || c.DatasourceConfigSHA256 != pair.ConfigSHA {
+		return nextcloudOriginalPublicationEpoch{}, ErrNextcloudOnboardingDenied
+	}
+	var epoch nextcloudOriginalPublicationEpoch
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Table("nextcloud_source_status_epochs").Where("connection_id=?", c.ConnectionID).Take(&epoch).Error; err != nil {
+		return nextcloudOriginalPublicationEpoch{}, err
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return nextcloudOriginalPublicationEpoch{}, err
+	}
+	if epoch.PairOperationID != pair.OperationID || epoch.PublicationEpoch < 0 || epoch.VerifiedAt <= 0 || epoch.VerifiedAt > now/1000 || epoch.VerifiedAt*1000 > now || now-epoch.VerifiedAt*1000 > 300000 {
+		return nextcloudOriginalPublicationEpoch{}, ErrNextcloudOnboardingDenied
+	}
+	return epoch, nil
+}
+
+func (r *nextcloudOriginalUploadRead) checkPublicationEpochInTx(tx *gorm.DB) (nextcloudOriginalPublicationEpoch, error) {
+	if !r.publicationCaptured {
+		return nextcloudOriginalPublicationEpoch{}, ErrNextcloudOnboardingDenied
+	}
+	current, err := r.observePublicationEpochInTx(tx)
+	if err != nil {
+		return current, err
+	}
+	if current.ConnectionID != r.publicationConnection || current.Legacy != r.publicationLegacy {
+		return current, ErrNextcloudOnboardingDenied
+	}
+	if current.PublicationEpoch != r.publicationEpoch {
+		allowed, err := NewNextcloudOnboardingStore(tx).RootMigrationAuthorizesEpoch(r.ctx, r.payload.TenantID, r.payload.KnowledgeBaseID, r.receipt.DataSourceID, r.actual.Artifact.Path, r.publicationEpoch, current.PublicationEpoch)
+		if err != nil {
+			return current, err
+		}
+		if !allowed {
+			return current, ErrNextcloudOnboardingDenied
+		}
+	}
+	return current, r.ctx.Err()
+}
+
+// The final SQL statement repeats these exact metadata predicates with the
+// same clock as every body/content lease. Nothing here creates an epoch row.
+func (r *nextcloudOriginalUploadRead) publicationFinalSQL(observed nextcloudOriginalPublicationEpoch) (string, []interface{}) {
+	if observed.Legacy {
+		return `SELECT '' AS publication_connection_id,p.operation_id AS publication_pair_operation_id,p.publication_epoch AS publication_epoch,0 AS publication_verified_at FROM nextcloud_source_pairings p JOIN data_sources d ON d.id=p.datasource_id AND d.tenant_id=p.tenant_id AND d.knowledge_base_id=p.knowledge_base_id AND d.type='nextcloud' AND d.status='active' AND d.deleted_at IS NULL WHERE p.operation_id=? AND p.tenant_id=? AND p.knowledge_base_id=? AND p.datasource_id=? AND p.state='active' AND NOT EXISTS(SELECT 1 FROM nextcloud_event_connections c WHERE c.datasource_id=p.datasource_id AND c.status='active')`, []interface{}{r.actual.PairOperation, r.payload.TenantID, r.payload.KnowledgeBaseID, r.receipt.DataSourceID}
+	}
+	return `SELECT c.connection_id AS publication_connection_id,p.operation_id AS publication_pair_operation_id,e.publication_epoch AS publication_epoch,e.verified_at AS publication_verified_at FROM nextcloud_event_connections c JOIN nextcloud_source_status_epochs e ON e.connection_id=c.connection_id JOIN nextcloud_source_pairings p ON p.operation_id=e.pair_operation_id JOIN data_sources d ON d.id=c.datasource_id AND d.tenant_id=c.tenant_id AND d.knowledge_base_id=c.knowledge_base_id AND d.type='nextcloud' AND d.status='active' AND d.deleted_at IS NULL WHERE c.connection_id=? AND c.status='active' AND c.tenant_id=? AND c.knowledge_base_id=? AND c.datasource_id=? AND p.tenant_id=c.tenant_id AND p.knowledge_base_id=c.knowledge_base_id AND p.datasource_id=c.datasource_id AND p.state='active' AND p.nextcloud_instance_id=c.nextcloud_instance_id AND p.binding_id=c.binding_id AND p.datasource_base_url=c.datasource_base_url AND p.datasource_config_sha256=c.datasource_config_sha256`, []interface{}{observed.ConnectionID, r.payload.TenantID, r.payload.KnowledgeBaseID, r.receipt.DataSourceID}
+}
+
+func (r *nextcloudOriginalUploadRead) checkPublicationFinalRow(row nextcloudOriginalFinalRow, observed nextcloudOriginalPublicationEpoch) error {
+	if row.PublicationConnectionID != observed.ConnectionID || row.PublicationPairOperationID != r.actual.PairOperation || row.PublicationEpoch != observed.PublicationEpoch || row.PublicationVerifiedAt != observed.VerifiedAt {
+		return ErrNextcloudOnboardingDenied
+	}
+	if !observed.Legacy && (row.PublicationVerifiedAt <= 0 || row.PublicationVerifiedAt > row.FinalClockMS/1000 || row.PublicationVerifiedAt*1000 > row.FinalClockMS || row.FinalClockMS-row.PublicationVerifiedAt*1000 > 300000) {
+		return ErrNextcloudOnboardingDenied
+	}
+	return nil
+}
