+	leases           map[string]originalBodyLease
+	bodies           map[string]originalBodyPayload
+	predecessors     map[string]bool
+	mu               sync.Mutex
+	checks           sync.WaitGroup
+	closed           bool
+	failed, closeErr error
+	joined           chan struct{}
+}
+
+func newNextcloudNoEventEpochRead(r *nextcloudOriginalUploadRead, ctx context.Context) *NextcloudNoEventEpochRead {
+	e := &NextcloudNoEventEpochRead{upload: r, db: r.db, leases: map[string]originalBodyLease{}, bodies: map[string]originalBodyPayload{}, predecessors: map[string]bool{}, joined: make(chan struct{})}
+	e.ctx, e.cancel = context.WithCancel(ctx)
+	e.ctx = context.WithValue(e.ctx, nextcloudNoEventEpochReadKey{}, e)
+	return e
+}
+
+// Acquisition is the sole state-writing phase. No caller can observe the reader
+// until its owner's real SQL transaction commits. Recheck never calls a producer.
+func (e *NextcloudNoEventEpochRead) acquireInTx(tx *gorm.DB) error {
+	fact, err := e.produceNoEventEpochInTx(tx)
+	if err != nil {
+		return err
+	}
+	e.observation = fact
+	if err = bodyInternal(tx.WithContext(e.hydrationContext(tx.Statement.Context))).Where("id=?", e.upload.receipt.DataSourceID).Take(&e.control).Error; err != nil {
+		return err
+	}
+	if e.control.ID != e.generation.ID || e.control.TenantID != e.generation.TenantID || e.control.KnowledgeBaseID != e.generation.KnowledgeBaseID || e.control.GenerationID != e.generation.GenerationID || e.control.ObservationID != fact.ID || e.control.Present != 1 || e.control.Revision <= 0 || bodySHA([]byte(e.control.ControlJSON)) != e.control.ControlSHA256 {
+		return ErrKnowledgeInputChanged
+	}
+	var binding struct {
+		Source, Generation, Observation, Digest string
+		Revision                                int64
+	}
+	if json.Unmarshal([]byte(e.control.ControlJSON), &binding) != nil || binding.Source != e.control.ID || binding.Generation != e.control.GenerationID || binding.Observation != fact.ID || binding.Digest != fact.Digest || binding.Revision != e.control.Revision {
+		return ErrKnowledgeInputChanged
+	}
+	e.schemaIdentity = e.generation.SchemaDigest
+	if e.catalogueGuard, err = nextcloudNoEventEpochCatalogueGuard(tx); err != nil {
+		return err
+	}
+	return e.checkStateInTx(tx, false)
+}
+
+// This getter cannot create or refresh a current observation. Only the explicit
+// no-event upload constructor produces it, before returning the actual owner.
+func (s *KnowledgeInputProvenanceStore) NextcloudCurrentEpochOriginal(ctx context.Context) (*NextcloudNoEventEpochRead, error) {
+	if ctx == nil {
+		return nil, ErrNextcloudOnboardingDenied
+	}
+	r := nextcloudOriginalUploadInContext(ctx)
+	if r == nil || r.store != s || r.noEventEpoch == nil || ctx.Err() != nil || !sameNextcloudUploadCaller(ctx, r.ctx) {
+		return nil, ErrNextcloudOnboardingDenied
+	}
+	if err := r.noEventEpoch.Recheck(); err != nil {
+		return nil, err
+	}
+	return r.noEventEpoch, nil
+}
+func (e *NextcloudNoEventEpochRead) Context() context.Context { return e.ctx }
+func (e *NextcloudNoEventEpochRead) start() error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.closed {
+		return ErrKnowledgeInputChanged
+	}
+	if e.failed != nil {
+		return e.failed
+	}
+	if err := e.ctx.Err(); err != nil {
+		return err
+	}
+	e.checks.Add(1)
+	return nil
+}
+func (e *NextcloudNoEventEpochRead) finish(err error) error {
+	if err == nil {
+		err = e.ctx.Err()
+	}
+	e.mu.Lock()
+	if err != nil && e.failed == nil {
+		e.failed = err
+		e.cancel()
+	}
+	e.mu.Unlock()
+	e.checks.Done()
+	return err
+}
+func (e *NextcloudNoEventEpochRead) Recheck() (err error) {
+	// The upload owner registers the entire check with both lifetimes, including
+	// the final content/body/epoch SQL clock. Close cannot release either early.
+	return e.upload.Recheck()
+}
+func (e *NextcloudNoEventEpochRead) Snapshot() (int64, string, error) {
+	if err := e.Recheck(); err != nil {
+		return 0, "", err
+	}
+	return e.observation.PublicationEpoch, e.observation.Digest, nil
+}
+func (e *NextcloudNoEventEpochRead) checkStateInTx(tx *gorm.DB, remote bool) error {
+	if err := e.upload.samePool(tx); err != nil {
+		return err
+	}
+	if err := e.ctx.Err(); err != nil {
+		return err
+	}
+	if err := e.upload.checkActorInTx(tx); err != nil {
+		return err
+	}
+	if err := e.checkImmutableStateInTx(tx); err != nil {
+		return err
+	}
+	var err error
+	var control nextcloudEpochCurrentControl
+	if err = bodyInternal(tx).Select("id,tenant_id,knowledge_base_id,generation_id,revision,present,observation_id,control_sha256,verified_at_ms").Where("id=?", e.control.ID).Take(&control).Error; err != nil {
+		return err
+	}
+	expected := e.control
+	expected.ControlJSON = ""
+	if !reflect.DeepEqual(control, expected) || control.Present != 1 {
+		return ErrKnowledgeInputChanged
+	}
+	if err = checkOriginalBodyAvailableBatchForCapturedInTx(e.ctx, tx, e.rows, e.heads); err != nil {
+		return err
+	}
+	if remote {
+		var source types.DataSource
+		if err = tx.Where("id=? AND tenant_id=? AND knowledge_base_id=? AND type=? AND status=?", e.upload.receipt.DataSourceID, e.upload.payload.TenantID, e.upload.payload.KnowledgeBaseID, types.ConnectorTypeNextcloud, types.DataSourceStatusActive).Take(&source).Error; err != nil {
+			return err
+		}
+		cfg, err := source.ParseConfig()
+		if err != nil {
+			return err
+		}
+		cfg.Type = source.Type
+		actual, err := nextcloudconnector.InspectPairing(e.ctx, cfg)
+		if err != nil {
+			return err
+		}
+		if actual.InstanceID != e.observation.InstanceID || actual.BindingID != e.observation.BindingID || actual.BaseURL != e.upload.actual.BaseURL || actual.PublicationState != e.observation.PublicationState || actual.PublicationEpoch != e.observation.PublicationEpoch {
+			return ErrNextcloudOnboardingDenied
+		}
+	}
+	if err = NewOriginalBodyRetentionStore(tx).checkJournalInTx(tx); err != nil {
+		return err
+	}
+	// Metadata is fresh after the real external source and journal IO.
+	if err = e.upload.checkActorInTx(tx); err != nil {
+		return err
+	}
+	if err = checkOriginalBodyAvailableBatchForCapturedInTx(e.ctx, tx, e.rows, e.heads); err != nil {
+		return err
+	}
+	return e.checkImmutableStateInTx(tx)
+}
+
+// This reads metadata before the physical/journal availability fence. Every
+// captured generation, signed observation and control tuple is immutable here.
+func (e *NextcloudNoEventEpochRead) checkImmutableStateInTx(tx *gorm.DB) error {
+	identity, err := nextcloudNoEventEpochSchemaIdentity(tx)
+	if err != nil || identity != e.schemaIdentity {
+		return ErrKnowledgeInputChanged
+	}
+	guard, err := nextcloudNoEventEpochCatalogueGuard(tx)
+	if err != nil || guard != e.catalogueGuard {
+		return ErrKnowledgeInputChanged
+	}
+	var generation nextcloudEpochProtocolOrigin
+	if err = bodyInternal(tx).Select("id,tenant_id,knowledge_base_id,generation_id,anchor_sha256,schema_digest,created_at_ms").Where("id=?", e.generation.ID).Take(&generation).Error; err != nil {
+		return err
+	}
+	wantGeneration := e.generation
+	wantGeneration.AnchorJSON = ""
+	if !reflect.DeepEqual(generation, wantGeneration) {
+		return ErrKnowledgeInputChanged
+	}
+	var observation nextcloudEpochObservationOriginal
+	if err = bodyInternal(tx).Select("id,tenant_id,knowledge_base_id,datasource_id,generation_id,pair_operation_id,instance_id,binding_id,config_sha256,publication_epoch,publication_state,observation_sha256,digest,created_at_ms").Where("id=?", e.observation.ID).Take(&observation).Error; err != nil {
+		return err
+	}
+	wantObservation := e.observation
+	wantObservation.ObservationJSON = ""
+	if !reflect.DeepEqual(observation, wantObservation) {
+		return ErrKnowledgeInputChanged
+	}
+	return e.ctx.Err()
+}
+func (e *NextcloudNoEventEpochRead) Close() error {
+	e.mu.Lock()
+	if e.closed {
+		joined := e.joined
+		e.mu.Unlock()
+		<-joined
+		e.mu.Lock()
+		err := errors.Join(e.failed, e.closeErr)
+		e.mu.Unlock()
+		return err
+	}
+	e.closed = true
+	e.cancel()
+	e.mu.Unlock()
+	e.checks.Wait()
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(e.ctx), 5*time.Second)
+	defer cancel()
+	err := e.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := reserveMessageBodyLeaseWriterInTx(tx); err != nil {
+			return err
+		}
+		now, err := nextcloudLeaseNowMS(tx)
+		if err != nil {
+			return err
+		}
+		var errs []error
+		for _, l := range e.leases {
+			q := bodyInternal(tx).Model(&originalBodyLease{}).Where("lease_id=? AND body_id=? AND owner_id=? AND kind=? AND epoch=? AND released_at_ms IS NULL", l.LeaseID, l.BodyID, l.OwnerID, l.Kind, l.Epoch).Update("released_at_ms", now)
+			errs = append(errs, q.Error)
+		}
+		return errors.Join(errs...)
+	}, memoryWriteOptions(e.db))
+	e.mu.Lock()
+	e.closeErr = err
+	close(e.joined)
+	e.mu.Unlock()
+	return err
+}
+
+func (e *NextcloudNoEventEpochRead) hydrationContext(ctx context.Context) context.Context {
+	return context.WithValue(ctx, nextcloudNoEventEpochHydrationKey{}, e)
+}
+
+// Metadata-only diagnostic predicate. It cannot produce or grant a reader and
+// never reads/mutates acquisition maps. Body producer capture is not hydration.
+func NextcloudNoEventEpochHydrationObserved(tx *gorm.DB) bool {
+	if tx == nil || tx.Statement == nil {
+		return false
+	}
+	e, _ := tx.Statement.Context.Value(nextcloudNoEventEpochHydrationKey{}).(*NextcloudNoEventEpochRead)
+	if e == nil || e.upload == nil || nextcloudOriginalUploadInContext(tx.Statement.Context) != e.upload {
+		return false
+	}
+	_, actual := tx.Statement.ConnPool.(gorm.TxCommitter)
+	if !actual {
+		return false
+	}
+	pool, err := tx.DB()
+	return err == nil && pool == e.upload.pool
+}
diff --git a/internal/application/repository/nextcloud_noevent_epoch_schema.go b/internal/application/repository/nextcloud_noevent_epoch_schema.go
new file mode 100644
index 0000000000000000000000000000000000000000..7a22f3b8b24d37c82604dbfd39e15e8a7d347d97
--- /dev/null
+++ b/internal/application/repository/nextcloud_noevent_epoch_schema.go
@@ -0,0 +1,184 @@
+package repository
+
+import (
+	_ "embed"
+	"encoding/json"
+	"sort"
+	"strings"
+
+	"gorm.io/gorm"
+)
+
+//go:embed nextcloud_noevent_epoch_schema_specs.json
+var nextcloudNoEventEpochSchemaSpecs []byte
+
+// Exact catalogue identities are structural continuity checks, never read grants.
+// A coordinated restore of this database and its external journal is not proved.
+func nextcloudNoEventEpochSchemaIdentity(tx *gorm.DB) (string, error) {
+	if !originalBodySchemaPresent(tx) {
+		return "", ErrKnowledgeInputChanged
+	}
+	if tx.Dialector.Name() == "postgres" {
+		return nextcloudNoEventEpochPGSchemaIdentity(tx)
+	}
+	if tx.Dialector.Name() != "sqlite" {
+		return "", ErrKnowledgeInputChanged
+	}
+	var specs struct{ Tables, Triggers map[string]string }
+	if json.Unmarshal(nextcloudNoEventEpochSchemaSpecs, &specs) != nil || len(specs.Tables) != 3 || len(specs.Triggers) != 6 {
+		return "", ErrKnowledgeInputChanged
+	}
+	type entry struct {
+		Type, Name, SQL string
+		Rootpage        int64
+	}
+	var actual []entry
+	names := []string{}
+	for n := range specs.Tables {
+		names = append(names, n)
+	}
+	for n := range specs.Triggers {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	if err := bodyInternal(tx).Raw("SELECT type,name,sql,rootpage FROM sqlite_schema WHERE name IN ? ORDER BY name", names).Scan(&actual).Error; err != nil {
+		return "", err
+	}
+	if len(actual) != len(names) {
+		return "", ErrKnowledgeInputChanged
+	}
+	normalize := func(s string) string {
+		return strings.Join(strings.Fields(strings.TrimSuffix(strings.TrimSpace(s), ";")), " ")
+	}
+	for _, row := range actual {
+		expected, table := specs.Tables[row.Name]
+		kind := "table"
+		if !table {
+			expected = specs.Triggers[row.Name]
+			kind = "trigger"
+		}
+		if expected == "" || row.Type != kind {
+			return "", ErrKnowledgeInputChanged
+		}
+		if normalize(row.SQL) != normalize(expected) {
+			if table {
+				return "", ErrKnowledgeInputChanged
+			}
+			wrapped, err := nextcloudNoEventSQLiteWrappedTrigger(tx, expected)
+			if err != nil || normalize(row.SQL) != normalize(wrapped) {
+				return "", ErrKnowledgeInputChanged
+			}
+		}
+	}
+	var cookie int64
+	if err := bodyInternal(tx).Raw("PRAGMA schema_version").Scan(&cookie).Error; err != nil {
+		return "", err
+	}
+	if cookie <= 0 {
+		return "", ErrKnowledgeInputChanged
+	}
+	return KnowledgeInputDigest(struct {
+		Cookie    int64
+		Catalogue []entry
+	}{cookie, actual})
+}
+
+// This renders exactly the existing 152 issuer, including every non-body column
+// equality. A changed condition, body, field set or rewrite authority is refused.
+func nextcloudNoEventSQLiteWrappedTrigger(tx *gorm.DB, definition string) (string, error) {
+	upper := strings.ToUpper(definition)
+	if !strings.Contains(upper, "UPDATE ON") {
+		return "", ErrKnowledgeInputChanged
+	}
+	table := ""
+	for _, name := range []string{"nextcloud_epoch_protocol_origins", "nextcloud_epoch_observation_originals", "nextcloud_epoch_current_controls"} {
+		if strings.Contains(definition, " ON "+name+" ") {
+			table = name
+			break
+		}
+	}
+	d, ok := bodyDescriptor(table)
+	if !ok {
+		return "", ErrKnowledgeInputChanged
+	}
+	columns, err := bodyInternal(tx).Migrator().ColumnTypes(table)
+	if err != nil {
+		return "", err
+	}
+	known := map[string]bool{}
+	for _, column := range columns {
+		known[column.Name()] = true
+	}
+	permitted := []string{}
+	for _, field := range d.Columns {
+		col := bodyFieldColumn(field)
+		if !known[col] {
+			return "", ErrKnowledgeInputChanged
+		}
+		equal := []string{}
+		for _, other := range columns {
+			if other.Name() != col {
+				equal = append(equal, "NEW."+bodyQuoted(other.Name())+" IS OLD."+bodyQuoted(other.Name()))
+			}
+		}
+		authority := "EXISTS (SELECT 1 FROM original_body_rewrite_authorities a JOIN original_body_payloads p ON p.id=a.body_id WHERE a.source_table=" + bodySQLLiteral(d.Table) + " AND a.row_key=CAST(OLD." + bodyQuoted(d.Key) + " AS TEXT) AND a.column_name=" + bodySQLLiteral(col) + " AND a.old_value=OLD." + bodyQuoted(col) + " AND a.new_value=NEW." + bodyQuoted(col) + ")"
+		permitted = append(permitted, "("+strings.Join(equal, " AND ")+" AND "+authority+")")
+	}
+	if len(permitted) == 0 {
+		return "", ErrKnowledgeInputChanged
+	}
+	begin := strings.Index(upper, " BEGIN")
+	if begin < 0 {
+		begin = strings.Index(upper, "\nBEGIN")
+	}
+	if begin < 0 {
+		return "", ErrKnowledgeInputChanged
+	}
+	prefix, suffix := definition[:begin], definition[begin:]
+	when := strings.Index(strings.ToUpper(prefix), " WHEN ")
+	if when < 0 {
+		when = strings.Index(strings.ToUpper(prefix), "\nWHEN ")
+	}
+	permit := strings.Join(permitted, " OR ")
+	if when >= 0 {
+		condition := strings.TrimSpace(prefix[when+6:])
+		prefix = prefix[:when] + " WHEN (" + condition + ") AND NOT (" + permit + ")"
+	} else {
+		prefix += " WHEN NOT (" + permit + ")"
+	}
+	return prefix + suffix, nil
+}
+
+// The final union embeds this same read-only catalogue predicate, so a real
+// before-SQL observer cannot replace a table/trigger after the earlier check.
+// Captured values remain immutable. This is not an independent full-restore proof.
+func nextcloudNoEventEpochCatalogueGuard(tx *gorm.DB) (string, error) {
+	sql := nextcloudNoEventEpochCatalogueGuardSQL(tx.Dialector.Name())
+	if sql == "" {
+		return "", ErrKnowledgeInputChanged
+	}
+	var actual string
+	if err := bodyInternal(tx).Raw("SELECT (" + sql + ")").Scan(&actual).Error; err != nil {
+		return "", err
+	}
+	if actual == "" {
+		return "", ErrKnowledgeInputChanged
+	}
+	return actual, nil
+}
+func nextcloudNoEventEpochCatalogueGuardSQL(dialect string) string {
+	if dialect == "sqlite" {
+		return `SELECT json_object('cookie',(SELECT schema_version FROM pragma_schema_version),'catalogue',json((SELECT json_group_array(json_object('type',type,'name',name,'sql',sql,'rootpage',rootpage)) FROM (SELECT type,name,sql,rootpage FROM sqlite_schema WHERE name IN ('nextcloud_epoch_protocol_origins','nextcloud_epoch_observation_originals','nextcloud_epoch_current_controls','nextcloud_epoch_protocol_update','nextcloud_epoch_protocol_delete','nextcloud_epoch_observation_update','nextcloud_epoch_observation_delete','nextcloud_epoch_control_revision','nextcloud_epoch_control_delete') ORDER BY type,name))))`
+	}
+	if dialect != "postgres" {
+		return ""
+	}
+	return `SELECT jsonb_build_object('namespace',(SELECT oid FROM pg_namespace WHERE nspname=current_schema()),'relations',(
+ SELECT jsonb_agg(jsonb_build_object('oid',c.oid,'name',c.relname,'kind',c.relkind,'persistence',c.relpersistence,'rls',c.relrowsecurity,'forced_rls',c.relforcerowsecurity,
+ 'columns',(SELECT jsonb_agg(jsonb_build_object('position',a.attnum,'name',a.attname,'type',a.atttypid,'typmod',a.atttypmod,'notnull',a.attnotnull,'identity',a.attidentity,'generated',a.attgenerated,'collation',a.attcollation,'default',pg_get_expr(d.adbin,d.adrelid)) ORDER BY a.attnum) FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped),
+ 'constraints',(SELECT jsonb_agg(jsonb_build_object('oid',k.oid,'name',k.conname,'kind',k.contype,'definition',pg_get_constraintdef(k.oid,false),'keys',k.conkey,'target',k.confrelid,'targetkeys',k.confkey,'validated',k.convalidated,'deferrable',k.condeferrable,'deferred',k.condeferred) ORDER BY k.conname,k.oid) FROM pg_constraint k WHERE k.conrelid=c.oid),
+ 'indexes',(SELECT jsonb_agg(jsonb_build_object('oid',i.indexrelid,'definition',pg_get_indexdef(i.indexrelid),'unique',i.indisunique,'primary',i.indisprimary,'valid',i.indisvalid,'ready',i.indisready,'live',i.indislive,'immediate',i.indimmediate,'keys',i.indkey,'classes',i.indclass) ORDER BY i.indexrelid) FROM pg_index i WHERE i.indrelid=c.oid),
+ 'triggers',(SELECT jsonb_agg(jsonb_build_object('oid',t.oid,'name',t.tgname,'type',t.tgtype,'enabled',t.tgenabled,'definition',pg_get_triggerdef(t.oid,false),'args',t.tgargs,'function_oid',p.oid,'function_namespace',p.pronamespace,'function_name',p.proname,'body',p.prosrc,'language',p.prolang,'returntype',p.prorettype,'arity',p.pronargs,'security',p.prosecdef,'strict',p.proisstrict,'volatility',p.provolatile,'parallel',p.proparallel,'config',p.proconfig) ORDER BY t.tgname,t.oid) FROM pg_trigger t JOIN pg_proc p ON p.oid=t.tgfoid WHERE t.tgrelid=c.oid AND NOT t.tgisinternal)
+ ) ORDER BY c.relname) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=current_schema() AND c.relname IN ('nextcloud_epoch_protocol_origins','nextcloud_epoch_observation_originals','nextcloud_epoch_current_controls')),
+ 'canonical_functions',(SELECT jsonb_agg(jsonb_build_object('oid',p.oid,'name',p.proname,'body',p.prosrc,'language',p.prolang,'returntype',p.prorettype,'arity',p.pronargs,'security',p.prosecdef,'strict',p.proisstrict,'volatility',p.provolatile,'parallel',p.proparallel,'config',p.proconfig) ORDER BY p.proname,p.oid) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname=current_schema() AND p.proname IN ('nextcloud_epoch_original_immutable','nextcloud_epoch_control_guard')))::text`
+}
