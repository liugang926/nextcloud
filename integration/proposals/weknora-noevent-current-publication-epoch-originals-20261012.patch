@@ -0,0 +1,109 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func (e *NextcloudNoEventEpochRead) authorNoEventEpochGenerationInTx(tx *gorm.DB) (nextcloudEpochProtocolOrigin, error) {
+	r := e.upload
+	// A missing row is not permission to re-bootstrap a retained old collection.
+	// These heads are in the existing body152 protocol, outside the new tables.
+	var retained int64
+	if err := bodyInternal(tx).Table("original_body_field_heads").Where("tenant_id=? AND knowledge_base_id=? AND source_table IN ?", r.payload.TenantID, r.payload.KnowledgeBaseID, []string{"nextcloud_epoch_protocol_origins", "nextcloud_epoch_observation_originals", "nextcloud_epoch_current_controls"}).Count(&retained).Error; err != nil {
+		return nextcloudEpochProtocolOrigin{}, err
+	}
+	if retained != 0 {
+		return nextcloudEpochProtocolOrigin{}, ErrOriginalBodyUnavailable
+	}
+	identity, err := nextcloudNoEventEpochSchemaIdentity(tx)
+	if err != nil {
+		return nextcloudEpochProtocolOrigin{}, err
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return nextcloudEpochProtocolOrigin{}, err
+	}
+	generation := nextcloudEpochProtocolOrigin{ID: r.receipt.DataSourceID, TenantID: r.payload.TenantID, KnowledgeBaseID: r.payload.KnowledgeBaseID, GenerationID: uuid.NewString(), SchemaDigest: identity, CreatedAtMS: now}
+	raw, err := json.Marshal(struct {
+		Source, Pair, Generation, Schema string
+		Tenant                           uint64
+		KB                               string
+	}{generation.ID, r.actual.PairOperation, generation.GenerationID, identity, generation.TenantID, generation.KnowledgeBaseID})
+	if err != nil {
+		return generation, err
+	}
+	generation.AnchorJSON = string(raw)
+	generation.AnchorSHA256 = bodySHA(raw)
+	ctx := context.WithValue(r.ctx, nextcloudNoEventEpochProducerKey{}, nextcloudNoEventEpochProducer{r, generation.TableName(), generation.ID, generation.AnchorSHA256})
+	if err = tx.WithContext(ctx).Create(&generation).Error; err != nil {
+		return generation, err
+	}
+	if err = e.claimNoEventEpochRowsInTx(tx, []originalBodyAvailabilityRow{{generation.TableName(), generation.ID}}); err != nil {
+		return generation, err
+	}
+	return generation, r.ctx.Err()
+}
+
+func (e *NextcloudNoEventEpochRead) publishNoEventEpochControlInTx(tx *gorm.DB, generation nextcloudEpochProtocolOrigin, fact nextcloudEpochObservationOriginal, now int64) error {
+	r := e.upload
+	var current nextcloudEpochCurrentControl
+	err := bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Select("id,tenant_id,knowledge_base_id,generation_id,revision,present,observation_id,control_sha256,verified_at_ms").Where("id=?", r.receipt.DataSourceID).Take(&current).Error
+	exists := err == nil
+	if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+		return err
+	}
+	if exists {
+		if current.TenantID != generation.TenantID || current.KnowledgeBaseID != generation.KnowledgeBaseID || current.GenerationID != generation.GenerationID || current.Revision <= 0 || current.Present != 1 {
+			return ErrKnowledgeInputChanged
+		}
+		if err = e.claimNoEventEpochRowsInTx(tx, []originalBodyAvailabilityRow{{current.TableName(), current.ID}}); err != nil {
+			return err
+		}
+		var held nextcloudEpochCurrentControl
+		if err = tx.WithContext(e.hydrationContext(tx.Statement.Context)).Where("id=?", current.ID).Take(&held).Error; err != nil {
+			return err
+		}
+		metadata := held
+		metadata.ControlJSON = ""
+		if !reflect.DeepEqual(metadata, current) || bodySHA([]byte(held.ControlJSON)) != current.ControlSHA256 {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	revision := int64(1)
+	if exists {
+		revision = current.Revision + 1
+		if revision <= current.Revision {
+			return ErrKnowledgeInputChanged
+		}
+	}
+	control := nextcloudEpochCurrentControl{ID: r.receipt.DataSourceID, TenantID: generation.TenantID, KnowledgeBaseID: generation.KnowledgeBaseID, GenerationID: generation.GenerationID, Revision: revision, Present: 1, ObservationID: fact.ID, VerifiedAtMS: now}
+	raw, err := json.Marshal(struct {
+		Source, Generation, Observation, Digest string
+		Revision                                int64
+	}{control.ID, control.GenerationID, control.ObservationID, fact.Digest, control.Revision})
+	if err != nil {
+		return err
+	}
+	control.ControlJSON = string(raw)
+	control.ControlSHA256 = bodySHA(raw)
+	ctx := context.WithValue(r.ctx, nextcloudNoEventEpochProducerKey{}, nextcloudNoEventEpochProducer{r, control.TableName(), control.ID, control.ControlSHA256})
+	if exists {
+		q := tx.WithContext(ctx).Model(&control).Where("id=? AND generation_id=? AND revision=? AND observation_id=?", current.ID, current.GenerationID, current.Revision, current.ObservationID).Updates(map[string]interface{}{"revision": control.Revision, "present": control.Present, "observation_id": control.ObservationID, "control_json": control.ControlJSON, "control_sha256": control.ControlSHA256, "verified_at_ms": control.VerifiedAtMS})
+		if q.Error != nil {
+			return q.Error
+		}
+		if q.RowsAffected != 1 {
+			return ErrKnowledgeInputChanged
+		}
+	} else if err = tx.WithContext(ctx).Create(&control).Error; err != nil {
+		return err
+	}
+	return e.claimNoEventEpochRowsInTx(tx, []originalBodyAvailabilityRow{{control.TableName(), control.ID}})
+}
diff --git a/internal/application/repository/nextcloud_noevent_epoch_original.go b/internal/application/repository/nextcloud_noevent_epoch_original.go
new file mode 100644
index 0000000000000000000000000000000000000000..ff3d449ab0b1ce58213bcb77ee5db2014762bb15
--- /dev/null
+++ b/internal/application/repository/nextcloud_noevent_epoch_original.go
@@ -0,0 +1,259 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"time"
+
+	nextcloudconnector "github.com/Tencent/WeKnora/internal/datasource/connector/nextcloud"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+type nextcloudEpochProtocolOrigin struct {
+	ID                                                                    string `gorm:"primaryKey"`
+	TenantID                                                              uint64
+	KnowledgeBaseID, GenerationID, AnchorJSON, AnchorSHA256, SchemaDigest string
+	CreatedAtMS                                                           int64
+}
+
+func (nextcloudEpochProtocolOrigin) TableName() string { return "nextcloud_epoch_protocol_origins" }
+
+type nextcloudEpochObservationOriginal struct {
+	ID                                                                 string `gorm:"primaryKey"`
+	TenantID                                                           uint64
+	KnowledgeBaseID                                                    string
+	DataSourceID                                                       string `gorm:"column:datasource_id"`
+	GenerationID, PairOperationID, InstanceID, BindingID, ConfigSHA256 string
+	PublicationEpoch                                                   int64
+	PublicationState                                                   string
+	ObservationJSON, ObservationSHA256, Digest                         string
+	CreatedAtMS                                                        int64
+}
+
+func (nextcloudEpochObservationOriginal) TableName() string {
+	return "nextcloud_epoch_observation_originals"
+}
+
+type nextcloudEpochCurrentControl struct {
+	ID                                        string `gorm:"primaryKey"`
+	TenantID                                  uint64
+	KnowledgeBaseID, GenerationID             string
+	Revision                                  int64
+	Present                                   int64
+	ObservationID, ControlJSON, ControlSHA256 string
+	VerifiedAtMS                              int64
+}
+
+func (nextcloudEpochCurrentControl) TableName() string { return "nextcloud_epoch_current_controls" }
+
+type nextcloudNoEventEpochProducerKey struct{}
+type nextcloudNoEventEpochProducer struct {
+	Read           *nextcloudOriginalUploadRead
+	Table, ID, SHA string
+}
+
+// A body callback sees only this actual fixed producer's private context. The
+// context selector is not accepted as an observation or a permission grant.
+func validateNextcloudNoEventEpochProducer(tx *gorm.DB, d originalBodyFieldDescriptor) error {
+	if d.Table != "nextcloud_epoch_protocol_origins" && d.Table != "nextcloud_epoch_observation_originals" && d.Table != "nextcloud_epoch_current_controls" {
+		return nil
+	}
+	p, _ := tx.Statement.Context.Value(nextcloudNoEventEpochProducerKey{}).(nextcloudNoEventEpochProducer)
+	if p.Read == nil || p.Table != d.Table || p.ID == "" || len(p.SHA) != 64 || nextcloudOriginalUploadInContext(tx.Statement.Context) != p.Read {
+		return ErrKnowledgeInputChanged
+	}
+	if err := p.Read.samePool(tx); err != nil {
+		return err
+	}
+	// This is an AfterCreate/AfterUpdate callback: the producer INSERT/UPDATE
+	// SQL and model remain live until GORM's processor tail resets them. Never
+	// pass that statement to authority queries. NewDB and Context in ONE Session
+	// keep the same owning ConnPool/caller while the next query resets SQL/model.
+	actorTX := tx.Session(&gorm.Session{NewDB: true, Context: tx.Statement.Context})
+	if err := p.Read.checkActorInTx(actorTX); err != nil {
+		return err
+	}
+	row, err := bodySourceRow(tx, d, p.ID)
+	if err != nil {
+		return err
+	}
+	column := ""
+	switch d.Table {
+	case "nextcloud_epoch_protocol_origins":
+		column = "anchor_json"
+	case "nextcloud_epoch_observation_originals":
+		column = "observation_json"
+	case "nextcloud_epoch_current_controls":
+		column = "control_json"
+	}
+	if bodyText(row[d.Key]) != p.ID || bodyUint(row["tenant_id"]) != p.Read.payload.TenantID || bodyText(row["knowledge_base_id"]) != p.Read.payload.KnowledgeBaseID || bodySHA([]byte(bodyText(row[column]))) != p.SHA {
+		return ErrKnowledgeInputChanged
+	}
+	return tx.Statement.Context.Err()
+}
+func nextcloudEpochOriginalDigest(v nextcloudEpochObservationOriginal) (string, error) {
+	v.Digest = ""
+	v.ObservationJSON = ""
+	return KnowledgeInputDigest(v)
+}
+
+// Only the actual upload holder can call this fixed producer. It chooses the
+// configured source itself, invokes the real connector and keeps the current
+// actor/build/source checks. It never accepts an epoch, source DTO or callback.
+func (e *NextcloudNoEventEpochRead) produceNoEventEpochInTx(tx *gorm.DB) (nextcloudEpochObservationOriginal, error) {
+	r := e.upload
+	if err := r.samePool(tx); err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	if err := r.checkActorInTx(tx); err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	if err := r.content.ValidateBuildLeaseInTx(r.ctx, tx, r.build.lease, r.build.scope); err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	generation, err := e.heldNoEventEpochGenerationInTx(tx)
+	if err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	e.generation = generation
+	var source struct {
+		Config []byte
+		Type   string
+	}
+	if err = tx.Table("data_sources").Select("config,type").Where("id=? AND tenant_id=? AND knowledge_base_id=? AND status='active' AND deleted_at IS NULL", r.receipt.DataSourceID, r.payload.TenantID, r.payload.KnowledgeBaseID).Take(&source).Error; err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	var dsConfig = source.Config
+	ds := &types.DataSource{Config: dsConfig, Type: source.Type}
+	config, err := ds.ParseConfig()
+	if err == nil {
+		config.Type = source.Type
+		err = nextcloudconnector.VerifyOriginalArtifactConfiguration(config, r.actual.Artifact)
+	}
+	if err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	actual, err := nextcloudconnector.InspectPairing(e.ctx, config)
+	if err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	if actual.InstanceID != r.actual.Artifact.InstanceID || actual.BindingID != r.actual.Artifact.BindingID || actual.BaseURL != r.actual.BaseURL || actual.PublicationState != "active" || actual.PublicationEpoch < 0 {
+		return nextcloudEpochObservationOriginal{}, ErrNextcloudOnboardingDenied
+	}
+	// No raw epoch or supplied source shape can reach this original constructor.
+	raw, err := json.Marshal(actual)
+	if err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	fact := nextcloudEpochObservationOriginal{ID: uuid.NewString(), TenantID: r.payload.TenantID, KnowledgeBaseID: r.payload.KnowledgeBaseID, DataSourceID: r.receipt.DataSourceID, GenerationID: generation.GenerationID, PairOperationID: r.actual.PairOperation, InstanceID: actual.InstanceID, BindingID: actual.BindingID, ConfigSHA256: r.actual.ConfigSHA, PublicationEpoch: actual.PublicationEpoch, PublicationState: actual.PublicationState, ObservationJSON: string(raw), ObservationSHA256: bodySHA(raw), CreatedAtMS: now}
+	fact.Digest, err = nextcloudEpochOriginalDigest(fact)
+	if err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	ctx := context.WithValue(r.ctx, nextcloudNoEventEpochProducerKey{}, nextcloudNoEventEpochProducer{r, fact.TableName(), fact.ID, fact.ObservationSHA256})
+	if err = tx.WithContext(ctx).Create(&fact).Error; err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	if err = e.claimNoEventEpochRowsInTx(tx, []originalBodyAvailabilityRow{{fact.TableName(), fact.ID}}); err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	if err = r.checkActorInTx(tx); err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	if err = e.publishNoEventEpochControlInTx(tx, generation, fact, now); err != nil {
+		return nextcloudEpochObservationOriginal{}, err
+	}
+	return fact, r.ctx.Err()
+}
+
+// The retained generation is authenticated through the existing 152 external
+// journal and actual body mirror, then compared to current catalogue identity.
+// Cookie/OID differences detect table replacement; they do not prove a complete
+// coordinated database/journal restore was impossible.
+func (e *NextcloudNoEventEpochRead) heldNoEventEpochGenerationInTx(tx *gorm.DB) (nextcloudEpochProtocolOrigin, error) {
+	r := e.upload
+	var generation nextcloudEpochProtocolOrigin
+	q := bodyInternal(tx).Select("id,tenant_id,knowledge_base_id,generation_id,anchor_sha256,schema_digest,created_at_ms").Where("id=? AND tenant_id=? AND knowledge_base_id=?", r.receipt.DataSourceID, r.payload.TenantID, r.payload.KnowledgeBaseID).Take(&generation)
+	if errors.Is(q.Error, gorm.ErrRecordNotFound) {
+		return e.authorNoEventEpochGenerationInTx(tx)
+	}
+	if q.Error != nil {
+		return generation, q.Error
+	}
+	if err := e.claimNoEventEpochRowsInTx(tx, []originalBodyAvailabilityRow{{generation.TableName(), generation.ID}}); err != nil {
+		return generation, err
+	}
+	var actual nextcloudEpochProtocolOrigin
+	if err := tx.WithContext(e.hydrationContext(tx.Statement.Context)).Where("id=?", generation.ID).Take(&actual).Error; err != nil {
+		return generation, err
+	}
+	metadata := actual
+	metadata.AnchorJSON = ""
+	if !reflect.DeepEqual(metadata, generation) || bodySHA([]byte(actual.AnchorJSON)) != generation.AnchorSHA256 {
+		return generation, ErrOriginalBodyUnavailable
+	}
+	identity, err := nextcloudNoEventEpochSchemaIdentity(tx)
+	if err != nil || identity != generation.SchemaDigest {
+		return generation, ErrKnowledgeInputChanged
+	}
+	var anchor struct {
+		Source, Pair, Generation, Schema string
+		Tenant                           uint64
+		KB                               string
+	}
+	if json.Unmarshal([]byte(actual.AnchorJSON), &anchor) != nil || anchor.Source != actual.ID || anchor.Pair != r.actual.PairOperation || anchor.Generation != actual.GenerationID || anchor.Schema != actual.SchemaDigest || anchor.Tenant != actual.TenantID || anchor.KB != actual.KnowledgeBaseID {
+		return actual, ErrKnowledgeInputChanged
+	}
+	return actual, r.ctx.Err()
+}
+
+func (e *NextcloudNoEventEpochRead) claimNoEventEpochRowsInTx(tx *gorm.DB, rows []originalBodyAvailabilityRow) error {
+	r := e.upload
+	if err := checkOriginalBodyAvailableBatchInTx(r.ctx, tx, rows); err != nil {
+		return err
+	}
+	heads, err := originalBodyBatchHeads(tx, rows)
+	if err != nil || len(heads) != len(rows) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, head := range heads {
+		if _, ok := e.leases[head.BodyID]; ok {
+			continue
+		}
+		id, err := NewOriginalBodyRetentionStore(tx).acquireLeaseInTx(tx, head.BodyID, "read", "nextcloud-noevent-epoch/"+r.payload.KnowledgeID, 15*time.Minute)
+		if err != nil {
+			return err
+		}
+		var lease originalBodyLease
+		if err = bodyInternal(tx).Where("lease_id=?", id).Take(&lease).Error; err != nil {
+			return err
+		}
+		var payload originalBodyPayload
+		if err = bodyInternal(tx).Where("id=?", head.BodyID).Take(&payload).Error; err != nil {
+			return err
+		}
+		e.leases[head.BodyID] = lease
+		e.bodies[head.BodyID] = payload
+		retained := e.heads[:0]
+		for _, old := range e.heads {
+			if old.SlotID == head.SlotID {
+				if old.BodyID != head.BodyID {
+					e.predecessors[old.BodyID] = true
+				}
+			} else {
+				retained = append(retained, old)
+			}
+		}
+		e.heads = append(retained, head)
+	}
+	e.rows = knowledgeSQLiteUniqueBodyRows(append(e.rows, rows...))
+	return checkOriginalBodyAvailableBatchForCapturedInTx(r.ctx, tx, e.rows, e.heads)
+}
