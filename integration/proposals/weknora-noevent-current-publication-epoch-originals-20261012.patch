+func noEventNextcloudCurrentEpochActual(t *testing.T, pg bool) {
+	modes := []string{"signed_noevent_sdk_publication", "epoch_lease_before_hydration", "epoch_after_SDK", "source_after_SDK", "model_after_SDK", "epoch_anchor_body_after_SDK", "late_result_content_union_clock", "arbitrary_epoch_DTO_refuses", "same_epoch_successor_does_not_refresh_reader", "table_reset_does_not_rebootstrap", "owned_close_waits_check", "concurrent_rechecks_preserve_captured_state"}
+	if pg {
+		modes = []string{"signed_noevent_upload_epoch", "epoch_after_capture", "arbitrary_epoch_DTO_refuses"}
+	}
+	for _, mode := range modes {
+		t.Run(mode, func(t *testing.T) {
+			knowledgeSQLiteOriginalVecAuto.Do(sqlite_vec.Auto)
+			m := newMachinePipelineFixtureWithDocument(t, pg, strings.Repeat("# Actual source\n\nOriginal delegated document input. ", 8), true, true, true)
+			f := m.f
