@@ -0,0 +1,27 @@
+package repository
+
+// The producer owns the exact current tuple. Recheck never follows a successor
+// observation. All equality arguments came from the authenticated constructor.
+func (e *NextcloudNoEventEpochRead) publicationFinalSQL() (string, []interface{}) {
+	g, o, c := e.generation, e.observation, e.control
+	query := `SELECT g.generation_id AS publication_connection_id,o.pair_operation_id AS publication_pair_operation_id,o.publication_epoch AS publication_epoch,c.verified_at_ms AS publication_verified_at
+ FROM nextcloud_epoch_current_controls c
+ JOIN nextcloud_epoch_protocol_origins g ON g.id=c.id AND g.generation_id=c.generation_id AND g.tenant_id=c.tenant_id AND g.knowledge_base_id=c.knowledge_base_id
+ JOIN nextcloud_epoch_observation_originals o ON o.id=c.observation_id AND o.datasource_id=c.id AND o.generation_id=c.generation_id AND o.tenant_id=c.tenant_id AND o.knowledge_base_id=c.knowledge_base_id
+ JOIN nextcloud_source_pairings p ON p.operation_id=o.pair_operation_id AND p.datasource_id=c.id AND p.tenant_id=c.tenant_id AND p.knowledge_base_id=c.knowledge_base_id AND p.state='active' AND p.nextcloud_instance_id=o.instance_id AND p.binding_id=o.binding_id AND p.datasource_config_sha256=o.config_sha256
+ JOIN data_sources d ON d.id=c.id AND d.tenant_id=c.tenant_id AND d.knowledge_base_id=c.knowledge_base_id AND d.type='nextcloud' AND d.status='active' AND d.deleted_at IS NULL
+ WHERE c.id=? AND c.tenant_id=? AND c.knowledge_base_id=? AND c.generation_id=? AND c.revision=? AND c.present=? AND c.observation_id=? AND c.control_json=? AND c.control_sha256=? AND c.verified_at_ms=?
+ AND g.anchor_json=? AND g.anchor_sha256=? AND g.schema_digest=? AND g.created_at_ms=?
+ AND (` + nextcloudNoEventEpochCatalogueGuardSQL(e.db.Dialector.Name()) + `)=?
+ AND o.pair_operation_id=? AND o.instance_id=? AND o.binding_id=? AND o.config_sha256=? AND o.publication_epoch=? AND o.publication_state=? AND o.observation_json=? AND o.observation_sha256=? AND o.digest=? AND o.created_at_ms=?`
+	return query, []interface{}{c.ID, c.TenantID, c.KnowledgeBaseID, c.GenerationID, c.Revision, c.Present, c.ObservationID, c.ControlJSON, c.ControlSHA256, c.VerifiedAtMS, g.AnchorJSON, g.AnchorSHA256, g.SchemaDigest, g.CreatedAtMS, e.catalogueGuard, o.PairOperationID, o.InstanceID, o.BindingID, o.ConfigSHA256, o.PublicationEpoch, o.PublicationState, o.ObservationJSON, o.ObservationSHA256, o.Digest, o.CreatedAtMS}
+}
+func (e *NextcloudNoEventEpochRead) checkPublicationFinalRow(row nextcloudOriginalFinalRow, observed nextcloudOriginalPublicationEpoch) error {
+	if row.PublicationConnectionID != e.generation.GenerationID || row.PublicationPairOperationID != e.observation.PairOperationID || row.PublicationEpoch != e.observation.PublicationEpoch || row.PublicationVerifiedAt != e.control.VerifiedAtMS || observed.ConnectionID != e.generation.GenerationID || observed.PublicationEpoch != e.observation.PublicationEpoch {
+		return ErrKnowledgeInputChanged
+	}
+	if row.PublicationVerifiedAt <= 0 || row.PublicationVerifiedAt > row.FinalClockMS || row.FinalClockMS-row.PublicationVerifiedAt > 300000 {
+		return ErrNextcloudOnboardingDenied
+	}
+	return e.ctx.Err()
+}
