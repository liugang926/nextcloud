+ id TEXT PRIMARY KEY NOT NULL REFERENCES data_sources(id), tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL REFERENCES knowledge_bases(id), generation_id TEXT NOT NULL UNIQUE,
+ anchor_json TEXT NOT NULL, anchor_sha256 TEXT NOT NULL CHECK(length(anchor_sha256)=64),
+ schema_digest TEXT NOT NULL CHECK(length(schema_digest)=64), created_at_ms INTEGER NOT NULL
+);
+CREATE TABLE nextcloud_epoch_observation_originals (
+ id TEXT PRIMARY KEY NOT NULL, tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL REFERENCES knowledge_bases(id), datasource_id TEXT NOT NULL REFERENCES data_sources(id),
+ generation_id TEXT NOT NULL REFERENCES nextcloud_epoch_protocol_origins(generation_id),
+ pair_operation_id TEXT NOT NULL, instance_id TEXT NOT NULL, binding_id TEXT NOT NULL,
+ config_sha256 TEXT NOT NULL CHECK(length(config_sha256)=64), publication_epoch INTEGER NOT NULL CHECK(publication_epoch>=0),
+ publication_state TEXT NOT NULL CHECK(publication_state IN('active','legacy')),
+ observation_json TEXT NOT NULL,
+ observation_sha256 TEXT NOT NULL CHECK(length(observation_sha256)=64), digest TEXT NOT NULL UNIQUE CHECK(length(digest)=64),
+ created_at_ms INTEGER NOT NULL
+);
+CREATE TABLE nextcloud_epoch_current_controls (
+ id TEXT PRIMARY KEY NOT NULL REFERENCES data_sources(id), tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL REFERENCES knowledge_bases(id), generation_id TEXT NOT NULL REFERENCES nextcloud_epoch_protocol_origins(generation_id),
+ revision INTEGER NOT NULL CHECK(revision>0), present INTEGER NOT NULL CHECK(present IN(0,1)),
+ observation_id TEXT NOT NULL REFERENCES nextcloud_epoch_observation_originals(id),
+ control_json TEXT NOT NULL, control_sha256 TEXT NOT NULL CHECK(length(control_sha256)=64),
+ verified_at_ms INTEGER NOT NULL
+);
+CREATE TRIGGER nextcloud_epoch_protocol_update BEFORE UPDATE ON nextcloud_epoch_protocol_origins BEGIN SELECT RAISE(ABORT,'nextcloud_epoch_original_immutable'); END;
+CREATE TRIGGER nextcloud_epoch_protocol_delete BEFORE DELETE ON nextcloud_epoch_protocol_origins BEGIN SELECT RAISE(ABORT,'nextcloud_epoch_original_immutable'); END;
+CREATE TRIGGER nextcloud_epoch_observation_update BEFORE UPDATE ON nextcloud_epoch_observation_originals BEGIN SELECT RAISE(ABORT,'nextcloud_epoch_original_immutable'); END;
+CREATE TRIGGER nextcloud_epoch_observation_delete BEFORE DELETE ON nextcloud_epoch_observation_originals BEGIN SELECT RAISE(ABORT,'nextcloud_epoch_original_immutable'); END;
