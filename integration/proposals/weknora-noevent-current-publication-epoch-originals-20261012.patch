+	}
+	return original[:begin] + "BEGIN IF TG_OP='UPDATE' AND (" + condition + ") THEN RETURN NEW; END IF;" + original[begin+len("BEGIN"):], nil
+}
+func nextcloudEpochSQLSame(a, b string) bool {
+	return reflect.DeepEqual(nextcloudEpochSQLTokens(a), nextcloudEpochSQLTokens(b))
+}
+
+// Only whole-expression parentheses and typed bigint literal casts from the
+// compiled pending172 checks are representation differences. Unknown tokens
+// retain their exact type/literal meaning and are refused by the fixed set.
+func nextcloudEpochExpression(s string) string {
+	tokens := nextcloudEpochSQLTokens(s)
+	projected := []string{}
+	for i := 0; i < len(tokens); i++ {
+		if i+4 < len(tokens) && tokens[i] == "(" && (tokens[i+1] == "0" || tokens[i+1] == "1" || tokens[i+1] == "64") && tokens[i+2] == ")" && tokens[i+3] == "::" && tokens[i+4] == "bigint" {
+			projected = append(projected, tokens[i+1])
+			i += 4
+			continue
+		}
+		projected = append(projected, tokens[i])
+	}
+	tokens = projected
+	for len(tokens) > 1 && tokens[0] == "(" && tokens[len(tokens)-1] == ")" {
+		depth := 0
+		whole := true
+		for i, t := range tokens {
+			if t == "(" {
+				depth++
+			}
+			if t == ")" {
+				depth--
+			}
+			if depth == 0 && i < len(tokens)-1 {
+				whole = false
+				break
+			}
+		}
+		if !whole {
+			break
+		}
+		tokens = tokens[1 : len(tokens)-1]
+	}
+	out := []string{}
+	for i := 0; i < len(tokens); i++ {
+		if i+2 < len(tokens) && (tokens[i] == "0" || tokens[i] == "1" || tokens[i] == "64") && tokens[i+1] == "::" && tokens[i+2] == "bigint" {
+			out = append(out, tokens[i])
+			i += 2
+			continue
+		}
+		out = append(out, tokens[i])
+	}
+	return strings.Join(out, " ")
+}
+func nextcloudEpochSQLTokens(sqlText string) []string {
+	out := []string{}
+	for i := 0; i < len(sqlText); {
+		c := sqlText[i]
+		if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
+			i++
+			continue
+		}
+		if i+1 < len(sqlText) && sqlText[i:i+2] == "--" {
+			for i < len(sqlText) && sqlText[i] != '\n' {
+				i++
+			}
+			continue
+		}
+		if c == '\'' || c == '"' {
+			quote := c
+			start := i
+			i++
+			for i < len(sqlText) {
+				if sqlText[i] == quote {
+					if i+1 < len(sqlText) && sqlText[i+1] == quote {
+						i += 2
+						continue
+					}
+					i++
+					break
+				}
+				i++
+			}
+			token := sqlText[start:i]
+			if quote == '"' {
+				token = strings.ToLower(strings.ReplaceAll(token[1:len(token)-1], "\"\"", "\""))
+			}
+			out = append(out, token)
+			continue
+		}
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' || c >= '0' && c <= '9' {
+			start := i
+			i++
+			for i < len(sqlText) {
+				c = sqlText[i]
+				if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' || c >= '0' && c <= '9') {
+					break
+				}
+				i++
+			}
+			out = append(out, strings.ToLower(sqlText[start:i]))
+			continue
+		}
+		if i+1 < len(sqlText) {
+			two := sqlText[i : i+2]
+			if two == "::" || two == "<>" || two == ">=" || two == "<=" || two == "!=" || two == "->" {
+				out = append(out, two)
+				i += 2
+				continue
+			}
+		}
+		out = append(out, string(c))
+		i++
+	}
+	return out
+}
