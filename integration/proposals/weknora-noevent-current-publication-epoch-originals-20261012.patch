+				pool, e := f.db.DB()
+				require.NoError(t, e)
+				pool.SetMaxOpenConns(2)
+				pool.SetMaxIdleConns(2)
+			}
+			if pg {
+				installNextcloudCurrentEpoch172ForTest(t, f.db)
+			} else {
+				installKnowledgeSQLiteOriginal90ForTest(t, f.db)
+				installNextcloudCurrentEpoch93ForTest(t, f.db)
+			}
+			leaseClock := "CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)"
+			if pg {
+				leaseClock = "CAST(EXTRACT(EPOCH FROM clock_timestamp())*1000 AS BIGINT)"
+			}
+			artifact := strings.Repeat("# Actual source\n\nOriginal delegated document input. ", 8)
+			sourceEpoch := &atomic.Int64{}
+			sourceEpoch.Store(1)
+			sourceHTTP, sourceAllowed, signedRequests, sourceError := ownedMachineSourceTransport(t, artifact, sourceEpoch)
+			t.Setenv("WEKNORA_NEXTCLOUD_ALLOWED_ORIGINS", sourceHTTP.URL)
+			var calls atomic.Int64
+			var faultApplied atomic.Bool
+			var reachedExpiry atomic.Bool
+			var mu sync.Mutex
+			var callbackErr error
+			var transmitted [][]string
+			fail := func(err error) { mu.Lock(); callbackErr = errors.Join(callbackErr, err); mu.Unlock() }
+			var operation types.NextcloudOnboardingOperation
+			var heldEpoch *repository.NextcloudNoEventEpochRead
+			var actualModels interfaces.ModelService
+			var actualModelID, actualKnowledgeID string
+			var clockInstalled bool
+			t.Cleanup(func() {
+				if clockInstalled {
+					if e := f.db.Callback().Row().Remove("noevent-nextcloud-final-content-clock"); e != nil {
+						t.Error(e)
+					}
+				}
+			})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				var wire struct {
+					Input      []string `json:"input"`
+					Dimensions int      `json:"dimensions"`
+				}
+				if err := json.NewDecoder(r.Body).Decode(&wire); err != nil {
+					fail(err)
+					w.WriteHeader(400)
+					return
+				}
+				if r.URL.Path != "/embeddings" || r.Header.Get("Authorization") != "Bearer owned-purpose-key" || wire.Dimensions != 2 {
+					fail(errors.New("actual embedding wire recipe mismatch"))
+					w.WriteHeader(400)
+					return
+				}
+				mu.Lock()
+				transmitted = append(transmitted, append([]string(nil), wire.Input...))
+				mu.Unlock()
+				if mode == "delegation_after_SDK" {
+					result := f.db.Session(&gorm.Session{NewDB: true}).Where("tenant_id=? AND directory_id=? AND object_guid=?", operation.TenantID, operation.ActorDirectoryID, operation.ActorObjectGUID).Delete(&types.NextcloudOnboardingDelegation{})
+					if result.Error != nil || result.RowsAffected != 1 {
+						fail(errors.New("actual delegation removal failed"))
+					} else {
+						var n int64
+						if e := f.db.Session(&gorm.Session{NewDB: true}).Model(&types.NextcloudOnboardingDelegation{}).Where("tenant_id=? AND directory_id=? AND object_guid=?", operation.TenantID, operation.ActorDirectoryID, operation.ActorObjectGUID).Count(&n).Error; e != nil || n != 0 {
+							fail(errors.New("actual delegation readback failed"))
+						} else {
+							faultApplied.Store(true)
+						}
+					}
+				}
+				if mode == "source_after_SDK" {
+					sourceAllowed.Store(false)
+					faultApplied.Store(true)
