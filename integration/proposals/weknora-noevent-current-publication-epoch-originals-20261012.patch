+func installNextcloudCurrentEpoch93ForTest(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	var path string
+	require.NoError(t, db.Raw("SELECT file FROM pragma_database_list WHERE name='main'").Scan(&path).Error)
+	require.NotEmpty(t, path)
+	root, err := filepath.Abs("../../..")
+	require.NoError(t, err)
+	source := t.TempDir()
+	files, err := filepath.Glob(filepath.Join(root, "migrations/sqlite", "*.sql"))
+	require.NoError(t, err)
+	require.NotEmpty(t, files)
+	for _, file := range files {
+		data, err := os.ReadFile(file)
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(filepath.Join(source, filepath.Base(file)), data, 0600))
+	}
+	for _, entry := range []struct{ Directory, Name string }{
+		{"migrations/pending/knowledge-sqlite-embedding-originals-000090", "000090_knowledge_sqlite_embedding_originals.up.sql"},
+		{"migrations/pending/knowledge-sqlite-embedding-originals-000090", "000090_knowledge_sqlite_embedding_originals.down.sql"},
+		{"migrations/pending/nextcloud-current-publication-epoch-originals/sqlite", "000093_nextcloud_current_publication_epoch_originals.up.sql"},
+		{"migrations/pending/nextcloud-current-publication-epoch-originals/sqlite", "000093_nextcloud_current_publication_epoch_originals.down.sql"},
+	} {
+		data, err := os.ReadFile(filepath.Join(root, entry.Directory, entry.Name))
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(filepath.Join(source, entry.Name), data, 0600))
+	}
+	migration, err := migrate.New("file://"+source, "sqlite3://"+path)
+	require.NoError(t, err)
+	require.NoError(t, migration.Migrate(93))
+	sc, dc := migration.Close()
+	require.NoError(t, sc)
+	require.NoError(t, dc)
+	var ledger struct {
+		Version uint
+		Dirty   bool
+	}
+	require.NoError(t, db.Table("schema_migrations").Take(&ledger).Error)
+	require.EqualValues(t, 93, ledger.Version)
+	require.False(t, ledger.Dirty)
+	require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(db))
+	require.NoError(t, repository.InstallOriginalBodyRetentionCallbacks(db))
+}
+
+// The existing fixture genuinely migrated canonical168 and initialized body152.
+// This independent pending172 prelude keeps that ledger/source, without Force,
+// aliases, replaying peer history or adding an empty PG vector module.
+func installNextcloudCurrentEpoch172ForTest(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	root, err := filepath.Abs("../../..")
+	require.NoError(t, err)
+	source := t.TempDir()
+	files, err := filepath.Glob(filepath.Join(root, "migrations/versioned", "*.sql"))
+	require.NoError(t, err)
+	require.NotEmpty(t, files)
+	for _, file := range files {
+		data, err := os.ReadFile(file)
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(filepath.Join(source, filepath.Base(file)), data, 0600))
+	}
+	for _, name := range []string{"000172_nextcloud_current_publication_epoch_originals.up.sql", "000172_nextcloud_current_publication_epoch_originals.down.sql"} {
+		data, err := os.ReadFile(filepath.Join(root, "migrations/pending/nextcloud-current-publication-epoch-originals/versioned", name))
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(filepath.Join(source, name), data, 0600))
+	}
+	var schema string
+	require.NoError(t, db.Raw("SELECT current_schema()").Scan(&schema).Error)
+	require.NotEmpty(t, schema)
+	config, err := pgconn.ParseConfig(os.Getenv("WEKNORA_AUTO_TAG_TEST_POSTGRES_DSN"))
+	require.NoError(t, err)
+	uri := &url.URL{Scheme: "postgres", User: url.UserPassword(config.User, config.Password), Host: net.JoinHostPort(config.Host, strconv.Itoa(int(config.Port))), Path: "/" + config.Database}
+	query := uri.Query()
+	query.Set("sslmode", "disable")
+	for key, value := range config.RuntimeParams {
+		query.Set(key, value)
+	}
+	query.Set("search_path", schema+",public")
+	query.Set("options", strings.TrimSpace(query.Get("options")+" -c app.skip_embedding=true"))
+	uri.RawQuery = query.Encode()
+	migration, err := migrate.New("file://"+source, uri.String())
+	require.NoError(t, err)
+	require.NoError(t, migration.Migrate(172))
+	sc, dc := migration.Close()
+	require.NoError(t, sc)
+	require.NoError(t, dc)
+	var ledger struct {
+		Version uint
+		Dirty   bool
+	}
+	require.NoError(t, db.Table("schema_migrations").Take(&ledger).Error)
+	require.EqualValues(t, 172, ledger.Version)
+	require.False(t, ledger.Dirty)
+	require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(db))
+	require.NoError(t, repository.InstallOriginalBodyRetentionCallbacks(db))
+}
