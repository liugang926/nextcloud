+					observerErr = err
+					return
+				}
+				if outputs == 0 {
+					return
+				}
+				if outputs != 1 {
+					observerErr = fmt.Errorf("actual final operation has %d output receipts", outputs)
+					return
+				}
+				if !ids[chosen.LeaseID] {
