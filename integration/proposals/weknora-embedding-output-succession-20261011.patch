+func (read *memoryEmbeddingRead) acquireMemoryEmbeddingParentHoldsInTx(tx *gorm.DB, fact *types.MemoryEmbeddingOriginal) error {
+	if !fact.BaseVectorPresent {
+		return nil
+	}
+	parent, err := loadMemoryEmbeddingReceipt(tx, fact.ParentReceiptID)
+	if err != nil {
+		return err
+	}
+	original, err := memoryEmbeddingReceiptOriginInTx(tx, memoryScope(fact.TenantID, fact.SubjectID), fact.ItemID, parent)
+	if err != nil {
+		return err
+	}
+	entries := []struct{ table, id, sha, digest string }{{original.TableName(), original.ID, original.InputSHA256, original.Digest}, {parent.TableName(), parent.ID, parent.VectorJSONSHA256, parent.Digest}}
+	if fact.ParentRankID != "" {
+		rank, err := loadMemoryEmbeddingRankReceipt(tx, fact.ParentRankID)
+		if err != nil {
+			return err
+		}
+		entries = append(entries, struct{ table, id, sha, digest string }{rank.TableName(), rank.ID, rank.RankVectorDigest, rank.Digest})
+	}
+	owner := "memory-embedding-parent/" + uuid.NewString()
+	for _, entry := range entries {
+		head, err := checkMemoryEmbeddingBodyReceiptInTx(tx, entry.table, entry.id, fact.TenantID, entry.sha, entry.digest)
+		if err != nil {
+			return err
+		}
+		id, err := NewOriginalBodyRetentionStore(tx).acquireLeaseInTx(tx, head.BodyID, "read", owner, 15*time.Minute)
+		if err != nil {
+			return err
+		}
+		var lease originalBodyLease
+		if err = bodyInternal(tx).Where("lease_id=?", id).Take(&lease).Error; err != nil {
+			return err
+		}
+		read.parentBindings[id] = lease
+		read.parentHeads[head.SlotID] = head
+	}
+	return nil
+}
+
+func (read *memoryEmbeddingRead) checkMemoryEmbeddingFinalClockInTx(tx *gorm.DB, derived *memoryDerivedHold) (resultErr error) {
+	vector, _ := tx.Statement.Context.Value(memoryEmbeddingVectorReadKey{}).(*memoryEmbeddingVectorRead)
+	if vector != nil {
+		if !sameMemoryEmbeddingPool(vector.repo.db, tx) || !sameOriginalModelCallerInRepository(tx.Statement.Context, vector.ctx) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err := vector.start(); err != nil {
+			return err
+		}
+		// A brief state lock establishes Add before Close may Wait. No state
+		// mutex is held while the caller-owned SQL transaction waits or queries.
+		defer func() { resultErr = vector.finish(resultErr) }()
+	}
+	if err := read.repo.checkMemoryGeneratedFinalClockInTx(tx, read.clock, derived); err != nil {
+		return err
+	}
+	if derived == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	all := map[string]originalBodyLease{read.clock.Lease.LeaseID: read.clock.Lease}
+	for _, bindings := range []map[string]originalBodyLease{derived.Leases, read.clock.Policy.Leases, read.clock.ModelBindings, read.parentBindings} {
+		if err := mergeMemoryFinalLeaseBindings(all, bindings); err != nil {
+			return err
+		}
+	}
+	for _, policy := range derived.Policies {
+		if err := mergeMemoryFinalLeaseBindings(all, policy.Leases); err != nil {
+			return err
+		}
+	}
+	coverage, _ := tx.Statement.Context.Value(faqReadLeaseCoverageKey{}).(faqReadLeaseCoverage)
+	content := append([]NextcloudContentLease(nil), coverage.Leases...)
+	contexts := []context.Context{tx.Statement.Context, read.ctx}
+	if vector != nil {
+		bindings, err := MemoryEmbeddingVectorLeaseBindings(tx.Statement.Context)
+		if err != nil {
+			return err
+		}
+		captured := map[string]originalBodyLease{}
+		for _, binding := range bindings {
+			captured[binding.LeaseID] = originalBodyLease{LeaseID: binding.LeaseID, BodyID: binding.BodyID, OwnerID: binding.OwnerID, Kind: binding.Kind, Epoch: binding.Epoch}
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, captured); err != nil {
+			return err
+		}
+		contexts = append(contexts, vector.ctx)
+	}
+	// The result capability is inherited by a rank/vector consumer. Copy only
+	// its actual private tuples, never hydrate current rows to manufacture them.
+	if query, _ := tx.Statement.Context.Value(memoryQueryEmbeddingResultKey{}).(*memoryQueryEmbeddingRead); query != nil {
+		pool, err := tx.DB()
+		if err != nil {
+			return err
+		}
+		own, err := query.repo.db.DB()
+		if err != nil {
+			return err
+		}
+		if pool != own || !sameOriginalModelCallerInRepository(tx.Statement.Context, query.ctx) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = query.startCheck(); err != nil {
+			return err
+		}
+		defer func() { resultErr = query.finishCheck(resultErr) }()
+		view := query.stateView()
+		if view.result == nil || view.model == nil || view.policy == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, view.bodyBindings); err != nil {
+			return err
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, view.policyHold.Leases); err != nil {
+			return err
+		}
+		models, err := memoryModelFinalLeaseBindings(view.model.Context())
+		if err != nil {
+			return err
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, models); err != nil {
+			return err
+		}
+		content = append(content, view.content...)
+		contexts = append(contexts, view.ctx, view.model.Context(), view.policy.Context())
+	}
+	clock := &memoryQueryEmbeddingRead{ctx: read.ctx, bodyBindings: all, content: content}
+	if err := clock.finalStateClock(tx.Session(&gorm.Session{NewDB: true}), nil); err != nil {
+		return err
+	}
+	for _, ctx := range contexts {
+		if ctx == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// These edges are written only by the genuine document producer on its own
+// checked transaction. A mutable vector/control observation is not an edge.
+func memoryEmbeddingReceiptOriginInTx(tx *gorm.DB, scope interfaces.MemoryScope, item string, receipt *types.MemoryEmbeddingReceipt) (*types.MemoryEmbeddingOriginal, error) {
+	if receipt == nil || receipt.TenantID != scope.TenantID || receipt.SubjectID != scope.SubjectID || receipt.ItemID != item {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	original, err := loadMemoryEmbeddingOriginal(tx, receipt.OriginalID)
+	if err != nil {
+		return nil, err
+	}
+	if original.Digest != receipt.OriginalDigest || original.TenantID != scope.TenantID || original.SubjectID != scope.SubjectID || original.ItemID != item || original.ModelID != receipt.ModelID || original.SpaceDigest != receipt.SpaceDigest || original.ExpectedDimensions != receipt.Dimensions || receipt.VectorRevision <= original.BaseVectorRevision || original.ParentReceiptID != receipt.ParentReceiptID || original.ParentReceiptDigest != receipt.ParentReceiptDigest || original.ParentRankID != receipt.ParentRankID || original.ParentRankDigest != receipt.ParentRankDigest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	for _, entry := range []struct{ table, id, sha, digest string }{{original.TableName(), original.ID, original.InputSHA256, original.Digest}, {receipt.TableName(), receipt.ID, receipt.VectorJSONSHA256, receipt.Digest}} {
+		if _, err = checkMemoryEmbeddingBodyReceiptInTx(tx, entry.table, entry.id, scope.TenantID, entry.sha, entry.digest); err != nil {
+			return nil, err
+		}
+	}
+	return original, nil
+}
+
+func checkMemoryEmbeddingRankParentInTx(tx *gorm.DB, scope interfaces.MemoryScope, item string, rank *types.MemoryEmbeddingRankReceipt, receipt *types.MemoryEmbeddingReceipt) error {
+	if rank == nil || receipt == nil || rank.TenantID != scope.TenantID || rank.SubjectID != scope.SubjectID || rank.ItemID != item || rank.ModelID != receipt.ModelID || rank.ReceiptID != receipt.ID || rank.ReceiptDigest != receipt.Digest || rank.VectorDigest != receipt.VectorDigest || rank.SourceVectorRevision != receipt.VectorRevision {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	_, err := checkMemoryEmbeddingBodyReceiptInTx(tx, rank.TableName(), rank.ID, scope.TenantID, rank.RankVectorDigest, rank.Digest)
+	return err
+}
+
+// Validate the current blob against its true receipt without using it as the
+// historical ranking input. This reads no old credential or provider.
+func checkMemoryEmbeddingCurrentBlobInTx(tx *gorm.DB, scope interfaces.MemoryScope, item string, receipt *types.MemoryEmbeddingReceipt, rank *types.MemoryEmbeddingRankReceipt) error {
+	var row types.MemoryItemEmbedding
+	if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.Locking{Strength: "SHARE"}).Where("item_id=? AND tenant_id=? AND subject_id=?", item, scope.TenantID, scope.SubjectID).Take(&row).Error; err != nil {
+		return err
+	}
+	if row.ModelID != receipt.ModelID || row.Dims != receipt.Dimensions || bodySHA(row.Vector) != receipt.VectorDigest {
+		return ErrOriginalBodyUnavailable
+	}
+	present, digest := receipt.RankVectorPresent, receipt.RankVectorDigest
+	if rank != nil {
+		present, digest = true, rank.RankVectorDigest
+	}
+	if tx.Dialector.Name() == "postgres" && tx.Migrator().HasColumn(&types.MemoryItemEmbedding{}, "embedding") {
+		var actual struct{ Value *string }
+		if err := tx.Session(&gorm.Session{NewDB: true}).Raw("SELECT CAST(embedding AS TEXT) AS value FROM memory_item_embeddings WHERE item_id=?", item).Scan(&actual).Error; err != nil {
+			return err
+		}
+		if (actual.Value != nil) != present || actual.Value != nil && bodySHA([]byte(*actual.Value)) != digest {
+			return ErrOriginalBodyUnavailable
+		}
+	} else if present {
+		return ErrOriginalBodyUnavailable
+	}
+	return tx.Statement.Context.Err()
+}
+
+func captureMemoryEmbeddingParentInTx(tx *gorm.DB, scope interfaces.MemoryScope, item string, control *types.MemoryEmbeddingVectorControl) (*types.MemoryEmbeddingReceipt, *types.MemoryEmbeddingRankReceipt, error) {
+	if control == nil || control.TenantID != scope.TenantID || control.SubjectID != scope.SubjectID || control.ItemID != item {
+		return nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	if !control.Present {
+		var count int64
+		if err := tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryItemEmbedding{}).Where("item_id=?", item).Count(&count).Error; err != nil {
+			return nil, nil, err
+		}
+		if count != 0 {
+			return nil, nil, types.ErrMemoryOriginalUnavailable
+		}
+		return nil, nil, nil
+	}
+	receipt, rank, err := loadCurrentMemoryEmbeddingReceipt(tx, scope, item, control.Revision)
+	if err != nil {
+		return nil, nil, err
+	} // UNKNOWN/raw gaps never become parents.
+	if _, err = memoryEmbeddingReceiptOriginInTx(tx, scope, item, receipt); err != nil {
+		return nil, nil, err
+	}
+	if rank != nil {
+		if err = checkMemoryEmbeddingRankParentInTx(tx, scope, item, rank, receipt); err != nil {
+			return nil, nil, err
+		}
+	}
+	if err = checkMemoryEmbeddingCurrentBlobInTx(tx, scope, item, receipt, rank); err != nil {
+		return nil, nil, err
+	}
+	return receipt, rank, nil
+}
+
+func checkMemoryEmbeddingParentInTx(tx *gorm.DB, fact *types.MemoryEmbeddingOriginal, requireCurrent bool) error {
+	if fact == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if (fact.ParentReceiptID == "") != (fact.ParentReceiptDigest == "") || (fact.ParentRankID == "") != (fact.ParentRankDigest == "") {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if !fact.BaseVectorPresent {
+		if fact.ParentReceiptID != "" || fact.ParentRankID != "" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		return tx.Statement.Context.Err()
+	}
+	if fact.ParentReceiptID == "" || len(fact.ParentReceiptDigest) != 64 || fact.ParentRankID != "" && len(fact.ParentRankDigest) != 64 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	scope := memoryScope(fact.TenantID, fact.SubjectID)
+	parent, err := loadMemoryEmbeddingReceipt(tx, fact.ParentReceiptID)
+	if err != nil {
+		return err
+	}
+	if parent.Digest != fact.ParentReceiptDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if _, err = memoryEmbeddingReceiptOriginInTx(tx, scope, fact.ItemID, parent); err != nil {
+		return err
+	}
+	expectedRevision := parent.VectorRevision
+	var rank *types.MemoryEmbeddingRankReceipt
+	if fact.ParentRankID != "" {
+		rank, err = loadMemoryEmbeddingRankReceipt(tx, fact.ParentRankID)
+		if err != nil {
+			return err
+		}
+		if rank.Digest != fact.ParentRankDigest {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = checkMemoryEmbeddingRankParentInTx(tx, scope, fact.ItemID, rank, parent); err != nil {
+			return err
+		}
+		expectedRevision = rank.VectorRevision
+	}
+	if expectedRevision != fact.BaseVectorRevision {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if requireCurrent {
+		control, err := memoryEmbeddingControlInTx(tx, scope, fact.ItemID, "SHARE")
+		if err != nil {
+			return err
+		}
+		if control.Revision != fact.BaseVectorRevision || !control.Present {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		current, currentRank, err := captureMemoryEmbeddingParentInTx(tx, scope, fact.ItemID, control)
+		if err != nil {
+			return err
+		}
+		if current.ID != parent.ID || current.Digest != parent.Digest || (currentRank == nil) != (rank == nil) || currentRank != nil && (currentRank.ID != rank.ID || currentRank.Digest != rank.Digest) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+
+// A later genuine output is a current-control descendant, never replacement
+// material for the saved selection. Every hop names its actual prior receipt,
+// optionally through a genuine rank representation, and retains live bodies.
+func checkMemoryEmbeddingOutputAncestryInTx(tx *gorm.DB, scope interfaces.MemoryScope, item string, current, saved *types.MemoryEmbeddingReceipt, minimumRevision uint64) error {
+	if current == nil || saved == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	seen := map[string]bool{}
+	for steps := 0; ; steps++ {
+		if steps >= 256 || seen[current.ID] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[current.ID] = true
+		original, err := memoryEmbeddingReceiptOriginInTx(tx, scope, item, current)
+		if err != nil {
+			return err
+		}
+		if current.ID == saved.ID {
+			if !faqInputEqual(current, saved) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			return tx.Statement.Context.Err()
+		}
+		if err = checkMemoryEmbeddingParentInTx(tx, original, false); err != nil {
+			return err
+		}
+		if original.ParentReceiptID == "" || original.BaseVectorRevision < minimumRevision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		parent, err := loadMemoryEmbeddingReceipt(tx, original.ParentReceiptID)
+		if err != nil {
+			return err
+		}
+		if parent.Digest != original.ParentReceiptDigest || parent.VectorRevision >= current.VectorRevision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		current = parent
+	}
+}
