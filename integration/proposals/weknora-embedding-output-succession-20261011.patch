+	digest := sha256.Sum256(raw)
+	return hex.EncodeToString(digest[:])
+}
+
+func embeddingSuccessorLastClockFrames() bool {
+	pcs := make([]uintptr, 96)
+	frames := runtime.CallersFrames(pcs[:runtime.Callers(2, pcs)])
+	outer, last, first := false, false, false
+	for {
+		frame, more := frames.Next()
+		outer = outer || strings.Contains(frame.Function, "repository.(*memoryEmbeddingRead).checkMemoryEmbeddingFinalClockInTx")
+		last = last || strings.Contains(frame.Function, "repository.(*memoryQueryEmbeddingRead).finalStateClock")
+		first = first || strings.Contains(frame.Function, "repository.(*memoryOriginalAdmissionRepository).checkMemoryGeneratedFinalClockInTx")
+		if !more {
+			break
+		}
+	}
+	return outer && last && !first
+}
+
+func embeddingSuccessorRequestedIDs(tx *gorm.DB) map[string]bool {
+	ids := map[string]bool{}
+	where, ok := tx.Statement.Clauses["WHERE"].Expression.(clause.Where)
+	if !ok {
+		return ids
+	}
+	for _, part := range where.Exprs {
+		if e, ok := part.(clause.Expr); ok && e.SQL == "lease_id IN ?" && len(e.Vars) == 1 {
+			if values, ok := e.Vars[0].([]string); ok {
+				for _, id := range values {
+					ids[id] = true
+				}
+			}
+		}
+	}
+	return ids
+}
