+func actualVectorCloseWaitsForChecks() bool {
+	buffer := make([]byte, 1<<20)
+	count := runtime.Stack(buffer, true)
+	// Classify only program functions. Never log stack arguments, SQL or body.
+	for _, stack := range strings.Split(string(buffer[:count]), "\n\n") {
+		if strings.Contains(stack, "repository.(*memoryEmbeddingVectorRead).Close") && strings.Contains(stack, "sync.(*WaitGroup).Wait") {
+			return true
+		}
+	}
+	return false
+}
+
+func runEmbeddingSuccessorVectorLifecycleActual(t *testing.T, pg bool) {
+	for _, mode := range []string{"foreign_pool_without_query", "close_during_final_union"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, models, _, _ := actualOriginalModelServices(t, f)
+			var calls atomic.Int64
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error("real vector lifecycle SDK request unavailable")
+					return
+				}
+				sequence := calls.Add(1)
+				if sequence > 2 || !strings.Contains(string(body), "GENUINE VECTOR LIFECYCLE DOCUMENT") || r.Header.Get("Authorization") != "Bearer synthetic-vector-lifecycle-key" {
+					t.Error("real SDK changed original document/credential")
+					w.WriteHeader(400)
+					return
+				}
+				vector := []float32{1, 0}
+				if sequence == 2 {
+					vector = []float32{0, 1}
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(map[string]interface{}{"data": []interface{}{map[string]interface{}{"index": 0, "embedding": vector}}})
+			}))
+			t.Cleanup(server.Close)
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			model := &types.Model{ID: "actual-vector-lifecycle-model", TenantID: 7, Name: "actual vector lifecycle model", Type: types.ModelTypeEmbedding, Source: types.ModelSourceRemote, Parameters: types.ModelParameters{Provider: "openai", BaseURL: server.URL, APIKey: "synthetic-vector-lifecycle-key", EmbeddingParameters: types.EmbeddingParameters{Dimension: 2, SupportsDimensionOverride: true}}}
+			require.NoError(t, models.CreateModel(f.ctx, model))
+			tenants := repository.NewTenantRepository(f.db)
+			ConfigureTenantMemoryPolicyAuthority(tenants, f.machine.f.store, NewGroupAccessService(repository.NewGroupAccessRepository(f.db)), nil)
+			_, _, err := tenants.(interfaces.MemoryPolicyOriginalWriter).ReplaceMemoryPolicyOriginal(f.ctx, 7, types.MemoryConfig{Enabled: true, WriteMode: types.MemoryWriteAuto, ExtractModelID: f.model.GetModelID(), EmbeddingModelID: model.ID})
+			require.NoError(t, err)
+			f.service = memoryservice.NewOriginalBoundMemoryService(f.repo, tenants, repository.NewMessageRepository(f.db), models, f.queue, nil, f.reader, f.admissions)
+			item, err := f.service.Remember(f.ctx, types.MemoryItem{Origin: types.MemoryOriginManual, Kind: types.MemoryKindFact, Content: "GENUINE VECTOR LIFECYCLE DOCUMENT", Importance: 4})
+			require.NoError(t, err)
+			require.EqualValues(t, 1, calls.Load())
+			originals := f.admissions.(interfaces.MemoryEmbeddingOriginalRepository)
+			if mode == "foreign_pool_without_query" {
+				// This is a real EMPTY vector capability from another private SQL pool.
+				// It has no query carrier and no foreign body IDs to accidentally fail
+				// a later SQL lookup. Only exact pool ownership can authorize joining it.
+				foreign := newMemAtomicSQLFixture(t, pg)
+				_, foreignModels, _, _ := actualOriginalModelServices(t, foreign)
+				utils.SetSSRFWhitelistFromRaw("127.0.0.1")
