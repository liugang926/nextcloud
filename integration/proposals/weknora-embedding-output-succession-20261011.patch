+				ConfigureTenantMemoryPolicyAuthority(foreignTenants, foreign.machine.f.store, NewGroupAccessService(repository.NewGroupAccessRepository(foreign.db)), nil)
+				_, _, err = foreignTenants.(interfaces.MemoryPolicyOriginalWriter).ReplaceMemoryPolicyOriginal(foreign.ctx, 7, types.MemoryConfig{Enabled: true, WriteMode: types.MemoryWriteAuto, ExtractModelID: foreign.model.GetModelID(), EmbeddingModelID: model.ID})
+				require.NoError(t, err)
+				_, err = foreign.repo.EnsureSubject(foreign.ctx, foreign.scope)
+				require.NoError(t, err)
+				foreignVector, err := foreign.admissions.(interfaces.MemoryEmbeddingVectorRepository).BeginMemoryEmbeddingVectors(foreign.ctx, foreign.scope, model.ID, nil)
+				require.NoError(t, err)
+				t.Cleanup(func() { _ = foreignVector.Close() })
+				snapshot, err := foreignVector.Snapshot()
+				require.NoError(t, err)
+				require.Empty(t, snapshot.Materials)
+				pool, err := f.db.DB()
+				require.NoError(t, err)
+				other, err := foreign.db.DB()
+				require.NoError(t, err)
+				require.NotSame(t, pool, other)
+				a, b := types.CallerFromContext(f.ctx), types.CallerFromContext(foreignVector.Context())
+				require.Equal(t, a.TenantID, b.TenantID)
+				require.Equal(t, a.UserID, b.UserID)
+				require.Equal(t, a.Role, b.Role)
+				p, pok := types.PrincipalFromContext(f.ctx)
+				q, qok := types.PrincipalFromContext(foreignVector.Context())
+				require.True(t, pok && qok)
+				require.Equal(t, p, q)
+				var before, after int64
+				require.NoError(t, f.db.Model(&types.MemoryEmbeddingOriginal{}).Count(&before).Error)
+				read, err := originals.BeginMemoryEmbedding(foreignVector.Context(), f.scope, types.MemoryEmbeddingCapture{ItemID: item.ID, ModelID: model.ID})
+				require.Error(t, err)
+				require.Nil(t, read)
+				require.NoError(t, f.db.Model(&types.MemoryEmbeddingOriginal{}).Count(&after).Error)
+				require.Equal(t, before, after)
+				require.EqualValues(t, 1, calls.Load(), "foreign vector pool without query must refuse before SDK")
+				require.NoError(t, foreignVector.Close())
+				assertMemAtomicSQLLeasesClosed(t, foreign)
+				assertMemAtomicSQLLeasesClosed(t, f)
+				return
+			}
+			vector, err := f.admissions.(interfaces.MemoryEmbeddingVectorRepository).BeginMemoryEmbeddingVectors(f.ctx, f.scope, model.ID, []string{item.ID})
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = vector.Close() })
+			read, err := originals.BeginMemoryEmbedding(vector.Context(), f.scope, types.MemoryEmbeddingCapture{ItemID: item.ID, ModelID: model.ID})
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = read.Close() })
+			input, err := read.Snapshot()
+			require.NoError(t, err)
+			client, err := models.GetEmbeddingModel(read.Context(), model.ID)
+			require.NoError(t, err)
+			lifetime, ok := client.(interfaces.ModelOriginalClientLifetime)
+			require.True(t, ok)
+			t.Cleanup(func() { _ = lifetime.CloseOriginal() })
+			call, cancelCall := context.WithTimeout(read.Context(), 10*time.Second)
+			result, err := client.Embed(call, input.Text)
+			cancelCall()
+			require.NoError(t, err)
+			require.NoError(t, read.Recheck())
+			require.EqualValues(t, 2, calls.Load())
+			pool, err := f.db.DB()
+			require.NoError(t, err)
+			pool.SetMaxOpenConns(1)
+			pool.SetMaxIdleConns(1)
+			type operationKey struct{}
+			token := new(int)
+			ctx, cancel := context.WithTimeout(context.WithValue(read.Context(), operationKey{}, token), 8*time.Second)
+			defer cancel()
+			observe, cancelObserve := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancelObserve() // observation only, never authority/SQL context
+			closeDone := make(chan error, 1)
+			var crossed, waitObserved atomic.Bool
+			var observerErr error
+			const callback = "test:genuine_vector_close_final_union"
+			require.NoError(t, f.db.Callback().Query().Before("gorm:query").Register(callback, func(tx *gorm.DB) {
+				if tx.Statement.Context.Value(operationKey{}) != token || tx.Statement.Table != "original_body_leases" || !embeddingSuccessorLastClockFrames() || len(embeddingSuccessorRequestedIDs(tx)) == 0 {
+					return
+				}
+				var outputs int64
+				if err := tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryEmbeddingReceipt{}).Where("original_id=? AND original_digest=?", input.OriginalID, input.OriginalDigest).Count(&outputs).Error; err != nil {
+					observerErr = err
+					return
+				}
+				if outputs != 1 {
+					return
+				}
+				if !crossed.CompareAndSwap(false, true) {
+					return
+				}
+				go func() { closeDone <- vector.Close() }()
+				select {
+				case <-vector.Context().Done():
+				case <-observe.Done():
+					observerErr = observe.Err()
+					return
+				}
+				// This observes the REAL Close blocked on its actual check WG, not a
+				// sleep guess or a SQL-pool wait that would mask the missing join.
+				ticker := time.NewTicker(time.Millisecond)
+				defer ticker.Stop()
+				for !actualVectorCloseWaitsForChecks() {
+					select {
+					case <-ticker.C:
+					case <-observe.Done():
+						observerErr = observe.Err()
+						return
+					}
+				}
+				waitObserved.Store(true)
+			}))
+			t.Cleanup(func() { _ = f.db.Callback().Query().Remove(callback) })
+			receipt, err := originals.CommitMemoryEmbedding(ctx, types.MemoryEmbeddingResult{OriginalID: input.OriginalID, OriginalDigest: input.OriginalDigest, Vector: result})
+			require.NoError(t, observerErr)
+			require.True(t, crossed.Load())
+			require.True(t, waitObserved.Load())
+			require.Error(t, err)
+			require.Nil(t, receipt)
+			select {
+			case <-closeDone:
+			case <-observe.Done():
+				t.Fatal("actual vector Close failed to join after final operation returned")
+			}
+			var committed int64
+			require.NoError(t, f.db.Model(&types.MemoryEmbeddingReceipt{}).Where("original_id=?", input.OriginalID).Count(&committed).Error)
+			require.Zero(t, committed)
+			require.NoError(t, lifetime.CloseOriginal())
+			_ = read.Close()
+			_ = vector.Close()
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
