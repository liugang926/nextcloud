+func TestEmbeddingSuccessorVectorLifecycleActualSQLite(t *testing.T) {
+	runEmbeddingSuccessorVectorLifecycleActual(t, false)
+}
+func TestPostgresEmbeddingSuccessorVectorLifecycleActual(t *testing.T) {
