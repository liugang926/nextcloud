+// pg_get_expr assumes a single relation varno. A trigger WHEN can contain
+// both OLD and NEW; pg_get_triggerdef reconstructs their correct namespaces.
+// The catalogue query separately pins table/function namespaces, event/type,
+// enablement and function identity. This parser never omits the WHEN expression.
+func jointTriggerWhenExpression(definition string) (string, error) {
+	tokens := jointSQLTokens(definition)
+	when := -1
+	for i, token := range tokens {
+		if token == "when" {
+			if when >= 0 {
+				return "", ErrJointSchemaUnknown
+			}
+			when = i
+		}
+	}
+	if when < 0 {
+		return "", nil
+	}
+	if when+1 >= len(tokens) || tokens[when+1] != "(" {
+		return "", ErrJointSchemaUnknown
+	}
+	depth, end := 0, -1
+	for i := when + 1; i < len(tokens); i++ {
+		if tokens[i] == "(" {
+			depth++
+		}
+		if tokens[i] == ")" {
+			depth--
+			if depth == 0 {
+				end = i
+				break
+			}
+		}
+	}
+	if end < 0 || end == when+2 || end+2 >= len(tokens) || tokens[end+1] != "execute" || (tokens[end+2] != "function" && tokens[end+2] != "procedure") {
+		return "", ErrJointSchemaUnknown
+	}
+	return jointCanonicalExpression(strings.Join(tokens[when+2:end], " ")), nil
+}
+
+// PostgreSQL deparses partial predicates with redundant grouping and literal
+// text casts. Normalize only that expression; uniqueness, columns, opclasses,
+// numeric/function casts and every predicate operator remain visible. Explicit
+// default btree is equivalent to the source's omitted default access method.
+func jointCanonicalIndexDefinition(definition, namespace string) (string, error) {
+	tokens := jointSQLTokens(jointCanonicalSQL(strings.TrimSuffix(definition, ";"), namespace))
+	if len(tokens) < 6 || tokens[0] != "create" {
+		return "", ErrJointSchemaUnknown
+	}
+	index := 1
+	if tokens[index] == "unique" {
+		index++
+	}
+	if index+3 >= len(tokens) || tokens[index] != "index" || tokens[index+2] != "on" {
+		return "", ErrJointSchemaUnknown
+	}
+	depth, where := 0, -1
+	for i, token := range tokens {
+		if token == "(" {
+			depth++
+		}
+		if token == ")" {
+			depth--
+			if depth < 0 {
+				return "", ErrJointSchemaUnknown
+			}
+		}
+		if depth == 0 && token == "where" {
+			if where >= 0 {
+				return "", ErrJointSchemaUnknown
+			}
+			where = i
+		}
+	}
+	if depth != 0 {
+		return "", ErrJointSchemaUnknown
+	}
+	prefix := tokens
+	if where >= 0 {
+		prefix = tokens[:where]
+	}
+	core := make([]string, 0, len(prefix))
+	for i := 0; i < len(prefix); i++ {
+		if prefix[i] == "using" && i+1 < len(prefix) && prefix[i+1] == "btree" {
+			i++
+			continue
+		}
+		core = append(core, prefix[i])
+	}
+	value := strings.Join(core, " ")
+	if where >= 0 {
+		if where+1 >= len(tokens) {
+			return "", ErrJointSchemaUnknown
+		}
+		value += " where " + jointCanonicalExpression(strings.Join(tokens[where+1:], " "))
+	}
+	return value, nil
+}
