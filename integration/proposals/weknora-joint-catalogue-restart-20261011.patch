+// Real pg_catalog and native DDL changes, never an authored permission witness.
+// Existing true full bootstrap and no-mutation assertions remain strict.
+func TestPostgresJointPartialIndexRepresentationActual(t *testing.T) {
+	for _, mode := range []string{"current", "dispatch_predicate", "root_predicate"} {
+		t.Run(mode, func(t *testing.T) {
+			root := sqliteRepoRoot(t)
+			chdirAndRestore(t, root)
+			db, dsn, options := jointLineageFixture(t, true)
+			require.NoError(t, RunMigrationsWithOptions(dsn, options))
+			version, dirty := jointLineageMigrationState(t, db)
+			require.EqualValues(t, 168, version)
+			require.False(t, dirty)
+			expected, err := jointExpectedCatalogue("versioned", version)
+			require.NoError(t, err)
+			require.NoError(t, jointVerifyIndexes(context.Background(), db, "versioned", expected), "canonical current partial predicates must be accepted")
+			if mode != "current" {
+				name, create := "memory_original_dispatch_due", "CREATE INDEX memory_original_dispatch_due ON memory_original_dispatches(next_attempt_at,admission_id) WHERE completed_at IS NOT NULL;"
+				if mode == "root_predicate" {
+					name, create = "nextcloud_root_migration_live", "CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id) WHERE state='finalized';"
+				}
+				_, err = db.Exec("DROP INDEX " + name)
+				require.NoError(t, err)
+				_, err = db.Exec(create)
+				require.NoError(t, err)
+				var actual, namespace string
+				var valid bool
+				require.NoError(t, db.QueryRow(`SELECT pg_get_indexdef(i.indexrelid),n.nspname,i.indisvalid FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=current_schema() AND c.relname=$1`, name).Scan(&actual, &namespace, &valid))
+				require.True(t, valid)
+				fault, err := jointCanonicalIndexDefinition(actual, namespace)
+				require.NoError(t, err)
+				original, err := jointCanonicalIndexDefinition(expected.Indexes[name], namespace)
+				require.NoError(t, err)
+				require.NotEqual(t, original, fault, "actual native predicate change confirmed before refusal")
+				require.ErrorIs(t, jointVerifyIndexes(context.Background(), db, "versioned", expected), ErrJointSchemaUnknown)
+			}
+			before := memoryFullSchemaSnapshot(t, db, "versioned")
+			err = RunMigrationsWithOptions(dsn, options)
+			if mode == "current" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, ErrJointSchemaUnknown)
+			}
+			require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "versioned"))
+			afterVersion, afterDirty := jointLineageMigrationState(t, db)
+			require.Equal(t, version, afterVersion)
+			require.Equal(t, dirty, afterDirty)
+		})
+	}
+}
+func TestPostgresJointTriggerWhenRepresentationActual(t *testing.T) {
+	for _, mode := range []string{"current", "changed_when", "removed_when", "foreign_function"} {
+		t.Run(mode, func(t *testing.T) {
+			root := sqliteRepoRoot(t)
+			chdirAndRestore(t, root)
+			db, dsn, options := jointLineageFixture(t, true)
+			require.NoError(t, RunMigrationsWithOptions(dsn, options))
+			version, dirty := jointLineageMigrationState(t, db)
+			require.EqualValues(t, 168, version)
+			require.False(t, dirty)
+			expected, err := jointExpectedCatalogue("versioned", version)
+			require.NoError(t, err)
+			name := "memory_subjects_derived_block"
+			definition := expected.Triggers[name]
+			require.NoError(t, jointVerifyTrigger(context.Background(), db, "versioned", name, definition, expected), "real OLD/NEW trigger WHEN must be deparsed by trigger context")
+			if mode != "current" {
+				_, err = db.Exec("DROP TRIGGER memory_subjects_derived_block ON memory_subjects")
+				require.NoError(t, err)
+				when, call := " WHEN (OLD.block_text IS DISTINCT FROM NEW.block_text AND OLD.item_count IS DISTINCT FROM NEW.item_count)", "memory_subjects_derived_block()"
+				if mode == "removed_when" {
+					when = ""
+				}
+				if mode == "foreign_function" {
+					_, err = db.Exec("CREATE SCHEMA owned_trigger_binding_fault")
+					require.NoError(t, err)
+					t.Cleanup(func() {
+						_, cleanupErr := db.Exec("DROP SCHEMA IF EXISTS owned_trigger_binding_fault CASCADE")
+						if cleanupErr != nil {
+							t.Errorf("owned trigger namespace cleanup: %v", cleanupErr)
+						}
+					})
+					_, err = db.Exec("CREATE FUNCTION owned_trigger_binding_fault.memory_subjects_derived_block() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$")
+					require.NoError(t, err)
+					call = "owned_trigger_binding_fault.memory_subjects_derived_block()"
+					when = " WHEN (OLD.block_text IS DISTINCT FROM NEW.block_text OR OLD.item_count IS DISTINCT FROM NEW.item_count)"
+				}
+				_, err = db.Exec("CREATE TRIGGER memory_subjects_derived_block AFTER UPDATE ON memory_subjects FOR EACH ROW" + when + " EXECUTE FUNCTION " + call)
+				require.NoError(t, err)
+				var actual, namespace string
+				require.NoError(t, db.QueryRow(`SELECT pg_get_triggerdef(t.oid,false),f.nspname FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_proc p ON p.oid=t.tgfoid JOIN pg_namespace f ON f.oid=p.pronamespace WHERE n.nspname=current_schema() AND c.relname='memory_subjects' AND t.tgname=$1`, name).Scan(&actual, &namespace))
+				if mode == "foreign_function" {
+					require.Equal(t, "owned_trigger_binding_fault", namespace)
+				} else {
+					fault, parseErr := jointTriggerWhenExpression(actual)
+					require.NoError(t, parseErr)
+					original, parseErr := jointTriggerWhenExpression(definition)
+					require.NoError(t, parseErr)
+					require.NotEqual(t, original, fault, "actual native WHEN change confirmed before refusal")
+				}
+				require.ErrorIs(t, jointVerifyTrigger(context.Background(), db, "versioned", name, definition, expected), ErrJointSchemaUnknown)
+			}
+			before := memoryFullSchemaSnapshot(t, db, "versioned")
+			err = RunMigrationsWithOptions(dsn, options)
+			if mode == "current" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, ErrJointSchemaUnknown)
+			}
+			require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "versioned"))
+			afterVersion, afterDirty := jointLineageMigrationState(t, db)
+			require.Equal(t, version, afterVersion)
+			require.Equal(t, dirty, afterDirty)
+		})
+	}
+}
