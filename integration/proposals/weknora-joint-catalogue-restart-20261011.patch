+// Diagnostic only: production full Up, then exact existing verifier calls.
+// Output is restricted to compiled object/column names, booleans and fixed
+// error codes. No business row, function body, definition or DSN is logged.
+func jointRestartDiagnosticCode(err error) string {
+	switch {
+	case err == nil:
+		return "ok"
+	case errors.Is(err, ErrJointSchemaUnknown):
+		return "unknown"
+	case errors.Is(err, ErrJointSchemaSourceIdentity):
+		return "source_identity"
+	case errors.Is(err, ErrJointSchemaUnavailable):
+		return "unavailable"
+	case errors.Is(err, ErrJointSchemaPeerForwardBridge):
+		return "peer_bridge"
+	case errors.Is(err, context.Canceled):
+		return "canceled"
+	case errors.Is(err, context.DeadlineExceeded):
+		return "deadline"
+	default:
+		return "other"
+	}
+}
+func jointRestartDiagnosticNames[V any](entries map[string]V) []string {
+	names := make([]string, 0, len(entries))
+	for name := range entries {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+func jointRestartDiagnosticTable(t *testing.T, ctx context.Context, db *sql.DB, dialect, name, definition string) {
+	t.Helper()
+	actual, err := jointCatalogueColumns(ctx, db, dialect, name)
+	t.Logf("joint_catalogue stage=table_columns object=%s code=%s", name, jointRestartDiagnosticCode(err))
+	if err != nil {
+		return
+	}
+	parts, err := jointColumnParts(definition)
+	if err != nil {
+		t.Logf("joint_catalogue stage=table_source object=%s code=%s", name, jointRestartDiagnosticCode(err))
+		return
+	}
+	wanted := []jointColumnIdentity{}
+	pk := map[string]bool{}
+	for _, part := range parts {
+		tokens := jointSQLTokens(part)
+		if len(tokens) == 0 {
+			continue
+		}
+		if tokens[0] == "primary" || tokens[0] == "foreign" || tokens[0] == "unique" || tokens[0] == "check" || tokens[0] == "constraint" {
+			if tokens[0] == "primary" {
+				for _, token := range tokens[3 : len(tokens)-1] {
+					if jointIdentifier.MatchString(token) {
+						pk[token] = true
+					}
+				}
+			}
+			continue
+		}
+		column, parseErr := jointColumnDeclaration(part)
+		if parseErr != nil {
+			t.Logf("joint_catalogue stage=column_source object=%s code=%s", name, jointRestartDiagnosticCode(parseErr))
+			continue
+		}
+		for i, token := range tokens {
+			if token == "primary" && i+1 < len(tokens) && tokens[i+1] == "key" {
+				pk[column.Name] = true
+			}
+		}
+		wanted = append(wanted, column)
+	}
+	if dialect == "versioned" {
+		for i := range wanted {
+			if pk[wanted[i].Name] {
+				wanted[i].NotNull = true
+			}
+		}
+	}
+	t.Logf("joint_catalogue stage=column_count object=%s equal=%t", name, len(actual) == len(wanted))
+	byName := map[string]jointColumnIdentity{}
+	for _, column := range actual {
+		byName[column.Name] = column
+	}
+	for position, want := range wanted {
+		got, present := byName[want.Name]
+		ordered := position < len(actual) && actual[position].Name == want.Name
+		t.Logf("joint_catalogue stage=column_identity object=%s column=%s present=%t order=%t type=%t nullability=%t default=%t", name, want.Name, present, ordered, got.Type == want.Type, got.NotNull == want.NotNull, got.Default == want.Default)
+	}
+	if dialect == "versioned" {
+		// Count/semantic shape diagnostics only. The production table verifier
+		// still owns the complete constraint comparison; no success is forged.
+		rows, qerr := db.QueryContext(ctx, `SELECT p.convalidated,p.condeferrable FROM pg_constraint p JOIN pg_class c ON c.oid=p.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname=current_schema() AND c.relname=$1 ORDER BY p.oid`, name)
+		if qerr != nil {
+			t.Logf("joint_catalogue stage=constraints object=%s code=unavailable", name)
+			return
+		}
+		valid, closed := true, true
+		for rows.Next() {
+			var v, d bool
+			if rows.Scan(&v, &d) != nil {
+				valid = false
+				break
+			}
+			valid = valid && v
+			closed = closed && !d
+		}
+		qerr = rows.Err()
+		closeErr := rows.Close()
+		t.Logf("joint_catalogue stage=constraints object=%s validated=%t nondeferrable=%t read_ok=%t close_ok=%t", name, valid, closed, qerr == nil, closeErr == nil)
+	}
+}
+func runJointCatalogueRestartDiagnostic(t *testing.T, pg bool) {
+	t.Helper()
+	root := sqliteRepoRoot(t)
+	chdirAndRestore(t, root)
+	db, dsn, options := jointLineageFixture(t, pg)
+	require.NoError(t, RunMigrationsWithOptions(dsn, options), "actual first full production Up must succeed")
+	version, dirty := jointLineageMigrationState(t, db)
+	require.False(t, dirty)
+	dialect, latest := "sqlite", uint(87)
+	if pg {
+		dialect, latest = "versioned", 168
+	}
+	require.Equal(t, latest, version)
+	ctx := context.Background()
+	expected, err := jointExpectedCatalogue(dialect, version)
+	require.NoError(t, err)
+	witness, err := jointLineageWitnessesFromSource()
+	require.NoError(t, err)
+	objects, _, err := jointLineageObjectSets(ctx, db, dialect)
+	require.NoError(t, err)
+	for _, category := range []struct {
+		kind     string
+		names    []string
+		expected map[string]string
+	}{
+		{"table", witness.Sentinels.Tables, expected.Tables},
+		{"function", witness.Sentinels.Functions, expected.Functions},
+		{"trigger", witness.Sentinels.Triggers, expected.Triggers},
+		{"index", witness.Sentinels.Indexes, expected.Indexes},
+	} {
+		names := append([]string(nil), category.names...)
+		sort.Strings(names)
+		for _, name := range names {
+			_, known := category.expected[name]
+			t.Logf("joint_catalogue stage=sentinel kind=%s object=%s present=%t expected=%t", category.kind, name, objects[category.kind+"/"+name], known)
+		}
+	}
+	for _, table := range jointRestartDiagnosticNames(witness.Sentinels.Columns) {
+		names := append([]string(nil), witness.Sentinels.Columns[table]...)
+		sort.Strings(names)
+		for _, name := range names {
+			present, columnErr := jointLineageIntroducedColumn(ctx, db, dialect, table, name)
+			_, known := expected.Columns[table][name]
+			t.Logf("joint_catalogue stage=future_column object=%s column=%s present=%t expected=%t code=%s", table, name, present, known, jointRestartDiagnosticCode(columnErr))
+		}
+	}
+	failures := 0
+	logCheck := func(stage, name string, checkErr error) {
+		t.Logf("joint_catalogue stage=%s object=%s code=%s", stage, name, jointRestartDiagnosticCode(checkErr))
+		if checkErr != nil {
+			failures++
+		}
+	}
+	for _, name := range jointRestartDiagnosticNames(expected.Tables) {
+		checkErr := jointVerifyTable(ctx, db, dialect, name, expected.Tables[name])
+		logCheck("table", name, checkErr)
+		if checkErr != nil {
+			jointRestartDiagnosticTable(t, ctx, db, dialect, name, expected.Tables[name])
+		}
+	}
+	for _, table := range jointRestartDiagnosticNames(expected.Columns) {
+		for _, name := range jointRestartDiagnosticNames(expected.Columns[table]) {
+			single := jointCatalogueExpected{Columns: map[string]map[string]string{table: {name: expected.Columns[table][name]}}}
+			logCheck("existing_column", table+"."+name, jointVerifyExistingColumns(ctx, db, dialect, single))
+		}
+	}
+	if pg {
+		logCheck("withdrawal_kind", "nextcloud_indexed_withdrawal_items_kind_check", jointVerifyWithdrawalKindConstraint(ctx, db, expected.RegistryConstraint))
+		for _, name := range jointRestartDiagnosticNames(expected.Functions) {
+			single := jointCatalogueExpected{Functions: map[string]string{name: expected.Functions[name]}}
+			logCheck("function", name, jointVerifyFunctions(ctx, db, single))
+		}
+	}
+	for _, name := range jointRestartDiagnosticNames(expected.Triggers) {
+		logCheck("trigger", name, jointVerifyTrigger(ctx, db, dialect, name, expected.Triggers[name], expected))
+	}
+	for _, name := range jointRestartDiagnosticNames(expected.Indexes) {
+		single := jointCatalogueExpected{Indexes: map[string]string{name: expected.Indexes[name]}}
+		logCheck("index", name, jointVerifyIndexes(ctx, db, dialect, single))
+	}
+	if pg && objects["embeddings"] {
+		definition := "CREATE TRIGGER nextcloud_indexed_embedding_guard BEFORE INSERT OR UPDATE OR DELETE ON embeddings FOR EACH ROW EXECUTE FUNCTION nextcloud_indexed_withdrawal_write_guard();"
+		logCheck("optional_embedding_trigger", "nextcloud_indexed_embedding_guard", jointVerifyTrigger(ctx, db, dialect, "nextcloud_indexed_embedding_guard", definition, expected))
+	}
+	logCheck("root_catalogue", "compiled_root_catalogue", verifyJointRootCatalogue(ctx, db, dialect, version))
+	logCheck("preflight", "compiled_joint_lineage", preflightJointSchemaLineage(ctx, dsn, options, version, dirty, true))
+	// Keep the failure oracle, after every diagnostic has been collected.
+	restartErr := RunMigrationsWithOptions(dsn, options)
+	logCheck("production_restart", "compiled_joint_lineage", restartErr)
+	t.Logf("joint_catalogue stage=summary object=compiled_joint_lineage all_checks_ok=%t", failures == 0)
+	require.NoError(t, restartErr, "full production restart stays required; diagnostic is not an allow hook")
+}
+func TestJointCatalogueRestartDiagnosticActualSQLite(t *testing.T) {
+	runJointCatalogueRestartDiagnostic(t, false)
+}
+func TestPostgresJointCatalogueRestartDiagnosticActual(t *testing.T) {
+	runJointCatalogueRestartDiagnostic(t, true)
+}
