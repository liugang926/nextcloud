+func TestJointPartialIndexCatalogueRepresentationExact(t *testing.T) {
+	for _, pair := range []struct{ source, catalogue string }{
+		{"CREATE INDEX memory_original_dispatch_due ON memory_original_dispatches(next_attempt_at,admission_id) WHERE completed_at IS NULL;", "CREATE INDEX memory_original_dispatch_due ON owned_schema.memory_original_dispatches USING btree (next_attempt_at, admission_id) WHERE (completed_at IS NULL)"},
+		{"CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id) WHERE state='prepared';", "CREATE UNIQUE INDEX nextcloud_root_migration_live ON owned_schema.nextcloud_root_migrations USING btree (pair_operation_id) WHERE (state = 'prepared'::text)"},
+	} {
+		want, err := jointCanonicalIndexDefinition(pair.source, "owned_schema")
+		require.NoError(t, err)
+		actual, err := jointCanonicalIndexDefinition(pair.catalogue, "owned_schema")
+		require.NoError(t, err)
+		require.Equal(t, want, actual)
+	}
+	source := "CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id) WHERE state='prepared';"
+	want, err := jointCanonicalIndexDefinition(source, "owned_schema")
+	require.NoError(t, err)
+	for _, changed := range []string{
+		"CREATE UNIQUE INDEX nextcloud_root_migration_live ON foreign_schema.nextcloud_root_migrations(pair_operation_id) WHERE state='prepared';",
+		"CREATE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id) WHERE state='prepared';",
+		"CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id) WHERE state<>'prepared';",
+		"CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id) WHERE state='finalized';",
+		"CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id);",
+		"CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id text_pattern_ops) WHERE state='prepared';",
+		"CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id::integer) WHERE state='prepared';",
+		"CREATE UNIQUE INDEX nextcloud_root_migration_live ON nextcloud_root_migrations(pair_operation_id) WHERE length(state)::integer=8;",
+	} {
+		got, parseErr := jointCanonicalIndexDefinition(changed, "owned_schema")
+		require.NoError(t, parseErr)
+		require.NotEqual(t, want, got, "predicate/type/operator/namespace changes stay visible")
+	}
+	nullSource, err := jointCanonicalIndexDefinition("CREATE INDEX memory_original_dispatch_due ON memory_original_dispatches(next_attempt_at,admission_id) WHERE completed_at IS NULL;", "")
+	require.NoError(t, err)
+	notNull, err := jointCanonicalIndexDefinition("CREATE INDEX memory_original_dispatch_due ON memory_original_dispatches(next_attempt_at,admission_id) WHERE completed_at IS NOT NULL;", "")
+	require.NoError(t, err)
+	require.NotEqual(t, nullSource, notNull)
+}
+func TestJointTriggerWhenCatalogueRepresentationExact(t *testing.T) {
+	source := "CREATE TRIGGER memory_subjects_derived_block AFTER UPDATE ON memory_subjects FOR EACH ROW WHEN (OLD.block_text IS DISTINCT FROM NEW.block_text OR OLD.item_count IS DISTINCT FROM NEW.item_count) EXECUTE FUNCTION memory_subjects_derived_block();"
+	catalogue := "CREATE TRIGGER memory_subjects_derived_block AFTER UPDATE ON owned_schema.memory_subjects FOR EACH ROW WHEN (((old.block_text IS DISTINCT FROM new.block_text) OR (old.item_count IS DISTINCT FROM new.item_count))) EXECUTE FUNCTION owned_schema.memory_subjects_derived_block()"
+	want, err := jointTriggerWhenExpression(source)
+	require.NoError(t, err)
+	got, err := jointTriggerWhenExpression(catalogue)
+	require.NoError(t, err)
+	require.Equal(t, want, got)
+	for _, changed := range []string{
+		"CREATE TRIGGER memory_subjects_derived_block AFTER UPDATE ON memory_subjects FOR EACH ROW EXECUTE FUNCTION memory_subjects_derived_block();",
+		"CREATE TRIGGER memory_subjects_derived_block AFTER UPDATE ON memory_subjects FOR EACH ROW WHEN (OLD.block_text IS DISTINCT FROM NEW.block_text AND OLD.item_count IS DISTINCT FROM NEW.item_count) EXECUTE FUNCTION memory_subjects_derived_block();",
+		"CREATE TRIGGER memory_subjects_derived_block AFTER UPDATE ON memory_subjects FOR EACH ROW WHEN (OLD.block_text IS DISTINCT FROM NEW.block_text OR OLD.item_count::integer IS DISTINCT FROM NEW.item_count) EXECUTE FUNCTION memory_subjects_derived_block();",
+	} {
+		actual, parseErr := jointTriggerWhenExpression(changed)
+		require.NoError(t, parseErr)
+		require.NotEqual(t, want, actual)
+	}
+	_, err = jointTriggerWhenExpression("CREATE TRIGGER owned AFTER UPDATE ON memory_subjects FOR EACH ROW WHEN () EXECUTE FUNCTION memory_subjects_derived_block();")
+	require.Error(t, err)
+}
