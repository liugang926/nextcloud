+package database
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Names are not object types. These pure checks exercise compiled declarations,
+// not a synthesized permission/original/schema-success hook.
+func TestJointSchemaSentinelKindsExact(t *testing.T) {
+	witness, err := jointLineageWitnessesFromSource()
+	require.NoError(t, err)
+	sqlite, err := jointExpectedCatalogue("sqlite", 87)
+	require.NoError(t, err)
+	pg, err := jointExpectedCatalogue("versioned", 168)
+	require.NoError(t, err)
+	for _, test := range []struct {
+		name     string
+		objects  map[string]bool
+		expected jointCatalogueExpected
+		refuse   bool
+	}{
+		{"sqlite_trigger_is_not_pg_function", map[string]bool{"memory_policy_version_guard": true, "trigger/memory_policy_version_guard": true}, sqlite, false},
+		{"pg_function_is_verified_as_function", map[string]bool{"memory_policy_version_guard": true, "function/memory_policy_version_guard": true}, pg, false},
+		{"wrong_kind_table_refuses", map[string]bool{"memory_policy_version_guard": true, "table/memory_policy_version_guard": true}, sqlite, true},
+		{"transient_table_still_refuses", map[string]bool{"nextcloud_gc_items_processing_v2": true, "table/nextcloud_gc_items_processing_v2": true}, sqlite, true},
+		{"unknown_pg_trigger_same_function_name_refuses", map[string]bool{"memory_original_admission_immutable": true, "trigger/memory_original_admission_immutable": true}, pg, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := jointVerifySentinelObjectKinds(test.objects, witness.Sentinels, test.expected)
+			if test.refuse {
+				require.ErrorIs(t, err, ErrJointSchemaUnknown)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
+
+func TestJointSchemaTypedSentinelRestartActualSQLite(t *testing.T) {
+	for _, mode := range []string{"current", "missing_trigger", "changed_trigger", "unexpected_transient_table", "same_name_wrong_kind"} {
+		t.Run(mode, func(t *testing.T) {
+			root := sqliteRepoRoot(t)
+			chdirAndRestore(t, root)
+			db, dsn, options := jointLineageFixture(t, false)
+			require.NoError(t, RunMigrationsWithOptions(dsn, options))
+			version, dirty := jointLineageMigrationState(t, db)
+			require.EqualValues(t, 87, version)
+			require.False(t, dirty)
+			expected, err := jointExpectedCatalogue("sqlite", version)
+			require.NoError(t, err)
+			witness, err := jointLineageWitnessesFromSource()
+			require.NoError(t, err)
+			objects, _, err := jointLineageObjectSets(context.Background(), db, "sqlite")
+			require.NoError(t, err)
+			require.True(t, objects["trigger/memory_policy_version_guard"])
+			require.False(t, objects["function/memory_policy_version_guard"], "SQLite guard is a trigger, not an installed schema function")
+			require.NoError(t, jointVerifySentinelObjectKinds(objects, witness.Sentinels, expected))
+			require.NoError(t, verifyJointRootCatalogue(context.Background(), db, "sqlite", version))
+			switch mode {
+			case "missing_trigger":
+				_, err = db.Exec("DROP TRIGGER memory_policy_version_guard")
+				require.NoError(t, err)
+				var actual int
+				require.NoError(t, db.QueryRow("SELECT count(*) FROM sqlite_master WHERE type='trigger' AND name='memory_policy_version_guard'").Scan(&actual))
+				require.Zero(t, actual)
+			case "changed_trigger":
+				_, err = db.Exec("DROP TRIGGER memory_policy_version_guard")
+				require.NoError(t, err)
+				_, err = db.Exec("CREATE TRIGGER memory_policy_version_guard BEFORE UPDATE ON memory_policy_control_versions BEGIN SELECT RAISE(ABORT,'owned_changed_guard'); END;")
+				require.NoError(t, err)
+				var actual string
+				require.NoError(t, db.QueryRow("SELECT sql FROM sqlite_master WHERE type='trigger' AND name='memory_policy_version_guard'").Scan(&actual))
+				require.NotEqual(t, jointCanonicalSQL(expected.Triggers["memory_policy_version_guard"], ""), jointCanonicalSQL(actual, ""))
+			case "unexpected_transient_table":
+				_, err = db.Exec("CREATE TABLE nextcloud_gc_items_processing_v2(owned_unknown INTEGER)")
+				require.NoError(t, err)
+			case "same_name_wrong_kind":
+				_, err = db.Exec("CREATE TABLE memory_policy_version_guard(owned_unknown INTEGER)")
+				require.NoError(t, err)
+			}
+			objects, _, err = jointLineageObjectSets(context.Background(), db, "sqlite")
+			require.NoError(t, err)
+			if mode == "unexpected_transient_table" {
+				require.True(t, objects["table/nextcloud_gc_items_processing_v2"])
+				require.ErrorIs(t, jointVerifySentinelObjectKinds(objects, witness.Sentinels, expected), ErrJointSchemaUnknown)
+			}
+			if mode == "same_name_wrong_kind" {
+				require.True(t, objects["table/memory_policy_version_guard"])
+				require.True(t, objects["trigger/memory_policy_version_guard"])
+				require.ErrorIs(t, jointVerifySentinelObjectKinds(objects, witness.Sentinels, expected), ErrJointSchemaUnknown)
+			}
+			before := memoryFullSchemaSnapshot(t, db, "sqlite")
+			err = RunMigrationsWithOptions(dsn, options)
+			if mode == "current" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, ErrJointSchemaUnknown)
+			}
+			require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "sqlite"), "native schema faults must not be repaired or advance the ledger")
+			afterVersion, afterDirty := jointLineageMigrationState(t, db)
+			require.Equal(t, version, afterVersion)
+			require.Equal(t, dirty, afterDirty)
+		})
+	}
+}
