+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	memoryservice "github.com/Tencent/WeKnora/internal/application/service/memory"
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// Source-only draft: real model construction, actor/policy/source/body holds,
+// actual worker A and public manual producers create both input clusters.
+// This file proves no final-clock boundary by model callback expiry; that is
+// a separate test. Only provider roundtrips are replaced by bounded replies.
+type memoryMultiClusterMarker struct{}
+type memoryMultiClusterChat struct {
+	*actualMemoryModel
+	secondInvalid bool
+	messages      [][]byte
+	responses     []string
+	modelLeaseIDs [][]string
+}
+
+func (m *memoryMultiClusterChat) Chat(ctx context.Context, input []chat.Message, options *chat.ChatOptions) (*types.ChatResponse, error) {
+	if len(input) == 0 || input[0].Content != types.MemoryConsolidationOriginalPrompt {
+		return m.actualMemoryModel.Chat(ctx, input, options)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if !logprivacy.ContentSuppressed(ctx) {
+		return nil, fmt.Errorf("actual generated input lost its content protection marker")
+	}
+	ids, err := repository.ModelOriginalLeaseIDs(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if len(ids) != 2 {
+		return nil, fmt.Errorf("expected the actual current model's two acquired body leases")
+	}
+	wire, err := json.Marshal(input)
+	if err != nil {
+		return nil, err
+	}
+	m.messages = append(m.messages, wire)
+	m.modelLeaseIDs = append(m.modelLeaseIDs, append([]string(nil), ids...))
+	index := len(m.messages) - 1
+	if index > 1 {
+		return nil, fmt.Errorf("bounded fixture accepts exactly two consolidation calls")
+	}
+	statement := memoryGeneratedMergedText
+	if !strings.Contains(input[1].Content, actualMemoryStoredText) {
+		statement = "The user's ongoing task is refactoring payment workflows using Go."
+	}
+	if m.secondInvalid && index == 1 {
+		// Valid recipe-shaped JSON reaches the real transaction. The first cluster
+		// has actual SQL writes before the complete second decision is refused.
+		statement = "Access token is sk-" + strings.Repeat("a", 32)
+	}
+	response, err := json.Marshal(map[string]string{"statement": statement})
+	if err != nil {
+		return nil, err
+	}
+	m.responses = append(m.responses, string(response))
+	return &types.ChatResponse{Content: string(response)}, nil
+}
+
+type memoryMultiClusterModels struct {
+	actualMemoryModels
+	transport *memoryMultiClusterChat
+}
+
+func (m memoryMultiClusterModels) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	if _, err := m.actualMemoryModels.GetChatModel(ctx, id); err != nil {
+		return nil, err
+	}
+	return m.transport, nil
+}
+func attachMemoryMultiCluster(t *testing.T, f *memAtomicSQLFixture, invalid bool) *memoryMultiClusterChat {
+	t.Helper()
+	transport := &memoryMultiClusterChat{actualMemoryModel: f.model.actualMemoryModel, secondInvalid: invalid}
+	_, svc, _, _ := actualOriginalModelServices(t, f)
+	originals, ok := svc.(interfaces.ModelOriginalLifetimeReader)
+	require.True(t, ok)
+	require.NotNil(t, originals)
+	models := memoryMultiClusterModels{actualMemoryModels: actualMemoryModels{model: f.model.actualMemoryModel, db: f.db, originals: originals}, transport: transport}
+	f.service = memoryservice.NewOriginalBoundMemoryService(f.repo, repository.NewTenantRepository(f.db), repository.NewMessageRepository(f.db), models, f.queue, nil, f.reader, f.admissions)
+	memoryservice.ConfigureOriginalMemoryOutbox(f.service, f.outbox)
+	return transport
+}
+func runMemoryGeneratedMultiClusterSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"two_clusters_exact_complete", "second_cluster_invalid_complete_rollback"} {
+		t.Run(mode, func(t *testing.T) {
+			f, _, _ := newMemSharedAgentNoKBFixture(t, pg)
+			f.ctx = context.WithValue(f.ctx, memoryMultiClusterMarker{}, uuid.NewString())
+			invalid := mode == "second_cluster_invalid_complete_rollback"
+			transport := attachMemoryMultiCluster(t, f, invalid)
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, transport.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			require.NoError(t, handleMemDerivedSQL(t, f))
+			require.Equal(t, 1, transport.calls)
+			var first types.MemoryItem
+			require.NoError(t, f.db.Where("tenant_id=? AND subject_id=? AND kind=? AND status=?", f.scope.TenantID, f.scope.SubjectID, types.MemoryKindFact, types.MemoryStatusActive).Take(&first).Error)
+			require.Equal(t, actualMemoryStoredText, first.Content)
+			second, err := f.service.Remember(f.ctx, types.MemoryItem{Kind: types.MemoryKindFact, Topic: "daily coding editor", Content: memoryGeneratedSecondText, Importance: 5, Origin: types.MemoryOriginManual})
+			require.NoError(t, err)
+			require.NoError(t, f.db.Where("id=?", second.ID).Take(second).Error)
+			now := time.Now().UTC().Truncate(time.Microsecond)
+			taskA := createMemoryStaleSQLTask(t, f, memoryStaleTaskText, "payment refactoring task", now.Add(-time.Hour), nil, nil, 4, false)
+			taskB := createMemoryStaleSQLTask(t, f, memoryFreshTaskText, "payment workflows task", now.Add(-time.Minute), nil, nil, 4, false)
+			inputs := map[string]types.MemoryItem{first.ID: first, second.ID: *second, taskA.ID: *taskA, taskB.ID: *taskB}
+			require.Len(t, inputs, 4)
+			beforePublications := memAtomicSQLCount(t, f, "memory_derived_publications")
+			beforeReceipts := memAtomicSQLCount(t, f, "memory_generated_receipts")
+			var beforeSubject types.MemorySubject
+			require.NoError(t, f.db.Where("tenant_id=? AND subject_id=?", f.scope.TenantID, f.scope.SubjectID).Take(&beforeSubject).Error)
+			own := f.ctx.Value(memoryMultiClusterMarker{})
+			actualResultInserts := 0
+			actualResultPublications := 0
+			observer := "actual-generated-multicluster-sql-" + uuid.NewString()
+			require.NoError(t, f.db.Callback().Create().After("gorm:create").Register(observer, func(tx *gorm.DB) {
+				if tx.Error != nil || tx.RowsAffected != 1 || tx.Statement.Context.Value(memoryMultiClusterMarker{}) != own {
+					return
+				}
+				if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+					return
+				}
+				if tx.Statement.Table == "memory_items" {
+					if item, ok := tx.Statement.Dest.(*types.MemoryItem); ok && item.Origin == types.MemoryOriginExtracted && item.TenantID == f.scope.TenantID && item.SubjectID == f.scope.SubjectID {
+						actualResultInserts++
+					}
+				}
+				if tx.Statement.Table == "memory_derived_publications" {
+					if fact, ok := tx.Statement.Dest.(*types.MemoryDerivedPublication); ok && fact.ProducerKind == "generated" && fact.TenantID == f.scope.TenantID && fact.SubjectID == f.scope.SubjectID {
+						actualResultPublications++
+					}
+				}
+			}))
+			t.Cleanup(func() { require.NoError(t, f.db.Callback().Create().Remove(observer)) })
+			result, callErr := f.service.ConsolidateNow(f.ctx)
+			require.Len(t, transport.messages, 2)
+			require.Len(t, transport.responses, 2)
+			require.Len(t, transport.modelLeaseIDs, 2)
+			var original types.MemoryGeneratedOriginal
+			require.NoError(t, f.db.Where("tenant_id=? AND subject_id=?", f.scope.TenantID, f.scope.SubjectID).Take(&original).Error)
+			require.Equal(t, types.MemoryConsolidationOriginalRecipe, original.Recipe)
+			require.NotEmpty(t, original.ModelProofJSON)
+			require.Len(t, original.ModelDigest, 64)
+			var body struct {
+				Prompts     []string
+				Maintenance []types.MemoryItem
+			}
+			require.NoError(t, json.Unmarshal([]byte(original.InputJSON), &body))
+			require.Len(t, body.Prompts, 2)
+			require.Empty(t, body.Maintenance)
+			require.Equal(t, types.MemoryOriginalBytesDigest([]byte(original.InputJSON)), original.InputSHA256)
+			var command types.MemoryConsolidationCommand
+			require.NoError(t, json.Unmarshal([]byte(original.RequestJSON), &command))
+			require.Len(t, command.Clusters, 2)
+			require.Empty(t, command.Demotions)
+			consumed := map[string]bool{}
+			for index, prompt := range body.Prompts {
+				require.Equal(t, []byte(prompt), transport.messages[index], "every admitted serialized message byte must be the byte actually transmitted for this cluster")
+				var actual []chat.Message
+				require.NoError(t, json.Unmarshal(transport.messages[index], &actual))
+				require.Len(t, actual, 2)
+				require.Equal(t, types.MemoryConsolidationOriginalPrompt, actual[0].Content)
+				var expected strings.Builder
+				for _, id := range command.Clusters[index] {
+					item, known := inputs[id]
+					require.True(t, known)
+					require.False(t, consumed[id])
+					consumed[id] = true
+					fmt.Fprintf(&expected, "- (%s) %s\n", item.ValidFrom.Format("2006-01-02"), types.SanitizeMemoryContent(item.Content))
+				}
+				require.Equal(t, []byte(expected.String()), []byte(actual[1].Content), "dates, order, full leased content and delimiters must all match")
+			}
+			require.Len(t, consumed, 4)
+			require.Equal(t, transport.modelLeaseIDs[0], transport.modelLeaseIDs[1], "all calls use the same actual captured current model hold")
+			require.Positive(t, actualResultInserts, "at least the first cluster reached real SQL Create inside the output transaction")
+			require.Positive(t, actualResultPublications, "at least the first cluster reached real immutable publication inside that same transaction")
+			if invalid {
+				require.Error(t, callErr)
+				require.Equal(t, 1, actualResultInserts)
+				require.Equal(t, beforePublications, memAtomicSQLCount(t, f, "memory_derived_publications"))
+				require.Equal(t, beforeReceipts, memAtomicSQLCount(t, f, "memory_generated_receipts"))
+				var rows []types.MemoryItem
+				require.NoError(t, f.db.Where("tenant_id=? AND subject_id=?", f.scope.TenantID, f.scope.SubjectID).Find(&rows).Error)
+				require.Len(t, rows, 4)
+				for _, item := range rows {
+					before, known := inputs[item.ID]
+					require.True(t, known)
+					require.Equal(t, before, item)
+				}
+				var subject types.MemorySubject
+				require.NoError(t, f.db.Where("id=?", beforeSubject.ID).Take(&subject).Error)
+				require.Equal(t, beforeSubject.BlockText, subject.BlockText)
+				require.Equal(t, beforeSubject.ItemCount, subject.ItemCount)
+				require.Equal(t, beforeSubject.ForcedConsolidatedAt, subject.ForcedConsolidatedAt)
+			} else {
+				require.NoError(t, callErr)
+				require.Equal(t, 2, result.Merged)
+				require.Equal(t, 0, result.Demoted)
+				require.Equal(t, 2, actualResultInserts)
+				var receipt types.MemoryGeneratedReceipt
+				require.NoError(t, f.db.Where("original_id=?", original.ID).Take(&receipt).Error)
+				require.Equal(t, original.Digest, receipt.OriginalDigest)
+				var decisions []types.MemoryGeneratedDecision
+				require.NoError(t, json.Unmarshal([]byte(receipt.ResponseJSON), &decisions))
+				require.Len(t, decisions, 2)
+				for index, decision := range decisions {
+					require.Equal(t, index, decision.ClusterIndex)
+					require.Equal(t, transport.responses[index], decision.RawResponse)
+					require.Equal(t, transport.responses[index], decision.ResponseJSON)
+				}
+				var effects []types.MemoryGeneratedEffect
+				require.NoError(t, json.Unmarshal([]byte(receipt.EffectManifest), &effects))
+				actions := map[string]int{}
+				for _, effect := range effects {
+					actions[effect.Action]++
+				}
+				require.Equal(t, 2, actions["merge_add"])
+				require.Equal(t, 4, actions["merge_supersede"])
+				for id := range inputs {
+					var item types.MemoryItem
+					require.NoError(t, f.db.Where("id=?", id).Take(&item).Error)
+					require.Equal(t, types.MemoryStatusSuperseded, item.Status)
+					require.NotEmpty(t, item.SupersededBy)
+				}
+				var active int64
+				require.NoError(t, f.db.Model(&types.MemoryItem{}).Where("tenant_id=? AND subject_id=? AND status=?", f.scope.TenantID, f.scope.SubjectID, types.MemoryStatusActive).Count(&active).Error)
+				require.EqualValues(t, 2, active)
+			}
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
