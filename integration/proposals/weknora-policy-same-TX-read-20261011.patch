@@ -0,0 +1,123 @@
+package repository
+
+import (
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+type memoryPolicyScopedProof struct {
+	Tenant uint64
+	Proof  types.MemoryPolicyProof
+}
+
+// This reuses only immutable facts inside the actual availability owner's
+// active SQL transaction. Controls, actors, scopes, leases and clocks never
+// enter these maps. The owner still flushes fresh ALL-head/payload/journal IO.
+func memoryPolicyAvailabilityScope(tx *gorm.DB) *originalBodyAvailabilityScope {
+	if tx == nil || tx.Statement == nil || tx.Statement.Context == nil {
+		return nil
+	}
+	scope, _ := tx.Statement.Context.Value(originalBodyAvailabilityScopeKey{}).(*originalBodyAvailabilityScope)
+	if scope == nil || scope.pool != tx.Statement.ConnPool {
+		return nil
+	}
+	return scope
+}
+
+func beginMemoryPolicyAvailabilityRead(tx *gorm.DB) (*gorm.DB, func() error, error) {
+	if scope := memoryPolicyAvailabilityScope(tx); scope != nil {
+		scope.mu.Lock()
+		closed, failed := scope.closed, scope.failed
+		scope.mu.Unlock()
+		if failed != nil {
+			return tx, nil, failed
+		}
+		if !closed {
+			if err := scope.ctx.Err(); err != nil {
+				return tx, nil, err
+			}
+			return tx, nil, tx.Statement.Context.Err()
+		}
+	}
+	return beginOriginalBodyAvailabilityScope(tx)
+}
+
+func memoryPolicyScopedOrigin(tx *gorm.DB, tenant uint64, proof types.MemoryPolicyProof) (*types.MemoryPolicyOriginal, bool) {
+	scope := memoryPolicyAvailabilityScope(tx)
+	if scope == nil {
+		return nil, false
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.failed != nil || scope.ctx.Err() != nil || tx.Statement.Context.Err() != nil {
+		return nil, false
+	}
+	origin, ok := scope.policyOrigins[memoryPolicyScopedProof{tenant, proof}]
+	if !ok {
+		return nil, false
+	}
+	return &origin, true
+}
+
+func rememberMemoryPolicyScopedOrigin(tx *gorm.DB, origin *types.MemoryPolicyOriginal) {
+	scope := memoryPolicyAvailabilityScope(tx)
+	if scope == nil {
+		return
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.failed != nil || scope.ctx.Err() != nil || tx.Statement.Context.Err() != nil {
+		return
+	}
+	if scope.policyOrigins == nil {
+		scope.policyOrigins = map[memoryPolicyScopedProof]types.MemoryPolicyOriginal{}
+	}
+	scope.policyOrigins[memoryPolicyScopedProof{origin.TenantID, origin.Proof()}] = *origin
+}
+
+func memoryPolicyScopedReceipt(tx *gorm.DB, originID string) (types.MemoryPolicyBodyReceipt, bool) {
+	scope := memoryPolicyAvailabilityScope(tx)
+	if scope == nil {
+		return types.MemoryPolicyBodyReceipt{}, false
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.failed != nil || scope.ctx.Err() != nil || tx.Statement.Context.Err() != nil {
+		return types.MemoryPolicyBodyReceipt{}, false
+	}
+	receipt, ok := scope.policyReceipts[originID]
+	return receipt, ok
+}
+
+func rememberMemoryPolicyScopedReceipt(tx *gorm.DB, receipt types.MemoryPolicyBodyReceipt) {
+	scope := memoryPolicyAvailabilityScope(tx)
+	if scope == nil {
+		return
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.failed != nil || scope.ctx.Err() != nil || tx.Statement.Context.Err() != nil {
+		return
+	}
+	if scope.policyReceipts == nil {
+		scope.policyReceipts = map[string]types.MemoryPolicyBodyReceipt{}
+	}
+	scope.policyReceipts[receipt.OriginID] = receipt
+}
+
+func memoryPolicyScopedHeads(tx *gorm.DB, originID string) ([]originalBodyFieldHead, bool) {
+	scope := memoryPolicyAvailabilityScope(tx)
+	if scope == nil {
+		return nil, false
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.failed != nil || scope.ctx.Err() != nil || tx.Statement.Context.Err() != nil {
+		return nil, false
+	}
+	heads, ok := scope.rows[originalBodyAvailabilityRow{"memory_policy_originals", originID}]
+	if !ok {
+		return nil, false
+	}
+	return append([]originalBodyFieldHead(nil), heads...), true
+}
