+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// These use the genuine configured policy producer and held reader. The
+// observer records counts/context identities only; it never signs a fact,
+// changes a result/error or supplies a permission to the checker.
+func runMemoryPolicySameTXReadSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"same_tx_current", "foreign_transaction", "last_head_mutation", "last_payload_mutation", "last_payload_bytes_mutation"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			repo, _, reader := actualPolicyRepository(t, f)
+			_, proof, err := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+			require.NoError(t, err)
+			require.NotNil(t, proof)
+			require.True(t, proof.Valid())
+			var origins int64
+			require.NoError(t, f.db.Model(&types.MemoryPolicyOriginal{}).Where("tenant_id=7").Count(&origins).Error)
+			require.EqualValues(t, 1, origins, "one real original, not synthetic chain fixtures")
+			lifetime, ok := repo.(interfaces.MemoryPolicyOriginalLifetimeReader)
+			require.True(t, ok)
+			read, err := lifetime.BeginMemoryPolicyOriginalRead(f.ctx, 7, *proof)
+			require.NoError(t, err)
+			closed := false
+			t.Cleanup(func() {
+				if !closed {
+					require.NoError(t, read.Close())
+				}
+			})
+			var head struct {
+				SlotID, BodyID string
+				Revision       int64
+			}
+			require.NoError(t, f.db.Table("original_body_field_heads").Select("slot_id,body_id,revision").Where("source_table='memory_policy_originals' AND row_key=?", proof.OriginID).Take(&head).Error)
+			require.NotEmpty(t, head.SlotID)
+			require.NotEmpty(t, head.BodyID)
+			var ownedLease struct {
+				LeaseID, BodyID, OwnerID, Kind string
+				Epoch                          int64
+			}
+			require.NoError(t, f.db.Table("original_body_leases").Select("lease_id,body_id,owner_id,kind,epoch").Where("body_id=? AND kind='read' AND released_at_ms IS NULL", head.BodyID).Take(&ownedLease).Error)
+			require.NotEmpty(t, ownedLease.LeaseID)
+			require.Equal(t, head.BodyID, ownedLease.BodyID)
+			require.NotEmpty(t, ownedLease.OwnerID)
+			var receipts, terminalBatches atomic.Int64
+			var triggered atomic.Bool
+			var actualContext context.Context
+			var actualPool gorm.ConnPool
+			const callback = "test:actual_policy_same_tx_read"
+			require.NoError(t, f.db.Callback().Query().Before("gorm:query").Register(callback, func(tx *gorm.DB) {
+				if tx.Statement.Table == "memory_policy_body_receipts" {
+					receipts.Add(1)
+				}
+				if (mode == "last_payload_mutation" || mode == "last_payload_bytes_mutation") && tx.Statement.Table == "original_body_leases" && !triggered.Load() {
