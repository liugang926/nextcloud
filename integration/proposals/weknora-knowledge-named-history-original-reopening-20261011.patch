+func TestKnowledgeNamedHistoryActualSQLiteHTTP(t *testing.T) {
+	for _, mode := range []string{"current", "credential_successor", "definition_successor", "actor_revoked", "query_parent_purged", "vector_ABA"} {
+		t.Run(mode, func(t *testing.T) {
+			knowledgeSQLiteOriginalVecAuto.Do(sqlite_vec.Auto)
+			store, db, base := jointFullSchemaBusinessFixture(t, false)
+			installKnowledgeSQLiteOriginal90ForTest(t, db)
+			installKnowledgeQuery91Actual(t, db)
+			var embeddingCalls, chatCalls atomic.Int64
+			var mu sync.Mutex
+			var observed error
+			const userText = "What does the source say?"
+			const sourceText = "retained-source-body"
+			const indexedText = "query-title\nretained-source-body"
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var err error
+				if r.Header.Get("Authorization") != "Bearer actual-query-key" {
+					err = errors.New("actual query SDK auth mismatch")
+				}
+				if r.URL.Path == "/embeddings" {
+					embeddingCalls.Add(1)
+					var request struct {
+						Input      []string `json:"input"`
+						Dimensions int      `json:"dimensions"`
+					}
+					if e := json.NewDecoder(r.Body).Decode(&request); e != nil {
+						err = e
+					}
+					if len(request.Input) != 1 || request.Dimensions != 2 || request.Input[0] != indexedText && request.Input[0] != userText {
+						err = errors.Join(err, errors.New("actual query SDK did not receive leased exact text"))
+					}
+					mu.Lock()
+					observed = errors.Join(observed, err)
+					mu.Unlock()
+					if err != nil {
+						w.WriteHeader(503)
+						return
+					}
+					w.Header().Set("Content-Type", "application/json")
+					_ = json.NewEncoder(w).Encode(map[string]interface{}{"data": []interface{}{map[string]interface{}{"index": 0, "embedding": []float32{1, 0}}}})
+					return
+				}
+				if r.URL.Path == "/chat/completions" {
+					chatCalls.Add(1)
+					var request struct {
+						Messages []struct{ Role, Content string } `json:"messages"`
+					}
+					if e := json.NewDecoder(r.Body).Decode(&request); e != nil {
+						err = e
+					}
+					all := ""
+					for _, m := range request.Messages {
+						all += m.Content
+					}
+					if !strings.Contains(all, userText) || !strings.Contains(all, sourceText) {
+						err = errors.Join(err, errors.New("actual answer SDK input lost original query/returned vector material"))
+					}
