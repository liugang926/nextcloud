+// Only a concrete same-pool original store can supply history readers. This
+// wiring is not permission, a model constructor or a metadata proof issuer.
+func ConfigureKnowledgeNamedHistoryStore(actual *KnowledgeSQLiteEmbeddingStore) {
+	if actual == nil || actual.material == nil || actual.models == nil {
+		return
+	}
+	a, e := actual.db.DB()
+	b, e2 := actual.material.db.DB()
+	c, e3 := actual.models.db.DB()
+	if e != nil || e2 != nil || e3 != nil || a != b || a != c {
+		return
+	}
+	actual.material.knowledgeNamedHistoryMu.Lock()
+	defer actual.material.knowledgeNamedHistoryMu.Unlock()
+	if actual.material.knowledgeNamedHistory == nil {
+		actual.material.knowledgeNamedHistory = actual
+	}
+}
+
+type knowledgeNamedHistoryRead struct {
+	store    *KnowledgeSQLiteEmbeddingStore
+	ctx      context.Context
+	cancel   context.CancelFunc
+	captured *types.KnowledgeEmbeddingConsumption
+	input    types.KnowledgeQueryEmbeddingInput
+	result   types.KnowledgeQueryEmbeddingReceipt
+	proof    types.ModelOriginalProof
+	model    *historicalModelRead
+	vector   *KnowledgeSQLiteEmbeddingVectorRead
+	parent   *types.MessageMaterialReadPlan
+	leases   map[string]originalBodyLease
+	payloads map[string]originalBodyPayload
+	heads    []originalBodyFieldHead
+	rows     []originalBodyAvailabilityRow
+	content  []NextcloudContentLease
+	mu       sync.Mutex
+	checks   sync.WaitGroup
+	closed   bool
+	failed   error
+	joined   chan struct{}
+}
+
+func (r *knowledgeNamedHistoryRead) start() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if r.failed != nil {
+		return r.failed
+	}
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	r.checks.Add(1)
+	return nil
+}
+func (r *knowledgeNamedHistoryRead) finish(err error) error {
+	r.mu.Lock()
+	if err == nil {
+		err = r.ctx.Err()
+	}
+	if err != nil && r.failed == nil {
+		r.failed = err
+		r.cancel()
+	}
+	r.mu.Unlock()
+	r.checks.Done()
+	return err
+}
+func (r *knowledgeNamedHistoryRead) Context() context.Context { return r.ctx }
+func (s *KnowledgeSQLiteEmbeddingStore) beginNamedKnowledgeHistory(ctx context.Context, c *types.KnowledgeEmbeddingConsumption) (*knowledgeNamedHistoryRead, error) {
+	if ctx == nil || ctx.Err() != nil || c == nil || c.Version != 1 || c.Recipe != "knowledge.query-native-vector-consumer.v1" || c.SourceLineage.RequireComplete() != nil || len(c.SourceLineage.Sources) != 0 || len(c.Candidates) == 0 || c.QueryInputID == "" || c.QueryReceiptID == "" {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	digest, err := knowledgeConsumptionDigest(c)
+	if err != nil || digest != c.Digest {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	r := &knowledgeNamedHistoryRead{store: s, captured: c, leases: map[string]originalBodyLease{}, payloads: map[string]originalBodyPayload{}, joined: make(chan struct{})}
+	r.ctx, r.cancel = context.WithCancel(ctx)
+	fail := func(err error) (*knowledgeNamedHistoryRead, error) { return nil, errors.Join(err, r.Close()) }
+	err = s.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		if e := knowledgeQuerySchemaInTx(tx); e != nil {
+			return e
+		}
+		if e := tx.Select("id,tenant_id,knowledge_base_id,session_id,message_id,admission_id,generation_id,message_body_digest,plan_json,plan_digest,kb_revision,kb_config_digest,model_id,model_proof_json,space_digest,expected_dimensions,input_sha256,digest,created_at_ms").Where("id=?", c.QueryInputID).Take(&r.input).Error; e != nil {
+			return e
+		}
+		if e := tx.Select("id,input_id,input_digest,tenant_id,knowledge_base_id,model_id,space_digest,dimensions,body_sha256,vector_sha256,digest,created_at_ms").Where("id=?", c.QueryReceiptID).Take(&r.result).Error; e != nil {
+			return e
+		}
+		d, e := knowledgeQueryInputDigest(r.input)
+		if e != nil || d != r.input.Digest || d != c.QueryInputDigest {
+			return ErrKnowledgeInputChanged
+		}
+		d, e = knowledgeQueryResultDigest(r.result)
+		if e != nil || d != r.result.Digest || d != c.QueryReceiptDigest || r.result.InputID != r.input.ID || r.result.InputDigest != r.input.Digest || r.result.TenantID != r.input.TenantID || r.result.ModelID != r.input.ModelID || r.input.TenantID != c.TenantID || r.input.KnowledgeBaseID != c.KnowledgeBaseID || r.result.KnowledgeBaseID != c.KnowledgeBaseID || r.result.SpaceDigest != c.SpaceDigest || r.input.SpaceDigest != c.SpaceDigest || r.result.Dimensions != r.input.ExpectedDimensions {
+			return ErrKnowledgeInputChanged
+		}
+		if json.Unmarshal([]byte(r.input.ModelProofJSON), &r.proof) != nil || !r.proof.Valid() || r.proof.ModelID != r.input.ModelID {
+			return ErrKnowledgeInputChanged
+		}
+		var saved types.MessageMaterialReadPlan
+		if json.Unmarshal([]byte(r.input.PlanJSON), &saved) != nil || saved.MetadataDigest != r.input.PlanDigest || saved.Request.AllSession || len(saved.Request.MessageIDs) != 1 || saved.Request.MessageIDs[0] != r.input.MessageID {
+			return ErrKnowledgeInputChanged
+		}
+		plan, e := s.material.peekMessageMaterialReadPlanInTx(tx, saved.Request)
+		if e != nil {
+			return e
+		}
+		a, b := *plan, saved
+		a.MetadataDigest = ""
+		b.MetadataDigest = ""
+		a.RecallHistory = nil
+		b.RecallHistory = nil
+		if !faqInputEqual(a, b) {
+			return ErrKnowledgeInputChanged
+		}
+		r.parent = plan
+		var fact messageMaterialAdmission
+		if e = tx.Where("id=? AND generation_id=? AND message_id=? AND session_id=? AND tenant_id=?", r.input.AdmissionID, r.input.GenerationID, r.input.MessageID, r.input.SessionID, r.input.TenantID).Take(&fact).Error; e != nil {
+			return e
+		}
+		_, owner, rev, e := s.material.currentMessageOwnerInTx(tx, r.input.SessionID)
+		if e != nil || fact.OwnerID != owner.UserID || fact.OwnerRevision != rev || fact.BodyDigest != r.input.MessageBodyDigest {
+			return ErrKnowledgeInputChanged
+		}
+		return nil
+	}, memoryWriteOptions(s.db))
+	if err != nil {
+		return fail(err)
+	}
+	history, err := s.models.BeginHistoricalModelOriginalRead(r.ctx, r.proof)
+	if err != nil {
+		return fail(err)
+	}
+	model, ok := history.(*historicalModelRead)
+	if !ok {
+		_ = history.Close()
+		return fail(ErrKnowledgeSQLiteEmbeddingUnknown)
+	}
+	r.model = model
+	r.ctx = model.Context()
+	owner := "knowledge-named-history/" + uuid.NewString()
+	ids, err := s.material.AcquireMessageBodyReadLeases(r.ctx, r.parent, owner, 15*time.Minute)
+	if err != nil {
+		return fail(err)
+	}
+	if len(ids) == 0 {
+		return fail(ErrOriginalBodyUnavailable)
+	}
+	// Capture every actual parent lease before any named query body hydration.
+	err = s.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		for _, id := range ids {
+			var l originalBodyLease
+			if e := bodyInternal(tx).Where("lease_id=?", id).Take(&l).Error; e != nil {
+				return e
+			}
+			if l.OwnerID != owner {
+				return ErrOriginalBodyUnavailable
+			}
+			r.leases[id] = l
+		}
+		for _, l := range r.model.hold.Hold.Leases {
+			r.leases[l.LeaseID] = l
+		}
+		return nil
+	}, memoryWriteOptions(s.db))
+	if err != nil {
+		cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+		for _, id := range ids {
+			_ = NewOriginalBodyRetentionStore(s.db).ReleaseLease(cleanup, id)
+		}
+		cancel()
+		return fail(err)
+	}
+	scopes := append([]types.KnowledgeSearchScope{}, r.parent.Scopes...)
+	scopes = append(scopes, types.KnowledgeSearchScope{TenantID: r.input.TenantID, KBID: r.input.KnowledgeBaseID})
+	seen := map[types.KnowledgeSearchScope]bool{}
+	for _, scope := range scopes {
+		if seen[scope] {
+			continue
+		}
+		seen[scope] = true
+		l, e := s.material.ContentLeaseStore().AcquireKBRead(r.ctx, scope.TenantID, scope.KBID, owner, 2*time.Minute)
+		if e != nil {
+			return fail(e)
+		}
+		r.content = append(r.content, l)
+	}
+	r.ctx, err = WithFAQReadLeaseCoverage(r.ctx, r.content)
+	if err != nil {
+		return fail(err)
+	}
+	r.ctx, err = WithMessageMaterialReadPlan(r.ctx, r.parent)
+	if err != nil {
+		return fail(err)
+	}
+	rowIDs := []uint64{}
+	for _, candidate := range c.Candidates {
+		rowIDs = append(rowIDs, candidate.RowID)
+	}
+	r.vector, err = s.BeginVectorRead(r.ctx, rowIDs)
+	if err != nil {
+		return fail(err)
+	}
+	err = s.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		rows := []originalBodyAvailabilityRow{{r.input.TableName(), r.input.ID}, {r.result.TableName(), r.result.ID}}
+		if e := checkOriginalBodyAvailableBatchInTx(r.ctx, tx, rows); e != nil {
+			return e
+		}
+		heads, e := originalBodyBatchHeads(tx, rows)
+		if e != nil || len(heads) != 2 {
+			return ErrOriginalBodyUnavailable
+		}
+		r.rows = rows
+		r.heads = heads
+		for _, h := range heads {
+			sha, id, column := r.input.InputSHA256, r.input.ID, "input_json"
+			if h.SourceTable == r.result.TableName() {
+				sha, id, column = r.result.BodySHA256, r.result.ID, "vector_json"
+			} else if h.SourceTable != r.input.TableName() {
+				return ErrOriginalBodyUnavailable
+			}
+			scope := originalBodyScope{Tenant: r.input.TenantID, KB: r.input.KnowledgeBaseID, OwnerKind: h.SourceTable, OwnerID: id}
+			if h.SourceTable == r.input.TableName() {
+				scope.AdmissionID = r.input.AdmissionID
+			}
+			ref, ok := bodyReference(h.OriginalBodyRef)
+			if !ok || h.ColumnName != column || h.RowKey != id || h.TenantID != r.input.TenantID || h.KnowledgeBaseID != r.input.KnowledgeBaseID || h.SourceIdentitySHA256 != bodyIdentity(h.SourceTable, id, column, scope) || ref.BodyID != h.BodyID || ref.SlotID != h.SlotID || ref.SHA256 != sha {
+				return ErrOriginalBodyUnavailable
+			}
+		}
+		for _, h := range heads {
+			id, e := NewOriginalBodyRetentionStore(tx).acquireLeaseInTx(tx, h.BodyID, "read", owner, 15*time.Minute)
+			if e != nil {
+				return e
+			}
+			var l originalBodyLease
+			if e = bodyInternal(tx).Where("lease_id=?", id).Take(&l).Error; e != nil {
+				return e
+			}
+			r.leases[id] = l
+		}
+		for _, l := range r.leases {
+			var b originalBodyPayload
+			if e = bodyInternal(tx).Where("id=?", l.BodyID).Take(&b).Error; e != nil {
+				return e
+			}
+			r.payloads[l.BodyID] = b
+		}
+		return r.checkInTx(tx)
+	}, memoryWriteOptions(s.db))
+	if err != nil {
+		return fail(err)
+	}
+	return r, nil
+}
+func (r *knowledgeNamedHistoryRead) checkInTx(tx *gorm.DB) error {
+	if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	pool, err := tx.DB()
+	if err != nil {
+		return err
+	}
+	actual, err := r.store.db.DB()
+	if err != nil || actual != pool || !sameOriginalModelCallerInRepository(tx.Statement.Context, r.ctx) {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	authority, err := knowledgeSQLiteEmbeddingAuthority(tx, r.store.material)
+	if err != nil {
+		return err
+	}
+	fresh, err := authority.RefreshCurrentReadActor(r.ctx)
+	if err != nil {
+		return err
+	}
+	var kb types.KnowledgeBase
+	if err = tx.Select("id,tenant_id,type,creator_id,is_temporary,embedding_model_id,summary_model_id,chunking_config,image_processing_config,vlm_config,asr_config,extract_config,faq_config,question_generation_config,auto_tag_config,profile_config,wiki_config,indexing_strategy,enrichment_templates,deleted_at").Where("id=? AND tenant_id=? AND deleted_at IS NULL", r.input.KnowledgeBaseID, r.input.TenantID).Take(&kb).Error; err != nil {
+		return err
+	}
+	if kb.EmbeddingModelID != r.input.ModelID || !kb.IndexingStrategy.VectorEnabled {
+		return ErrKnowledgeInputChanged
+	}
+	dummy := &KnowledgeSQLiteEmbeddingVectorRead{}
+	if err = dummy.authorizeKB(authority, fresh, &kb); err != nil {
+		return err
+	}
+	lineage, e := readKnowledgeConfigurationOrigin(tx, &kb)
+	if e != nil || lineage == nil || lineage.RequireComplete() != nil || len(lineage.Sources) != 0 {
+		return ErrKnowledgeInputChanged
+	}
+	revision, e := knowledgeConfigurationControlRevision(tx, kb.ID)
+	if e != nil || revision != r.input.KBRevision {
+		return ErrKnowledgeInputChanged
+	}
+	config, e := knowledgeConfigurationOriginDigest(&kb)
+	if e != nil || config != r.input.KBConfigDigest {
+		return ErrKnowledgeInputChanged
+	}
+	if err = CheckHistoricalModelOriginalHolds(r.model.Context(), tx.Session(&gorm.Session{NewDB: true}), r.proof); err != nil {
+		return err
+	}
+	facts, err := loadHistoricalModelFacts(tx.Session(&gorm.Session{NewDB: true}).WithContext(r.model.Context()), r.proof)
+	if err != nil {
+		return err
+	}
+	var definition types.ModelOriginalDefinition
+	if json.Unmarshal([]byte(facts.Definition.DefinitionJSON), &definition) != nil || definition.Type != types.ModelTypeEmbedding || definition.Parameters.OriginalEmbedding == nil || modelembedding.ValidateOriginalEmbeddingDefinition(definition.Parameters.OriginalEmbedding) != nil || definition.Parameters.OriginalEmbedding.SpaceDigest != r.input.SpaceDigest || definition.Parameters.OriginalEmbedding.ExpectedDimensions != r.input.ExpectedDimensions {
+		return ErrKnowledgeInputChanged
+	}
+	var in types.KnowledgeQueryEmbeddingInput
+	var result types.KnowledgeQueryEmbeddingReceipt
+	if err = tx.Where("id=?", r.input.ID).Take(&in).Error; err != nil {
+		return err
+	}
+	if err = tx.Where("id=?", r.result.ID).Take(&result).Error; err != nil {
+		return err
+	}
+	id, err := knowledgeQueryInputDigest(in)
+	if err != nil || id != r.input.Digest || id != in.Digest || bodySHA([]byte(in.InputJSON)) != in.InputSHA256 {
+		return ErrKnowledgeInputChanged
+	}
+	rd, err := knowledgeQueryResultDigest(result)
+	if err != nil || rd != r.result.Digest || rd != result.Digest || bodySHA([]byte(result.VectorJSON)) != result.BodySHA256 {
+		return ErrKnowledgeInputChanged
+	}
+	metaIn, metaResult := in, result
+	metaIn.InputJSON = ""
+	metaResult.VectorJSON = ""
+	if !reflect.DeepEqual(metaIn, r.input) || !reflect.DeepEqual(metaResult, r.result) {
+		return ErrKnowledgeInputChanged
+	}
+	var queryBody struct{ Text string }
+	if json.Unmarshal([]byte(in.InputJSON), &queryBody) != nil || queryBody.Text == "" {
+		return ErrKnowledgeInputChanged
+	}
+	var original messageMaterialAdmission
+	if err = tx.Where("id=? AND generation_id=? AND tenant_id=?", in.AdmissionID, in.GenerationID, in.TenantID).Take(&original).Error; err != nil {
+		return err
+	}
+	_, owner, ownerRevision, e := r.store.material.currentMessageOwnerInTx(tx, in.SessionID)
+	if e != nil || original.OwnerID != owner.UserID || original.OwnerRevision != ownerRevision || original.BodyDigest != in.MessageBodyDigest {
+		return ErrKnowledgeInputChanged
+	}
+	var vector []float32
+	if json.Unmarshal([]byte(result.VectorJSON), &vector) != nil {
+		return ErrKnowledgeInputChanged
+	}
+	bytes, err := knowledgeSQLiteVectorBytes(vector)
+	if err != nil || len(vector) != in.ExpectedDimensions || bodySHA(bytes) != result.VectorSHA256 {
+		return ErrKnowledgeInputChanged
+	}
+	var named types.MessageMaterialReadPlan
+	if json.Unmarshal([]byte(in.PlanJSON), &named) != nil {
+		return ErrKnowledgeInputChanged
+	}
+	current, err := r.store.material.peekMessageMaterialReadPlanInTx(tx, named.Request)
+	if err != nil {
+		return err
+	}
+	a, b := *current, named
+	a.MetadataDigest = ""
+	b.MetadataDigest = ""
+	a.RecallHistory = nil
+	b.RecallHistory = nil
+	if !faqInputEqual(a, b) {
+		return ErrKnowledgeInputChanged
+	}
+	snapshot, err := r.store.material.captureMessageMaterialInTx(tx.Session(&gorm.Session{NewDB: true}), named.Request)
+	if err != nil {
+		return err
+	}
+	if len(snapshot.Messages) != 1 || len(snapshot.Proofs) != 1 || snapshot.Messages[0] == nil || snapshot.Proofs[0] == nil {
+		return ErrKnowledgeInputChanged
+	}
+	message, proof := snapshot.Messages[0], snapshot.Proofs[0]
+	if message.ID != in.MessageID || message.Role != "user" || !message.IsCompleted || message.Content != queryBody.Text || proof.AdmissionID != in.AdmissionID || proof.GenerationID != in.GenerationID || proof.BodyDigest != in.MessageBodyDigest {
+		return ErrKnowledgeInputChanged
+	}
+	if err = r.vector.CheckInTx(r.vector.Context(), tx); err != nil {
+		return err
+	}
+	for _, candidate := range r.captured.Candidates {
+		input, receipt := r.vector.originals[candidate.RowID], r.vector.receipts[candidate.RowID]
+		if input.ID != candidate.InputID || input.Digest != candidate.InputDigest || receipt.ID != candidate.ReceiptID || receipt.Digest != candidate.ReceiptDigest || receipt.Revision != candidate.Revision || input.ModelProofJSON != candidate.ModelProofJSON || input.SpaceDigest != in.SpaceDigest {
+			return ErrKnowledgeInputChanged
+		}
+	}
+	// Never run a new provider or rerank to certify old output. Exact named hits
+	// and query bytes are authenticated by the immutable saved consumption.
+	seen := map[uint64]bool{}
+	for _, h := range r.captured.Hits {
+		if seen[h.RowID] || r.vector.receipts[h.RowID].ID == "" {
+			return ErrKnowledgeInputChanged
+		}
+		seen[h.RowID] = true
+	}
+	if err = checkOriginalBodyAvailableBatchForCapturedInTx(r.ctx, tx, r.rows, r.heads); err != nil {
+		return err
+	}
+	return r.finalClockInTx(tx)
+}
+func (r *knowledgeNamedHistoryRead) capturedBindings() (map[string]originalBodyLease, map[string]originalBodyPayload, []NextcloudContentLease, error) {
+	all := map[string]originalBodyLease{}
+	payloads := map[string]originalBodyPayload{}
+	if err := mergeMemoryFinalLeaseBindings(all, r.leases); err != nil {
+		return nil, nil, nil, err
+	}
+	if err := mergeMemoryFinalLeaseBindings(all, r.vector.leases); err != nil {
+		return nil, nil, nil, err
+	}
+	for id, b := range r.payloads {
+		payloads[id] = b
+	}
+	for id, b := range r.vector.payloads {
+		if before, ok := payloads[id]; ok && !reflect.DeepEqual(before, b) {
+			return nil, nil, nil, ErrOriginalBodyUnavailable
+		}
+		payloads[id] = b
+	}
+	return all, payloads, r.content, nil
+}
+func (r *knowledgeNamedHistoryRead) finalClockInTx(tx *gorm.DB) error {
+	all, payloads, content, err := r.capturedBindings()
+	if err != nil {
+		return err
+	}
+	// Current identity/KB permission stays fresh after the named physical IO.
+	authority, err := knowledgeSQLiteEmbeddingAuthority(tx, r.store.material)
+	if err != nil {
+		return err
+	}
+	fresh, err := authority.RefreshCurrentReadActor(r.ctx)
+	if err != nil {
+		return err
+	}
+	var kb types.KnowledgeBase
+	if err = tx.Select("id,tenant_id,type,creator_id,is_temporary,deleted_at").Where("id=? AND tenant_id=? AND deleted_at IS NULL", r.input.KnowledgeBaseID, r.input.TenantID).Take(&kb).Error; err != nil {
+		return err
+	}
+	if err = r.vector.authorizeKB(authority, fresh, &kb); err != nil {
+		return err
+	}
+	if err = NewOriginalBodyRetentionStore(tx).checkJournalInTx(tx); err != nil {
+		return err
+	}
+	if err = knowledgeQueryFinalClockInTx(tx, all, payloads, content); err != nil {
+		return err
+	}
+	for _, ctx := range r.clockContexts() {
+		if err = ctx.Err(); err != nil {
+			return err
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+func (r *knowledgeNamedHistoryRead) Recheck() error {
+	if err := r.start(); err != nil {
+		return err
+	}
+	err := r.store.db.WithContext(r.ctx).Transaction(r.checkInTx, memoryWriteOptions(r.store.db))
+	return r.finish(err)
+}
+func (r *knowledgeNamedHistoryRead) Close() error {
+	r.mu.Lock()
+	if r.closed {
+		joined := r.joined
+		r.mu.Unlock()
+		<-joined
+		r.mu.Lock()
+		err := r.failed
+		r.mu.Unlock()
+		return err
+	}
+	r.closed = true
+	r.cancel()
+	r.mu.Unlock()
+	r.checks.Wait()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	var err error
+	borrowed := map[string]bool{}
+	if r.model != nil {
+		for _, l := range r.model.hold.Hold.Leases {
+			borrowed[l.LeaseID] = true
+		}
+	}
+	ids := []string{}
+	for id := range r.leases {
+		if !borrowed[id] {
+			ids = append(ids, id)
+		}
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		err = errors.Join(err, NewOriginalBodyRetentionStore(r.store.db).ReleaseLease(cleanup, id))
+	}
+	for _, l := range r.content {
+		err = errors.Join(err, r.store.material.ContentLeaseStore().ReleaseLease(cleanup, l.ID))
+	}
+	if r.vector != nil {
+		err = errors.Join(err, r.vector.Close())
+	}
+	if r.model != nil {
+		err = errors.Join(err, r.model.Close())
+	}
+	r.mu.Lock()
+	if r.failed == nil {
+		r.failed = err
+	}
+	close(r.joined)
+	r.mu.Unlock()
+	return err
+}
+
+// No binding is read back from SQL as new authority. The owning group joins
+// Close while callers project these exact privately acquired identities.
+func (r *knowledgeNamedHistoryRead) clockContexts() []context.Context {
+	out := []context.Context{r.ctx, r.model.Context(), r.vector.Context()}
+	for _, model := range r.vector.models {
+		out = append(out, model.Context())
+	}
+	return out
+}
+
+// Capture the complete baseline only when the owning group has just acquired
+// and concretely checked this exact opaque historical read. Later clocks must
+// compare this baseline, never accept a newly observed payload as authority.
+func knowledgeHistoricalModelPayloadsInTx(ctx context.Context, tx *gorm.DB, read *historicalModelRead) (map[string]originalBodyPayload, error) {
+	if read == nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err := CheckHistoricalModelOriginalHolds(ctx, tx, read.hold.Hold.Proof); err != nil {
+		return nil, err
+	}
+	out := map[string]originalBodyPayload{}
+	for _, body := range read.hold.Hold.Bodies {
+		var p originalBodyPayload
+		if err := bodyInternal(tx).Where("id=?", body.Head.BodyID).Take(&p).Error; err != nil {
+			return nil, err
+		}
+		lease, ok := read.hold.Hold.Leases[body.Head.BodyID]
+		if !ok || p.ID != lease.BodyID || p.TenantID != read.hold.Hold.Proof.OwnerTenantID || p.State != "live" || p.PurgeEpoch != lease.Epoch || p.BodySHA256 != body.Receipt.BodyDigest {
+			return nil, ErrOriginalBodyUnavailable
+		}
+		out[p.ID] = p
+	}
+	return out, nil
+}
+
+// The first concrete configuration is immutable. Request reads take only this
+// short pointer lock; it never spans SQL or a wait on the shared pool.
+func (s *KnowledgeInputProvenanceStore) knowledgeNamedHistoryStore() *KnowledgeSQLiteEmbeddingStore {
+	s.knowledgeNamedHistoryMu.RLock()
+	defer s.knowledgeNamedHistoryMu.RUnlock()
+	return s.knowledgeNamedHistory
+}
