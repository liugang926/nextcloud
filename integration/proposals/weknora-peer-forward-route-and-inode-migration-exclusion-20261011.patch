+				afterVersion, afterDirty := jointLineageMigrationState(t, db)
+				require.Equal(t, beforeVersion, afterVersion)
+				require.Equal(t, beforeDirty, afterDirty)
+			}
+			var tenantAfter string
+			require.NoError(t, db.QueryRow("SELECT business FROM tenants WHERE id=7").Scan(&tenantAfter))
+			require.Equal(t, tenantBefore, tenantAfter)
+			if pg {
+				var after string
+				require.NoError(t, db.QueryRow("SELECT jsonb_agg(to_jsonb(e) ORDER BY id)::text FROM embeddings e").Scan(&after))
+				require.Equal(t, embeddingBefore, after)
+			}
+		})
+	}
+}
+
+func TestPeerForwardProductionRouteActualSQLite(t *testing.T)   { runPeerForwardRouteActual(t, false) }
+func TestPostgresPeerForwardProductionRouteActual(t *testing.T) { runPeerForwardRouteActual(t, true) }
diff --git a/internal/database/migration_peer_sqlite_exclusive.go b/internal/database/migration_peer_sqlite_exclusive.go
new file mode 100644
index 000000000..7be4e9477
--- /dev/null
+++ b/internal/database/migration_peer_sqlite_exclusive.go
@@ -0,0 +1,143 @@
+package database
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+type jointPeerSQLiteMigrationContextKey struct{}
+
+// This file descriptor is a migration exclusion, never an original/role grant.
+// It owns the real existing main DB inode, not a derived lock-file pathname.
+// It is kept until the migration driver's Close has actually returned.
+type jointPeerSQLiteMigrationExclusion struct {
+	file          *os.File
+	identity      os.FileInfo
+	mainPath      string
+	requestedPath string
+	resolvedPath  string
+	once          sync.Once
+	closeErr      error
+}
+
+func (x *jointPeerSQLiteMigrationExclusion) Close() error {
+	x.once.Do(func() { x.closeErr = x.file.Close() })
+	return x.closeErr
+}
+func (x *jointPeerSQLiteMigrationExclusion) check(ctx context.Context) error {
+	if ctx == nil {
+		return ErrJointSchemaUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	descriptor, err := x.file.Stat()
+	if err != nil || !os.SameFile(descriptor, x.identity) {
+		return ErrJointSchemaUnknown
+	}
+	requested, err := os.Stat(x.requestedPath)
+	if err != nil || !os.SameFile(requested, x.identity) {
+		return ErrJointSchemaUnknown
+	}
+	main, err := os.Stat(x.mainPath)
+	if err != nil || !os.SameFile(main, x.identity) {
+		return ErrJointSchemaUnknown
+	}
+	resolved, err := os.Stat(x.resolvedPath)
+	if err != nil || !os.SameFile(resolved, x.identity) {
+		return ErrJointSchemaUnknown
+	}
+	return validatePeerSQLiteMigrationFile(descriptor)
+}
+func peerSQLiteMigrationExclusionFromContext(ctx context.Context) (*jointPeerSQLiteMigrationExclusion, error) {
+	if ctx == nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	held, ok := ctx.Value(jointPeerSQLiteMigrationContextKey{}).(*jointPeerSQLiteMigrationExclusion)
+	if !ok || held == nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	return held, held.check(ctx)
+}
+func checkPeerSQLiteMigrationExclusion(ctx context.Context) error {
+	if ctx == nil {
+		return ErrJointSchemaUnavailable
+	}
+	if ctx.Value(jointPeerSQLiteMigrationContextKey{}) == nil {
+		return nil
+	}
+	_, err := peerSQLiteMigrationExclusionFromContext(ctx)
+	return err
+}
+
+// Derive the filename from this actual read-only SQLite connection. The input
+// path is not a filename guess or an externally chosen migration lock key.
+func acquirePeerSQLiteMigrationExclusion(ctx context.Context, dsn string, options MigrationOptions) (*jointPeerSQLiteMigrationExclusion, error) {
+	if ctx == nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	options.jointReadOnly = true
+	db, dialect, err := openJointLineageDB(dsn, options)
+	if err != nil {
+		return nil, err
+	}
+	if dialect != "sqlite" {
+		_ = db.Close()
+		return nil, ErrJointSchemaUnavailable
+	}
+	rows, err := db.QueryContext(ctx, "PRAGMA database_list")
+	if err != nil {
+		_ = db.Close()
+		return nil, ErrJointSchemaUnavailable
+	}
+	mainPath := ""
+	count := 0
+	for rows.Next() {
+		var sequence int
+		var name, filename string
+		if rows.Scan(&sequence, &name, &filename) != nil {
+			_ = rows.Close()
+			_ = db.Close()
+			return nil, ErrJointSchemaUnavailable
+		}
+		if name == "main" {
+			mainPath = filename
+			count++
+		}
+	}
+	err = errors.Join(rows.Err(), rows.Close(), db.Close())
+	if err != nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	if count != 1 || mainPath == "" || !filepath.IsAbs(mainPath) {
+		return nil, ErrJointSchemaUnknown
+	}
+	resolvedPath, err := filepath.EvalSymlinks(mainPath)
+	if err != nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	requestedPath := options.SQLiteDBPath
+	if requestedPath == "" {
+		requestedPath = strings.TrimPrefix(dsn, "sqlite3://")
+	}
+	requestedPath, err = filepath.Abs(requestedPath)
+	if err != nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	held, err := lockPeerSQLiteMigrationInode(ctx, mainPath, resolvedPath)
+	if err != nil {
+		return nil, err
+	}
+	held.requestedPath = requestedPath
+	if err = held.check(ctx); err != nil {
+		return nil, errors.Join(err, held.Close())
+	}
+	return held, nil
+}
