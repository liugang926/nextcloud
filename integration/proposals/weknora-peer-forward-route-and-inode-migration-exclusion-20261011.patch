diff --git a/internal/database/migration_peer_sqlite_exclusive_unix_actual_test.go b/internal/database/migration_peer_sqlite_exclusive_unix_actual_test.go
new file mode 100644
index 000000000..cf37861c2
--- /dev/null
+++ b/internal/database/migration_peer_sqlite_exclusive_unix_actual_test.go
@@ -0,0 +1,262 @@
+//go:build linux || darwin
+
+package database
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A real independent process owns the kernel lock. Its stdout carries only
+// static phase tokens, never DB body/proof/credential values or a guessed PID.
+func TestPeerSQLiteMigrationProcessHelper(t *testing.T) {
+	if os.Getenv("WEKNORA_PEER_SQLITE_KERNEL_HELPER") != "1" {
+		return
+	}
+	path := os.Getenv("WEKNORA_PEER_SQLITE_KERNEL_DB")
+	require.NotEmpty(t, path)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	options := MigrationOptions{SQLiteDBPath: path, AutoRecoverDirty: false}
+	if os.Getenv("WEKNORA_PEER_SQLITE_KERNEL_MODE") == "up" {
+		probe, stop := context.WithTimeout(ctx, 60*time.Millisecond)
+		_, err := acquirePeerSQLiteMigrationExclusion(probe, "sqlite3://unused", options)
+		stop()
+		require.ErrorIs(t, err, context.DeadlineExceeded, "parent must really own the OFD lock")
+		fmt.Println("PEER_OFD_BLOCKED")
+		require.NoError(t, RunMigrationsWithContext(ctx, "sqlite3://unused", options))
+		fmt.Println("PEER_UP_COMPLETE")
+		return
+	}
+	held, err := acquirePeerSQLiteMigrationExclusion(ctx, "sqlite3://unused", options)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, held.Close()) }()
+	fmt.Println("PEER_OFD_HELD")
+	done := make(chan error, 1)
+	go func() { var b [1]byte; _, err := os.Stdin.Read(b[:]); done <- err }()
+	select {
+	case err := <-done:
+		require.True(t, err == nil || errors.Is(err, io.EOF))
+	case <-ctx.Done():
+		t.Error("owned helper release did not arrive")
+	}
+}
+
+type peerSQLiteProcess struct {
+	cmd     *exec.Cmd
+	release io.WriteCloser
+	tokens  <-chan string
+	wait    <-chan error
+	joined  bool
+}
+
+func startPeerSQLiteProcess(t *testing.T, path, mode string) *peerSQLiteProcess {
+	t.Helper()
+	cmd := exec.Command(os.Args[0], "-test.run=^TestPeerSQLiteMigrationProcessHelper$", "-test.count=1")
+	cmd.Env = append(os.Environ(), "WEKNORA_PEER_SQLITE_KERNEL_HELPER=1", "WEKNORA_PEER_SQLITE_KERNEL_DB="+path, "WEKNORA_PEER_SQLITE_KERNEL_MODE="+mode)
+	stdout, err := cmd.StdoutPipe()
+	require.NoError(t, err)
+	release, err := cmd.StdinPipe()
+	require.NoError(t, err)
+	require.NoError(t, cmd.Start())
+	tokens := make(chan string, 4)
+	wait := make(chan error, 1)
+	go func() {
+		scanner := bufio.NewScanner(stdout)
+		for scanner.Scan() {
+			line := scanner.Text()
+			if strings.HasPrefix(line, "PEER_") {
+				tokens <- line
+			}
+		}
+		close(tokens)
+	}()
+	go func() { wait <- cmd.Wait() }()
+	process := &peerSQLiteProcess{cmd: cmd, release: release, tokens: tokens, wait: wait}
+	t.Cleanup(func() {
+		_ = release.Close()
+		if process.joined {
+			return
+		}
+		select {
+		case <-wait:
+			process.joined = true
+		case <-time.After(3 * time.Second):
+			_ = cmd.Process.Kill()
+			select {
+			case <-wait:
+				process.joined = true
+			case <-time.After(3 * time.Second):
+				t.Error("owned kernel helper did not actually join")
+			}
+		}
+	})
+	return process
+}
+func peerSQLiteToken(t *testing.T, p *peerSQLiteProcess, want string) {
+	t.Helper()
+	select {
+	case got, ok := <-p.tokens:
+		require.True(t, ok)
+		require.Equal(t, want, got)
+	case <-time.After(3 * time.Second):
+		t.Fatal("real independent kernel lock token not observed")
+	}
+}
+func peerSQLiteJoin(t *testing.T, p *peerSQLiteProcess, wantSuccess bool) {
+	t.Helper()
+	select {
+	case err := <-p.wait:
+		p.joined = true
+		if wantSuccess {
+			require.NoError(t, err)
+		} else {
+			require.Error(t, err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("real independent process did not terminate")
+	}
+}
+func peerSQLiteActual80(t *testing.T) (string, MigrationOptions) {
+	t.Helper()
+	root := sqliteRepoRoot(t)
+	chdirAndRestore(t, root)
+	db, dsn, options := jointLineageFixture(t, false)
+	m := peerPrefixActualDriver(t, root, "sqlite", dsn, options)
+	require.NoError(t, m.Migrate(73))
+	require.NoError(t, memoryFullExec(db, "sqlite", "INSERT INTO tenants(id,name,business) VALUES(7,'actual-kernel-owner','retained actual data')"))
+	require.NoError(t, m.Migrate(80))
+	se, de := m.Close()
+	require.NoError(t, se)
+	require.NoError(t, de)
+	var mode string
+	require.NoError(t, db.QueryRow("PRAGMA journal_mode=WAL").Scan(&mode))
+	require.Equal(t, "wal", mode)
+	return dsn, options
+}
+
+func TestPeerSQLiteKernelMigrationExclusionActual(t *testing.T) {
+	t.Run("two_processes_symlink_cancel_and_release", func(t *testing.T) {
+		dsn, options := peerSQLiteActual80(t)
+		alias := filepath.Join(t.TempDir(), "actual-peer-alias.sqlite")
+		require.NoError(t, os.Symlink(options.SQLiteDBPath, alias))
+		child := startPeerSQLiteProcess(t, options.SQLiteDBPath, "hold")
+		peerSQLiteToken(t, child, "PEER_OFD_HELD")
+		ctx, cancel := context.WithTimeout(context.Background(), 60*time.Millisecond)
+		_, err := acquirePeerSQLiteMigrationExclusion(ctx, dsn, MigrationOptions{SQLiteDBPath: alias})
+		cancel()
+		require.ErrorIs(t, err, context.DeadlineExceeded)
+		require.NoError(t, child.release.Close())
+		peerSQLiteJoin(t, child, true)
+		held, err := acquirePeerSQLiteMigrationExclusion(context.Background(), dsn, MigrationOptions{SQLiteDBPath: alias})
+		require.NoError(t, err)
+		require.NoError(t, held.Close())
+	})
+	t.Run("close_other_fd_keeps_lock_and_sql_writer_works", func(t *testing.T) {
+		dsn, options := peerSQLiteActual80(t)
+		held, err := acquirePeerSQLiteMigrationExclusion(context.Background(), dsn, options)
+		require.NoError(t, err)
+		t.Cleanup(func() { require.NoError(t, held.Close()) })
+		other, err := os.Open(options.SQLiteDBPath)
+		require.NoError(t, err)
+		require.NoError(t, other.Close())
+		writer, _, err := openJointLineageDB(dsn, options)
+		require.NoError(t, err)
+		defer writer.Close()
+		tx, err := writer.Begin()
+		require.NoError(t, err)
+		result, err := tx.Exec("UPDATE tenants SET business=business WHERE 1=0")
+		require.NoError(t, err)
+		rows, err := result.RowsAffected()
+		require.NoError(t, err)
+		require.Zero(t, rows)
+		require.NoError(t, tx.Rollback())
+		ctx, cancel := context.WithTimeout(context.Background(), 60*time.Millisecond)
+		defer cancel()
+		_, err = acquirePeerSQLiteMigrationExclusion(ctx, dsn, options)
+		require.ErrorIs(t, err, context.DeadlineExceeded, "closing SQLite/other fd must not release OFD ownership")
+	})
+	t.Run("sigkill_releases_real_process_lock", func(t *testing.T) {
+		dsn, options := peerSQLiteActual80(t)
+		child := startPeerSQLiteProcess(t, options.SQLiteDBPath, "hold")
+		peerSQLiteToken(t, child, "PEER_OFD_HELD")
+		require.NoError(t, child.cmd.Process.Kill())
+		peerSQLiteJoin(t, child, false)
+		held, err := acquirePeerSQLiteMigrationExclusion(context.Background(), dsn, options)
+		require.NoError(t, err)
+		require.NoError(t, held.Close())
+	})
+	t.Run("actual_up_serializes_second_process_restart", func(t *testing.T) {
+		dsn, options := peerSQLiteActual80(t)
+		held, err := acquirePeerSQLiteMigrationExclusion(context.Background(), dsn, options)
+		require.NoError(t, err)
+		t.Cleanup(func() { require.NoError(t, held.Close()) })
+		ctx := context.WithValue(context.Background(), jointPeerSQLiteMigrationContextKey{}, held)
+		route, err := selectJointMigrationRoute(ctx, dsn, options, 80, false, true)
+		require.NoError(t, err)
+		m, err := newJointPeerRouteMigrate(ctx, "file://"+filepath.ToSlash(route.directory), dsn, options, 80, route)
+		require.NoError(t, err)
+		driverClosed := false
+		t.Cleanup(func() {
+			if !driverClosed {
+				se, de := m.Close()
+				if se != nil || de != nil {
+					t.Error("owned first migration driver close failed")
+				}
+				driverClosed = true
+			}
+		})
+		alias := filepath.Join(t.TempDir(), "actual-up-alias.sqlite")
+		require.NoError(t, os.Symlink(options.SQLiteDBPath, alias))
+		child := startPeerSQLiteProcess(t, alias, "up")
+		peerSQLiteToken(t, child, "PEER_OFD_BLOCKED")
+		require.NoError(t, m.Up(), "real first migrator preserves driver fileTX+dirty semantics")
+		se, de := m.Close()
+		driverClosed = true
+		require.NoError(t, se)
+		require.NoError(t, de)
+		require.NoError(t, held.Close())
+		peerSQLiteToken(t, child, "PEER_UP_COMPLETE")
+		peerSQLiteJoin(t, child, true)
+		read, _, err := openJointLineageDB(dsn, MigrationOptions{SQLiteDBPath: options.SQLiteDBPath, jointReadOnly: true})
+		require.NoError(t, err)
+		defer read.Close()
+		require.NoError(t, VerifyJointSchemaReadyOnDB(context.Background(), read, "sqlite"))
+		version, dirty, known, err := observeJointSchemaHistoryOnDB(context.Background(), read, "sqlite")
+		require.NoError(t, err)
+		require.True(t, known)
+		require.EqualValues(t, 89, version)
+		require.False(t, dirty)
+	})
+	t.Run("hardlink_wal_alias_and_replaced_inode_refuse", func(t *testing.T) {
+		dsn, options := peerSQLiteActual80(t)
+		hard := filepath.Join(t.TempDir(), "unsafe-hardlink.sqlite")
+		require.NoError(t, os.Link(options.SQLiteDBPath, hard))
+		_, err := acquirePeerSQLiteMigrationExclusion(context.Background(), dsn, options)
+		require.ErrorIs(t, err, ErrJointSchemaUnknown)
+		require.NoError(t, os.Remove(hard))
+		held, err := acquirePeerSQLiteMigrationExclusion(context.Background(), dsn, options)
+		require.NoError(t, err)
+		defer held.Close()
+		moved := options.SQLiteDBPath + ".owned-original"
+		require.NoError(t, os.Rename(options.SQLiteDBPath, moved))
+		replacement, err := os.OpenFile(options.SQLiteDBPath, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		require.NoError(t, err)
+		require.NoError(t, replacement.Close())
+		require.ErrorIs(t, held.check(context.Background()), ErrJointSchemaUnknown, "real inode replacement cannot borrow held DB identity")
+		require.NoError(t, os.Remove(options.SQLiteDBPath))
+		require.NoError(t, os.Rename(moved, options.SQLiteDBPath))
+		require.NoError(t, held.check(context.Background()), "restore this owned fault before ordinary pool cleanup")
+	})
+}
