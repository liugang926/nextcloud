diff --git a/internal/database/migration_peer_route.go b/internal/database/migration_peer_route.go
new file mode 100644
index 000000000..538e9c428
--- /dev/null
+++ b/internal/database/migration_peer_route.go
@@ -0,0 +1,431 @@
+package database
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+// A route is derived from the actual ledger, catalogue and immutable source
+// files. It is never caller configured, a body original or an access grant.
+type jointMigrationRoute struct {
+	lineage      jointMigrationSourceLineage
+	directory    string
+	sourceDigest string
+	finalVersion uint
+}
+
+func jointPeerForwardVersion(dialect string, version uint) bool {
+	if dialect == "versioned" {
+		return version == 161 || version == 169 || version == 170 || version == 171
+	}
+	return dialect == "sqlite" && (version == 80 || version == 88 || version == 89)
+}
+
+func jointCanonicalMigrationRoute(dialect string) (jointMigrationRoute, error) {
+	witness, err := jointLineageWitnessesFromSource()
+	if err != nil {
+		return jointMigrationRoute{}, err
+	}
+	if err = jointLineageVerifyAvailableSources(dialect, witness); err != nil {
+		return jointMigrationRoute{}, err
+	}
+	root, err := os.Getwd()
+	if err != nil {
+		return jointMigrationRoute{}, ErrJointSchemaSourceIdentity
+	}
+	var latest uint
+	for _, module := range witness.Modules[dialect] {
+		if module.Version > latest {
+			latest = module.Version
+		}
+	}
+	if latest == 0 {
+		return jointMigrationRoute{}, ErrJointSchemaSourceIdentity
+	}
+	return jointMigrationRoute{jointCanonicalRootSource, filepath.Join(root, "migrations", dialect), fmt.Sprintf("%x", sha256.Sum256(jointLineageWitnessJSON)), latest}, nil
+}
+
+func selectJointMigrationRoute(ctx context.Context, dsn string, options MigrationOptions, version uint, dirty, known bool) (jointMigrationRoute, error) {
+	dialect := jointLineageDialect(dsn, options)
+	if err := checkPeerSQLiteMigrationExclusion(ctx); err != nil {
+		return jointMigrationRoute{}, err
+	}
+	canonical, err := jointCanonicalMigrationRoute(dialect)
+	if err != nil {
+		return jointMigrationRoute{}, err
+	}
+	if !jointPeerForwardVersion(dialect, version) || !known || dirty {
+		return canonical, preflightJointSchemaLineage(ctx, dsn, options, version, dirty, known)
+	}
+	// The final canonical versions differ from all supported peer versions.
+	// A peer version can only choose this route after its complete catalogue.
+	readOptions := options
+	readOptions.jointReadOnly = true
+	db, _, err := openJointLineageDB(dsn, readOptions)
+	if err != nil {
+		return jointMigrationRoute{}, err
+	}
+	defer db.Close()
+	return inspectJointPeerForwardRoute(ctx, db, canonical.directory, dialect, version)
+}
+
+func recheckJointMigrationRoute(ctx context.Context, dsn string, options MigrationOptions, version uint, dirty, known bool, captured jointMigrationRoute) error {
+	current, err := selectJointMigrationRoute(ctx, dsn, options, version, dirty, known)
+	if err != nil {
+		return err
+	}
+	if current != captured {
+		return ErrJointSchemaSourceIdentity
+	}
+	return ctx.Err()
+}
+
+// These are source projections of the actual Root payloads copied into the
+// peer tail, not a physical ledger alias. Root155/156 execute as170/171 and
+// SQLite74/75 execute as88/89; schema_migrations retains those real versions.
+func jointExpectedPeerForwardCatalogue(dialect string, version uint) (jointCatalogueExpected, error) {
+	latest, withdrawal, memory := uint(161), uint(170), uint(171)
+	rootWithdrawal, rootMemory := uint(155), uint(156)
+	if dialect == "sqlite" {
+		latest, withdrawal, memory = 80, 88, 89
+		rootWithdrawal, rootMemory = 74, 75
+	}
+	if !jointPeerForwardVersion(dialect, version) {
+		return jointCatalogueExpected{}, ErrJointSchemaUnknown
+	}
+	expected, err := jointExpectedPeerPrefixCatalogue(dialect, latest)
+	if err != nil {
+		return expected, err
+	}
+	var root jointCatalogueBlueprint
+	if json.Unmarshal(jointCatalogueJSON, &root) != nil {
+		return expected, ErrJointSchemaSourceIdentity
+	}
+	for _, module := range root.Modules[dialect] {
+		if (module.Version == rootWithdrawal && version >= withdrawal) || (module.Version == rootMemory && version >= memory) {
+			if err = applyJointPeerForwardModule(expected, module); err != nil {
+				return expected, err
+			}
+			if module.RegistryConstraint != "" {
+				expected.RegistryConstraint = module.RegistryConstraint
+			}
+		}
+	}
+	return expected, nil
+}
+
+func applyJointPeerForwardModule(expected jointCatalogueExpected, module jointCatalogueModule) error {
+	for name, definition := range module.Tables {
+		expected.Tables[name] = definition
+	}
+	for _, definition := range module.Triggers {
+		tokens := jointSQLTokens(definition)
+		if len(tokens) < 4 {
+			return ErrJointSchemaSourceIdentity
+		}
+		expected.Triggers[tokens[2]] = definition
+	}
+	for _, definition := range module.Functions {
+		// The final catalogue still verifies full function bodies and metadata.
+		name, err := jointPeerForwardDefinitionName(definition, "function")
+		if err != nil {
+			return err
+		}
+		expected.Functions[name] = definition
+	}
+	for _, definition := range module.Indexes {
+		name, err := jointPeerForwardDefinitionName(definition, "index")
+		if err != nil {
+			return err
+		}
+		expected.Indexes[name] = definition
+	}
+	for _, definition := range module.Alters {
+		tokens := jointSQLTokens(definition)
+		if len(tokens) < 7 || tokens[0] != "alter" || tokens[1] != "table" || tokens[3] != "add" || tokens[4] != "column" || !jointIdentifier.MatchString(tokens[2]) || !jointIdentifier.MatchString(tokens[5]) {
+			return ErrJointSchemaSourceIdentity
+		}
+		table, column := tokens[2], tokens[5]
+		// Preserve the actual definition's literal bytes, including defaults.
+		columnStart := jointPeerForwardColumnDefinition(definition, column)
+		if columnStart == "" {
+			return ErrJointSchemaSourceIdentity
+		}
+		if expected.Columns[table] == nil {
+			expected.Columns[table] = map[string]string{}
+		}
+		expected.Columns[table][column] = columnStart
+		if tableSQL, ok := expected.Tables[table]; ok {
+			parts, err := jointColumnParts(tableSQL)
+			if err != nil {
+				return err
+			}
+			already := false
+			for _, part := range parts {
+				fields := jointSQLTokens(part)
+				if len(fields) > 0 && fields[0] == column {
+					already = true
+				}
+			}
+			if !already {
+				last := len(tableSQL) - 1
+				for last >= 0 && tableSQL[last] != ')' {
+					last--
+				}
+				if last < 0 {
+					return ErrJointSchemaSourceIdentity
+				}
+				expected.Tables[table] = tableSQL[:last] + "," + columnStart + tableSQL[last:]
+			}
+		}
+	}
+	return nil
+}
+
+func inspectJointPeerForwardRoute(ctx context.Context, db *sql.DB, canonicalDirectory, dialect string, version uint) (jointMigrationRoute, error) {
+	var none jointMigrationRoute
+	if ctx == nil || db == nil || !jointPeerForwardVersion(dialect, version) {
+		return none, ErrJointSchemaUnknown
+	}
+	root := filepath.Dir(filepath.Dir(canonicalDirectory))
+	assets, err := verifyJointPeerForwardSourceAssets(root, dialect)
+	if err != nil {
+		return none, err
+	}
+	if err = verifyJointPeerPrefixProjection(dialect); err != nil {
+		return none, err
+	}
+	if err = verifyJointPeerTailProjection(root, dialect); err != nil {
+		return none, err
+	}
+	expected, err := jointExpectedPeerForwardCatalogue(dialect, version)
+	if err != nil {
+		return none, err
+	}
+	txOptions := &sql.TxOptions{ReadOnly: true}
+	if dialect == "versioned" {
+		txOptions.Isolation = sql.LevelRepeatableRead
+	}
+	tx, err := db.BeginTx(ctx, txOptions)
+	if err != nil {
+		return none, ErrJointSchemaUnavailable
+	}
+	defer tx.Rollback()
+	rows, err := tx.QueryContext(ctx, "SELECT version,dirty FROM schema_migrations")
+	if err != nil {
+		return none, ErrJointSchemaUnknown
+	}
+	count := 0
+	for rows.Next() {
+		var got uint
+		var dirty bool
+		if rows.Scan(&got, &dirty) != nil {
+			rows.Close()
+			return none, ErrJointSchemaUnknown
+		}
+		count++
+		if dirty {
+			rows.Close()
+			return none, ErrJointSchemaAmbiguousDirty
+		}
+		if got != version {
+			rows.Close()
+			return none, ErrJointSchemaUnknown
+		}
+	}
+	readErr, closeErr := rows.Err(), rows.Close()
+	if readErr != nil || closeErr != nil {
+		return none, ErrJointSchemaUnavailable
+	}
+	if count != 1 {
+		return none, ErrJointSchemaUnknown
+	}
+	objects, _, err := peerPrefixObjectSets(ctx, tx, dialect)
+	if err != nil {
+		return none, err
+	}
+	witness, err := jointLineageWitnessesFromSource()
+	if err != nil {
+		return none, err
+	}
+	if err = jointVerifySentinelObjectKinds(objects, witness.Sentinels, expected); err != nil {
+		return none, err
+	}
+	for table, columns := range witness.Sentinels.Columns {
+		for _, column := range columns {
+			present, err := peerPrefixIntroducedColumn(ctx, tx, dialect, table, column)
+			if err != nil {
+				return none, err
+			}
+			if present {
+				if _, ok := expected.Columns[table][column]; !ok {
+					return none, ErrJointSchemaUnknown
+				}
+			}
+		}
+	}
+	if err = verifyPeerPrefixCatalogueInTx(ctx, tx, dialect, expected); err != nil {
+		return none, err
+	}
+	if dialect == "versioned" {
+		if version >= 170 {
+			if err = jointVerifyWithdrawalKindConstraint(ctx, tx, expected.RegistryConstraint); err != nil {
+				return none, err
+			}
+		}
+		core, err := inspectJoint125LocalRepair(ctx, tx)
+		if err != nil {
+			return none, err
+		}
+		// Only a verified pre169 local binding can be missing.169 repeats the
+		// complete check under its actual local table lock before repairing it.
+		if core.state != joint125GuardCurrent && core.state != joint125OptionalAbsent && !(version == 161 && core.state == joint125GuardMissing) {
+			return none, ErrJointSchemaUnknown
+		}
+	}
+	again, err := verifyJointPeerForwardSourceAssets(root, dialect)
+	if err != nil || again != assets {
+		return none, ErrJointSchemaSourceIdentity
+	}
+	if err = verifyJointPeerTailProjection(root, dialect); err != nil {
+		return none, err
+	}
+	if err = ctx.Err(); err != nil {
+		return none, err
+	}
+	if err = checkPeerSQLiteMigrationExclusion(ctx); err != nil {
+		return none, err
+	}
+	if err = tx.Commit(); err != nil {
+		return none, ErrJointSchemaUnavailable
+	}
+	return jointMigrationRoute{jointHistoricalPeerForwardSource, filepath.Join(root, "migrations", "peer-forward", dialect), assets.SourceDigest, assets.PhysicalLatest}, nil
+}
+
+func verifyJointPeerTailProjection(root, dialect string) error {
+	var blueprint jointCatalogueBlueprint
+	var manifest jointPeerForwardAssetManifest
+	if json.Unmarshal(jointCatalogueJSON, &blueprint) != nil || json.Unmarshal(jointPeerForwardSourceAssetJSON, &manifest) != nil {
+		return ErrJointSchemaSourceIdentity
+	}
+	versions := map[uint]uint{155: 170, 156: 171}
+	if dialect == "sqlite" {
+		versions = map[uint]uint{74: 88, 75: 89}
+	}
+	for sourceVersion, targetVersion := range versions {
+		var module *jointCatalogueModule
+		for i := range blueprint.Modules[dialect] {
+			if blueprint.Modules[dialect][i].Version == sourceVersion {
+				module = &blueprint.Modules[dialect][i]
+			}
+		}
+		if module == nil {
+			return ErrJointSchemaSourceIdentity
+		}
+		matches := 0
+		for _, file := range manifest.Routes[dialect].Files {
+			if file.Version == targetVersion && file.Direction == "up" {
+				matches++
+				a, e1 := os.ReadFile(filepath.Join(root, module.Path))
+				b, e2 := os.ReadFile(filepath.Join(root, file.Path))
+				if e1 != nil || e2 != nil || string(a) != string(b) || fmt.Sprintf("%x", sha256.Sum256(a)) != module.SHA256 || module.SHA256 != file.SHA256 {
+					return ErrJointSchemaSourceIdentity
+				}
+			}
+		}
+		if matches != 1 {
+			return ErrJointSchemaSourceIdentity
+		}
+	}
+	return nil
+}
+
+func verifyJointReadyRouteOnDB(ctx context.Context, db *sql.DB, dialect string) error {
+	canonical, err := jointCanonicalMigrationRoute(dialect)
+	if err != nil {
+		return err
+	}
+	version, dirty, known, err := observeJointSchemaHistoryOnDB(ctx, db, dialect)
+	if err != nil {
+		return err
+	}
+	if dirty && version >= jointLineageFirstVersion(dialect) {
+		return ErrJointSchemaAmbiguousDirty
+	}
+	if !known || dirty {
+		return ErrJointSchemaNotReady
+	}
+	if version == canonical.finalVersion {
+		return verifyJointRootCatalogue(ctx, db, dialect, version)
+	}
+	if !jointPeerForwardVersion(dialect, version) {
+		return ErrJointSchemaNotReady
+	}
+	peer, err := inspectJointPeerForwardRoute(ctx, db, canonical.directory, dialect, version)
+	if err != nil {
+		return err
+	}
+	if version != peer.finalVersion {
+		return ErrJointSchemaNotReady
+	}
+	return ctx.Err()
+}
+
+func jointPeerForwardDefinitionName(definition, kind string) (string, error) {
+	pattern := `(?is)^CREATE(?: OR REPLACE)? FUNCTION\s+([a-z_0-9]+)`
+	if kind == "index" {
+		pattern = `(?is)^CREATE(?: UNIQUE)? INDEX(?: IF NOT EXISTS)?\s+([a-z_0-9]+)`
+	}
+	match := regexp.MustCompile(pattern).FindStringSubmatch(definition)
+	if len(match) != 2 || !jointIdentifier.MatchString(match[1]) {
+		return "", ErrJointSchemaSourceIdentity
+	}
+	return match[1], nil
+}
+func jointPeerForwardColumnDefinition(definition, column string) string {
+	match := regexp.MustCompile(`(?is)^ALTER TABLE\s+[a-z_0-9]+\s+ADD COLUMN\s+([a-z_0-9]+)\s+(.+?);?$`).FindStringSubmatch(definition)
+	if len(match) != 3 || match[1] != column {
+		return ""
+	}
+	return column + " " + strings.TrimSuffix(match[2], ";")
+}
+func verifyJointPeerPrefixProjection(dialect string) error {
+	var blueprint jointPeerPrefixBlueprint
+	var manifest jointPeerForwardAssetManifest
+	if json.Unmarshal(jointPeerPrefixCatalogueJSON, &blueprint) != nil || json.Unmarshal(jointPeerForwardSourceAssetJSON, &manifest) != nil {
+		return ErrJointSchemaSourceIdentity
+	}
+	route, ok := manifest.Routes[dialect]
+	if !ok || len(blueprint.Modules[dialect]) != 8 {
+		return ErrJointSchemaSourceIdentity
+	}
+	for _, module := range blueprint.Modules[dialect] {
+		count := 0
+		for _, file := range route.Files {
+			if file.Direction == "up" && file.Path == module.Path && file.SHA256 == module.SHA256 {
+				count++
+			}
+		}
+		if count != 1 {
+			return ErrJointSchemaSourceIdentity
+		}
+	}
+	evolution := blueprint.CommonEvolution[dialect]
+	count := 0
+	for _, file := range route.Files {
+		if file.Direction == "up" && file.Version == evolution.Version && file.Path == evolution.Path && file.SHA256 == evolution.SHA256 {
+			count++
+		}
+	}
+	if count != 1 {
+		return ErrJointSchemaSourceIdentity
+	}
+	return nil
+}
