+func TestPeerForwardFinalCatalogueSourceProjection(t *testing.T) {
+	root := sqliteRepoRoot(t)
+	for _, dialect := range []string{"sqlite", "versioned"} {
+		t.Run(dialect, func(t *testing.T) {
+			require.NoError(t, verifyJointPeerPrefixProjection(dialect))
+			require.NoError(t, verifyJointPeerTailProjection(root, dialect))
+			physical, canonical := uint(89), uint(87)
+			if dialect == "versioned" {
+				physical, canonical = 171, 168
+			}
+			peer, err := jointExpectedPeerForwardCatalogue(dialect, physical)
+			require.NoError(t, err)
+			current, err := jointExpectedCatalogue(dialect, canonical)
+			require.NoError(t, err)
+			require.Equal(t, current, peer, "only actual full forward payloads produce the equivalent final catalogue; physical ledger is still89/171")
+		})
