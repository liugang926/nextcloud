@@ -0,0 +1,15 @@
+//go:build !linux && !darwin
+
+package database
+
+import (
+	"context"
+	"os"
+)
+
+// The Linux/Darwin OFD contracts is not projected onto another platform/VFS. Platform
+// support remains required; an unsupported peer migration stays closed.
+func validatePeerSQLiteMigrationFile(os.FileInfo) error { return ErrJointSchemaUnavailable }
+func lockPeerSQLiteMigrationInode(context.Context, string, string) (*jointPeerSQLiteMigrationExclusion, error) {
+	return nil, ErrJointSchemaUnavailable
+}
