+				require.NoError(t, VerifyJointSchemaReady(context.Background(), dsn, opts))
+				require.NoError(t, VerifyJointSchemaReadyOnDB(context.Background(), db, dialect), "qualify this actual pool, not a replacement DSN")
+				readyBefore := memoryFullSchemaSnapshot(t, db, dialect)
+				require.NoError(t, RunMigrationsWithOptions(dsn, opts), "honest171/89 restart uses same route; never alias168/87")
+				require.Equal(t, readyBefore, memoryFullSchemaSnapshot(t, db, dialect))
+				version, dirty = jointLineageMigrationState(t, db)
+				require.Equal(t, final, version)
+				require.False(t, dirty)
+				if pg {
+					core, err := inspectJoint125LocalRepair(context.Background(), db)
+					require.NoError(t, err)
+					require.Equal(t, joint125GuardCurrent, core.state)
