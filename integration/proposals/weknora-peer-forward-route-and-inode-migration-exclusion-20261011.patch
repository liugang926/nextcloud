+				var originals int
+				require.NoError(t, db.QueryRow("SELECT count(*) FROM memory_original_admissions").Scan(&originals))
+				require.Zero(t, originals, "migration cannot adopt legacy data as a body original")
+				require.NoError(t, db.QueryRow("SELECT count(*) FROM model_definition_originals").Scan(&originals))
+				require.Zero(t, originals)
+				if mode == "down_refused" {
+					downgrade := peerPrefixActualDriver(t, root, dialect, dsn, opts)
+					require.Error(t, downgrade.Down(), "actual forward DOWN refuses before persistent drop")
+					se, de := downgrade.Close()
+					require.NoError(t, se)
+					require.NoError(t, de)
+					require.Equal(t, readyBefore, memoryFullSchemaSnapshot(t, db, dialect))
+					_, actualDirty := jointLineageMigrationState(t, db)
+					require.True(t, actualDirty, "driver honestly marks failed Down dirty; never repair ledger")
+					require.ErrorIs(t, VerifyJointSchemaReadyOnDB(context.Background(), db, dialect), ErrJointSchemaAmbiguousDirty)
+				}
+			}
+			if runErr != nil {
