+package database
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+
+	"github.com/golang-migrate/migrate/v4"
+	migratedatabase "github.com/golang-migrate/migrate/v4/database"
+	sqlite3migrate "github.com/golang-migrate/migrate/v4/database/sqlite3"
+)
+
+// Up acquires this real driver lock before reading its ledger or SetVersion.
+// Revalidate the exact captured tuple there, not only on an earlier pool.
+// The wrapper forwards Run/SetVersion unchanged and never implements Force.
+type jointPeerRouteMigrationDriver struct {
+	migratedatabase.Driver
+	ctx     context.Context
+	dsn     string
+	options MigrationOptions
+	version uint
+	route   jointMigrationRoute
+}
+
+func (d *jointPeerRouteMigrationDriver) Lock() error {
+	if err := d.Driver.Lock(); err != nil {
+		return err
+	}
+	fail := func(err error) error { return errors.Join(err, d.Driver.Unlock()) }
+	version, dirty, err := d.Driver.Version()
+	if err != nil {
+		return fail(ErrJointSchemaUnavailable)
+	}
+	if version < 0 || uint(version) != d.version || dirty {
+		return fail(ErrJointSchemaUnknown)
+	}
+	if err := recheckJointMigrationRoute(d.ctx, d.dsn, d.options, uint(version), dirty, true, d.route); err != nil {
+		return fail(err)
+	}
+	return nil
+}
+
+func newJointPeerRouteMigrate(ctx context.Context, sourceURL, dsn string, options MigrationOptions, version uint, route jointMigrationRoute) (*migrate.Migrate, error) {
+	if jointLineageDialect(dsn, options) == "sqlite" {
+		if _, err := peerSQLiteMigrationExclusionFromContext(ctx); err != nil {
+			return nil, err
+		}
+	}
+	var driver migratedatabase.Driver
+	var err error
+	name := "postgres"
+	if options.SQLiteDBPath != "" {
+		name = "sqlite3"
+		raw, err := jointSQLiteFilenameDSN(options.SQLiteDBPath, "rwc")
+		if err != nil {
+			return nil, err
+		}
+		pool, err := sql.Open("sqlite3", raw)
+		if err != nil {
+			return nil, err
+		}
+		driver, err = sqlite3migrate.WithInstance(pool, &sqlite3migrate.Config{})
+		if err != nil {
+			return nil, errors.Join(err, pool.Close())
+		}
+	} else {
+		if jointLineageDialect(dsn, options) == "sqlite" {
+			name = "sqlite3"
+		}
+		driver, err = migratedatabase.Open(dsn)
+		if err != nil {
+			return nil, err
+		}
+	}
+	guarded := &jointPeerRouteMigrationDriver{Driver: driver, ctx: ctx, dsn: dsn, options: options, version: version, route: route}
+	m, err := migrate.NewWithDatabaseInstance(sourceURL, name, guarded)
+	if err != nil {
+		return nil, errors.Join(err, guarded.Close())
+	}
+	return m, nil
+}
