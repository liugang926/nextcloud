--- /dev/null
+++ b/internal/database/migration_peer_sqlite_exclusive_darwin.go
@@ -0,0 +1,96 @@
+//go:build darwin
+
+package database
+
+import (
+	"context"
+	"errors"
+	"os"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/golang-migrate/migrate/v4"
+	"golang.org/x/sys/unix"
+)
+
+// Verified from Apple's SDK sys/fcntl.h. The pinned x/sys Darwin generated
+// constants omit OFD commands, so use this OS ABI constant without a POSIX
+// F_SETLK/flock fallback. An older/unsupported kernel returns an error closed.
+const darwinPeerOFDSetLK = 90
+
+func validatePeerSQLiteMigrationFile(info os.FileInfo) error {
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || !info.Mode().IsRegular() || st.Nlink != 1 {
+		return ErrJointSchemaUnknown
+	}
+	// Multiple hardlink names can have different WAL sidecars. Mandatory file
+	// locking modes cannot borrow the advisory noninterference guarantee either.
+	if info.Mode()&os.ModeSetgid != 0 && info.Mode().Perm()&0010 == 0 {
+		return ErrJointSchemaUnknown
+	}
+	return nil
+}
+func lockPeerSQLiteMigrationInode(ctx context.Context, mainPath, resolvedPath string) (*jointPeerSQLiteMigrationExclusion, error) {
+	fd, err := unix.Open(resolvedPath, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	file := os.NewFile(uintptr(fd), resolvedPath)
+	if file == nil {
+		_ = unix.Close(fd)
+		return nil, ErrJointSchemaUnavailable
+	}
+	// The default pinned SQLite Darwin finder uses POSIX locks on these local
+	// filesystems (APFS through its successful F_GETLK path). Remote/proxy/flock
+	// variants remain unsupported, never inferred from an arbitrary VFS.
+	var filesystem unix.Statfs_t
+	if err = unix.Fstatfs(fd, &filesystem); err != nil {
+		_ = file.Close()
+		return nil, ErrJointSchemaUnavailable
+	}
+	fstype := strings.TrimRight(string(filesystem.Fstypename[:]), "\x00")
+	if (fstype != "apfs" && fstype != "hfs" && fstype != "ufs") || filesystem.Flags&unix.MNT_RDONLY != 0 {
+		_ = file.Close()
+		return nil, ErrJointSchemaUnavailable
+	}
+	identity, err := file.Stat()
+	if err != nil {
+		_ = file.Close()
+		return nil, ErrJointSchemaUnavailable
+	}
+	if err = validatePeerSQLiteMigrationFile(identity); err != nil {
+		_ = file.Close()
+		return nil, err
+	}
+	held := &jointPeerSQLiteMigrationExclusion{file: file, identity: identity, mainPath: mainPath, resolvedPath: resolvedPath}
+	// OFD locks remain owned by this open file description, including after
+	// SQLite closes another fd for this inode. No blocking lock goroutine exists.
+	// Byte0 is outside pinned SQLite's POSIX PENDING/RESERVED/SHARED ranges
+	// starting at0x40000000; no DB byte, SQL writer or ledger row is changed.
+	wait, cancel := context.WithTimeout(ctx, migrate.DefaultLockTimeout)
+	defer cancel()
+	for {
+		if err = wait.Err(); err != nil {
+			_ = held.Close()
+			return nil, err
+		}
+		lock := unix.Flock_t{Type: unix.F_WRLCK, Whence: 0, Start: 0, Len: 1}
+		err = unix.FcntlFlock(file.Fd(), darwinPeerOFDSetLK, &lock)
+		if err == nil {
+			return held, nil
+		}
+		if !errors.Is(err, unix.EAGAIN) && !errors.Is(err, unix.EACCES) && !errors.Is(err, unix.EINTR) {
+			_ = held.Close()
+			return nil, ErrJointSchemaUnavailable
+		}
+		timer := time.NewTimer(20 * time.Millisecond)
+		select {
+		case <-wait.Done():
+			timer.Stop()
+			_ = held.Close()
+			return nil, wait.Err()
+		case <-timer.C:
+		}
+	}
+}
