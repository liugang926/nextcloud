--- /dev/null
+++ b/internal/application/service/model_original_download_host_shutdown_actual_test.go
@@ -0,0 +1,186 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/Tencent/WeKnora/internal/shutdown"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/Tencent/WeKnora/internal/utils"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func runOriginalDownloadExpiredHTTPDrain(t *testing.T, pg bool) {
+	f := newMemAtomicSQLFixture(t, pg)
+	_, models, _, _ := actualOriginalModelServices(t, f)
+	life, ok := models.(interfaces.ModelOriginalDownloadLifecycle)
+	require.True(t, ok)
+	ctx, cancel := context.WithTimeout(f.ctx, 8*time.Second)
+	pullStarted, pullJoined, pullRelease := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var pullStartOnce, pullJoinOnce, pullReleaseOnce sync.Once
+	var calls atomic.Int64
+	var tasks sync.WaitGroup
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/pull" {
+			w.WriteHeader(400)
+			return
+		}
+		calls.Add(1)
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.Header().Set("Content-Type", "application/x-ndjson")
+		_, _ = io.WriteString(w, "{\"status\":\"pulling manifest\"}\n")
+		w.(http.Flusher).Flush()
+		pullStartOnce.Do(func() { close(pullStarted) })
+		defer pullJoinOnce.Do(func() { close(pullJoined) })
+		select {
+		case <-r.Context().Done():
+		case <-pullRelease:
+		}
+	}))
+	handlerStarted, handlerRelease := make(chan struct{}), make(chan struct{})
+	var handlerStartOnce, handlerReleaseOnce sync.Once
+	host := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		handlerStartOnce.Do(func() { close(handlerStarted) })
+		select {
+		case <-r.Context().Done():
+		case <-handlerRelease:
+		}
+		w.WriteHeader(204)
+	}))
+	t.Cleanup(func() {
+		handlerReleaseOnce.Do(func() { close(handlerRelease) })
+		pullReleaseOnce.Do(func() { close(pullRelease) })
+		cancel()
+		life.StopOriginalDownloads()
+		_ = host.Config.Close()
+		tasks.Wait()
+		host.Close()
+		provider.Close()
+	})
+	utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+	t.Cleanup(utils.ResetSSRFWhitelistForTest)
+	life.StartOriginalDownloads()
+	model := &types.Model{ID: "actual-expired-http-drain-original-pull", TenantID: 7, Name: "nomic-embed-text:actual-drain", Type: types.ModelTypeEmbedding, Source: types.ModelSourceLocal, Parameters: types.ModelParameters{BaseURL: provider.URL, EmbeddingParameters: types.EmbeddingParameters{Dimension: 2}}}
+	require.NoError(t, models.CreateModel(ctx, model))
+	require.NotNil(t, model.OriginalProof)
+	require.True(t, model.OriginalProof.Valid())
+	select {
+	case <-pullStarted:
+	case <-ctx.Done():
+		t.Fatal("genuine creation download did not reach owned HTTP")
+	}
+	httpDone := make(chan error, 1)
+	tasks.Add(1)
+	go func() {
+		defer tasks.Done()
+		req, err := http.NewRequestWithContext(ctx, http.MethodGet, host.URL, nil)
+		if err != nil {
+			httpDone <- err
+			return
+		}
+		response, err := host.Client().Do(req)
+		if response != nil {
+			_ = response.Body.Close()
+		}
+		httpDone <- err
+	}()
+	select {
+	case <-handlerStarted:
+	case <-ctx.Done():
+		t.Fatal("real active HTTP handler did not start")
+	}
+	// The handler actually consumes the small drain deadline. The host helper
+	// must continue from this terminal HTTP result without renewing user input.
+	drain, cancelDrain := context.WithTimeout(context.Background(), 500*time.Millisecond)
+	defer cancelDrain()
+	err := host.Config.Shutdown(drain)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.ErrorIs(t, drain.Err(), context.DeadlineExceeded)
+	require.NoError(t, host.Config.Close())
+	cleaner := shutdown.NewResourceCleaner()
+	var dependenciesReleased atomic.Bool
+	// Register in this order intentionally: ordinary LIFO would invoke dependent
+	// cleanup first. The host's mandatory join precedes the entire ordinary chain.
+	cleaner.RegisterWithName("OriginalModelDownloads", func() error { life.StopOriginalDownloads(); return nil })
+	cleaner.RegisterWithName("DependentSQLResource", func() error {
+		select {
+		case <-pullJoined:
+		case <-ctx.Done():
+			return fmt.Errorf("owned original pull did not observe cancellation before dependent cleanup: %w", ctx.Err())
+		}
+		if err := life.WaitOriginalDownload(ctx, model.ID); !errors.Is(err, context.Canceled) {
+			return fmt.Errorf("expected real canceled download terminal before cleanup: %v", err)
+		}
+		clean := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx})
+		var leases int64
+		if err := clean.Table("original_body_leases").Where("kind=? AND released_at_ms IS NULL", "read").Count(&leases).Error; err != nil {
+			return err
+		}
+		if leases != 0 {
+			return fmt.Errorf("%d actual input-body leases remain before dependent cleanup", leases)
+		}
+		var outputs int64
+		if err := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Model(&types.ModelDownloadOriginal{}).Where("model_id=?", model.ID).Count(&outputs).Error; err != nil {
+			return err
+		}
+		if outputs != 0 {
+			return fmt.Errorf("canceled original download published %d output facts", outputs)
+		}
+		dependenciesReleased.Store(true)
+		return nil
+	})
+	// Exercise the reported old host call chain against the same actual task:
+	// ordinary cleanup refuses this expired HTTP context and skips callbacks.
+	oldErrors := cleaner.Cleanup(drain)
+	require.Len(t, oldErrors, 1)
+	require.ErrorIs(t, oldErrors[0], context.DeadlineExceeded)
+	require.False(t, dependenciesReleased.Load())
+	select {
+	case <-pullJoined:
+		t.Fatal("the old expired-context path unexpectedly canceled the still-owned download")
+	default:
+	}
+	var definition types.ModelOriginalBodyReceipt
+	require.NoError(t, f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Where("origin_id=?", model.OriginalProof.DefinitionID).Take(&definition).Error)
+	var held int64
+	require.NoError(t, f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Table("original_body_leases").Where("body_id=? AND kind=? AND released_at_ms IS NULL", definition.BodyID, "read").Count(&held).Error)
+	require.Equal(t, int64(1), held, "the actual created model still owns its original input lease")
+	cleanupDone := make(chan []error, 1)
+	tasks.Add(1)
+	go func() {
+		defer tasks.Done()
+		cleanupDone <- shutdown.CleanupAfterHTTPDrain(drain, 500*time.Millisecond, models, cleaner)
+	}()
+	select {
+	case errs := <-cleanupDone:
+		require.Empty(t, errs)
+	case <-ctx.Done():
+		t.Fatal("expired-drain host cleanup failed to join its actual download")
+	}
+	require.True(t, dependenciesReleased.Load(), "fresh ordinary cleanup must follow the actual mandatory download join")
+	require.Equal(t, int64(1), calls.Load())
+	select {
+	case <-httpDone:
+	case <-ctx.Done():
+		t.Fatal("forced-close HTTP request did not finish")
+	}
+	var stored types.Model
+	require.NoError(t, f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Where("id=?", model.ID).Take(&stored).Error)
+	require.Equal(t, types.ModelStatusDownloading, stored.Status)
+	assertMemAtomicSQLLeasesClosed(t, f)
+}
