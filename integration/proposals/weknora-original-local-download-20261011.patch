@@ -0,0 +1,15 @@
+package container
+
+import (
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// Invoked after DB construction and all model-authority providers. Stop owns
+// cancellation and joins download/watch operations before cleanup returns.
+// This container does not register a database-close callback.
+func registerOriginalModelDownloads(models interfaces.ModelService, cleaner interfaces.ResourceCleaner) {
+	if life, ok := models.(interfaces.ModelOriginalDownloadLifecycle); ok {
+		life.StartOriginalDownloads()
+		cleaner.RegisterWithName("OriginalModelDownloads", func() error { life.StopOriginalDownloads(); return nil })
+	}
+}
