@@ -0,0 +1,55 @@
+package types
+
+import (
+	"encoding/json"
+	"time"
+)
+
+// A creation-authorized download recipe, never a running-model grant.
+type ModelOriginalDownloadDefinition struct {
+	Version                                                      int
+	Recipe, WireRecipe, BaseURL, URL, RemoteModel, Auth          string
+	Headers                                                      map[string]string
+	Stream                                                       bool
+	RequestTimeoutSeconds, WatchIntervalMillis, MaxResponseBytes int
+	RetryMaxRetries                                              int
+	Digest                                                       string
+}
+
+func ModelOriginalDownloadDigest(r *ModelOriginalDownloadDefinition) (string, error) {
+	if r == nil {
+		return "", ErrMemoryOriginalUnavailable
+	}
+	copy := *r
+	copy.Digest = ""
+	wire, err := json.Marshal(copy)
+	return MemoryOriginalBytesDigest(wire), err
+}
+
+// TranscriptJSON records the exact transmitted request and received response,
+// without credentials. Body152 captures it in the same state-publication TX.
+type ModelDownloadOriginal struct {
+	ID                                                         string `gorm:"primaryKey"`
+	ModelID                                                    string
+	TenantID                                                   uint64
+	InputStateID, InputProofDigest, DefinitionID, CredentialID string
+	OutputStateID, OutputStateDigest, RecipeDigest             string
+	Status                                                     ModelStatus
+	TranscriptJSON, TranscriptDigest, AuthorSelector, Digest   string
+	CreatedAt                                                  time.Time
+}
+
+func (ModelDownloadOriginal) TableName() string { return "model_download_originals" }
+
+// []byte preserves exact wire bytes in a canonical, credential-free envelope.
+type ModelOriginalDownloadTranscript struct {
+	Request, Response []byte
+	Failure           string
+}
+
+func ModelDownloadOriginalDigest(value ModelDownloadOriginal) (string, error) {
+	value.Digest = ""
+	value.CreatedAt = value.CreatedAt.UTC()
+	wire, err := json.Marshal(value)
+	return MemoryOriginalBytesDigest(wire), err
+}
