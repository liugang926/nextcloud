@@ -0,0 +1,139 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/models/embedding"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+type modelOriginalDownloadRead struct{ read *modelOriginalRead }
+
+func (r *modelOriginalDownloadRead) Context() context.Context { return r.read.Context() }
+func (r *modelOriginalDownloadRead) Snapshot() (*types.Model, *types.ModelOriginalProof, error) {
+	return r.read.Snapshot()
+}
+func (r *modelOriginalDownloadRead) Recheck() error { return r.read.Recheck() }
+func (r *modelOriginalDownloadRead) Close() error   { return r.read.Close() }
+func (r *modelRepository) BeginModelOriginalDownload(ctx context.Context, id string, expected types.ModelOriginalProof) (interfaces.ModelOriginalDownloadRead, error) {
+	if !expected.Valid() || expected.ModelID != id {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	// Creation and continued download require the live author's write permission,
+	// not merely permission to invoke a shared/builtin model.
+	authority := func(ctx context.Context, tx *gorm.DB, p types.ModelOriginalProof) (context.Context, error) {
+		return r.authorizeModelOriginal(ctx, tx, p.OwnerTenantID, p.IsBuiltin)
+	}
+	raw, err := beginModelOriginalReadMode(ctx, r.db, id, &expected, authority, true)
+	if err != nil {
+		return nil, err
+	}
+	actual, ok := raw.(*modelOriginalRead)
+	if !ok {
+		_ = raw.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err = embedding.ValidateOriginalDownloadDefinition(actual.model.Parameters.OriginalDownload); err != nil {
+		_ = raw.Close()
+		return nil, err
+	}
+	return &modelOriginalDownloadRead{actual}, nil
+}
+func modelDownloadFactDigest(value types.ModelDownloadOriginal) (string, error) {
+	return types.ModelDownloadOriginalDigest(value)
+}
+func (r *modelRepository) CommitModelOriginalDownload(read interfaces.ModelOriginalDownloadRead, status types.ModelStatus, transcript string) (*types.ModelDownloadOriginal, error) {
+	actual, ok := read.(*modelOriginalDownloadRead)
+	if !ok || !actual.read.download || status != types.ModelStatusActive && status != types.ModelStatusDownloadFailed || !json.Valid([]byte(transcript)) {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	held := actual.read
+	if err := embedding.ValidateOriginalDownloadTranscript(held.model.Parameters.OriginalDownload, transcript, status); err != nil {
+		return nil, err
+	}
+	pool, err := r.db.DB()
+	if err != nil {
+		return nil, err
+	}
+	heldPool, err := held.db.DB()
+	if err != nil || pool != heldPool {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err = held.startCheck(); err != nil {
+		return nil, err
+	}
+	var receipt *types.ModelDownloadOriginal
+	err = r.db.WithContext(held.ctx).Transaction(func(tx *gorm.DB) error {
+		// Both producer and read use tenant/actor -> model -> original-head/body.
+		// Check the creation proof before producing any status/result effect.
+		if err := held.checkInTx(tx); err != nil {
+			return err
+		}
+		tx = tx.Session(&gorm.Session{NewDB: true, Context: held.ctx})
+		if err := tx.Clauses(forUpdateClause()).Where("id=?", held.hold.Proof.ModelID).Take(&types.Model{}).Error; err != nil {
+			return err
+		}
+		model, err := cloneOriginalModel(held.model)
+		if err != nil {
+			return err
+		}
+		fresh, err := r.authorizeModelOriginal(held.ctx, tx, model.TenantID, model.IsBuiltin)
+		if err != nil {
+			return err
+		}
+		tx = tx.Session(&gorm.Session{NewDB: true, Context: fresh})
+		update := tx.Model(&types.Model{}).Where("id=? AND status=?", model.ID, types.ModelStatusDownloading).Updates(map[string]interface{}{"status": status, "updated_at": memoryFactTime()})
+		if update.Error != nil {
+			return update.Error
+		}
+		if update.RowsAffected != 1 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		control, err := modelControls(tx.Session(&gorm.Session{NewDB: true}), model.ID)
+		if err != nil {
+			return err
+		}
+		actor, err := captureKnowledgeActorSelector(fresh, "")
+		if err != nil {
+			return err
+		}
+		selector, err := json.Marshal(actor)
+		if err != nil {
+			return err
+		}
+		state := types.ModelStateOriginal{ID: uuid.NewString(), ModelID: model.ID, TenantID: model.TenantID, Epoch: control.StateEpoch, DefinitionID: held.hold.Proof.DefinitionID, CredentialID: held.hold.Proof.CredentialID, Status: status, IsDefault: model.IsDefault, ManagedBy: model.ManagedBy, AuthorSelector: string(selector), CreatedAt: memoryFactTime()}
+		state.Digest, err = modelStateFactDigest(state)
+		if err != nil {
+			return err
+		}
+		if err = tx.Session(&gorm.Session{NewDB: true}).Create(&state).Error; err != nil {
+			return err
+		}
+		out := &types.ModelDownloadOriginal{ID: uuid.NewString(), ModelID: model.ID, TenantID: model.TenantID, InputStateID: held.hold.Proof.StateID, InputProofDigest: held.hold.Proof.Digest, DefinitionID: held.hold.Proof.DefinitionID, CredentialID: held.hold.Proof.CredentialID, OutputStateID: state.ID, OutputStateDigest: state.Digest, RecipeDigest: model.Parameters.OriginalDownload.Digest, Status: status, TranscriptJSON: transcript, TranscriptDigest: bodySHA([]byte(transcript)), AuthorSelector: string(selector), CreatedAt: memoryFactTime()}
+		out.Digest, err = modelDownloadFactDigest(*out)
+		if err != nil {
+			return err
+		}
+		if err = tx.Session(&gorm.Session{NewDB: true}).Create(out).Error; err != nil {
+			return err
+		}
+		// Native body152 capture and all IO precede the final original hold clock.
+		if err = CheckOriginalBodyAvailableInTx(fresh, tx.Session(&gorm.Session{NewDB: true}), out.TableName(), out.ID); err != nil {
+			return err
+		}
+		if err = checkModelOriginalHoldsInTx(tx.Session(&gorm.Session{NewDB: true, Context: fresh}), held.hold.Proof); err != nil {
+			return err
+		}
+		receipt = out
+		return fresh.Err()
+	}, memoryWriteOptions(r.db))
+	if err = held.finishCheck(err); err != nil {
+		return nil, err
+	}
+	return receipt, nil
+}
+
