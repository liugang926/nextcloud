index 00000000..1da90e92
--- /dev/null
+++ b/internal/models/embedding/original_download.go
@@ -0,0 +1,129 @@
+package embedding
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"github.com/Tencent/WeKnora/internal/types"
+	ollamaapi "github.com/ollama/ollama/api"
+	"io"
+	"net/url"
+	"strings"
+)
+
+const OriginalOllamaDownloadRecipe = "model/ollama-pull/explicit-creation-v1"
+const OriginalOllamaPullWire = "ollama/api.PullRequest@v0.23.2/explicit-auth-v1"
+
+func NormalizeAuthoredDownloadDefinition(m *types.Model) error {
+	if m == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if m.Source != types.ModelSourceLocal {
+		if m.Parameters.OriginalDownload != nil {
+			return fmt.Errorf("remote models cannot author local downloads")
+		}
+		return nil
+	}
+	if m.Parameters.OriginalDownload == nil {
+		base := strings.TrimRight(strings.TrimSpace(m.Parameters.BaseURL), "/")
+		remote := m.Name
+		if v := m.Parameters.ExtraConfig["remote_model_name"]; v != "" {
+			remote = v
+		}
+		r := &types.ModelOriginalDownloadDefinition{Version: 1, Recipe: OriginalOllamaDownloadRecipe, WireRecipe: OriginalOllamaPullWire, BaseURL: base, URL: base + "/api/pull", RemoteModel: remote, Auth: "optional-bearer", Headers: map[string]string{}, Stream: true, RequestTimeoutSeconds: 600, WatchIntervalMillis: 100, MaxResponseBytes: 8 * 1024 * 1024, RetryMaxRetries: 0}
+		for k, v := range m.Parameters.CustomHeaders {
+			r.Headers[k] = v
+		}
+		var err error
+		r.Digest, err = types.ModelOriginalDownloadDigest(r)
+		if err != nil {
+			return err
+		}
+		m.Parameters.OriginalDownload = r
+	}
+	r := m.Parameters.OriginalDownload
+	if err := ValidateOriginalDownloadDefinition(r); err != nil {
+		return err
+	}
+	remote := m.Name
+	if v := m.Parameters.ExtraConfig["remote_model_name"]; v != "" {
+		remote = v
+	}
+	if r.BaseURL != strings.TrimRight(strings.TrimSpace(m.Parameters.BaseURL), "/") || r.RemoteModel != remote {
+		return fmt.Errorf("download fields differ from explicitly authored model")
+	}
+	headers, _ := json.Marshal(m.Parameters.CustomHeaders)
+	captured, _ := json.Marshal(r.Headers)
+	// nil and empty authored header collections have the same no-header effect.
+	if len(m.Parameters.CustomHeaders) != 0 && string(headers) != string(captured) || len(m.Parameters.CustomHeaders) == 0 && len(r.Headers) != 0 {
+		return fmt.Errorf("download headers differ from author input")
+	}
+	return nil
+}
+func ValidateOriginalDownloadDefinition(r *types.ModelOriginalDownloadDefinition) error {
+	if r == nil || r.Version != 1 || r.Recipe != OriginalOllamaDownloadRecipe || r.WireRecipe != OriginalOllamaPullWire || r.RemoteModel == "" || r.Headers == nil || !r.Stream || r.RequestTimeoutSeconds <= 0 || r.RequestTimeoutSeconds > 600 || r.WatchIntervalMillis <= 0 || r.WatchIntervalMillis > 1000 || r.MaxResponseBytes <= 0 || r.MaxResponseBytes > 8*1024*1024 || r.RetryMaxRetries != 0 || r.Auth != "optional-bearer" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	u, err := url.Parse(r.BaseURL)
+	if err != nil || u.Host == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || u.Scheme != "http" && u.Scheme != "https" || u.Hostname() == "ollama.com" || r.URL != strings.TrimRight(r.BaseURL, "/")+"/api/pull" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	digest, err := types.ModelOriginalDownloadDigest(r)
+	if err != nil || digest != r.Digest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+
+// The status publisher checks the exact request recipe and the complete reply.
+// A digest or caller-provided success label cannot replace these wire bytes.
+func ValidateOriginalDownloadTranscript(r *types.ModelOriginalDownloadDefinition, raw string, status types.ModelStatus) error {
+	if err := ValidateOriginalDownloadDefinition(r); err != nil {
+		return err
+	}
+	var t types.ModelOriginalDownloadTranscript
+	if json.Unmarshal([]byte(raw), &t) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	canonical, err := json.Marshal(t)
+	if err != nil || string(canonical) != raw {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	stream := r.Stream
+	expected, err := json.Marshal(ollamaapi.PullRequest{Model: r.RemoteModel, Stream: &stream})
+	if err != nil || !bytes.Equal(t.Request, expected) || len(t.Response) > r.MaxResponseBytes {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if status == types.ModelStatusDownloadFailed && t.Failure == "transport" {
+		return nil
+	}
+	success := false
+	valid := true
+	count := 0
+	decoder := json.NewDecoder(bytes.NewReader(t.Response))
+	for {
+		var wire struct {
+			ollamaapi.ProgressResponse
+			Error string `json:"error"`
+		}
+		err := decoder.Decode(&wire)
+		if err == io.EOF {
+			break
+		}
+		if err != nil || success || wire.Error != "" || wire.Status == "" || wire.Total < 0 || wire.Completed < 0 || wire.Total > 0 && wire.Completed > wire.Total {
+			valid = false
+			break
+		}
+		count++
+		if wire.Status == "success" {
+			success = true
+		}
+	}
+	if status == types.ModelStatusActive && t.Failure == "" && valid && success && count > 0 {
+		return nil
+	}
+	if status == types.ModelStatusDownloadFailed && t.Failure == "protocol" && (!valid || !success || count == 0) {
+		return nil
+	}
+	return types.ErrMemoryOriginalUnavailable
+}
diff --git a/internal/shutdown/cleanup.go b/internal/shutdown/cleanup.go
new file mode 100644
index 00000000..24b7b9c4
--- /dev/null
+++ b/internal/shutdown/cleanup.go
@@ -0,0 +1,86 @@
+package shutdown
+
+import (
+	"context"
+	"log"
+	"sync"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// ResourceCleaner is a resource cleaner that can be used to clean up resources
+type ResourceCleaner struct {
+	mu       sync.Mutex
+	cleanups []types.CleanupFunc
+}
+
+// NewResourceCleaner creates a new resource cleaner
+func NewResourceCleaner() interfaces.ResourceCleaner {
+	return &ResourceCleaner{
+		cleanups: make([]types.CleanupFunc, 0),
+	}
+}
+
+// Register registers a cleanup function
+// Note: the cleanup function will be executed in reverse order (the last registered will be executed first)
+func (c *ResourceCleaner) Register(cleanup types.CleanupFunc) {
+	if cleanup == nil {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.cleanups = append(c.cleanups, cleanup)
+}
+
+// RegisterWithName registers a cleanup function with a name, for logging tracking
+func (c *ResourceCleaner) RegisterWithName(name string, cleanup types.CleanupFunc) {
+	if cleanup == nil {
+		return
+	}
+
+	wrappedCleanup := func() error {
+		log.Printf("Cleaning up resource: %s", name)
+		err := cleanup()
+		if err != nil {
+			log.Printf("Error cleaning up resource %s: %v", name, err)
+		} else {
+			log.Printf("Successfully cleaned up resource: %s", name)
+		}
+		return err
+	}
+
+	c.Register(wrappedCleanup)
+}
+
+// Cleanup executes all cleanup functions
+// Even if a cleanup function fails, other cleanup functions will still be executed
+func (c *ResourceCleaner) Cleanup(ctx context.Context) (errs []error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	// Execute cleanup functions in reverse order (the last registered will be executed first)
+	for i := len(c.cleanups) - 1; i >= 0; i-- {
+		select {
+		case <-ctx.Done():
+			errs = append(errs, ctx.Err())
+			return errs
+		default:
+			if err := c.cleanups[i](); err != nil {
+				errs = append(errs, err)
+			}
+		}
+	}
+
+	return errs
+}
+
+// Reset clears all registered cleanup functions
+func (c *ResourceCleaner) Reset() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.cleanups = make([]types.CleanupFunc, 0)
+}
