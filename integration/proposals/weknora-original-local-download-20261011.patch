@@ -0,0 +1,21 @@
+package shutdown
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"time"
+)
+
+// HTTP drain and resource cleanup have separate cancellation ownership. An
+// expired drain cannot skip the mandatory cancel/join before dependent cleanup.
+// The caller passes its unchanged configured timeout for the fresh cleanup
+// phase. Mandatory owned joins still finish if that phase's context expires;
+// subsequent ordinary callbacks continue to obey ResourceCleaner's policy.
+func CleanupAfterHTTPDrain(drain context.Context, timeout time.Duration, models interfaces.ModelService, cleaner interfaces.ResourceCleaner) []error {
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(drain), timeout)
+	defer cancel()
+	if life, ok := models.(interfaces.ModelOriginalDownloadLifecycle); ok {
+		life.StopOriginalDownloads()
+	}
+	return cleaner.Cleanup(ctx)
+}
