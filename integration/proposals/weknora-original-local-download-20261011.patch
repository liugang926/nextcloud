@@ -0,0 +1,125 @@
+package main
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/shutdown"
+	"github.com/stretchr/testify/require"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestDesktopShutdownJoinsExpiredHTTPDrainCleanup(t *testing.T) {
+	app := NewApp()
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	handlerStarted, handlerRelease := make(chan struct{}), make(chan struct{})
+	var startOnce, handlerReleaseOnce sync.Once
+	cleanerEntered, cleanerRelease := make(chan struct{}), make(chan struct{})
+	var cleanerReleaseOnce sync.Once
+	var tasks sync.WaitGroup
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		startOnce.Do(func() { close(handlerStarted) })
+		select {
+		case <-r.Context().Done():
+		case <-handlerRelease:
+		}
+		w.WriteHeader(204)
+	}))
+	cleaner := shutdown.NewResourceCleaner()
+	cleaner.Register(func() error { close(cleanerEntered); <-cleanerRelease; return nil })
+	t.Cleanup(func() {
+		handlerReleaseOnce.Do(func() { close(handlerRelease) })
+		cleanerReleaseOnce.Do(func() { close(cleanerRelease) })
+		cancel()
+		_ = server.Config.Close()
+		tasks.Wait()
+		server.Close()
+	})
+	tasks.Add(1)
+	go func() {
+		defer tasks.Done()
+		request, err := http.NewRequestWithContext(ctx, http.MethodGet, server.URL, nil)
+		if err != nil {
+			return
+		}
+		response, _ := server.Client().Do(request)
+		if response != nil {
+			_ = response.Body.Close()
+		}
+	}()
+	select {
+	case <-handlerStarted:
+	case <-ctx.Done():
+		t.Fatal("actual desktop HTTP drain handler did not start")
+	}
+	backendResult := make(chan error, 1)
+	tasks.Add(1)
+	go func() {
+		defer tasks.Done()
+		<-app.shutdownCh
+		defer close(app.shutdownDone)
+		drain, cancelDrain := context.WithTimeout(context.Background(), 500*time.Millisecond)
+		defer cancelDrain()
+		err := server.Config.Shutdown(drain)
+		_ = server.Config.Close()
+		if err != context.DeadlineExceeded {
+			backendResult <- err
+			return
+		}
+		errs := shutdown.CleanupAfterHTTPDrain(drain, 500*time.Millisecond, nil, cleaner)
+		if len(errs) != 0 {
+			backendResult <- errs[0]
+			return
+		}
+		backendResult <- nil
+	}()
+	firstReturned, secondReturned, secondStarted := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	tasks.Add(2)
+	go func() { defer tasks.Done(); app.shutdown(context.Background()); close(firstReturned) }()
+	select {
+	case <-cleanerEntered:
+	case <-ctx.Done():
+		t.Fatal("expired drain skipped actual cleanup callback")
+	}
+	go func() {
+		defer tasks.Done()
+		close(secondStarted)
+		app.shutdown(context.Background())
+		close(secondReturned)
+	}()
+	select {
+	case <-secondStarted:
+	case <-ctx.Done():
+		t.Fatal("second shutdown caller did not start")
+	}
+	select {
+	case <-firstReturned:
+		t.Fatal("desktop quit returned before actual cleanup completed")
+	default:
+	}
+	select {
+	case <-secondReturned:
+		t.Fatal("repeated desktop shutdown returned before actual cleanup completed")
+	default:
+	}
+	cleanerReleaseOnce.Do(func() { close(cleanerRelease) })
+	select {
+	case <-firstReturned:
+	case <-ctx.Done():
+		t.Fatal("desktop shutdown did not join cleanup")
+	}
+	select {
+	case <-secondReturned:
+	case <-ctx.Done():
+		t.Fatal("repeated desktop shutdown did not join the same cleanup")
+	}
+	select {
+	case err := <-backendResult:
+		require.NoError(t, err)
+	case <-ctx.Done():
+		t.Fatal("backend cleanup did not finish")
+	}
+}
