diff --git a/internal/application/service/model_original_download.go b/internal/application/service/model_original_download.go
new file mode 100644
index 00000000..8e219c92
--- /dev/null
+++ b/internal/application/service/model_original_download.go
@@ -0,0 +1,259 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/models/api"
+	"github.com/Tencent/WeKnora/internal/models/embedding"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/Tencent/WeKnora/internal/utils"
+	ollamaapi "github.com/ollama/ollama/api"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+)
+
+type originalModelDownloadJob struct {
+	cancel context.CancelFunc
+	done   chan struct{}
+	err    error
+}
+type originalModelDownloads struct {
+	mu               sync.Mutex
+	enabled, stopped bool
+	jobs             map[string]*originalModelDownloadJob
+	active           sync.WaitGroup
+}
+
+func (s *modelService) StartOriginalDownloads() {
+	s.downloads.mu.Lock()
+	defer s.downloads.mu.Unlock()
+	if !s.downloads.stopped {
+		s.downloads.enabled = true
+	}
+}
+func (s *modelService) StopOriginalDownloads() {
+	s.downloads.mu.Lock()
+	s.downloads.stopped = true
+	for _, j := range s.downloads.jobs {
+		j.cancel()
+	}
+	s.downloads.mu.Unlock()
+	s.downloads.active.Wait()
+}
+func (s *modelService) WaitOriginalDownload(ctx context.Context, id string) error {
+	s.downloads.mu.Lock()
+	j := s.downloads.jobs[id]
+	s.downloads.mu.Unlock()
+	if j == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-j.done:
+		return j.err
+	}
+}
+func (s *modelService) checkOriginalDownloadsAccepting() error {
+	s.downloads.mu.Lock()
+	defer s.downloads.mu.Unlock()
+	if s.downloads.stopped {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+func (s *modelService) queueOriginalModelDownload(ctx context.Context, model *types.Model) error {
+	s.downloads.mu.Lock()
+	defer s.downloads.mu.Unlock()
+	if s.downloads.stopped {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if !s.downloads.enabled {
+		return nil
+	}
+	if model.OriginalProof == nil || !model.OriginalProof.Valid() {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if _, ok := s.repo.(interfaces.ModelOriginalDownloader); !ok {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if s.downloads.jobs == nil {
+		s.downloads.jobs = map[string]*originalModelDownloadJob{}
+	}
+	if _, exists := s.downloads.jobs[model.ID]; exists {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	// The HTTP create owns the already committed creation authorization. Request
+	// completion does not cancel its explicitly requested background operation;
+	// process Stop and the captured finite download recipe own cancellation.
+	intentCtx, cancel := context.WithCancel(logprivacy.SuppressContent(context.WithoutCancel(ctx)))
+	proof := *model.OriginalProof
+	job := &originalModelDownloadJob{cancel: cancel, done: make(chan struct{})}
+	s.downloads.jobs[model.ID] = job
+	s.downloads.active.Add(1)
+	go func() {
+		defer s.downloads.active.Done()
+		defer close(job.done)
+		defer cancel()
+		job.err = s.runOriginalModelDownload(intentCtx, proof)
+	}()
+	return nil
+}
+func (s *modelService) runOriginalModelDownload(ctx context.Context, proof types.ModelOriginalProof) (resultErr error) {
+	repo, ok := s.repo.(interfaces.ModelOriginalDownloader)
+	if !ok {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	read, err := repo.BeginModelOriginalDownload(ctx, proof.ModelID, proof)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		if e := read.Close(); e != nil && resultErr == nil {
+			resultErr = e
+		}
+	}()
+	model, actual, err := read.Snapshot()
+	if err != nil {
+		return err
+	}
+	if actual == nil || *actual != proof || model == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	r := model.Parameters.OriginalDownload
+	if err = embedding.ValidateOriginalDownloadDefinition(r); err != nil {
+		return err
+	}
+	call, cancel := context.WithTimeout(read.Context(), time.Duration(r.RequestTimeoutSeconds)*time.Second)
+	defer cancel()
+	stream := r.Stream
+	request := ollamaapi.PullRequest{Model: r.RemoteModel, Stream: &stream}
+	headers := map[string]string{}
+	for k, v := range r.Headers {
+		headers[k] = v
+	}
+	auth := api.NoAuth()
+	if model.Parameters.APIKey != "" {
+		auth = api.BearerAuth(model.Parameters.APIKey)
+	}
+	// No Client.do/process endpoint/signing environment, heartbeat, tags or
+	// implicit ensure/pull. This one /api/pull is the creation request itself.
+	transport := &http.Transport{DialContext: utils.SSRFSafeDialContext, TLSHandshakeTimeout: 10 * time.Second, IdleConnTimeout: 90 * time.Second, MaxIdleConnsPerHost: 1}
+	defer transport.CloseIdleConnections()
+	client := utils.NewSSRFSafeHTTPClientWithTransport(utils.SSRFSafeHTTPClientConfig{Timeout: 0, MaxRedirects: 0}, transport)
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return utils.ErrSSRFRedirectBlocked }
+	endpoint := api.Endpoint{BaseURL: r.BaseURL, URL: r.URL, Model: r.RemoteModel, ModelID: model.ID, Headers: headers, Auth: auth, Client: client}
+	req, requestBytes, err := endpoint.NewRequest(call, r.URL, &request, false)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Accept", "application/x-ndjson")
+	if err = read.Recheck(); err != nil {
+		return err
+	}
+	stopWatch := make(chan struct{})
+	watchJoined := make(chan struct{})
+	var watchErr error
+	go func() {
+		defer close(watchJoined)
+		ticker := time.NewTicker(time.Duration(r.WatchIntervalMillis) * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-stopWatch:
+				return
+			case <-call.Done():
+				return
+			case <-ticker.C:
+				if e := read.Recheck(); e != nil {
+					watchErr = e
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	var responseBytes []byte
+	var providerErr error
+	response, err := endpoint.Do(req)
+	if err != nil {
+		providerErr = err
+	} else {
+		responseBytes, providerErr = io.ReadAll(io.LimitReader(response.Body, int64(r.MaxResponseBytes)+1))
+		closeErr := response.Body.Close()
+		if providerErr == nil {
+			providerErr = closeErr
+		}
+		if len(responseBytes) > r.MaxResponseBytes {
+			providerErr = types.ErrMemoryOriginalUnavailable
+			responseBytes = nil
+		}
+	}
+	close(stopWatch)
+	<-watchJoined
+	if watchErr != nil {
+		return watchErr
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	status := types.ModelStatusDownloadFailed
+	failure := "transport"
+	if providerErr == nil {
+		decoder := json.NewDecoder(bytes.NewReader(responseBytes))
+		success := false
+		count := 0
+		for {
+			var wire struct {
+				ollamaapi.ProgressResponse
+				Error string `json:"error"`
+			}
+			e := decoder.Decode(&wire)
+			if errors.Is(e, io.EOF) {
+				break
+			}
+			if e != nil || success || wire.Error != "" || wire.Status == "" || wire.Total < 0 || wire.Completed < 0 || wire.Total > 0 && wire.Completed > wire.Total {
+				providerErr = types.ErrMemoryOriginalUnavailable
+				break
+			}
+			count++
+			if wire.Status == "success" {
+				success = true
+			}
+		}
+		if providerErr == nil && success && count > 0 {
+			status = types.ModelStatusActive
+			failure = ""
+		} else {
+			failure = "protocol"
+		}
+	}
+	// A short deadline/stop or authority failure cannot publish success, or
+	// manufacture an authorized failure transition after cancellation.
+	if err = read.Recheck(); err != nil {
+		return err
+	}
+	transcript, err := json.Marshal(types.ModelOriginalDownloadTranscript{Request: requestBytes, Response: responseBytes, Failure: failure})
+	if err != nil {
+		return err
+	}
+	_, err = repo.CommitModelOriginalDownload(read, status, string(transcript))
+	if err != nil {
+		return err
+	}
+	if status != types.ModelStatusActive {
+		if providerErr != nil {
+			return providerErr
+		}
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+
+var _ interfaces.ModelOriginalDownloadLifecycle = (*modelService)(nil)
diff --git a/internal/application/service/model_original_download_host_shutdown_actual_test.go b/internal/application/service/model_original_download_host_shutdown_actual_test.go
