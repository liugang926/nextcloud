+)
+
+type actualModelLastIOKey struct{}
+type actualModelLastIO struct {
+	armed            atomic.Bool
+	direct           atomic.Int64
+	reached, applied atomic.Bool
+	mu               sync.Mutex
+	err              error
+	lease            struct {
+		LeaseID, BodyID, OwnerID, Kind string
+		Epoch, ExpiresAtMS             int64
+		ReleasedAtMS                   *int64
+	}
+	payload struct {
+		ID, State, BodySHA256 string
+		PurgeEpoch, BodyBytes int64
+	}
+	expiry, observedClock int64
+}
+
+// This context token selects a test-owned real operation. It carries no
+// actor, proof, model, body or lease authorization and is unknown to production.
+func modelLastIOObserverMatches(tx *gorm.DB, token *actualModelLastIO, lane string) bool {
+	if tx.Statement.Table != "original_body_journal_heads" || tx.Statement.Context.Value(actualModelLastIOKey{}) != token || !token.armed.Load() {
+		return false
+	}
+	pcs := make([]uintptr, 64)
+	frames := runtime.CallersFrames(pcs[:runtime.Callers(2, pcs)])
+	directJournal, foundJournal, wanted, inCheck := false, false, false, false
+	for {
+		frame, more := frames.Next()
+		name := frame.Function
+		if foundJournal && !directJournal {
+			directJournal = strings.HasSuffix(name, ".checkModelOriginalHoldsInTx")
+			foundJournal = false
+		}
+		if strings.HasSuffix(name, ".(*OriginalBodyRetentionStore).checkJournalInTx") {
+			foundJournal = true
+		}
+		if lane == "current" && strings.HasSuffix(name, ".CheckCurrentModelOriginalHolds") {
+			wanted = true
+		}
+		if lane == "download" && strings.Contains(name, ".CommitModelOriginalDownload.func1") {
+			wanted = true
+		}
+		if strings.HasSuffix(name, ".(*modelOriginalRead).checkInTx") {
+			inCheck = true
+		}
+		if !more {
+			break
+		}
+	}
+	return directJournal && wanted && (lane != "download" || !inCheck)
+}
+func runModelOriginalFinalBindingClockActual(t *testing.T, pg bool) {
+	for _, lane := range []string{"current", "download"} {
+		for _, mode := range []string{"legal", "late_expiry", "lease_owner", "lease_epoch", "lease_release", "payload_state", "payload_epoch", "payload_sha", "payload_bytes"} {
+			t.Run(lane+"_"+mode, func(t *testing.T) {
+				f := newMemAtomicSQLFixture(t, pg)
+				_, models, _, reader := actualOriginalModelServices(t, f)
+				token := &actualModelLastIO{}
+				ctx, cancel := context.WithTimeout(context.WithValue(f.ctx, actualModelLastIOKey{}, token), 8*time.Second)
+				var read interfaces.ModelOriginalRead
+				var life interfaces.ModelOriginalDownloadLifecycle
+				var calls atomic.Int64
+				var server *httptest.Server
+				released := make(chan struct{})
+				var releaseOnce sync.Once
+				t.Cleanup(func() {
+					releaseOnce.Do(func() { close(released) })
+					cancel()
+					if life != nil {
+						life.StopOriginalDownloads()
+					}
+					if read != nil {
+						_ = read.Close()
+					}
+					if server != nil {
+						server.Close()
+					}
+				})
+				var proof types.ModelOriginalProof
+				id := f.model.GetModelID()
+				var ids []string
+				if lane == "current" {
+					var err error
+					read, err = reader.BeginModelOriginalRead(ctx, id, nil)
+					require.NoError(t, err)
+					_, actual, err := read.Snapshot()
+					require.NoError(t, err)
+					proof = *actual
+					ids, err = repository.ModelOriginalLeaseIDs(read.Context())
+					require.NoError(t, err)
+					require.Len(t, ids, 2)
+				} else {
+					var ok bool
+					life, ok = models.(interfaces.ModelOriginalDownloadLifecycle)
+					require.True(t, ok)
+					server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						if r.URL.Path != "/api/pull" {
+							w.WriteHeader(400)
+							return
+						}
+						calls.Add(1)
+						_, _ = io.Copy(io.Discard, r.Body)
+						select {
+						case <-released:
+						case <-r.Context().Done():
+							return
+						}
+						w.Header().Set("Content-Type", "application/x-ndjson")
+						_, _ = io.WriteString(w, "{\"status\":\"success\"}\n")
+					}))
+					utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+					t.Cleanup(utils.ResetSSRFWhitelistForTest)
+					life.StartOriginalDownloads()
+					id = "actual-late-binding-download"
+					model := &types.Model{ID: id, TenantID: 7, Name: "nomic-embed-text:actual-final-binding", Type: types.ModelTypeEmbedding, Source: types.ModelSourceLocal, Parameters: types.ModelParameters{BaseURL: server.URL, EmbeddingParameters: types.EmbeddingParameters{Dimension: 2}}}
+					require.NoError(t, models.CreateModel(ctx, model))
+					require.NotNil(t, model.OriginalProof)
+					proof = *model.OriginalProof
+				}
+				// The genuine current read reports its captured IDs. For download, the
+				// callback selects the real definition lease after acquisition, by the
+				// exact creation receipt; it never fabricates an execution/grant or lease.
+				name := "actual-model-final-journal-binding"
+				require.NoError(t, f.db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
+					if tx.Error != nil || !modelLastIOObserverMatches(tx, token, lane) || token.direct.Add(1) != 2 {
+						return
+					}
+					token.reached.Store(true)
+					clean := func() *gorm.DB {
+						return tx.Session(&gorm.Session{NewDB: true, Context: context.WithValue(tx.Statement.Context, actualModelLastIOKey{}, nil)})
+					}
+					var receipt types.ModelOriginalBodyReceipt
+					err := clean().Where("origin_id=?", proof.DefinitionID).Take(&receipt).Error
+					var candidates []struct {
+						LeaseID, BodyID, OwnerID, Kind string
+						Epoch, ExpiresAtMS             int64
+						ReleasedAtMS                   *int64
+					}
+					if err == nil {
+						query := clean().Table("original_body_leases").Where("body_id=? AND kind=? AND released_at_ms IS NULL", receipt.BodyID, "read")
+						if lane == "current" {
+							query = query.Where("lease_id IN ?", ids)
+						} else {
+							query = query.Where("owner_id LIKE ?", "model-original-read/%")
+						}
+						err = query.Find(&candidates).Error
+						if err == nil && len(candidates) != 1 {
+							err = fmt.Errorf("exact original definition has %d acquired target leases", len(candidates))
+						}
+					}
+					var boundPayload struct {
+						ID, State, BodySHA256 string
+						PurgeEpoch, BodyBytes int64
+					}
+					if err == nil {
+						err = clean().Table("original_body_payloads").Select("id,state,body_sha256,purge_epoch,body_bytes").Where("id=?", receipt.BodyID).Take(&boundPayload).Error
+					}
+					if err == nil {
+						bound := candidates[0]
+						token.lease = bound
+						token.payload = boundPayload
+						clock := func() (int64, error) {
+							var now int64
+							sql := "SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)"
+							if pg {
+								sql = "SELECT floor(extract(epoch FROM clock_timestamp())*1000)::bigint"
+							}
+							err := clean().Raw(sql).Scan(&now).Error
+							return now, err
+						}
+						if mode != "legal" {
+							table, column, value := "original_body_leases", "", interface{}(nil)
+							switch mode {
+							case "late_expiry":
+								var now int64
+								now, err = clock()
+								token.expiry = now + 25
+								column, value = "expires_at_ms", token.expiry
+							case "lease_owner":
+								column, value = "owner_id", bound.OwnerID+"/actual-owned-tx-fault"
+							case "lease_epoch":
+								column, value = "epoch", bound.Epoch+1
+							case "lease_release":
+								column, value = "released_at_ms", int64(1)
+							case "payload_state":
+								table, column, value = "original_body_payloads", "state", "purged"
+							case "payload_epoch":
+								table, column, value = "original_body_payloads", "purge_epoch", boundPayload.PurgeEpoch+1
+							case "payload_sha":
+								table, column, value = "original_body_payloads", "body_sha256", strings.Repeat("0", 64)
+							case "payload_bytes":
+								table, column, value = "original_body_payloads", "body_bytes", boundPayload.BodyBytes+1
+							}
+							if err == nil {
+								write := clean().Table(table)
+								if table == "original_body_leases" {
+									write = write.Where("lease_id=? AND body_id=? AND owner_id=? AND epoch=? AND kind=?", bound.LeaseID, bound.BodyID, bound.OwnerID, bound.Epoch, bound.Kind)
+								} else {
+									write = write.Where("id=? AND purge_epoch=? AND state=?", boundPayload.ID, boundPayload.PurgeEpoch, boundPayload.State)
+								}
+								result := write.Update(column, value)
+								err = result.Error
+								if err == nil && result.RowsAffected != 1 {
+									err = fmt.Errorf("late owned-TX fault changed %d rows", result.RowsAffected)
+								}
+							}
+							if err == nil {
+								var actual interface{}
+								if table == "original_body_leases" {
+									var back struct {
+										LeaseID, BodyID, OwnerID, Kind string
+										Epoch, ExpiresAtMS             int64
+										ReleasedAtMS                   *int64
+									}
+									err = clean().Table(table).Where("lease_id=?", bound.LeaseID).Take(&back).Error
+									switch mode {
+									case "late_expiry":
+										actual = back.ExpiresAtMS
+									case "lease_owner":
+										actual = back.OwnerID
+									case "lease_epoch":
+										actual = back.Epoch
+									case "lease_release":
+										if back.ReleasedAtMS != nil {
+											actual = *back.ReleasedAtMS
+										}
+									}
+								} else {
+									var back struct {
+										ID, State, BodySHA256 string
+										PurgeEpoch, BodyBytes int64
+									}
+									err = clean().Table(table).Where("id=?", boundPayload.ID).Take(&back).Error
+									switch mode {
+									case "payload_state":
+										actual = back.State
+									case "payload_epoch":
+										actual = back.PurgeEpoch
+									case "payload_sha":
+										actual = back.BodySHA256
+									case "payload_bytes":
+										actual = back.BodyBytes
+									}
+								}
+								if err == nil && actual != value {
+									err = fmt.Errorf("independent actual row readback did not match late %s mutation", column)
+								}
+							}
+							if err == nil && mode == "late_expiry" {
+								for {
+									if tx.Statement.Context.Err() != nil {
+										err = tx.Statement.Context.Err()
+										break
+									}
+									var now int64
+									now, err = clock()
+									if err != nil {
+										break
+									}
+									if now >= token.expiry {
+										token.observedClock = now
+										break
+									}
+								}
+							}
+							token.applied.Store(err == nil)
+						}
+					}
+					token.mu.Lock()
+					token.err = err
+					token.mu.Unlock()
+					// The observer records native SQL failures; it does not AddError to fake a
+					// product refusal. The actual shared helper must see the changed rows.
+				}))
+				t.Cleanup(func() { _ = f.db.Callback().Query().Remove(name) })
+				token.armed.Store(true)
+				var err error
+				if lane == "current" {
+					err = f.db.WithContext(read.Context()).Transaction(func(tx *gorm.DB) error { return repository.CheckCurrentModelOriginalHolds(read.Context(), tx, proof) })
+				} else {
+					releaseOnce.Do(func() { close(released) })
+					err = life.WaitOriginalDownload(ctx, id)
+				}
+				require.True(t, token.reached.Load(), "exact last direct journal IO was reached after both original bodies/leases were read")
+				token.mu.Lock()
+				faultErr := token.err
+				token.mu.Unlock()
+				require.NoError(t, faultErr)
+				if mode != "legal" {
+					require.True(t, token.applied.Load(), "same-TX mutation and independent row readback must succeed before the product error assertion")
+				}
+				if mode == "late_expiry" {
+					require.Positive(t, token.expiry)
+					require.GreaterOrEqual(t, token.observedClock, token.expiry)
+				}
+				if mode == "legal" {
+					require.NoError(t, err)
+				} else {
+					require.ErrorIs(t, err, repository.ErrOriginalBodyUnavailable)
+				}
+				if lane == "download" {
+					require.Equal(t, int64(1), calls.Load())
+					var count int64
+					require.NoError(t, f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Model(&types.ModelDownloadOriginal{}).Where("model_id=?", id).Count(&count).Error)
+					if mode == "legal" {
+						require.Equal(t, int64(1), count)
+					} else {
+						require.Zero(t, count)
+						var state types.Model
+						require.NoError(t, f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Where("id=?", id).Take(&state).Error)
+						require.Equal(t, types.ModelStatusDownloading, state.Status)
+					}
+				}
+				if read != nil {
+					require.NoError(t, read.Close())
+				}
+				if life != nil {
+					life.StopOriginalDownloads()
+				}
+				// Failed download result/state and the faulting metadata write roll back in
+				// the same real SQL TX; only the reader's subsequent lease release persists.
+				if mode != "legal" {
+					var payload struct {
+						ID, State, BodySHA256 string
+						PurgeEpoch, BodyBytes int64
+					}
+					require.NoError(t, f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Table("original_body_payloads").Select("id,state,body_sha256,purge_epoch,body_bytes").Where("id=?", token.payload.ID).Take(&payload).Error)
+					require.Equal(t, token.payload, payload)
+				}
+				if mode != "legal" {
+					var lease struct {
+						LeaseID, BodyID, OwnerID, Kind string
+						Epoch, ExpiresAtMS             int64
+						ReleasedAtMS                   *int64
+					}
+					require.NoError(t, f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Table("original_body_leases").Where("lease_id=?", token.lease.LeaseID).Take(&lease).Error)
+					require.Equal(t, token.lease.BodyID, lease.BodyID)
+					require.Equal(t, token.lease.OwnerID, lease.OwnerID)
+					require.Equal(t, token.lease.Kind, lease.Kind)
+					require.Equal(t, token.lease.Epoch, lease.Epoch)
+					require.Equal(t, token.lease.ExpiresAtMS, lease.ExpiresAtMS)
+					require.NotNil(t, lease.ReleasedAtMS, "the original owner actually releases its restored lease after the failed TX")
+				}
+				assertMemAtomicSQLLeasesClosed(t, f)
+			})
+		}
+	}
+}
+func TestSQLiteModelOriginalFinalBindingClockActual(t *testing.T) {
+	runModelOriginalFinalBindingClockActual(t, false)
+}
+func TestPostgresModelOriginalFinalBindingClockActual(t *testing.T) {
+	runModelOriginalFinalBindingClockActual(t, true)
+}
