new file mode 100644
index 000000000..741b68b5d
--- /dev/null
+++ b/internal/database/migration_original_pending_tail_source_test.go
@@ -0,0 +1,119 @@
+package database
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func originalPendingTailSourceFixture(t *testing.T, dialect string) (string, jointOriginalPendingTailDefinition) {
+	t.Helper()
+	_, file, _, ok := runtime.Caller(0)
+	require.True(t, ok)
+	realRoot := filepath.Clean(filepath.Join(filepath.Dir(file), "..", ".."))
+	root := t.TempDir()
+	var definition jointOriginalPendingTailDefinition
+	require.NoError(t, json.Unmarshal(jointOriginalPendingTailJSON, &definition))
+	copySource := func(name string) {
+		body, err := os.ReadFile(filepath.Join(realRoot, filepath.FromSlash(name)))
+		require.NoError(t, err)
+		to := filepath.Join(root, filepath.FromSlash(name))
+		require.NoError(t, os.MkdirAll(filepath.Dir(to), 0700))
+		require.NoError(t, os.WriteFile(to, body, 0600))
+	}
+	witness, err := jointLineageWitnessesFromSource()
+	require.NoError(t, err)
+	for _, module := range witness.Modules[dialect] {
+		copySource(module.Path)
+	}
+	var peer jointPeerForwardAssetManifest
+	require.NoError(t, json.Unmarshal(jointPeerForwardSourceAssetJSON, &peer))
+	for _, file := range peer.Routes[dialect].Files {
+		copySource(file.Path)
+	}
+	for _, module := range definition.Modules[dialect] {
+		copySource(module.UpPath)
+		copySource(module.DownPath)
+	}
+	copySource(definition.BodyDescriptorSource.Path)
+	return root, definition
+}
+
+// Actual source-file qualification and complete statement projection. These
+// fixtures create no SQL database, schema_migrations, fact, grant or lease.
+func TestJointOriginalPendingTailSourceAdmission(t *testing.T) {
+	for _, dialect := range []string{"sqlite", "versioned"} {
+		t.Run(dialect, func(t *testing.T) {
+			for _, mode := range []string{"complete_source_projection_route_closed", "up_fullbyte_changed", "guarded_down_changed", "extra_pending_file", "unknown_canonical_tail", "extra_peer_file", "actual_body_descriptor_source_changed", "symlink_up", "cancelled"} {
+				t.Run(mode, func(t *testing.T) {
+					root, definition := originalPendingTailSourceFixture(t, dialect)
+					module := definition.Modules[dialect][0]
+					appendFile := func(name string) {
+						path := filepath.Join(root, name)
+						body, err := os.ReadFile(path)
+						require.NoError(t, err)
+						require.NoError(t, os.WriteFile(path, append(body, []byte("\n-- changed full source bytes\n")...), 0600))
+					}
+					ctx, cancel := context.WithCancel(context.Background())
+					defer cancel()
+					switch mode {
+					case "up_fullbyte_changed":
+						appendFile(module.UpPath)
+					case "guarded_down_changed":
+						appendFile(module.DownPath)
+					case "extra_pending_file":
+						require.NoError(t, os.WriteFile(filepath.Join(root, filepath.Dir(module.UpPath), "000999_unknown.up.sql"), []byte("SELECT 1;"), 0600))
+					case "unknown_canonical_tail":
+						require.NoError(t, os.WriteFile(filepath.Join(root, "migrations", dialect, "000999_unknown.up.sql"), []byte("SELECT 1;"), 0600))
+					case "extra_peer_file":
+						require.NoError(t, os.WriteFile(filepath.Join(root, "migrations", "peer-forward", dialect, "000999_unknown.up.sql"), []byte("SELECT 1;"), 0600))
+					case "actual_body_descriptor_source_changed":
+						appendFile(definition.BodyDescriptorSource.Path)
+					case "symlink_up":
+						path := filepath.Join(root, module.UpPath)
+						body, err := os.ReadFile(path)
+						require.NoError(t, err)
+						real := filepath.Join(t.TempDir(), "same-source.up.sql")
+						require.NoError(t, os.WriteFile(real, body, 0600))
+						require.NoError(t, os.Remove(path))
+						require.NoError(t, os.Symlink(real, path))
+					case "cancelled":
+						cancel()
+					}
+					admission, err := admitJointOriginalPendingTailSources(ctx, root, dialect)
+					if mode != "complete_source_projection_route_closed" {
+						require.Error(t, err)
+						require.Nil(t, admission)
+						return
+					}
+					require.NoError(t, err)
+					require.NotNil(t, admission)
+					require.Len(t, admission.sourceDigest, 64)
+					for _, module := range definition.Modules[dialect] {
+						catalogue, err := admission.catalogue(module.Version)
+						require.NoError(t, err)
+						for name, fullDDL := range module.Catalogue.Tables {
+							require.Equal(t, fullDDL, catalogue.Tables[name])
+						}
+						for _, fullDDL := range module.Catalogue.Triggers {
+							tokens := jointSQLTokens(fullDDL)
+							require.GreaterOrEqual(t, len(tokens), 3)
+							require.Equal(t, fullDDL, catalogue.Triggers[tokens[2]])
+						}
+						require.Equal(t, definition.BodyDescriptors, catalogue.BodyDescriptors)
+					}
+					_, err = admission.catalogue(92)
+					require.ErrorIs(t, err, ErrJointSchemaUnknown)
+					route, err := admission.migrationRoute()
+					require.ErrorIs(t, err, ErrJointOriginalPendingTailRoute)
+					require.Equal(t, jointMigrationRoute{}, route)
+				})
+			}
+		})
+	}
+}
