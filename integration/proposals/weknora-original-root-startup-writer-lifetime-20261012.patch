+type originalRootActualProcess struct {
+	cmd     *exec.Cmd
+	release io.WriteCloser
+	tokens  <-chan string
+	waited  <-chan error
+	scanned <-chan error
+	joined  bool
+}
+
+func startOriginalRootActualProcess(t *testing.T, root, path, mode string) *originalRootActualProcess {
+	t.Helper()
+	cmd := exec.Command(os.Args[0], "-test.run=^TestOriginalRootWholeSQLiteProcessHelper$", "-test.count=1")
+	cmd.Dir = root
+	env := []string{}
+	for _, value := range os.Environ() {
+		if !strings.HasPrefix(value, "WEKNORA_ORIGINAL_ROOT_KERNEL_") {
+			env = append(env, value)
+		}
+	}
+	cmd.Env = append(env, "WEKNORA_ORIGINAL_ROOT_KERNEL_HELPER=1", "WEKNORA_ORIGINAL_ROOT_KERNEL_DB="+path, "WEKNORA_ORIGINAL_ROOT_KERNEL_MODE="+mode)
+	stdout, err := cmd.StdoutPipe()
+	require.NoError(t, err)
+	release, err := cmd.StdinPipe()
+	require.NoError(t, err)
+	require.NoError(t, cmd.Start())
+	tokens := make(chan string, 4)
+	waited := make(chan error, 1)
+	scanned := make(chan error, 1)
+	go func() {
+		scanner := bufio.NewScanner(stdout)
+		diagnosticBytes := 0
+		for scanner.Scan() {
+			line := scanner.Text()
+			if strings.HasPrefix(line, "ORIGINAL_ROOT_") {
+				tokens <- line
+			} else if len(line) <= 128 && originalRootActualChildDiagnosticLine(line) && len(line) <= 4096-diagnosticBytes {
+				diagnosticBytes += len(line)
+				t.Log(line)
+			}
+		}
+		scanned <- scanner.Err()
+		close(tokens)
+		waited <- cmd.Wait()
+	}()
+	p := &originalRootActualProcess{cmd: cmd, release: release, tokens: tokens, waited: waited, scanned: scanned}
+	t.Cleanup(func() {
+		_ = release.Close()
+		if !p.joined {
+			select {
+			case <-waited:
+				p.joined = true
+			case <-time.After(3 * time.Second):
+				_ = cmd.Process.Kill()
+				select {
+				case <-waited:
+					p.joined = true
+				case <-time.After(3 * time.Second):
+					t.Error("actual owned bootstrap process did not join")
+				}
+			}
+		}
+		select {
+		case err := <-scanned:
+			if err != nil {
+				t.Error("actual helper stdout did not finish cleanly")
+			}
+		case <-time.After(3 * time.Second):
+			t.Error("actual helper stdout scanner did not join")
+		}
+	})
+	return p
+}
+func originalRootActualToken(t *testing.T, p *originalRootActualProcess, want string) {
+	t.Helper()
+	select {
+	case got, ok := <-p.tokens:
+		require.True(t, ok)
+		require.Equal(t, want, got)
+	case <-time.After(3 * time.Second):
+		t.Fatal("actual bootstrap lifecycle token absent")
+	}
+}
+func joinOriginalRootActualProcess(t *testing.T, p *originalRootActualProcess) {
+	t.Helper()
+	select {
+	case err := <-p.waited:
+		p.joined = true
+		require.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("actual bootstrap process did not terminate")
+	}
+}
