+// Prefix preparation must address the same actual filename as the Root owner.
+// The legacy URL Open stringifies spaces before passing a bare filename to
+// sqlite3; the production URI pool decodes them while WithInstance binds that
+// exact pool. This local fixture still runs only the genuine historical SQL.
+func installOriginalRootActualSQLitePrefix(t *testing.T, source, path string, version uint) {
+	t.Helper()
+	db, _, err := openJointLineageDB("sqlite3://unused", MigrationOptions{SQLiteDBPath: path})
+	require.NoError(t, err)
+	driver, err := sqlite3migrate.WithInstance(db, &sqlite3migrate.Config{})
+	if err != nil {
+		_ = db.Close()
+		require.NoError(t, err)
+	}
+	m, err := migrate.NewWithDatabaseInstance("file://"+filepath.ToSlash(filepath.Join(source, "migrations", "sqlite")), "sqlite3", driver)
+	if err != nil {
+		_ = driver.Close()
+		require.NoError(t, err)
+	}
+	err = m.Migrate(version)
+	sourceErr, databaseErr := m.Close()
+	require.NoError(t, err)
+	require.NoError(t, sourceErr)
+	require.NoError(t, databaseErr)
+}
