+// Kernel-helper-only live observations use the existing fixed Root observer.
+// The callback does no IO/wait/SQL and can only offer bounded enum/bool records
+// to a nonblocking queue. A separate sink writes at most two records per phase.
+func originalRootActualChildDiagnosticContext(ctx context.Context) (context.Context, func()) {
+	if os.Getenv("WEKNORA_ORIGINAL_ROOT_KERNEL_HELPER") != "1" || os.Getenv(originalRootDiagnosticFlag) != "1" {
+		return ctx, func() {}
+	}
+	type record struct {
+		phase   originalRootDiagnosticPhase
+		success bool
+	}
+	events := make(chan record, 2*int(originalRootDiagnosticPhaseCount))
+	done := make(chan struct{})
+	var mu sync.Mutex
+	var seen [originalRootDiagnosticPhaseCount]uint8
+	sealed := false
+	go func() {
+		defer close(done)
+		for value := range events {
+			fmt.Printf("original_root_child_phase phase=%d success=%t\n", value.phase, value.success)
+		}
+	}()
+	observer := &originalRootDiagnosticObserver{observe: func(phase originalRootDiagnosticPhase, success bool) {
+		if phase >= originalRootDiagnosticPhaseCount {
+			return
+		}
+		mask := uint8(1)
+		if success {
+			mask = 2
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		if sealed || seen[phase]&mask != 0 {
+			return
+		}
+		seen[phase] |= mask
+		select {
+		case events <- record{phase: phase, success: success}:
+		default:
+		}
+	}}
+	marked := context.WithValue(ctx, originalRootDiagnosticObserverKey{}, observer)
+	marked = WithJointSchemaCataloguePhaseObserver(marked, func(value JointSchemaCataloguePhaseObservation) {
+		phase, tailPhase, tail, known := originalRootExactDiagnosticPhaseForTest(value)
+		if known {
+			observeOriginalRootDiagnostic(marked, phase, !value.Failed)
+			if tail {
+				observeOriginalRootDiagnostic(marked, tailPhase, !value.Failed)
+			}
+		}
+	})
+	return marked, func() {
+		mu.Lock()
+		sealed = true
+		close(events)
+		mu.Unlock()
+		<-done
+	}
+}
+
+func originalRootActualChildErrorClass(err error) string {
+	switch {
+	case errors.Is(err, context.DeadlineExceeded):
+		return "deadline"
+	case errors.Is(err, context.Canceled):
+		return "cancelled"
+	case errors.Is(err, ErrJointSchemaUnknown):
+		return "schema_unknown"
+	case errors.Is(err, ErrJointSchemaSourceIdentity):
+		return "source_identity"
+	case errors.Is(err, ErrJointSchemaUnavailable):
+		return "schema_unavailable"
+	case errors.Is(err, ErrJointSchemaAmbiguousDirty):
+		return "schema_dirty"
+	case errors.Is(err, ErrOriginalRootSchemaNotReady):
+		return "root_not_ready"
+	case errors.Is(err, ErrOriginalRootPeerTail):
+		return "peer_tail"
+	default:
+		return "other"
+	}
+}
+
+// Only exact fixed diagnostic grammar is relayed. General child stdout,
+// stderr, paths, SQL, stack frames and provider error messages are discarded.
+func originalRootActualChildDiagnosticLine(line string) bool {
+	var phase uint
+	var success bool
+	if _, err := fmt.Sscanf(line, "original_root_child_phase phase=%d success=%t", &phase, &success); err == nil {
+		return phase < uint(originalRootDiagnosticPhaseCount) && line == fmt.Sprintf("original_root_child_phase phase=%d success=%t", phase, success)
+	}
+	var step, class string
+	if _, err := fmt.Sscanf(line, "original_root_child_failure step=%s class=%s", &step, &class); err != nil ||
+		(step != "run" && step != "ready") || line != fmt.Sprintf("original_root_child_failure step=%s class=%s", step, class) {
+		return false
+	}
+	switch class {
+	case "deadline", "cancelled", "schema_unknown", "source_identity", "schema_unavailable", "schema_dirty", "root_not_ready", "peer_tail", "other":
+		return true
+	}
+	return false
+}
diff --git a/internal/database/migration_original_root_sqlite_canonical.go b/internal/database/migration_original_root_sqlite_canonical.go
new file mode 100644
index 000000000..8dc941067
--- /dev/null
+++ b/internal/database/migration_original_root_sqlite_canonical.go
@@ -0,0 +1,197 @@
+package database
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/golang-migrate/migrate/v4"
+	migratedatabase "github.com/golang-migrate/migrate/v4/database"
+	sqlite3migrate "github.com/golang-migrate/migrate/v4/database/sqlite3"
+)
+
+type originalRootCanonicalDriver struct {
+	migratedatabase.Driver
+	ctx             context.Context
+	use             *originalRootSQLiteUse
+	source          *jointOriginalRootSource
+	dsn             string
+	options         MigrationOptions
+	version, target int
+	locked, ran     bool
+}
+
+func (d *originalRootCanonicalDriver) current(expected int, dirty bool) error {
+	version, actualDirty, err := d.Driver.Version()
+	if err != nil || version != expected || actualDirty != dirty {
+		return ErrJointSchemaUnknown
+	}
+	return d.source.recheck(d.ctx)
+}
+func (d *originalRootCanonicalDriver) Lock() error {
+	return d.use.write(d.ctx, "canonical_before_lock", func() error {
+		if err := d.Driver.Lock(); err != nil {
+			return err
+		}
+		fail := func(err error) error { return errors.Join(err, d.Driver.Unlock()) }
+		if err := d.current(d.version, false); err != nil {
+			return fail(err)
+		}
+		version, known := uint(0), d.version >= 0
+		if known {
+			version = uint(d.version)
+		}
+		route, err := selectJointMigrationRoute(d.ctx, d.dsn, d.options, version, false, known)
+		if err != nil {
+			return fail(err)
+		}
+		if route.lineage != jointCanonicalRootSource {
+			return fail(ErrOriginalRootPeerTail)
+		}
+		d.locked = true
+		return nil
+	})
+}
+func (d *originalRootCanonicalDriver) Unlock() error { d.locked = false; return d.Driver.Unlock() }
+func (d *originalRootCanonicalDriver) SetVersion(version int, dirty bool) error {
+	return d.use.write(d.ctx, "canonical_before_set_version", func() error {
+		if !d.locked {
+			return ErrJointSchemaUnknown
+		}
+		if dirty {
+			if version < 0 || version <= d.version || uint(version) > d.source.spec.OriginVersion || d.target != -1 {
+				return ErrOriginalRootTailDowngrade
+			}
+			if err := d.current(d.version, false); err != nil {
+				return err
+			}
+			if d.upSHA(version) == "" {
+				return ErrJointSchemaSourceIdentity
+			}
+			if err := d.Driver.SetVersion(version, true); err != nil {
+				return err
+			}
+			d.target, d.ran = version, false
+			return nil
+		}
+		if version != d.target || !d.ran {
+			return ErrJointSchemaUnknown
+		}
+		if err := d.current(d.target, true); err != nil {
+			return err
+		}
+		if err := d.Driver.SetVersion(version, false); err != nil {
+			return err
+		}
+		d.version, d.target, d.ran = version, -1, false
+		return nil
+	})
+}
+func (d *originalRootCanonicalDriver) upSHA(version int) string {
+	matches, wanted := 0, ""
+	for _, file := range d.source.spec.CanonicalFiles {
+		if !strings.HasSuffix(file.Path, ".up.sql") {
+			continue
+		}
+		n, err := strconv.Atoi(strings.SplitN(filepath.Base(file.Path), "_", 2)[0])
+		if err == nil && n == version {
+			matches++
+			wanted = file.SHA256
+		}
+	}
+	if matches != 1 {
+		return ""
+	}
+	return wanted
+}
+func (d *originalRootCanonicalDriver) Run(reader io.Reader) error {
+	return d.use.write(d.ctx, "canonical_before_run", func() error {
+		if !d.locked || d.target < 0 || d.ran {
+			return ErrJointSchemaUnknown
+		}
+		if err := d.current(d.target, true); err != nil {
+			return err
+		}
+		raw, err := io.ReadAll(io.LimitReader(reader, (1<<20)+1))
+		if err != nil || len(raw) > 1<<20 {
+			return ErrJointSchemaSourceIdentity
+		}
+		if wanted := d.upSHA(d.target); wanted == "" || fmt.Sprintf("%x", sha256.Sum256(raw)) != wanted {
+			return ErrJointSchemaSourceIdentity
+		}
+		if err = d.Driver.Run(bytes.NewReader(raw)); err != nil {
+			return err
+		}
+		d.ran = true
+		return nil
+	})
+}
+func runOriginalRootSQLiteCanonical(ctx context.Context, dsn string, opts MigrationOptions, source *jointOriginalRootSource, version uint, known bool) (runErr error) {
+	use, err := originalRootSQLiteUseFromContext(ctx)
+	if err != nil {
+		return err
+	}
+	pool, err := originalRootSQLiteWriterPool(ctx, use)
+	if err != nil {
+		return err
+	}
+	// This native initializer itself executes ensureVersionTable CREATE.
+	// Hold the exact same owner/write gate around it, not just around later Up.
+	var native migratedatabase.Driver
+	err = use.write(ctx, "canonical_before_initialization", func() error {
+		if err := source.recheck(ctx); err != nil {
+			return err
+		}
+		var err error
+		native, err = sqlite3migrate.WithInstance(pool, &sqlite3migrate.Config{})
+		return err
+	})
+	if err != nil {
+		return errors.Join(err, pool.Close())
+	}
+	captured := -1
+	if known {
+		captured = int(version)
+	}
+	guarded := &originalRootCanonicalDriver{Driver: native, ctx: ctx, use: use, source: source, dsn: dsn, options: opts, version: captured, target: -1}
+	m, err := migrate.NewWithDatabaseInstance("file://"+filepath.ToSlash(filepath.Join(source.root, "migrations", "sqlite")), "sqlite3", guarded)
+	if err != nil {
+		return errors.Join(err, guarded.Close())
+	}
+	defer func() {
+		actual, dirty, versionErr := m.Version()
+		se, de := m.Close()
+		runErr = errors.Join(runErr, se, de)
+		failure := ""
+		if runErr != nil {
+			failure = ErrOriginalRootSchemaNotReady.Error()
+		}
+		setMigrationState(actual, dirty, failure, versionErr == nil)
+	}()
+	// Preserve the old genuine42 decommission refusal before43 is made dirty.
+	if known && version == 42 {
+		var existing int
+		if err = pool.QueryRowContext(ctx, "SELECT EXISTS(SELECT 1 FROM nextcloud_source_decommissions)").Scan(&existing); err != nil {
+			return ErrJointSchemaUnavailable
+		}
+		if existing != 0 {
+			return ErrJointSchemaUnknown
+		}
+	}
+	if err = m.Up(); err != nil && err != migrate.ErrNoChange {
+		return err
+	}
+	final, dirty, err := m.Version()
+	if err != nil || dirty || final != source.spec.OriginVersion {
+		return ErrJointSchemaUnknown
+	}
+	return use.write(ctx, "canonical_before_final_catalogue", func() error {
+		return preflightJointSchemaLineage(ctx, dsn, opts, final, false, true)
+	})
+}
diff --git a/internal/database/migration_original_root_sqlite_create_unix.go b/internal/database/migration_original_root_sqlite_create_unix.go
new file mode 100644
index 000000000..dde83c585
--- /dev/null
+++ b/internal/database/migration_original_root_sqlite_create_unix.go
@@ -0,0 +1,23 @@
+//go:build linux || darwin
+
+package database
+
+import (
+	"errors"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// O_EXCL never truncates/replaces an existing main file; O_NOFOLLOW refuses a
+// late symlink. Return every successful FD to the registry without closing it.
+func originalRootSQLiteCreateRetainedDescriptor(path string) (*peerSQLiteRetainedDescriptor, error) {
+	fd, err := unix.Open(path, unix.O_RDWR|unix.O_CREAT|unix.O_EXCL|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0600)
+	if err != nil {
+		if errors.Is(err, unix.EEXIST) {
+			return nil, os.ErrExist
+		}
+		return nil, ErrJointSchemaUnavailable
+	}
+	return &peerSQLiteRetainedDescriptor{file: os.NewFile(uintptr(fd), path), rawFD: uintptr(fd)}, nil
+}
