+-- Independent SQLite90 payload shared by future canonical87 and peer89 routes.
+-- This file is not yet attached to either startup route or its source witness.
+CREATE TABLE IF NOT EXISTS lite_embeddings (
+ id INTEGER PRIMARY KEY AUTOINCREMENT, created_at DATETIME, updated_at DATETIME,
+ source_id TEXT NOT NULL, source_type INTEGER NOT NULL, chunk_id TEXT,
+ knowledge_id TEXT, knowledge_base_id TEXT, tag_id TEXT, content TEXT NOT NULL,
+ dimension INTEGER NOT NULL, is_enabled NUMERIC DEFAULT true
+);
+CREATE UNIQUE INDEX IF NOT EXISTS idx_sqlite_emb_source ON lite_embeddings(source_id,source_type);
+CREATE TABLE knowledge_sqlite_embedding_inputs (
+ id TEXT PRIMARY KEY NOT NULL, tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL, knowledge_id TEXT NOT NULL, chunk_id TEXT NOT NULL,
+ admission_id TEXT NOT NULL REFERENCES knowledge_input_admissions(admission_id),
+ model_id TEXT NOT NULL, model_proof_json TEXT NOT NULL, space_digest TEXT NOT NULL CHECK(length(space_digest)=64),
+ expected_dimensions INTEGER NOT NULL CHECK(expected_dimensions BETWEEN 1 AND 65536),
+ input_json TEXT NOT NULL, input_sha256 TEXT NOT NULL CHECK(length(input_sha256)=64),
+ digest TEXT NOT NULL UNIQUE CHECK(length(digest)=64), created_at_ms INTEGER NOT NULL
+);
+CREATE TABLE knowledge_sqlite_embedding_controls (
+ row_id INTEGER PRIMARY KEY NOT NULL, revision INTEGER NOT NULL CHECK(revision>0), present INTEGER NOT NULL CHECK(present IN(0,1))
+);
+CREATE TABLE knowledge_sqlite_embedding_vectors (
+ row_id INTEGER PRIMARY KEY NOT NULL REFERENCES lite_embeddings(id) ON DELETE CASCADE,
+ dimension INTEGER NOT NULL CHECK(dimension BETWEEN 1 AND 65536),
+ vector BLOB NOT NULL CHECK(length(vector)=dimension*4)
+);
+CREATE TABLE knowledge_sqlite_embedding_receipts (
+ id TEXT PRIMARY KEY NOT NULL, tenant_id INTEGER NOT NULL CHECK(tenant_id>0),
+ knowledge_base_id TEXT NOT NULL, knowledge_id TEXT NOT NULL, chunk_id TEXT NOT NULL,
+ input_id TEXT NOT NULL UNIQUE REFERENCES knowledge_sqlite_embedding_inputs(id),
+ input_digest TEXT NOT NULL CHECK(length(input_digest)=64), row_id INTEGER NOT NULL UNIQUE,
+ revision INTEGER NOT NULL CHECK(revision>0), dimension INTEGER NOT NULL CHECK(dimension BETWEEN 1 AND 65536),
+ vector_json TEXT NOT NULL, vector_sha256 TEXT NOT NULL CHECK(length(vector_sha256)=64),
+ digest TEXT NOT NULL UNIQUE CHECK(length(digest)=64), created_at_ms INTEGER NOT NULL
+);
+-- Existing metadata is UNKNOWN: controls record presence/observed revision, but
+-- no vector blob, input original or SDK output receipt is invented for it.
+INSERT INTO knowledge_sqlite_embedding_controls(row_id,revision,present) SELECT id,1,0 FROM lite_embeddings;
+CREATE TRIGGER knowledge_lite_embedding_insert AFTER INSERT ON lite_embeddings BEGIN
+ INSERT INTO knowledge_sqlite_embedding_controls(row_id,revision,present) VALUES(NEW.id,1,0);
+END;
+CREATE TRIGGER knowledge_lite_embedding_update AFTER UPDATE ON lite_embeddings BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1 WHERE row_id=NEW.id;
+END;
+CREATE TRIGGER knowledge_lite_embedding_delete AFTER DELETE ON lite_embeddings BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1,present=0 WHERE row_id=OLD.id;
+END;
+CREATE TRIGGER knowledge_sqlite_vector_insert AFTER INSERT ON knowledge_sqlite_embedding_vectors BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1,present=1 WHERE row_id=NEW.row_id;
+END;
+CREATE TRIGGER knowledge_sqlite_vector_update AFTER UPDATE ON knowledge_sqlite_embedding_vectors BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1 WHERE row_id=NEW.row_id;
+END;
+CREATE TRIGGER knowledge_sqlite_vector_delete AFTER DELETE ON knowledge_sqlite_embedding_vectors BEGIN
+ UPDATE knowledge_sqlite_embedding_controls SET revision=revision+1,present=0 WHERE row_id=OLD.row_id;
+END;
+CREATE TRIGGER knowledge_sqlite_embedding_input_guard BEFORE UPDATE ON knowledge_sqlite_embedding_inputs BEGIN
+ SELECT RAISE(ABORT,'knowledge_sqlite_embedding_input_immutable');
+END;
+CREATE TRIGGER knowledge_sqlite_embedding_input_delete_guard BEFORE DELETE ON knowledge_sqlite_embedding_inputs BEGIN
+ SELECT RAISE(ABORT,'knowledge_sqlite_embedding_input_immutable');
+END;
+CREATE TRIGGER knowledge_sqlite_embedding_receipt_guard BEFORE UPDATE ON knowledge_sqlite_embedding_receipts BEGIN
+ SELECT RAISE(ABORT,'knowledge_sqlite_embedding_receipt_immutable');
+END;
+CREATE TRIGGER knowledge_sqlite_embedding_receipt_delete_guard BEFORE DELETE ON knowledge_sqlite_embedding_receipts BEGIN
+ SELECT RAISE(ABORT,'knowledge_sqlite_embedding_receipt_immutable');
+END;
