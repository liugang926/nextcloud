+// Only real schema/ledger metadata is hashed, never original body/credentials.
+func originalRootWriterMetadata(path string) (string, error) {
+	db, _, err := openJointLineageDB("sqlite3://unused", MigrationOptions{SQLiteDBPath: path, jointReadOnly: true})
+	if err != nil {
+		return "", err
+	}
+	defer db.Close()
+	rows, err := db.Query("SELECT name,type,COALESCE(sql,'') FROM sqlite_master ORDER BY name,type")
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.New()
+	ledger := false
+	for rows.Next() {
+		var name, kind, sqlText string
+		if rows.Scan(&name, &kind, &sqlText) != nil {
+			rows.Close()
+			return "", ErrJointSchemaUnavailable
+		}
+		if name == "schema_migrations" && kind == "table" {
+			ledger = true
+		}
+		digest.Write([]byte(name + "\x00" + kind + "\x00" + sqlText + "\x00"))
+	}
+	if err = errors.Join(rows.Err(), rows.Close()); err != nil {
+		return "", err
+	}
+	if ledger {
+		rows, err = db.Query("SELECT version,dirty FROM schema_migrations ORDER BY version,dirty")
+		if err != nil {
+			return "", err
+		}
+		for rows.Next() {
+			var v int
+			var dirty bool
+			if rows.Scan(&v, &dirty) != nil {
+				rows.Close()
+				return "", ErrJointSchemaUnavailable
+			}
+			digest.Write([]byte(fmtOriginalRootWriterLedger(v, dirty)))
+		}
+		if err = errors.Join(rows.Err(), rows.Close()); err != nil {
+			return "", err
+		}
+	}
+	return hex.EncodeToString(digest.Sum(nil)), nil
+}
+func fmtOriginalRootWriterLedger(version int, dirty bool) string {
+	return fmt.Sprintf("%d/%t\x00", version, dirty)
+}
+func TestOriginalRootSQLiteMutationOwnerFaultsActual(t *testing.T) {
+	root := sqliteRepoRoot(t)
+	chdirAndRestore(t, root)
+	for _, phase := range []string{"canonical_before_initialization", "canonical_before_set_version", "canonical_before_run", "tail_before_initialization"} {
+		t.Run(phase, func(t *testing.T) {
+			for _, fault := range []string{"borrowed_owner_close_joins", "actual_path_replacement"} {
+				t.Run(fault, func(t *testing.T) {
+					path := filepath.Join(t.TempDir(), "actual writer lifetime.sqlite")
+					if phase == "tail_before_initialization" {
+						installOriginalRootActualSQLitePrefix(t, root, path, 87)
+					}
+					held, owned, err := acquireOriginalRootSQLiteBootstrap(context.Background(), "sqlite3://unused", MigrationOptions{SQLiteDBPath: path})
+					require.NoError(t, err)
+					require.True(t, owned)
+					closed := make(chan error, 1)
+					closeRequested := false
+					t.Cleanup(func() {
+						if closeRequested {
+							select {
+							case err := <-closed:
+								if err != nil {
+									t.Error("real owner Close failed")
+								}
+							case <-time.After(3 * time.Second):
+								t.Error("real owner Close did not join driver release")
+							}
+						} else {
+							if held.Close() != nil {
+								t.Error("real owner cleanup failed")
+							}
+						}
+					})
+					applied := false
+					before := ""
+					retained := path
+					var observerErr error
+					observe := func(actualPhase string) {
+						if applied || actualPhase != phase {
+							return
+						}
+						applied = true
+						before, observerErr = originalRootWriterMetadata(path)
+						if observerErr != nil {
+							return
+						}
+						if fault == "actual_path_replacement" {
+							retained = path + ".retained"
+							if observerErr = os.Rename(path, retained); observerErr != nil {
+								return
+							}
+							observerErr = os.WriteFile(path, nil, 0600)
+							return
+						}
+						closeRequested = true
+						go func() { closed <- held.Close() }()
+						deadline := time.NewTimer(3 * time.Second)
+						defer deadline.Stop()
+						for {
+							held.lifeMu.Lock()
+							closing := held.closing
+							held.lifeMu.Unlock()
+							if closing {
+								break
+							}
+							tick := time.NewTimer(time.Millisecond)
+							select {
+							case <-deadline.C:
+								tick.Stop()
+								observerErr = ErrJointSchemaUnavailable
+								return
+							case <-tick.C:
+							}
+						}
+						// Close really started, but cannot finish until this actual borrower
+						// closes its driver and releases its use after this callback returns.
+						select {
+						case <-closed:
+							observerErr = ErrJointSchemaUnavailable
+						default:
+						}
+					}
+					ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+					defer cancel()
+					ctx = context.WithValue(ctx, jointPeerSQLiteMigrationContextKey{}, held)
+					ctx = context.WithValue(ctx, originalRootMutationProbeKey{}, observe)
+					err = RunOriginalKnowledgeMigrations(ctx, "sqlite3://unused", MigrationOptions{SQLiteDBPath: path})
+					require.True(t, applied, "real chosen mutation boundary must be reached")
+					require.NoError(t, observerErr)
+					require.Error(t, err, "invalidated owner/path must refuse before the observed next actual native write")
+					after, err := originalRootWriterMetadata(retained)
+					require.NoError(t, err)
+					require.Equal(t, before, after, "schema and real ledger remain exactly the boundary snapshot; no effect after invalidation")
+					if fault == "actual_path_replacement" {
+						originalRootActualNoLedger(t, path)
+					}
+				})
+			}
+		})
+	}
+}
