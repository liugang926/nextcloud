diff --git a/internal/database/migration_original_root_sql_actual_test.go b/internal/database/migration_original_root_sql_actual_test.go
new file mode 100644
index 000000000..24cdcaf96
--- /dev/null
+++ b/internal/database/migration_original_root_sql_actual_test.go
@@ -0,0 +1,211 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/golang-migrate/migrate/v4"
+	"github.com/lib/pq"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/postgres"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+func originalRootActualInstallWrappers(t *testing.T, db *sql.DB, pg bool) {
+	t.Helper()
+	var dialector gorm.Dialector = sqlite.New(sqlite.Config{Conn: db})
+	if pg {
+		require.IsType(t, &pq.Driver{}, db.Driver())
+		dialector = postgres.New(postgres.Config{DriverName: "postgres", Conn: db})
+	}
+	actual, err := gorm.Open(dialector, &gorm.Config{Logger: gormlogger.Discard, DisableAutomaticPing: true})
+	require.NoError(t, err)
+	require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(actual), "only the true production42-descriptor installer creates wrappers")
+}
+func originalRootActualPeerTail(t *testing.T, root, dialect, dsn string, opts MigrationOptions, final uint, appendPending bool) {
+	t.Helper()
+	directory := peerPrefixCopiedAssets(t, root, dialect)
+	m := peerPrefixActualDriver(t, directory, dialect, dsn, opts)
+	require.NoError(t, m.Migrate(final), "authentic historical/forward SQL, no ledger rewrite")
+	se, de := m.Close()
+	require.NoError(t, se)
+	require.NoError(t, de)
+	if !appendPending {
+		return
+	}
+	var manifest jointOriginalRootSourceManifest
+	// The actual payload is shared data schema, never shared migration origin.
+	require.NoError(t, json.Unmarshal(jointOriginalRootSourceJSON, &manifest))
+	for _, file := range manifest.Routes[dialect].Files {
+		if file.Version == manifest.Routes[dialect].OriginVersion {
+			continue
+		}
+		raw, err := os.ReadFile(filepath.Join(root, file.OriginalPath))
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(filepath.Join(directory, "migrations", "peer-forward", dialect, filepath.Base(file.Path)), raw, 0600))
+	}
+	m = peerPrefixActualDriver(t, directory, dialect, dsn, opts)
+	require.NoError(t, m.Up(), "real peer-origin shared payload executes with an honest physical ledger")
+	se, de = m.Close()
+	require.NoError(t, se)
+	require.NoError(t, de)
+}
+func runOriginalRootTailActual(t *testing.T, pg bool) {
+	for _, mode := range []string{"fresh_actual_root_to_tail", "real_root_memory_prefix_upgrade", "nonempty_root_restart", "issued_42_body_wrappers_restart", "peer_final_refused", "peer_same_number_tail_refused", "dirty_tail_no_force", "missing_checkpoint_refused", "changed_checkpoint_refused", "changed_source_before_driver", "down_refused_before_ledger"} {
+		t.Run(mode, func(t *testing.T) {
+			root := sqliteRepoRoot(t)
+			dialect, origin, final, peerFinal := "sqlite", uint(87), uint(93), uint(89)
+			if pg {
+				dialect, origin, final, peerFinal = "versioned", 168, 172, 171
+			}
+			db, dsn, opts := jointLineageFixture(t, pg)
+			chdirAndRestore(t, root)
+			ctx := context.Background()
+			ctx = originalRootDiagnosticContextForTest(t, ctx)
+			if mode == "peer_final_refused" || mode == "peer_same_number_tail_refused" {
