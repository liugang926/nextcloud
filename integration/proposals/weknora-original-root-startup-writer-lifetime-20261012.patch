diff --git a/internal/database/migration_joint_verified_bigint_in.go b/internal/database/migration_joint_verified_bigint_in.go
new file mode 100644
index 000000000..f8eb90ead
--- /dev/null
+++ b/internal/database/migration_joint_verified_bigint_in.go
@@ -0,0 +1,170 @@
+package database
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var jointUnsignedIntegerLiteral = regexp.MustCompile(`^[0-9]+$`)
+var jointBigintINDollarQuote = regexp.MustCompile(`^\$(?:[a-zA-Z_][a-zA-Z_0-9]*)?\$`)
+
+// PostgreSQL turns BIGINT-column IN integer constants into a BIGINT array;
+// its deparser may parenthesize each atomic operand before its ::bigint cast.
+// Only actual columns already matched to their trusted full declarations may
+// use this equivalence. Column/function/arithmetic/narrowing casts remain exact.
+func jointCanonicalConstraintWithVerifiedBigintIN(text, namespace string, safeTextColumns, verifiedBigintColumns map[string]bool) string {
+	original := jointCanonicalConstraint(text, namespace, safeTextColumns)
+	tokens := jointSQLTokens(text)
+	if len(tokens) < 2 || tokens[0] != "check" {
+		return original
+	}
+	// jointSQLTokens intentionally normalizes identifier quotation for the
+	// old verifier. This new equivalence must retain the lexical distinction
+	// between native ANY/ARRAY/bigint and user-defined quoted identifiers.
+	// The old expression tree also loses quoted ANY for bare ARRAY literals,
+	// so falling back to it here would still overmatch. Quoted CHECK syntax
+	// retains exact lexical identity outside the native equivalence domain.
+	if jointBigintINHasIdentifierQuote(text) {
+		return "quoted-check-identity:" + strings.TrimSpace(text)
+	}
+	expression := jointTrimParens(tokens[1:])
+	if len(expression) < 9 || !jointIdentifier.MatchString(expression[0]) || !verifiedBigintColumns[expression[0]] ||
+		expression[1] != "=" || expression[2] != "any" || expression[3] != "(" || expression[4] != "array" || expression[5] != "[" ||
+		expression[len(expression)-2] != "]" || expression[len(expression)-1] != ")" {
+		return original
+	}
+	items := expression[6 : len(expression)-2]
+	values := []string{}
+	start, depth := 0, 0
+	for i := 0; i <= len(items); i++ {
+		if i < len(items) {
+			switch items[i] {
+			case "(":
+				depth++
+			case ")":
+				depth--
+				if depth < 0 {
+					return original
+				}
+			}
+			if items[i] != "," || depth != 0 {
+				continue
+			}
+		} else if depth != 0 {
+			return original
+		}
+		value, ok := jointVerifiedBigintArrayLiteral(items[start:i])
+		if !ok {
+			return original
+		}
+		values = append(values, value)
+		start = i + 1
+	}
+	if len(values) < 2 {
+		return original
+	}
+	return jointCanonicalConstraint("CHECK ("+expression[0]+" IN ("+strings.Join(values, ",")+"))", namespace, safeTextColumns)
+}
+
+func jointVerifiedBigintArrayLiteral(tokens []string) (string, bool) {
+	tokens = jointTrimParens(tokens)
+	literal := ""
+	if len(tokens) == 1 {
+		literal = tokens[0]
+	} else if len(tokens) >= 3 && tokens[len(tokens)-2] == "::" && tokens[len(tokens)-1] == "bigint" {
+		operand := jointTrimParens(tokens[:len(tokens)-2])
+		if len(operand) != 1 {
+			return "", false
+		}
+		literal = operand[0]
+		if len(literal) >= 2 && literal[0] == '\'' && literal[len(literal)-1] == '\'' {
+			literal = literal[1 : len(literal)-1]
+		}
+	} else {
+		return "", false
+	}
+	if !jointUnsignedIntegerLiteral.MatchString(literal) {
+		return "", false
+	}
+	value, err := strconv.ParseInt(literal, 10, 64)
+	if err != nil {
+		return "", false
+	}
+	return strconv.FormatInt(value, 10), true
+}
+
+// Track quote provenance outside SQL literal/comment regions. Rejecting every
+// quoted identifier is conservative; quotes inside a string are data and must
+// not be confused with identifier syntax. This does not rewrite SQL tokens.
+func jointBigintINHasIdentifierQuote(text string) bool {
+	for i := 0; i < len(text); {
+		switch {
+		case text[i] == '"':
+			return true
+		case text[i] == '\'':
+			escapes := i > 0 && (text[i-1] == 'e' || text[i-1] == 'E') &&
+				(i < 2 || !jointBigintINIdentifierByte(text[i-2]))
+			i++
+			closed := false
+			for i < len(text) {
+				if escapes && text[i] == '\\' {
+					i += 2
+					continue
+				}
+				if text[i] == '\'' {
+					if i+1 < len(text) && text[i+1] == '\'' {
+						i += 2
+						continue
+					}
+					i++
+					closed = true
+					break
+				}
+				i++
+			}
+			if !closed {
+				return true
+			}
+		case i+1 < len(text) && text[i:i+2] == "--":
+			for i < len(text) && text[i] != '\n' {
+				i++
+			}
+		case i+1 < len(text) && text[i:i+2] == "/*":
+			depth := 1
+			i += 2
+			for i+1 < len(text) && depth > 0 {
+				if text[i:i+2] == "/*" {
+					depth++
+					i += 2
+				} else if text[i:i+2] == "*/" {
+					depth--
+					i += 2
+				} else {
+					i++
+				}
+			}
+			if depth != 0 {
+				return true
+			}
+		case text[i] == '$':
+			delimiter := jointBigintINDollarQuote.FindString(text[i:])
+			if delimiter == "" {
+				i++
+				continue
+			}
+			end := strings.Index(text[i+len(delimiter):], delimiter)
+			if end < 0 {
+				return true
+			}
+			i += len(delimiter)*2 + end
+		default:
+			i++
+		}
+	}
+	return false
+}
+
+func jointBigintINIdentifierByte(value byte) bool {
+	return value >= 'a' && value <= 'z' || value >= 'A' && value <= 'Z' || value >= '0' && value <= '9' || value == '_' || value == '$'
+}
