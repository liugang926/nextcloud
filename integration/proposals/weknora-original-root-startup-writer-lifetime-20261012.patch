+// A real child owns or attempts the actual main-file OFD exclusion. Tokens
+// describe real lifecycle transitions; no actor/material/Ready fact is minted.
+func TestOriginalRootWholeSQLiteProcessHelper(t *testing.T) {
+	if os.Getenv("WEKNORA_ORIGINAL_ROOT_KERNEL_HELPER") != "1" {
+		return
+	}
+	path := os.Getenv("WEKNORA_ORIGINAL_ROOT_KERNEL_DB")
+	if path == "" {
+		t.Fatal("actual main filename missing")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	opts := MigrationOptions{SQLiteDBPath: path, AutoRecoverDirty: false}
+	mode := os.Getenv("WEKNORA_ORIGINAL_ROOT_KERNEL_MODE")
+	if mode == "hold" {
+		held, owned, err := acquireOriginalRootSQLiteBootstrap(ctx, "sqlite3://unused", opts)
+		if err != nil || !owned {
+			t.Fatal("actual bootstrap owner unavailable")
+		}
+		defer func() {
+			if held.Close() != nil {
+				t.Error("actual bootstrap owner release failed")
+			}
+		}()
+		fmt.Println("ORIGINAL_ROOT_OFD_HELD")
+		done := make(chan error, 1)
+		go func() { var b [1]byte; _, err := os.Stdin.Read(b[:]); done <- err }()
+		select {
+		case err := <-done:
+			if err != nil && !errors.Is(err, io.EOF) {
+				t.Error("actual release input failed")
+			}
+		case <-ctx.Done():
+			t.Error("actual release did not arrive")
+		}
+		return
+	}
+	if mode != "probe_and_run" {
+		t.Fatal("unknown actual helper mode")
+	}
+	ctx, finishDiagnostic := originalRootActualChildDiagnosticContext(ctx)
+	defer finishDiagnostic()
+	probe, stop := context.WithTimeout(ctx, 60*time.Millisecond)
+	_, _, err := acquireOriginalRootSQLiteBootstrap(probe, "sqlite3://unused", opts)
+	stop()
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatal("actual parent OFD exclusion did not block bootstrap")
+	}
+	fmt.Println("ORIGINAL_ROOT_BOOTSTRAP_BLOCKED")
+	if err := RunOriginalKnowledgeMigrations(ctx, "sqlite3://unused", opts); err != nil {
+		fmt.Printf("original_root_child_failure step=run class=%s\n", originalRootActualChildErrorClass(err))
+		t.Fatal("actual complete Root bootstrap/tail failed")
+	}
+	if err := VerifyOriginalKnowledgeSchemaReady(ctx, "sqlite3://unused", opts); err != nil {
+		fmt.Printf("original_root_child_failure step=ready class=%s\n", originalRootActualChildErrorClass(err))
+		t.Fatal("actual complete Root readiness failed")
+	}
+	fmt.Println("ORIGINAL_ROOT_READY")
+}
