index 000000000..bc666d8c9
--- /dev/null
+++ b/internal/database/migration_original_pending_tail_source.go
@@ -0,0 +1,270 @@
+package database
+
+import (
+	"context"
+	"crypto/sha256"
+	_ "embed"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"strings"
+)
+
+// Admission below qualifies source files, never a database or application.
+// Existing canonical and peer migrations remain unchanged. A shared physical
+// tail needs an independently reviewed route/restart contract before use.
+var ErrJointOriginalPendingTailRoute = errors.New("joint_original_pending_tail_route_unwired")
+
+//go:embed migration_original_pending_tail_specs.json
+var jointOriginalPendingTailJSON []byte
+
+type jointOriginalPendingTailModule struct {
+	Version                                uint
+	UpPath, DownPath, UpSHA256, DownSHA256 string
+	Statements                             []string
+	Catalogue                              jointCatalogueModule
+	Effects                                []string
+}
+type jointOriginalPendingTailDefinition struct {
+	Format, Activation, PG169 string
+	RouteConverged            bool
+	Modules                   map[string][]jointOriginalPendingTailModule
+	BodyDescriptors           map[string]jointBodyDescriptor
+	BodyDescriptorSource      struct{ Path, SHA256 string }
+}
+type jointOriginalPendingTailSourceAdmission struct {
+	dialect, sourceDigest string
+	modules               []jointOriginalPendingTailModule
+	descriptors           map[string]jointBodyDescriptor
+}
+
+func originalPendingTailFile(root, name, want string) ([]byte, error) {
+	if name == "" || filepath.IsAbs(name) || filepath.ToSlash(filepath.Clean(name)) != name || strings.HasPrefix(name, "../") || len(want) != 64 {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	path := filepath.Join(root, filepath.FromSlash(name))
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 1<<20 {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	body, err := os.ReadFile(path)
+	if err != nil || fmt.Sprintf("%x", sha256.Sum256(body)) != want {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	return body, nil
+}
+
+// This is a concrete source qualification entry, also exercised by the source
+// fixture. It checks the old nine canonical modules and the full honest peer
+// assets as dependencies, then the complete immutable UP and guarded DOWN.
+func admitJointOriginalPendingTailSources(ctx context.Context, root, dialect string) (*jointOriginalPendingTailSourceAdmission, error) {
+	if ctx == nil || !filepath.IsAbs(root) || (dialect != "sqlite" && dialect != "versioned") {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	var definition jointOriginalPendingTailDefinition
+	if json.Unmarshal(jointOriginalPendingTailJSON, &definition) != nil || definition.Format != "joint-original-pending-tail-source-v1" || definition.Activation != "unwired_pending_sources_only" || definition.RouteConverged || definition.PG169 != "reserved_pending_not_executed_or_implied" {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	versions := []uint{90, 91, 93}
+	if dialect == "versioned" {
+		versions = []uint{172}
+	}
+	modules := definition.Modules[dialect]
+	if len(modules) != len(versions) || len(definition.BodyDescriptors) != 7 || definition.BodyDescriptorSource.Path != "internal/application/repository/original_body_fields.go" {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	witness, err := jointLineageWitnessesFromSource()
+	if err != nil {
+		return nil, err
+	}
+	known := map[string]bool{}
+	for _, module := range witness.Modules[dialect] {
+		if _, err = originalPendingTailFile(root, module.Path, module.SHA256); err != nil {
+			return nil, err
+		}
+		known[filepath.Base(module.Path)] = true
+	}
+	entries, err := os.ReadDir(filepath.Join(root, "migrations", dialect))
+	if err != nil {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".up.sql") {
+			continue
+		}
+		var version uint
+		if _, err = fmt.Sscanf(entry.Name(), "%d_", &version); err != nil {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		if version >= jointLineageFirstVersion(dialect) && !known[entry.Name()] {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+	}
+	if _, err = verifyJointPeerForwardSourceAssets(root, dialect); err != nil {
+		return nil, err
+	}
+	bodySource, err := originalPendingTailFile(root, definition.BodyDescriptorSource.Path, definition.BodyDescriptorSource.SHA256)
+	if err != nil {
+		return nil, err
+	}
+	if err = verifyJointOriginalPendingBodyDescriptors(bodySource, definition.BodyDescriptors); err != nil {
+		return nil, err
+	}
+	for i, module := range modules {
+		if module.Version != versions[i] || !strings.HasPrefix(module.UpPath, "migrations/pending/") || module.DownPath != strings.TrimSuffix(module.UpPath, ".up.sql")+".down.sql" || module.Catalogue.Version != module.Version || module.Catalogue.Path != module.UpPath || module.Catalogue.SHA256 != module.UpSHA256 {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		up, e := originalPendingTailFile(root, module.UpPath, module.UpSHA256)
+		if e != nil {
+			return nil, e
+		}
+		if _, e = originalPendingTailFile(root, module.DownPath, module.DownSHA256); e != nil {
+			return nil, e
+		}
+		names, e := os.ReadDir(filepath.Join(root, filepath.Dir(module.UpPath)))
+		if e != nil || len(names) != 2 {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		for _, name := range names {
+			if name.IsDir() || name.Name() != filepath.Base(module.UpPath) && name.Name() != filepath.Base(module.DownPath) {
+				return nil, ErrJointSchemaSourceIdentity
+			}
+		}
+		statements, e := jointOriginalPendingTailStatements(string(up))
+		if e != nil || !reflect.DeepEqual(statements, module.Statements) {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		projected, effects, e := projectJointOriginalPendingTailModule(module, statements)
+		if e != nil || !reflect.DeepEqual(projected, module.Catalogue) || !reflect.DeepEqual(effects, module.Effects) {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	// Repeat source checks before publishing this source-only observation.
+	if _, err = verifyJointPeerForwardSourceAssets(root, dialect); err != nil {
+		return nil, err
+	}
+	for _, module := range modules {
+		if _, err = originalPendingTailFile(root, module.UpPath, module.UpSHA256); err != nil {
+			return nil, err
+		}
+		if _, err = originalPendingTailFile(root, module.DownPath, module.DownSHA256); err != nil {
+			return nil, err
+		}
+	}
+	return &jointOriginalPendingTailSourceAdmission{dialect, fmt.Sprintf("%x", sha256.Sum256(jointOriginalPendingTailJSON)), modules, definition.BodyDescriptors}, nil
+}
+
+func verifyJointOriginalPendingBodyDescriptors(source []byte, expected map[string]jointBodyDescriptor) error {
+	pattern := regexp.MustCompile(`(?m)^\s*\{"([a-z_0-9]+)",\s*"([a-z_0-9]+)",\s*"([a-z_0-9]+)",\s*\[\]string\{([^}]+)\}\},?\s*$`)
+	columns := regexp.MustCompile(`"([a-z_0-9]+)"`)
+	actual := map[string]jointBodyDescriptor{}
+	for _, match := range pattern.FindAllStringSubmatch(string(source), -1) {
+		if _, wanted := expected[match[1]]; !wanted {
+			continue
+		}
+		if match[3] != "inline" {
+			return ErrJointSchemaSourceIdentity
+		}
+		if _, duplicate := actual[match[1]]; duplicate {
+			return ErrJointSchemaSourceIdentity
+		}
+		descriptor := jointBodyDescriptor{Key: match[2], Columns: []string{}}
+		for _, column := range columns.FindAllStringSubmatch(match[4], -1) {
+			descriptor.Columns = append(descriptor.Columns, column[1])
+		}
+		actual[match[1]] = descriptor
+	}
+	if !reflect.DeepEqual(actual, expected) {
+		return ErrJointSchemaSourceIdentity
+	}
+	return nil
+}
+
+func projectJointOriginalPendingTailModule(module jointOriginalPendingTailModule, statements []string) (jointCatalogueModule, []string, error) {
+	out := jointCatalogueModule{Version: module.Version, Path: module.UpPath, SHA256: module.UpSHA256, Tables: map[string]string{}, Triggers: []string{}, Functions: []string{}, Indexes: []string{}, Alters: []string{}}
+	effects := []string{}
+	seen := map[string]bool{}
+	for _, statement := range statements {
+		tokens := jointSQLTokens(statement)
+		if len(tokens) < 3 {
+			return out, nil, ErrJointSchemaSourceIdentity
+		}
+		if tokens[0] == "insert" {
+			effects = append(effects, statement)
+			continue
+		}
+		if tokens[0] != "create" {
+			return out, nil, ErrJointSchemaSourceIdentity
+		}
+		position := 1
+		if tokens[position] == "unique" {
+			position++
+		}
+		kind := tokens[position]
+		position++
+		if position+2 < len(tokens) && tokens[position] == "if" && tokens[position+1] == "not" && tokens[position+2] == "exists" {
+			position += 3
+		}
+		if position >= len(tokens) || !jointIdentifier.MatchString(tokens[position]) {
+			return out, nil, ErrJointSchemaSourceIdentity
+		}
+		name := tokens[position]
+		if seen[kind+":"+name] {
+			return out, nil, ErrJointSchemaSourceIdentity
+		}
+		seen[kind+":"+name] = true
+		switch kind {
+		case "table":
+			out.Tables[name] = statement
+		case "trigger":
+			out.Triggers = append(out.Triggers, statement)
+		case "function":
+			out.Functions = append(out.Functions, statement)
+		case "index":
+			out.Indexes = append(out.Indexes, statement)
+		default:
+			return out, nil, ErrJointSchemaSourceIdentity
+		}
+	}
+	return out, effects, nil
+}
+
+// A fixture and future route implementation can inspect the exact complete
+// catalogue projection. This is not a live DB check, original or read grant.
+func (a *jointOriginalPendingTailSourceAdmission) catalogue(version uint) (jointCatalogueExpected, error) {
+	if a == nil {
+		return jointCatalogueExpected{}, ErrJointSchemaSourceIdentity
+	}
+	expected := jointCatalogueExpected{Tables: map[string]string{}, Triggers: map[string]string{}, Functions: map[string]string{}, Columns: map[string]map[string]string{}, Indexes: map[string]string{}, BodyDescriptors: a.descriptors}
+	known := false
+	for _, module := range a.modules {
+		if module.Version == version {
+			known = true
+		}
+		if module.Version <= version {
+			if err := applyJointPeerForwardModule(expected, module.Catalogue); err != nil {
+				return expected, err
+			}
+		}
+	}
+	if !known {
+		return expected, ErrJointSchemaUnknown
+	}
+	return expected, nil
+}
+
+// In particular, canonical87/168 and peer89/171 may not be relabelled93/172.
+// No caller can obtain an actionable route from the prepared source projection.
+func (a *jointOriginalPendingTailSourceAdmission) migrationRoute() (jointMigrationRoute, error) {
+	return jointMigrationRoute{}, ErrJointOriginalPendingTailRoute
+}
