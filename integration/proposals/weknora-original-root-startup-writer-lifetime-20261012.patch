@@ -0,0 +1,164 @@
+package database
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+func TestJointVerifiedBigintINKeepsNarrowingFunctionsAndChangedValues(t *testing.T) {
+	wanted := jointCanonicalConstraint("CHECK (present IN (0,1))", "")
+	verified := map[string]bool{"present": true}
+	for _, actual := range []string{
+		"CHECK ((present = ANY (ARRAY[(0+0)::bigint,(1)::bigint])))",
+		"CHECK ((present = ANY (ARRAY[((present))::bigint,(1)::bigint])))",
+		"CHECK ((present = ANY (ARRAY[func(0)::bigint,(1)::bigint])))",
+		"CHECK ((present = ANY (ARRAY[((0)::integer)::bigint,(1)::bigint])))",
+		"CHECK ((present = ANY (ARRAY[(0)::bigint,(2)::bigint])))",
+		"CHECK ((present = ANY (ARRAY[(0)::bigint,(9223372036854775808)::bigint])))",
+		"CHECK ((present::integer = ANY (ARRAY['0'::bigint,'1'::bigint])))",
+		"CHECK ((abs(present) = ANY (ARRAY['0'::bigint,'1'::bigint])))",
+		"CHECK ((present+1 = ANY (ARRAY['0'::bigint,'1'::bigint])))",
+		"CHECK ((present = ANY (ARRAY['0'::integer,'1'::integer])))",
+		"CHECK ((present = ANY (ARRAY['0'::bigint,'2'::bigint])))",
+		"CHECK ((present = ANY (ARRAY['0'::bigint,abs('1'::bigint)])))",
+		"CHECK ((present = ANY (ARRAY['0'::bigint,'9223372036854775808'::bigint])))",
+		"CHECK ((present = ANY (ARRAY['0.0'::bigint,'1'::bigint])))",
+		"CHECK ((present = ANY (ARRAY['0'::bigint,'1'::bigint]::integer[])))",
+		"CHECK ((present <> ANY (ARRAY['0'::bigint,'1'::bigint])))",
+		"CHECK ((other = ANY (ARRAY['0'::bigint,'1'::bigint])))",
+		"CHECK ((1 = ANY (ARRAY['0'::bigint,'1'::bigint])))",
+		`CHECK ((present = "any"(ARRAY['0'::bigint,'1'::bigint])))`,
+		`CHECK ((present = "any"(ARRAY[0,1])))`,
+		`CHECK ((present = ANY("array"['0'::bigint,'1'::bigint])))`,
+		`CHECK ((present = ANY(ARRAY['0'::"bigint",'1'::"bigint"])))`,
+		`CHECK ((present = custom."any"(ARRAY['0'::bigint,'1'::bigint])))`,
+		`CHECK ((present = ANY(ARRAY['0'::custom.bigint,'1'::custom.bigint])))`,
+	} {
+		if jointCanonicalConstraintWithVerifiedBigintIN(actual, "", nil, verified) == wanted {
+			t.Fatal("typed-literal equivalence accepted a changed predicate, value or nonliteral/narrowing cast")
+		}
+	}
+}
+
+func TestJointVerifiedBigintINRequiresIndependentlyVerifiedColumn(t *testing.T) {
+	actual := "CHECK ((present = ANY (ARRAY['0'::bigint,'1'::bigint])))"
+	for _, unverified := range []map[string]bool{nil, {}, {"other": true}, {"present": false}} {
+		if jointCanonicalConstraintWithVerifiedBigintIN(actual, "", nil, unverified) != jointCanonicalConstraint(actual, "") {
+			t.Fatal("unverified column acquired a typed-literal normalization")
+		}
+	}
+	for _, identifierQuote := range []string{`"any"(ARRAY['0'::bigint,'1'::bigint])`, `ANY(ARRAY['0'::"bigint",'1'::"bigint"])`, `custom."any"(ARRAY[0,1])`} {
+		if !jointBigintINHasIdentifierQuote(identifierQuote) {
+			t.Fatal("quoted identifier provenance was lost")
+		}
+	}
+	for _, literalQuote := range []string{`'literal "bytes"'`, `'escaped '' literal "bytes"'`, `$tag$literal "bytes"$tag$`, `/* comment "bytes" /* nested */ */ ANY(ARRAY['0'::bigint,'1'::bigint])`, "-- comment \"bytes\"\nANY(ARRAY['0'::bigint,'1'::bigint])"} {
+		if jointBigintINHasIdentifierQuote(literalQuote) {
+			t.Fatal("literal or comment bytes were mistaken for an identifier quote")
+		}
+	}
+}
+
+// This positive is derived from the actual PostgreSQL catalogue, never a
+// fabricated pg_get_constraintdef string. Mutations must remain full-table
+// failures even when the source's integer constants have typed deparser forms.
+func TestJointVerifiedBigintINActualPostgresTable(t *testing.T) {
+	for _, mode := range []string{"native_original", "altered_value", "narrowed_column_cast", "function_operand", "integer_column"} {
+		t.Run(mode, func(t *testing.T) {
+			db, _, _ := jointLineageFixture(t, true)
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			const table = "verified_bigint_in_fixture"
+			const definition = "CREATE TABLE verified_bigint_in_fixture (present BIGINT NOT NULL CHECK(present IN(0,1)));"
+			if _, err := db.ExecContext(ctx, definition); err != nil {
+				t.Fatal("actual PostgreSQL BIGINT IN fixture could not be created")
+			}
+			var native string
+			if err := db.QueryRowContext(ctx, "SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid='verified_bigint_in_fixture'::regclass AND contype='c'").Scan(&native); err != nil {
+				t.Fatal("actual native constraint definition could not be read")
+			}
+			columns, err := jointCatalogueColumns(ctx, db, "versioned", table)
+			if err != nil || len(columns) != 1 || columns[0] != (jointColumnIdentity{Name: "present", Type: "bigint", NotNull: true}) {
+				t.Fatal("native BIGINT column did not match its complete trusted declaration")
+			}
+			logJointFixedNativeBigintConstraintForTest(t, table, definition, native, columns)
+			wanted := jointCanonicalConstraint("CHECK (present IN (0,1))", "")
+			if jointCanonicalConstraint(native, "") == wanted {
+				t.Fatal("actual provider did not exhibit the typed-constant deparser discrepancy under diagnosis")
+			}
+			if jointCanonicalConstraintWithVerifiedBigintIN(native, "", nil, map[string]bool{columns[0].Name: columns[0].Type == "bigint"}) != wanted {
+				t.Fatal("actual native typed constants did not preserve the original integer IN meaning")
+			}
+			if err := jointVerifyTable(ctx, db, "versioned", table, definition); err != nil {
+				t.Fatal("full actual column and constraint identity refused the unchanged BIGINT IN table")
+			}
+			mutation := ""
+			switch mode {
+			case "native_original":
+				return
+			case "altered_value":
+				mutation = "ALTER TABLE verified_bigint_in_fixture DROP CONSTRAINT verified_bigint_in_fixture_present_check, ADD CHECK(present IN(0,2))"
+			case "narrowed_column_cast":
+				mutation = "ALTER TABLE verified_bigint_in_fixture DROP CONSTRAINT verified_bigint_in_fixture_present_check, ADD CHECK(present::integer IN(0,1))"
+			case "function_operand":
+				// The quoted user function is scalar and permits only2, unlike
+				// native ANY/IN0,1. Quotation loss must not recertify this CHECK.
+				if _, err := db.ExecContext(ctx, `CREATE FUNCTION "any"(bigint[]) RETURNS bigint LANGUAGE SQL IMMUTABLE AS 'SELECT 2::bigint'`); err != nil {
+					t.Fatal("actual quoted scalar function could not be created")
+				}
+				var scalar int64
+				if err := db.QueryRowContext(ctx, `SELECT "any"(ARRAY['0'::bigint,'1'::bigint])`).Scan(&scalar); err != nil || scalar != 2 {
+					t.Fatal("actual quoted function did not exhibit its distinct scalar behavior")
+				}
+				mutation = `ALTER TABLE verified_bigint_in_fixture DROP CONSTRAINT verified_bigint_in_fixture_present_check, ADD CHECK(present = "any"(ARRAY['0'::bigint,'1'::bigint]))`
+			case "integer_column":
+				mutation = "ALTER TABLE verified_bigint_in_fixture ALTER COLUMN present TYPE INTEGER"
+			}
+			if _, err := db.ExecContext(ctx, mutation); err != nil {
+				t.Fatal("actual negative schema mutation could not be installed")
+			}
+			if mode == "function_operand" {
+				if err := db.QueryRowContext(ctx, "SELECT pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid='verified_bigint_in_fixture'::regclass AND contype='c'").Scan(&native); err != nil || !jointBigintINHasIdentifierQuote(native) {
+					t.Fatal("actual scalar-function constraint did not retain quoted identifier evidence")
+				}
+				if _, err := db.ExecContext(ctx, "INSERT INTO verified_bigint_in_fixture(present) VALUES(2)"); err != nil {
+					t.Fatal("actual scalar CHECK did not demonstrate its different permitted value")
+				}
+			}
+			if err := jointVerifyTable(ctx, db, "versioned", table, definition); err != ErrJointSchemaUnknown {
+				t.Fatal("changed actual schema did not retain the full unknown-lineage refusal")
+			}
+		})
+	}
+}
+
+// Diagnostics are permitted only for this newly created, fixed, data-free
+// primitive fixture before any negative mutation. Never log app-table or
+// arbitrary source/query rows, DSNs, schema names or provider error text.
+func logJointFixedNativeBigintConstraintForTest(t *testing.T, table, definition, native string, columns []jointColumnIdentity) {
+	t.Helper()
+	if table != "verified_bigint_in_fixture" || definition != "CREATE TABLE verified_bigint_in_fixture (present BIGINT NOT NULL CHECK(present IN(0,1)));" ||
+		len(columns) != 1 || columns[0] != (jointColumnIdentity{Name: "present", Type: "bigint", NotNull: true}) {
+		return
+	}
+	if len(native) > 512 {
+		t.Log("joint_fixed_bigint_native diagnostic_suppressed=oversize")
+		return
+	}
+	record := struct {
+		Native                    string   `json:"native"`
+		Tokens                    []string `json:"tokens"`
+		Original, Current, Wanted string
+	}{Native: native, Tokens: jointSQLTokens(native), Original: jointCanonicalConstraint(native, ""),
+		Current: jointCanonicalConstraintWithVerifiedBigintIN(native, "", nil, map[string]bool{"present": true}),
+		Wanted:  jointCanonicalConstraint("CHECK (present IN (0,1))", "")}
+	data, err := json.Marshal(record)
+	const prefix = "joint_fixed_bigint_native "
+	if err != nil || len(data)+len(prefix) > 2048 {
+		t.Log("joint_fixed_bigint_native diagnostic_suppressed=oversize")
+		return
+	}
+	t.Logf("%s%s", prefix, data)
+}
diff --git a/internal/database/migration_original_pending_tail_source.go b/internal/database/migration_original_pending_tail_source.go
