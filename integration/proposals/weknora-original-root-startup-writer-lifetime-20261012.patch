diff --git a/internal/database/migration_original_root_sqlite_exclusion.go b/internal/database/migration_original_root_sqlite_exclusion.go
new file mode 100644
index 000000000..55a8b0a75
--- /dev/null
+++ b/internal/database/migration_original_root_sqlite_exclusion.go
@@ -0,0 +1,236 @@
+package database
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Fresh-file creation shares the existing bounded process-lifetime registry.
+// A successful plain FD is strongly retained before any validation error;
+// closing it could clear unrelated same-process SQLite POSIX locks.
+func (r *peerSQLiteDescriptorRegistry) ensureOriginalRootFile(ctx context.Context, path string) (os.FileInfo, error) {
+	if ctx == nil || r != &peerSQLiteMigrationDescriptors {
+		return nil, ErrJointSchemaUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if _, err := os.Lstat(path); err == nil {
+		info, err := os.Stat(path)
+		if err != nil {
+			return nil, ErrJointSchemaUnavailable
+		}
+		if err = validatePeerSQLiteMigrationFile(info); err != nil {
+			return nil, err
+		}
+		return info, nil
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, ErrJointSchemaUnavailable
+	}
+	capacity, err := peerSQLiteDescriptorCapacity()
+	if err != nil {
+		return nil, err
+	}
+	if len(r.retained)+r.reservations >= capacity {
+		return nil, ErrJointSchemaDescriptorCapacity
+	}
+	r.reservations++
+	opened, err := originalRootSQLiteCreateRetainedDescriptor(path)
+	if opened != nil {
+		r.retained = append(r.retained, opened)
+	}
+	r.reservations--
+	if errors.Is(err, os.ErrExist) {
+		// Another real creator won; capture that file before descriptor()/claim.
+		info, err := os.Stat(path)
+		if err != nil {
+			return nil, ErrJointSchemaUnavailable
+		}
+		if err = validatePeerSQLiteMigrationFile(info); err != nil {
+			return nil, err
+		}
+		return info, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if opened == nil || opened.file == nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	opened.resolvedPath = path
+	opened.changeLock = peerSQLiteChangeOFD
+	opened.gate = make(chan struct{}, 1)
+	opened.gate <- struct{}{}
+	opened.poisoned = make(chan struct{})
+	info, err := opened.file.Stat()
+	if err != nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	opened.identity = info
+	if err = validatePeerSQLiteMigrationFile(info); err != nil {
+		return nil, err
+	}
+	key, err := peerSQLiteDescriptorKey(info)
+	if err != nil {
+		return nil, err
+	}
+	opened.filesystem, err = peerSQLiteDescriptorFilesystem(opened.file)
+	if err != nil {
+		return nil, err
+	}
+	again, err := os.Stat(path)
+	if err != nil || !os.SameFile(info, again) {
+		return nil, ErrJointSchemaUnknown
+	}
+	// O_EXCL created a new inode. Never replace a live/quarantined registry owner.
+	if r.entries[key] != nil {
+		return nil, ErrJointSchemaUnknown
+	}
+	r.entries[key] = opened
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	return info, nil
+}
+
+func originalRootSQLiteFilename(dsn string, opts MigrationOptions) (string, string, error) {
+	path := opts.SQLiteDBPath
+	if path == "" {
+		path = strings.TrimPrefix(dsn, "sqlite3://")
+	}
+	if path == "" || path == ":memory:" {
+		return "", "", ErrJointSchemaUnavailable
+	}
+	requested, err := filepath.Abs(path)
+	if err != nil {
+		return "", "", ErrJointSchemaUnavailable
+	}
+	_, err = os.Lstat(requested)
+	if err == nil {
+		resolved, err := filepath.EvalSymlinks(requested)
+		if err != nil {
+			return "", "", ErrJointSchemaUnknown
+		}
+		return requested, resolved, nil
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return "", "", ErrJointSchemaUnavailable
+	}
+	parent, err := filepath.EvalSymlinks(filepath.Dir(requested))
+	if err != nil {
+		return "", "", ErrJointSchemaUnavailable
+	}
+	return requested, filepath.Join(parent, filepath.Base(requested)), nil
+}
+
+// Observe SQLite's actual main filename only AFTER owning byte-zero OFD. Both
+// aliases and the SQL connection's main relation must match the claimed inode.
+// Empty fresh main files are legitimate bootstrap inputs, not Ready schemas.
+func originalRootSQLiteActualMain(ctx context.Context, held *jointPeerSQLiteMigrationExclusion, requested string) error {
+	if err := held.check(ctx); err != nil {
+		return err
+	}
+	requestedInfo, err := os.Stat(requested)
+	if err != nil || !os.SameFile(requestedInfo, held.identity) {
+		return ErrJointSchemaUnknown
+	}
+	opts := MigrationOptions{SQLiteDBPath: held.resolvedPath, jointReadOnly: true}
+	db, dialect, err := openJointLineageDB("sqlite3://unused", opts)
+	if err != nil {
+		return err
+	}
+	if dialect != "sqlite" {
+		return errors.Join(ErrJointSchemaUnavailable, db.Close())
+	}
+	rows, err := db.QueryContext(ctx, "PRAGMA database_list")
+	if err != nil {
+		return errors.Join(ErrJointSchemaUnavailable, db.Close())
+	}
+	count := 0
+	main := ""
+	for rows.Next() {
+		var sequence int
+		var name, filename string
+		if rows.Scan(&sequence, &name, &filename) != nil {
+			rows.Close()
+			db.Close()
+			return ErrJointSchemaUnavailable
+		}
+		if name == "main" {
+			count++
+			main = filename
+		}
+	}
+	closeErr := errors.Join(rows.Err(), rows.Close(), db.Close())
+	if closeErr != nil {
+		return ErrJointSchemaUnavailable
+	}
+	if count != 1 || main == "" || !filepath.IsAbs(main) {
+		return ErrJointSchemaUnknown
+	}
+	info, err := os.Stat(main)
+	if err != nil || !os.SameFile(info, held.identity) {
+		return ErrJointSchemaUnknown
+	}
+	if err = held.check(ctx); err != nil {
+		return err
+	}
+	requestedInfo, err = os.Stat(requested)
+	if err != nil || !os.SameFile(requestedInfo, held.identity) {
+		return ErrJointSchemaUnknown
+	}
+	return ctx.Err()
+}
+
+// The owner is acquired before the first ledger/catalogue read or migrator
+// initialization, covering old canonical bootstrap, tail, Ready and all driver
+// closes. An already held genuine same-file context is borrowed, never relocked.
+func acquireOriginalRootSQLiteBootstrap(ctx context.Context, dsn string, opts MigrationOptions) (*jointPeerSQLiteMigrationExclusion, bool, error) {
+	if ctx == nil {
+		return nil, false, ErrJointSchemaUnavailable
+	}
+	requested, resolved, err := originalRootSQLiteFilename(dsn, opts)
+	if err != nil {
+		return nil, false, err
+	}
+	if ctx.Value(jointPeerSQLiteMigrationContextKey{}) != nil {
+		held, err := peerSQLiteMigrationExclusionFromContext(ctx)
+		if err != nil {
+			return nil, false, err
+		}
+		if err = originalRootSQLiteActualMain(ctx, held, requested); err != nil {
+			return nil, false, err
+		}
+		return held, false, nil
+	}
+	captured, err := peerSQLiteMigrationDescriptors.ensureOriginalRootFile(ctx, resolved)
+	if err != nil {
+		return nil, false, err
+	}
+	held, err := lockPeerSQLiteMigrationInode(ctx, resolved, resolved)
+	if err != nil {
+		return nil, false, err
+	}
+	held.requestedPath = requested
+	fail := func(err error) (*jointPeerSQLiteMigrationExclusion, bool, error) {
+		return nil, false, errors.Join(err, held.Close())
+	}
+	if captured == nil || !os.SameFile(captured, held.identity) {
+		return fail(ErrJointSchemaUnknown)
+	}
+	if err = held.check(ctx); err != nil {
+		return fail(err)
+	}
+	if err = originalRootSQLiteActualMain(ctx, held, requested); err != nil {
+		return fail(err)
+	}
+	return held, true, nil
+}
diff --git a/internal/database/migration_original_root_sqlite_writer.go b/internal/database/migration_original_root_sqlite_writer.go
new file mode 100644
index 000000000..d0278b7c5
--- /dev/null
+++ b/internal/database/migration_original_root_sqlite_writer.go
@@ -0,0 +1,138 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+)
+
+type originalRootSQLiteUseKey struct{}
+type originalRootSQLiteUse struct {
+	held     *jointPeerSQLiteMigrationExclusion
+	once     sync.Once
+	released bool
+}
+
+func pinOriginalRootSQLiteUse(ctx context.Context) (context.Context, *originalRootSQLiteUse, error) {
+	held, err := peerSQLiteMigrationExclusionFromContext(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	held.lifeMu.Lock()
+	defer held.lifeMu.Unlock()
+	if held.closing {
+		return nil, nil, ErrJointSchemaUnavailable
+	}
+	if err = held.check(ctx); err != nil {
+		return nil, nil, err
+	}
+	held.uses.Add(1)
+	use := &originalRootSQLiteUse{held: held}
+	return context.WithValue(ctx, originalRootSQLiteUseKey{}, use), use, nil
+}
+func (u *originalRootSQLiteUse) release() {
+	u.once.Do(func() { u.held.lifeMu.Lock(); u.released = true; u.held.uses.Done(); u.held.lifeMu.Unlock() })
+}
+func originalRootSQLiteUseFromContext(ctx context.Context) (*originalRootSQLiteUse, error) {
+	if ctx == nil {
+		return nil, ErrJointSchemaUnavailable
+	}
+	u, ok := ctx.Value(originalRootSQLiteUseKey{}).(*originalRootSQLiteUse)
+	held, err := peerSQLiteMigrationExclusionFromContext(ctx)
+	if !ok || u == nil || u.held == nil || err != nil || u.held != held {
+		return nil, ErrJointSchemaUnavailable
+	}
+	held.lifeMu.Lock()
+	defer held.lifeMu.Unlock()
+	if held.closing || u.released {
+		return nil, ErrJointSchemaUnavailable
+	}
+	return u, nil
+}
+
+// A test-only context observer can mutate an actual file/owner BEFORE the
+// admission below. It returns no fact or permission and is absent by default.
+// No hook runs while lifeMu is held, so real owner.Close can actually join.
+type originalRootMutationProbeKey struct{}
+
+func originalRootMutationProbe(ctx context.Context, phase string) {
+	if fn, ok := ctx.Value(originalRootMutationProbeKey{}).(func(string)); ok && fn != nil {
+		fn(phase)
+	}
+}
+func (u *originalRootSQLiteUse) write(ctx context.Context, phase string, run func() error) error {
+	if u == nil || u.held == nil || run == nil {
+		return ErrJointSchemaUnavailable
+	}
+	originalRootMutationProbe(ctx, phase)
+	u.held.lifeMu.Lock()
+	defer u.held.lifeMu.Unlock()
+	if u.held.closing || u.released {
+		return ErrJointSchemaUnavailable
+	}
+	if err := u.held.check(ctx); err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return run()
+}
+
+// This is the actual private writer pool: max1 prevents WithInstance from
+// switching to a fresh connection between the main-file check and its own
+// ensureVersionTable CREATE. mode=rw cannot recreate a removed filename.
+func originalRootSQLiteWriterPool(ctx context.Context, use *originalRootSQLiteUse) (pool *sql.DB, poolErr error) {
+	poolErr = use.write(ctx, "before_writer_open", func() (runErr error) {
+		raw, err := jointSQLiteFilenameDSN(use.held.resolvedPath, "rw")
+		if err != nil {
+			return err
+		}
+		pool, err = sql.Open("sqlite3", raw)
+		if err != nil {
+			return ErrJointSchemaUnavailable
+		}
+		pool.SetMaxOpenConns(1)
+		pool.SetMaxIdleConns(1)
+		conn, err := pool.Conn(ctx)
+		if err != nil {
+			return ErrJointSchemaUnavailable
+		}
+		defer func() { runErr = errors.Join(runErr, conn.Close()) }()
+		rows, err := conn.QueryContext(ctx, "PRAGMA database_list")
+		if err != nil {
+			return ErrJointSchemaUnavailable
+		}
+		count := 0
+		main := ""
+		for rows.Next() {
+			var seq int
+			var name, path string
+			if rows.Scan(&seq, &name, &path) != nil {
+				rows.Close()
+				return ErrJointSchemaUnavailable
+			}
+			if name == "main" {
+				count++
+				main = path
+			}
+		}
+		err = errors.Join(rows.Err(), rows.Close())
+		if err != nil {
+			return ErrJointSchemaUnavailable
+		}
+		info, err := os.Stat(main)
+		if err != nil || count != 1 || !filepath.IsAbs(main) || !os.SameFile(info, use.held.identity) {
+			return ErrJointSchemaUnknown
+		}
+		return use.held.check(ctx)
+	})
+	if poolErr != nil && pool != nil {
+		poolErr = errors.Join(poolErr, pool.Close())
+		pool = nil
+	}
+	return pool, poolErr
+}
