+package database
+
+import "strings"
+
+// Split complete frozen statements without losing trigger BEGIN/CASE bodies
+// or PostgreSQL dollar-quoted functions. It is used for source projection only;
+// SQL execution continues to belong exclusively to the real migrate driver.
+func jointOriginalPendingTailStatements(sql string) ([]string, error) {
+	result := []string{}
+	start, i, depth := 0, 0, 0
+	var quote byte
+	dollar := ""
+	words := []string{}
+	for i < len(sql) {
+		if dollar != "" {
+			if strings.HasPrefix(sql[i:], dollar) {
+				i += len(dollar)
+				dollar = ""
+			} else {
+				i++
+			}
+			continue
+		}
+		if quote != 0 {
+			if sql[i] == quote {
+				if i+1 < len(sql) && sql[i+1] == quote {
+					i += 2
+					continue
+				}
+				quote = 0
+			}
+			i++
+			continue
+		}
+		if strings.HasPrefix(sql[i:], "--") {
+			end := strings.IndexByte(sql[i:], '\n')
+			if end < 0 {
+				i = len(sql)
+			} else {
+				i += end + 1
+			}
+			continue
+		}
+		if strings.HasPrefix(sql[i:], "/*") {
+			end := strings.Index(sql[i+2:], "*/")
+			if end < 0 {
+				return nil, ErrJointSchemaSourceIdentity
+			}
+			i += end + 4
+			continue
+		}
+		if sql[i] == '\'' || sql[i] == '"' {
+			quote = sql[i]
+			i++
+			continue
+		}
+		if sql[i] == '$' {
+			j := i + 1
+			for j < len(sql) && (sql[j] == '_' || sql[j] >= 'a' && sql[j] <= 'z' || sql[j] >= 'A' && sql[j] <= 'Z' || sql[j] >= '0' && sql[j] <= '9') {
+				j++
+			}
+			if j < len(sql) && sql[j] == '$' {
+				dollar = sql[i : j+1]
+				i = j + 1
+				continue
+			}
+		}
+		if sql[i] == '_' || sql[i] >= 'a' && sql[i] <= 'z' || sql[i] >= 'A' && sql[i] <= 'Z' {
+			j := i + 1
+			for j < len(sql) && (sql[j] == '_' || sql[j] >= 'a' && sql[j] <= 'z' || sql[j] >= 'A' && sql[j] <= 'Z' || sql[j] >= '0' && sql[j] <= '9') {
+				j++
+			}
+			word := strings.ToLower(sql[i:j])
+			words = append(words, word)
+			if len(words) >= 2 && words[0] == "create" && words[1] == "trigger" {
+				if word == "begin" || word == "case" {
+					depth++
+				} else if word == "end" {
+					depth--
+					if depth < 0 {
+						return nil, ErrJointSchemaSourceIdentity
+					}
+				}
+			}
+			i = j
+			continue
+		}
+		if sql[i] == ';' && depth == 0 {
+			statement := strings.TrimSpace(sql[start : i+1])
+			if statement != "" {
+				result = append(result, statement)
+			}
+			start = i + 1
+			words = []string{}
+		}
+		i++
+	}
+	if quote != 0 || dollar != "" || depth != 0 || strings.TrimSpace(sql[start:]) != "" {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	return result, nil
+}
diff --git a/internal/database/migration_original_root.go b/internal/database/migration_original_root.go
new file mode 100644
index 000000000..6eb99b169
--- /dev/null
+++ b/internal/database/migration_original_root.go
@@ -0,0 +1,237 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"os"
+
+	"github.com/golang-migrate/migrate/v4"
+)
+
+var (
+	ErrOriginalRootPeerTail       = errors.New("original_root_tail_needs_peer_common_append")
+	ErrOriginalRootSchemaNotReady = errors.New("original_root_tail_not_ready")
+)
+
+// RunOriginalKnowledgeMigrations is an explicit startup migration entry. It
+// leaves the old canonical and Peer entry/SQL intact; no registry is activated.
+// First bootstrap really executes the old canonical source to87/168. Only an
+// exact Root catalogue may then create the immutable route checkpoint under
+// the actual migrate lock and execute the independent unchanged tail.
+func RunOriginalKnowledgeMigrations(ctx context.Context, dsn string, opts MigrationOptions) (runErr error) {
+	if ctx == nil {
+		return ErrJointSchemaUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	root, err := os.Getwd()
+	if err != nil {
+		return ErrJointSchemaSourceIdentity
+	}
+	dialect := jointLineageDialect(dsn, opts)
+	source, err := admitJointOriginalRootSource(ctx, root, dialect)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntrySource, err == nil)
+	if err != nil {
+		return err
+	}
+	// Own the actual main inode before any old canonical bootstrap SQL or
+	// ledger observation. Tail must reuse this owner; recursive acquire is not
+	// a substitute for exclusion of the whole explicit startup lifecycle.
+	if dialect == "sqlite" {
+		held, owned, err := acquireOriginalRootSQLiteBootstrap(ctx, dsn, opts)
+		if err != nil {
+			return err
+		}
+		if owned {
+			defer func() { runErr = errors.Join(runErr, held.Close()) }()
+		}
+		ctx = context.WithValue(ctx, jointPeerSQLiteMigrationContextKey{}, held)
+		opts.SQLiteDBPath = held.resolvedPath
+		var use *originalRootSQLiteUse
+		ctx, use, err = pinOriginalRootSQLiteUse(ctx)
+		if err != nil {
+			return err
+		}
+		defer use.release()
+	}
+	version, dirty, known, err := observeJointSchemaHistoryBeforeDriver(ctx, dsn, opts)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntryInitialLedger, err == nil)
+	if err != nil {
+		return err
+	}
+	if dirty {
+		return ErrJointSchemaAmbiguousDirty
+	}
+	if !known || version < source.spec.OriginVersion {
+		route, err := selectJointMigrationRoute(ctx, dsn, opts, version, dirty, known)
+		if err != nil {
+			return err
+		}
+		if route.lineage != jointCanonicalRootSource {
+			return ErrOriginalRootPeerTail
+		}
+		if known {
+			readOptions := opts
+			readOptions.jointReadOnly = true
+			db, _, err := openJointLineageDB(dsn, readOptions)
+			if err != nil {
+				return err
+			}
+			checkErr := originalRootFutureAbsence(ctx, db, source)
+			if err = errors.Join(checkErr, db.Close()); err != nil {
+				return err
+			}
+		}
+		// Never use Force/automatic recovery in this explicit new route.
+		canonicalOptions := opts
+		canonicalOptions.AutoRecoverDirty = false
+		if dialect == "sqlite" {
+			err = runOriginalRootSQLiteCanonical(ctx, dsn, canonicalOptions, source, version, known)
+		} else {
+			err = RunMigrationsWithContext(ctx, dsn, canonicalOptions)
+		}
+		observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntryCanonicalBootstrap, err == nil)
+		if err != nil {
+			return err
+		}
+		version, dirty, known, err = observeJointSchemaHistoryBeforeDriver(ctx, dsn, opts)
+		observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntryPostBootstrapLedger, err == nil)
+		if err != nil {
+			return err
+		}
+	}
+	if !known || dirty {
+		return ErrJointSchemaAmbiguousDirty
+	}
+	if !source.knownVersion(version) {
+		// Honest89/171 and other peer prefixes remain on their own old route.
+		if jointPeerForwardVersion(dialect, version) {
+			return ErrOriginalRootPeerTail
+		}
+		return ErrJointSchemaUnknown
+	}
+	readOptions := opts
+	readOptions.jointReadOnly = true
+	db, _, err := openJointLineageDB(dsn, readOptions)
+	if err != nil {
+		return err
+	}
+	checkErr := inspectOriginalRootRoute(ctx, db, source, version, true)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntryOriginInspect, checkErr == nil)
+	if err = errors.Join(checkErr, db.Close()); err != nil {
+		return err
+	}
+	if err = source.recheck(ctx); err != nil {
+		return err
+	}
+	m, err := newOriginalRootMigrate(ctx, dsn, opts, source, version)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntryTailInitialization, err == nil)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		actual, actualDirty, versionErr := m.Version()
+		sourceErr, driverErr := m.Close()
+		runErr = errors.Join(runErr, sourceErr, driverErr)
+		fixedFailure := ""
+		if runErr != nil {
+			fixedFailure = ErrOriginalRootSchemaNotReady.Error()
+		}
+		setMigrationState(actual, actualDirty, fixedFailure, versionErr == nil)
+	}()
+	err = m.Up()
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntryTailUp, err == nil || err == migrate.ErrNoChange)
+	if err != nil && err != migrate.ErrNoChange {
+		return err
+	}
+	final, finalDirty, err := m.Version()
+	if err != nil || finalDirty || final != source.spec.FinalVersion {
+		return ErrOriginalRootSchemaNotReady
+	}
+	readOptions.jointReadOnly = true
+	db, _, err = openJointLineageDB(dsn, readOptions)
+	if err != nil {
+		return err
+	}
+	checkErr = inspectOriginalRootRoute(ctx, db, source, final, false)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticEntryFinalInspect, checkErr == nil)
+	return errors.Join(checkErr, db.Close())
+}
+
+func inspectOriginalRootRoute(ctx context.Context, db *sql.DB, source *jointOriginalRootSource, version uint, allowOrigin bool) (routeErr error) {
+	if ctx == nil || db == nil || source == nil || !source.knownVersion(version) {
+		return ErrJointSchemaUnknown
+	}
+	if err := source.recheck(ctx); err != nil {
+		return err
+	}
+	options := &sql.TxOptions{ReadOnly: true}
+	if source.dialect == "versioned" {
+		options.Isolation = sql.LevelRepeatableRead
+	}
+	tx, err := db.BeginTx(ctx, options)
+	if err != nil {
+		return ErrJointSchemaUnavailable
+	}
+	defer func() {
+		if closeErr := tx.Rollback(); closeErr != nil && closeErr != sql.ErrTxDone {
+			routeErr = errors.Join(routeErr, closeErr)
+		}
+	}()
+	actual, dirty, err := originalRootLedger(ctx, tx)
+	if err != nil {
+		return err
+	}
+	if dirty {
+		return ErrJointSchemaAmbiguousDirty
+	}
+	if actual != version {
+		return ErrJointSchemaUnknown
+	}
+	objects, _, err := peerPrefixObjectSets(ctx, tx, source.dialect)
+	if err != nil {
+		return err
+	}
+	checkpoint := objects[originalRootRouteTable]
+	if !checkpoint && (!allowOrigin || version != source.spec.OriginVersion) {
+		return ErrJointSchemaUnknown
+	}
+	if err = verifyOriginalRootCatalogueInTx(ctx, tx, source, version, checkpoint); err != nil {
+		return err
+	}
+	return checkPeerSQLiteMigrationExclusion(ctx)
+}
+
+// Actual application readiness uses its real pool and complete catalogue,
+// exact checkpoint row/DDL/source,42 known body descriptors and final ledger.
+// A same-number peer/manual tail cannot retroactively mint the Root marker.
+func VerifyOriginalKnowledgeSchemaReadyOnDB(ctx context.Context, db *sql.DB, dialect string) error {
+	if ctx == nil || db == nil {
+		return ErrJointSchemaUnavailable
+	}
+	if dialect == "postgres" {
+		dialect = "versioned"
+	}
+	root, err := os.Getwd()
+	if err != nil {
+		return ErrJointSchemaSourceIdentity
+	}
+	source, err := admitJointOriginalRootSource(ctx, root, dialect)
+	if err != nil {
+		return err
+	}
+	return inspectOriginalRootRoute(ctx, db, source, source.spec.FinalVersion, false)
+}
+func VerifyOriginalKnowledgeSchemaReady(ctx context.Context, dsn string, opts MigrationOptions) error {
+	if ctx == nil {
+		return ErrJointSchemaUnavailable
+	}
+	opts.jointReadOnly = true
+	db, dialect, err := openJointLineageDB(dsn, opts)
+	if err != nil {
+		return err
+	}
+	return errors.Join(VerifyOriginalKnowledgeSchemaReadyOnDB(ctx, db, dialect), db.Close())
+}
diff --git a/internal/database/migration_original_root_catalogue.go b/internal/database/migration_original_root_catalogue.go
new file mode 100644
index 000000000..3ba7d2373
--- /dev/null
+++ b/internal/database/migration_original_root_catalogue.go
@@ -0,0 +1,209 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+)
+
+const originalRootRouteTable = "nextcloud_original_root_route_origin"
+
+func originalRootLedger(ctx context.Context, tx *sql.Tx) (uint, bool, error) {
+	rows, err := tx.QueryContext(ctx, "SELECT version,dirty FROM schema_migrations")
+	if err != nil {
+		return 0, false, ErrJointSchemaUnknown
+	}
+	var version uint
+	var dirty bool
+	count := 0
+	for rows.Next() {
+		if rows.Scan(&version, &dirty) != nil {
+			rows.Close()
+			return 0, false, ErrJointSchemaUnknown
+		}
+		count++
+	}
+	rowErr, closeErr := rows.Err(), rows.Close()
+	if rowErr != nil || closeErr != nil || count != 1 {
+		return 0, false, ErrJointSchemaUnknown
+	}
+	return version, dirty, ctx.Err()
+}
+func originalRootRouteMarker(ctx context.Context, tx *sql.Tx, s *jointOriginalRootSource) error {
+	rows, err := tx.QueryContext(ctx, "SELECT id,dialect,origin_version,source_sha256,catalogue_sha256,checkpoint_sha256 FROM "+originalRootRouteTable)
+	if err != nil {
+		return ErrJointSchemaUnknown
+	}
+	count := 0
+	for rows.Next() {
+		var id int
+		var dialect, source, catalogue, checkpoint string
+		var version uint
+		if rows.Scan(&id, &dialect, &version, &source, &catalogue, &checkpoint) != nil || id != 1 || dialect != s.dialect || version != s.spec.OriginVersion || source != s.digest || catalogue != s.originCatalogueDigest || checkpoint != s.spec.CheckpointSHA256 {
+			rows.Close()
+			return ErrJointSchemaUnknown
+		}
+		count++
+	}
+	rowErr, closeErr := rows.Err(), rows.Close()
+	if rowErr != nil || closeErr != nil || count != 1 {
+		return ErrJointSchemaUnknown
+	}
+	return ctx.Err()
+}
+
+// Validate the complete old Root projection and the exact installed tail in
+// one real transaction. Old/root and new/pending sentinels are typed together;
+// a future object, wrong kind or partial checkpoint cannot borrow the route.
+func verifyOriginalRootCatalogueInTx(ctx context.Context, tx *sql.Tx, s *jointOriginalRootSource, version uint, checkpoint bool) error {
+	if s == nil || tx == nil || ctx == nil {
+		return ErrJointSchemaUnavailable
+	}
+	expected, err := s.expected(version, checkpoint)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueExpected, err == nil)
+	if err != nil {
+		return err
+	}
+	objects, _, err := peerPrefixObjectSets(ctx, tx, s.dialect)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueObjectKinds, err == nil)
+	if err != nil {
+		return err
+	}
+	witness, err := jointLineageWitnessesFromSource()
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueExpected, err == nil)
+	if err != nil {
+		return err
+	}
+	sentinel := witness.Sentinels
+	// Appending creates fresh slices and leaves the embedded old witness intact.
+	sentinel.Tables = append([]string{}, sentinel.Tables...)
+	sentinel.Triggers = append([]string{}, sentinel.Triggers...)
+	sentinel.Functions = append([]string{}, sentinel.Functions...)
+	sentinel.Indexes = append([]string{}, sentinel.Indexes...)
+	all, err := s.expected(s.spec.FinalVersion, true)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueExpected, err == nil)
+	if err != nil {
+		return err
+	}
+	for name := range all.Tables {
+		sentinel.Tables = append(sentinel.Tables, name)
+	}
+	for name := range all.Triggers {
+		sentinel.Triggers = append(sentinel.Triggers, name)
+	}
+	for name := range all.Functions {
+		sentinel.Functions = append(sentinel.Functions, name)
+	}
+	for name := range all.Indexes {
+		sentinel.Indexes = append(sentinel.Indexes, name)
+	}
+	// The real local backend may have initialized this old scalar table before
+	// 90. Require its exact shape, never invent vector/input/output receipts.
+	if s.dialect == "sqlite" && version == s.spec.OriginVersion && objects["table/lite_embeddings"] {
+		expected.Tables["lite_embeddings"] = all.Tables["lite_embeddings"]
+		for name, definition := range all.Indexes {
+			if objects["index/"+name] && name == "idx_sqlite_emb_source" {
+				expected.Indexes[name] = definition
+			}
+		}
+	}
+	err = jointVerifySentinelObjectKinds(objects, sentinel, expected)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueObjectKinds, err == nil)
+	if err != nil {
+		return err
+	}
+	for table, columns := range witness.Sentinels.Columns {
+		for _, column := range columns {
+			present, err := peerPrefixIntroducedColumn(ctx, tx, s.dialect, table, column)
+			if err != nil {
+				observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueColumns, false)
+				return err
+			}
+			if present {
+				if _, ok := expected.Columns[table][column]; !ok {
+					observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueColumns, false)
+					return ErrJointSchemaUnknown
+				}
+			}
+		}
+	}
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueColumns, true)
+	err = verifyPeerPrefixCatalogueInTx(ctx, tx, s.dialect, expected)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueExactFull, err == nil)
+	if err != nil {
+		return err
+	}
+	if s.dialect == "versioned" {
+		err = jointVerifyWithdrawalKindConstraint(ctx, tx, expected.RegistryConstraint)
+		observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueWithdrawalConstraint, err == nil)
+		if err != nil {
+			return err
+		}
+		core, err := inspectJoint125LocalRepair(ctx, tx)
+		if err != nil {
+			observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueCore125, false)
+			return err
+		}
+		if core.state != joint125GuardCurrent && core.state != joint125OptionalAbsent {
+			observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueCore125, false)
+			return ErrJointSchemaRootWitness
+		}
+		observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueCore125, true)
+	}
+	if checkpoint {
+		err = originalRootRouteMarker(ctx, tx, s)
+		observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueOriginMarker, err == nil)
+		if err != nil {
+			return err
+		}
+	}
+	err = s.recheck(ctx)
+	observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueSourceRecheck, err == nil)
+	return err
+}
+
+func originalRootFutureAbsence(ctx context.Context, db *sql.DB, s *jointOriginalRootSource) error {
+	tx, err := db.BeginTx(ctx, &sql.TxOptions{ReadOnly: true})
+	if err != nil {
+		return ErrJointSchemaUnavailable
+	}
+	defer tx.Rollback()
+	objects, _, err := peerPrefixObjectSets(ctx, tx, s.dialect)
+	if err != nil {
+		return err
+	}
+	all, err := s.expected(s.spec.FinalVersion, true)
+	if err != nil {
+		return err
+	}
+	old, err := jointExpectedCatalogue(s.dialect, s.spec.OriginVersion)
+	if err != nil {
+		return err
+	}
+	for name := range all.Tables {
+		if name == "lite_embeddings" {
+			continue
+		}
+		if _, exists := old.Tables[name]; !exists && objects[name] {
+			return ErrJointSchemaUnknown
+		}
+	}
+	for name := range all.Triggers {
+		if _, exists := old.Triggers[name]; !exists && objects[name] {
+			return ErrJointSchemaUnknown
+		}
+	}
+	for name := range all.Functions {
+		if _, exists := old.Functions[name]; !exists && objects[name] {
+			return ErrJointSchemaUnknown
+		}
+	}
+	for name := range all.Indexes {
+		if name == "idx_sqlite_emb_source" {
+			continue
+		}
+		if _, exists := old.Indexes[name]; !exists && objects[name] {
+			return ErrJointSchemaUnknown
+		}
+	}
+	return ctx.Err()
+}
diff --git a/internal/database/migration_original_root_diagnostic.go b/internal/database/migration_original_root_diagnostic.go
new file mode 100644
index 000000000..d66d216ed
--- /dev/null
+++ b/internal/database/migration_original_root_diagnostic.go
@@ -0,0 +1,56 @@
+package database
+
+import "context"
+
+// These labels describe actual Root call/predicate phases only. They do not
+// contain SQL, object names, selectors, rows, error text or authorization.
+type originalRootDiagnosticPhase uint8
+
+const (
+	originalRootDiagnosticEntrySource originalRootDiagnosticPhase = iota
+	originalRootDiagnosticEntryInitialLedger
+	originalRootDiagnosticEntryCanonicalBootstrap
+	originalRootDiagnosticEntryPostBootstrapLedger
+	originalRootDiagnosticEntryOriginInspect
+	originalRootDiagnosticEntryTailInitialization
+	originalRootDiagnosticEntryTailUp
+	originalRootDiagnosticEntryFinalInspect
+	originalRootDiagnosticCatalogueExpected
+	originalRootDiagnosticCatalogueObjectKinds
+	originalRootDiagnosticCatalogueColumns
+	originalRootDiagnosticCatalogueExactFull
+	originalRootDiagnosticCatalogueWithdrawalConstraint
+	originalRootDiagnosticCatalogueCore125
+	originalRootDiagnosticCatalogueOriginMarker
+	originalRootDiagnosticCatalogueSourceRecheck
+	originalRootDiagnosticExactTables
+	originalRootDiagnosticExactColumns
+	originalRootDiagnosticExactFunctions
+	originalRootDiagnosticExactTriggers
+	originalRootDiagnosticExactIndexes
+	originalRootDiagnosticTailTableOne
+	originalRootDiagnosticTailTableTwo
+	originalRootDiagnosticTailTableThree
+	originalRootDiagnosticPhaseCount
+)
+
+type originalRootDiagnosticObserverKey struct{}
+type originalRootDiagnosticObserver struct {
+	observe func(originalRootDiagnosticPhase, bool)
+}
+
+// Only package-local tests register the inert observer. Default calls have
+// no observer, clock read, extra SQL, context mutation or admission marker.
+func observeOriginalRootDiagnostic(ctx context.Context, phase originalRootDiagnosticPhase, success bool) {
+	if ctx == nil || phase >= originalRootDiagnosticPhaseCount {
+		return
+	}
+	observer, _ := ctx.Value(originalRootDiagnosticObserverKey{}).(*originalRootDiagnosticObserver)
+	if observer == nil || observer.observe == nil {
+		return
+	}
+	// The diagnostic callback has no return value and cannot replace the
+	// actual caller's error/permission decision, including a callback panic.
+	defer func() { _ = recover() }()
+	observer.observe(phase, success)
+}
diff --git a/internal/database/migration_original_root_diagnostic_test.go b/internal/database/migration_original_root_diagnostic_test.go
new file mode 100644
index 000000000..e7f1eef13
--- /dev/null
+++ b/internal/database/migration_original_root_diagnostic_test.go
@@ -0,0 +1,199 @@
+package database
+
+import (
+	"context"
+	"errors"
+	"os"
+	"sync"
+	"testing"
+)
+
+const originalRootDiagnosticFlag = "WEKNORA_ORIGINAL_ROOT_PHASE_DIAGNOSTIC"
+const originalRootDiagnosticMaxCount uint64 = 1<<32 - 1
+
+var originalRootDiagnosticPhaseNames = [originalRootDiagnosticPhaseCount]string{
+	"entry_source", "entry_initial_ledger", "entry_canonical_bootstrap",
+	"entry_post_bootstrap_ledger", "entry_origin_inspect", "entry_tail_initialization",
+	"entry_tail_up", "entry_final_inspect", "catalogue_expected",
+	"catalogue_object_kinds", "catalogue_columns", "catalogue_exact_full",
+	"catalogue_withdrawal_constraint", "catalogue_core125",
+	"catalogue_origin_marker", "catalogue_source_recheck",
+	"exact_tables", "exact_columns", "exact_functions", "exact_triggers",
+	"exact_indexes", "tail_table_1", "tail_table_2", "tail_table_3",
+}
+
+type originalRootDiagnosticBucket struct {
+	count, successes uint64
+	saturated        bool
+}
+
+type originalRootDiagnosticCollector struct {
+	mu      sync.Mutex
+	buckets [originalRootDiagnosticPhaseCount]originalRootDiagnosticBucket
+	sealed  bool
+}
+
+// Bounded fixed-enum counts only. No SQL, waits, logs or test failures execute
+// in a callback, and no test hook can replace a real migration return value.
+func (collector *originalRootDiagnosticCollector) record(phase originalRootDiagnosticPhase, success bool) {
+	if phase >= originalRootDiagnosticPhaseCount {
+		return
+	}
+	collector.mu.Lock()
+	defer collector.mu.Unlock()
+	if collector.sealed {
+		return
+	}
+	bucket := &collector.buckets[phase]
+	if bucket.count == originalRootDiagnosticMaxCount {
+		bucket.saturated = true
+		return
+	}
+	bucket.count++
+	if success {
+		bucket.successes++
+	}
+}
+
+func originalRootDiagnosticContextForTest(t *testing.T, ctx context.Context) context.Context {
+	t.Helper()
+	if os.Getenv(originalRootDiagnosticFlag) != "1" {
+		return ctx
+	}
+	collector := &originalRootDiagnosticCollector{}
+	observer := &originalRootDiagnosticObserver{observe: collector.record}
+	t.Cleanup(func() {
+		// Every synchronous Root operation has returned, including its owned
+		// migrate driver Close/deferred error joins. This performs no new wait.
+		collector.mu.Lock()
+		collector.sealed = true
+		buckets := collector.buckets
+		collector.mu.Unlock()
+		for phase, bucket := range buckets {
+			t.Logf("original_root_phase phase=%s count=%d success_count=%d failure_count=%d saturated=%t",
+				originalRootDiagnosticPhaseNames[phase], bucket.count, bucket.successes,
+				bucket.count-bucket.successes, bucket.saturated)
+		}
+	})
+	marked := context.WithValue(ctx, originalRootDiagnosticObserverKey{}, observer)
+	// Reuse the existing actual verifier's terminal phase observation. Drop
+	// its Object entirely from the callback payload/log; only three compiled
+	// pending-table targets map to fixed numbered phase buckets.
+	return WithJointSchemaCataloguePhaseObserver(marked, func(value JointSchemaCataloguePhaseObservation) {
+		phase, tailPhase, tail, known := originalRootExactDiagnosticPhaseForTest(value)
+		if !known {
+			return
+		}
+		observeOriginalRootDiagnostic(marked, phase, !value.Failed)
+		if tail {
+			observeOriginalRootDiagnostic(marked, tailPhase, !value.Failed)
+		}
+	})
+}
+
+func TestOriginalRootDiagnosticCallbackCannotReplaceMigrationReturn(t *testing.T) {
+	businessErr := errors.New("fixed migration refusal")
+	observer := &originalRootDiagnosticObserver{observe: func(originalRootDiagnosticPhase, bool) { panic("diagnostic callback") }}
+	ctx := context.WithValue(context.Background(), originalRootDiagnosticObserverKey{}, observer)
+	actual := func() error {
+		observeOriginalRootDiagnostic(ctx, originalRootDiagnosticCatalogueCore125, false)
+		return businessErr
+	}
+	if actual() != businessErr {
+		t.Fatal("diagnostic callback replaced the actual migration result")
+	}
+}
+
+func TestOriginalRootDiagnosticDefaultOffAndBoundedConcurrentCounts(t *testing.T) {
+	t.Setenv(originalRootDiagnosticFlag, "")
+	base, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	if originalRootDiagnosticContextForTest(t, base) != base {
+		t.Fatal("default-off registration changed the actual context")
+	}
+	collector := &originalRootDiagnosticCollector{}
+	var workers sync.WaitGroup
+	for phase := originalRootDiagnosticPhase(0); phase < originalRootDiagnosticPhaseCount; phase++ {
+		workers.Add(1)
+		go func(phase originalRootDiagnosticPhase) {
+			defer workers.Done()
+			for i := 0; i < 100; i++ {
+				collector.record(phase, i%2 == 0)
+			}
+		}(phase)
+	}
+	workers.Wait()
+	for _, bucket := range collector.buckets {
+		if bucket.count != 100 || bucket.successes != 50 || bucket.saturated {
+			t.Fatal("fixed phase counts lost concurrent numeric observations")
+		}
+	}
+	collector.buckets[0] = originalRootDiagnosticBucket{count: originalRootDiagnosticMaxCount}
+	collector.record(0, true)
+	if collector.buckets[0].count != originalRootDiagnosticMaxCount || !collector.buckets[0].saturated {
+		t.Fatal("fixed phase count exceeded its bound")
+	}
+	before := collector.buckets
+	collector.sealed = true
+	collector.record(originalRootDiagnosticCatalogueCore125, false)
+	collector.record(originalRootDiagnosticPhaseCount, false)
+	if before != collector.buckets {
+		t.Fatal("sealed or invalid phase changed the bounded collector")
+	}
+	cancel()
+	if base.Err() != context.Canceled {
+		t.Fatal("diagnostic registration changed actual cancellation")
+	}
+}
+
+// The existing Object is a compiled catalogue identifier, never an actual row
+// or SQL value. It is consumed only for this constant mapping and never kept.
+func originalRootExactDiagnosticPhaseForTest(value JointSchemaCataloguePhaseObservation) (originalRootDiagnosticPhase, originalRootDiagnosticPhase, bool, bool) {
+	phase := originalRootDiagnosticPhaseCount
+	switch value.Phase {
+	case "table":
+		phase = originalRootDiagnosticExactTables
+	case "columns":
+		phase = originalRootDiagnosticExactColumns
+	case "functions":
+		phase = originalRootDiagnosticExactFunctions
+	case "trigger":
+		phase = originalRootDiagnosticExactTriggers
+	case "indexes":
+		phase = originalRootDiagnosticExactIndexes
+	default:
+		return 0, 0, false, false
+	}
+	if value.Phase != "table" {
+		return phase, 0, false, true
+	}
+	switch value.Object {
+	case "nextcloud_epoch_protocol_origins":
+		return phase, originalRootDiagnosticTailTableOne, true, true
+	case "nextcloud_epoch_observation_originals":
+		return phase, originalRootDiagnosticTailTableTwo, true, true
+	case "nextcloud_epoch_current_controls":
+		return phase, originalRootDiagnosticTailTableThree, true, true
+	default:
+		return phase, 0, false, true
+	}
+}
+
+func TestOriginalRootExactDiagnosticDropsObjectAndUsesOnlyFixedPhases(t *testing.T) {
+	for _, phase := range []string{"table", "columns", "functions", "trigger", "indexes"} {
+		a, _, tail, known := originalRootExactDiagnosticPhaseForTest(JointSchemaCataloguePhaseObservation{Phase: phase, Object: "arbitrary object/body/credential bytes", Failed: true})
+		b, _, emptyTail, emptyKnown := originalRootExactDiagnosticPhaseForTest(JointSchemaCataloguePhaseObservation{Phase: phase, Failed: false})
+		if !known || !emptyKnown || tail || emptyTail || a != b || a >= originalRootDiagnosticPhaseCount {
+			t.Fatal("dynamic object data changed a fixed diagnostic phase")
+		}
+	}
+	for i, name := range []string{"nextcloud_epoch_protocol_origins", "nextcloud_epoch_observation_originals", "nextcloud_epoch_current_controls"} {
+		phase, target, tail, known := originalRootExactDiagnosticPhaseForTest(JointSchemaCataloguePhaseObservation{Phase: "table", Object: name})
+		if !known || !tail || phase != originalRootDiagnosticExactTables || target != originalRootDiagnosticTailTableOne+originalRootDiagnosticPhase(i) {
+			t.Fatal("compiled target did not map to its fixed numbered phase")
+		}
+	}
+	if _, _, _, known := originalRootExactDiagnosticPhaseForTest(JointSchemaCataloguePhaseObservation{Phase: "arbitrary phase bytes", Object: "nextcloud_epoch_protocol_origins"}); known {
+		t.Fatal("unlisted verifier phase entered the fixed diagnostic inventory")
+	}
+}
diff --git a/internal/database/migration_original_root_driver.go b/internal/database/migration_original_root_driver.go
new file mode 100644
index 000000000..54286e139
--- /dev/null
+++ b/internal/database/migration_original_root_driver.go
@@ -0,0 +1,278 @@
+package database
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"errors"
+	"fmt"
+	"io"
+
+	"github.com/golang-migrate/migrate/v4"
+	migratedatabase "github.com/golang-migrate/migrate/v4/database"
+	postgresmigrate "github.com/golang-migrate/migrate/v4/database/postgres"
+	sqlite3migrate "github.com/golang-migrate/migrate/v4/database/sqlite3"
+)
+
+var ErrOriginalRootTailDowngrade = errors.New("original_root_tail_downgrade_closed")
+
+type originalRootTransactionBeginner interface {
+	BeginTx(context.Context, *sql.TxOptions) (*sql.Tx, error)
+}
+
+type originalRootMigrationDriver struct {
+	migratedatabase.Driver
+	ctx         context.Context
+	source      *jointOriginalRootSource
+	db          *sql.DB
+	actual      originalRootTransactionBeginner
+	version     uint
+	target      uint
+	locked, ran bool
+	sqliteUse   *originalRootSQLiteUse
+	releaseUse  func()
+}
+
+func (d *originalRootMigrationDriver) verify(version uint, dirty, create bool) (verifyErr error) {
+	if err := checkPeerSQLiteMigrationExclusion(d.ctx); err != nil {
+		return err
+	}
+	if err := d.source.recheck(d.ctx); err != nil {
+		return err
+	}
+	options := &sql.TxOptions{}
+	if d.source.dialect == "versioned" {
+		options.Isolation = sql.LevelSerializable
+	}
+	tx, err := d.actual.BeginTx(d.ctx, options)
+	if err != nil {
+		return ErrJointSchemaUnavailable
+	}
+	defer func() {
+		if closeErr := tx.Rollback(); closeErr != nil && closeErr != sql.ErrTxDone {
+			verifyErr = errors.Join(verifyErr, closeErr)
+		}
+	}()
+	got, gotDirty, err := originalRootLedger(d.ctx, tx)
+	if err != nil {
+		return err
+	}
+	ledger := version
+	if dirty {
+		ledger = d.target
+	}
+	if got != ledger || gotDirty != dirty {
+		return ErrJointSchemaUnknown
+	}
+	objects, _, err := peerPrefixObjectSets(d.ctx, tx, d.source.dialect)
+	if err != nil {
+		return err
+	}
+	checkpoint := objects[originalRootRouteTable]
+	if !checkpoint {
+		if !create || dirty || version != d.source.spec.OriginVersion {
+			return ErrJointSchemaUnknown
+		}
+		// An unrelated object with a compiled checkpoint name is not absence.
+		if objects["nextcloud_original_root_route_immutable_update"] || objects["nextcloud_original_root_route_immutable_delete"] || objects["nextcloud_original_root_route_immutable"] {
+			return ErrJointSchemaUnknown
+		}
+		if err = verifyOriginalRootCatalogueInTx(d.ctx, tx, d.source, version, false); err != nil {
+			return err
+		}
+		for _, statement := range d.source.spec.CheckpointStatements {
+			if _, err = tx.ExecContext(d.ctx, statement); err != nil {
+				return ErrJointSchemaUnavailable
+			}
+		}
+		query := "INSERT INTO " + originalRootRouteTable + "(id,dialect,origin_version,source_sha256,catalogue_sha256,checkpoint_sha256) VALUES(1,?,?,?,?,?)"
+		if d.source.dialect == "versioned" {
+			query = "INSERT INTO " + originalRootRouteTable + "(id,dialect,origin_version,source_sha256,catalogue_sha256,checkpoint_sha256) VALUES(1,$1,$2,$3,$4,$5)"
+		}
+		result, err := tx.ExecContext(d.ctx, query, d.source.dialect, d.source.spec.OriginVersion, d.source.digest, d.source.originCatalogueDigest, d.source.spec.CheckpointSHA256)
+		if err != nil {
+			return ErrJointSchemaUnavailable
+		}
+		count, err := result.RowsAffected()
+		if err != nil || count != 1 {
+			return ErrJointSchemaUnknown
+		}
+	}
+	if err = verifyOriginalRootCatalogueInTx(d.ctx, tx, d.source, version, true); err != nil {
+		return err
+	}
+	if err = checkPeerSQLiteMigrationExclusion(d.ctx); err != nil {
+		return err
+	}
+	if err = tx.Commit(); err != nil {
+		return ErrJointSchemaUnavailable
+	}
+	return nil
+}
+
+func (d *originalRootMigrationDriver) Lock() error {
+	return d.write("tail_before_lock", d.lock)
+}
+func (d *originalRootMigrationDriver) lock() error {
+	if err := d.Driver.Lock(); err != nil {
+		return err
+	}
+	if err := d.verify(d.version, false, true); err != nil {
+		return errors.Join(err, d.Driver.Unlock())
+	}
+	d.locked = true
+	return nil
+}
+func (d *originalRootMigrationDriver) Unlock() error {
+	d.locked = false
+	return d.Driver.Unlock()
+}
+func (d *originalRootMigrationDriver) SetVersion(version int, dirty bool) error {
+	return d.write("tail_before_set_version", func() error { return d.setVersion(version, dirty) })
+}
+func (d *originalRootMigrationDriver) setVersion(version int, dirty bool) error {
+	if !d.locked || version < 0 {
+		return ErrOriginalRootTailDowngrade
+	}
+	if dirty {
+		next := uint(0)
+		for _, module := range d.source.pending.modules {
+			if module.Version > d.version {
+				next = module.Version
+				break
+			}
+		}
+		if uint(version) != next || next == 0 || d.target != 0 {
+			return ErrOriginalRootTailDowngrade
+		}
+		if err := d.verify(d.version, false, false); err != nil {
+			return err
+		}
+		if err := d.Driver.SetVersion(version, true); err != nil {
+			return err
+		}
+		d.target, d.ran = uint(version), false
+		return nil
+	}
+	if uint(version) != d.target || !d.ran {
+		return ErrJointSchemaUnknown
+	}
+	// The new real schema must match before marking that actual version clean.
+	if err := d.verify(d.target, true, false); err != nil {
+		return err
+	}
+	if err := d.Driver.SetVersion(version, false); err != nil {
+		return err
+	}
+	d.version, d.target, d.ran = uint(version), 0, false
+	return nil
+}
+func (d *originalRootMigrationDriver) Run(reader io.Reader) error {
+	return d.write("tail_before_run", func() error { return d.run(reader) })
+}
+func (d *originalRootMigrationDriver) run(reader io.Reader) error {
+	if !d.locked || d.target == 0 || d.ran {
+		return ErrJointSchemaUnknown
+	}
+	raw, err := io.ReadAll(io.LimitReader(reader, (1<<20)+1))
+	if err != nil || len(raw) > 1<<20 {
+		return ErrJointSchemaSourceIdentity
+	}
+	wanted := ""
+	for _, module := range d.source.pending.modules {
+		if module.Version == d.target {
+			wanted = module.UpSHA256
+		}
+	}
+	if wanted == "" || fmt.Sprintf("%x", sha256.Sum256(raw)) != wanted {
+		return ErrJointSchemaSourceIdentity
+	}
+	if err = d.verify(d.version, true, false); err != nil {
+		return err
+	}
+	// Keep each pinned driver's real SQL transaction/dirty semantics intact.
+	if err = d.Driver.Run(bytes.NewReader(raw)); err != nil {
+		return err
+	}
+	d.ran = true
+	return nil
+}
+func (d *originalRootMigrationDriver) write(phase string, run func() error) error {
+	if d.sqliteUse != nil {
+		return d.sqliteUse.write(d.ctx, phase, run)
+	}
+	return run()
+}
+func (d *originalRootMigrationDriver) Close() error {
+	err := errors.Join(d.Driver.Close(), d.db.Close())
+	if d.releaseUse != nil {
+		d.releaseUse()
+	}
+	return err
+}
+
+func newOriginalRootMigrate(ctx context.Context, dsn string, opts MigrationOptions, source *jointOriginalRootSource, version uint) (*migrate.Migrate, error) {
+	opts.jointReadOnly = false
+	dialect := jointLineageDialect(dsn, opts)
+	var pool *sql.DB
+	var use *originalRootSQLiteUse
+	var releaseUse func()
+	var err error
+	if dialect == "sqlite" {
+		use, err = originalRootSQLiteUseFromContext(ctx)
+		if err != nil {
+			ctx, use, err = pinOriginalRootSQLiteUse(ctx)
+			if err != nil {
+				return nil, err
+			}
+			releaseUse = use.release
+		}
+		pool, err = originalRootSQLiteWriterPool(ctx, use)
+	} else {
+		pool, _, err = openJointLineageDB(dsn, opts)
+	}
+	if err != nil {
+		if releaseUse != nil {
+			releaseUse()
+		}
+		return nil, err
+	}
+	var driver migratedatabase.Driver
+	var actual originalRootTransactionBeginner = pool
+	name := "sqlite3"
+	if dialect == "sqlite" {
+		err = use.write(ctx, "tail_before_initialization", func() error {
+			if err := source.recheck(ctx); err != nil {
+				return err
+			}
+			var err error
+			driver, err = sqlite3migrate.WithInstance(pool, &sqlite3migrate.Config{})
+			return err
+		})
+	} else {
+		name = "postgres"
+		var conn *sql.Conn
+		conn, err = pool.Conn(ctx)
+		if err == nil {
+			actual = conn
+			driver, err = postgresmigrate.WithConnection(ctx, conn, &postgresmigrate.Config{})
+			if err != nil {
+				err = errors.Join(err, conn.Close())
+			}
+		}
+	}
+	if err != nil {
+		closeErr := pool.Close()
+		if releaseUse != nil {
+			releaseUse()
+		}
+		return nil, errors.Join(ErrJointSchemaUnavailable, closeErr)
+	}
+	guarded := &originalRootMigrationDriver{Driver: driver, ctx: ctx, source: source, db: pool, actual: actual, version: version, sqliteUse: use, releaseUse: releaseUse}
+	m, err := migrate.NewWithDatabaseInstance("file://"+source.root+"/"+source.spec.Directory, name, guarded)
+	if err != nil {
+		return nil, errors.Join(ErrJointSchemaSourceIdentity, guarded.Close())
+	}
+	return m, nil
+}
diff --git a/internal/database/migration_original_root_source.go b/internal/database/migration_original_root_source.go
new file mode 100644
index 000000000..0f560351c
--- /dev/null
+++ b/internal/database/migration_original_root_source.go
@@ -0,0 +1,211 @@
+package database
+
+import (
+	"context"
+	"crypto/sha256"
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+)
+
+//go:embed migration_original_root_sources.json
+var jointOriginalRootSourceJSON []byte
+
+type jointOriginalRootSourceFile struct {
+	Path, OriginalPath, SHA256, Direction string
+	Version                               uint
+}
+type jointOriginalRootCanonicalFile struct{ Path, SHA256 string }
+type jointOriginalRootSourceSpec struct {
+	OriginVersion, FinalVersion                 uint
+	Directory, CheckpointPath, CheckpointSHA256 string
+	Files                                       []jointOriginalRootSourceFile
+	CanonicalFiles                              []jointOriginalRootCanonicalFile
+	CheckpointStatements                        []string
+}
+type jointOriginalRootSourceManifest struct {
+	Format, Activation, PeerAppend, PG169 string
+	Routes                                map[string]jointOriginalRootSourceSpec
+}
+type jointOriginalRootSource struct {
+	root, dialect, digest, originCatalogueDigest string
+	spec                                         jointOriginalRootSourceSpec
+	pending                                      *jointOriginalPendingTailSourceAdmission
+	checkpoint                                   jointCatalogueModule
+}
+
+// This independently named source contains the authentic last Root version
+// plus unchanged pending payloads. It cannot bootstrap from an arbitrary
+// ledger: only the explicit entry first establishes the genuine old Root.
+func admitJointOriginalRootSource(ctx context.Context, root, dialect string) (*jointOriginalRootSource, error) {
+	pending, err := admitJointOriginalPendingTailSources(ctx, root, dialect)
+	if err != nil {
+		return nil, err
+	}
+	var manifest jointOriginalRootSourceManifest
+	if json.Unmarshal(jointOriginalRootSourceJSON, &manifest) != nil || manifest.Format != "joint-original-root-route-v1" || manifest.Activation != "explicit_root_only_entry" || manifest.PeerAppend != "refused_no_common_append_contract" || manifest.PG169 != "pending_not_executed_or_implied" || len(manifest.Routes) != 2 {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	spec, ok := manifest.Routes[dialect]
+	origin, final := uint(87), uint(93)
+	if dialect == "versioned" {
+		origin, final = 168, 172
+	}
+	if !ok || spec.OriginVersion != origin || spec.FinalVersion != final || spec.Directory != "migrations/original-root/"+dialect || spec.CheckpointPath != "migrations/original-root/checkpoint/"+dialect+".sql" || len(spec.Files) != 2+len(pending.modules)*2 || len(spec.CanonicalFiles) == 0 {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	knownCanonical := map[string]bool{}
+	for _, file := range spec.CanonicalFiles {
+		if filepath.Dir(file.Path) != "migrations/"+dialect || !strings.HasSuffix(file.Path, ".sql") || knownCanonical[file.Path] {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		if _, err = originalPendingTailFile(root, file.Path, file.SHA256); err != nil {
+			return nil, err
+		}
+		knownCanonical[file.Path] = true
+	}
+	entries, err := os.ReadDir(filepath.Join(root, "migrations", dialect))
+	if err != nil {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	for _, entry := range entries {
+		if strings.HasSuffix(entry.Name(), ".sql") && !knownCanonical["migrations/"+dialect+"/"+entry.Name()] {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+	}
+	if len(entries) != len(knownCanonical) {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	files := map[string]bool{}
+	for _, file := range spec.Files {
+		if filepath.Dir(file.Path) != spec.Directory || file.Path != spec.Directory+"/"+filepath.Base(file.OriginalPath) || files[file.Path] || (file.Direction != "up" && file.Direction != "down") || !strings.HasSuffix(file.Path, "."+file.Direction+".sql") {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		matches := 0
+		if file.Version == origin && knownCanonical[file.OriginalPath] {
+			for _, old := range spec.CanonicalFiles {
+				if old.Path == file.OriginalPath && old.SHA256 == file.SHA256 {
+					matches++
+				}
+			}
+		} else {
+			for _, module := range pending.modules {
+				if file.Version == module.Version && ((file.Direction == "up" && file.OriginalPath == module.UpPath && file.SHA256 == module.UpSHA256) || (file.Direction == "down" && file.OriginalPath == module.DownPath && file.SHA256 == module.DownSHA256)) {
+					matches++
+				}
+			}
+		}
+		if matches != 1 {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		copied, err := originalPendingTailFile(root, file.Path, file.SHA256)
+		if err != nil {
+			return nil, err
+		}
+		original, err := originalPendingTailFile(root, file.OriginalPath, file.SHA256)
+		if err != nil || string(copied) != string(original) {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+		files[file.Path] = true
+	}
+	entries, err = os.ReadDir(filepath.Join(root, spec.Directory))
+	if err != nil || len(entries) != len(files) {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || !files[spec.Directory+"/"+entry.Name()] {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+	}
+	checkpointFiles, err := os.ReadDir(filepath.Join(root, "migrations/original-root/checkpoint"))
+	if err != nil || len(checkpointFiles) != 2 {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	for _, file := range checkpointFiles {
+		if file.IsDir() || (file.Name() != "sqlite.sql" && file.Name() != "versioned.sql") {
+			return nil, ErrJointSchemaSourceIdentity
+		}
+	}
+	raw, err := originalPendingTailFile(root, spec.CheckpointPath, spec.CheckpointSHA256)
+	if err != nil {
+		return nil, err
+	}
+	statements, err := jointOriginalPendingTailStatements(string(raw))
+	if err != nil || !reflect.DeepEqual(statements, spec.CheckpointStatements) {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	checkpoint, effects, err := projectJointOriginalPendingTailModule(jointOriginalPendingTailModule{}, statements)
+	if err != nil || len(effects) != 0 || len(checkpoint.Tables) != 1 || checkpoint.Tables["nextcloud_original_root_route_origin"] == "" {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	expected, err := jointExpectedCatalogue(dialect, origin)
+	if err != nil {
+		return nil, err
+	}
+	rawExpected, err := json.Marshal(expected)
+	if err != nil {
+		return nil, ErrJointSchemaSourceIdentity
+	}
+	out := &jointOriginalRootSource{root: root, dialect: dialect, digest: fmt.Sprintf("%x", sha256.Sum256(jointOriginalRootSourceJSON)), originCatalogueDigest: fmt.Sprintf("%x", sha256.Sum256(rawExpected)), spec: spec, pending: pending, checkpoint: checkpoint}
+	return out, ctx.Err()
+}
+func (s *jointOriginalRootSource) recheck(ctx context.Context) error {
+	if s == nil {
+		return ErrJointSchemaSourceIdentity
+	}
+	current, err := admitJointOriginalRootSource(ctx, s.root, s.dialect)
+	if err != nil {
+		return err
+	}
+	if current.digest != s.digest || current.originCatalogueDigest != s.originCatalogueDigest || !reflect.DeepEqual(current.spec, s.spec) {
+		return ErrJointSchemaSourceIdentity
+	}
+	return ctx.Err()
+}
+func (s *jointOriginalRootSource) knownVersion(version uint) bool {
+	if s == nil {
+		return false
+	}
+	if version == s.spec.OriginVersion {
+		return true
+	}
+	for _, module := range s.pending.modules {
+		if version == module.Version {
+			return true
+		}
+	}
+	return false
+}
+func (s *jointOriginalRootSource) expected(version uint, checkpoint bool) (jointCatalogueExpected, error) {
+	if !s.knownVersion(version) {
+		return jointCatalogueExpected{}, ErrJointSchemaUnknown
+	}
+	expected, err := jointExpectedCatalogue(s.dialect, s.spec.OriginVersion)
+	if err != nil {
+		return expected, err
+	}
+	// Exact descriptors supplement the old 35, never replace their identities.
+	for table, descriptor := range s.pending.descriptors {
+		expected.BodyDescriptors[table] = descriptor
+	}
+	if len(expected.BodyDescriptors) != 42 {
+		return expected, ErrJointSchemaSourceIdentity
+	}
+	for _, module := range s.pending.modules {
+		if module.Version <= version {
+			if err = applyJointPeerForwardModule(expected, module.Catalogue); err != nil {
+				return expected, err
+			}
+		}
+	}
+	if checkpoint {
+		if err = applyJointPeerForwardModule(expected, s.checkpoint); err != nil {
+			return expected, err
+		}
+	}
+	return expected, nil
+}
diff --git a/internal/database/migration_original_root_source_test.go b/internal/database/migration_original_root_source_test.go
new file mode 100644
index 000000000..1cff71120
--- /dev/null
+++ b/internal/database/migration_original_root_source_test.go
@@ -0,0 +1,90 @@
+package database
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func originalRootSourceFixture(t *testing.T, dialect, actual string) string {
+	t.Helper()
+	root, _ := originalPendingTailSourceFixture(t, dialect)
+	var manifest jointOriginalRootSourceManifest
+	require.NoError(t, json.Unmarshal(jointOriginalRootSourceJSON, &manifest))
+	spec := manifest.Routes[dialect]
+	copyFile := func(name string) {
+		data, err := os.ReadFile(filepath.Join(actual, name))
+		require.NoError(t, err)
+		path := filepath.Join(root, name)
+		require.NoError(t, os.MkdirAll(filepath.Dir(path), 0700))
+		require.NoError(t, os.WriteFile(path, data, 0600))
+	}
+	for _, file := range spec.CanonicalFiles {
+		copyFile(file.Path)
+	}
+	for _, file := range spec.Files {
+		copyFile(file.Path)
+	}
+	copyFile("migrations/original-root/checkpoint/sqlite.sql")
+	copyFile("migrations/original-root/checkpoint/versioned.sql")
+	return root
+}
+func TestOriginalRootTailSourceQualification(t *testing.T) {
+	for _, dialect := range []string{"sqlite", "versioned"} {
+		t.Run(dialect, func(t *testing.T) {
+			for _, mode := range []string{"exact_copied_route_and_42_descriptors", "historical_down_changed", "copied_up_changed", "extra_route_file", "checkpoint_changed", "cancelled"} {
+				t.Run(mode, func(t *testing.T) {
+					root := originalRootSourceFixture(t, dialect, sqliteRepoRoot(t))
+					var manifest jointOriginalRootSourceManifest
+					require.NoError(t, json.Unmarshal(jointOriginalRootSourceJSON, &manifest))
+					spec := manifest.Routes[dialect]
+					change := func(name string) {
+						path := filepath.Join(root, name)
+						data, err := os.ReadFile(path)
+						require.NoError(t, err)
+						require.NoError(t, os.WriteFile(path, append(data, []byte("\n-- actual source mutation\n")...), 0600))
+					}
+					ctx, cancel := context.WithCancel(context.Background())
+					defer cancel()
+					switch mode {
+					case "historical_down_changed":
+						for _, file := range spec.CanonicalFiles {
+							if filepath.Ext(file.Path) == ".sql" && len(file.Path) > 9 && file.Path[len(file.Path)-9:] == ".down.sql" {
+								change(file.Path)
+								break
+							}
+						}
+					case "copied_up_changed":
+						change(spec.Files[len(spec.Files)-2].Path)
+					case "extra_route_file":
+						require.NoError(t, os.WriteFile(filepath.Join(root, spec.Directory, "000999_unknown.up.sql"), []byte("SELECT 1;"), 0600))
+					case "checkpoint_changed":
+						change(spec.CheckpointPath)
+					case "cancelled":
+						cancel()
+					}
+					source, err := admitJointOriginalRootSource(ctx, root, dialect)
+					if mode != "exact_copied_route_and_42_descriptors" {
+						require.Error(t, err)
+						require.Nil(t, source)
+						return
+					}
+					require.NoError(t, err)
+					expected, err := source.expected(spec.FinalVersion, true)
+					require.NoError(t, err)
+					require.Len(t, expected.BodyDescriptors, 42)
+					require.NotEmpty(t, expected.Tables[originalRootRouteTable])
+					require.NoError(t, source.recheck(ctx))
+					require.False(t, source.knownVersion(92), "absence92 has no adopted root payload")
+					if dialect == "versioned" {
+						require.False(t, source.knownVersion(169), "172 never implies execution of169")
+					}
+				})
+			}
+		})
+	}
+}
