+	for _, p := range hold.Manifest.Inputs {
+		if p.ObjectKind == "memory_item" && p.ObjectID == fact.ItemID && p.PublicationID == fact.ItemPublicationID {
+			itemKnown = true
+		}
+		if p.ObjectKind == "memory_topic" && p.PublicationID == fact.TopicPublicationID {
+			topicKnown = true
+		}
+	}
+	if !itemKnown || !topicKnown {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	scope := memoryScope(fact.TenantID, fact.SubjectID)
+	if !afterVectorWrite {
+		control, err := memoryEmbeddingControlInTx(tx, scope, fact.ItemID, "SHARE")
+		if err != nil {
+			return err
+		}
+		if control.Revision != fact.BaseVectorRevision || control.Present != fact.BaseVectorPresent {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	head, err := checkMemoryEmbeddingBodyReceiptInTx(tx, "memory_embedding_originals", fact.ID, fact.TenantID, fact.InputSHA256, fact.Digest)
+	if err != nil || head != read.head {
+		return ErrOriginalBodyUnavailable
+	}
+	return read.repo.checkMemoryGeneratedFinalClockInTx(tx, read.clock, hold)
+}
+
+func (read *memoryEmbeddingRead) Snapshot() (*types.MemoryEmbeddingInputSnapshot, error) {
+	if err := read.startCheck(); err != nil {
+		return nil, err
+	}
+	var snapshot *types.MemoryEmbeddingInputSnapshot
+	err := read.repo.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := read.checkInTx(tx, false); err != nil {
+			return err
+		}
+		var body struct{ InputJSON string }
+		if err := tx.Session(&gorm.Session{NewDB: true}).Table("memory_embedding_originals").Select("input_json").Where("id=?", read.original.ID).Take(&body).Error; err != nil {
+			return err
+		}
+		var input struct {
+			Text               string
+			ItemPublicationID  string
+			TopicPublicationID string
+		}
+		if bodySHA([]byte(body.InputJSON)) != read.original.InputSHA256 || json.Unmarshal([]byte(body.InputJSON), &input) != nil || input.Text == "" || input.ItemPublicationID != read.original.ItemPublicationID || input.TopicPublicationID != read.original.TopicPublicationID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		snapshot = &types.MemoryEmbeddingInputSnapshot{OriginalID: read.original.ID, OriginalDigest: read.original.Digest, ItemID: read.original.ItemID, ModelID: read.original.ModelID, Text: input.Text, SpaceDigest: read.original.SpaceDigest, ExpectedDimensions: read.original.ExpectedDimensions}
+		hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		return read.repo.checkMemoryGeneratedFinalClockInTx(tx, read.clock, hold)
+	}, memoryWriteOptions(read.repo.db))
+	if err = read.finishCheck(err); err != nil {
+		return nil, err
+	}
+	return snapshot, nil
+}
+func (read *memoryEmbeddingRead) Recheck() error {
+	if err := read.startCheck(); err != nil {
+		return err
+	}
+	err := read.repo.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error { return read.checkInTx(tx, false) }, memoryWriteOptions(read.repo.db))
+	return read.finishCheck(err)
+}
+func (read *memoryEmbeddingRead) Close() error {
+	read.mu.Lock()
+	if read.closed {
+		joined := read.closeJoined
+		read.mu.Unlock()
+		<-joined
+		read.mu.Lock()
+		err := read.failed
+		read.mu.Unlock()
+		return err
+	}
+	read.closed = true
+	read.cancel()
+	read.mu.Unlock()
+	read.checks.Wait()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(read.ctx), 5*time.Second)
+	defer cancel()
+	var first error
+	if read.clock.Lease.LeaseID != "" {
+		first = NewOriginalBodyRetentionStore(read.repo.db).ReleaseLease(cleanup, read.clock.Lease.LeaseID)
+	}
+	for _, close := range []func() error{func() error {
+		if read.model != nil {
+			return read.model.Close()
+		}
+		return nil
+	}, func() error {
+		if read.policy != nil {
+			return read.policy.Close()
+		}
+		return nil
+	}, func() error {
+		if read.derived != nil {
+			return read.derived.Close()
+		}
+		return nil
+	}} {
+		if err := close(); err != nil && first == nil {
+			first = err
+		}
+	}
+	read.mu.Lock()
+	if read.failed == nil {
+		read.failed = first
+	}
+	close(read.closeJoined)
+	err := read.failed
+	read.mu.Unlock()
+	return err
+}
