+func memoryScope(tenant uint64, subject string) interfaces.MemoryScope {
+	return interfaces.MemoryScope{TenantID: tenant, SubjectID: subject}
+}
+
+func (r *memoryOriginalAdmissionRepository) CommitMemoryEmbedding(ctx context.Context, result types.MemoryEmbeddingResult) (*types.MemoryEmbeddingReceipt, error) {
+	read, _ := ctx.Value(memoryEmbeddingReadKey{}).(*memoryEmbeddingRead)
+	if read == nil || read.repo != r || read.original == nil || read.original.ID != result.OriginalID || read.original.Digest != result.OriginalDigest || len(result.Vector) != read.original.ExpectedDimensions {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	for _, v := range result.Vector {
+		if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+	}
+	if err := read.startCheck(); err != nil {
+		return nil, err
+	}
+	var receipt *types.MemoryEmbeddingReceipt
