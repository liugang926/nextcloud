+func runMemoryEmbeddingEntryActual(t *testing.T, pg bool) {
+	for _, mode := range []string{"remember", "update", "vector_disabled", "no_model_id", "nil_model_service", "provider_error"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, models, _, _ := actualOriginalModelServices(t, f)
+			var logs bytes.Buffer
+			log := logrus.New()
+			log.SetOutput(&logs)
+			log.SetLevel(logrus.DebugLevel)
+			ctx := context.WithValue(f.ctx, types.LoggerContextKey, logrus.NewEntry(log))
+			calls := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error("entry provider request read failed")
+					return
+				}
+				calls++
+				if !bytes.Contains(body, []byte("original entry statement")) {
+					t.Error("entry did not submit exact authored memory")
+				}
+				if mode == "provider_error" {
+					w.WriteHeader(http.StatusBadRequest)
+					_, _ = io.WriteString(w, "PRIVATE_ENTRY_PROVIDER_ERROR")
+					return
+				}
+				vector := []float32{1, 0}
+				if calls == 2 {
+					vector = []float32{0, 1}
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(map[string]interface{}{"data": []interface{}{map[string]interface{}{"index": 0, "embedding": vector}}})
+			}))
+			t.Cleanup(server.Close)
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			model := &types.Model{ID: "actual-memory-entry-embedding", TenantID: 7, Name: "actual entry embedding", Type: types.ModelTypeEmbedding, Source: types.ModelSourceRemote, Parameters: types.ModelParameters{Provider: "openai", BaseURL: server.URL, APIKey: "fixture-entry-key", EmbeddingParameters: types.EmbeddingParameters{Dimension: 2, SupportsDimensionOverride: true}}}
+			require.NoError(t, models.CreateModel(f.ctx, model))
+			tenant := repository.NewTenantRepository(f.db)
+			ConfigureTenantMemoryPolicyAuthority(tenant, f.machine.f.store, NewGroupAccessService(repository.NewGroupAccessRepository(f.db)), nil)
+			cfg := types.MemoryConfig{Enabled: true, WriteMode: types.MemoryWriteAuto, ExtractModelID: f.model.GetModelID(), EmbeddingModelID: model.ID}
+			if mode == "vector_disabled" {
+				disabled := false
+				cfg.VectorRecall = &disabled
+			}
+			if mode == "no_model_id" {
+				cfg.EmbeddingModelID = ""
+			}
+			_, _, err := tenant.(interfaces.MemoryPolicyOriginalWriter).ReplaceMemoryPolicyOriginal(f.ctx, 7, cfg)
+			require.NoError(t, err)
+			actualModels := models
+			if mode == "nil_model_service" {
+				actualModels = nil
+			}
+			f.service = memoryservice.NewOriginalBoundMemoryService(f.repo, tenant, repository.NewMessageRepository(f.db), actualModels, f.queue, nil, f.reader, f.admissions)
+			memoryservice.ConfigureOriginalMemoryOutbox(f.service, f.outbox)
+			item, err := f.service.Remember(ctx, types.MemoryItem{Origin: types.MemoryOriginManual, Kind: types.MemoryKindFact, Topic: "entry flow", Content: "original entry statement", Importance: 4})
+			require.NoError(t, err, "embedding failure cannot turn a committed memory write into a failure")
+			require.NotNil(t, item)
+			if mode == "update" {
+				item, err = f.service.UpdateItem(ctx, item.ID, "original entry statement updated", 4)
+				require.NoError(t, err)
+			}
+			var vectors, receipts int64
+			require.NoError(t, f.db.Model(&types.MemoryItemEmbedding{}).Where("item_id=?", item.ID).Count(&vectors).Error)
+			require.NoError(t, f.db.Model(&types.MemoryEmbeddingReceipt{}).Where("item_id=?", item.ID).Count(&receipts).Error)
+			switch mode {
+			case "remember":
+				require.Equal(t, 1, calls)
+				require.EqualValues(t, 1, vectors)
+				require.EqualValues(t, 1, receipts)
+			case "update":
+				require.Equal(t, 2, calls)
+				require.EqualValues(t, 1, vectors)
+				require.EqualValues(t, 2, receipts)
+				var row types.MemoryItemEmbedding
+				require.NoError(t, f.db.Where("item_id=?", item.ID).Take(&row).Error)
+				require.Equal(t, []float32{0, 1}, types.DecodeEmbedding(row.Vector))
+			case "provider_error":
+				require.Equal(t, 1, calls)
+				require.Zero(t, vectors)
+				require.Zero(t, receipts)
+				require.NotContains(t, logs.String(), "PRIVATE_ENTRY_PROVIDER_ERROR")
+				require.Contains(t, logs.String(), "original-bound embedding refused")
+			default:
+				require.Zero(t, calls)
+				require.Zero(t, vectors)
+				require.Zero(t, receipts)
+			}
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryEmbeddingEntryActualSQLiteHTTP(t *testing.T)   { runMemoryEmbeddingEntryActual(t, false) }
+func TestPostgresMemoryEmbeddingEntryActualHTTP(t *testing.T) { runMemoryEmbeddingEntryActual(t, true) }
