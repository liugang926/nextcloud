+	if err != nil {
+		return err
+	}
+	if err = authority.CheckRuntime(fresh); err != nil {
+		return err
+	}
+	if err = lockMemoryPolicyAuthor(tx, fresh, fact.TenantID); err != nil {
+		return err
+	}
