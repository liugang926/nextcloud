+			return types.ErrMemoryOriginalUnavailable
+		}
+		rankPresent, rankDigest := false, ""
+		if tx.Dialector.Name() == "postgres" && tx.Migrator().HasColumn(&types.MemoryItemEmbedding{}, "embedding") {
+			var rank struct{ Value *string }
+			if err = tx.Session(&gorm.Session{NewDB: true}).Raw("SELECT CAST(embedding AS TEXT) AS value FROM memory_item_embeddings WHERE item_id=?", row.ItemID).Scan(&rank).Error; err != nil {
+				return err
+			}
+			if rank.Value == nil {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			rankPresent = true
+			rankDigest = bodySHA([]byte(*rank.Value))
+		}
+		body, err := json.Marshal(result.Vector)
+		if err != nil {
+			return err
+		}
+		receipt = &types.MemoryEmbeddingReceipt{ID: uuid.NewString(), OriginalID: read.original.ID, OriginalDigest: read.original.Digest, TenantID: scope.TenantID, SubjectID: scope.SubjectID, ItemID: row.ItemID, ModelID: row.ModelID, SpaceDigest: read.original.SpaceDigest, Dimensions: row.Dims, VectorRevision: actualControl.Revision, VectorDigest: bodySHA(vector), RankVectorPresent: rankPresent, RankVectorDigest: rankDigest, VectorJSON: string(body), VectorJSONSHA256: bodySHA(body), CreatedAt: at}
+		receipt.Digest, err = memoryEmbeddingReceiptDigest(receipt)
+		if err != nil {
+			return err
+		}
+		producer := memoryEmbeddingProducerContext(ctx, "memory_embedding_receipts", receipt.ID, scope.TenantID, receipt.VectorJSONSHA256)
+		if err = tx.Session(&gorm.Session{NewDB: true}).WithContext(producer).Create(receipt).Error; err != nil {
+			return err
+		}
+		if err = createMemoryEmbeddingBodyReceiptInTx(tx, "memory_embedding_receipts", receipt.ID, scope.TenantID, receipt.VectorJSONSHA256, receipt.Digest); err != nil {
+			return err
+		}
+		if _, err = checkMemoryEmbeddingBodyReceiptInTx(tx, "memory_embedding_receipts", receipt.ID, scope.TenantID, receipt.VectorJSONSHA256, receipt.Digest); err != nil {
+			return err
+		}
+		return read.checkInTx(tx, true) // All result IO precedes this final union SQL clock.
+	}, memoryWriteOptions(r.db))
+	if err = read.finishCheck(err); err != nil {
+		return nil, err
+	}
+	copy := *receipt
+	copy.VectorJSON = ""
+	return &copy, nil
+}
