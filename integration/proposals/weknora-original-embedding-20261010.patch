+package embedding
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"math"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/logger"
+	"github.com/Tencent/WeKnora/internal/models/api"
+	"github.com/Tencent/WeKnora/internal/models/api/arkembeddings"
+	"github.com/Tencent/WeKnora/internal/models/api/dashscopeembeddings"
+	"github.com/Tencent/WeKnora/internal/models/api/googleembeddings"
+	"github.com/Tencent/WeKnora/internal/models/api/openaiembeddings"
+	"github.com/Tencent/WeKnora/internal/models/catalog"
+	"github.com/Tencent/WeKnora/internal/tracing/langfuse"
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+const (
+	OriginalOpenAIEmbeddingRecipe    = "embedding/openai/full-v1"
+	OriginalDashScopeEmbeddingRecipe = "embedding/dashscope/full-v1"
+	OriginalArkEmbeddingRecipe       = "embedding/ark/full-v1"
+	OriginalGoogleEmbeddingRecipe    = "embedding/google/full-v1"
+)
+
+func originalEmbeddingProtocolRecipe(protocol api.EmbeddingAPI) string {
+	switch protocol {
+	case api.EmbeddingOpenAI:
+		return OriginalOpenAIEmbeddingRecipe
+	case api.EmbeddingDashScope:
+		return OriginalDashScopeEmbeddingRecipe
+	case api.EmbeddingArk:
+		return OriginalArkEmbeddingRecipe
+	case api.EmbeddingGoogle:
+		return OriginalGoogleEmbeddingRecipe
+	default:
+		return ""
+	}
+}
+
+// This is called only by the real model definition producer. Resolve freezes
+// authored provider/entry/override settings and endpoint metadata into the new
+// immutable definition. No default key or deployment credential is consumed.
+func captureAuthoredNativeEmbedding(model *types.Model, provider string) (*types.ModelOriginalEmbeddingDefinition, error) {
+	if provider != "aliyun" && provider != "volcengine" && provider != "gemini" {
+		return nil, fmt.Errorf("complete original embedding provider recipe is required; tenant cloud credentials have no original source")
+	}
+	resolved, err := catalog.Resolve(catalog.Ref{Provider: provider, Model: model.Name, BaseURL: model.Parameters.BaseURL, ModelType: types.ModelTypeEmbedding, Extra: model.Parameters.ExtraConfig, Override: model.Parameters.Spec, TruncatePromptTokens: model.Parameters.EmbeddingParameters.TruncatePromptTokens})
+	if err != nil {
+		return nil, err
+	}
+	model.Parameters.BaseURL = resolved.BaseURL
+	settings := resolved.Embeddings
+	wire, err := json.Marshal(settings)
+	if err != nil {
+		return nil, err
+	}
+	retry := api.DefaultRetryPolicy()
+	recipe := &types.ModelOriginalEmbeddingDefinition{Version: 1, Recipe: originalEmbeddingProtocolRecipe(resolved.EmbeddingAPI), Provider: provider, API: string(resolved.EmbeddingAPI), BaseURL: resolved.BaseURL, RemoteModel: resolved.RemoteModel, Query: map[string]string{}, Headers: map[string]string{}, Settings: wire, ExpectedDimensions: model.Parameters.EmbeddingParameters.Dimension, RetryMaxRetries: retry.MaxRetries, RetryBaseDelayNanos: int64(retry.BaseDelay), RetryMaxDelayNanos: int64(retry.MaxDelay), RequiresAuth: resolved.Vendor.RequiresAuth}
+	switch resolved.Vendor.AuthStyleFor(resolved.Vendor.API) {
+	case catalog.AuthNone:
+		recipe.Auth = "none"
+	case catalog.AuthBearer:
+		recipe.Auth = "bearer"
+	case catalog.AuthAPIKeyHeader:
+		recipe.Auth = "api-key"
+	case catalog.AuthXAPIKey:
+		recipe.Auth = "x-api-key"
+	case catalog.AuthGoogleAPIKey:
+		recipe.Auth = "x-goog-api-key"
+	default:
+		return nil, fmt.Errorf("original embedding signer credentials have no supported original source")
+	}
+	if recipe.Auth != "none" {
+		recipe.RequiresAuth = true
+		if model.Parameters.APIKey == "" {
+			return nil, fmt.Errorf("explicit authored embedding credential is required; deployment keys are not original credentials")
+		}
+	}
+	for key, value := range resolved.Vendor.Headers {
+		recipe.Headers[key] = value
+	}
+	for key, value := range model.Parameters.CustomHeaders {
+		recipe.Headers[key] = value
+	}
+	if model.Parameters.EmbeddingParameters.SupportsDimensionOverride {
+		recipe.WireDimensions = recipe.ExpectedDimensions
+	}
+	if resolved.Vendor.Endpoint != nil {
+		recipe.URL, recipe.Query = resolved.Vendor.Endpoint(catalog.EndpointRequest{BaseURL: resolved.BaseURL, Model: resolved.RemoteModel, ModelType: types.ModelTypeEmbedding, API: resolved.Vendor.API, EmbeddingAPI: resolved.EmbeddingAPI, Extra: model.Parameters.ExtraConfig})
+	}
+	if resolved.EmbeddingAPI == api.EmbeddingGoogle && recipe.URL == "" {
+		root := strings.TrimSuffix(strings.TrimRight(recipe.BaseURL, "/"), "/openai")
+		recipe.URL = root + "/models/" + strings.TrimPrefix(recipe.RemoteModel, "models/") + ":batchEmbedContents"
+	}
+	recipe.SpaceDigest, err = types.ModelOriginalEmbeddingDigest(recipe)
+	if err != nil {
+		return nil, err
+	}
+	return recipe, nil
+}
+func NormalizeAuthoredEmbeddingDefinition(model *types.Model) error {
+	if model == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if model.Type != types.ModelTypeEmbedding || model.Source != types.ModelSourceRemote {
+		return nil
+	}
+	if model.Parameters.OriginalEmbedding == nil {
+		provider := strings.ToLower(strings.TrimSpace(model.Parameters.Provider))
+		if provider != "openai" && provider != "generic" {
+			recipe, err := captureAuthoredNativeEmbedding(model, provider)
+			if err != nil {
+				return err
+			}
+			model.Parameters.OriginalEmbedding = recipe
+		} else {
+			if model.Parameters.Spec != nil {
+				return fmt.Errorf("complete original embedding recipe is required for catalog overrides")
+			}
+			for key := range model.Parameters.ExtraConfig {
+				if key != "remote_model_name" {
+					return fmt.Errorf("complete original embedding recipe is required for provider extra config")
+				}
+			}
+			if model.Parameters.EmbeddingParameters.TruncatePromptTokens != 0 {
+				return fmt.Errorf("complete original embedding truncation settings are required")
+			}
+			settings := catalog.EmbeddingsSettings{API: api.EmbeddingOpenAI, Path: "/embeddings", SendEncodingFormat: true, DimensionsField: "dimensions", InputTypeValues: map[string]string{}, MaxBatchSize: 2048, RequestTimeout: 60, ExtraBody: map[string]any{}}
+			wire, err := json.Marshal(settings)
+			if err != nil {
+				return err
+			}
+			retry := api.DefaultRetryPolicy()
+			recipe := &types.ModelOriginalEmbeddingDefinition{Version: 1, Recipe: OriginalOpenAIEmbeddingRecipe, Provider: provider, API: string(api.EmbeddingOpenAI), BaseURL: strings.TrimRight(model.Parameters.BaseURL, "/"), RemoteModel: model.Name, Query: map[string]string{}, Headers: map[string]string{}, Auth: "none", Settings: wire, ExpectedDimensions: model.Parameters.EmbeddingParameters.Dimension, RetryMaxRetries: retry.MaxRetries, RetryBaseDelayNanos: int64(retry.BaseDelay), RetryMaxDelayNanos: int64(retry.MaxDelay)}
+			if remote := model.Parameters.ExtraConfig["remote_model_name"]; remote != "" {
+				recipe.RemoteModel = remote
+			}
+			for key, value := range model.Parameters.CustomHeaders {
+				recipe.Headers[key] = value
+			}
+			if model.Parameters.APIKey != "" {
+				recipe.Auth = "bearer"
+				recipe.RequiresAuth = true
+			}
+			if model.Parameters.EmbeddingParameters.SupportsDimensionOverride {
+				recipe.WireDimensions = recipe.ExpectedDimensions
+			}
+			recipe.SpaceDigest, err = types.ModelOriginalEmbeddingDigest(recipe)
+			if err != nil {
+				return err
+			}
+			model.Parameters.OriginalEmbedding = recipe
+		}
+	}
+	recipe := model.Parameters.OriginalEmbedding
+	if recipe.BaseURL != strings.TrimRight(model.Parameters.BaseURL, "/") || recipe.Provider != strings.ToLower(strings.TrimSpace(model.Parameters.Provider)) || recipe.ExpectedDimensions != model.Parameters.EmbeddingParameters.Dimension {
+		return fmt.Errorf("embedding fields differ from the complete original recipe")
+	}
+	expectedRemote := model.Name
+	if remote := model.Parameters.ExtraConfig["remote_model_name"]; remote != "" {
+		expectedRemote = remote
+	}
+	if recipe.RemoteModel != expectedRemote {
+		return fmt.Errorf("embedding model identity differs from the complete original recipe")
+	}
+	expectedWire := 0
+	if model.Parameters.EmbeddingParameters.SupportsDimensionOverride {
+		expectedWire = recipe.ExpectedDimensions
+	}
+	if recipe.WireDimensions != expectedWire {
+		return fmt.Errorf("embedding dimension decision differs from the complete original recipe")
+	}
+	return ValidateOriginalEmbeddingDefinition(recipe)
+}
+func originalEmbeddingSettings(recipe *types.ModelOriginalEmbeddingDefinition) (catalog.EmbeddingsSettings, error) {
+	var settings catalog.EmbeddingsSettings
+	var keys map[string]json.RawMessage
+	if recipe == nil || len(recipe.Settings) == 0 || json.Unmarshal(recipe.Settings, &keys) != nil || json.Unmarshal(recipe.Settings, &settings) != nil {
+		return settings, fmt.Errorf("complete original embedding settings are required")
+	}
+	canonical, err := json.Marshal(settings)
+	if err != nil {
+		return settings, err
+	}
+	var expected map[string]json.RawMessage
+	if json.Unmarshal(canonical, &expected) != nil || len(keys) != len(expected) {
+		return settings, fmt.Errorf("original embedding settings must include every field")
+	}
+	for key := range expected {
+		if _, ok := keys[key]; !ok {
+			return settings, fmt.Errorf("original embedding settings field is absent")
+		}
+	}
+	if !settings.API.Known() || string(settings.API) != recipe.API || settings.MaxBatchSize < 0 || settings.MaxInputChars < 0 || settings.RequestTimeout < 0 || settings.TruncatePromptTokens < 0 {
+		return settings, fmt.Errorf("invalid original embedding protocol limits")
+	}
+	if settings.InputTypeField != "" && (settings.InputTypeValues[string(api.EmbedDocument)] == "" || settings.InputTypeValues[string(api.EmbedQuery)] == "") {
+		return settings, fmt.Errorf("original embedding input types are incomplete")
+	}
+	if settings.API == api.EmbeddingArk && settings.MaxBatchSize != 1 {
+		return settings, fmt.Errorf("original Ark embeddings require exactly one text per request")
+	}
+	return settings, nil
+}
+func ValidateOriginalEmbeddingDefinition(recipe *types.ModelOriginalEmbeddingDefinition) error {
+	if recipe == nil || recipe.Version != 1 || originalEmbeddingProtocolRecipe(api.EmbeddingAPI(recipe.API)) == "" || recipe.Recipe != originalEmbeddingProtocolRecipe(api.EmbeddingAPI(recipe.API)) || recipe.Provider == "" || recipe.BaseURL == "" || recipe.RemoteModel == "" || recipe.ExpectedDimensions <= 0 || recipe.WireDimensions < 0 || recipe.WireDimensions != 0 && recipe.WireDimensions != recipe.ExpectedDimensions {
+		return fmt.Errorf("complete original embedding definition is unavailable")
+	}
+	if recipe.RetryMaxRetries < 0 || recipe.RetryBaseDelayNanos < 0 || recipe.RetryMaxDelayNanos < 0 {
+		return fmt.Errorf("invalid original embedding retry policy")
+	}
+	switch recipe.Auth {
+	case "none":
+		if recipe.RequiresAuth || recipe.SignerRecipe != "" {
+			return fmt.Errorf("invalid unauthenticated original embedding mode")
+		}
+	case "bearer", "api-key", "x-api-key", "x-goog-api-key":
+		if !recipe.RequiresAuth || recipe.SignerRecipe != "" {
+			return fmt.Errorf("invalid original embedding key authentication")
+		}
+	default:
+		return fmt.Errorf("unsupported original embedding authentication/signer; cloud credential source remains pending")
+	}
+	settings, err := originalEmbeddingSettings(recipe)
+	if err != nil {
+		return err
+	}
+	if recipe.WireDimensions > 0 && settings.DimensionsField == "" {
+		return fmt.Errorf("original embedding dimension override lacks a field")
+	}
+	digest, err := types.ModelOriginalEmbeddingDigest(recipe)
+	if err != nil || digest != recipe.SpaceDigest {
+		return fmt.Errorf("original embedding recipe digest changed")
+	}
+	return nil
+}
+
+// Uses the actual held model/credential snapshot. No Resolve, vendor default
+// key, environment credentials, tenant lookup or endpoint function is called.
+func NewOriginalRemoteEmbedder(model *types.Model, pooler EmbedderPooler) (Embedder, error) {
+	if model == nil || model.Type != types.ModelTypeEmbedding || model.Source != types.ModelSourceRemote {
+		return nil, fmt.Errorf("original remote embedding model is required")
+	}
+	recipe := model.Parameters.OriginalEmbedding
+	if err := ValidateOriginalEmbeddingDefinition(recipe); err != nil {
+		return nil, err
+	}
+	if err := validateEmbeddingBaseURL(recipe.BaseURL); err != nil {
+		return nil, err
+	}
+	if recipe.URL != "" {
+		if err := validateEmbeddingBaseURL(recipe.URL); err != nil {
+			return nil, err
+		}
+	}
+	var auth api.AuthFunc
+	if recipe.Auth == "none" {
+		auth = api.NoAuth()
+	} else {
+		if model.Parameters.APIKey == "" {
+			return nil, fmt.Errorf("original embedding credential is absent")
+		}
+		if recipe.Auth == "bearer" {
+			auth = api.BearerAuth(model.Parameters.APIKey)
+		} else {
+			auth = api.HeaderAuth(recipe.Auth, model.Parameters.APIKey)
+		}
+	}
+	settings, err := originalEmbeddingSettings(recipe)
+	if err != nil {
+		return nil, err
+	}
+	headers := map[string]string{}
+	for k, v := range recipe.Headers {
+		headers[k] = v
+	}
+	query := map[string]string{}
+	for k, v := range recipe.Query {
+		query[k] = v
+	}
+	endpoint := api.Endpoint{BaseURL: recipe.BaseURL, URL: recipe.URL, Query: query, Model: recipe.RemoteModel, ModelID: model.ID, Auth: auth, Headers: headers, Client: newEmbeddingHTTPClient(time.Duration(settings.RequestTimeout) * time.Second)}
+	retry := api.RetryPolicy{MaxRetries: recipe.RetryMaxRetries, BaseDelay: time.Duration(recipe.RetryBaseDelayNanos), MaxDelay: time.Duration(recipe.RetryMaxDelayNanos)}
+	var client api.Embedder
+	switch api.EmbeddingAPI(recipe.API) {
+	case api.EmbeddingOpenAI:
+		client = openaiembeddings.New(openaiembeddings.Config{Endpoint: endpoint, Settings: settings, Dimensions: recipe.WireDimensions, Retry: retry})
+	case api.EmbeddingDashScope:
+		client = dashscopeembeddings.New(dashscopeembeddings.Config{Endpoint: endpoint, Settings: settings, Dimensions: recipe.WireDimensions, Retry: retry})
+	case api.EmbeddingArk:
+		client = arkembeddings.New(arkembeddings.Config{Endpoint: endpoint, Settings: settings, Dimensions: recipe.WireDimensions, Retry: retry})
+	case api.EmbeddingGoogle:
+		client = googleembeddings.New(googleembeddings.Config{Endpoint: endpoint, Settings: settings, Dimensions: recipe.WireDimensions, Retry: retry})
+	default:
+		return nil, fmt.Errorf("unknown original embedding protocol")
+	}
+	var output Embedder = &protocolEmbedder{inner: client, settings: settings, modelName: recipe.RemoteModel, modelID: model.ID, dimensions: recipe.ExpectedDimensions, EmbedderPooler: pooler}
+	output = &originalDimensionEmbedder{inner: output, dimensions: recipe.ExpectedDimensions}
+	output = wrapEmbeddingConcurrency(output, model.Parameters.MaxConcurrency)
+	if logger.LLMDebugEnabled() {
+		output = &debugEmbedder{inner: output}
+	}
+	if langfuse.GetManager().Enabled() {
+		output = &langfuseEmbedder{inner: output}
+	}
+	return output, nil
+}
+
+type originalDimensionEmbedder struct {
+	inner      Embedder
+	dimensions int
+}
+
+func (w *originalDimensionEmbedder) GetModelName() string { return w.inner.GetModelName() }
+func (w *originalDimensionEmbedder) GetModelID() string   { return w.inner.GetModelID() }
+func (w *originalDimensionEmbedder) GetDimensions() int   { return w.dimensions }
+func (w *originalDimensionEmbedder) Embed(ctx context.Context, text string) ([]float32, error) {
+	vectors, err := w.BatchEmbed(ctx, []string{text})
+	if err != nil {
+		return nil, err
+	}
+	return vectors[0], nil
+}
+func (w *originalDimensionEmbedder) BatchEmbed(ctx context.Context, texts []string) ([][]float32, error) {
+	vectors, err := w.inner.BatchEmbed(ctx, texts)
+	if err != nil {
+		return nil, err
+	}
+	if len(vectors) != len(texts) {
+		return nil, fmt.Errorf("original embedding response count changed")
+	}
+	for _, vector := range vectors {
+		if len(vector) != w.dimensions {
+			return nil, fmt.Errorf("original embedding response dimension changed")
+		}
+		for _, value := range vector {
+			if math.IsNaN(float64(value)) || math.IsInf(float64(value), 0) {
+				return nil, fmt.Errorf("original embedding response is not finite")
+			}
+		}
+	}
+	return vectors, nil
+}
+func (w *originalDimensionEmbedder) BatchEmbedWithPool(ctx context.Context, model Embedder, texts []string) ([][]float32, error) {
+	return w.inner.BatchEmbedWithPool(ctx, w, texts)
+}
