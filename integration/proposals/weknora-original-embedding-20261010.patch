+package types
+
+import "encoding/json"
+
+// This is a complete authored provider recipe. Credentials remain solely in
+// the separate immutable credential receipt, never in catalog/tenant defaults.
+type ModelOriginalEmbeddingDefinition struct {
+	Version             int
+	Recipe              string
+	Provider            string
+	API                 string
+	BaseURL             string
+	URL                 string
+	Query               map[string]string
+	RemoteModel         string
+	Headers             map[string]string
+	Auth                string
+	RequiresAuth        bool
+	SignerRecipe        string
+	Settings            json.RawMessage
+	ExpectedDimensions  int
+	WireDimensions      int
+	RetryMaxRetries     int
+	RetryBaseDelayNanos int64
+	RetryMaxDelayNanos  int64
+	SpaceDigest         string
+}
+
+func ModelOriginalEmbeddingDigest(recipe *ModelOriginalEmbeddingDefinition) (string, error) {
+	if recipe == nil {
+		return "", ErrMemoryOriginalUnavailable
+	}
+	copy := *recipe
+	copy.SpaceDigest = ""
+	body, err := json.Marshal(copy)
+	if err != nil {
+		return "", err
+	}
+	return MemoryOriginalBytesDigest(body), nil
+}
