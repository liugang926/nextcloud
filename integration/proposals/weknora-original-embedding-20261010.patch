+	if err = policy.Session(&gorm.Session{NewDB: true}).Select("id,memory_config").Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", fact.TenantID).Take(&tenant).Error; err != nil {
+		return err
+	}
