+package service
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/models/embedding"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// The existing chat carrier's begin/Close/Recheck methods are protocol-neutral:
+// they only own read/cancel/watch/join state. No Chat or nil-inner metadata
+// method is called here, and the original chat/SSE source remains unchanged.
+type modelOriginalEmbeddingClient struct {
+	inner embedding.Embedder
+	life  *modelOriginalChatClient
+}
+
+func (w *modelOriginalEmbeddingClient) GetModelName() string   { return w.inner.GetModelName() }
+func (w *modelOriginalEmbeddingClient) GetModelID() string     { return w.inner.GetModelID() }
+func (w *modelOriginalEmbeddingClient) GetDimensions() int     { return w.inner.GetDimensions() }
+func (w *modelOriginalEmbeddingClient) RecheckOriginal() error { return w.life.RecheckOriginal() }
+func (w *modelOriginalEmbeddingClient) CloseOriginal() error   { return w.life.CloseOriginal() }
+func (w *modelOriginalEmbeddingClient) Embed(ctx context.Context, text string) (vector []float32, resultErr error) {
+	call, finish, _, err := w.life.begin(ctx)
+	if err != nil {
+		if w.life.autoClose {
+			_ = w.CloseOriginal()
+		}
+		return nil, err
+	}
+	defer func() {
+		finish()
+		if w.life.autoClose {
+			if err := w.CloseOriginal(); err != nil && resultErr == nil {
+				vector = nil
+				resultErr = err
+			}
+		}
+	}()
+	vector, err = w.inner.Embed(call, text)
+	if err != nil {
+		return nil, err
+	}
+	if err = w.life.read.Recheck(); err != nil {
+		return nil, err
+	}
+	return vector, nil
+}
+func (w *modelOriginalEmbeddingClient) BatchEmbed(ctx context.Context, texts []string) (vectors [][]float32, resultErr error) {
+	call, finish, _, err := w.life.begin(ctx)
+	if err != nil {
+		if w.life.autoClose {
+			_ = w.CloseOriginal()
+		}
+		return nil, err
+	}
+	defer func() {
+		finish()
+		if w.life.autoClose {
+			if err := w.CloseOriginal(); err != nil && resultErr == nil {
+				vectors = nil
+				resultErr = err
+			}
+		}
+	}()
+	vectors, err = w.inner.BatchEmbed(call, texts)
+	if err != nil {
+		return nil, err
+	}
+	if err = w.life.read.Recheck(); err != nil {
+		return nil, err
+	}
+	return vectors, nil
+}
+func (w *modelOriginalEmbeddingClient) BatchEmbedWithPool(ctx context.Context, model embedding.Embedder, texts []string) ([][]float32, error) {
+	// Ordered protocol batches remain inside one owned lifetime. The legacy
+	// pool submits background closures and can return before joining on submit
+	// failure; it cannot serve as this original's completion boundary.
+	return w.BatchEmbed(ctx, texts)
+}
+func bindOriginalEmbeddingClient(ctx context.Context, inner embedding.Embedder, read interfaces.ModelOriginalRead, owner bool) (embedding.Embedder, error) {
+	life := &modelOriginalChatClient{read: read, owner: owner, autoClose: owner, calls: map[uint64]context.CancelFunc{}, closeJoined: make(chan struct{}), closeSignal: make(chan struct{})}
+	wrapper := &modelOriginalEmbeddingClient{inner: inner, life: life}
+	if owner {
+		// Ordinary embedding calls own and close this reader on operation return.
+		// Output producers must explicitly open an outer actual ModelOriginalRead
+		// and construct under its Context; borrowed clients never close that hold.
+		// Do not attach ownership to the short-lived pipeline child/output slot.
+		context.AfterFunc(ctx, func() { _ = wrapper.CloseOriginal() })
+	}
+	return wrapper, nil
+}
+func (s *modelService) getOriginalEmbeddingModel(ctx context.Context, id string, tenant uint64) (embedding.Embedder, error) {
+	if id == "" || tenant == 0 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read, borrowed := repository.OriginalModelReadFromContext(ctx, id)
+	if !borrowed {
+		var err error
+		read, err = s.BeginModelOriginalRead(ctx, id, nil)
+		if err != nil {
+			return nil, err
+		}
+	}
+	closeOnFailure := !borrowed
+	defer func() {
+		if closeOnFailure {
+			_ = read.Close()
+		}
+	}()
+	model, proof, err := read.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	if model == nil || proof == nil || !proof.Valid() || proof.ModelID != id || model.Status != types.ModelStatusActive || model.Type != types.ModelTypeEmbedding || model.TenantID != tenant && !model.IsBuiltin {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	provider, err := embedding.NewOriginalRemoteEmbedder(model, s.pooler)
+	if err != nil {
+		return nil, err
+	}
+	// Constructor URL/security checks may block; validate the same actual hold
+	// after all construction IO, before returning a runnable instance.
+	if err = read.Recheck(); err != nil {
+		return nil, err
+	}
+	bound, err := bindOriginalEmbeddingClient(ctx, provider, read, !borrowed)
+	if err != nil {
+		return nil, err
+	}
+	closeOnFailure = false
+	return bound, nil
+}
