+			return err
+		}
+		if existing != 0 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		vector := types.EncodeEmbedding(result.Vector)
+		at := memoryFactTime()
+		row := &types.MemoryItemEmbedding{ItemID: read.original.ItemID, TenantID: scope.TenantID, SubjectID: scope.SubjectID, ModelID: read.original.ModelID, Dims: len(result.Vector), Vector: vector, CreatedAt: at, UpdatedAt: at}
+		if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.OnConflict{Columns: []clause.Column{{Name: "item_id"}}, DoUpdates: clause.AssignmentColumns([]string{"tenant_id", "subject_id", "model_id", "dims", "vector", "updated_at"})}).Create(row).Error; err != nil {
+			return err
+		}
+		vectors := &memoryRepository{db: tx.Session(&gorm.Session{NewDB: true})}
+		if err = vectors.writeVectorColumn(tx.Session(&gorm.Session{NewDB: true}), row.ItemID, vector); err != nil {
+			return err
+		}
+		actualControl, err := memoryEmbeddingControlInTx(tx, scope, row.ItemID, "UPDATE")
+		if err != nil {
+			return err
+		}
+		if !actualControl.Present || actualControl.Revision <= control.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var persisted types.MemoryItemEmbedding
+		if err = tx.Session(&gorm.Session{NewDB: true}).Where("item_id=? AND tenant_id=? AND subject_id=?", row.ItemID, scope.TenantID, scope.SubjectID).Take(&persisted).Error; err != nil {
+			return err
+		}
