+	if err != nil {
+		return err
+	}
+	if proof.Proof() != read.clock.Policy.Current || cfg == nil || !cfg.Enabled || !cfg.VectorRecallEnabled() || cfg.EmbeddingModelID != fact.ModelID {
+		return types.ErrMemoryOriginalUnavailable
+	}
