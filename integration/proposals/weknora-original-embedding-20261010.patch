+			if err := tx.Exec("UPDATE memory_subjects SET updated_at=updated_at WHERE tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Error; err != nil {
+				return err
+			}
+		}
+		if err := read.checkInTx(tx, false); err != nil {
+			return err
+		}
+		var subject types.MemorySubject
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(forUpdateClause()).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Take(&subject).Error; err != nil {
+			return err
+		}
+		if !subject.Enabled {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		control, err := memoryEmbeddingControlInTx(tx, scope, read.original.ItemID, "UPDATE")
+		if err != nil {
+			return err
+		}
+		if control.Revision != read.original.BaseVectorRevision || control.Present != read.original.BaseVectorPresent {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var existing int64
