+}
+
+// Same product recipe for document writes and missing-vector backfill. Aliases
+// are supplied exclusively from the leased original topic publication.
+func MemoryEmbeddingDocumentText(item *MemoryItem, aliases []string) string {
+	if item == nil {
+		return ""
+	}
+	topic, content := SanitizeMemoryTopic(item.Topic), SanitizeMemoryContent(item.Content)
+	text := content
+	if topic != "" && topic != content {
+		text = topic + "：" + content
+	}
+	if text == "" {
+		return ""
+	}
+	seen := map[string]bool{text: true, content: true, topic: true}
+	for _, alias := range aliases {
+		alias = strings.TrimSpace(SanitizeMemoryTopic(alias))
+		if alias == "" || seen[alias] {
+			continue
+		}
+		seen[alias] = true
+		text += "；" + alias
+	}
+	return text
+}
