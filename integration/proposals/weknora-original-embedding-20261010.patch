+package memory
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// Functional document write/backfill primitive. The application never authors
+// the input, model proof or result receipt from a caller's current row snapshot.
+// StoreItemEmbedding/review maintenance wiring and query/ranking consumption
+// remain separate required work; this function is not a full feature claim.
+func EmbedOriginalMemoryItem(ctx context.Context, originals interfaces.MemoryEmbeddingOriginalRepository, models interfaces.ModelService, scope interfaces.MemoryScope, capture types.MemoryEmbeddingCapture) (receipt *types.MemoryEmbeddingReceipt, resultErr error) {
+	if originals == nil || models == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read, err := originals.BeginMemoryEmbedding(ctx, scope, capture)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err := read.Close(); err != nil && resultErr == nil {
+			receipt = nil
+			resultErr = err
+		}
+	}()
+	input, err := read.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	client, err := models.GetEmbeddingModel(read.Context(), input.ModelID)
+	if err != nil {
+		return nil, err
+	}
+	lifetime, ok := client.(interface {
+		RecheckOriginal() error
+		CloseOriginal() error
+	})
+	if !ok {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	defer func() {
+		if err := lifetime.CloseOriginal(); err != nil && resultErr == nil {
+			receipt = nil
+			resultErr = err
+		}
+	}()
+	if client.GetDimensions() != input.ExpectedDimensions {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	call, cancel := context.WithTimeout(read.Context(), embedWriteTimeout)
+	defer cancel()
+	vector, err := client.Embed(call, input.Text)
+	if err != nil {
+		return nil, err
+	}
+	if err = read.Recheck(); err != nil {
+		return nil, err
+	}
+	if err = lifetime.RecheckOriginal(); err != nil {
+		return nil, err
+	}
+	// Borrowed provider and every outer body hold remain open through commit.
+	return originals.CommitMemoryEmbedding(read.Context(), types.MemoryEmbeddingResult{OriginalID: input.OriginalID, OriginalDigest: input.OriginalDigest, Vector: vector})
+}
