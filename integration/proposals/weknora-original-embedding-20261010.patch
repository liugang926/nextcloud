+CREATE TABLE memory_embedding_vector_controls(item_id TEXT PRIMARY KEY,tenant_id INTEGER NOT NULL,subject_id TEXT NOT NULL,revision INTEGER NOT NULL,present INTEGER NOT NULL);
+INSERT INTO memory_embedding_vector_controls SELECT item_id,tenant_id,subject_id,0,1 FROM memory_item_embeddings;
+CREATE TABLE memory_embedding_originals(id TEXT PRIMARY KEY,tenant_id INTEGER NOT NULL,subject_id TEXT NOT NULL,item_id TEXT NOT NULL,model_id TEXT NOT NULL,recipe TEXT NOT NULL,item_publication_id TEXT NOT NULL,topic_publication_id TEXT NOT NULL,derived_inputs_json TEXT NOT NULL,derived_inputs_digest TEXT NOT NULL,actor_selector TEXT NOT NULL,policy_proof_json TEXT NOT NULL,model_proof_json TEXT NOT NULL,model_digest TEXT NOT NULL,space_digest TEXT NOT NULL,expected_dimensions INTEGER NOT NULL,base_vector_revision INTEGER NOT NULL,base_vector_present INTEGER NOT NULL,input_json TEXT NOT NULL,input_sha256 TEXT NOT NULL,digest TEXT NOT NULL,created_at DATETIME NOT NULL);
+CREATE TABLE memory_embedding_receipts(id TEXT PRIMARY KEY,original_id TEXT NOT NULL UNIQUE REFERENCES memory_embedding_originals(id),original_digest TEXT NOT NULL,tenant_id INTEGER NOT NULL,subject_id TEXT NOT NULL,item_id TEXT NOT NULL,model_id TEXT NOT NULL,space_digest TEXT NOT NULL,dimensions INTEGER NOT NULL,vector_revision INTEGER NOT NULL,vector_digest TEXT NOT NULL,rank_vector_digest TEXT NOT NULL,rank_vector_present INTEGER NOT NULL,vector_json TEXT NOT NULL,vector_json_sha256 TEXT NOT NULL,digest TEXT NOT NULL,created_at DATETIME NOT NULL,UNIQUE(item_id,vector_revision));
+CREATE TABLE memory_embedding_body_receipts(origin_kind TEXT NOT NULL,origin_id TEXT NOT NULL,origin_digest TEXT NOT NULL,body_sha256 TEXT NOT NULL,slot_id TEXT NOT NULL,body_id TEXT NOT NULL,head_revision INTEGER NOT NULL,source_identity_sha256 TEXT NOT NULL,digest TEXT NOT NULL,created_at DATETIME NOT NULL,PRIMARY KEY(origin_kind,origin_id));
+CREATE TRIGGER memory_embedding_vector_insert AFTER INSERT ON memory_item_embeddings BEGIN
+UPDATE memory_embedding_vector_controls SET revision=revision+1,present=(tenant_id=NEW.tenant_id AND subject_id=NEW.subject_id) WHERE item_id=NEW.item_id;
+INSERT INTO memory_embedding_vector_controls SELECT NEW.item_id,NEW.tenant_id,NEW.subject_id,1,1 WHERE NOT EXISTS(SELECT 1 FROM memory_embedding_vector_controls WHERE item_id=NEW.item_id);
