diff --git a/internal/application/repository/memory_embedding_backfill.go b/internal/application/repository/memory_embedding_backfill.go
new file mode 100644
index 00000000..0b699b96
--- /dev/null
+++ b/internal/application/repository/memory_embedding_backfill.go
@@ -0,0 +1,86 @@
+package repository
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// Discovery returns identities only, from an actual leased collection. It
+// never reads an unproved current item body or vector as a new model input.
+// Receipt/body-aware ranking and repairing purged receipt bodies remain
+// separate consumer work; each returned ID acquires fresh complete input.
+func (r *memoryOriginalAdmissionRepository) DiscoverMemoryEmbeddingBackfill(ctx context.Context, scope interfaces.MemoryScope, modelID string, limit int) (ids []string, resultErr error) {
+	if !scope.Valid() || modelID == "" || limit <= 0 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	derived, err := r.BeginMemoryDerivedRead(ctx, scope)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err := derived.Close(); err != nil && resultErr == nil {
+			ids = nil
+			resultErr = err
+		}
+	}()
+	snapshot, err := derived.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	model, err := r.BeginModelOriginalRead(derived.Context(), modelID, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err := model.Close(); err != nil && resultErr == nil {
+			ids = nil
+			resultErr = err
+		}
+	}()
+	metadata, proof, err := model.Snapshot()
+	if err != nil {
+		return nil, err
+	}
+	if metadata == nil || proof == nil || metadata.Parameters.OriginalEmbedding == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	recipe := metadata.Parameters.OriginalEmbedding
+	space, err := types.ModelOriginalEmbeddingDigest(recipe)
+	if err != nil || space != recipe.SpaceDigest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	err = r.db.WithContext(model.Context()).Transaction(func(tx *gorm.DB) error {
+		hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		if hold == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err := r.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		if err := CheckCurrentModelOriginalHolds(model.Context(), tx.Session(&gorm.Session{NewDB: true}), *proof); err != nil {
+			return err
+		}
+		for _, item := range snapshot.Items {
+			if len(ids) >= limit {
+				break
+			}
+			if item == nil || item.Status != types.MemoryStatusActive {
+				continue
+			}
+			var known int64
+			if err := tx.Session(&gorm.Session{NewDB: true}).Table("memory_embedding_receipts AS r").Joins("JOIN memory_embedding_vector_controls AS c ON c.item_id=r.item_id AND c.revision=r.vector_revision AND c.present=?", true).Joins("JOIN memory_item_embeddings AS v ON v.item_id=r.item_id AND v.tenant_id=r.tenant_id AND v.subject_id=r.subject_id AND v.model_id=r.model_id AND v.dims=r.dimensions").Where("r.tenant_id=? AND r.subject_id=? AND r.item_id=? AND r.model_id=? AND r.space_digest=?", scope.TenantID, scope.SubjectID, item.ID, modelID, space).Count(&known).Error; err != nil {
+				return err
+			}
+			if known == 0 {
+				ids = append(ids, item.ID)
+			}
+		}
+		if err := r.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		return CheckCurrentModelOriginalHolds(model.Context(), tx.Session(&gorm.Session{NewDB: true}), *proof)
+	}, memoryWriteOptions(r.db))
+	return ids, err
+}
diff --git a/internal/application/repository/memory_embedding_body.go b/internal/application/repository/memory_embedding_body.go
new file mode 100644
index 00000000..606380c5
--- /dev/null
+++ b/internal/application/repository/memory_embedding_body.go
@@ -0,0 +1,88 @@
+package repository
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryEmbeddingProducerKey struct{}
+type memoryEmbeddingProducerBoundary struct {
+	Table, ID string
+	Tenant    uint64
+	SHA256    string
+}
+
+func memoryEmbeddingOriginalDigest(f *types.MemoryEmbeddingOriginal) (string, error) {
+	copy := *f
+	copy.Digest = ""
+	copy.InputJSON = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryEmbeddingReceiptDigest(f *types.MemoryEmbeddingReceipt) (string, error) {
+	copy := *f
+	copy.Digest = ""
+	copy.VectorJSON = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryEmbeddingBodyReceiptDigest(f *types.MemoryEmbeddingBodyReceipt) (string, error) {
+	copy := *f
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryEmbeddingProducerContext(ctx context.Context, table, id string, tenant uint64, sha string) context.Context {
+	return context.WithValue(ctx, memoryEmbeddingProducerKey{}, memoryEmbeddingProducerBoundary{table, id, tenant, sha})
+}
+
+func memoryEmbeddingBodyHeadInTx(tx *gorm.DB, table, id string, tenant uint64, sha string) (originalBodyFieldHead, error) {
+	column := "input_json"
+	if table == "memory_embedding_receipts" {
+		column = "vector_json"
+	} else if table != "memory_embedding_originals" {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	var heads []originalBodyFieldHead
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("source_table=? AND row_key=?", table, id).Find(&heads).Error; err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	if len(heads) != 1 {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	h := heads[0]
+	ref, ok := bodyReference(h.OriginalBodyRef)
+	if !ok || h.ColumnName != column || h.TenantID != tenant || h.KnowledgeBaseID != "" || h.KnowledgeID != "" || h.OwnerKind != table || h.OwnerID != id || ref.BodyID != h.BodyID || ref.SlotID != h.SlotID || ref.SHA256 != sha {
+		return h, ErrOriginalBodyUnavailable
+	}
+	if err := checkOriginalBodyAvailableForHeads(tx.Statement.Context, tx, table, id, heads); err != nil {
+		return h, err
+	}
+	return h, nil
+}
+func createMemoryEmbeddingBodyReceiptInTx(tx *gorm.DB, table, id string, tenant uint64, sha, digest string) error {
+	h, err := memoryEmbeddingBodyHeadInTx(tx, table, id, tenant, sha)
+	if err != nil {
+		return err
+	}
+	f := &types.MemoryEmbeddingBodyReceipt{OriginKind: table, OriginID: id, OriginDigest: digest, BodySHA256: sha, SlotID: h.SlotID, BodyID: h.BodyID, HeadRevision: h.Revision, SourceIdentitySHA256: h.SourceIdentitySHA256, CreatedAt: memoryFactTime()}
+	f.Digest, err = memoryEmbeddingBodyReceiptDigest(f)
+	if err != nil {
+		return err
+	}
+	return tx.Session(&gorm.Session{NewDB: true}).Create(f).Error
+}
+func checkMemoryEmbeddingBodyReceiptInTx(tx *gorm.DB, table, id string, tenant uint64, sha, digest string) (originalBodyFieldHead, error) {
+	h, err := memoryEmbeddingBodyHeadInTx(tx, table, id, tenant, sha)
+	if err != nil {
+		return h, err
+	}
+	var f types.MemoryEmbeddingBodyReceipt
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("origin_kind=? AND origin_id=?", table, id).Take(&f).Error; err != nil {
+		return h, err
+	}
+	actual, err := memoryEmbeddingBodyReceiptDigest(&f)
+	if err != nil || actual != f.Digest || f.OriginDigest != digest || f.BodySHA256 != sha || f.BodyID != h.BodyID || f.SlotID != h.SlotID || f.HeadRevision != h.Revision || f.SourceIdentitySHA256 != h.SourceIdentitySHA256 {
+		return h, ErrOriginalBodyUnavailable
+	}
+	return h, nil
+}
diff --git a/internal/application/repository/memory_embedding_input.go b/internal/application/repository/memory_embedding_input.go
new file mode 100644
index 00000000..b725f986
--- /dev/null
+++ b/internal/application/repository/memory_embedding_input.go
@@ -0,0 +1,305 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"sync"
+	"time"
+)
+
+const memoryEmbeddingOriginalFields = "id,tenant_id,subject_id,item_id,model_id,recipe,item_publication_id,topic_publication_id,derived_inputs_json,derived_inputs_digest,actor_selector,policy_proof_json,model_proof_json,model_digest,space_digest,expected_dimensions,base_vector_revision,base_vector_present,input_sha256,digest,created_at"
+
+type memoryEmbeddingReadKey struct{}
+type memoryEmbeddingRead struct {
+	repo        *memoryOriginalAdmissionRepository
+	ctx         context.Context
+	cancel      context.CancelFunc
+	original    *types.MemoryEmbeddingOriginal
+	head        originalBodyFieldHead
+	clock       *memoryGeneratedHold
+	derived     interfaces.MemoryDerivedRead
+	policy      interfaces.MemoryPolicyOriginalRead
+	model       interfaces.ModelOriginalRead
+	modelProof  types.ModelOriginalProof
+	mu          sync.Mutex
+	checks      sync.WaitGroup
+	closed      bool
+	failed      error
+	closeJoined chan struct{}
+}
+
+func memoryEmbeddingControlInTx(tx *gorm.DB, scope interfaces.MemoryScope, item string, lock string) (*types.MemoryEmbeddingVectorControl, error) {
+	var control types.MemoryEmbeddingVectorControl
+	q := tx.Session(&gorm.Session{NewDB: true})
+	if lock != "" {
+		q = q.Clauses(clause.Locking{Strength: lock})
+	}
+	if err := q.Where("item_id=?", item).Take(&control).Error; err != nil {
+		return nil, err
+	}
+	if control.TenantID != scope.TenantID || control.SubjectID != scope.SubjectID {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &control, nil
+}
+
+func loadMemoryEmbeddingOriginal(tx *gorm.DB, id string) (*types.MemoryEmbeddingOriginal, error) {
+	var fact types.MemoryEmbeddingOriginal
+	if id == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err := tx.Session(&gorm.Session{NewDB: true}).Select(memoryEmbeddingOriginalFields).Where("id=?", id).Take(&fact).Error; err != nil {
+		return nil, err
+	}
+	digest, err := memoryEmbeddingOriginalDigest(&fact)
+	if err != nil || digest != fact.Digest || fact.Recipe != types.MemoryEmbeddingDocumentRecipe || fact.TenantID == 0 || fact.SubjectID == "" || fact.ItemID == "" || fact.ItemPublicationID == "" || fact.ExpectedDimensions <= 0 || len(fact.SpaceDigest) != 64 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &fact, nil
+}
+
+// No text or vector bytes are accepted from the caller. The repository owns
+// the real graph read and freezes the exact product input after same-TX checks.
+func (r *memoryOriginalAdmissionRepository) BeginMemoryEmbedding(ctx context.Context, scope interfaces.MemoryScope, capture types.MemoryEmbeddingCapture) (interfaces.MemoryEmbeddingRead, error) {
+	if !scope.Valid() || capture.ItemID == "" || capture.ModelID == "" || r.authorityFactory == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read := &memoryEmbeddingRead{repo: r, clock: &memoryGeneratedHold{}, closeJoined: make(chan struct{})}
+	read.ctx, read.cancel = context.WithCancel(ctx)
+	var err error
+	read.derived, err = r.BeginMemoryDerivedRead(read.ctx, scope)
+	if err != nil {
+		read.Close()
+		return nil, err
+	}
+	snapshot, err := read.derived.Snapshot()
+	if err != nil {
+		read.Close()
+		return nil, err
+	}
+	read.ctx = logprivacy.SuppressContent(read.derived.Context())
+	var item *types.MemoryItem
+	for _, candidate := range snapshot.Items {
+		if candidate.ID == capture.ItemID {
+			copy := *candidate
+			item = &copy
+			break
+		}
+	}
+	if item == nil || item.Status != types.MemoryStatusActive || item.ExpiresAt != nil && !item.ExpiresAt.After(time.Now().UTC()) {
+		read.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	itemPublication, topicPublication := "", ""
+	aliases := []string{}
+	for _, proof := range snapshot.Manifest.Inputs {
+		if proof.ObjectKind == "memory_item" && proof.ObjectID == item.ID {
+			itemPublication = proof.PublicationID
+		}
+	}
+	if item.Kind == types.MemoryKindInterest {
+		key := types.NormalizeTopicKey(item.Topic)
+		for _, topic := range snapshot.Topics {
+			if topic.NormalizedKey == key {
+				aliases = append(aliases, topic.Aliases...)
+				for _, proof := range snapshot.Manifest.Inputs {
+					if proof.ObjectKind == "memory_topic" && proof.ObjectID == topic.ID {
+						topicPublication = proof.PublicationID
+					}
+				}
+				if topicPublication == "" {
+					read.Close()
+					return nil, types.ErrMemoryOriginalUnavailable
+				}
+				break
+			}
+		}
+	}
+	text := types.MemoryEmbeddingDocumentText(item, aliases)
+	if itemPublication == "" || text == "" {
+		read.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var policy types.MemoryPolicyProof
+	err = r.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		revision, err := memoryPolicyRevision(tx, scope.TenantID)
+		if err != nil {
+			return err
+		}
+		var origin types.MemoryPolicyOriginal
+		if err = tx.Session(&gorm.Session{NewDB: true}).Select("id,tenant_id,revision,policy_digest,digest").Where("tenant_id=? AND revision=?", scope.TenantID, revision).Take(&origin).Error; err != nil {
+			return err
+		}
+		policy, err = memoryPolicyProofInTx(tx, &origin)
+		return err
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		read.Close()
+		return nil, err
+	}
+	read.policy, err = beginMemoryPolicyOriginalRead(read.ctx, r.db, scope.TenantID, policy)
+	if err != nil {
+		read.Close()
+		return nil, err
+	}
+	cfg, _, err := read.policy.Policy()
+	if err != nil || cfg == nil || !cfg.Enabled || !cfg.VectorRecallEnabled() || cfg.EmbeddingModelID != capture.ModelID {
+		read.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read.clock.Policy, _ = read.policy.Context().Value(memoryPolicyHoldKey{}).(memoryPolicyHold)
+	read.model, err = r.BeginModelOriginalRead(read.policy.Context(), capture.ModelID, nil)
+	if err != nil {
+		read.Close()
+		return nil, err
+	}
+	model, proof, err := read.model.Snapshot()
+	if err != nil {
+		read.Close()
+		return nil, err
+	}
+	if model == nil || proof == nil || !proof.Valid() || model.Type != types.ModelTypeEmbedding || model.Status != types.ModelStatusActive || model.ID != capture.ModelID || model.TenantID != scope.TenantID && !model.IsBuiltin {
+		read.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	// These fields are supplied by the separately frozen model-original
+	// embedding producer. No catalog/overlay/current row resolves this recipe.
+	recipe := model.Parameters.OriginalEmbedding
+	if recipe == nil || recipe.ExpectedDimensions <= 0 {
+		read.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	space, err := types.ModelOriginalEmbeddingDigest(recipe)
+	if err != nil || space != recipe.SpaceDigest {
+		read.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read.modelProof = *proof
+	read.ctx = read.model.Context()
+	read.clock.ModelContext = read.model.Context()
+	err = r.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		if hold == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err := r.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		if err := CheckCurrentModelOriginalHolds(read.model.Context(), tx.Session(&gorm.Session{NewDB: true}), *proof); err != nil {
+			return err
+		}
+		if err := r.captureMemoryGeneratedModelBindingsInTx(tx, read.clock, hold); err != nil {
+			return err
+		}
+		var subject types.MemorySubject
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Take(&subject).Error; err != nil {
+			return err
+		}
+		if !subject.Enabled {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+		if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		actor, err := authority.Store.CaptureMemoryOriginalActor(tx.Statement.Context)
+		if err != nil || actor == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		fresh, err := authority.Store.RestoreMemoryOriginalActor(tx.Statement.Context, *actor, scope.TenantID, scope.SubjectID)
+		if err != nil {
+			return err
+		}
+		if err = authority.CheckRuntime(fresh); err != nil {
+			return err
+		}
+		if err = lockMemoryPolicyAuthor(tx, fresh, scope.TenantID); err != nil {
+			return err
+		}
+		bound := tx.Session(&gorm.Session{NewDB: true}).WithContext(context.WithValue(tx.Statement.Context, memoryPolicyHoldKey{}, read.clock.Policy))
+		if err = checkMemoryPolicyHoldsInTx(bound, scope.TenantID, read.clock.Policy.Current, read.clock.Policy.Queued); err != nil {
+			return err
+		}
+		control, err := memoryEmbeddingControlInTx(tx, scope, item.ID, "SHARE")
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			var count int64
+			if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryItemEmbedding{}).Where("item_id=?", item.ID).Count(&count).Error; err != nil {
+				return err
+			}
+			if count != 0 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			seed := &types.MemoryEmbeddingVectorControl{ItemID: item.ID, TenantID: scope.TenantID, SubjectID: scope.SubjectID}
+			if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.OnConflict{DoNothing: true}).Create(seed).Error; err != nil {
+				return err
+			}
+			control, err = memoryEmbeddingControlInTx(tx, scope, item.ID, "SHARE")
+		}
+		if err != nil {
+			return err
+		}
+		manifest, err := json.Marshal(hold.Manifest)
+		if err != nil {
+			return err
+		}
+		actorJSON, err := json.Marshal(actor)
+		if err != nil {
+			return err
+		}
+		policyJSON, err := json.Marshal(policy)
+		if err != nil {
+			return err
+		}
+		modelJSON, err := json.Marshal(proof)
+		if err != nil {
+			return err
+		}
+		input, err := json.Marshal(struct {
+			Text               string
+			ItemPublicationID  string
+			TopicPublicationID string
+		}{text, itemPublication, topicPublication})
+		if err != nil {
+			return err
+		}
+		fact := &types.MemoryEmbeddingOriginal{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, ItemID: item.ID, ModelID: model.ID, Recipe: types.MemoryEmbeddingDocumentRecipe, ItemPublicationID: itemPublication, TopicPublicationID: topicPublication, DerivedInputsJSON: string(manifest), DerivedInputsDigest: hold.Manifest.Digest, ActorSelector: string(actorJSON), PolicyProofJSON: string(policyJSON), ModelProofJSON: string(modelJSON), ModelDigest: proof.Digest, SpaceDigest: space, ExpectedDimensions: recipe.ExpectedDimensions, BaseVectorRevision: control.Revision, BaseVectorPresent: control.Present, InputJSON: string(input), InputSHA256: bodySHA(input), CreatedAt: memoryFactTime()}
+		fact.Digest, err = memoryEmbeddingOriginalDigest(fact)
+		if err != nil {
+			return err
+		}
+		producer := memoryEmbeddingProducerContext(read.ctx, "memory_embedding_originals", fact.ID, fact.TenantID, fact.InputSHA256)
+		if err = tx.Session(&gorm.Session{NewDB: true}).WithContext(producer).Create(fact).Error; err != nil {
+			return err
+		}
+		if err = createMemoryEmbeddingBodyReceiptInTx(tx, "memory_embedding_originals", fact.ID, fact.TenantID, fact.InputSHA256, fact.Digest); err != nil {
+			return err
+		}
+		head, err := checkMemoryEmbeddingBodyReceiptInTx(tx, "memory_embedding_originals", fact.ID, fact.TenantID, fact.InputSHA256, fact.Digest)
+		if err != nil {
+			return err
+		}
+		read.head = head
+		lease, err := NewOriginalBodyRetentionStore(tx).acquireLeaseInTx(tx, head.BodyID, "read", "memory-embedding-read/"+uuid.NewString(), 15*time.Minute)
+		if err != nil {
+			return err
+		}
+		if err = bodyInternal(tx).Where("lease_id=?", lease).Take(&read.clock.Lease).Error; err != nil {
+			return err
+		}
+		read.original = fact
+		return read.checkInTx(tx, false)
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		read.Close()
+		return nil, err
+	}
+	read.ctx = context.WithValue(read.ctx, memoryEmbeddingReadKey{}, read)
+	return read, nil
+}
diff --git a/internal/application/repository/memory_embedding_read.go b/internal/application/repository/memory_embedding_read.go
new file mode 100644
index 00000000..97f330d5
--- /dev/null
+++ b/internal/application/repository/memory_embedding_read.go
@@ -0,0 +1,221 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"time"
+)
+
+func (read *memoryEmbeddingRead) startCheck() error {
+	read.mu.Lock()
+	defer read.mu.Unlock()
+	if read.closed || read.failed != nil {
+		if read.failed != nil {
+			return read.failed
+		}
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err := read.ctx.Err(); err != nil {
+		return err
+	}
+	read.checks.Add(1)
+	return nil
+}
+func (read *memoryEmbeddingRead) finishCheck(err error) error {
+	read.mu.Lock()
+	if err == nil {
+		err = read.ctx.Err()
+	}
+	if err != nil && read.failed == nil {
+		read.failed = err
+		read.cancel()
+	}
+	read.mu.Unlock()
+	read.checks.Done()
+	return err
+}
+func (read *memoryEmbeddingRead) Context() context.Context { return read.ctx }
+
+func (read *memoryEmbeddingRead) checkInTx(tx *gorm.DB, afterVectorWrite bool) error {
+	if read.original == nil || read.clock == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if tx.Statement.Context.Err() != nil {
+		return tx.Statement.Context.Err()
+	}
+	fact, err := loadMemoryEmbeddingOriginal(tx, read.original.ID)
+	if err != nil {
+		return err
+	}
+	if fact.Digest != read.original.Digest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if hold == nil || hold.Manifest.Digest != fact.DerivedInputsDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = read.repo.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+		return err
+	}
+	var actor types.MemoryOriginalActor
+	if json.Unmarshal([]byte(fact.ActorSelector), &actor) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	authority := read.repo.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
