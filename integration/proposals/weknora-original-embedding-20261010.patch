+CREATE TABLE memory_embedding_originals(id TEXT PRIMARY KEY,tenant_id BIGINT NOT NULL,subject_id TEXT NOT NULL,item_id TEXT NOT NULL,model_id TEXT NOT NULL,recipe TEXT NOT NULL,item_publication_id TEXT NOT NULL,topic_publication_id TEXT NOT NULL,derived_inputs_json TEXT NOT NULL,derived_inputs_digest TEXT NOT NULL,actor_selector TEXT NOT NULL,policy_proof_json TEXT NOT NULL,model_proof_json TEXT NOT NULL,model_digest TEXT NOT NULL,space_digest TEXT NOT NULL,expected_dimensions INTEGER NOT NULL,base_vector_revision BIGINT NOT NULL,base_vector_present BOOLEAN NOT NULL,input_json TEXT NOT NULL,input_sha256 TEXT NOT NULL,digest TEXT NOT NULL,created_at TIMESTAMPTZ NOT NULL);
+CREATE TABLE memory_embedding_receipts(id TEXT PRIMARY KEY,original_id TEXT NOT NULL UNIQUE REFERENCES memory_embedding_originals(id),original_digest TEXT NOT NULL,tenant_id BIGINT NOT NULL,subject_id TEXT NOT NULL,item_id TEXT NOT NULL,model_id TEXT NOT NULL,space_digest TEXT NOT NULL,dimensions INTEGER NOT NULL,vector_revision BIGINT NOT NULL,vector_digest TEXT NOT NULL,rank_vector_digest TEXT NOT NULL,rank_vector_present BOOLEAN NOT NULL,vector_json TEXT NOT NULL,vector_json_sha256 TEXT NOT NULL,digest TEXT NOT NULL,created_at TIMESTAMPTZ NOT NULL,UNIQUE(item_id,vector_revision));
+CREATE TABLE memory_embedding_body_receipts(origin_kind TEXT NOT NULL,origin_id TEXT NOT NULL,origin_digest TEXT NOT NULL,body_sha256 TEXT NOT NULL,slot_id TEXT NOT NULL,body_id TEXT NOT NULL,head_revision BIGINT NOT NULL,source_identity_sha256 TEXT NOT NULL,digest TEXT NOT NULL,created_at TIMESTAMPTZ NOT NULL,PRIMARY KEY(origin_kind,origin_id));
+CREATE FUNCTION memory_embedding_vector_bump() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='DELETE' OR TG_OP='UPDATE' THEN
+ UPDATE memory_embedding_vector_controls SET revision=revision+1,present=FALSE WHERE item_id=OLD.item_id;
+ END IF;
+ IF TG_OP<>'DELETE' THEN
+ INSERT INTO memory_embedding_vector_controls(item_id,tenant_id,subject_id,revision,present) VALUES(NEW.item_id,NEW.tenant_id,NEW.subject_id,1,TRUE)
+ ON CONFLICT(item_id) DO UPDATE SET revision=memory_embedding_vector_controls.revision+1,present=(memory_embedding_vector_controls.tenant_id=EXCLUDED.tenant_id AND memory_embedding_vector_controls.subject_id=EXCLUDED.subject_id);
+ RETURN NEW; END IF; RETURN OLD; END; $$;
+CREATE TRIGGER memory_embedding_vector_bump AFTER INSERT OR UPDATE OR DELETE ON memory_item_embeddings FOR EACH ROW EXECUTE FUNCTION memory_embedding_vector_bump();
+CREATE FUNCTION memory_embedding_control_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'embedding controls are retained'; END IF;
+ IF OLD.item_id IS DISTINCT FROM NEW.item_id OR OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.subject_id IS DISTINCT FROM NEW.subject_id OR NEW.revision<>OLD.revision+1 THEN RAISE EXCEPTION 'embedding control revision is monotonic'; END IF;RETURN NEW; END;$$;
+CREATE TRIGGER memory_embedding_control_guard BEFORE UPDATE OR DELETE ON memory_embedding_vector_controls FOR EACH ROW EXECUTE FUNCTION memory_embedding_control_guard();
+CREATE TRIGGER memory_embedding_originals_immutable BEFORE UPDATE OR DELETE ON memory_embedding_originals FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+CREATE TRIGGER memory_embedding_receipts_immutable BEFORE UPDATE OR DELETE ON memory_embedding_receipts FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+CREATE TRIGGER memory_embedding_body_receipts_immutable BEFORE UPDATE OR DELETE ON memory_embedding_body_receipts FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
