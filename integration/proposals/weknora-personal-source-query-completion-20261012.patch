+package service
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	sqliteindex "github.com/Tencent/WeKnora/internal/application/repository/retriever/sqlite"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// Explicit original constructor configuration only. No normal registry/QA
+// caller is enabled here and no machine purpose is converted to a Web grant.
+func ConfigurePersonalNextcloudSQLiteVectorReads(engine interfaces.RetrieveEngineRepository, groups interfaces.GroupAccessService, directoryRuntime interfaces.DirectoryRuntimeService) error {
+	return sqliteindex.ConfigureOriginalSQLiteVectorSourceReads(engine, func(tx *gorm.DB) *repository.KnowledgeSQLiteVectorSourceAuthority {
+		boundGroups := NewGroupAccessService(repository.NewGroupAccessRepository(tx))
