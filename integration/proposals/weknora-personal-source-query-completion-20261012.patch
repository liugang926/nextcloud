+// Hash only immutable original metadata/receipts and actual completion effects;
+// never print source/model payloads or a plaintext credential.
+func personalCompletionFactsForTest(t *testing.T, db *gorm.DB, knowledge, assistant string) string {
+	t.Helper()
+	facts := map[string]any{}
+	for _, query := range []struct {
+		table, where, columns, order string
+		args                         []any
+	}{
+		{"knowledge_sqlite_embedding_inputs", "knowledge_id=?", "id,admission_id,model_id,space_digest,input_sha256,digest", "id", []any{knowledge}},
+		{"knowledge_sqlite_embedding_receipts", "knowledge_id=?", "id,input_id,input_digest,row_id,revision,vector_sha256,digest", "id", []any{knowledge}},
+		{"nextcloud_original_upload_inputs", "knowledge_id=?", "knowledge_id,input_digest,artifact_digest,root_digest,root_revision,config_digest,config_revision", "knowledge_id", []any{knowledge}},
+		{"message_material_receipts", "message_id=?", "*", "message_id", []any{assistant}},
+		{"message_completion_input_manifests", "assistant_admission_id IN (SELECT id FROM message_material_admissions WHERE message_id=?)", "assistant_admission_id,manifest_digest", "assistant_admission_id", []any{assistant}},
+	} {
+		var rows []map[string]any
+		require.NoError(t, db.Table(query.table).Select(query.columns).Where(query.where, query.args...).Order(query.order).Find(&rows).Error)
+		facts[query.table] = rows
+	}
+	digest, err := repository.KnowledgeInputDigest(facts)
+	require.NoError(t, err)
+	return digest
+}
+
+// This observer invokes public producer APIs from a live Query/Row callback.
+// WithContext alone creates clone2 and would preserve the observed SELECT's
+// SQL/model/select/where. Materialize a same-TX empty statement first, then use
+// NewDB for every internal producer query; no authority or producer is replaced.
+func personalCompletionMutationProducerDB(tx *gorm.DB) *gorm.DB {
+	return tx.Session(&gorm.Session{NewDB: true, Context: tx.Statement.Context, Initialized: true}).Session(&gorm.Session{NewDB: true})
+}
