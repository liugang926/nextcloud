+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sort"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+// Configuration supplies the real per-TX public guard; this is not a source
+// grant. The read still requires current actor/DirGUID/ACL/source/body proof.
+type KnowledgeSQLiteVectorSourceAuthority struct {
+	Store        *KnowledgeInputProvenanceStore
+	Guard        *access.NextcloudSourceLineageGuard
+	CheckRuntime func(context.Context) error
+}
+type KnowledgeSQLiteVectorSourceAuthorityFactory func(*gorm.DB) *KnowledgeSQLiteVectorSourceAuthority
+
+func ConfigureKnowledgeSQLiteVectorSourceReads(s *KnowledgeSQLiteEmbeddingStore, factory KnowledgeSQLiteVectorSourceAuthorityFactory) error {
+	if s == nil || factory == nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	s.sourceMu.Lock()
+	defer s.sourceMu.Unlock()
+	if s.sourceFactory != nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	s.sourceFactory = factory
+	return nil
+}
+func (s *KnowledgeSQLiteEmbeddingStore) sourceReadFactory() KnowledgeSQLiteVectorSourceAuthorityFactory {
+	s.sourceMu.RLock()
+	defer s.sourceMu.RUnlock()
+	return s.sourceFactory
+}
+
+func personalKnowledgeVectorCaller(ctx context.Context) error {
+	caller := types.CallerFromContext(ctx)
+	principal, ok := types.PrincipalFromContext(ctx)
+	if !ok || principal.Type != types.PrincipalWebUser || principal.ID != caller.UserID || caller.UserID == "" || types.IsSyntheticUserID(caller.UserID) || caller.TenantID == 0 || NextcloudEmbeddingPurposePresent(ctx) {
+		return access.ErrNextcloudPublicationDenied
+	}
+	if _, machine := types.TenantAPIKeyScopeFromContext(ctx); machine {
+		return access.ErrNextcloudPublicationDenied
+	}
+	return ctx.Err()
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) sourceAuthority(tx *gorm.DB) (*KnowledgeSQLiteVectorSourceAuthority, error) {
+	if err := personalKnowledgeVectorCaller(r.ctx); err != nil {
+		return nil, err
+	}
+	factory := r.store.sourceReadFactory()
+	if factory == nil {
+		return nil, access.ErrNextcloudPublicationUnavailable
+	}
+	actual := factory(tx.Session(&gorm.Session{NewDB: true}))
+	if actual == nil || actual.Store == nil || actual.Guard == nil || actual.CheckRuntime == nil || actual.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return nil, access.ErrNextcloudPublicationUnavailable
+	}
+	if err := actual.CheckRuntime(r.ctx); err != nil {
+		return nil, err
+	}
+	fresh, err := actual.Store.RefreshCurrentReadActor(r.ctx)
+	if err != nil {
+		return nil, err
+	}
+	if !sameOriginalModelCallerInRepository(fresh, r.ctx) {
+		return nil, access.ErrNextcloudPublicationDenied
+	}
+	return actual, nil
+}
+
+// Immutable admission metadata selects the source set before index-body
+// hydration. Source rows/content are held and public-authorized before the
+// input JSON is decoded; its authentic proof must then match this exact set.
+func (r *KnowledgeSQLiteEmbeddingVectorRead) captureSourceReadsInTx(tx *gorm.DB, owner string) error {
+	all := []*types.SourceLineage{}
+	for _, input := range r.originals {
+		var admission knowledgeInputAdmission
+		if err := tx.Select("admission_id,tenant_id,knowledge_base_id,knowledge_id,source_lineage").Where("admission_id=? AND tenant_id=? AND knowledge_base_id=? AND knowledge_id=?", input.AdmissionID, input.TenantID, input.KnowledgeBaseID, input.KnowledgeID).Take(&admission).Error; err != nil {
+			return err
+		}
+		var source types.SourceLineage
+		if json.Unmarshal([]byte(admission.SourceLineage), &source) != nil || source.RequireComplete() != nil {
+			return ErrKnowledgeInputChanged
+		}
+		all = append(all, &source)
+	}
+	lineage, err := types.UnionSourceLineage(all...)
+	if err != nil {
+		return err
+	}
+	if len(lineage.Sources) == 0 {
+		return nil
+	}
+	if _, err = r.sourceAuthority(tx); err != nil {
+		return err
+	}
+	r.sourceLineage = lineage
+	sources := append([]types.SourceIdentity(nil), lineage.Sources...)
+	sort.Slice(sources, func(i, j int) bool {
+		a, b := sources[i], sources[j]
+		if a.TenantID != b.TenantID {
+			return a.TenantID < b.TenantID
+		}
+		if a.KnowledgeBaseID != b.KnowledgeBaseID {
+			return a.KnowledgeBaseID < b.KnowledgeBaseID
+		}
+		return a.KnowledgeID < b.KnowledgeID
+	})
+	retentionRows := []originalBodyAvailabilityRow{}
+	r.sourceKBFences = map[string]nextcloudContentFence{}
+	for _, source := range sources {
+		scope := NextcloudContentScope{source.TenantID, source.KnowledgeBaseID, source.KnowledgeID, source.DataSourceID, source.ExternalID}
+		lease, e := r.store.material.ContentLeaseStore().AcquireKnowledgeInTx(r.ctx, tx, scope, NextcloudContentReadLease, owner, 2*time.Minute)
+		if e != nil {
+			return e
+		}
+		if uint64(lease.Epoch) != source.Revision {
+			return ErrKnowledgeInputChanged
+		}
+		r.sourceContent = append(r.sourceContent, lease)
+		var fence nextcloudContentFence
+		if e = tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", scope.TenantID, scope.KnowledgeBaseID).Take(&fence).Error; e != nil {
+			return e
+		}
+		r.sourceKBFences[fmt.Sprintf("%d/%s", scope.TenantID, scope.KnowledgeBaseID)] = fence
+		retentionRows = append(retentionRows, originalBodyAvailabilityRow{"knowledges", source.KnowledgeID}, originalBodyAvailabilityRow{"nextcloud_original_upload_inputs", source.KnowledgeID})
+	}
+	// All actual inherited body and source content holds precede hydration.
+	if err = r.claimBodyRowsInTx(tx, retentionRows, owner); err != nil {
+		return err
+	}
+	r.ctx, err = WithFAQReadLeaseCoverage(r.ctx, r.sourceContent)
+	if err != nil {
+		return err
+	}
+	if err = r.captureCompletionSourceOriginalsInTx(tx, sources); err != nil {
+		return err
+	}
+	return r.authorizeCapturedSourcesInTx(tx)
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) checkSourceReadsInTx(tx *gorm.DB) error {
+	all := []*types.SourceLineage{}
+	for _, body := range r.body {
+		all = append(all, body.Proof.SourceLineage)
+	}
+	lineage, err := types.UnionSourceLineage(all...)
+	if err != nil {
+		return err
+	}
+	if len(lineage.Sources) == 0 {
+		if len(r.sourceContent) != 0 || r.sourceLineage != nil {
+			return ErrKnowledgeInputChanged
+		}
+		return nil
+	}
+	if r.sourceLineage == nil || !reflect.DeepEqual(lineage, r.sourceLineage) || len(r.sourceContent) != len(lineage.Sources) {
+		return ErrKnowledgeInputChanged
+	}
+	return r.authorizeCapturedSourcesInTx(tx)
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) authorizeCapturedSourcesInTx(tx *gorm.DB) error {
+	authority, err := r.sourceAuthority(tx)
+	if err != nil {
+		return err
+	}
+	lineage := r.sourceLineage
+	if lineage == nil || lineage.RequireComplete() != nil {
+		return ErrKnowledgeInputChanged
+	}
+	targets := types.SearchTargets{}
+	for _, input := range r.originals {
+		targets = append(targets, &types.SearchTarget{Type: types.SearchTargetTypeKnowledgeBase, TenantID: input.TenantID, KnowledgeBaseID: input.KnowledgeBaseID})
+	}
+	return authority.Guard.Check(r.ctx, lineage, access.LineageReadScope{Targets: targets})
+}
