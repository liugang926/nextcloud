+
+// These are witnesses captured after the genuine private vector source check,
+// not lineage grants. All fields are local metadata; no credential is hydrated.
+type knowledgeCompletionSourcePair struct {
+	OperationID      string
+	TenantID         uint64
+	KnowledgeBaseID  string
+	DataSourceID     string `gorm:"column:datasource_id"`
+	InstanceID       string `gorm:"column:nextcloud_instance_id"`
+	BindingID        string
+	BaseURL          string `gorm:"column:datasource_base_url"`
+	ConfigSHA        string `gorm:"column:datasource_config_sha256"`
+	PublicationEpoch int64
+	KeyID, State     string
+}
+type knowledgeCompletionSourceEpoch struct {
+	Pair                                          knowledgeCompletionSourcePair
+	OperationID, OperationState, PermissionSHA256 string
+	PermissionVersion                             int64
+	ConnectionID                                  string
+	PublicationEpoch, VerifiedAt, OriginalEpoch   int64
+	OriginalPath                                  string
+	Source                                        types.SourceIdentity
+	OriginalInputDigest, OriginalArtifactDigest   string
+	Grants                                        []types.NextcloudSourceGrant
+}
+type knowledgeCompletionSourceLocal struct {
+	read      *KnowledgeSQLiteEmbeddingVectorRead
+	tx        *gorm.DB
+	local     *access.NextcloudSourceLocalRead
+	authority *KnowledgeSQLiteVectorSourceAuthority
+	epochs    map[string]knowledgeCompletionSourceEpoch
+	controls  map[string]modelOriginalControl
+}
+
+func (r *KnowledgeSQLiteEmbeddingVectorRead) completionSourceEpochInTx(tx *gorm.DB, source types.SourceIdentity) (knowledgeCompletionSourceEpoch, error) {
+	var result knowledgeCompletionSourceEpoch
+	result.Grants = []types.NextcloudSourceGrant{}
+	if err := tx.Table("nextcloud_source_pairings").Select("operation_id,tenant_id,knowledge_base_id,datasource_id,nextcloud_instance_id,binding_id,datasource_base_url,datasource_config_sha256,state,publication_epoch,key_id").Where("operation_id=? AND tenant_id=? AND knowledge_base_id=? AND datasource_id=? AND state='active'", source.PairOperationID, source.TenantID, source.KnowledgeBaseID, source.DataSourceID).Take(&result.Pair).Error; err != nil {
+		return result, err
+	}
+	if result.Pair.InstanceID != source.InstanceID || result.Pair.BindingID != source.BindingID {
+		return result, ErrKnowledgeInputChanged
+	}
+	var op struct {
+		OperationID, State, PermissionSHA256 string
+		PermissionVersion                    int64
+	}
+	if err := tx.Table("nextcloud_onboarding_operations").Select("operation_id,state,permission_sha256,permission_version").Where("operation_id=? AND tenant_id=? AND knowledge_base_id=? AND instance_id=? AND binding_id=? AND state='active'", source.PairOperationID, source.TenantID, source.KnowledgeBaseID, source.InstanceID, source.BindingID).Take(&op).Error; err != nil {
+		return result, err
+	}
+	result.OperationID = op.OperationID
+	result.OperationState = op.State
+	result.PermissionSHA256 = op.PermissionSHA256
+	result.PermissionVersion = op.PermissionVersion
+	if err := tx.Where("operation_id=?", source.PairOperationID).Order("source_relation_id,kind,directory_id,object_guid").Find(&result.Grants).Error; err != nil {
+		return result, err
+	}
+	var connections []struct {
+		ConnectionID                                                              string
+		TenantID                                                                  uint64
+		KnowledgeBaseID                                                           string
+		DataSourceID                                                              string `gorm:"column:datasource_id"`
+		NextcloudInstanceID, BindingID, DatasourceBaseURL, DatasourceConfigSHA256 string
+	}
+	if err := tx.Table("nextcloud_event_connections").Select("connection_id,tenant_id,knowledge_base_id,datasource_id,nextcloud_instance_id,binding_id,datasource_base_url,datasource_config_sha256").Where("datasource_id=? AND status='active'", source.DataSourceID).Find(&connections).Error; err != nil {
+		return result, err
+	}
+	result.Source = source
+	originalKey := fmt.Sprintf("%d/%s/%s", source.TenantID, source.KnowledgeBaseID, source.KnowledgeID)
+	original, hasOriginal := r.sourceArtifacts[originalKey]
+	if !hasOriginal || original.PairOperation != source.PairOperationID || original.Artifact.InstanceID != source.InstanceID || original.Artifact.BindingID != source.BindingID || original.Artifact.ExternalID != source.ExternalID || original.Artifact.FileID != source.FileID || original.Artifact.ETag != source.ETag || original.BaseURL != result.Pair.BaseURL || original.ConfigSHA != result.Pair.ConfigSHA || types.NextcloudLineageContentRevision(original.Artifact.ContentRevision) != source.ContentRevision {
+		return result, ErrKnowledgeInputChanged
+	}
+	// This selector is the immutable held upload body captured once at Begin,
+	// never a re-captured current Knowledge.Metadata value after remote IO.
+	rawEpoch := original.Artifact.PublicationEpoch
+	if rawEpoch == "" {
+		if len(connections) != 0 {
+			return result, ErrKnowledgeInputChanged
+		}
+		result.OriginalEpoch = result.Pair.PublicationEpoch
+	} else {
+		epoch, e := strconv.ParseInt(rawEpoch, 10, 64)
+		if e != nil || epoch < 0 || strconv.FormatInt(epoch, 10) != rawEpoch {
+			return result, ErrKnowledgeInputChanged
+		}
+		result.OriginalEpoch = epoch
+	}
+	result.OriginalPath = original.Artifact.Path
+	receipt, found := r.sourceOriginals[originalKey]
+	if !found {
+		return result, ErrKnowledgeInputChanged
+	}
+	result.OriginalInputDigest = receipt.InputDigest
+	result.OriginalArtifactDigest = receipt.ArtifactDigest
+	if len(connections) == 0 {
+		result.PublicationEpoch = result.Pair.PublicationEpoch
+		return result, nil
+	}
+	if len(connections) != 1 {
+		return result, ErrKnowledgeInputChanged
+	}
+	c := connections[0]
+	if c.ConnectionID == "" || c.TenantID != source.TenantID || c.KnowledgeBaseID != source.KnowledgeBaseID || c.DataSourceID != source.DataSourceID || c.NextcloudInstanceID != source.InstanceID || c.BindingID != source.BindingID || c.DatasourceBaseURL != result.Pair.BaseURL || c.DatasourceConfigSHA256 != result.Pair.ConfigSHA {
+		return result, ErrKnowledgeInputChanged
+	}
+	var epoch struct {
+		ConnectionID, PairOperationID string
+		PublicationEpoch, VerifiedAt  int64
+	}
+	if err := tx.Table("nextcloud_source_status_epochs").Where("connection_id=?", c.ConnectionID).Take(&epoch).Error; err != nil {
+		return result, err
+	}
+	if epoch.ConnectionID != c.ConnectionID || epoch.PairOperationID != source.PairOperationID || epoch.PublicationEpoch < 0 || epoch.VerifiedAt <= 0 {
+		return result, ErrKnowledgeInputChanged
+	}
+	result.ConnectionID = epoch.ConnectionID
+	result.PublicationEpoch = epoch.PublicationEpoch
+	result.VerifiedAt = epoch.VerifiedAt
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return result, err
+	}
+	if epoch.VerifiedAt > now/1000 || now-epoch.VerifiedAt*1000 > 300000 {
+		return result, ErrKnowledgeInputChanged
+	}
+	if result.OriginalEpoch != result.PublicationEpoch {
+		allowed, e := NewNextcloudOnboardingStore(tx).RootMigrationAuthorizesEpoch(tx.Statement.Context, source.TenantID, source.KnowledgeBaseID, source.DataSourceID, result.OriginalPath, result.OriginalEpoch, result.PublicationEpoch)
+		if e != nil || !allowed {
+			return result, ErrKnowledgeInputChanged
+		}
+	}
+	return result, nil
+}
+func (r *KnowledgeSQLiteEmbeddingVectorRead) captureCompletionSourceLocalInTx(tx *gorm.DB) (*knowledgeCompletionSourceLocal, error) {
+	result := &knowledgeCompletionSourceLocal{read: r, tx: tx, epochs: map[string]knowledgeCompletionSourceEpoch{}, controls: map[string]modelOriginalControl{}}
+	for _, input := range r.originals {
+		control, err := modelControls(tx, input.ModelID)
+		if err != nil {
+			return nil, err
+		}
+		result.controls[input.ModelID] = control
+	}
+	if err := knowledgeCompletionFinalHeadsInTx(tx, r.rows, r.heads); err != nil {
+		return nil, err
+	}
+	if r.sourceLineage == nil {
+		if len(r.sourceContent) != 0 || len(r.sourceKBFences) != 0 {
+			return nil, ErrKnowledgeInputChanged
+		}
+		return result, nil
+	}
+	authority, err := r.sourceAuthority(tx)
+	if err != nil {
+		return nil, err
+	}
+	targets := types.SearchTargets{}
+	for _, input := range r.originals {
+		targets = append(targets, &types.SearchTarget{Type: types.SearchTargetTypeKnowledgeBase, TenantID: input.TenantID, KnowledgeBaseID: input.KnowledgeBaseID})
+	}
+	result.authority = authority
+	result.local, err = authority.Guard.CheckAndCaptureLocal(r.ctx, r.sourceLineage, access.LineageReadScope{Targets: targets})
+	if err != nil {
+		return nil, err
+	}
+	for _, source := range r.sourceLineage.Sources {
+		key := fmt.Sprintf("%d/%s/%s", source.TenantID, source.KnowledgeBaseID, source.KnowledgeID)
+		epoch, e := r.completionSourceEpochInTx(tx, source)
+		if e != nil {
+			return nil, e
+		}
+		result.epochs[key] = epoch
+	}
+	return result, nil
+}
+func (local *knowledgeCompletionSourceLocal) recheckInTx(tx *gorm.DB) error {
+	if local == nil || local.read == nil || local.tx.Statement.ConnPool != tx.Statement.ConnPool {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	r := local.read
+	if r.sourceLineage != nil {
+		if local.authority == nil || local.authority.Store == nil || local.authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+		if err := local.local.Recheck(); err != nil {
+			return err
+		}
+		for key, want := range r.sourceOriginals {
+			var current nextcloudOriginalUploadInput
+			if err := tx.Select("knowledge_id,tenant_id,knowledge_base_id,datasource_id,source_revision,config_revision,root_revision,routing_revision,tenant_revision,routing_digest,tenant_digest,config_digest,root_digest,artifact_digest,input_digest").Where("knowledge_id=? AND tenant_id=? AND knowledge_base_id=?", want.KnowledgeID, want.TenantID, want.KnowledgeBaseID).Take(&current).Error; err != nil {
+				return err
+			}
+			want.ActualInputs = ""
+			if !reflect.DeepEqual(current, want) || r.sourceArtifacts[key].Artifact.ArtifactSHA256 != want.ArtifactDigest {
+				return ErrKnowledgeInputChanged
+			}
+		}
+		for _, source := range r.sourceLineage.Sources {
+			key := fmt.Sprintf("%d/%s/%s", source.TenantID, source.KnowledgeBaseID, source.KnowledgeID)
+			current, err := r.completionSourceEpochInTx(tx, source)
+			if err != nil {
+				return err
+			}
+			want, ok := local.epochs[key]
+			if !ok || !reflect.DeepEqual(current, want) {
+				return ErrKnowledgeInputChanged
+			}
+		}
+	}
+	authority, err := knowledgeSQLiteEmbeddingAuthority(tx, r.store.material)
+	if err != nil {
+		return err
+	}
+	fresh, err := authority.RefreshCurrentReadActor(r.ctx)
+	if err != nil {
+		return err
+	}
+	for _, input := range r.originals {
+		var kb types.KnowledgeBase
+		if err = tx.Where("id=? AND tenant_id=?", input.KnowledgeBaseID, input.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		if err = r.authorizeKB(authority, fresh, &kb); err != nil {
+			return err
+		}
+	}
+	for id, want := range local.controls {
+		current, e := modelControls(tx, id)
+		if e != nil {
+			return e
+		}
+		if current != want {
+			return ErrKnowledgeSQLiteEmbeddingUnknown
+		}
+	}
+	for id, receipt := range r.receipts {
+		if err = checkKnowledgeSQLiteVectorCurrentInTx(tx, id, receipt.Revision, receipt.Dimension, r.body[id].Info, r.vectors[id]); err != nil {
+			return err
+		}
+	}
+	return r.ctx.Err()
+}
+
+// No external body/journal/remote IO belongs after this metadata-only check.
+// Bodies have already been genuinely held and physically verified above.
+func knowledgeCompletionCurrentModelMetadataInTx(tx *gorm.DB, m *modelOriginalRead) error {
+	if m == nil || m.download || m.model == nil || m.authorize == nil || m.ctx.Err() != nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	fresh, err := m.authorize(withOriginalBodyAvailabilityScope(tx, m.ctx), tx, m.hold.Proof)
+	if err != nil {
+		return err
+	}
+	var current types.Model
+	if err = tx.Session(&gorm.Session{NewDB: true}).WithContext(fresh).Where("id=?", m.hold.Proof.ModelID).Take(&current).Error; err != nil {
+		return err
+	}
+	control, err := modelControls(tx, current.ID)
+	if err != nil {
+		return err
+	}
+	proof := m.hold.Proof
+	if control.DefinitionRevision != proof.DefinitionRevision || control.CredentialRevision != proof.CredentialRevision || control.StateEpoch != proof.StateEpoch || current.Status != types.ModelStatusActive || current.TenantID != proof.OwnerTenantID || current.IsBuiltin != proof.IsBuiltin || current.DeletedAt.Valid || current.IsDefault != m.model.IsDefault || current.ManagedBy != m.model.ManagedBy {
+		return ErrKnowledgeInputChanged
+	}
+	definition, err := types.ModelDefinitionBytes(m.model)
+	if err != nil {
+		return err
+	}
+	matches, err := types.ModelDefinitionMatchesOriginal(&current, string(definition))
+	if err != nil || !matches {
+		return ErrKnowledgeInputChanged
+	}
+	actualCredential, err := types.ModelCredentialPlainDigest(&current)
+	if err != nil {
+		return err
+	}
+	wantCredential, err := types.ModelCredentialPlainDigest(m.model)
+	if err != nil || actualCredential != wantCredential {
+		return ErrKnowledgeInputChanged
+	}
+	return fresh.Err()
+}
+func knowledgeCompletionFinalHeadsInTx(tx *gorm.DB, rows []originalBodyAvailabilityRow, heads []originalBodyFieldHead) error {
+	current, err := originalBodyBatchHeads(tx, rows)
+	if err != nil {
+		return err
+	}
+	if !sameOriginalBodyHeads(heads, current) {
+		return ErrOriginalBodyUnavailable
+	}
+	return nil
+}
+func knowledgeCompletionSourceLeaseUnion(content []NextcloudContentLease, fences map[string]nextcloudContentFence, r *KnowledgeSQLiteEmbeddingVectorRead) ([]NextcloudContentLease, error) {
+	if r == nil {
+		return nil, ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	content = append(content, r.sourceContent...)
+	for key, fence := range r.sourceKBFences {
+		if key != fmt.Sprintf("%d/%s", fence.TenantID, fence.KnowledgeBaseID) || fence.KnowledgeID != "" || fence.State != "open" || fence.Epoch <= 0 {
+			return nil, ErrNextcloudContentLeaseInvalid
+		}
+		if before, ok := fences[key]; ok && !reflect.DeepEqual(before, fence) {
+			return nil, ErrNextcloudContentLeaseInvalid
+		}
+		fences[key] = fence
+	}
+	return content, nil
+}
+func knowledgeCompletionCurrentModelHeadsInTx(tx *gorm.DB, m *modelOriginalRead) error {
+	for _, body := range m.hold.Bodies {
+		var head originalBodyFieldHead
+		if err := bodyInternal(tx).Where("slot_id=?", body.Head.SlotID).Take(&head).Error; err != nil {
+			return err
+		}
+		if head != body.Head {
+			return ErrOriginalBodyUnavailable
+		}
+		var receipt types.ModelOriginalBodyReceipt
+		if err := tx.Where("origin_id=?", body.Receipt.OriginID).Take(&receipt).Error; err != nil {
+			return err
+		}
+		actualTime := receipt.CreatedAt
+		receipt.CreatedAt = body.Receipt.CreatedAt
+		if !reflect.DeepEqual(receipt, body.Receipt) || !actualTime.Equal(body.Receipt.CreatedAt) {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return nil
+}
+
+// The same final statement as ALL body/content leases also reloads the exact
+// source epoch, pair, operation and complete grant rows. A changed epoch is not
+// confused with SourceIdentity.Revision (the independent content fence epoch).
+func knowledgeCompletionSourceEpochFinalSQL(key string, w knowledgeCompletionSourceEpoch) (string, []interface{}, error) {
+	if key != fmt.Sprintf("%d/%s/%s", w.Source.TenantID, w.Source.KnowledgeBaseID, w.Source.KnowledgeID) || w.Pair.OperationID != w.Source.PairOperationID {
+		return "", nil, ErrKnowledgeInputChanged
+	}
+	epochSQL := "p.publication_epoch"
+	verifiedSQL := "0"
+	connectionSQL := "''"
+	joins := ""
+	extra := " AND NOT EXISTS(SELECT 1 FROM nextcloud_event_connections ec WHERE ec.datasource_id=p.datasource_id AND ec.status='active')"
+	args := []interface{}{key}
+	if w.ConnectionID != "" {
+		epochSQL = "e.publication_epoch"
+		verifiedSQL = "e.verified_at"
+		connectionSQL = "c.connection_id"
+		joins = ` JOIN nextcloud_event_connections c ON c.datasource_id=p.datasource_id AND c.tenant_id=p.tenant_id AND c.knowledge_base_id=p.knowledge_base_id AND c.status='active' AND c.nextcloud_instance_id=p.nextcloud_instance_id AND c.binding_id=p.binding_id AND c.datasource_base_url=p.datasource_base_url AND c.datasource_config_sha256=p.datasource_config_sha256 JOIN nextcloud_source_status_epochs e ON e.connection_id=c.connection_id AND e.pair_operation_id=p.operation_id`
+		extra = " AND c.connection_id=? AND (SELECT COUNT(*) FROM nextcloud_event_connections ec WHERE ec.datasource_id=p.datasource_id AND ec.status='active')=1"
+	}
+	grants := `COALESCE((SELECT json_group_array(json(grant_json)) FROM (SELECT json_object('OperationID',sg.operation_id,'SourceRelationID',sg.source_relation_id,'Kind',sg.kind,'DirectoryID',sg.directory_id,'ObjectGUID',sg.object_guid,'TenantID',sg.tenant_id,'KnowledgeBaseID',sg.knowledge_base_id,'PrincipalID',sg.principal_id,'PermissionVersion',sg.permission_version,'PublicationEpoch',sg.publication_epoch,'Origin',sg.origin) AS grant_json FROM nextcloud_source_grants sg WHERE sg.operation_id=p.operation_id ORDER BY sg.source_relation_id,sg.kind,sg.directory_id,sg.object_guid)),'[]')`
+	payload := `json_object('Pair',json_object('OperationID',p.operation_id,'TenantID',p.tenant_id,'KnowledgeBaseID',p.knowledge_base_id,'DataSourceID',p.datasource_id,'InstanceID',p.nextcloud_instance_id,'BindingID',p.binding_id,'BaseURL',p.datasource_base_url,'ConfigSHA',p.datasource_config_sha256,'State',p.state,'PublicationEpoch',p.publication_epoch,'KeyID',p.key_id),'OperationID',o.operation_id,'OperationState',o.state,'PermissionSHA256',o.permission_sha256,'PermissionVersion',o.permission_version,'ConnectionID',` + connectionSQL + `,'PublicationEpoch',` + epochSQL + `,'VerifiedAt',` + verifiedSQL + `,'Grants',json(` + grants + `))`
+	query := `SELECT 'publication' AS domain,? AS id,'' AS body_id,'' AS owner_id,'' AS kind,0 AS epoch,0 AS expires_at_ms,NULL AS released_at_ms,0 AS tenant,'' AS kb,'' AS knowledge,'' AS broad_state,0 AS broad_epoch,'' AS exact_state,0 AS exact_epoch,` + payload + ` AS payload_json,CAST((julianday('now')-2440587.5)*86400000 AS INTEGER) AS clock_ms FROM nextcloud_source_pairings p JOIN data_sources d ON d.id=p.datasource_id AND d.tenant_id=p.tenant_id AND d.knowledge_base_id=p.knowledge_base_id AND d.type='nextcloud' AND d.status='active' AND d.deleted_at IS NULL JOIN nextcloud_onboarding_operations o ON o.operation_id=p.operation_id AND o.tenant_id=p.tenant_id AND o.knowledge_base_id=p.knowledge_base_id AND o.instance_id=p.nextcloud_instance_id AND o.binding_id=p.binding_id AND o.state='active' JOIN nextcloud_content_fences f ON f.tenant_id=p.tenant_id AND f.knowledge_base_id=p.knowledge_base_id AND f.knowledge_id=? AND f.datasource_id=p.datasource_id AND f.external_id=? AND f.state='open' AND f.epoch=? JOIN nextcloud_original_upload_inputs u ON u.knowledge_id=f.knowledge_id AND u.tenant_id=f.tenant_id AND u.knowledge_base_id=f.knowledge_base_id AND u.datasource_id=f.datasource_id AND u.input_digest=? AND u.artifact_digest=?` + joins + ` WHERE p.operation_id=? AND p.tenant_id=? AND p.knowledge_base_id=? AND p.datasource_id=? AND p.state='active'` + extra
+	args = append(args, w.Source.KnowledgeID, w.Source.ExternalID, int64(w.Source.Revision), w.OriginalInputDigest, w.OriginalArtifactDigest, w.Pair.OperationID, w.Pair.TenantID, w.Pair.KnowledgeBaseID, w.Pair.DataSourceID)
+	if w.ConnectionID != "" {
+		args = append(args, w.ConnectionID)
+	}
+	return query, args, nil
+}
+
+func (r *KnowledgeSQLiteEmbeddingVectorRead) captureCompletionSourceOriginalsInTx(tx *gorm.DB, sources []types.SourceIdentity) error {
+	r.sourceOriginals = map[string]nextcloudOriginalUploadInput{}
+	r.sourceArtifacts = map[string]nextcloudOriginalUploadActual{}
+	for _, source := range sources {
+		var original nextcloudOriginalUploadInput
+		if err := tx.WithContext(r.ctx).Where("knowledge_id=? AND tenant_id=? AND knowledge_base_id=? AND datasource_id=?", source.KnowledgeID, source.TenantID, source.KnowledgeBaseID, source.DataSourceID).Take(&original).Error; err != nil {
+			return err
+		}
+		var actual nextcloudOriginalUploadActual
+		if json.Unmarshal([]byte(original.ActualInputs), &actual) != nil {
+			return ErrKnowledgeInputChanged
+		}
+		digest, err := KnowledgeInputDigest(actual)
+		if err != nil || digest != original.InputDigest || original.ArtifactDigest != actual.Artifact.ArtifactSHA256 || actual.PairOperation != source.PairOperationID || actual.Artifact.InstanceID != source.InstanceID || actual.Artifact.BindingID != source.BindingID || actual.Artifact.ExternalID != source.ExternalID || actual.Artifact.FileID != source.FileID || actual.Artifact.ETag != source.ETag || actual.Artifact.ItemDigest == "" || actual.Artifact.SourceConfigDigest == "" {
+			return ErrKnowledgeInputChanged
+		}
+		key := fmt.Sprintf("%d/%s/%s", source.TenantID, source.KnowledgeBaseID, source.KnowledgeID)
+		r.sourceOriginals[key] = original
+		r.sourceArtifacts[key] = actual
+	}
+	return nil
+}
