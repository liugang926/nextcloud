+package sqlite
+
+import (
+	apprepo "github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// A mutable model/KB DTO or a legacy backend cannot install this authority.
+// Only this actual original adapter's concrete same-pool store is configured.
+func ConfigureOriginalSQLiteVectorSourceReads(engine interfaces.RetrieveEngineRepository, factory apprepo.KnowledgeSQLiteVectorSourceAuthorityFactory) error {
+	actual, ok := engine.(*sqliteRepository)
+	if !ok || actual == nil || actual.originals == nil || actual.initErr != nil {
+		return apprepo.ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return apprepo.ConfigureKnowledgeSQLiteVectorSourceReads(actual.originals, factory)
+}
