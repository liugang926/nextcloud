+	var mode string
+	require.NoError(t, f.db.Raw("PRAGMA journal_mode").Scan(&mode).Error)
+	require.Equal(t, "wal", mode)
+	_, svc, _, reader := actualOriginalModelServices(t, f)
+	ctx := context.WithValue(f.ctx, modelRecheckWriterKey{}, ctxToken)
+	read, err := reader.BeginModelOriginalRead(ctx, f.model.GetModelID(), nil)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		if err := read.Close(); err != nil {
+			t.Error("owned model read cleanup failed")
+		}
+	})
+	model, proof, err := read.Snapshot()
+	require.NoError(t, err)
+	require.NotNil(t, proof)
+	require.True(t, proof.Valid())
+	return f, svc, read, model, *proof
+}
+
+func modelRecheckPermissionVersion(t *testing.T, db *gorm.DB, tenant uint64) types.PermissionVersion {
+	t.Helper()
+	var version types.PermissionVersion
+	require.NoError(t, db.Session(&gorm.Session{NewDB: true}).Where("tenant_id=?", tenant).Take(&version).Error)
+	return version
+}
+
+func modelRecheckAssertClosed(t *testing.T, f *memAtomicSQLFixture, read interfaces.ModelOriginalRead) {
+	t.Helper()
+	require.NoError(t, read.Close())
+	var live int64
+	require.NoError(t, f.db.Session(&gorm.Session{NewDB: true}).Table("original_body_leases").Where("kind=? AND released_at_ms IS NULL", "read").Count(&live).Error)
+	require.Zero(t, live)
+	require.Zero(t, f.model.calls, "SQL recheck never calls a provider")
+}
+
+func TestModelOriginalRecheckSQLiteWriterReservationActual(t *testing.T) {
+	t.Setenv(memoryJointSchemaOptin, "1")
+	t.Run("zero_row_preserves_permission_facts_and_row_guard", func(t *testing.T) {
+		token := new(int)
+		f, _, read, _, _ := modelRecheckWriterFixture(t, token)
+		before := modelRecheckPermissionVersion(t, f.db, f.scope.TenantID)
+		leases := messageLeaseWriterFacts(t, f.db)
+		const trigger = "owned_model_recheck_permission_row_guard"
+		require.NoError(t, f.db.Exec("CREATE TRIGGER "+trigger+" BEFORE UPDATE ON directory_permission_versions BEGIN SELECT RAISE(ABORT,'owned permission row guard'); END").Error)
+		active := true
+		t.Cleanup(func() {
+			if active {
+				if err := f.db.Exec("DROP TRIGGER " + trigger).Error; err != nil {
+					t.Error("owned permission guard cleanup failed")
+				}
+			}
+		})
+		observed := false
+		name := "test:model-recheck-zero-row"
+		require.NoError(t, f.db.Callback().Raw().After("gorm:raw").Register(name, func(tx *gorm.DB) {
+			if tx.Statement.Context.Value(modelRecheckWriterKey{}) == token && tx.Statement.SQL.String() == modelRecheckReservationSQL && tx.Error == nil {
+				observed = true
+				require.Zero(t, tx.RowsAffected)
+				require.Equal(t, before, modelRecheckPermissionVersion(t, tx, f.scope.TenantID))
+			}
+		}))
+		t.Cleanup(func() {
+			if err := f.db.Callback().Raw().Remove(name); err != nil {
+				t.Error("owned zero-row observer cleanup failed")
+			}
+		})
+		require.NoError(t, read.Recheck())
+		require.True(t, observed)
+		require.Equal(t, before, modelRecheckPermissionVersion(t, f.db, f.scope.TenantID))
+		require.Equal(t, leases, messageLeaseWriterFacts(t, f.db))
+		matching := f.db.Session(&gorm.Session{NewDB: true}).Model(&types.PermissionVersion{}).Where("tenant_id=?", f.scope.TenantID).Update("version", before.Version+1)
+		require.Error(t, matching.Error, "the actual matching-row trigger is active")
+		require.NoError(t, f.db.Exec("DROP TRIGGER "+trigger).Error)
+		active = false
+		modelRecheckAssertClosed(t, f, read)
+	})
+	t.Run("recheck_serializes_real_permission_producer_on_two_connections", func(t *testing.T) {
+		token := new(int)
+		f, _, read, _, proof := modelRecheckWriterFixture(t, token)
+		operation, cancel := context.WithTimeout(f.ctx, 10*time.Second)
+		defer cancel()
+		writer := messageLeaseWriterSecondConnection(t, f, operation)
+		before := modelRecheckPermissionVersion(t, f.db, f.scope.TenantID)
+		held, attempted := make(chan struct{}, 1), make(chan struct{}, 1)
+		release := make(chan struct{})
+		var releaseOnce sync.Once
+		var pauseOnce sync.Once
+		recheckDone, writerDone := make(chan error, 1), make(chan error, 1)
+		recheckJoined, writerStarted, writerJoined := false, false, false
+		name, writerName := "test:model-recheck-held", "test:model-permission-producer-attempt"
+		require.NoError(t, f.db.Callback().Raw().After("gorm:raw").Register(name, func(tx *gorm.DB) {
+			if tx.Statement.Context.Value(modelRecheckWriterKey{}) != token || tx.Statement.SQL.String() != modelRecheckReservationSQL || tx.Error != nil {
+				return
+			}
+			if tx.RowsAffected != 0 {
+				t.Error("model reservation changed a permission row")
+			}
+			pauseOnce.Do(func() {
+				held <- struct{}{}
+				select {
+				case <-release:
+				case <-operation.Done():
+				}
+			})
+		}))
+		require.NoError(t, writer.Callback().Create().Before("gorm:create").Register(writerName, func(tx *gorm.DB) {
+			if tx.Statement.Table == "resource_access_policies" {
+				attempted <- struct{}{}
+			}
+		}))
+		t.Cleanup(func() {
+			releaseOnce.Do(func() { close(release) })
+			cancel()
+			if err := read.Close(); err != nil {
+				t.Error("owned model read cleanup failed")
+			}
+			cleanup, stop := context.WithTimeout(context.WithoutCancel(f.ctx), 5*time.Second)
+			defer stop()
+			if !recheckJoined {
+				select {
+				case <-recheckDone:
+					recheckJoined = true
+				case <-cleanup.Done():
+					t.Error("owned model recheck did not join")
+				}
+			}
+			if writerStarted && !writerJoined {
+				select {
+				case <-writerDone:
+					writerJoined = true
+				case <-cleanup.Done():
+					t.Error("owned permission producer did not join")
+				}
+			}
+			if err := writer.Callback().Create().Remove(writerName); err != nil {
+				t.Error("owned permission observer cleanup failed")
+			}
+			if err := f.db.Callback().Raw().Remove(name); err != nil {
+				t.Error("owned model observer cleanup failed")
+			}
+		})
+		go func() { recheckDone <- read.Recheck() }()
+		select {
+		case <-held:
+		case <-operation.Done():
+			t.Fatal("real model writer reservation was not reached")
+		}
+		require.NoError(t, writer.Exec("PRAGMA busy_timeout=0").Error)
+		probe := writer.Exec(modelRecheckReservationSQL)
+		require.True(t, messageLeaseWriterBusy(probe.Error), "real second WAL connection must observe the reserved writer")
+		require.NoError(t, writer.Exec("PRAGMA busy_timeout=5000").Error)
+		writerStarted = true
+		go func() {
+			writerDone <- NewGroupAccessService(repository.NewGroupAccessRepository(writer)).SetResourceAccessPolicy(operation, &types.ResourceAccessPolicy{TenantID: f.scope.TenantID, ResourceType: types.GroupResourceTypeKnowledgeBase, ResourceID: "kb", Mode: types.ResourceAccessInherit, UpdatedBy: types.CallerFromContext(f.ctx).UserID})
+		}()
+		select {
+		case <-attempted:
+		case <-operation.Done():
+			t.Fatal("real permission producer did not attempt its SQL write")
+		}
+		select {
+		case <-writerDone:
+			writerJoined = true
+			t.Fatal("permission producer unexpectedly finished while another connection held the WAL writer")
+		default:
+		}
+		releaseOnce.Do(func() { close(release) })
+		select {
+		case err := <-recheckDone:
+			recheckJoined = true
+			require.NoError(t, err)
+		case <-operation.Done():
+			t.Fatal("real model recheck did not finish")
+		}
+		select {
+		case err := <-writerDone:
+			writerJoined = true
+			require.NoError(t, err)
+		case <-operation.Done():
+			t.Fatal("real permission producer did not finish")
+		}
+		require.Equal(t, before.Version+1, modelRecheckPermissionVersion(t, writer, f.scope.TenantID).Version)
+		require.NoError(t, read.Recheck(), "a lawful permission-version successor is freshly reauthorized")
+		_, after, err := read.Snapshot()
+		require.NoError(t, err)
+		require.Equal(t, proof, *after)
+		modelRecheckAssertClosed(t, f, read)
+	})
+	for _, mode := range []string{"actor_changed_refuses", "model_successor_refuses", "held_body_purged_refuses"} {
+		t.Run(mode, func(t *testing.T) {
+			f, svc, read, model, proof := modelRecheckWriterFixture(t, new(int))
+			switch mode {
+			case "actor_changed_refuses":
+				write := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Model(&types.User{}).Where("id=? AND is_active=?", types.CallerFromContext(f.ctx).UserID, true).Update("is_active", false)
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+			case "model_successor_refuses":
+				model.Description = "genuine new definition after held snapshot"
+				require.NoError(t, svc.UpdateModel(f.ctx, model))
+				_, _, _, reader := actualOriginalModelServices(t, f)
+				_, next := actualModelProof(t, reader, f.ctx, model.ID)
+				require.NotEqual(t, proof.DefinitionID, next.DefinitionID)
+			case "held_body_purged_refuses":
+				var body types.ModelOriginalBodyReceipt
+				require.NoError(t, f.db.Session(&gorm.Session{NewDB: true}).Where("origin_kind=? AND origin_id=?", "definition", proof.DefinitionID).Take(&body).Error)
+				write := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Table("original_body_payloads").Where("id=? AND state=?", body.BodyID, "live").Update("state", "purged")
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+			}
+			refusal := read.Recheck()
+			require.Error(t, refusal)
+			_, _, err := read.Snapshot()
+			require.ErrorIs(t, err, refusal)
+			modelRecheckAssertClosed(t, f, read)
+		})
+	}
+	t.Run("caller_owned_transaction_keeps_actual_actor_check", func(t *testing.T) {
+		f, _, read, _, proof := modelRecheckWriterFixture(t, new(int))
+		var refusal error
+		err := f.db.WithContext(f.ctx).Transaction(func(tx *gorm.DB) error {
+			write := tx.Session(&gorm.Session{NewDB: true}).Model(&types.User{}).Where("id=? AND is_active=?", types.CallerFromContext(f.ctx).UserID, true).Update("is_active", false)
+			if write.Error != nil {
+				return write.Error
+			}
+			if write.RowsAffected != 1 {
+				return errors.New("owned actor control fault did not affect its actual row")
+			}
+			refusal = repository.CheckCurrentModelOriginalHolds(read.Context(), tx, proof)
+			return refusal
+		})
+		require.Error(t, refusal)
+		require.ErrorIs(t, err, refusal)
+		var actor types.User
+		require.NoError(t, f.db.Session(&gorm.Session{NewDB: true}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Take(&actor).Error)
+		require.True(t, actor.IsActive, "the refused caller-owned transaction rolls back its real mutation")
+		require.ErrorIs(t, read.Recheck(), refusal, "a refused held reader stays isolated after SQL rollback")
+		_, _, sticky := read.Snapshot()
+		require.ErrorIs(t, sticky, refusal)
+		modelRecheckAssertClosed(t, f, read)
+		_, _, _, reader := actualOriginalModelServices(t, f)
+		fresh, err := reader.BeginModelOriginalRead(f.ctx, proof.ModelID, &proof)
+		require.NoError(t, err, "rollback restored the actual actor; only a newly authorized reader may use the same immutable proof")
+		t.Cleanup(func() {
+			if err := fresh.Close(); err != nil {
+				t.Error("owned fresh model read cleanup failed")
+			}
+		})
+		require.NoError(t, fresh.Recheck())
+		_, after, err := fresh.Snapshot()
+		require.NoError(t, err)
+		require.NotNil(t, after)
+		require.Equal(t, proof, *after)
+		modelRecheckAssertClosed(t, f, fresh)
+	})
+}
