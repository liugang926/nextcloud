diff --git a/internal/application/service/model_original_embedding_operation.go b/internal/application/service/model_original_embedding_operation.go
new file mode 100644
index 000000000..d051d22f9
--- /dev/null
+++ b/internal/application/service/model_original_embedding_operation.go
@@ -0,0 +1,157 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"sync"
+
+	"github.com/Tencent/WeKnora/internal/models/embedding"
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// An operation uses the very same immutable model/credential reader and carrier
+// as its constructor. No current-row reconstruction or new authoring occurs.
+type modelOriginalEmbeddingOperation struct {
+	parent   *modelOriginalEmbeddingClient
+	ctx      context.Context
+	finish   func()
+	mu       sync.Mutex
+	closed   bool
+	closeErr error
+	joined   chan struct{}
+	calls    sync.WaitGroup
+}
+
+func (w *modelOriginalEmbeddingClient) claimOriginalEmbeddingCall() (func(), error) {
+	w.operationMu.Lock()
+	if w.delegated {
+		w.operationMu.Unlock()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	w.directCalls++
+	w.operationMu.Unlock()
+	return func() {
+		w.operationMu.Lock()
+		w.directCalls--
+		w.operationMu.Unlock()
+	}, nil
+}
+
+func (w *modelOriginalEmbeddingClient) BeginOriginalEmbeddingOperation(ctx context.Context) (context.Context, embedding.Embedder, func() error, error) {
+	w.operationMu.Lock()
+	if w.life.owner && (w.delegated || w.directCalls != 0) {
+		w.operationMu.Unlock()
+		return ctx, nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	if w.life.owner {
+		w.delegated = true
+	}
+	w.operationMu.Unlock()
+	call, finish, _, err := w.life.begin(ctx)
+	if err != nil {
+		if w.life.owner {
+			err = errors.Join(err, w.CloseOriginal())
+		}
+		return ctx, nil, nil, err
+	}
+	op := &modelOriginalEmbeddingOperation{parent: w, ctx: call, finish: finish, joined: make(chan struct{})}
+	return call, op, op.CloseOriginal, nil
+}
+
+func (o *modelOriginalEmbeddingOperation) GetModelName() string { return o.parent.GetModelName() }
+func (o *modelOriginalEmbeddingOperation) GetModelID() string   { return o.parent.GetModelID() }
+func (o *modelOriginalEmbeddingOperation) GetDimensions() int   { return o.parent.GetDimensions() }
+
+func (o *modelOriginalEmbeddingOperation) begin(ctx context.Context) (context.Context, func(), error) {
+	o.mu.Lock()
+	if o.closed || o.ctx.Err() != nil {
+		o.mu.Unlock()
+		return ctx, nil, types.ErrMemoryOriginalUnavailable
+	}
+	o.calls.Add(1)
+	o.mu.Unlock()
+	child, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(o.ctx, cancel)
+	call, finish, _, err := o.parent.life.begin(child)
+	if err != nil {
+		stop()
+		cancel()
+		o.calls.Done()
+		return ctx, nil, err
+	}
+	if err := o.ctx.Err(); err != nil {
+		finish()
+		stop()
+		cancel()
+		o.calls.Done()
+		return ctx, nil, err
+	}
+	return call, func() { finish(); stop(); cancel(); o.calls.Done() }, nil
+}
+
+func (o *modelOriginalEmbeddingOperation) Embed(ctx context.Context, text string) ([]float32, error) {
+	call, finish, err := o.begin(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finish()
+	vector, err := o.parent.inner.Embed(call, text)
+	if err != nil {
+		return nil, err
+	}
+	if err = o.parent.life.read.Recheck(); err != nil {
+		return nil, err
+	}
+	return vector, nil
+}
+
+func (o *modelOriginalEmbeddingOperation) BatchEmbed(ctx context.Context, texts []string) ([][]float32, error) {
+	call, finish, err := o.begin(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer finish()
+	vectors, err := o.parent.inner.BatchEmbed(call, texts)
+	if err != nil {
+		return nil, err
+	}
+	if err = o.parent.life.read.Recheck(); err != nil {
+		return nil, err
+	}
+	return vectors, nil
+}
+
+func (o *modelOriginalEmbeddingOperation) BatchEmbedWithPool(ctx context.Context, _ embedding.Embedder, texts []string) ([][]float32, error) {
+	return o.BatchEmbed(ctx, texts)
+}
+
+func (o *modelOriginalEmbeddingOperation) CloseOriginal() error {
+	o.mu.Lock()
+	if o.closed {
+		joined := o.joined
+		o.mu.Unlock()
+		<-joined
+		o.mu.Lock()
+		err := o.closeErr
+		o.mu.Unlock()
+		return err
+	}
+	o.closed = true
+	o.mu.Unlock()
+	// Cancel and join the actual factory watcher and all SDK child calls before
+	// closing an owned reader. Borrowed outer readers remain alive for commit.
+	o.finish()
+	o.calls.Wait()
+	err := o.parent.life.RecheckOriginal()
+	if o.parent.life.owner {
+		err = errors.Join(err, o.parent.CloseOriginal())
+	}
+	o.mu.Lock()
+	o.closeErr = err
+	close(o.joined)
+	o.mu.Unlock()
+	return err
+}
+
+var _ embedding.OriginalOperationFactory = (*modelOriginalEmbeddingClient)(nil)
+var _ embedding.Embedder = (*modelOriginalEmbeddingOperation)(nil)
