+// Recheck refreshes the current actor through a real permission-version
+// INSERT, even when the existing version makes ON CONFLICT a no-op. Reserve
+// SQLite's writer before that transaction's first read, without changing any
+// permission row or minting an original/lease. Caller-owned checkInTx paths and
+// PostgreSQL keep their existing behavior; a nested stale snapshot still has
+// to perform this real write and may refuse rather than being replayed.
+func reserveModelOriginalRecheckWriterInTx(tx *gorm.DB) error {
+	if tx.Dialector.Name() != "sqlite" {
+		return nil
+	}
+	if err := tx.Statement.Context.Err(); err != nil {
+		return err
+	}
+	result := tx.Session(&gorm.Session{NewDB: true, Context: tx.Statement.Context}).Exec("UPDATE directory_permission_versions SET version=version WHERE 1=0")
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 0 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
