+						select {
+						case e := <-returned:
+							require.Error(t, e)
+						case <-ctx.Done():
+							t.Fatal("actual SDK did not cancel and join")
+						}
+						require.Error(t, end())
+						ended = true
+						select {
+						case e := <-closed:
+							require.NoError(t, e)
+						case <-ctx.Done():
+							t.Fatal("owned model Close did not join")
+						}
+						select {
