+				err := observerErr
+				mu.Unlock()
+				require.NoError(t, err)
+				require.Len(t, captured[0], len(pool))
+				require.Equal(t, []string{"genuine operation item owned item input"}, captured[1])
+			} else {
+				var outer interfaces.ModelOriginalRead
+				if mode == "borrowed_reader_retained" {
+					var err error
+					outer, err = reader.BeginModelOriginalRead(ctx, model.ID, &proof)
+					require.NoError(t, err)
+					defer outer.Close()
+					ctx = outer.Context()
+				}
+				client, err := svc.GetEmbeddingModel(ctx, model.ID)
+				require.NoError(t, err)
