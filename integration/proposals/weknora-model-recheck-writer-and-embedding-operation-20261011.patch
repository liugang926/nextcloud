+// This sink persists actual vectors for the existing BatchIndex entry. It is
+// not an original publisher, proof stub, or a real external vector backend.
+type originalOperationVectorForTest struct {
+	SourceID string `gorm:"primaryKey"`
+	Vector   string
+}
+type originalOperationIndexForTest struct {
+	interfaces.RetrieveEngineRepository
+	db          *gorm.DB
+	modelBodies []string
+}
+
+func (r *originalOperationIndexForTest) BatchSave(ctx context.Context, list []*types.IndexInfo, params map[string]any) error {
+	var live int64
+	if err := r.db.WithContext(ctx).Table("original_body_leases").Where("body_id IN ? AND kind='read' AND released_at_ms IS NULL", r.modelBodies).Count(&live).Error; err != nil {
+		return err
+	}
+	if live != 2 {
+		return fmt.Errorf("actual model operation lost its two body holds before SQL save")
+	}
+	vectors, ok := params["embedding"].(map[string][]float32)
+	if !ok {
+		return fmt.Errorf("actual index vector map missing")
+	}
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		for _, item := range list {
+			vector, ok := vectors[item.SourceID]
+			if !ok || len(vector) != 3 {
+				return fmt.Errorf("actual index vector dimension missing")
+			}
+			wire, err := json.Marshal(vector)
+			if err != nil {
+				return err
+			}
+			if err := tx.Create(&originalOperationVectorForTest{SourceID: item.SourceID, Vector: string(wire)}).Error; err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+func runOriginalEmbeddingOperationActual(t *testing.T, pg bool) {
+	for _, mode := range []string{"retry_then_real_SQL_save", "wiki_two_real_batches", "actor_between_batches", "borrowed_reader_retained", "close_active_HTTP_joins"} {
+		t.Run(mode, func(t *testing.T) {
+			t.Setenv(memoryJointSchemaOptin, "1")
+			f := newMemAtomicSQLFixture(t, pg)
+			_, svc, _, reader := actualOriginalModelServices(t, f)
+			var calls, failUntil atomic.Int64
+			started, providerJoined := make(chan struct{}), make(chan struct{})
+			var startOnce, joinOnce sync.Once
+			var mu sync.Mutex
+			requests := [][]string{}
+			var observerErr error
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				call := calls.Add(1)
+				startOnce.Do(func() { close(started) })
+				wire, err := io.ReadAll(r.Body)
+				var body struct {
+					Input []string `json:"input"`
+				}
+				if err == nil {
+					err = json.Unmarshal(wire, &body)
+				}
+				if err == nil && (r.URL.Path != "/embeddings" || r.Header.Get("Authorization") != "Bearer fixture-operation-key") {
+					err = fmt.Errorf("actual proved endpoint/auth binding changed")
+				}
+				mu.Lock()
+				if err != nil {
+					observerErr = err
+				}
+				requests = append(requests, append([]string(nil), body.Input...))
+				mu.Unlock()
+				if err != nil {
+					w.WriteHeader(400)
+					return
+				}
+				if mode == "close_active_HTTP_joins" {
+					<-r.Context().Done()
+					joinOnce.Do(func() { close(providerJoined) })
+					return
+				}
+				if mode == "retry_then_real_SQL_save" && call <= failUntil.Load() {
+					w.WriteHeader(http.StatusServiceUnavailable)
+					_, _ = w.Write([]byte(`{"error":{"message":"owned temporary failure"}}`))
+					return
+				}
+				data := []map[string]any{}
+				for i := range body.Input {
+					data = append(data, map[string]any{"index": i, "embedding": []float32{1, 0, 0}})
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(map[string]any{"data": data})
+			}))
+			t.Cleanup(server.Close)
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			model := &types.Model{ID: "actual-embedding-operation", TenantID: 7, Name: "actual-operation-embedding", Type: types.ModelTypeEmbedding, Source: types.ModelSourceRemote, Parameters: types.ModelParameters{Provider: "openai", BaseURL: server.URL, APIKey: "fixture-operation-key", EmbeddingParameters: types.EmbeddingParameters{Dimension: 3, SupportsDimensionOverride: true}}}
+			require.NoError(t, svc.CreateModel(f.ctx, model))
+			require.NotNil(t, model.OriginalProof)
+			require.True(t, model.OriginalProof.Valid())
+			current, proof := actualModelProof(t, reader, f.ctx, model.ID)
+			require.NotNil(t, current.Parameters.OriginalEmbedding)
+			if mode == "retry_then_real_SQL_save" {
+				// A genuine full author update pins zero inner retries so the
+				// real outer backoff gets exactly one HTTP503 then one success.
+				current.Parameters.OriginalEmbedding.RetryMaxRetries = 0
+				var err error
+				current.Parameters.OriginalEmbedding.SpaceDigest, err = types.ModelOriginalEmbeddingDigest(current.Parameters.OriginalEmbedding)
+				require.NoError(t, err)
+				require.NoError(t, svc.UpdateModel(f.ctx, current))
+				current, proof = actualModelProof(t, reader, f.ctx, model.ID)
+				require.Zero(t, current.Parameters.OriginalEmbedding.RetryMaxRetries)
+			}
+			// Exhaust the pinned SDK's whole retry budget once, so the second
+			// healthy call belongs to the real outer batchEmbedWithBackoff.
+			failUntil.Store(int64(current.Parameters.OriginalEmbedding.RetryMaxRetries + 1))
+			var defBody types.ModelOriginalBodyReceipt
+			var credentialBody types.ModelOriginalBodyReceipt
+			require.NoError(t, f.db.Where("origin_id=?", proof.DefinitionID).Take(&defBody).Error)
+			require.NoError(t, f.db.Where("origin_id=?", proof.CredentialID).Take(&credentialBody).Error)
+			ctx, cancel := context.WithTimeout(f.ctx, 10*time.Second)
+			defer cancel()
+			if mode == "wiki_two_real_batches" {
+				pool := [][]string{}
+				for i := 0; i <= wikiTaxonomyFeedAllMaxFolders; i++ {
+					pool = append(pool, []string{"owned", fmt.Sprintf("folder-%02d", i)})
+				}
+				wiki := &wikiIngestService{modelService: svc}
