+					require.NoError(t, f.db.Order("source_id").Find(&saved).Error)
+					require.Len(t, saved, 2)
+					mu.Lock()
+					captured := append([][]string(nil), requests...)
+					err := observerErr
+					mu.Unlock()
+					require.NoError(t, err)
+					for _, text := range captured {
+						require.Equal(t, []string{inputs[0].Content, inputs[1].Content}, text)
