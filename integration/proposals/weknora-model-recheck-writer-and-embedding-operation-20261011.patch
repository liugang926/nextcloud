diff --git a/internal/models/embedding/original_operation.go b/internal/models/embedding/original_operation.go
new file mode 100644
index 000000000..47c87d91f
--- /dev/null
+++ b/internal/models/embedding/original_operation.go
@@ -0,0 +1,28 @@
+package embedding
+
+import (
+	"context"
+	"errors"
+)
+
+// OriginalOperationFactory is implemented by the proved model client. It keeps
+// its existing original reader alive across all calls in one operation.
+type OriginalOperationFactory interface {
+	BeginOriginalEmbeddingOperation(context.Context) (context.Context, Embedder, func() error, error)
+}
+
+// BeginOperation preserves direct SDK providers' existing behaviour. It does
+// not create an original, an input proof, or permission for an unbound provider.
+// The returned end must run after calls have joined and outside a SQL transaction.
+func BeginOperation(ctx context.Context, model Embedder) (context.Context, Embedder, func() error, error) {
+	if ctx == nil || model == nil {
+		return ctx, nil, nil, errors.New("embedding operation unavailable")
+	}
+	if err := ctx.Err(); err != nil {
+		return ctx, nil, nil, err
+	}
+	if original, ok := model.(OriginalOperationFactory); ok {
+		return original.BeginOriginalEmbeddingOperation(ctx)
+	}
+	return ctx, model, func() error { return nil }, nil
+}
