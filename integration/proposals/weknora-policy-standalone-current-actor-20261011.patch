+// Reading a policy is not authoring one: valid current viewer/web/API/worker
+// callers are allowed by the configured current actor provider. This checks
+// their exact identity/tenant on this transaction, without requiring admin.
+func authorizeMemoryPolicyCurrentActorInTx(tx *gorm.DB, ctx context.Context, hold memoryPolicyHold) (context.Context, error) {
+	if tx == nil || hold.Authorize == nil || ctx == nil {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return ctx, err
+	}
+	caller := types.CallerFromContext(ctx)
+	principal, ok := types.PrincipalFromContext(ctx)
+	if !ok || caller.TenantID != hold.Tenant || !principal.Valid() {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	if executionTenant, bound := types.TenantIDFromContext(ctx); bound && executionTenant != hold.Tenant {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	clean := tx.Session(&gorm.Session{NewDB: true, Context: ctx})
+	if err := lockMemoryPolicyAuthor(clean, ctx, hold.Tenant); err != nil {
+		return ctx, err
+	}
+	fresh, err := hold.Authorize(ctx, clean)
+	if err != nil {
+		return ctx, err
+	}
+	if fresh == nil {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	current := types.CallerFromContext(fresh)
+	currentPrincipal, currentOK := types.PrincipalFromContext(fresh)
+	if !currentOK || currentPrincipal != principal || current.TenantID != caller.TenantID || current.UserID != caller.UserID || !current.Role.IsValid() {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	return fresh, fresh.Err()
+}
