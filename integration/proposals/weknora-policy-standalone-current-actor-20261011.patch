diff --git a/internal/application/service/memory_policy_standalone_actor_sql_actual_test.go b/internal/application/service/memory_policy_standalone_actor_sql_actual_test.go
new file mode 100644
index 00000000..71ee524a
--- /dev/null
+++ b/internal/application/service/memory_policy_standalone_actor_sql_actual_test.go
@@ -0,0 +1,121 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"testing"
+)
+
+// Real canonical old-root fixture and settings producer. There is no model
+// context whose failure can incidentally cancel this standalone policy hold.
+func runMemoryPolicyStandaloneActorSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"current", "viewer_is_legal", "actor_disabled", "membership_removed", "caller_canceled", "missing_authority"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newJointOriginalUpgradeFixture(t, pg)
+			groups := NewGroupAccessService(repository.NewGroupAccessRepository(f.db))
+			tenant := repository.NewTenantRepository(f.db)
+			ConfigureTenantMemoryPolicyAuthority(tenant, f.store, groups, nil)
+			writer, ok := tenant.(interfaces.MemoryPolicyOriginalWriter)
+			require.True(t, ok)
+			_, proof, err := writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, types.MemoryConfig{Enabled: false, WriteMode: types.MemoryWriteAuto, ExtractInstructions: "Only retain explicitly stated preferences.", ExtractDelaySeconds: types.MinMemoryExtractDelaySeconds})
+			require.NoError(t, err)
+			require.NotNil(t, proof)
+			require.True(t, proof.Valid())
+			if mode == "missing_authority" {
+				unconfigured := repository.NewTenantRepository(f.db).(interfaces.MemoryPolicyOriginalLifetimeReader)
+				read, err := unconfigured.BeginMemoryPolicyOriginalRead(f.ctx, 7, *proof)
+				require.Error(t, err)
+				require.Nil(t, read)
+				jointOriginalLeaseState(t, f, false)
+				return
+			}
+			if mode == "viewer_is_legal" {
+				write := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Model(&types.TenantMember{}).Where("tenant_id=? AND user_id=? AND status=?", 7, f.userID, types.TenantMemberStatusActive).Update("role", types.TenantRoleViewer)
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+				var actual types.TenantMember
+				require.NoError(t, f.db.Session(&gorm.Session{NewDB: true}).Where("tenant_id=? AND user_id=?", 7, f.userID).Take(&actual).Error)
+				require.Equal(t, types.TenantRoleViewer, actual.Role)
+			}
+			ctx, cancel := context.WithCancel(f.ctx)
+			t.Cleanup(cancel)
+			reader := tenant.(interfaces.MemoryPolicyOriginalLifetimeReader)
+			read, err := reader.BeginMemoryPolicyOriginalRead(ctx, 7, *proof)
+			require.NoError(t, err)
+			require.NotNil(t, read)
+			closed := false
+			t.Cleanup(func() {
+				if !closed {
+					if err := read.Close(); err != nil {
+						t.Error("close genuine standalone policy hold failed")
+					}
+				}
+			})
+			cfg, bound, err := read.Policy()
+			require.NoError(t, err)
+			require.NotNil(t, cfg)
+			require.Equal(t, *proof, *bound)
+			jointOriginalLeaseState(t, f, true)
+			refuse := false
+			switch mode {
+			case "actor_disabled":
+				write := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Model(&types.User{}).Where("id=? AND is_active=?", f.userID, true).Update("is_active", false)
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+				var actual types.User
+				require.NoError(t, f.db.Session(&gorm.Session{NewDB: true}).Where("id=?", f.userID).Take(&actual).Error)
+				require.False(t, actual.IsActive)
+				refuse = true
+			case "membership_removed":
+				write := f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}).Where("tenant_id=? AND user_id=?", 7, f.userID).Delete(&types.TenantMember{})
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+				var remaining int64
+				require.NoError(t, f.db.Session(&gorm.Session{NewDB: true}).Model(&types.TenantMember{}).Where("tenant_id=? AND user_id=?", 7, f.userID).Count(&remaining).Error)
+				require.Zero(t, remaining)
+				refuse = true
+			case "caller_canceled":
+				cancel()
+				refuse = true
+			}
+			var refusal error
+			if refuse {
+				refusal = read.Recheck()
+				require.Error(t, refusal)
+				cfg, bound, err = read.Policy()
+				require.Error(t, err)
+				require.True(t, errors.Is(err, refusal))
+				require.Nil(t, cfg)
+				require.Nil(t, bound)
+			} else {
+				require.NoError(t, read.Recheck())
+				cfg, bound, err = read.Policy()
+				require.NoError(t, err)
+				require.NotNil(t, cfg)
+				require.Equal(t, *proof, *bound)
+			}
+			firstClose := read.Close()
+			closed = true
+			require.NoError(t, firstClose)
+			jointOriginalLeaseState(t, f, false)
+			secondClose := read.Close()
+			if refuse {
+				require.Error(t, secondClose)
+				require.True(t, errors.Is(secondClose, refusal))
+			} else {
+				require.NoError(t, secondClose)
+			}
+		})
+	}
+}
+func TestMemoryPolicyStandaloneCurrentActorActualSQLite(t *testing.T) {
+	runMemoryPolicyStandaloneActorSQL(t, false)
+}
+func TestPostgresMemoryPolicyStandaloneCurrentActorActual(t *testing.T) {
+	runMemoryPolicyStandaloneActorSQL(t, true)
+}
