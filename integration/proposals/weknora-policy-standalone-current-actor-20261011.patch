+	if r.authorityFactory == nil || tx == nil {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true, Context: ctx}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	if err := authority.CheckRuntime(ctx); err != nil {
+		return ctx, err
+	}
+	return authority.Store.RefreshCurrentReadActor(ctx)
