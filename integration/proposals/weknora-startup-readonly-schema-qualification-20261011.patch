+				require.Equal(t, 1, consumerCalls)
+				require.NotNil(t, started)
+				pool, poolErr := started.DB()
+				require.NoError(t, poolErr)
+				t.Cleanup(func() {
+					if err := pool.Close(); err != nil {
+						t.Errorf("close actual started pool: %v", err)
+					}
+				})
+				require.NoError(t, database.VerifyJointSchemaReady(context.Background(), dsn, opts), "production retention wrapper remains a legal exact witness")
+				require.NoError(t, database.VerifyJointSchemaReadyOnDB(context.Background(), pool, "sqlite"))
+				var seq int
