+				default:
+					require.True(t, errors.Is(err, database.ErrJointSchemaUnknown))
+				}
+				require.Equal(t, beforeSchema, startupSchemaSnapshot(t, inspectDB), "refused startup has no retention/producer/postmigration DDL")
+				require.Equal(t, beforeLedger, startupSchemaLedger(t, inspectDB), "no initialized ledger or Force")
+				if mode != "unknown_historyless_auto" {
+					var afterCount int
+					require.NoError(t, inspectDB.QueryRow("SELECT count(*) FROM memory_original_admissions").Scan(&afterCount))
+					require.Equal(t, originalCount, afterCount)
+				}
+			}
+			entries, err := os.ReadDir(filepath.Dir(path))
+			require.NoError(t, err)
+			for _, entry := range entries {
+				require.Contains(t, []string{filepath.Base(path), filepath.Base(path) + "-wal", filepath.Base(path) + "-shm"}, entry.Name(), "no shortened/alternate filename or WAL may be created")
+			}
+			var marker string
+			require.NoError(t, inspectDB.QueryRow("SELECT value FROM owned_startup_marker WHERE id=1").Scan(&marker))
+			require.Equal(t, "preserved-marker", marker)
+		})
+	}
+}
