+			if mode == "missing_module_auto" {
+				_, err := inspectDB.Exec("DROP TABLE nextcloud_root_migrations")
+				require.NoError(t, err)
+			}
+			if mode == "changed_source_external" {
+				copied := startupSchemaSource(t, root, 87)
+				file := filepath.Join(copied, "migrations", "sqlite", "000087_nextcloud_graph_recovery_fence.up.sql")
+				body, err := os.ReadFile(file)
+				require.NoError(t, err)
+				require.NoError(t, os.WriteFile(file, append(body, []byte("\n-- source identity negative\n")...), 0600))
+				startupSchemaChdir(t, copied)
