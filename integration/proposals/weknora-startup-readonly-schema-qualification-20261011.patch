@@ -0,0 +1,43 @@
+package database
+
+import (
+	"context"
+	"regexp"
+)
+
+// Metadata only: the phase and object come from the compiled catalogue/witness,
+// never actual source SQL/arguments/rows/trigger bodies or credential material.
+type JointSchemaCataloguePhaseObservation struct {
+	Phase  string
+	Object string
+	Failed bool
+}
+type jointSchemaCataloguePhaseObserverKey struct{}
+type jointSchemaCataloguePhaseObserver func(JointSchemaCataloguePhaseObservation)
+
+var jointSchemaCatalogueDiagnosticObject = regexp.MustCompile(`^[a-z_][a-z0-9_]*(\.[a-z_][a-z0-9_]*)?$`)
+
+func WithJointSchemaCataloguePhaseObserver(ctx context.Context, observer func(JointSchemaCataloguePhaseObservation)) context.Context {
+	if ctx == nil || observer == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, jointSchemaCataloguePhaseObserverKey{}, jointSchemaCataloguePhaseObserver(observer))
+}
+func observeJointSchemaCataloguePhase(ctx context.Context, phase, object string, failed bool) {
+	if ctx == nil {
+		return
+	}
+	observer, _ := ctx.Value(jointSchemaCataloguePhaseObserverKey{}).(jointSchemaCataloguePhaseObserver)
+	if observer == nil {
+		return
+	}
+	switch phase {
+	case "expected_catalogue", "source_witness", "objects", "sentinel_kinds", "sentinel_column", "table", "withdrawal_kind", "columns", "functions", "trigger", "optional_embedding_trigger", "indexes":
+	default:
+		return
+	}
+	if object != "" && !jointSchemaCatalogueDiagnosticObject.MatchString(object) {
+		return
+	}
+	observer(JointSchemaCataloguePhaseObservation{Phase: phase, Object: object, Failed: failed})
+}
