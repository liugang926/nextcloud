diff --git a/internal/container/database_schema_initial_ping_cleanup_test.go b/internal/container/database_schema_initial_ping_cleanup_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6b7e5615630ece0f03a075e3b5d90fe98682ec19
--- /dev/null
+++ b/internal/container/database_schema_initial_ping_cleanup_test.go
@@ -0,0 +1,75 @@
+package container
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+// This driver tests only actual GORM initial Ping/Close lifecycle. It provides
+// no schema, row, body, original, successful authorization or app readiness.
+type startupPingFaultDriver struct{ state *startupPingFaultState }
+type startupPingFaultState struct {
+	pingErr, closeErr                error
+	opens, pings, closes, statements atomic.Int32
+}
+type startupPingFaultConn struct{ state *startupPingFaultState }
+
+func (d *startupPingFaultDriver) Open(string) (driver.Conn, error) {
+	d.state.opens.Add(1)
+	return &startupPingFaultConn{state: d.state}, nil
+}
+func (c *startupPingFaultConn) Prepare(string) (driver.Stmt, error) {
+	c.state.statements.Add(1)
+	return nil, errors.New("startup_cleanup_driver_has_no_SQL_authority")
+}
+func (c *startupPingFaultConn) Begin() (driver.Tx, error) {
+	c.state.statements.Add(1)
+	return nil, errors.New("startup_cleanup_driver_has_no_transaction_authority")
+}
+func (c *startupPingFaultConn) Close() error { c.state.closes.Add(1); return c.state.closeErr }
+func (c *startupPingFaultConn) Ping(context.Context) error {
+	c.state.pings.Add(1)
+	return c.state.pingErr
+}
+
+var startupPingDriverSequence atomic.Uint64
+
+func TestDatabaseStartupInitialPingFailureClosesActualPool(t *testing.T) {
+	for _, mode := range []string{"ping_only", "ping_and_close_failure"} {
+		t.Run(mode, func(t *testing.T) {
+			pingCause := errors.New("actual_startup_driver_ping_failure")
+			state := &startupPingFaultState{pingErr: pingCause}
+			if mode == "ping_and_close_failure" {
+				state.closeErr = errors.New("actual_startup_driver_close_failure")
+			}
+			name := fmt.Sprintf("owned_startup_ping_driver_%d", startupPingDriverSequence.Add(1))
+			sql.Register(name, &startupPingFaultDriver{state: state})
+			pool, err := sql.Open(name, "")
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = pool.Close() })
+			opened, err := openStartupDatabase(postgres.New(postgres.Config{Conn: pool, WithoutReturning: true}), &gorm.Config{Logger: gormlogger.Discard})
+			require.Nil(t, opened, "a Ping-refused handle must never transfer to DI")
+			require.ErrorIs(t, err, pingCause)
+			if state.closeErr != nil {
+				require.ErrorIs(t, err, state.closeErr)
+			}
+			require.Equal(t, int32(1), state.opens.Load())
+			require.Equal(t, int32(1), state.pings.Load())
+			require.Equal(t, int32(1), state.closes.Load(), "the actual driver connection must be closed before returning refusal")
+			require.Zero(t, state.statements.Load(), "cleanup fixture must mint no fake schema or grants")
+			require.Error(t, pool.Ping(), "the actual SQL pool is closed, not just hidden by a nil return")
+			require.Equal(t, int32(1), state.pings.Load())
+			require.Equal(t, int32(1), state.closes.Load())
+		})
+	}
+}
diff --git a/internal/container/database_schema_ready.go b/internal/container/database_schema_ready.go
new file mode 100644
index 0000000000000000000000000000000000000000..693df4a18c95326bea4e821e6db0bad45106ae12
--- /dev/null
+++ b/internal/container/database_schema_ready.go
@@ -0,0 +1,42 @@
+package container
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"gorm.io/gorm"
+
+	"github.com/Tencent/WeKnora/internal/database"
+)
+
+// A migration refusal is terminal for database DI. Disabling automatic Up
+// changes who installs the schema, never whether the installed schema is ready.
+func bootstrapDatabaseSchema(ctx context.Context, dsn string, opts database.MigrationOptions, autoMigrate bool) error {
+	if autoMigrate {
+		if err := database.RunMigrationsWithContext(ctx, dsn, opts); err != nil {
+			return fmt.Errorf("database schema migration refused: %w", err)
+		}
+	}
+	if err := database.VerifyJointSchemaReady(ctx, dsn, opts); err != nil {
+		return fmt.Errorf("database schema startup readiness refused: %w", err)
+	}
+	return nil
+}
+
+// GORM can return a non-nil initialized handle with an automatic Ping error.
+// No failing initial pool has transferred to DI, so release it and retain both
+// initialization and cleanup causes. A prior Initialize Close is idempotent.
+func openStartupDatabase(dialector gorm.Dialector, cfg *gorm.Config) (*gorm.DB, error) {
+	opened, err := gorm.Open(dialector, cfg)
+	if err == nil {
+		return opened, nil
+	}
+	if opened == nil {
+		return nil, err
+	}
+	pool, poolErr := opened.DB()
+	if poolErr != nil {
+		return nil, errors.Join(err, poolErr)
+	}
+	return nil, errors.Join(err, pool.Close())
+}
