+func TestSQLiteLegacy42SpecialFilenamePreflightActual(t *testing.T) {
+	for _, mode := range []string{"empty_actual_upgrade", "observed_legacy_decommission_refused_clean"} {
+		t.Run(mode, func(t *testing.T) {
+			root := sqliteRepoRoot(t)
+			prefix := copySQLiteMigrationsThrough(t, root, 42)
+			path := filepath.Join(t.TempDir(), "legacy42 database ? # %.db")
+			raw, err := jointSQLiteFilenameDSN(path, "rwc")
+			require.NoError(t, err)
+			setup, err := sql.Open("sqlite3", raw)
+			require.NoError(t, err)
+			t.Cleanup(func() {
+				if err := setup.Close(); err != nil {
+					t.Errorf("close owned42 preparation pool: %v", err)
+				}
+			})
+			actualDriver, err := sqlite3migrate.WithInstance(setup, &sqlite3migrate.Config{})
+			require.NoError(t, err)
+			m, err := migrate.NewWithDatabaseInstance("file://"+filepath.Join(prefix, "migrations", "sqlite"), "sqlite3", actualDriver)
+			require.NoError(t, err)
+			migrationClosed := false
+			t.Cleanup(func() {
+				if !migrationClosed {
+					se, de := m.Close()
+					if se != nil {
+						t.Errorf("close owned42 source: %v", se)
+					}
+					if de != nil {
+						t.Errorf("close owned42 driver: %v", de)
+					}
+				}
+			})
+			require.NoError(t, m.Migrate(42), "actual canonical predecessor is installed at its honest old version")
+			se, de := m.Close()
+			migrationClosed = true
+			require.NoError(t, se)
+			require.NoError(t, de)
+			runtimeDSN, err := SQLiteRuntimeDSN(path)
+			require.NoError(t, err)
+			db, err := sql.Open("sqlite3", runtimeDSN)
+			require.NoError(t, err)
+			t.Cleanup(func() {
+				if err := db.Close(); err != nil {
+					t.Errorf("close actual legacy42 pool: %v", err)
+				}
+			})
+			if mode == "observed_legacy_decommission_refused_clean" {
+				// Negative-only old observed operation, same untrusted legacy shape
+				// as the existing42 safety gate. This is no valid current original,
+				// signed source, read grant, successful decommission or fake ledger.
+				statements := []string{
+					`INSERT INTO tenants(id,name,business) VALUES(7,'paired','test')`,
+					`INSERT INTO knowledge_bases(id,name,tenant_id,embedding_model_id,summary_model_id) VALUES('kb-review','review',7,'embed','summary')`,
+					`INSERT INTO data_sources(id,tenant_id,knowledge_base_id,name,type,config,status) VALUES('ds-review',7,'kb-review','review','nextcloud','{}','paused')`,
+					`INSERT INTO nextcloud_source_pairings(operation_id,tenant_id,knowledge_base_id,datasource_id,nextcloud_instance_id,binding_id,datasource_base_url,datasource_config_sha256,publication_epoch,key_id,state) VALUES('pair-review',7,'kb-review','ds-review','instance','binding','https://nextcloud.example','hash',1,'pair_key','pending')`,
+					`INSERT INTO nextcloud_source_decommissions(operation_id,pair_operation_id,tenant_id,knowledge_base_id,datasource_id,nextcloud_instance_id,binding_id,publication_epoch,key_id,state) VALUES('decommission-review','pair-review',7,'kb-review','ds-review','instance','binding',1,'pair_key','prepared')`,
+				}
+				for _, statement := range statements {
+					_, err := db.Exec(statement)
+					require.NoError(t, err)
+				}
+			}
+			before := memoryFullSchemaSnapshot(t, db, "sqlite")
+			version, dirty := sqliteMigrationState(t, db)
+			require.Equal(t, 42, version)
+			require.False(t, dirty)
+			chdirAndRestore(t, root)
+			opts := MigrationOptions{SQLiteDBPath: path, AutoRecoverDirty: true}
+			err = RunMigrationsWithOptions("sqlite3://"+path, opts)
+			if mode == "empty_actual_upgrade" {
+				require.NoError(t, err)
+				version, dirty = sqliteMigrationState(t, db)
+				require.Equal(t, 87, version)
+				require.False(t, dirty)
+				require.NoError(t, VerifyJointSchemaReady(context.Background(), "sqlite3://"+path, opts))
+			} else {
+				require.ErrorContains(t, err, "review existing Nextcloud decommissions")
+				version, dirty = sqliteMigrationState(t, db)
+				require.Equal(t, 42, version)
+				require.False(t, dirty)
+				require.Equal(t, before, memoryFullSchemaSnapshot(t, db, "sqlite"), "refusal precedes migration43 dirty or schema writes")
+				var state string
