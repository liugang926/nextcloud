+func TestJointSchemaStartupActualOpenedSQLitePool(t *testing.T) {
+	root := sqliteRepoRoot(t)
+	chdirAndRestore(t, root)
+	directory := t.TempDir()
+	path := filepath.Join(directory, "complete database ? # %.db")
+	opts := MigrationOptions{SQLiteDBPath: path}
+	require.NoError(t, RunMigrationsWithOptions("sqlite3://"+path, opts), "real writable canonical bootstrap must create the exact requested filename")
+	raw, err := SQLiteRuntimeDSN(path)
+	require.NoError(t, err)
+	pool, err := sql.Open("sqlite3", raw)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		if err := pool.Close(); err != nil {
+			t.Errorf("close actual qualified runtime pool: %v", err)
+		}
+	})
+	require.NoError(t, VerifyJointSchemaReadyOnDB(context.Background(), pool, "sqlite"))
+	var seq int
+	var name, actualPath string
+	require.NoError(t, pool.QueryRow("PRAGMA database_list").Scan(&seq, &name, &actualPath))
+	require.Equal(t, "main", name)
+	require.Equal(t, path, actualPath)
+	foreignPath := filepath.Join(t.TempDir(), "unqualified-other.db")
+	foreignDSN, err := jointSQLiteFilenameDSN(foreignPath, "rwc")
+	require.NoError(t, err)
+	foreign, err := sql.Open("sqlite3", foreignDSN)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		if err := foreign.Close(); err != nil {
+			t.Errorf("close owned rejected runtime pool: %v", err)
+		}
+	})
+	_, err = foreign.Exec("CREATE TABLE actual_wrong_pool_sentinel(id INTEGER PRIMARY KEY,marker TEXT NOT NULL)")
+	require.NoError(t, err)
+	_, err = foreign.Exec("INSERT INTO actual_wrong_pool_sentinel(id,marker) VALUES(1,'wrong-pool-preserved')")
+	require.NoError(t, err)
+	before := memoryFullSchemaSnapshot(t, foreign, "sqlite")
+	require.NoError(t, VerifyJointSchemaReady(context.Background(), "sqlite3://"+path, opts), "the requested file remains legitimately complete")
+	require.ErrorIs(t, VerifyJointSchemaReadyOnDB(context.Background(), foreign, "sqlite"), ErrJointSchemaUnknown, "checking the qualified filename cannot authorize an actually different pool")
+	require.Equal(t, before, memoryFullSchemaSnapshot(t, foreign, "sqlite"))
+	var marker string
+	require.NoError(t, foreign.QueryRow("SELECT marker FROM actual_wrong_pool_sentinel WHERE id=1").Scan(&marker))
+	require.Equal(t, "wrong-pool-preserved", marker)
+	entries, err := os.ReadDir(directory)
+	require.NoError(t, err)
+	for _, entry := range entries {
+		require.Contains(t, []string{filepath.Base(path), filepath.Base(path) + "-wal", filepath.Base(path) + "-shm"}, entry.Name())
+	}
+}
