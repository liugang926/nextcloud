+			startupCtx := context.Background()
+			if os.Getenv("WEKNORA_JOINT_SCHEMA_CATALOGUE_PHASE_DIAGNOSTIC") == "1" {
+				startupCtx = database.WithJointSchemaCataloguePhaseObserver(startupCtx, func(value database.JointSchemaCataloguePhaseObservation) {
+					t.Logf("joint_schema_catalogue_phase phase=%s object=%s failed=%t", value.Phase, value.Object, value.Failed)
+				})
+			}
+			require.NoError(t, container.Provide(func() (*gorm.DB, error) { return initDatabaseWithContext(startupCtx, &config.Config{}) }))
+			type readyConsumer struct{ db *gorm.DB }
+			consumerCalls := 0
+			require.NoError(t, container.Provide(func(db *gorm.DB) *readyConsumer { consumerCalls++; return &readyConsumer{db: db} }))
