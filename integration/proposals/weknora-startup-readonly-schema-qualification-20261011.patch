@@ -0,0 +1,45 @@
+package database
+
+import (
+	"net/url"
+	"path/filepath"
+)
+
+func jointSQLiteFilenameDSN(path, mode string) (string, error) {
+	if path == ":memory:" && mode == "rwc" {
+		return path, nil
+	}
+	if path == "" || path == ":memory:" || (mode != "ro" && mode != "rw" && mode != "rwc") {
+		return "", ErrJointSchemaUnavailable
+	}
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return "", ErrJointSchemaUnavailable
+	}
+	uri := url.URL{Scheme: "file", Path: absolute}
+	query := url.Values{"mode": {mode}}
+	if mode == "ro" {
+		query.Set("_query_only", "on")
+	}
+	uri.RawQuery = query.Encode()
+	return uri.String(), nil
+}
+
+// SQLiteRuntimeDSN consumes the same filename as migration/readiness. It can
+// open an existing qualified database, never silently create an alternate file.
+func SQLiteRuntimeDSN(path string) (string, error) {
+	raw, err := jointSQLiteFilenameDSN(path, "rw")
+	if err != nil {
+		return "", err
+	}
+	uri, err := url.Parse(raw)
+	if err != nil {
+		return "", ErrJointSchemaUnavailable
+	}
+	query := uri.Query()
+	query.Set("_journal_mode", "WAL")
+	query.Set("_busy_timeout", "5000")
+	query.Set("_foreign_keys", "on")
+	uri.RawQuery = query.Encode()
+	return uri.String(), nil
+}
