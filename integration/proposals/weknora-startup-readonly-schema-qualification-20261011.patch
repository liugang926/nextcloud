diff --git a/internal/database/migration_joint_ready.go b/internal/database/migration_joint_ready.go
new file mode 100644
index 0000000000000000000000000000000000000000..5e044eebea255b01e070693055603175bea94fab
--- /dev/null
+++ b/internal/database/migration_joint_ready.go
@@ -0,0 +1,89 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+)
+
+var ErrJointSchemaNotReady = errors.New("joint_schema_not_ready_for_application_startup")
+
+// VerifyJointSchemaReady is read-only: no migrate driver, Up, Force, ledger
+// creation, body producer, installer or grant is invoked. A clean supported
+// prefix can be eligible for migration without being ready for this app.
+func VerifyJointSchemaReady(ctx context.Context, dsn string, opts MigrationOptions) error {
+	if ctx == nil {
+		return ErrJointSchemaUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	// Both the initial ledger observer and every catalogue connection are
+	// truly read-only for readiness; SQL-only inspection must not create a DB.
+	opts.jointReadOnly = true
+	version, dirty, known, err := observeJointSchemaHistoryBeforeDriver(ctx, dsn, opts)
+	if err != nil {
+		return err
+	}
+	if err := preflightJointSchemaLineage(ctx, dsn, opts, version, dirty, known); err != nil {
+		return err
+	}
+	witness, err := jointLineageWitnessesFromSource()
+	if err != nil {
+		return err
+	}
+	var latest uint
+	for _, module := range witness.Modules[jointLineageDialect(dsn, opts)] {
+		if module.Version > latest {
+			latest = module.Version
+		}
+	}
+	if latest == 0 || !known || dirty || version != latest {
+		return ErrJointSchemaNotReady
+	}
+	return ctx.Err()
+}
+
+// VerifyJointSchemaReadyOnDB qualifies the pool that will actually serve the
+// app. It never reopens a DSN/path or initializes a migrate driver/ledger.
+func VerifyJointSchemaReadyOnDB(ctx context.Context, db *sql.DB, dialect string) error {
+	if ctx == nil || db == nil {
+		return ErrJointSchemaUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if dialect == "postgres" {
+		dialect = "versioned"
+	}
+	if dialect != "versioned" && dialect != "sqlite" {
+		return ErrJointSchemaUnavailable
+	}
+	witness, err := jointLineageWitnessesFromSource()
+	if err != nil {
+		return err
+	}
+	if err := jointLineageVerifyAvailableSources(dialect, witness); err != nil {
+		return err
+	}
+	version, dirty, known, err := observeJointSchemaHistoryOnDB(ctx, db, dialect)
+	if err != nil {
+		return err
+	}
+	if dirty && version >= jointLineageFirstVersion(dialect) {
+		return ErrJointSchemaAmbiguousDirty
+	}
+	var latest uint
+	for _, module := range witness.Modules[dialect] {
+		if module.Version > latest {
+			latest = module.Version
+		}
+	}
+	if latest == 0 || !known || dirty || version != latest {
+		return ErrJointSchemaNotReady
+	}
+	if err := verifyJointRootCatalogue(ctx, db, dialect, version); err != nil {
+		return err
+	}
+	return ctx.Err()
+}
diff --git a/internal/database/migration_joint_ready_sql_actual_test.go b/internal/database/migration_joint_ready_sql_actual_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6b4dbad44c861329298187c5424fb616b835556c
--- /dev/null
+++ b/internal/database/migration_joint_ready_sql_actual_test.go
@@ -0,0 +1,198 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/golang-migrate/migrate/v4"
+	"github.com/stretchr/testify/require"
+)
+
+func runJointSchemaStartupReadinessActual(t *testing.T, pg bool) {
+	for _, mode := range []string{"full_clean_readonly", "clean_root_prefix_not_ready", "genuine_dirty_no_force", "unknown_historyless_no_ledger", "missing_current_module", "changed_source_no_mutation", "canceled_readonly"} {
+		t.Run(mode, func(t *testing.T) {
+			root := sqliteRepoRoot(t)
+			chdirAndRestore(t, root)
+			db, dsn, opts := jointLineageFixture(t, pg)
+			dialect, latest, prefix := "sqlite", uint(87), uint(75)
+			actualDSN := "sqlite3://" + opts.SQLiteDBPath
+			if pg {
+				dialect, latest, prefix = "versioned", 168, 156
+				actualDSN = dsn
+			}
+			if mode == "clean_root_prefix_not_ready" {
+				copied := jointLineageCopiedSource(t, root, dialect, prefix)
+				m, err := migrate.New("file://"+filepath.Join(copied, "migrations", dialect), actualDSN)
+				require.NoError(t, err)
+				require.NoError(t, m.Up(), "real exact canonical prefix is eligible for Up, not app startup")
+				se, de := m.Close()
+				require.NoError(t, se)
+				require.NoError(t, de)
+			} else if mode != "unknown_historyless_no_ledger" {
+				require.NoError(t, RunMigrationsWithOptions(dsn, opts), "positive preparation is a complete actual production upgrade")
+				version, dirty := jointLineageMigrationState(t, db)
+				require.Equal(t, latest, version)
+				require.False(t, dirty)
+			}
+			requireStartupSentinel(t, db)
+			if mode == "genuine_dirty_no_force" {
+				copied := jointLineageCopiedSource(t, root, dialect, latest)
+				fault := filepath.Join(copied, "migrations", dialect, fmt.Sprintf("%06d_owned_startup_failure.up.sql", latest+1))
+				require.NoError(t, os.WriteFile(fault, []byte("SELECT * FROM owned_missing_startup_fault;\n"), 0600))
+				m, err := migrate.New("file://"+filepath.Join(copied, "migrations", dialect), actualDSN)
+				require.NoError(t, err)
+				require.Error(t, m.Up(), "real failed SQL produces dirty history; no direct ledger edits")
+				se, de := m.Close()
+				require.NoError(t, se)
+				require.NoError(t, de)
+				version, dirty := jointLineageMigrationState(t, db)
+				require.Equal(t, latest+1, version)
+				require.True(t, dirty)
+			}
+			if mode == "missing_current_module" {
+				_, err := db.Exec("DROP TABLE nextcloud_root_migrations")
+				require.NoError(t, err, "actual current module loss; no invented witness")
+			}
+			if mode == "changed_source_no_mutation" {
+				copied := jointLineageCopiedSource(t, root, dialect, latest)
+				paths, err := filepath.Glob(filepath.Join(copied, "migrations", dialect, fmtJointVersion(latest)+"_*.up.sql"))
+				require.NoError(t, err)
+				require.Len(t, paths, 1)
+				body, err := os.ReadFile(paths[0])
+				require.NoError(t, err)
+				require.NoError(t, os.WriteFile(paths[0], append(body, []byte("\n-- owned source identity fault\n")...), 0600))
+				chdirAndRestore(t, copied)
+			}
+			before := memoryFullSchemaSnapshot(t, db, dialect)
+			ledger := startupReadinessLedger(t, db, dialect)
+			ctx := context.Background()
+			if mode == "canceled_readonly" {
+				var cancel context.CancelFunc
+				ctx, cancel = context.WithCancel(ctx)
+				cancel()
+			}
+			err := VerifyJointSchemaReady(ctx, dsn, opts)
+			switch mode {
+			case "full_clean_readonly":
+				require.NoError(t, err)
+				require.NoError(t, VerifyJointSchemaReady(ctx, dsn, opts), "repeat startup validates exact full catalogue again")
+			case "clean_root_prefix_not_ready":
+				require.ErrorIs(t, err, ErrJointSchemaNotReady)
+			case "genuine_dirty_no_force":
+				require.ErrorIs(t, err, ErrJointSchemaAmbiguousDirty)
+			case "changed_source_no_mutation":
+				require.ErrorIs(t, err, ErrJointSchemaSourceIdentity)
+			case "canceled_readonly":
+				require.ErrorIs(t, err, context.Canceled)
+			default:
+				require.ErrorIs(t, err, ErrJointSchemaUnknown)
+			}
+			require.Equal(t, before, memoryFullSchemaSnapshot(t, db, dialect), "readiness has no schema/driver/installer effects")
+			require.Equal(t, ledger, startupReadinessLedger(t, db, dialect), "no ledger creation or Force")
+			var value string
+			require.NoError(t, db.QueryRow("SELECT marker FROM owned_startup_sentinel WHERE id=1").Scan(&value))
+			require.Equal(t, "unchanged-startup-marker", value)
+		})
+	}
+}
+
+func requireStartupSentinel(t *testing.T, db *sql.DB) {
+	t.Helper()
+	_, err := db.Exec("CREATE TABLE owned_startup_sentinel(id INTEGER PRIMARY KEY,marker TEXT NOT NULL)")
+	require.NoError(t, err)
+	_, err = db.Exec("INSERT INTO owned_startup_sentinel(id,marker) VALUES(1,'unchanged-startup-marker')")
+	require.NoError(t, err)
+}
+
+func startupReadinessLedger(t *testing.T, db *sql.DB, dialect string) []string {
+	t.Helper()
+	query := "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='schema_migrations'"
+	if dialect == "versioned" {
+		query = "SELECT count(*) FROM information_schema.tables WHERE table_schema=current_schema() AND table_name='schema_migrations'"
+	}
+	var count int
+	require.NoError(t, db.QueryRow(query).Scan(&count))
+	if count == 0 {
+		return nil
+	}
+	version, dirty := jointLineageMigrationState(t, db)
+	return []string{fmt.Sprint(version), fmt.Sprint(dirty)}
+}
