+package container
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/config"
+	"github.com/Tencent/WeKnora/internal/database"
+	"github.com/golang-migrate/migrate/v4"
+	sqlite3migrate "github.com/golang-migrate/migrate/v4/database/sqlite3"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/dig"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+)
+
+func startupSchemaRepoRoot(t *testing.T) string {
+	t.Helper()
+	root, err := filepath.Abs(filepath.Join("..", ".."))
+	require.NoError(t, err)
+	_, err = os.Stat(filepath.Join(root, "migrations", "sqlite", "000087_nextcloud_graph_recovery_fence.up.sql"))
+	require.NoError(t, err)
+	return root
+}
+
+func startupSchemaChdir(t *testing.T, path string) {
+	t.Helper()
+	old, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(path))
+	t.Cleanup(func() {
+		if err := os.Chdir(old); err != nil {
+			t.Errorf("restore owned startup cwd: %v", err)
+		}
+	})
+}
+
+func startupSchemaSource(t *testing.T, root string, through uint) string {
+	t.Helper()
+	copyRoot := t.TempDir()
+	directory := filepath.Join(copyRoot, "migrations", "sqlite")
+	require.NoError(t, os.MkdirAll(directory, 0700))
+	paths, err := filepath.Glob(filepath.Join(root, "migrations", "sqlite", "*.up.sql"))
+	require.NoError(t, err)
+	for _, path := range paths {
+		var version uint
+		_, err := fmt.Sscanf(filepath.Base(path), "%d_", &version)
+		require.NoError(t, err)
+		if version > through {
+			continue
+		}
+		body, err := os.ReadFile(path)
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(filepath.Join(directory, filepath.Base(path)), body, 0600))
+	}
+	return copyRoot
+}
+
+func startupSchemaSnapshot(t *testing.T, db *sql.DB) []string {
+	t.Helper()
+	rows, err := db.Query("SELECT type,name,COALESCE(sql,'') FROM sqlite_master WHERE name NOT LIKE 'sqlite_%' ORDER BY type,name")
+	require.NoError(t, err)
+	defer rows.Close()
+	var result []string
+	for rows.Next() {
+		var kind, name, definition string
+		require.NoError(t, rows.Scan(&kind, &name, &definition))
+		result = append(result, kind+"|"+name+"|"+definition)
+	}
+	require.NoError(t, rows.Err())
+	return result
+}
+
+func startupSchemaLedger(t *testing.T, db *sql.DB) []string {
+	t.Helper()
+	var exists int
+	require.NoError(t, db.QueryRow("SELECT count(*) FROM sqlite_master WHERE type='table' AND name='schema_migrations'").Scan(&exists))
+	if exists == 0 {
+		return nil
+	}
+	var version uint
+	var dirty bool
+	require.NoError(t, db.QueryRow("SELECT version,dirty FROM schema_migrations").Scan(&version, &dirty))
+	return []string{fmt.Sprint(version), fmt.Sprint(dirty)}
+}
+
+// Direct fixture migration uses the same escaped actual filename as the
+// production runtime. sqlite3 URL parsing is not a second filesystem identity.
+func startupSchemaOwnedMigrationDriver(t *testing.T, source, path string) (*migrate.Migrate, func() (error, error)) {
+	t.Helper()
+	raw, err := database.SQLiteRuntimeDSN(path)
+	require.NoError(t, err)
+	ownedURI, err := url.Parse(raw)
+	require.NoError(t, err)
+	query := ownedURI.Query()
+	query.Set("mode", "rwc")
+	ownedURI.RawQuery = query.Encode()
+	pool, err := sql.Open("sqlite3", ownedURI.String())
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		if err := pool.Close(); err != nil {
+			t.Errorf("close owned direct fixture pool: %v", err)
+		}
+	})
+	driver, err := sqlite3migrate.WithInstance(pool, &sqlite3migrate.Config{})
+	require.NoError(t, err)
+	m, err := migrate.NewWithDatabaseInstance("file://"+filepath.Join(source, "migrations", "sqlite"), "sqlite3", driver)
+	require.NoError(t, err)
+	closed := false
+	closeMigration := func() (error, error) {
+		if closed {
+			return nil, nil
+		}
+		closed = true
+		return m.Close()
+	}
+	t.Cleanup(func() {
+		se, de := closeMigration()
+		if se != nil {
+			t.Errorf("close owned fixture source: %v", se)
+		}
+		if de != nil {
+			t.Errorf("close owned fixture driver: %v", de)
+		}
+	})
+	var seq int
+	var name, actualPath string
+	require.NoError(t, pool.QueryRow("PRAGMA database_list").Scan(&seq, &name, &actualPath))
+	require.Equal(t, "main", name)
+	require.Equal(t, path, actualPath, "the real fixture migrate driver must share the requested actual database")
+	return m, closeMigration
+}
+
+func TestDatabaseStartupRejectsBeforePostMigrationActualSQLite(t *testing.T) {
+	for _, mode := range []string{"full_clean_auto", "full_clean_external", "unknown_historyless_auto", "dirty_auto", "clean_prefix_external", "missing_module_auto", "changed_source_external", "canceled_before_open", "missing_storage_external"} {
