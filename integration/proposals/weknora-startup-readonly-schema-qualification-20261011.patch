+			t.Setenv("AUTO_MIGRATE", "true")
+			t.Setenv("BUILTIN_MODELS_CONFIG", filepath.Join(t.TempDir(), "not-configured.yaml"))
+			if strings.HasSuffix(mode, "external") {
+				t.Setenv("AUTO_MIGRATE", "false")
+			}
+			if mode == "missing_storage_external" {
+				t.Setenv("AUTO_MIGRATE", "false")
+				path = filepath.Join(t.TempDir(), "missing ? # %.db")
+				t.Setenv("DB_PATH", path)
+				db, err := initDatabaseWithContext(context.Background(), &config.Config{})
