@@ -0,0 +1,312 @@
+package service
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+// A fixture configuration is authored before original capture, using the same
+// producer and independent current reader as the policy SQL contract tests.
+func authorMemNativeFixturePolicySQL(t *testing.T, f *memAtomicSQLFixture, cfg types.MemoryConfig) types.MemoryPolicyProof {
+	t.Helper()
+	_, writer, reader := actualPolicyRepository(t, f)
+	_, before, err := reader.ReadMemoryPolicyOriginal(f.ctx, f.scope.TenantID)
+	require.NoError(t, err)
+	require.NotNil(t, before)
+	require.True(t, before.Valid())
+	_, authored, err := writer.ReplaceMemoryPolicyOriginal(f.ctx, f.scope.TenantID, cfg)
+	require.NoError(t, err)
+	require.NotNil(t, authored)
+	require.True(t, authored.Valid())
+	require.Greater(t, authored.Revision, before.Revision)
+	_, _, independent := actualPolicyRepository(t, f)
+	actual, proof, err := independent.ReadMemoryPolicyOriginal(f.ctx, f.scope.TenantID)
+	require.NoError(t, err)
+	require.NotNil(t, proof)
+	require.True(t, proof.Valid())
+	require.Equal(t, *authored, *proof)
+	want, err := types.MemoryPolicyBytes(&cfg)
+	require.NoError(t, err)
+	got, err := types.MemoryPolicyBytes(actual)
+	require.NoError(t, err)
+	require.Equal(t, string(want), string(got))
+	require.Equal(t, types.MemoryOriginalBytesDigest(want), proof.PolicyDigest)
+	return *proof
+}
+
+// Assert the complete typed receipt, rather than treating every derived row
+// as a model item operation. These native transports emit no topic operation;
+// resident block rendering and capacity retirement are separate exact effects.
+func assertMemNativeOriginalEffectsSQL(t *testing.T, f *memAtomicSQLFixture, checkpointID string, expected map[string]int) {
+	t.Helper()
+	var receipt types.MemoryOriginalCheckpoint
+	require.NoError(t, f.db.Where("id=?", checkpointID).Take(&receipt).Error)
+	require.Equal(t, f.scope.TenantID, receipt.TenantID)
+	require.Equal(t, f.scope.SubjectID, receipt.SubjectID)
+	// Historical effect verification consumes the actual retained immutable
+	// envelope. The worker loader intentionally requires Pending=true and is
+	// not a history or recall API after a successful checkpoint drains it.
+	var original types.MemoryOriginalAdmission
+	require.NoError(t, f.db.Where("id=?", receipt.InputAdmissionID).Take(&original).Error)
+	input := &types.MemoryOriginalInput{}
+	require.NoError(t, json.Unmarshal([]byte(original.Envelope), input))
+	require.Equal(t, original.ID, input.ID)
+	require.Equal(t, original.Digest, input.Digest)
+	unsignedInput := *input
+	unsignedInput.Digest = ""
+	digest, err := repository.KnowledgeInputDigest(unsignedInput)
+	require.NoError(t, err)
+	require.Equal(t, original.Digest, digest, "the immutable full metadata envelope must verify independently")
+	require.Equal(t, f.scope.TenantID, original.TenantID)
+	require.Equal(t, f.scope.SubjectID, original.SubjectID)
+	require.Equal(t, receipt.SessionID, original.SessionID)
+	require.Equal(t, receipt.PendingRevision, original.PendingRevision)
+	require.Equal(t, original.TenantID, input.Request.TenantID)
+	require.Equal(t, original.SubjectID, input.Request.SubjectID)
+	require.Equal(t, original.SessionID, input.Request.SessionID)
+	require.Equal(t, original.PendingRevision, input.Request.PendingRevision)
+	require.Equal(t, original.PreviousAdmissionID, input.Request.PreviousAdmissionID)
+	require.Equal(t, input.Request.TenantID, input.Actor.CallerTenantID)
+	require.Equal(t, input.Request.SubjectID, input.Actor.Principal.StorageID())
+	require.Equal(t, types.CallerFromContext(f.ctx).UserID, input.Actor.UserID)
+	require.True(t, input.Request.EnqueuePolicyProof.Valid())
+	require.Equal(t, input.Request.EnqueuePolicyProof.PolicyDigest, input.Request.EnqueuePolicyDigest)
+	require.True(t, input.Request.EnqueueModelProof.Valid())
+	require.Equal(t, input.Request.EnqueueModelProof.ModelID, input.Request.EnqueueModelID)
+	require.Equal(t, input.Request.EnqueueModelProof.Digest, input.Request.EnqueueModelDigest)
+	require.NotNil(t, input.Plan)
+	require.NotNil(t, input.Material)
+	require.Empty(t, input.Material.Messages, "retained input metadata is not a current body read")
+	require.NoError(t, input.Plan.SourceLineage.RequireComplete())
+	require.Equal(t, input.Plan.MetadataDigest, input.Material.MetadataDigest)
+	require.NotEmpty(t, input.Plan.MetadataDigest)
+	requestDigest, err := repository.KnowledgeInputDigest(input.Request.MaterialRequest)
+	require.NoError(t, err)
+	for _, request := range []types.MessageMaterialReadRequest{input.Plan.Request, input.Material.Request} {
+		actual, err := repository.KnowledgeInputDigest(request)
+		require.NoError(t, err)
+		require.Equal(t, requestDigest, actual)
+	}
+	selected := map[string]bool{}
+	for _, id := range input.Request.MaterialRequest.MessageIDs {
+		require.NotEmpty(t, id)
+		require.False(t, selected[id])
+		selected[id] = true
+	}
+	require.True(t, selected[input.Request.TriggerMessageID])
+	require.Len(t, input.Material.Proofs, len(selected))
+	seenProofs := map[string]bool{}
+	for _, proof := range input.Material.Proofs {
+		require.NotNil(t, proof)
+		require.True(t, selected[proof.MessageID])
+		require.False(t, seenProofs[proof.MessageID])
+		seenProofs[proof.MessageID] = true
+		require.Equal(t, input.Request.TenantID, proof.TenantID)
+		require.Equal(t, input.Request.SessionID, proof.SessionID)
+		require.Equal(t, input.Material.SessionOwnerID, proof.OwnerID)
+		require.NotEmpty(t, proof.AdmissionID)
+		require.NotEmpty(t, proof.GenerationID)
+		require.Len(t, proof.BodyDigest, 64)
+		require.Positive(t, proof.Revision)
+		require.NoError(t, proof.SourceLineage.RequireComplete())
+		for _, field := range proof.GeneratedFields {
+			require.NotNil(t, field)
+			require.NotEmpty(t, field.AdmissionID)
+			require.Len(t, field.BodyDigest, 64)
+			require.Positive(t, field.Revision)
+			require.NoError(t, field.SourceLineage.RequireComplete())
+		}
+	}
+	require.Equal(t, input.Digest, receipt.InputDigest)
+	var execution types.MemoryOriginalExecution
+	require.NoError(t, f.db.Where("id=?", receipt.ExecutionAdmissionID).Take(&execution).Error)
+	require.Equal(t, input.ID, execution.InputAdmissionID)
+	require.Equal(t, input.Digest, execution.InputDigest)
+	unsignedExecution := execution
+	unsignedExecution.Digest = ""
+	executionDigest, err := repository.KnowledgeInputDigest(unsignedExecution)
+	require.NoError(t, err)
+	require.Equal(t, execution.Digest, executionDigest)
+	var model types.ModelOriginalProof
+	require.NoError(t, json.Unmarshal([]byte(execution.ModelProofJSON), &model))
+	require.True(t, model.Valid())
+	require.Equal(t, input.Request.EnqueueModelProof, model)
+	require.Equal(t, input.Request.EnqueueModelDigest, model.Digest)
+	require.Equal(t, execution.ModelDigest, model.Digest)
+	var effects []types.MemoryOriginalEffect
+	require.NoError(t, json.Unmarshal([]byte(receipt.OperationManifest), &effects))
+	digest, err = repository.KnowledgeInputDigest(effects)
+	require.NoError(t, err)
+	require.Equal(t, receipt.OperationsDigest, digest)
+	unsignedReceipt := receipt
+	unsignedReceipt.Digest = ""
+	digest, err = repository.KnowledgeInputDigest(unsignedReceipt)
+	require.NoError(t, err)
+	require.Equal(t, receipt.Digest, digest)
+	total := 0
+	for _, count := range expected {
+		total += count
+	}
+	require.Len(t, effects, total)
+	var origins []types.MemoryOriginalDerivation
+	require.NoError(t, f.db.Where("commit_id=?", receipt.ID).Find(&origins).Error)
+	require.Len(t, origins, total)
+	byID := map[string]types.MemoryOriginalDerivation{}
+	for _, origin := range origins {
+		_, duplicate := byID[origin.ID]
+		require.False(t, duplicate)
+		byID[origin.ID] = origin
+	}
+	seen := map[string]bool{}
+	actualCounts := map[string]int{}
+	publications := map[string]types.MemoryDerivedPublication{}
+	var block *types.MemoryDerivedBlock
+	for _, effect := range effects {
+		require.False(t, seen[effect.DerivationID], "no duplicate or unknown effect may disappear from the manifest")
+		seen[effect.DerivationID] = true
+		key := effect.ObjectKind + "/" + effect.Action
+		require.Contains(t, expected, key, "unexpected typed effect")
+		actualCounts[key]++
+		origin, ok := byID[effect.DerivationID]
+		require.True(t, ok)
+		require.Equal(t, types.MemoryOriginalEffect{OperationID: origin.OperationID, DerivationID: origin.ID, ObjectKind: origin.ObjectKind, ObjectID: origin.ObjectID, Action: origin.Action, BodyDigest: origin.BodyDigest, ParentDerivationID: origin.ParentDerivationID}, effect)
+		require.NotEmpty(t, origin.OperationID)
+		require.Equal(t, input.ID, origin.InputAdmissionID)
+		require.Equal(t, execution.ID, origin.ExecutionAdmissionID)
+		require.Equal(t, f.scope.TenantID, origin.TenantID)
+		require.Equal(t, f.scope.SubjectID, origin.SubjectID)
+		unsigned := origin
+		unsigned.Digest = ""
+		digest, err := repository.KnowledgeInputDigest(unsigned)
+		require.NoError(t, err)
+		require.Equal(t, origin.Digest, digest)
+		var dependency struct{ InputID, InputDigest, ExecutionID, ExecutionDigest, ModelResultDigest, Recipe, Parent, EffectRole string }
+		require.NoError(t, json.Unmarshal([]byte(origin.DependencyJSON), &dependency))
+		require.Equal(t, input.ID, dependency.InputID)
+		require.Equal(t, input.Digest, dependency.InputDigest)
+		require.Equal(t, execution.ID, dependency.ExecutionID)
+		require.Equal(t, execution.Digest, dependency.ExecutionDigest)
+		require.Equal(t, receipt.ModelResultDigest, dependency.ModelResultDigest)
+		require.Equal(t, receipt.Recipe, dependency.Recipe)
+		require.Equal(t, origin.ParentDerivationID, dependency.Parent)
+		roles := map[string]string{"memory_item/add": "model_result", "memory_item/archive": "capacity_retirement", "memory_block/render": "resident_block"}
+		require.Equal(t, roles[key], dependency.EffectRole)
+		var publication types.MemoryDerivedPublication
+		// This is an oracle for the real producer output, read through installed
+		// body callbacks. It neither creates a publication nor signs current data.
+		require.NoError(t, f.db.Where("derivation_id=?", origin.ID).Take(&publication).Error)
+		require.Equal(t, "worker", publication.ProducerKind)
+		require.Equal(t, input.ID, publication.InputAdmissionID)
+		require.Equal(t, execution.ID, publication.ExecutionAdmissionID)
+		require.Equal(t, receipt.ID, publication.CommitID)
+		require.Equal(t, origin.ObjectID, publication.ObjectID)
+		require.Equal(t, origin.ObjectKind, publication.ObjectKind)
+		require.Equal(t, f.scope.TenantID, publication.TenantID)
+		require.Equal(t, f.scope.SubjectID, publication.SubjectID)
+		require.Equal(t, origin.BodyDigest, publication.MaterialDigest)
+		require.Equal(t, types.MemoryOriginalBytesDigest([]byte(publication.MaterialJSON)), publication.MaterialSHA256)
+		unsignedPublication := publication
+		unsignedPublication.Digest = ""
+		unsignedPublication.MaterialJSON = ""
+		digest, err = repository.KnowledgeInputDigest(unsignedPublication)
+		require.NoError(t, err)
+		require.Equal(t, publication.Digest, digest)
+		var body types.MemoryDerivedBodyReceipt
+		require.NoError(t, f.db.Where("publication_id=?", publication.ID).Take(&body).Error)
+		require.Equal(t, publication.Digest, body.PublicationDigest)
+		require.Equal(t, publication.MaterialSHA256, body.MaterialSHA256)
+		unsignedBody := body
+		unsignedBody.Digest = ""
+		digest, err = repository.KnowledgeInputDigest(unsignedBody)
+		require.NoError(t, err)
+		require.Equal(t, body.Digest, digest)
+		var head struct {
+			SlotID, BodyID, SourceTable, RowKey, ColumnName, OwnerKind, OwnerID, SourceIdentitySHA256 string
+			TenantID                                                                                  uint64
+			Revision                                                                                  int64
+		}
+		require.NoError(t, f.db.Table("original_body_field_heads").Where("slot_id=?", body.SlotID).Take(&head).Error)
+		require.Equal(t, body.BodyID, head.BodyID)
+		require.Equal(t, body.HeadRevision, head.Revision)
+		require.Equal(t, body.SourceIdentitySHA256, head.SourceIdentitySHA256)
+		require.Equal(t, "memory_derived_publications", head.SourceTable)
+		require.Equal(t, publication.ID, head.RowKey)
+		require.Equal(t, "material_json", head.ColumnName)
+		require.Equal(t, publication.ID, head.OwnerID)
+		require.Equal(t, "memory_derived_publications", head.OwnerKind)
+		require.Equal(t, publication.TenantID, head.TenantID)
+		var payloadBody struct {
+			ID, BodySHA256, State string
+			TenantID              uint64
+		}
+		require.NoError(t, f.db.Table("original_body_payloads").Select("id,tenant_id,body_sha256,state").Where("id=?", body.BodyID).Take(&payloadBody).Error)
+		require.Equal(t, publication.TenantID, payloadBody.TenantID)
+		require.Equal(t, publication.MaterialSHA256, payloadBody.BodySHA256)
+		require.Equal(t, "live", payloadBody.State)
+		if origin.ParentDerivationID != "" {
+			parent, exists := byID[origin.ParentDerivationID]
+			require.True(t, exists, "native capacity parent must be one of the exact model effects")
+			require.Equal(t, "add", parent.Action)
+			require.Equal(t, origin.ObjectID, parent.ObjectID)
+			var parentPublication types.MemoryDerivedPublication
+			require.NoError(t, f.db.Select("id").Where("derivation_id=?", parent.ID).Take(&parentPublication).Error)
+			require.Equal(t, parentPublication.ID, publication.ParentPublicationID)
