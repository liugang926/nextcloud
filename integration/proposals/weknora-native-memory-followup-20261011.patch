+// Provider calls continue to use their original cancellable operation context.
+func originalModelAcquisitionContext(ctx context.Context) (context.Context, func(), func() error, error) {
+	if err := ctx.Err(); err != nil {
+		return ctx, nil, nil, err
+	}
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok {
+		return ctx, nil, nil, nil
+	}
+	slot.mu.Lock()
+	owner, closed, failed := slot.OwnerContext, slot.Closed, slot.Failed
+	slot.mu.Unlock()
+	if closed || failed != nil || owner == nil {
+		return ctx, nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err := owner.Err(); err != nil {
+		return ctx, nil, nil, err
+	}
+	held, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	stopOwner := context.AfterFunc(owner, cancel)
+	// SQL acquisition, Snapshot, construction and the last current recheck are
+	// still cancelled by the original operation until the live owner adopts it.
+	stopAcquire := context.AfterFunc(ctx, cancel)
+	var once sync.Once
+	release := func() { once.Do(func() { stopAcquire(); stopOwner(); cancel() }) }
+	transfer := func() error {
+		stopAcquire()
+		if err := ctx.Err(); err != nil {
+			cancel()
+			return err
+		}
+		return held.Err()
+	}
+	return held, release, transfer, nil
+}
