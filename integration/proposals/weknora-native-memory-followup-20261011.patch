-	read, err := r.derived.BeginMemoryDerivedRead(ctx, scope)
+	var read interfaces.MemoryDerivedRead
+	var err error
+	// A repeatable-read snapshot can predate a concurrent original commit
+	// whose collection lock we waited for. PostgreSQL then aborts this read
+	// with 40001. Begin rolls back/closes every failed attempt; reacquire the
+	// complete graph under a fresh snapshot before any caller write executes.
+	// Refusals, canceled contexts and mutation-transaction errors never retry.
+	for attempt := 0; attempt < 3; attempt++ {
+		if err = ctx.Err(); err != nil {
+			return ctx, nil, err
+		}
+		read, err = r.derived.BeginMemoryDerivedRead(ctx, scope)
+		if err == nil {
+			break
+		}
+		var state interface{ SQLState() string }
+		if r.db.Dialector.Name() != "postgres" || !errors.As(err, &state) || state.SQLState() != "40001" {
+			return ctx, nil, err
+		}
+	}
 	if err != nil {
 		return ctx, nil, err
 	}
