@@ -0,0 +1,47 @@
+package repository
+
+import (
+	"context"
+
+	"gorm.io/gorm"
+)
+
+// CheckSDKTexts validates the actual private read and exact captured ordered
+// wire input before provider IO. It does not accept a DTO or a later result as
+// evidence that arbitrary text was an original. Existing retries of the same
+// unbound input retain the operation; a published/bound input is not re-used.
+func (h *KnowledgeSQLiteEmbeddingInputRead) CheckSDKTexts(ctx context.Context, texts []string) (err error) {
+	if h == nil || ctx == nil || ctx.Err() != nil {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	actual, _ := ctx.Value(knowledgeSQLiteEmbeddingKey{}).(*KnowledgeSQLiteEmbeddingInputRead)
+	if actual != h {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	if err = h.start(); err != nil {
+		return err
+	}
+	defer func() { err = h.finish(err) }()
+	h.mu.Lock()
+	matches := len(texts) == len(h.order) && len(texts) > 0 && len(h.outputs) == 0
+	if matches {
+		for i, text := range texts {
+			if h.bodies[h.order[i]].WireText != text {
+				matches = false
+				break
+			}
+		}
+	}
+	h.mu.Unlock()
+	if !matches {
+		return ErrKnowledgeSQLiteEmbeddingUnknown
+	}
+	return h.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// Reserve the actual owner transaction before its first schema/fact reads;
+		// source/build and current actor checks may perform real writes later.
+		if err := reserveMessageBodyLeaseWriterInTx(tx); err != nil {
+			return err
+		}
+		return h.checkInTx(tx, false)
+	}, memoryWriteOptions(h.db))
+}
