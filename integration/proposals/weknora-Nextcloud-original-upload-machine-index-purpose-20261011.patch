@@ -0,0 +1,47 @@
+package repository
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// SameNextcloudEmbeddingModelReadCaller is an identity check, never an
+// authorization grant. Only an actual current model read and the same private
+// live upload/build holder can match without an ordinary principal. The SDK
+// carrier must still run the complete model/purpose/body recheck before IO.
+// Historical, download, chat and arbitrary structural readers cannot match.
+func SameNextcloudEmbeddingModelReadCaller(ctx context.Context, reader interfaces.ModelOriginalRead) bool {
+	if ctx == nil || ctx.Err() != nil {
+		return false
+	}
+	read, ok := reader.(*modelOriginalRead)
+	if !ok || read == nil || read.download || read.ctx == nil || read.ctx.Err() != nil || read.model == nil || read.model.Type != types.ModelTypeEmbedding || !read.hold.Proof.Valid() {
+		return false
+	}
+	holder := nextcloudOriginalUploadInContext(ctx)
+	if holder == nil || holder.ctx == nil || holder.ctx.Err() != nil || !holder.needsEmbedding || !SameNextcloudEmbeddingPurposeCaller(ctx, read.ctx) {
+		return false
+	}
+	proof := read.hold.Proof
+	if proof.ModelID != holder.configuredModel || read.model.ID != proof.ModelID || read.model.TenantID != proof.OwnerTenantID || read.model.IsBuiltin != proof.IsBuiltin {
+		return false
+	}
+	pool, err := read.db.DB()
+	if err != nil || pool != holder.pool {
+		return false
+	}
+	ids, err := capturedModelOriginalLeaseIDs(read.hold)
+	return err == nil && len(ids) == 2
+}
+
+// Presence is not admission. Even an invalid typed marker must not fall back
+// to unrestricted ordinary SDK calls after a failed machine-purpose check.
+func NextcloudEmbeddingPurposePresent(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	_, present := ctx.Value(nextcloudOriginalUploadReadKey{}).(*nextcloudOriginalUploadRead)
+	return present
+}
diff --git a/internal/application/repository/nextcloud_embedding_purpose.go b/internal/application/repository/nextcloud_embedding_purpose.go
new file mode 100644
index 000000000..fc2c195c9
--- /dev/null
+++ b/internal/application/repository/nextcloud_embedding_purpose.go
@@ -0,0 +1,506 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"strconv"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/datasource/connector/nextcloud"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func (r *nextcloudOriginalUploadRead) capturePurposeInTx(tx *gorm.DB) error {
+	if r.actual.PairOperation == "" {
+		return ErrNextcloudOnboardingDenied
+	}
+	if err := tx.Where("operation_id=? AND state='active'", r.actual.PairOperation).Take(&r.operation).Error; err != nil {
+		return err
+	}
+	if err := tx.Where("id=? AND enabled=?", r.operation.CredentialID, true).Take(&r.credential).Error; err != nil {
+		return err
+	}
+	return r.checkActorInTx(tx)
+}
+
+// Re-run the actual onboarding actor semantics against this transaction. The
+// GUID-only delegation is a scoped machine purpose, never a WebUser principal.
+func (r *nextcloudOriginalUploadRead) checkActorInTx(tx *gorm.DB) error {
+	var op types.NextcloudOnboardingOperation
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("operation_id=? AND state='active'", r.operation.OperationID).Take(&op).Error; err != nil {
+		return err
+	}
+	// Permission/revision successors may be lawful, but identity is immutable and
+	// every current permission snapshot below is checked anew, not cached.
+	a, b := op, r.operation
+	a.Revision = b.Revision
+	a.PermissionVersion = b.PermissionVersion
+	a.PermissionSHA256 = b.PermissionSHA256
+	a.PermissionSyncedAt = b.PermissionSyncedAt
+	a.UpdatedAt = b.UpdatedAt
+	if !reflect.DeepEqual(a, b) || op.TenantID != r.payload.TenantID || op.KnowledgeBaseID != r.payload.KnowledgeBaseID || op.InstanceID != r.actual.Artifact.InstanceID || op.BindingID != r.actual.Artifact.BindingID || op.ActorDirectoryID == "" || op.ActorObjectGUID == "" {
+		return ErrNextcloudOnboardingDenied
+	}
+	var credential types.NextcloudOnboardingCredential
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND enabled=?", op.CredentialID, true).Take(&credential).Error; err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(credential, r.credential) || credential.TenantID != op.TenantID || credential.InstanceID != op.InstanceID || credential.BaseURL != r.actual.BaseURL || credential.DirectoryID != op.ActorDirectoryID || credential.TemplateKBID != op.ProcessingTemplateID {
+		return ErrNextcloudOnboardingDenied
+	}
+	closed, err := nextcloudControlsClosed(tx, op.InstanceID)
+	if err != nil {
+		return err
+	}
+	if closed {
+		return ErrNextcloudOnboardingDenied
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return err
+	}
+	var directory types.Directory
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", op.ActorDirectoryID).Take(&directory).Error; err != nil {
+		return ErrNextcloudOnboardingDenied
+	}
+	if err = directoryUsable(tx, op.ActorDirectoryID, time.UnixMilli(now).UTC()); err != nil {
+		return err
+	}
+	var identity types.DirectoryIdentity
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("directory_id=? AND object_guid=? AND status=? AND snapshot_version=(SELECT snapshot_version FROM directories WHERE id=?)", op.ActorDirectoryID, op.ActorObjectGUID, types.DirectoryObjectActive, op.ActorDirectoryID).Take(&identity).Error; err != nil {
+		return ErrNextcloudOnboardingDenied
+	}
+	linked := ""
+	if identity.UserID != nil {
+		linked = *identity.UserID
+	}
+	if linked != op.ActorUserID {
+		return ErrNextcloudOnboardingDenied
+	}
+	var delegates []types.NextcloudOnboardingDelegation
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND directory_id=? AND object_guid=?", op.TenantID, op.ActorDirectoryID, op.ActorObjectGUID).Find(&delegates).Error; err != nil {
+		return err
+	}
+	delegated := len(delegates)
+	admin := false
+	if linked != "" {
+		var user types.User
+		if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND is_active=?", linked, true).Take(&user).Error; err != nil {
+			return ErrNextcloudOnboardingDenied
+		}
+		var member types.TenantMember
+		if e := tx.Where("tenant_id=? AND user_id=? AND status=?", op.TenantID, linked, types.TenantMemberStatusActive).Take(&member).Error; e == nil {
+			admin = member.Role.HasPermission(types.TenantRoleAdmin)
+		} else if e != gorm.ErrRecordNotFound {
+			return e
+		}
+	}
+	if delegated != 1 && !admin {
+		return ErrNextcloudOnboardingDenied
+	}
+	// A task that actually carries a web/key caller must also retain that real
+	// caller's current authority. An absent machine caller remains absent.
+	if r.authenticatedCaller {
+		authority, err := knowledgeSQLiteEmbeddingAuthority(tx, r.store)
+		if err != nil {
+			return err
+		}
+		fresh, err := authority.RefreshCurrentReadActor(r.ctx)
+		if err != nil {
+			return err
+		}
+		if !sameOriginalModelCallerInRepository(fresh, r.ctx) {
+			return ErrNextcloudOnboardingDenied
+		}
+	}
+	return r.ctx.Err()
+}
+
+func (r *nextcloudOriginalUploadRead) checkLocalInTx(tx *gorm.DB) error {
+	if err := r.samePool(tx); err != nil {
+		return err
+	}
+	if err := r.build.admissionCtx.Err(); err != nil {
+		return err
+	}
+	if err := r.checkActorInTx(tx); err != nil {
+		return err
+	}
+	if err := r.bodyReadPreflightInTx(tx); err != nil {
+		return err
+	}
+	var source types.DataSource
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND tenant_id=? AND knowledge_base_id=?", r.receipt.DataSourceID, r.payload.TenantID, r.payload.KnowledgeBaseID).Take(&source).Error; err != nil {
+		return err
+	}
+	var pair NextcloudSourcePairing
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("operation_id=? AND state='active'", r.actual.PairOperation).Take(&pair).Error; err != nil {
+		return err
+	}
+	var sourceVersion struct{ Revision uint64 }
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Table("nextcloud_upload_source_versions").Where("datasource_id=?", r.receipt.DataSourceID).Take(&sourceVersion).Error; err != nil {
+		return err
+	}
+	if sourceVersion.Revision != r.receipt.SourceRevision {
+		return ErrKnowledgeInputChanged
+	}
+	k, err := r.ownSourceMetadataInTx(tx)
+	if err != nil {
+		return err
+	}
+	receipt, err := r.store.verifyOriginalUploadInTx(tx, k, nil, "", false)
+	if err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(*receipt, r.receipt) {
+		return ErrKnowledgeInputChanged
+	}
+	if k.FilePath == "" || k.FilePath != r.payload.FilePath {
+		return ErrKnowledgeInputChanged
+	}
+	var kb types.KnowledgeBase
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND tenant_id=? AND deleted_at IS NULL", r.payload.KnowledgeBaseID, r.payload.TenantID).Take(&kb).Error; err != nil {
+		return err
+	}
+	digest, err := knowledgeConfigDigest(&kb, k)
+	if err != nil || digest != r.receipt.ConfigDigest || kb.EmbeddingModelID != r.configuredModel || kb.IndexingStrategy.NeedsEmbedding() != r.needsEmbedding {
+		return ErrKnowledgeInputChanged
+	}
+	revision, err := knowledgeConfigurationControlRevision(tx, kb.ID)
+	if err != nil || revision != r.receipt.ConfigRevision {
+		return ErrKnowledgeInputChanged
+	}
+	routing, err := knowledgeEnrichmentRoutingDigest(&kb)
+	if err != nil || routing != r.receipt.RoutingDigest {
+		return ErrKnowledgeInputChanged
+	}
+	revision, err = knowledgeEnrichmentRevision(tx, "routing", kb.ID)
+	if err != nil || revision != r.receipt.RoutingRevision {
+		return ErrKnowledgeInputChanged
+	}
+	var tenant types.Tenant
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", r.payload.TenantID).Take(&tenant).Error; err != nil {
+		return err
+	}
+	if tenant.Status != "active" {
+		return ErrNextcloudOnboardingDenied
+	}
+	digest, err = knowledgeProducerTenantDigest(&tenant)
+	if err != nil || digest != r.receipt.TenantDigest {
+		return ErrKnowledgeInputChanged
+	}
+	revision, err = knowledgeEnrichmentRevision(tx, "tenant", strconv.FormatUint(r.payload.TenantID, 10))
+	if err != nil || revision != r.receipt.TenantRevision {
+		return ErrKnowledgeInputChanged
+	}
+	lineage, err := readKnowledgeConfigurationOrigin(tx, &kb)
+	if err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(lineage, r.lineage) {
+		return ErrKnowledgeInputChanged
+	}
+	if r.actual.TaskControls == nil || r.payload.URL != "" || len(r.payload.Passages) != 0 {
+		return ErrKnowledgeInputChanged
+	}
+	controls := nextcloudOriginalDocumentTaskControls{r.payload.Language, r.payload.FileName, r.payload.FileType, r.payload.EnableMultimodel, r.payload.EnableQuestionGeneration, r.payload.QuestionCount}
+	wanted, err := KnowledgeInputDigest(r.actual.TaskControls)
+	if err != nil {
+		return err
+	}
+	got, err := KnowledgeInputDigest(controls)
+	if err != nil || got != wanted {
+		return ErrKnowledgeInputChanged
+	}
+	return r.checkContentInTx(tx)
+}
+
+// This explicit directory-GUID adapter checks local current grant rows plus the
+// signed remote mounted-file decision. It never invokes publicGuard with a
+// fabricated user, and never treats a content lease as read authorization.
+func (r *nextcloudOriginalUploadRead) checkSourcesInTx(tx *gorm.DB) error {
+	if err := r.bodyReadPreflightInTx(tx); err != nil {
+		return err
+	}
+	own, err := r.ownSourceMetadataInTx(tx)
+	if err != nil {
+		return err
+	}
+	ds, _, err := originalUploadSourceInTx(tx, own, nextcloudFetchedArtifactContext{Actual: r.actual.Artifact, DataSourceID: r.receipt.DataSourceID})
+	if err != nil {
+		return err
+	}
+	if err = r.checkRemoteSourceInTx(tx, ds, own, r.actual.Artifact.InstanceID, r.actual.Artifact.BindingID, r.actual.Artifact.FileID, r.actual.Artifact.ETag, r.actual.Artifact.ContentRevision); err != nil {
+		return err
+	}
+	for _, source := range r.lineage.Sources {
+		k, current, err := (&knowledgeRepository{db: tx}).resolveNextcloudSourceLineageInTx(tx, source.TenantID, source.KnowledgeBaseID, source.KnowledgeID)
+		if err != nil {
+			return err
+		}
+		if current != source {
+			return ErrKnowledgeInputChanged
+		}
+		if err = r.checkInheritedGUIDGrantInTx(tx, source); err != nil {
+			return err
+		}
+		var ds types.DataSource
+		if err = tx.Where("id=? AND tenant_id=? AND knowledge_base_id=? AND type=? AND status=? AND deleted_at IS NULL", source.DataSourceID, source.TenantID, source.KnowledgeBaseID, types.ConnectorTypeNextcloud, types.DataSourceStatusActive).Take(&ds).Error; err != nil {
+			return err
+		}
+		if err = r.checkRemoteSourceInTx(tx, &ds, k, source.InstanceID, source.BindingID, source.FileID, source.ETag, source.ContentRevision); err != nil {
+			return err
+		}
+	}
+	// Remote transport and path-chain IO can overlap a revocation. Re-read all
+	// captured local actor/source/dependency tuples in this same transaction.
+	if err := r.checkLocalInTx(tx); err != nil {
+		return err
+	}
+	for _, source := range r.lineage.Sources {
+		if err := r.checkInheritedGUIDGrantInTx(tx, source); err != nil {
+			return err
+		}
+		_, current, err := (&knowledgeRepository{db: tx}).resolveNextcloudSourceLineageInTx(tx, source.TenantID, source.KnowledgeBaseID, source.KnowledgeID)
+		if err != nil {
+			return err
+		}
+		if current != source {
+			return ErrKnowledgeInputChanged
+		}
+	}
+	return r.ctx.Err()
+}
+func (r *nextcloudOriginalUploadRead) checkInheritedGUIDGrantInTx(tx *gorm.DB, source types.SourceIdentity) error {
+	var op types.NextcloudOnboardingOperation
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("operation_id=? AND state='active'", source.PairOperationID).Take(&op).Error; err != nil {
+		return err
+	}
+	var pair NextcloudSourcePairing
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("operation_id=? AND tenant_id=? AND knowledge_base_id=? AND datasource_id=? AND state='active'", source.PairOperationID, source.TenantID, source.KnowledgeBaseID, source.DataSourceID).Take(&pair).Error; err != nil {
+		return err
+	}
+	var currentSource types.DataSource
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND tenant_id=? AND knowledge_base_id=? AND status=? AND deleted_at IS NULL", source.DataSourceID, source.TenantID, source.KnowledgeBaseID, types.DataSourceStatusActive).Take(&currentSource).Error; err != nil {
+		return err
+	}
+	// The actual grant rows are held through this transaction too. A raw
+	// DELETE may bypass ApplyGrantSnapshot's op-row fence, but must still
+	// contend with these exact current grant-row SHARE locks.
+	var grants []types.NextcloudSourceGrant
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND knowledge_base_id=? AND operation_id=? AND directory_id=?", source.TenantID, source.KnowledgeBaseID, source.PairOperationID, r.operation.ActorDirectoryID).Find(&grants).Error; err != nil {
+		return err
+	}
+	var count int64
+	err := tx.Raw(`SELECT COUNT(*) FROM nextcloud_source_grants sg
+ JOIN nextcloud_onboarding_operations o ON o.operation_id=sg.operation_id AND o.state='active'
+ JOIN nextcloud_source_pairings p ON p.operation_id=o.operation_id AND p.state='active'
+ JOIN data_sources ds ON ds.id=p.datasource_id AND ds.status='active' AND ds.deleted_at IS NULL
+ JOIN directories d ON d.id=sg.directory_id AND d.enabled=TRUE
+ JOIN directory_identities i ON i.directory_id=d.id AND i.object_guid=? AND i.status='active' AND i.snapshot_version=d.snapshot_version
+ WHERE sg.tenant_id=? AND sg.knowledge_base_id=? AND sg.operation_id=? AND sg.directory_id=?
+ AND sg.permission_version=o.permission_version AND sg.permission_version>0
+ AND sg.publication_epoch=COALESCE((SELECT MAX(e.publication_epoch) FROM nextcloud_source_status_epochs e JOIN nextcloud_event_connections c ON c.connection_id=e.connection_id AND c.status='active' WHERE e.pair_operation_id=p.operation_id AND c.datasource_id=ds.id),p.publication_epoch)
+ AND ((sg.kind='user' AND sg.principal_id=i.id) OR (sg.kind='group' AND EXISTS(SELECT 1 FROM directory_group_memberships gm JOIN directory_groups g ON g.id=gm.group_id AND g.directory_id=d.id AND g.status='active' AND g.snapshot_version=d.snapshot_version WHERE gm.directory_id=d.id AND gm.identity_id=i.id AND gm.group_id=sg.principal_id AND gm.snapshot_version=d.snapshot_version)))`, r.operation.ActorObjectGUID, source.TenantID, source.KnowledgeBaseID, source.PairOperationID, r.operation.ActorDirectoryID).Scan(&count).Error
+	if err != nil {
+		return err
+	}
+	if count == 0 {
+		return ErrNextcloudOnboardingDenied
+	}
+	return nil
+}
+func (r *nextcloudOriginalUploadRead) checkRemoteSourceInTx(tx *gorm.DB, ds *types.DataSource, k *types.Knowledge, instance, binding, file, etag, revision string) error {
+	cfg, err := ds.ParseConfig()
+	if err != nil {
+		return err
+	}
+	cfg.Type = ds.Type
+	if len(cfg.ResourceIDs) != 1 || cfg.ResourceIDs[0] != binding {
+		return ErrKnowledgeInputChanged
+	}
+	id, err := strconv.ParseInt(file, 10, 64)
+	if err != nil || id <= 0 {
+		return ErrKnowledgeInputChanged
+	}
+	path, err := NewNextcloudOnboardingStore(tx).ResolveCurrentSourcePath(r.ctx, k.TenantID, k.KnowledgeBaseID, ds.ID, k.GetMetadata()["nextcloud_path"])
+	if err != nil {
+		return err
+	}
+	ctx := types.WithNextcloudContentRevision(r.ctx, revision)
+	decision, err := nextcloud.AuthorizeCurrentFile(ctx, cfg, instance, binding, r.operation.ActorDirectoryID, r.operation.ActorObjectGUID, id)
+	if err != nil {
+		return err
+	}
+	if !decision.Allow || decision.SourceETag != etag || decision.SourceContentRevision != revision {
+		return ErrNextcloudOnboardingDenied
+	}
+	return nextcloud.CheckCurrentPublication(ctx, cfg, instance, binding, id, etag, path)
+}
+
+// The initial model admission supplies partial proof metadata. ModelID is
+// already restricted by the holder; the model's immutable proof/body/controls
+// are subsequently validated by the unchanged genuine model reader.
+func CheckNextcloudEmbeddingModelPurposeInTx(ctx context.Context, tx *gorm.DB, proof types.ModelOriginalProof) (present bool, err error) {
+	if ctx == nil {
+		return false, nil
+	}
+	r, present := ctx.Value(nextcloudOriginalUploadReadKey{}).(*nextcloudOriginalUploadRead)
+	if !present {
+		return false, nil
+	}
+	if r == nil {
+		return true, ErrKnowledgeInputChanged
+	}
+	if err = r.start(); err != nil {
+		return true, err
+	}
+	defer func() { err = r.finish(err) }()
+	if !r.needsEmbedding || proof.ModelID == "" || proof.ModelID != r.configuredModel || (!proof.IsBuiltin && proof.OwnerTenantID != r.payload.TenantID) {
+		return true, ErrNextcloudOnboardingDenied
+	}
+	var model struct {
+		ID        string
+		TenantID  uint64
+		IsBuiltin bool
+		Type      string
+	}
+	if err = tx.Table("models").Select("id,tenant_id,is_builtin,type").Where("id=? AND deleted_at IS NULL", proof.ModelID).Take(&model).Error; err != nil {
+		return true, err
+	}
+	if model.Type != string(types.ModelTypeEmbedding) || model.TenantID != proof.OwnerTenantID || model.IsBuiltin != proof.IsBuiltin {
+		return true, ErrNextcloudOnboardingDenied
+	}
+	err = r.checkInTx(tx, true)
+	return true, err
+}
+
+// Used by the actual per-TX knowledge source verifier. This does not open a
+// second pool transaction while an owned caller transaction is waiting.
+func CheckNextcloudOriginalUploadSources(ctx context.Context, store *KnowledgeInputProvenanceStore, proof *types.KnowledgeBuildInputProof) (present bool, err error) {
+	r, present := ctx.Value(nextcloudOriginalUploadReadKey{}).(*nextcloudOriginalUploadRead)
+	if !present {
+		return false, nil
+	}
+	if r == nil || store == nil || store.db == nil || proof == nil {
+		return true, ErrKnowledgeInputChanged
+	}
+	if err = r.start(); err != nil {
+		return true, err
+	}
+	defer func() { err = r.finish(err) }()
+	check := func(tx *gorm.DB) error {
+		if proof.TenantID != r.payload.TenantID || proof.KnowledgeBaseID != r.payload.KnowledgeBaseID || proof.KnowledgeID != r.payload.KnowledgeID || proof.BuildGeneration != uint64(r.build.lease.Epoch) {
+			return ErrKnowledgeInputChanged
+		}
+		var k types.Knowledge
+		if e := tx.Where("id=? AND tenant_id=? AND knowledge_base_id=?", proof.KnowledgeID, proof.TenantID, proof.KnowledgeBaseID).Take(&k).Error; e != nil {
+			return e
+		}
+		admission, _, lineage, e := store.admissionInTx(tx, &k, proof)
+		if e != nil {
+			return e
+		}
+		if admission.OriginKind != "nextcloud" {
+			return ErrKnowledgeInputChanged
+		}
+		own, e := knowledgeBuildSourceIdentity(tx, &k, proof.BuildGeneration)
+		if e != nil {
+			return e
+		}
+		expected, e := types.NewCompleteSourceLineage(own)
+		if e != nil {
+			return e
+		}
+		expected, e = types.UnionSourceLineage(expected, r.lineage)
+		if e != nil {
+			return e
+		}
+		if !reflect.DeepEqual(lineage, expected) || !reflect.DeepEqual(proof.SourceLineage, expected) {
+			return ErrKnowledgeInputChanged
+		}
+		return r.checkInTx(tx, true)
+	}
+	if _, nested := store.db.Statement.ConnPool.(gorm.TxCommitter); nested {
+		err = check(store.db.WithContext(ctx))
+	} else {
+		err = store.db.WithContext(ctx).Transaction(check, memoryWriteOptions(store.db))
+	}
+	return true, err
+}
+
+// Decode equality is insufficient: immutable upload bytes and digest stay exact.
+func (r *nextcloudOriginalUploadRead) actualInTx(tx *gorm.DB) (*nextcloudOriginalUploadActual, error) {
+	var receipt nextcloudOriginalUploadInput
+	if err := tx.Where("knowledge_id=? AND tenant_id=? AND knowledge_base_id=?", r.payload.KnowledgeID, r.payload.TenantID, r.payload.KnowledgeBaseID).Take(&receipt).Error; err != nil {
+		return nil, err
+	}
+	if !reflect.DeepEqual(receipt, r.receipt) {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var actual nextcloudOriginalUploadActual
+	if json.Unmarshal([]byte(receipt.ActualInputs), &actual) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	return &actual, nil
+}
+
+// Producer-side fence for the current credential's real delegated actor. It is
+// separate from model reading and adds no account/role/principal to context.
+func lockNextcloudOnboardingActorInTx(tx *gorm.DB, c types.NextcloudOnboardingCredential, dir, guid, actor string) error {
+	if c.DirectoryID != dir {
+		return ErrNextcloudOnboardingDenied
+	}
+	var directory types.Directory
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", dir).Take(&directory).Error; err != nil {
+		return ErrNextcloudOnboardingDenied
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return err
+	}
+	if err = directoryUsable(tx, dir, time.UnixMilli(now).UTC()); err != nil {
+		return err
+	}
+	var identity types.DirectoryIdentity
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("directory_id=? AND object_guid=? AND status=? AND snapshot_version=?", dir, guid, types.DirectoryObjectActive, directory.SnapshotVersion).Take(&identity).Error; err != nil {
+		return ErrNextcloudOnboardingDenied
+	}
+	linked := ""
+	if identity.UserID != nil {
+		linked = *identity.UserID
+	}
+	if linked != actor {
+		return ErrNextcloudOnboardingDenied
+	}
+	var delegates []types.NextcloudOnboardingDelegation
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND directory_id=? AND object_guid=?", c.TenantID, dir, guid).Find(&delegates).Error; err != nil {
+		return err
+	}
+	if linked == "" {
+		if len(delegates) != 1 {
+			return ErrNextcloudOnboardingDenied
+		}
+		return nil
+	}
+	var user types.User
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND is_active=?", linked, true).Take(&user).Error; err != nil {
+		return ErrNextcloudOnboardingDenied
+	}
+	var members []types.TenantMember
+	if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND user_id=? AND status=?", c.TenantID, linked, types.TenantMemberStatusActive).Find(&members).Error; err != nil {
+		return err
+	}
+	for _, member := range members {
+		if member.Role.HasPermission(types.TenantRoleAdmin) {
+			return nil
+		}
+	}
+	if len(delegates) != 1 {
+		return ErrNextcloudOnboardingDenied
+	}
+	return nil
+}
