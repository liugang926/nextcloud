+++ b/internal/application/repository/nextcloud_original_upload_read.go
@@ -0,0 +1,390 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+type nextcloudOriginalUploadReadKey struct{}
+type nextcloudOriginalContentBinding struct {
+	Lease nextcloudContentLeaseRow
+	Scope NextcloudContentScope
+}
+
+// Only Begin constructs this capability. The router's build lease is borrowed;
+// read/body leases are owned, and Close never releases the router's build token.
+type nextcloudOriginalUploadRead struct {
+	db                  *gorm.DB
+	pool                *sql.DB
+	store               *KnowledgeInputProvenanceStore
+	content             *NextcloudContentLeaseStore
+	ctx                 context.Context
+	cancel              context.CancelFunc
+	build               nextcloudBuildContext
+	payload             types.DocumentProcessPayload
+	receipt             nextcloudOriginalUploadInput
+	actual              nextcloudOriginalUploadActual
+	operation           types.NextcloudOnboardingOperation
+	credential          types.NextcloudOnboardingCredential
+	authenticatedCaller bool
+	configuredModel     string
+	needsEmbedding      bool
+	lineage             *types.SourceLineage
+	rows                []originalBodyAvailabilityRow
+	heads               []originalBodyFieldHead
+	bodies              map[string]originalBodyPayload
+	predecessors        map[string]bool
+	leases              map[string]originalBodyLease
+	contentBindings     map[string]nextcloudOriginalContentBinding
+	kbFences            map[string]nextcloudContentFence
+	mu                  sync.Mutex
+	checks              sync.WaitGroup
+	closed              bool
+	failed              error
+	closeErr            error
+	joined              chan struct{}
+}
+
+func (s *KnowledgeInputProvenanceStore) BeginNextcloudOriginalUploadRead(ctx context.Context, p types.DocumentProcessPayload) (interfaces.NextcloudOriginalUploadRead, error) {
+	if s == nil || s.db == nil || ctx == nil || ctx.Err() != nil || p.TenantID == 0 || p.KnowledgeBaseID == "" || p.KnowledgeID == "" {
+		return nil, ErrKnowledgeInputChanged
+	}
+	build, ok := ctx.Value(nextcloudBuildContextKey{}).(nextcloudBuildContext)
+	content, real := build.validator.(*NextcloudContentLeaseStore)
+	if !ok || !real || content == nil || build.admissionCtx == nil || build.admissionCtx.Err() != nil || build.scope.TenantID != p.TenantID || build.scope.KnowledgeBaseID != p.KnowledgeBaseID || build.scope.KnowledgeID != p.KnowledgeID {
+		return nil, ErrNextcloudContentLeaseInvalid
+	}
+	ctx, authenticatedCaller, err := captureNextcloudUploadCaller(ctx)
+	if err != nil {
+		return nil, err
+	}
+	pool, err := s.db.DB()
+	if err != nil {
+		return nil, err
+	}
+	contentPool, err := content.db.DB()
+	if err != nil || pool != contentPool {
+		return nil, ErrNextcloudContentLeaseInvalid
+	}
+	if _, nested := s.db.Statement.ConnPool.(gorm.TxCommitter); nested {
+		return nil, ErrNextcloudContentLeaseInvalid
+	}
+	r := &nextcloudOriginalUploadRead{authenticatedCaller: authenticatedCaller, db: s.db, pool: pool, store: s, content: content, build: build, payload: p, bodies: map[string]originalBodyPayload{}, predecessors: map[string]bool{}, leases: map[string]originalBodyLease{}, contentBindings: map[string]nextcloudOriginalContentBinding{}, kbFences: map[string]nextcloudContentFence{}, joined: make(chan struct{})}
+	r.ctx, r.cancel = context.WithCancel(logprivacy.SuppressContent(ctx))
+	r.ctx = context.WithValue(r.ctx, nextcloudOriginalUploadReadKey{}, r)
+	owner := "nextcloud-original-upload/" + uuid.NewString()
+	err = s.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := reserveMessageBodyLeaseWriterInTx(tx); err != nil {
+			return err
+		}
+		// Metadata selectors only. actual_inputs is a vault field and is not selected
+		// until its genuine original body read lease has committed in this transaction.
+		if !originalBodySchemaPresent(tx) {
+			return ErrOriginalBodyUnavailable
+		}
+		var meta nextcloudOriginalUploadInput
+		if err := bodyInternal(tx).Select("knowledge_id,tenant_id,knowledge_base_id,datasource_id,source_revision,config_revision,root_revision,routing_revision,tenant_revision,routing_digest,tenant_digest,config_digest,root_digest,artifact_digest,input_digest").Where("knowledge_id=? AND tenant_id=? AND knowledge_base_id=?", p.KnowledgeID, p.TenantID, p.KnowledgeBaseID).Take(&meta).Error; err != nil {
+			return err
+		}
+		if meta.DataSourceID != build.scope.DataSourceID {
+			return ErrKnowledgeInputChanged
+		}
+		var kb types.KnowledgeBase
+		if err := tx.Where("id=? AND tenant_id=? AND deleted_at IS NULL", p.KnowledgeBaseID, p.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		lineage, err := nextcloudConfigurationLineageMetadataInTx(tx, &kb)
+		if err != nil {
+			return err
+		}
+		r.lineage, err = types.UnionSourceLineage(lineage)
+		if err != nil {
+			return err
+		}
+		r.configuredModel = kb.EmbeddingModelID
+		r.needsEmbedding = kb.IndexingStrategy.NeedsEmbedding()
+		// Fence/lease order follows the real content writer: KB, exact knowledge.
+		// This validates the borrowed token; it is not an authorization inference.
+		if err = content.ValidateBuildLeaseInTx(r.ctx, tx, build.lease, build.scope); err != nil {
+			return err
+		}
+		var borrowed nextcloudContentLeaseRow
+		if err = tx.Where("lease_id=?", build.lease.ID).Take(&borrowed).Error; err != nil {
+			return err
+		}
+		r.contentBindings[borrowed.LeaseID] = nextcloudOriginalContentBinding{borrowed, build.scope}
+		var ownKB nextcloudContentFence
+		if err = tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", build.scope.TenantID, build.scope.KnowledgeBaseID).Take(&ownKB).Error; err != nil {
+			return err
+		}
+		r.kbFences[nextcloudOriginalKBKey(build.scope)] = ownKB
+		r.rows = []originalBodyAvailabilityRow{{"nextcloud_original_upload_inputs", p.KnowledgeID}}
+		sources := append([]types.SourceIdentity(nil), r.lineage.Sources...)
+		sort.Slice(sources, func(i, j int) bool {
+			a, b := sources[i], sources[j]
+			if a.TenantID != b.TenantID {
+				return a.TenantID < b.TenantID
+			}
+			if a.KnowledgeBaseID != b.KnowledgeBaseID {
+				return a.KnowledgeBaseID < b.KnowledgeBaseID
+			}
+			return a.KnowledgeID < b.KnowledgeID
+		})
+		for _, source := range sources {
+			scope := NextcloudContentScope{source.TenantID, source.KnowledgeBaseID, source.KnowledgeID, source.DataSourceID, source.ExternalID}
+			lease, err := content.AcquireKnowledgeInTx(r.ctx, tx, scope, NextcloudContentReadLease, owner, NextcloudContentLeaseMaxTTL)
+			if err != nil {
+				return err
+			}
+			if uint64(lease.Epoch) != source.Revision {
+				return ErrKnowledgeInputChanged
+			}
+			var row nextcloudContentLeaseRow
+			if err = tx.Where("lease_id=?", lease.ID).Take(&row).Error; err != nil {
+				return err
+			}
+			r.contentBindings[row.LeaseID] = nextcloudOriginalContentBinding{row, scope}
+			var kbFence nextcloudContentFence
+			if err = tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", scope.TenantID, scope.KnowledgeBaseID).Take(&kbFence).Error; err != nil {
+				return err
+			}
+			r.kbFences[nextcloudOriginalKBKey(scope)] = kbFence
+			r.rows = append(r.rows, originalBodyAvailabilityRow{"knowledges", source.KnowledgeID})
+		}
+		// Heads are captured before payload/body hydration. Only exact private heads
+		// can select bodies. Unknown/missing upload originals never get a new head.
+		r.heads, err = originalBodyBatchHeads(tx, r.rows)
+		if err != nil {
+			return err
+		}
+		// The initial knowledge read is also before plaintext hydration. These
+		// named predecessor bodies remain held, while lawful processing may author
+		// newer knowledge heads. The index operation separately holds its actual
+		// current knowledge/chunk heads before reading model inputs.
+		ownHeads, err := originalBodyBatchHeads(tx, []originalBodyAvailabilityRow{{"knowledges", p.KnowledgeID}})
+		if err != nil {
+			return err
+		}
+		allHeads := append(append([]originalBodyFieldHead(nil), r.heads...), ownHeads...)
+		for _, head := range ownHeads {
+			r.predecessors[head.BodyID] = true
+		}
+		upload := 0
+		for _, head := range r.heads {
+			if head.SourceTable == "nextcloud_original_upload_inputs" && head.RowKey == p.KnowledgeID && head.ColumnName == "actual_inputs" && head.TenantID == p.TenantID && head.KnowledgeBaseID == p.KnowledgeBaseID {
+				upload++
+			}
+		}
+		if upload != 1 {
+			return ErrOriginalBodyUnavailable
+		}
+		for _, head := range allHeads {
+			if _, exists := r.leases[head.BodyID]; exists {
+				continue
+			}
+			id, err := NewOriginalBodyRetentionStore(tx).acquireLeaseInTx(tx, head.BodyID, "read", owner, 15*time.Minute)
+			if err != nil {
+				return err
+			}
+			var lease originalBodyLease
+			if err = bodyInternal(tx).Where("lease_id=?", id).Take(&lease).Error; err != nil {
+				return err
+			}
+			r.leases[head.BodyID] = lease
+			var body originalBodyPayload
+			if err = bodyInternal(tx).Where("id=?", head.BodyID).Take(&body).Error; err != nil {
+				return err
+			}
+			r.bodies[head.BodyID] = body
+		}
+		if err = r.bodyReadPreflightInTx(tx); err != nil {
+			return err
+		}
+		verifiedLineage, err := readKnowledgeConfigurationOrigin(tx, &kb)
+		if err != nil {
+			return err
+		}
+		if !reflect.DeepEqual(verifiedLineage, r.lineage) {
+			return ErrKnowledgeInputChanged
+		}
+		if err = tx.Where("knowledge_id=? AND tenant_id=? AND knowledge_base_id=?", p.KnowledgeID, p.TenantID, p.KnowledgeBaseID).Take(&r.receipt).Error; err != nil {
+			return err
+		}
+		metadata := r.receipt
+		metadata.ActualInputs = ""
+		if !reflect.DeepEqual(metadata, meta) {
+			return ErrKnowledgeInputChanged
+		}
+		if json.Unmarshal([]byte(r.receipt.ActualInputs), &r.actual) != nil {
+			return ErrKnowledgeInputChanged
+		}
+		digest, err := KnowledgeInputDigest(r.actual)
+		if err != nil || digest != r.receipt.InputDigest {
+			return ErrKnowledgeInputChanged
+		}
+		if err = r.capturePurposeInTx(tx); err != nil {
+			return err
+		}
+		if err = checkOriginalBodyAvailableBatchForCapturedInTx(r.ctx, tx, []originalBodyAvailabilityRow{{"knowledges", p.KnowledgeID}}, ownHeads); err != nil {
+			return err
+		}
+		return r.checkInTx(tx, true)
+	}, memoryWriteOptions(s.db))
+	if err != nil {
+		r.cancel()
+		return nil, err
+	}
+	return r, nil
+}
+
+func (r *nextcloudOriginalUploadRead) Context() context.Context { return r.ctx }
+func (r *nextcloudOriginalUploadRead) start() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return ErrKnowledgeInputChanged
+	}
+	if r.failed != nil {
+		return r.failed
+	}
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	if err := r.build.admissionCtx.Err(); err != nil {
+		return err
+	}
+	r.checks.Add(1)
+	return nil
+}
+func (r *nextcloudOriginalUploadRead) finish(err error) error {
+	if err == nil {
+		err = r.ctx.Err()
+	}
+	r.mu.Lock()
+	if err != nil && r.failed == nil {
+		r.failed = err
+		r.cancel()
+	}
+	r.mu.Unlock()
+	r.checks.Done()
+	return err
+}
+func (r *nextcloudOriginalUploadRead) Recheck() (err error) {
+	if err = r.start(); err != nil {
+		return err
+	}
+	defer func() { err = r.finish(err) }()
+	return r.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := reserveMessageBodyLeaseWriterInTx(tx); err != nil {
+			return err
+		}
+		return r.checkInTx(tx, true)
+	}, memoryWriteOptions(r.db))
+}
+func (r *nextcloudOriginalUploadRead) samePool(tx *gorm.DB) error {
+	if tx == nil || tx.Statement == nil {
+		return ErrKnowledgeInputChanged
+	}
+	if _, ok := tx.Statement.ConnPool.(gorm.TxCommitter); !ok {
+		return ErrKnowledgeInputChanged
+	}
+	pool, err := tx.DB()
+	if err != nil {
+		return err
+	}
+	if pool != r.pool || !SameNextcloudEmbeddingPurposeCaller(tx.Statement.Context, r.ctx) {
+		return ErrKnowledgeInputChanged
+	}
+	return r.ctx.Err()
+}
+func (r *nextcloudOriginalUploadRead) Close() error {
+	r.mu.Lock()
+	if r.closed {
+		joined := r.joined
+		r.mu.Unlock()
+		<-joined
+		r.mu.Lock()
+		err := errors.Join(r.failed, r.closeErr)
+		r.mu.Unlock()
+		return err
+	}
+	r.closed = true
+	r.cancel()
+	r.mu.Unlock()
+	r.checks.Wait()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	var err error
+	err = r.db.WithContext(cleanup).Transaction(func(tx *gorm.DB) error {
+		if e := reserveMessageBodyLeaseWriterInTx(tx); e != nil {
+			return e
+		}
+		now, e := nextcloudLeaseNowMS(tx)
+		if e != nil {
+			return e
+		}
+		for _, l := range r.leases {
+			e = bodyInternal(tx).Model(&originalBodyLease{}).Where("lease_id=? AND body_id=? AND owner_id=? AND kind=? AND epoch=? AND released_at_ms IS NULL", l.LeaseID, l.BodyID, l.OwnerID, l.Kind, l.Epoch).Update("released_at_ms", now).Error
+			err = errors.Join(err, e)
+		}
+		for _, binding := range r.contentBindings {
+			l := binding.Lease
+			if l.LeaseID == r.build.lease.ID {
+				continue
+			}
+			e = tx.Model(&nextcloudContentLeaseRow{}).Where("lease_id=? AND tenant_id=? AND knowledge_base_id=? AND knowledge_id=? AND owner_id=? AND kind=? AND epoch=? AND released_at_ms IS NULL", l.LeaseID, l.TenantID, l.KnowledgeBaseID, l.KnowledgeID, l.OwnerID, l.Kind, l.Epoch).Updates(map[string]any{"released_at_ms": now, "updated_at_ms": now}).Error
+			err = errors.Join(err, e)
+		}
+		return err
+	})
+	r.mu.Lock()
+	r.closeErr = err
+	close(r.joined)
+	r.mu.Unlock()
+	return err
+}
+
+var _ interfaces.NextcloudOriginalUploadLifetimeReader = (*KnowledgeInputProvenanceStore)(nil)
+
+// Freeze the real caller representation before any existing WithExecutionTenant
+// / WithKBTaskWrite normalization. Execution tenant alone is not authentication.
+// This empty Viewer sentinel is the same official WithExecutionTenant capture;
+// no Principal, user, role grant or administrative identity is constructed.
+func captureNextcloudUploadCaller(ctx context.Context) (context.Context, bool, error) {
+	rawCaller := ctx.Value(types.CallerContextKey)
+	caller, captured := rawCaller.(types.Caller)
+	_, principal := types.PrincipalFromContext(ctx)
+	_, key := types.TenantAPIKeyScopeFromContext(ctx)
+	if (rawCaller != nil && !captured) || (ctx.Value(types.PrincipalContextKey) != nil && !principal) || (ctx.Value(types.TenantAPIKeyScopeContextKey) != nil && !key) {
+		return ctx, false, ErrNextcloudOnboardingDenied
+	}
+	user, _ := types.UserIDFromContext(ctx)
+	if captured {
+		if !caller.Role.IsValid() {
+			return ctx, false, ErrNextcloudOnboardingDenied
+		}
+		empty := caller.TenantID == 0 && caller.UserID == ""
+		if empty && caller.Role != types.TenantRoleViewer {
+			return ctx, false, ErrNextcloudOnboardingDenied
+		}
+		authenticated := principal || key || user != "" || !empty
+		return ctx, authenticated, nil
+	}
+	authenticated := principal || key || user != "" || types.TenantRoleFromContext(ctx) != types.TenantRoleViewer
+	if authenticated {
+		return types.WithCaller(ctx, types.CallerFromContext(ctx)), true, nil
+	}
+	return types.WithCaller(ctx, types.Caller{TenantID: 0, UserID: "", Role: types.TenantRoleViewer}), false, nil
+}
