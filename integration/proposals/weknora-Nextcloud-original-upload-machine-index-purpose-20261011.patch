+// Test transport runs the actual HMAC protocol and a fixed provisioned source
+// ACL/publication state. It is not injected as a repository authorizer callback.
+func ownedMachineSourceTransport(t *testing.T, artifact string) (*httptest.Server, *atomic.Bool, *atomic.Int64, func() error) {
+	t.Helper()
+	allow := &atomic.Bool{}
+	allow.Store(true)
+	count := &atomic.Int64{}
+	var mu sync.Mutex
+	var observed error
+	nonces := map[string]bool{}
+	record := func(err error) { mu.Lock(); observed = errors.Join(observed, err); mu.Unlock() }
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+		if err != nil {
+			record(errors.New("source request body read failed"))
+			w.WriteHeader(400)
+			return
+		}
+		r.Body = io.NopCloser(bytes.NewReader(raw))
+		if r.Header.Get("Authorization") != "Bearer isolated-machine" || r.Header.Get("X-WeKnora-Key-Id") != "local-key" {
+			record(errors.New("source machine credential mismatch"))
+			w.WriteHeader(401)
+			return
+		}
+		stamp, err := strconv.ParseInt(r.Header.Get("X-WeKnora-Timestamp"), 10, 64)
+		if err != nil || stamp < time.Now().Unix()-60 || stamp > time.Now().Unix()+60 {
+			record(errors.New("source signature timestamp invalid"))
+			w.WriteHeader(401)
+			return
+		}
+		nonce := r.Header.Get("X-WeKnora-Nonce")
+		decoded, e := hex.DecodeString(nonce)
+		if e != nil || len(decoded) != 16 {
+			record(errors.New("source signature nonce invalid"))
+			w.WriteHeader(401)
+			return
+		}
+		canonicalQuery, err := ownedMachineCanonicalQuery(r.URL.RawQuery)
+		if err != nil {
+			record(err)
+			w.WriteHeader(400)
+			return
+		}
+		body := sha256.Sum256(raw)
+		canonical := strings.Join([]string{"weknora-hmac-sha256-v1", strings.ToUpper(r.Method), r.URL.EscapedPath(), canonicalQuery, hex.EncodeToString(body[:]), r.Header.Get("X-WeKnora-Timestamp"), nonce, "local-key"}, "\n")
+		key := sha256.Sum256([]byte("isolated-machine"))
+		mac := hmac.New(sha256.New, key[:])
+		_, _ = mac.Write([]byte(canonical))
+		signature, err := hex.DecodeString(r.Header.Get("X-WeKnora-Signature"))
+		if err != nil || !hmac.Equal(mac.Sum(nil), signature) {
+			record(errors.New("actual source HMAC did not bind request bytes/path/query"))
+			w.WriteHeader(401)
+			return
+		}
+		mu.Lock()
+		replay := nonces[nonce]
+		nonces[nonce] = true
+		mu.Unlock()
+		if replay {
+			record(errors.New("source machine nonce replay"))
+			w.WriteHeader(401)
+			return
+		}
+		count.Add(1)
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/capabilities"):
+			fmt.Fprint(w, `{"protocol_version":"1","instance_id":"instance"}`)
+		case strings.HasSuffix(r.URL.Path, "/bindings"):
+			fmt.Fprint(w, `{"bindings":[{"id":"binding","name":"owned delegated source","root_file_id":7,"publication_state":"active","publication_epoch":1}]}`)
+		case strings.HasSuffix(r.URL.Path, "/manifest"):
+			fmt.Fprintf(w, `{"generation":"owned-generation","complete":true,"next_cursor":null,"items":[{"file_id":77,"etag":"actual-etag","name":"source.md","path":"source.md","mime_type":"text/markdown","size":%d,"mtime":1700000000}]}`, len(artifact))
+		case strings.HasSuffix(r.URL.Path, "/changes"):
+			http.NotFound(w, r)
+		case strings.HasSuffix(r.URL.Path, "/content"):
+			if r.Header.Get("If-Match") != `"actual-etag"` {
+				record(errors.New("source file current ETag mismatch"))
+				w.WriteHeader(412)
+				return
+			}
+			w.Header().Set("ETag", `"actual-etag"`)
+			w.Header().Set("Content-Type", "text/markdown")
+			_, _ = io.WriteString(w, artifact)
+		case strings.HasSuffix(r.URL.Path, "/publication-check"):
+			var p struct{ ETag, Path string }
+			if json.Unmarshal(raw, &p) != nil || p.ETag != "actual-etag" || p.Path != "source.md" {
+				record(errors.New("source publication check not bound to current file"))
+				w.WriteHeader(400)
+				return
+			}
+			if !allow.Load() {
+				w.WriteHeader(403)
+				return
+			}
+			w.WriteHeader(204)
+		case strings.HasSuffix(r.URL.Path, "/authorize"):
+			var p struct {
+				DirectoryID     string `json:"directory_id"`
+				ObjectGUID      string `json:"object_guid"`
+				FileID          int64  `json:"file_id"`
+				ContentRevision string `json:"content_revision"`
+			}
+			if json.Unmarshal(raw, &p) != nil {
+				record(errors.New("source authorization request invalid"))
+				w.WriteHeader(400)
+				return
+			}
+			permitted := allow.Load() && p.DirectoryID == "machine-ad" && p.ObjectGUID == "aabbccdd-0011-2233-4455-667788990011" && p.FileID == 77 && p.ContentRevision == "0"
+			_ = json.NewEncoder(w).Encode(map[string]any{"allow": permitted, "reason": "owned-current-source-policy", "policy_revision": "owned-policy-1", "source_etag": "actual-etag", "source_content_revision": "0", "checked_at": time.Now().Unix()})
+		default:
+			record(errors.New("unexpected owned source endpoint"))
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(server.Close)
+	return server, allow, count, func() error { mu.Lock(); defer mu.Unlock(); return observed }
+}
+func ownedMachineCanonicalQuery(raw string) (string, error) {
+	if strings.Contains(raw, ";") {
+		return "", errors.New("source ambiguous query")
+	}
+	parts := []string{}
+	seen := map[string]bool{}
+	for _, item := range strings.Split(raw, "&") {
+		if item == "" {
+			continue
+		}
+		k, v, _ := strings.Cut(item, "=")
+		key, e := url.QueryUnescape(k)
+		if e != nil || key == "" || seen[key] {
+			return "", errors.New("source duplicate/invalid query key")
+		}
+		seen[key] = true
+		value, e := url.QueryUnescape(v)
+		if e != nil {
+			return "", errors.New("source invalid query value")
+		}
+		encode := func(s string) string { return strings.ReplaceAll(url.QueryEscape(s), "+", "%20") }
+		parts = append(parts, encode(key)+"="+encode(value))
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, "&"), nil
+}
