+package repository
+
+import (
+	"context"
+	"reflect"
+	"sort"
+	"strconv"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func (r *nextcloudOriginalUploadRead) checkContentInTx(tx *gorm.DB) error {
+	ids := make([]string, 0, len(r.contentBindings))
+	for id := range r.contentBindings {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool {
+		a, b := r.contentBindings[ids[i]].Scope, r.contentBindings[ids[j]].Scope
+		if a.TenantID != b.TenantID {
+			return a.TenantID < b.TenantID
+		}
+		if a.KnowledgeBaseID != b.KnowledgeBaseID {
+			return a.KnowledgeBaseID < b.KnowledgeBaseID
+		}
+		return a.KnowledgeID < b.KnowledgeID
+	})
+	for _, id := range ids {
+		binding := r.contentBindings[id]
+		want := binding.Lease
+		scope := binding.Scope
+		// Matches the real writer's KB -> exact order; SHARE on PostgreSQL and
+		// the actual owning write transaction on SQLite hold the local fences.
+		var kb nextcloudContentFence
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", scope.TenantID, scope.KnowledgeBaseID).Take(&kb).Error; err != nil {
+			return err
+		}
+		original, ok := r.kbFences[nextcloudOriginalKBKey(scope)]
+		if !ok || !reflect.DeepEqual(kb, original) || kb.State != "open" || kb.Epoch <= 0 {
+			return ErrNextcloudContentLeaseDenied
+		}
+		var fence nextcloudContentFence
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=?", scope.TenantID, scope.KnowledgeBaseID, scope.KnowledgeID).Take(&fence).Error; err != nil {
+			return err
+		}
+		if fence.State != "open" || fence.Epoch != want.Epoch || fence.DataSourceID != scope.DataSourceID || fence.ExternalID != scope.ExternalID {
+			return ErrNextcloudContentLeaseDenied
+		}
+		var lease nextcloudContentLeaseRow
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id=?", want.LeaseID).Take(&lease).Error; err != nil {
+			return err
+		}
+		if lease.TenantID != want.TenantID || lease.KnowledgeBaseID != want.KnowledgeBaseID || lease.KnowledgeID != want.KnowledgeID || lease.Kind != want.Kind || lease.OwnerID != want.OwnerID || lease.Epoch != want.Epoch || lease.ReleasedAtMS != nil {
+			return ErrNextcloudContentLeaseExpired
+		}
+		closed, err := nextcloudKBControlsClosed(tx, scope.TenantID, scope.KnowledgeBaseID)
+		if err != nil {
+			return err
+		}
+		if want.Kind == string(NextcloudContentReadLease) && closed {
+			return ErrNextcloudContentLeaseDenied
+		}
+		if want.Kind == string(NextcloudContentBuildLease) {
+			allowed, err := NextcloudBuildControlsAllowed(r.ctx, tx, scope.TenantID, scope.KnowledgeBaseID, scope.DataSourceID, scope.KnowledgeID)
+			if err != nil {
+				return err
+			}
+			if !allowed {
+				return ErrNextcloudContentLeaseDenied
+			}
+		}
+	}
+	return r.build.admissionCtx.Err()
+}
+func nextcloudOriginalKBKey(scope NextcloudContentScope) string {
+	return strconv.FormatUint(scope.TenantID, 10) + "/" + scope.KnowledgeBaseID
+}
+
+func (r *nextcloudOriginalUploadRead) checkInTx(tx *gorm.DB, remote bool) error {
+	if err := r.checkLocalInTx(tx); err != nil {
+		return err
+	}
+	if remote {
+		if err := r.checkSourcesInTx(tx); err != nil {
+			return err
+		}
+	}
+	if err := checkOriginalBodyAvailableBatchForCapturedInTx(r.ctx, tx, r.rows, r.heads); err != nil {
+		return err
+	}
+	return r.finalClockInTx(tx, nil, nil)
+}
+
+type nextcloudOriginalFinalRow struct {
+	Category                                      string
+	LeaseID, Kind, OwnerID                        string
+	BodyID                                        string `gorm:"column:lease_body_id"`
+	Epoch, ExpiresAtMS, FinalClockMS              int64
+	ReleasedAtMS                                  *int64
+	TenantID                                      uint64
+	KnowledgeBaseID, KnowledgeID                  string
+	FenceEpoch, KBEpoch                           int64
+	FenceState, KBState, DataSourceID, ExternalID string
+	DirectoryEnabled                              bool
+	DirectoryLastSyncMS                           *int64
+	DirectoryLastSyncError                        string
+	Body                                          originalBodyPayload `gorm:"embedded;embeddedPrefix:body_"`
+}
+
+// The caller has completed all remote, model, journal, physical and native-index
+// IO. This ONE statement supplies one actual clock and fresh body/content tuples
+// together. No model/source/body IO is permitted after this boundary.
+func (r *nextcloudOriginalUploadRead) finalClockInTx(tx *gorm.DB, extra map[string]originalBodyLease, payloads map[string]originalBodyPayload) error {
+	if err := r.samePool(tx); err != nil {
+		return err
+	}
+	expected := map[string]originalBodyLease{}
+	for _, l := range r.leases {
+		expected[l.LeaseID] = l
+	}
+	for id, l := range extra {
+		if prior, ok := expected[id]; ok && prior != l {
+			return ErrOriginalBodyUnavailable
+		}
+		expected[id] = l
+	}
+	bodyIDs := []string{}
+	for id := range expected {
+		bodyIDs = append(bodyIDs, id)
+	}
+	sort.Strings(bodyIDs)
+	contentIDs := []string{}
+	for id := range r.contentBindings {
+		contentIDs = append(contentIDs, id)
+	}
+	sort.Strings(contentIDs)
+	if len(bodyIDs) == 0 || len(contentIDs) == 0 {
+		return ErrOriginalBodyUnavailable
+	}
+	clock := "CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)"
+	if tx.Dialector.Name() == "postgres" {
+		clock = "CAST(EXTRACT(EPOCH FROM clock_timestamp())*1000 AS BIGINT)"
+	}
+	directoryClock := "CAST((julianday(last_successful_sync_at)-2440587.5)*86400000 AS INTEGER)"
+	if tx.Dialector.Name() == "postgres" {
+		directoryClock = "CAST(EXTRACT(EPOCH FROM last_successful_sync_at)*1000 AS BIGINT)"
+	}
+	query := `WITH tick AS MATERIALIZED (SELECT ` + clock + ` AS now_ms), actor AS MATERIALIZED (SELECT enabled,` + directoryClock + ` AS synced_ms,COALESCE(last_sync_error,'') AS sync_error FROM directories WHERE id=?)
+ SELECT 'body' AS category,l.lease_id,l.body_id AS lease_body_id,l.kind,l.owner_id,l.epoch,l.expires_at_ms,l.released_at_ms,t.now_ms AS final_clock_ms,
+ 0 AS tenant_id,'' AS knowledge_base_id,'' AS knowledge_id,0 AS fence_epoch,0 AS kb_epoch,'' AS fence_state,'' AS kb_state,'' AS datasource_id,'' AS external_id,
+ p.id AS body_id,p.tenant_id AS body_tenant_id,p.body_sha256 AS body_body_sha256,p.origin_domain_sha256 AS body_origin_domain_sha256,p.payload AS body_payload,p.body_bytes AS body_body_bytes,p.storage_kind AS body_storage_kind,p.state AS body_state,p.created_at_ms AS body_created_at_ms,p.last_checked_at_ms AS body_last_checked_at_ms,p.retired_at_ms AS body_retired_at_ms,p.body_deadline_ms AS body_body_deadline_ms,p.metadata_deadline_ms AS body_metadata_deadline_ms,p.purge_token AS body_purge_token,p.purge_epoch AS body_purge_epoch,a.enabled AS directory_enabled,a.synced_ms AS directory_last_sync_ms,a.sync_error AS directory_last_sync_error
+ FROM original_body_leases l JOIN original_body_payloads p ON p.id=l.body_id CROSS JOIN tick t CROSS JOIN actor a WHERE l.lease_id IN ?
+ UNION ALL
+ SELECT 'content',l.lease_id,'',l.kind,l.owner_id,l.epoch,l.expires_at_ms,l.released_at_ms,t.now_ms,l.tenant_id,l.knowledge_base_id,l.knowledge_id,f.epoch,k.epoch,f.state,k.state,f.datasource_id,f.external_id,
+ '',0,'','',NULL,0,'','',0,0,NULL,NULL,NULL,'',0,a.enabled,a.synced_ms,a.sync_error
+ FROM nextcloud_content_leases l JOIN nextcloud_content_fences f ON f.tenant_id=l.tenant_id AND f.knowledge_base_id=l.knowledge_base_id AND f.knowledge_id=l.knowledge_id
+ JOIN nextcloud_content_fences k ON k.tenant_id=l.tenant_id AND k.knowledge_base_id=l.knowledge_base_id AND k.knowledge_id='' CROSS JOIN tick t CROSS JOIN actor a WHERE l.lease_id IN ?`
+	// Payload columns use their exact embedded prefix; lease_body_id cannot
+	// collide with the payload primary key in GORM's row scanner.
+	var rows []nextcloudOriginalFinalRow
+	if err := bodyInternal(tx).Raw(query, r.operation.ActorDirectoryID, bodyIDs, contentIDs).Scan(&rows).Error; err != nil {
+		return err
+	}
+	if len(rows) != len(bodyIDs)+len(contentIDs) {
+		return ErrOriginalBodyUnavailable
+	}
+	seen := map[string]bool{}
+	for _, row := range rows {
+		if !row.DirectoryEnabled || row.DirectoryLastSyncMS == nil || row.DirectoryLastSyncError != "" || *row.DirectoryLastSyncMS > row.FinalClockMS || row.FinalClockMS-*row.DirectoryLastSyncMS > 300000 {
+			return ErrNextcloudOnboardingDenied
+		}
+		if seen[row.LeaseID] || row.ReleasedAtMS != nil || row.ExpiresAtMS <= row.FinalClockMS {
+			return ErrOriginalBodyUnavailable
+		}
+		seen[row.LeaseID] = true
+		if row.Category == "body" {
+			want, ok := expected[row.LeaseID]
+			if !ok || row.BodyID != want.BodyID || row.Kind != want.Kind || row.Kind != "read" || row.OwnerID != want.OwnerID || row.Epoch != want.Epoch {
+				return ErrOriginalBodyUnavailable
+			}
+			actual := row.Body
+			original, ok := r.bodies[want.BodyID]
+			if !ok {
+				original, ok = payloads[want.BodyID]
+			}
+			if r.predecessors[want.BodyID] {
+				// The initial knowledge DTO may have an authored processing successor.
+				// Retirement deadlines are metadata, not read authority: keep exact bytes,
+				// domain/scope, storage, SHA, purge state/epoch and the actual read lease.
+				// Current index bodies additionally retain their own exact head/payload
+				// checks in the input operation; this never approves a current successor.
+				actual.RetiredAtMS = original.RetiredAtMS
+				actual.BodyDeadlineMS = original.BodyDeadlineMS
+				actual.MetadataDeadlineMS = original.MetadataDeadlineMS
+			}
+			if !ok || actual.State != "live" || actual.PurgeEpoch != want.Epoch || !reflect.DeepEqual(actual, original) {
+				return ErrOriginalBodyUnavailable
+			}
+		} else if row.Category == "content" {
+			binding, ok := r.contentBindings[row.LeaseID]
+			want := binding.Lease
+			scope := binding.Scope
+			kb, hasKB := r.kbFences[nextcloudOriginalKBKey(scope)]
+			if !ok || !hasKB || row.TenantID != want.TenantID || row.KnowledgeBaseID != want.KnowledgeBaseID || row.KnowledgeID != want.KnowledgeID || row.Kind != want.Kind || row.OwnerID != want.OwnerID || row.Epoch != want.Epoch || row.FenceEpoch != want.Epoch || row.KBEpoch != kb.Epoch || row.FenceState != "open" || row.KBState != "open" || row.DataSourceID != scope.DataSourceID || row.ExternalID != scope.ExternalID {
+				return ErrNextcloudContentLeaseExpired
+			}
+		} else {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	if err := r.build.admissionCtx.Err(); err != nil {
+		return err
+	}
+	return r.ctx.Err()
+}
+
+func nextcloudOriginalUploadInContext(ctx context.Context) *nextcloudOriginalUploadRead {
+	r, _ := ctx.Value(nextcloudOriginalUploadReadKey{}).(*nextcloudOriginalUploadRead)
+	return r
+}
