+
+// No inherited knowledge reader is invoked here. The authentic config origin
+// supplies selectors only; its digest/revision and complete source union are
+// checked before any body/head/lease allocation, then fully verified afterwards.
+func nextcloudConfigurationLineageMetadataInTx(tx *gorm.DB, kb *types.KnowledgeBase) (*types.SourceLineage, error) {
+	revision, err := knowledgeConfigurationControlRevision(tx, kb.ID)
+	if err != nil {
+		return nil, err
+	}
+	var origin knowledgeConfigurationInputOrigin
+	if err = tx.Where("tenant_id=? AND knowledge_base_id=? AND config_revision=?", kb.TenantID, kb.ID, revision).Take(&origin).Error; err != nil {
+		return nil, err
+	}
+	digest, err := knowledgeConfigurationOriginDigest(kb)
+	if err != nil || digest != origin.InputDigest {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var lineage types.SourceLineage
+	if json.Unmarshal([]byte(origin.SourceLineage), &lineage) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	if err = lineage.RequireComplete(); err != nil {
+		return nil, err
+	}
+	return types.UnionSourceLineage(&lineage)
+}
+
+// Current own-source verification needs identity/config fields, not current
+// Title/Description/Profile/body. In particular, a lawful processing successor
+// is not hydrated under the initial predecessor's lease. file_name is an exact
+// SQL predicate against the immutable, already leased upload artifact, rather
+// than a newly hydrated current field. Actual index content is separately read
+// only after the input operation claims its current knowledge/chunk bodies.
+func (r *nextcloudOriginalUploadRead) ownSourceMetadataInTx(tx *gorm.DB) (*types.Knowledge, error) {
+	keys := []string{"datasource_id", "external_id", "source_resource_id", "nextcloud_instance_id", "nextcloud_binding_id", "nextcloud_file_id", "nextcloud_target_etag", "nextcloud_path", "nextcloud_content_revision", "process_overrides"}
+	quoted := []string{}
+	for _, key := range keys {
+		quoted = append(quoted, "'"+key+"'")
+	}
+	// Preserve absence, JSON null, booleans, and object/array types exactly;
+	// absent legacy content_revision must not become a new explicit null value.
+	expression := "COALESCE((SELECT json_group_object(key,CASE WHEN type IN ('object','array') THEN json(value) WHEN type='true' THEN json('true') WHEN type='false' THEN json('false') ELSE value END) FROM json_each(knowledges.metadata) WHERE key IN (" + strings.Join(quoted, ",") + ")),'{}')"
+	if tx.Dialector.Name() == "postgres" {
+		expression = "COALESCE((SELECT jsonb_object_agg(key,value) FROM jsonb_each(knowledges.metadata) WHERE key IN (" + strings.Join(quoted, ",") + ")),'{}'::jsonb)"
+	}
+	var k types.Knowledge
+	// Internal projection excludes every body152 application field, including
+	// metadata.manual.content; callbacks must not hydrate the excluded leaves.
+	query := bodyInternal(tx).Table("knowledges").Select("id,tenant_id,knowledge_base_id,channel,type,file_path,"+expression+" AS metadata").Where("id=? AND tenant_id=? AND knowledge_base_id=? AND channel=? AND type=? AND file_name=?", r.payload.KnowledgeID, r.payload.TenantID, r.payload.KnowledgeBaseID, types.ConnectorTypeNextcloud, "file", r.actual.Artifact.FileName)
+	if err := query.Take(&k).Error; err != nil {
+		return nil, err
+	}
+	k.FileName = r.actual.Artifact.FileName
+	return &k, nil
+}
+
+// This preflight precedes every inherited full reader. It pins the exact named
+// heads in writer order, checks physical/journal availability, then verifies
+// the real private lease tuples and actual SQL expiry. It creates no origin.
+func (r *nextcloudOriginalUploadRead) bodyReadPreflightInTx(tx *gorm.DB) error {
+	slots := []string{}
+	for _, head := range r.heads {
+		slots = append(slots, head.SlotID)
+	}
+	sort.Strings(slots)
+	var heads []originalBodyFieldHead
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("slot_id IN ?", slots).Order("slot_id").Find(&heads).Error; err != nil {
+		return err
+	}
+	if !sameOriginalBodyHeads(r.heads, heads) {
+		return ErrOriginalBodyUnavailable
+	}
+	if err := checkOriginalBodyAvailableBatchForCapturedInTx(r.ctx, tx, r.rows, r.heads); err != nil {
+		return err
+	}
+	ids := []string{}
+	wanted := map[string]originalBodyLease{}
+	for _, lease := range r.leases {
+		ids = append(ids, lease.LeaseID)
+		wanted[lease.LeaseID] = lease
+	}
+	sort.Strings(ids)
+	var leases []originalBodyLease
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id IN ?", ids).Order("lease_id").Find(&leases).Error; err != nil {
+		return err
+	}
+	if len(leases) != len(ids) {
+		return ErrOriginalBodyUnavailable
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return err
+	}
+	for _, lease := range leases {
+		original, ok := wanted[lease.LeaseID]
+		if !ok || lease.BodyID != original.BodyID || lease.OwnerID != original.OwnerID || lease.Kind != original.Kind || lease.Epoch != original.Epoch || lease.ReleasedAtMS != nil || lease.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return r.ctx.Err()
+}
+
+// Pure identity matching for the actual private machine capability, not a read
+// or execution authorization. Actual model/body/source checks remain required.
+// Ordinary callers/historical readers continue to use their existing helpers.
+func SameNextcloudEmbeddingPurposeCaller(ctx, other context.Context) bool {
+	if ctx == nil || other == nil || ctx.Err() != nil || other.Err() != nil {
+		return false
+	}
+	r := nextcloudOriginalUploadInContext(ctx)
+	if r == nil || nextcloudOriginalUploadInContext(other) != r {
+		return false
+	}
+	r.mu.Lock()
+	live := !r.closed && r.failed == nil
+	r.mu.Unlock()
+	if !live || r.ctx.Err() != nil || r.build.admissionCtx == nil || r.build.admissionCtx.Err() != nil {
+		return false
+	}
+	for _, candidate := range []context.Context{ctx, other} {
+		tenant, hasTenant := types.TenantIDFromContext(candidate)
+		savedTenant, hadTenant := types.TenantIDFromContext(r.ctx)
+		if hasTenant != hadTenant || tenant != savedTenant || !hasTenant || tenant != r.payload.TenantID {
+			return false
+		}
+		build, ok := candidate.Value(nextcloudBuildContextKey{}).(nextcloudBuildContext)
+		concrete, real := build.validator.(*NextcloudContentLeaseStore)
+		original, originalReal := r.build.validator.(*NextcloudContentLeaseStore)
+		if !ok || !real || !originalReal || concrete != original || build.scope != r.build.scope || !sameNextcloudOriginalContext(build.admissionCtx, r.build.admissionCtx) || build.lease.ID != r.build.lease.ID || build.lease.OwnerID != r.build.lease.OwnerID || build.lease.Kind != r.build.lease.Kind || build.lease.Epoch != r.build.lease.Epoch || build.lease.TenantID != r.build.lease.TenantID || build.lease.KnowledgeBaseID != r.build.lease.KnowledgeBaseID || build.lease.KnowledgeID != r.build.lease.KnowledgeID {
+			return false
+		}
+		caller, hasCaller := candidate.Value(types.CallerContextKey).(types.Caller)
+		captured, hadCaller := r.ctx.Value(types.CallerContextKey).(types.Caller)
+		if hasCaller != hadCaller || !reflect.DeepEqual(caller, captured) || !reflect.DeepEqual(types.CallerFromContext(candidate), types.CallerFromContext(r.ctx)) {
+			return false
+		}
+		principal, hasPrincipal := types.PrincipalFromContext(candidate)
+		saved, hadPrincipal := types.PrincipalFromContext(r.ctx)
+		if hasPrincipal != hadPrincipal || !reflect.DeepEqual(principal, saved) {
+			return false
+		}
+		key, hasKey := types.TenantAPIKeyScopeFromContext(candidate)
+		savedKey, hadKey := types.TenantAPIKeyScopeFromContext(r.ctx)
+		if hasKey != hadKey || !reflect.DeepEqual(key, savedKey) {
+			return false
+		}
+	}
+	return true
+}
+
+func sameKnowledgeSQLiteEmbeddingCaller(ctx, other context.Context) bool {
+	if nextcloudOriginalUploadInContext(ctx) != nil || nextcloudOriginalUploadInContext(other) != nil {
+		return SameNextcloudEmbeddingPurposeCaller(ctx, other)
+	}
+	return sameOriginalModelCallerInRepository(ctx, other)
+}
+
+func sameNextcloudOriginalContext(a, b context.Context) bool {
+	if a == nil || b == nil {
+		return false
+	}
+	left, right := reflect.ValueOf(a), reflect.ValueOf(b)
+	return left.Type() == right.Type() && left.Comparable() && right.Comparable() && left.Interface() == right.Interface()
+}
