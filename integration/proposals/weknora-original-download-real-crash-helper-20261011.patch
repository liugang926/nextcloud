+// These opt-in helpers are independent OS processes in one exact owned runtime.
+// They never run the app or rebuild the binary. Child receives storage/routing,
+// not a Caller, proof, Snapshot or memory-only release capability.
+const originalCrashModeEnv = "WEKNORA_ORIGINAL_DOWNLOAD_CRASH_CHILD_MODE"
+const originalCrashManifestEnv = "WEKNORA_ORIGINAL_DOWNLOAD_CRASH_MANIFEST"
+
+type originalCrashManifest struct {
+	Version                                                                int
+	Nonce, SourceHead, BinarySHA, DBPath, RunDir, ModelID                  string
+	BinaryBytes                                                            int64
+	ExpectedEUID                                                           int
+	DeadlineMS                                                             int64
+	SchemaSHA, JournalID, JournalDirectory, JournalKeyPath, JournalPinPath string
+	JournalKeySHA, JournalPinSHA, AESKeySHA                                string
+}
+type originalCrashRuntimeIdentity struct {
+	Nonce, ContainerID, ImageID, SourceHead, BinarySHA string
+	Entrypoint, Command, Mounts                        []string
+	EnvironmentSHA                                     string
+	ParentPID                                          int
+}
+type originalCrashKillIdentity struct {
+	Nonce, ContainerID, BinarySHA string
+	ParentPID, ChildPID           int
+}
+type originalCrashLease struct {
+	LeaseID, BodyID, OwnerID, Kind string
+	Epoch, ExpiresAtMS             int64
+	ReleasedAtMS                   *int64
+}
+type originalCrashOwner struct {
+	LeaseID, AttemptID, AttemptDigest, BodyID, OwnerID, Kind, Digest string
+	Epoch                                                            int64
+}
+type originalCrashSnapshot struct {
+	PID                                                                                                                        int
+	OriginalFactsSHA, OriginalBodiesSHA                                                                                        string
+	ModelID, DispatchID, DispatchDigest, InputStateID, ProofDigest, ProofSHA, RecipeDigest, AttemptID, AttemptDigest, ResultID string
+	LeaseUntilMS, AttemptExpiresMS, SQLNowMS                                                                                   int64
+	Attempts                                                                                                                   uint64
+	Owners                                                                                                                     []originalCrashOwner
+	Leases                                                                                                                     []originalCrashLease
+	Status                                                                                                                     types.ModelStatus
+}
+
+func originalCrashSHA(v []byte) string { d := sha256.Sum256(v); return hex.EncodeToString(d[:]) }
+func originalCrashFileSHA(path string) (string, int64, error) {
+	f, e := os.Open(path)
+	if e != nil {
+		return "", 0, e
+	}
+	defer f.Close()
+	h := sha256.New()
+	n, e := io.Copy(h, f)
+	if e != nil {
+		return "", n, e
+	}
+	return hex.EncodeToString(h.Sum(nil)), n, nil
+}
+func originalCrashWriteJSON(path string, v interface{}) error {
+	data, e := json.MarshalIndent(v, "", "  ")
+	if e != nil {
+		return e
+	}
+	temp := path + ".tmp"
+	if e = os.WriteFile(temp, append(data, '\n'), 0600); e != nil {
+		return e
+	}
+	return os.Rename(temp, path)
+}
+func originalCrashReadJSON(path string, v interface{}) error {
+	b, e := os.ReadFile(path)
+	if e != nil {
+		return e
+	}
+	return json.Unmarshal(b, v)
+}
+func originalCrashEmit(kind, nonce, path string, v interface{}) error {
+	if e := originalCrashWriteJSON(path, v); e != nil {
+		return e
+	}
+	sha, _, e := originalCrashFileSHA(path)
+	if e != nil {
+		return e
+	}
+	// Metadata-only stdout: no DSN/key/plaintext/model body or assumed success.
+	b, e := json.Marshal(map[string]interface{}{"event": kind, "nonce": nonce, "pid": os.Getpid(), "metadata_sha256": sha})
+	if e != nil {
+		return e
+	}
+	_, e = fmt.Fprintln(os.Stdout, string(b))
+	return e
+}
+func originalCrashOpenDB(path string) (*gorm.DB, error) {
+	if !filepath.IsAbs(path) {
+		return nil, fmt.Errorf("crash fixture DB must be absolute")
+	}
+	db, e := gorm.Open(sqlite.Open("file:"+filepath.ToSlash(path)+"?_busy_timeout=5000&_journal_mode=WAL&_foreign_keys=on"), &gorm.Config{Logger: gormlogger.Default.LogMode(gormlogger.Silent)})
+	if e != nil {
+		return nil, e
+	}
+	pool, e := db.DB()
+	if e != nil {
+		return nil, e
+	}
+	pool.SetMaxOpenConns(1)
+	pool.SetMaxIdleConns(1)
+	if e = repository.InstallOriginalBodyRetentionCallbacks(db); e != nil {
+		_ = pool.Close()
+		return nil, e
+	}
+	return db, nil
+}
+func originalCrashSchemaSHA(db *gorm.DB) (string, error) {
+	var schema []struct{ Type, Name, SQL string }
+	e := db.Raw("SELECT type,name,sql FROM sqlite_master WHERE type IN ('table','index','trigger') AND name NOT LIKE 'sqlite_%' ORDER BY type,name").Scan(&schema).Error
+	if e != nil {
+		return "", e
+	}
+	b, e := json.Marshal(schema)
+	return originalCrashSHA(b), e
+}
+func originalCrashSQLNow(db *gorm.DB) (int64, error) {
+	var n int64
+	e := db.Raw("SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)").Scan(&n).Error
+	return n, e
+}
+func originalCrashServices(db *gorm.DB) (interfaces.ModelRepository, interfaces.ModelService, *repository.KnowledgeInputProvenanceStore) {
+	store := repository.NewKnowledgeInputProvenanceStore(db)
+	groups := NewGroupAccessService(repository.NewGroupAccessRepository(db))
+	repository.ConfigureKnowledgeInputActorGroupAccess(store, groups)
+	repo := repository.NewModelRepository(db)
+	ConfigureModelOriginalAuthority(repo, store, groups, nil)
+	return repo, NewModelService(repo, nil, nil, nil, nil, nil), store
+}
+func originalCrashSnapshotInDB(ctx context.Context, db *gorm.DB, id string) (originalCrashSnapshot, error) {
+	s := originalCrashSnapshot{PID: os.Getpid(), ModelID: id}
+	fresh := func() *gorm.DB { return db.Session(&gorm.Session{NewDB: true, Context: ctx}) }
+	var d struct {
+		ID, InputStateID, ProofJSON, ProofDigest, RecipeDigest, Digest, AttemptID, ResultID string
+		LeaseUntilMS                                                                        int64
+		Attempts                                                                            uint64
+	}
+	if e := fresh().Table("model_download_dispatches").Where("model_id=?", id).Take(&d).Error; e != nil {
+		return s, e
+	}
+	s.DispatchID, s.DispatchDigest, s.InputStateID, s.ProofDigest, s.ProofSHA, s.RecipeDigest, s.AttemptID, s.ResultID, s.LeaseUntilMS, s.Attempts = d.ID, d.Digest, d.InputStateID, d.ProofDigest, originalCrashSHA([]byte(d.ProofJSON)), d.RecipeDigest, d.AttemptID, d.ResultID, d.LeaseUntilMS, d.Attempts
+	var proof types.ModelOriginalProof
+	if e := json.Unmarshal([]byte(d.ProofJSON), &proof); e != nil {
+		return s, e
+	}
+	if !proof.Valid() || proof.Digest != d.ProofDigest || proof.StateID != d.InputStateID {
+		return s, fmt.Errorf("persisted creation proof mismatch")
+	}
+	var definition types.ModelDefinitionOriginal
+	var credential types.ModelCredentialOriginal
+	var state types.ModelStateOriginal
+	if e := fresh().Where("id=?", proof.DefinitionID).Take(&definition).Error; e != nil {
+		return s, e
+	}
+	if e := fresh().Where("id=?", proof.CredentialID).Take(&credential).Error; e != nil {
+		return s, e
+	}
+	if e := fresh().Where("id=?", proof.StateID).Take(&state).Error; e != nil {
+		return s, e
+	}
+	dd, cd, sd := definition, credential, state
+	dd.Digest = ""
+	cd.Digest = ""
+	sd.Digest = ""
+	dd.CreatedAt = dd.CreatedAt.UTC()
+	cd.CreatedAt = cd.CreatedAt.UTC()
+	sd.CreatedAt = sd.CreatedAt.UTC()
+	defSHA, e := repository.KnowledgeInputDigest(dd)
+	if e != nil {
+		return s, e
+	}
+	credSHA, e := repository.KnowledgeInputDigest(cd)
+	if e != nil {
+		return s, e
+	}
+	stateSHA, e := repository.KnowledgeInputDigest(sd)
+	if e != nil {
+		return s, e
+	}
+	if defSHA != definition.Digest || defSHA != proof.DefinitionDigest || credSHA != credential.Digest || credSHA != proof.CredentialDigest || stateSHA != state.Digest || stateSHA != proof.StateDigest || state.DefinitionID != definition.ID || state.CredentialID != credential.ID || state.Status != types.ModelStatusDownloading {
+		return s, fmt.Errorf("immutable creation fact digest mismatch")
+	}
+	var receipts []types.ModelOriginalBodyReceipt
+	if e := fresh().Where("origin_id IN ?", []string{proof.DefinitionID, proof.CredentialID}).Order("origin_id").Find(&receipts).Error; e != nil {
+		return s, e
+	}
+	if len(receipts) != 2 {
+		return s, fmt.Errorf("creation body receipt count")
+	}
+	bodyIDs := []string{}
+	for _, receipt := range receipts {
+		value := receipt
+		value.Digest = ""
+		value.CreatedAt = value.CreatedAt.UTC()
+		actual, e := repository.KnowledgeInputDigest(value)
+		if e != nil {
+			return s, e
+		}
+		expected := proof.DefinitionBodyReceiptDigest
+		if receipt.OriginID == proof.CredentialID {
+			expected = proof.CredentialBodyReceiptDigest
+		}
+		if actual != receipt.Digest || actual != expected {
+			return s, fmt.Errorf("creation body receipt digest mismatch")
+		}
+		bodyIDs = append(bodyIDs, receipt.BodyID)
+	}
+	facts, e := json.Marshal(struct {
+		Definition types.ModelDefinitionOriginal
+		Credential types.ModelCredentialOriginal
+		State      types.ModelStateOriginal
+		Receipts   []types.ModelOriginalBodyReceipt
+	}{definition, credential, state, receipts})
+	if e != nil {
+		return s, e
+	}
+	s.OriginalFactsSHA = originalCrashSHA(facts)
+	var payloads []struct {
+		ID, BodySHA256, State, StorageKind string
+		TenantID                           uint64
+		Payload                            *string
+		PurgeEpoch, BodyBytes              int64
+	}
+	if e := fresh().Table("original_body_payloads").Where("id IN ?", bodyIDs).Order("id").Find(&payloads).Error; e != nil {
+		return s, e
+	}
+	if len(payloads) != 2 {
+		return s, fmt.Errorf("creation payload count")
+	}
+	for _, body := range payloads {
+		var receipt *types.ModelOriginalBodyReceipt
+		for i := range receipts {
+			if receipts[i].BodyID == body.ID {
+				if receipt != nil {
+					return s, fmt.Errorf("ambiguous creation body receipt")
+				}
+				receipt = &receipts[i]
+			}
+		}
+		if receipt == nil {
+			return s, fmt.Errorf("creation body receipt absent")
+		}
+		table, column, raw := "model_definition_originals", "definition_json", definition.DefinitionJSON
+		originID, originDigest, originKind := definition.ID, definition.Digest, "definition"
+		if receipt.OriginID == credential.ID {
+			table, column, raw = "model_credential_originals", "credential_json", credential.CredentialJSON
+			originID, originDigest, originKind = credential.ID, credential.Digest, "credential"
+		}
+		if receipt.OriginID != originID || receipt.OriginKind != originKind || receipt.OriginDigest != originDigest || receipt.TenantID != proof.OwnerTenantID || receipt.BodyID != body.ID {
+			return s, fmt.Errorf("creation receipt/source identity mismatch")
+		}
+		var head struct {
+			SlotID, SourceTable, RowKey, ColumnName, OwnerKind, OwnerID, SourceIdentitySHA256, BodyID, KnowledgeBaseID, KnowledgeID, OriginalBodyRef string
+			TenantID                                                                                                                                 uint64
+			Revision                                                                                                                                 int64
+		}
+		if e := fresh().Table("original_body_field_heads").Where("source_table=? AND row_key=? AND column_name=?", table, originID, column).Take(&head).Error; e != nil {
+			return s, e
+		}
+		if head.SourceTable != table || head.RowKey != originID || head.ColumnName != column || head.OwnerKind != table || head.OwnerID != originID || head.TenantID != proof.OwnerTenantID || head.KnowledgeBaseID != "" || head.KnowledgeID != "" || head.SlotID != receipt.SlotID || head.BodyID != body.ID || head.Revision != receipt.HeadRevision || head.SourceIdentitySHA256 != receipt.SourceIdentitySHA256 {
+			return s, fmt.Errorf("creation captured head binding mismatch")
+		}
+		var ref struct {
+			Version int    `json:"_original_body_version"`
+			SlotID  string `json:"slot_id"`
+			BodyID  string `json:"body_id"`
+			SHA     string `json:"sha256"`
+		}
+		if e := json.Unmarshal([]byte(head.OriginalBodyRef), &ref); e != nil {
+			return s, e
+		}
+		sourceSHA := originalCrashSHA([]byte(raw))
+		if ref.Version != 1 || ref.SlotID != head.SlotID || ref.BodyID != body.ID || ref.SHA != sourceSHA || receipt.BodyDigest != sourceSHA || body.BodySHA256 != sourceSHA || body.BodyBytes != int64(len([]byte(raw))) || body.TenantID != proof.OwnerTenantID || body.State != "live" || body.StorageKind != "inline" {
+			return s, fmt.Errorf("creation inline source bytes/metadata unavailable")
+		}
+		// Actual inline representation lives in the original source column. Payload
+		// is normally nil; an observed nonnil copy still must match those exact bytes.
+		if body.Payload != nil && (*body.Payload != raw || originalCrashSHA([]byte(*body.Payload)) != sourceSHA) {
+			return s, fmt.Errorf("creation inline payload copy mismatch")
+		}
+	}
+	bodies, e := json.Marshal(payloads)
+	if e != nil {
+		return s, e
+	}
+	s.OriginalBodiesSHA = originalCrashSHA(bodies)
+
+	if d.AttemptID != "" {
+		var a struct {
+			ID, Digest  string
+			ExpiresAtMS int64
+		}
+		if e := fresh().Table("model_download_attempts").Where("id=? AND dispatch_id=? AND dispatch_digest=?", d.AttemptID, d.ID, d.Digest).Take(&a).Error; e != nil {
+			return s, e
+		}
+		s.AttemptDigest, s.AttemptExpiresMS = a.Digest, a.ExpiresAtMS
+	}
+	if e := fresh().Table("model_download_lease_owners").Where("attempt_id IN (SELECT id FROM model_download_attempts WHERE dispatch_id=?)", d.ID).Order("lease_id").Find(&s.Owners).Error; e != nil {
+		return s, e
+	}
+	ids := []string{}
+	for _, o := range s.Owners {
+		ids = append(ids, o.LeaseID)
+	}
+	if len(ids) > 0 {
+		if e := fresh().Table("original_body_leases").Where("lease_id IN ?", ids).Order("lease_id").Find(&s.Leases).Error; e != nil {
+			return s, e
+		}
+	}
+	var model struct{ Status types.ModelStatus }
+	if e := fresh().Table("models").Select("status").Where("id=?", id).Take(&model).Error; e != nil {
+		return s, e
+	}
+	s.Status = model.Status
+	n, e := originalCrashSQLNow(fresh())
+	s.SQLNowMS = n
+	return s, e
+}
+func originalCrashValidReady(s originalCrashSnapshot) error {
+	if s.ResultID != "" || s.Status != types.ModelStatusDownloading || s.AttemptID == "" || s.Attempts != 1 || s.LeaseUntilMS != s.AttemptExpiresMS || s.SQLNowMS >= s.AttemptExpiresMS || len(s.Owners) != 2 || len(s.Leases) != 2 {
+		return fmt.Errorf("first ready must contain the real committed first claim and two unreleased leases")
+	}
+	for _, o := range s.Owners {
+		if o.AttemptID != s.AttemptID || o.AttemptDigest != s.AttemptDigest || o.OwnerID != "model-original-read/download/"+s.AttemptID || o.Kind != "read" {
+			return fmt.Errorf("first owner fact does not bind the real attempt")
+		}
+		found := false
+		for _, l := range s.Leases {
+			if l.LeaseID == o.LeaseID {
+				found = l.BodyID == o.BodyID && l.OwnerID == o.OwnerID && l.Kind == o.Kind && l.Epoch == o.Epoch && l.ReleasedAtMS == nil && l.ExpiresAtMS > s.SQLNowMS
+			}
+		}
+		if !found {
+			return fmt.Errorf("first owner/lease tuple mismatch")
+		}
+	}
+	return nil
+}
