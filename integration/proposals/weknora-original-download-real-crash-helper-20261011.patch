+func TestOriginalLocalDownloadCrashChild(t *testing.T) {
+	mode := os.Getenv(originalCrashModeEnv)
+	if mode == "" {
+		t.Skip("dedicated subprocess only")
+	}
+	require.Contains(t, []string{"first", "recover"}, mode)
+	var m originalCrashManifest
+	require.NoError(t, originalCrashReadJSON(os.Getenv(originalCrashManifestEnv), &m))
+	require.Equal(t, 1, m.Version)
+	require.NotEmpty(t, m.Nonce)
+	require.Equal(t, m.ExpectedEUID, os.Geteuid())
+	executable, e := os.Executable()
+	require.NoError(t, e)
+	sha, bytes, e := originalCrashFileSHA(executable)
+	require.NoError(t, e)
+	require.Equal(t, m.BinarySHA, sha)
+	require.Equal(t, m.BinaryBytes, bytes)
+	require.Equal(t, m.JournalDirectory, os.Getenv("WEKNORA_ORIGINAL_BODY_JOURNAL_DIRECTORY"))
+	require.Equal(t, m.JournalKeyPath, os.Getenv("WEKNORA_ORIGINAL_BODY_JOURNAL_KEY"))
+	require.Equal(t, m.JournalPinPath, os.Getenv("WEKNORA_ORIGINAL_BODY_JOURNAL_PIN"))
+	require.Equal(t, m.AESKeySHA, originalCrashSHA([]byte(os.Getenv("SYSTEM_AES_KEY"))))
+	keySHA, _, e := originalCrashFileSHA(m.JournalKeyPath)
+	require.NoError(t, e)
+	require.Equal(t, m.JournalKeySHA, keySHA)
+	pinSHA, _, e := originalCrashFileSHA(m.JournalPinPath)
+	require.NoError(t, e)
+	require.Equal(t, m.JournalPinSHA, pinSHA)
+	db, e := originalCrashOpenDB(m.DBPath)
+	require.NoError(t, e)
+	pool, e := db.DB()
+	require.NoError(t, e)
+	defer pool.Close()
+	var journalMode string
+	require.NoError(t, db.Raw("PRAGMA journal_mode").Scan(&journalMode).Error)
+	require.Equal(t, "wal", strings.ToLower(journalMode))
+	schema, e := originalCrashSchemaSHA(db)
+	require.NoError(t, e)
+	require.Equal(t, m.SchemaSHA, schema)
+	var anchor struct{ JournalID string }
+	require.NoError(t, db.Table("original_body_journal_heads").Select("journal_id").Where("id=1").Take(&anchor).Error)
+	require.Equal(t, m.JournalID, anchor.JournalID)
+	require.NoError(t, repository.NewOriginalBodyRetentionStore(db).VerifyJournalReady()) // No Initialize/new anchor in child.
+	utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+	defer utils.ResetSSRFWhitelistForTest()
+	repo, models, _ := originalCrashServices(db)
+	life := models.(interfaces.ModelOriginalDownloadLifecycle)
+	cleanup := models.(interfaces.ModelOriginalDownloadCleanupLifecycle)
+	deadline := time.UnixMilli(m.DeadlineMS)
+	ctx, cancel := context.WithDeadline(context.Background(), deadline)
+	defer cancel()
+	// First has no graceful defer: the parent must kill this exact OS process.
+	// Recovery has an explicit final join after the real output is proved.
+	life.StartOriginalDownloads()
+	actual := models.(*modelService)
+	actual.downloads.mu.Lock()
+	started := actual.downloads.recoveryReady
+	actual.downloads.mu.Unlock()
+	select {
+	case <-started:
+	case <-ctx.Done():
+		t.Fatal("real startup recovery exceeded parent window")
+	}
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		s, e := originalCrashSnapshotInDB(ctx, db, m.ModelID)
+		require.NoError(t, e)
+		if mode == "first" && originalCrashValidReady(s) == nil {
+			require.NoError(t, originalCrashEmit("first_ready_observation", m.Nonce, filepath.Join(m.RunDir, "first.ready.private.json"), s))
+			<-ctx.Done()
+			t.Fatal("first child was not SIGKILLed before fixed parent deadline")
+		}
+		if mode == "recover" && s.ResultID != "" {
+			require.NoError(t, life.WaitOriginalDownload(ctx, m.ModelID))
+			_, p, done, e := repo.(interfaces.ModelOriginalDownloadDispatcher).ClaimModelOriginalDownload(ctx, m.ModelID)
+			require.NoError(t, e)
+			require.True(t, done)
+			require.Nil(t, p)
+			require.NoError(t, cleanup.StopOriginalDownloadsWithErrors())
+			s, e = originalCrashSnapshotInDB(ctx, db, m.ModelID)
+			require.NoError(t, e)
+			require.NoError(t, originalCrashEmit("recovery_receipt_observation", m.Nonce, filepath.Join(m.RunDir, "recovered.private.json"), s))
+			return
+		}
+		select {
+		case <-ctx.Done():
+			if mode == "recover" {
+				_ = cleanup.StopOriginalDownloadsWithErrors()
+			}
+			t.Fatal("child recovery exceeded original parent window")
+		case <-ticker.C:
+		}
+	}
+}
+
+type originalCrashProcess struct {
+	cmd  *exec.Cmd
+	done chan struct{}
+	mu   sync.Mutex
+	err  error
+	log  *os.File
+}
+
+func originalCrashStartProcess(ctx context.Context, m originalCrashManifest, manifestPath, mode string) (*originalCrashProcess, error) {
+	executable, e := os.Executable()
+	if e != nil {
+		return nil, e
+	}
+	log, e := os.OpenFile(filepath.Join(m.RunDir, mode+".child.private.log"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if e != nil {
+		return nil, e
+	}
+	cmd := exec.CommandContext(ctx, executable, "-test.run=^TestOriginalLocalDownloadCrashChild$", "-test.count=1", "-test.timeout=1200s", "-test.v")
+	environment := []string{}
+	for _, entry := range os.Environ() {
+		if !strings.HasPrefix(entry, originalCrashModeEnv+"=") && !strings.HasPrefix(entry, originalCrashManifestEnv+"=") {
+			environment = append(environment, entry)
+		}
+	}
+	cmd.Env = append(environment, originalCrashModeEnv+"="+mode, originalCrashManifestEnv+"="+manifestPath)
+	cmd.Stdout = log
+	cmd.Stderr = log
+	p := &originalCrashProcess{cmd: cmd, done: make(chan struct{}), log: log}
+	if e = cmd.Start(); e != nil {
+		_ = log.Close()
+		return nil, e
+	}
+	go func() {
+		e := cmd.Wait()
+		p.mu.Lock()
+		p.err = e
+		p.mu.Unlock()
+		_ = log.Close()
+		close(p.done)
+	}()
+	return p, nil
+}
+func (p *originalCrashProcess) wait(ctx context.Context) error {
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-p.done:
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		return p.err
+	}
+}
+func (p *originalCrashProcess) joinCleanup(ctx context.Context) error {
+	select {
+	case <-p.done:
+		return nil
+	default:
+	}
+	if e := p.cmd.Process.Signal(syscall.SIGKILL); e != nil && !errors.Is(e, os.ErrProcessDone) {
+		return e
+	}
+	select {
+	case <-p.done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+func originalCrashWaitFile(ctx context.Context, path string, v interface{}) error {
+	tick := time.NewTicker(200 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		e := originalCrashReadJSON(path, v)
+		if e == nil {
+			return nil
+		}
+		if !errors.Is(e, os.ErrNotExist) {
+			return e
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-tick.C:
+		}
+	}
+}
+func originalCrashAuditChild(m originalCrashManifest, p *originalCrashProcess, owner originalCrashRuntimeIdentity) error {
+	if p.cmd.Process.Pid <= 0 || owner.Nonce != m.Nonce || owner.BinarySHA != m.BinarySHA || owner.SourceHead != m.SourceHead || owner.ParentPID != os.Getpid() || owner.ContainerID == "" || owner.ImageID == "" || len(owner.Entrypoint)+len(owner.Command) == 0 || len(owner.Mounts) == 0 || owner.EnvironmentSHA == "" {
+		return fmt.Errorf("exact owner runtime identity is incomplete")
+	}
+	executable, e := os.Executable()
+	if e != nil {
+		return e
+	}
+	sha, size, e := originalCrashFileSHA(executable)
+	if e != nil {
+		return e
+	}
+	if sha != m.BinarySHA || size != m.BinaryBytes {
+		return fmt.Errorf("owned binary changed")
+	}
+	// Linux owned-container run: actual target executable/argv/environment are
+	// checked before signal. The Root driver checks the outer image/mount identity.
+	target, e := os.Readlink(fmt.Sprintf("/proc/%d/exe", p.cmd.Process.Pid))
+	if e != nil {
+		return e
+	}
+	targetSHA, _, e := originalCrashFileSHA(target)
+	if e != nil {
+		return e
+	}
+	if targetSHA != m.BinarySHA {
+		return fmt.Errorf("child executable mismatch")
+	}
+	argv, e := os.ReadFile(fmt.Sprintf("/proc/%d/cmdline", p.cmd.Process.Pid))
+	if e != nil {
+		return e
+	}
+	if !strings.Contains(string(argv), "-test.run=^TestOriginalLocalDownloadCrashChild$") {
+		return fmt.Errorf("child command mismatch")
+	}
+	env, e := os.ReadFile(fmt.Sprintf("/proc/%d/environ", p.cmd.Process.Pid))
+	if e != nil {
+		return e
+	}
+	if !strings.Contains(string(env), originalCrashManifestEnv+"="+filepath.Join(m.RunDir, "manifest.private.json")) {
+		return fmt.Errorf("child manifest identity mismatch")
+	}
+	private := map[string]interface{}{"nonce": m.Nonce, "parent_pid": os.Getpid(), "child_pid": p.cmd.Process.Pid, "binary_sha256": targetSHA, "binary_bytes": m.BinaryBytes, "argv_sha256": originalCrashSHA(argv), "environment_sha256": originalCrashSHA(env), "container_id": owner.ContainerID, "image_id": owner.ImageID, "runtime_identity": owner}
+	return originalCrashWriteJSON(filepath.Join(m.RunDir, "before-kill.identity.private.json"), private)
+}
