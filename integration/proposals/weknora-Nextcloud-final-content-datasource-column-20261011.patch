@@ -0,0 +1,30 @@
+package repository
+
+import (
+	"sync"
+	"testing"
+
+	"gorm.io/gorm/schema"
+)
+
+// Parse the actual final-union scan type with the real pinned GORM naming
+// strategy; this is a pure mapping oracle, not a content-lease grant.
+func TestNextcloudOriginalFinalRowUsesExactSQLColumns(t *testing.T) {
+	parsed, err := schema.Parse(&nextcloudOriginalFinalRow{}, &sync.Map{}, schema.NamingStrategy{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected := map[string]string{"DataSourceID": "datasource_id", "BodyID": "lease_body_id", "KBEpoch": "kb_epoch", "KBState": "kb_state", "FenceEpoch": "fence_epoch", "FenceState": "fence_state", "KnowledgeBaseID": "knowledge_base_id", "FinalClockMS": "final_clock_ms"}
+	for field, column := range expected {
+		actual := parsed.FieldsByName[field]
+		if actual == nil || actual.DBName != column {
+			t.Fatalf("actual final-union field %s must bind SQL column %s", field, column)
+		}
+	}
+	if actual := parsed.FieldsByDBName["datasource_id"]; actual == nil || actual.Name != "DataSourceID" {
+		t.Fatal("content datasource_id SQL alias has no actual scan field")
+	}
+	if actual := parsed.FieldsByDBName["body_id"]; actual == nil || actual.Name != "ID" || len(actual.BindNames) != 2 || actual.BindNames[0] != "Body" {
+		t.Fatal("payload body_id must remain separate from actual lease_body_id")
+	}
+}
