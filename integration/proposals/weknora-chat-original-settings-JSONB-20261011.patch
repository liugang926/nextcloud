+func TestOriginalChatSettingsStableJSON(t *testing.T) {
+	canonical := func(raw string) (json.RawMessage, error) {
+		return ModelOriginalChatSettingsBytes(&ModelOriginalChatDefinition{Version: 1, Recipe: "chat/openai-completions/full-v1", Settings: json.RawMessage(raw)})
+	}
+	first, err := canonical(`{"z":[1,"literal",true],"large":9007199254740993,"decimal":1.2500,"exp":1e2,"a":{"b":false,"a":null}}`)
+	require.NoError(t, err)
+	second, err := canonical(` { "a":{"a":null,"b":false}, "exp":100.00,"decimal":1.25,"large":9007199254740993,"z":[1.0,"literal",true] } `)
+	require.NoError(t, err)
+	require.Equal(t, string(first), string(second))
+	for _, changed := range []string{`{"z":["literal",1,true],"large":9007199254740993,"decimal":1.25,"exp":100,"a":{"b":false,"a":null}}`, `{"z":[1,"literal",true],"large":9007199254740992,"decimal":1.25,"exp":100,"a":{"b":false,"a":null}}`, `{"z":[1,"different",true],"large":9007199254740993,"decimal":1.25,"exp":100,"a":{"b":false,"a":null}}`} {
+		value, err := canonical(changed)
+		require.NoError(t, err)
+		require.NotEqual(t, string(first), string(value))
+	}
+	for _, invalid := range []string{`{"a":1,"a":2}`, `{"a":{"b":true,"b":false}}`, `{} {}`, `[]`, `{"text":"\ud800"}`, `{"text":"\udc00"}`, `{"number":1e2147483647}`} {
+		_, err := canonical(invalid)
+		require.Error(t, err)
+	}
+	_, err = ModelOriginalChatSettingsBytes(&ModelOriginalChatDefinition{Version: 1, Recipe: "unknown", Settings: json.RawMessage(`{}`)})
+	require.Error(t, err)
+}
+
+// A serialization comparison oracle is not a seeded SQL origin or grant. The
+// repository additionally retains the real raw digest/body/receipt checks.
+func TestOriginalChatSettingsLegacyDefinitionProjection(t *testing.T) {
+	params := ModelParameters{OriginalChat: &ModelOriginalChatDefinition{Version: 1, Recipe: "chat/openai-completions/full-v1", Settings: json.RawMessage(`{"z":[1,2],"a":9007199254740993}`)}, BaseURL: "https://explicit.invalid", Provider: "openai"}
+	model := &Model{ID: "authored-model", TenantID: 7, Name: "authored name", Type: ModelTypeKnowledgeQA, Source: ModelSourceRemote, Parameters: params}
+	legacy, err := json.Marshal(ModelOriginalDefinition{model.ID, model.TenantID, model.Name, model.DisplayName, model.Description, model.Type, model.Source, model.IsBuiltin, params})
+	require.NoError(t, err)
+	retained := append([]byte(nil), legacy...)
+	current := *model
+	recipe := *params.OriginalChat
+	recipe.Settings = json.RawMessage(`{"a":9007199254740993,"z":[1.0,2.0]}`)
+	current.Parameters.OriginalChat = &recipe
+	match, err := ModelDefinitionMatchesOriginal(&current, string(legacy))
+	require.NoError(t, err)
+	require.True(t, match)
+	require.True(t, bytes.Equal(retained, legacy))
+	require.NoError(t, RestoreModelOriginalChatSettings(&current, string(legacy)))
+	require.Equal(t, string(params.OriginalChat.Settings), string(current.Parameters.OriginalChat.Settings))
+	require.True(t, bytes.Equal(retained, legacy))
+	current.Name = "different name"
+	match, err = ModelDefinitionMatchesOriginal(&current, string(legacy))
+	require.NoError(t, err)
+	require.False(t, match)
+	current.Name = model.Name
+	recipe.Settings = json.RawMessage(`{"a":9007199254740992,"z":[1,2]}`)
+	current.Parameters.OriginalChat = &recipe
+	match, err = ModelDefinitionMatchesOriginal(&current, string(legacy))
+	require.NoError(t, err)
+	require.False(t, match)
+	_, err = ModelDefinitionMatchesOriginal(model, string(legacy[:len(legacy)-1])+`,"Unknown":1}`)
+	require.Error(t, err)
+}
