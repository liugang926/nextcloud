diff --git a/internal/types/model_original_settings.go b/internal/types/model_original_settings.go
new file mode 100644
index 00000000..68455d0d
--- /dev/null
+++ b/internal/types/model_original_settings.go
@@ -0,0 +1,272 @@
+package types
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// Only the four established chat Settings objects have representation freedom.
+// Strings and arrays retain values/order; exact decimal numbers never pass
+// through float64. Duplicate keys/trailing values/non-object roots are closed.
+// Existing SDK completeSettings field/schema/type validation is still required.
+func ModelOriginalChatSettingsBytes(recipe *ModelOriginalChatDefinition) (json.RawMessage, error) {
+	if recipe == nil || recipe.Version != 1 {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	switch recipe.Recipe {
+	case "chat/openai-completions/full-v1", "chat/openai-responses/full-v1", "chat/anthropic-messages/full-v1", "chat/google-generative-ai/full-v1":
+	default:
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	if !validModelSettingsStrings(recipe.Settings) {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	d := json.NewDecoder(bytes.NewReader(recipe.Settings))
+	d.UseNumber()
+	numberBudget := 1 << 20 // Bound total decimal expansion; no precision rounding.
+	value, err := readModelSettingsJSON(d, 0, &numberBudget)
+	if err != nil {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	if _, ok := value.(map[string]interface{}); !ok {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	data, err := json.Marshal(value)
+	if err != nil {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	return data, nil
+}
+func validModelSettingsStrings(raw []byte) bool {
+	if !utf8.Valid(raw) {
+		return false
+	}
+	inside := false
+	for i := 0; i < len(raw); i++ {
+		if raw[i] == '"' {
+			inside = !inside
+			continue
+		}
+		if !inside || raw[i] != '\\' {
+			continue
+		}
+		i++
+		if i >= len(raw) {
+			return false
+		}
+		if raw[i] != 'u' {
+			continue
+		}
+		if i+4 >= len(raw) {
+			return false
+		}
+		code, err := strconv.ParseUint(string(raw[i+1:i+5]), 16, 16)
+		if err != nil {
+			return false
+		}
+		i += 4
+		if code >= 0xDC00 && code <= 0xDFFF {
+			return false
+		}
+		if code >= 0xD800 && code <= 0xDBFF {
+			if i+6 >= len(raw) || raw[i+1] != '\\' || raw[i+2] != 'u' {
+				return false
+			}
+			low, err := strconv.ParseUint(string(raw[i+3:i+7]), 16, 16)
+			if err != nil || low < 0xDC00 || low > 0xDFFF {
+				return false
+			}
+			i += 6
+		}
+	}
+	return true
+}
+func readModelSettingsJSON(d *json.Decoder, depth int, numberBudget *int) (interface{}, error) {
+	if depth > 10000 {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	token, err := d.Token()
+	if err != nil {
+		return nil, err
+	}
+	switch value := token.(type) {
+	case json.Delim:
+		switch value {
+		case '{':
+			object := map[string]interface{}{}
+			for d.More() {
+				keyToken, err := d.Token()
+				if err != nil {
+					return nil, err
+				}
+				key, ok := keyToken.(string)
+				if !ok {
+					return nil, ErrMemoryOriginalUnavailable
+				}
+				if _, exists := object[key]; exists {
+					return nil, ErrMemoryOriginalUnavailable
+				}
+				child, err := readModelSettingsJSON(d, depth+1, numberBudget)
+				if err != nil {
+					return nil, err
+				}
+				object[key] = child
+			}
+			end, err := d.Token()
+			if err != nil || end != json.Delim('}') {
+				return nil, ErrMemoryOriginalUnavailable
+			}
+			return object, nil
+		case '[':
+			array := []interface{}{}
+			for d.More() {
+				child, err := readModelSettingsJSON(d, depth+1, numberBudget)
+				if err != nil {
+					return nil, err
+				}
+				array = append(array, child)
+			}
+			end, err := d.Token()
+			if err != nil || end != json.Delim(']') {
+				return nil, ErrMemoryOriginalUnavailable
+			}
+			return array, nil
+		}
+	case json.Number:
+		canonical, err := modelSettingsDecimal(value.String(), numberBudget)
+		if err != nil {
+			return nil, err
+		}
+		return json.Number(canonical), nil
+	case string, bool, nil:
+		return value, nil
+	}
+	return nil, ErrMemoryOriginalUnavailable
+}
+func modelSettingsDecimal(value string, budget *int) (string, error) {
+	sign := ""
+	if strings.HasPrefix(value, "-") {
+		sign = "-"
+		value = value[1:]
+	}
+	exponent := int64(0)
+	if at := strings.IndexAny(value, "eE"); at >= 0 {
+		parsed, err := strconv.ParseInt(value[at+1:], 10, 32)
+		if err != nil {
+			return "", ErrMemoryOriginalUnavailable
+		}
+		exponent = parsed
+		value = value[:at]
+	}
+	fraction := 0
+	if at := strings.IndexByte(value, '.'); at >= 0 {
+		fraction = len(value) - at - 1
+		value = value[:at] + value[at+1:]
+	}
+	value = strings.TrimLeft(value, "0")
+	if value == "" {
+		if *budget < 1 {
+			return "", ErrMemoryOriginalUnavailable
+		}
+		*budget--
+		return "0", nil
+	}
+	trailing := len(value) - len(strings.TrimRight(value, "0"))
+	value = strings.TrimRight(value, "0")
+	scale := exponent - int64(fraction) + int64(trailing)
+	// Bound expansion, never round/coerce. This covers PostgreSQL JSONB's
+	// numeric range; unsupported enormous exponents fail without huge allocation.
+	if scale > 131072 || scale < -131072 {
+		return "", ErrMemoryOriginalUnavailable
+	}
+	point := int64(len(value)) + scale
+	size := int64(len(sign) + len(value))
+	if scale >= 0 {
+		size += scale
+	} else if point > 0 {
+		size++
+	} else {
+		size += 2 - point
+	}
+	if size > int64(*budget) {
+		return "", ErrMemoryOriginalUnavailable
+	}
+	*budget -= int(size)
+	if scale >= 0 {
+		return sign + value + strings.Repeat("0", int(scale)), nil
+	}
+	if point > 0 {
+		return sign + value[:int(point)] + "." + value[int(point):], nil
+	}
+	return sign + "0." + strings.Repeat("0", int(-point)) + value, nil
+}
+
+// Re-marshalling WITHOUT Settings normalization must reproduce all stored
+// bytes exactly. No other field/representation is granted equivalence. Old
+// genuine encodings and hashes stay untouched; unknown fields remain closed.
+func decodeModelDefinitionOriginal(raw string) (*ModelOriginalDefinition, error) {
+	if !utf8.ValidString(raw) {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	d := json.NewDecoder(strings.NewReader(raw))
+	d.UseNumber()
+	d.DisallowUnknownFields()
+	var definition ModelOriginalDefinition
+	if d.Decode(&definition) != nil {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	legacy, err := json.Marshal(definition)
+	if err != nil || string(legacy) != raw {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	return &definition, nil
+}
+
+// No proof/digest is generated here. Callers still verify raw fact digest,
+// SHA256(raw DefinitionJSON), exact body head/receipt and current controls.
+func ModelDefinitionMatchesOriginal(model *Model, raw string) (bool, error) {
+	definition, err := decodeModelDefinitionOriginal(raw)
+	if err != nil {
+		return false, err
+	}
+	original := &Model{ID: definition.ID, TenantID: definition.TenantID, Name: definition.Name, DisplayName: definition.DisplayName, Description: definition.Description, Type: definition.Type, Source: definition.Source, IsBuiltin: definition.IsBuiltin, Parameters: definition.Parameters}
+	originalBytes, err := ModelDefinitionBytes(original)
+	if err != nil {
+		return false, err
+	}
+	currentBytes, err := ModelDefinitionBytes(model)
+	if err != nil {
+		return false, err
+	}
+	return bytes.Equal(originalBytes, currentBytes), nil
+}
+
+// After raw fact/body verification, restore only exact original Settings to
+// the current proved snapshot. No historical credential is hydrated, no
+// provider constructed and no current state/authority changed by this helper.
+func RestoreModelOriginalChatSettings(model *Model, raw string) error {
+	definition, err := decodeModelDefinitionOriginal(raw)
+	if err != nil {
+		return err
+	}
+	if definition.Parameters.OriginalChat == nil {
+		return nil
+	}
+	if model == nil || model.Parameters.OriginalChat == nil {
+		return ErrMemoryOriginalUnavailable
+	}
+	recipe := *model.Parameters.OriginalChat
+	recipe.Settings = append(json.RawMessage(nil), definition.Parameters.OriginalChat.Settings...)
+	model.Parameters.OriginalChat = &recipe
+	return nil
+}
