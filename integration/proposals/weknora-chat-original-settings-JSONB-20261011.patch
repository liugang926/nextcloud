--- /dev/null
+++ b/internal/application/service/model_original_legacy_sdk_settings_test.go
@@ -0,0 +1,58 @@
+package service
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/models/catalog"
+	modelchat "github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+// Serialization contract only: these bytes are not SQL origins/receipts,
+// proofs or read grants. Actual old-producer -> new-reader SQL remains a gate.
+func TestModelOriginalLegacySDKSettingsProjection(t *testing.T) {
+	for _, mode := range []string{"SDK_struct_order_HTML", "legal_surrogate", "different_number"} {
+		t.Run(mode, func(t *testing.T) {
+			model := actualModelLiteral("legacy-sdk-serialization", 7)
+			model.Name = "original <authored> name"
+			require.NoError(t, modelchat.NormalizeAuthoredChatDefinition(model))
+			settings := catalog.DefaultOpenAICompletions()
+			settings.ExtraBody = map[string]interface{}{"literal": "<safe>🚀</safe>", "precision": json.Number("9007199254740993"), "ordered": []interface{}{"first", "second"}}
+			ordered, err := json.Marshal(settings)
+			require.NoError(t, err)
+			if mode == "legal_surrogate" {
+				ordered = []byte(strings.ReplaceAll(string(ordered), "🚀", `\ud83d\ude80`))
+			}
+			model.Parameters.OriginalChat.Settings = ordered
+			require.NoError(t, modelchat.ValidateOriginalChatDefinition(model.Parameters.OriginalChat), "real SDK fullSettings schema stays required")
+			params := model.Parameters
+			params.APIKey = ""
+			params.AppSecret = ""
+			legacy, err := json.Marshal(types.ModelOriginalDefinition{model.ID, model.TenantID, model.Name, model.DisplayName, model.Description, model.Type, model.Source, model.IsBuiltin, params})
+			require.NoError(t, err)
+			require.Contains(t, string(legacy), `\u003c`)
+			before := append([]byte(nil), legacy...)
+			var currentSettings map[string]json.RawMessage
+			require.NoError(t, json.Unmarshal(ordered, &currentSettings))
+			if mode == "different_number" {
+				var extra map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(currentSettings["ExtraBody"], &extra))
+				extra["precision"] = json.RawMessage("9007199254740992")
+				currentSettings["ExtraBody"], err = json.Marshal(extra)
+				require.NoError(t, err)
+			}
+			recipe := *model.Parameters.OriginalChat
+			recipe.Settings, err = json.Marshal(currentSettings)
+			require.NoError(t, err)
+			current := *model
+			current.Parameters.OriginalChat = &recipe
+			match, err := types.ModelDefinitionMatchesOriginal(&current, string(legacy))
+			require.NoError(t, err)
+			require.Equal(t, mode != "different_number", match)
+			require.Equal(t, before, legacy, "legacy raw bytes/digest input not rewritten")
+		})
+	}
+}
