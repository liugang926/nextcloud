@@ -0,0 +1,112 @@
+package service
+
+import (
+	"encoding/json"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPostgresJointOriginalChatSettingsJSONBActual(t *testing.T) {
+	for _, mode := range []string{"current", "same_representation", "changed_settings"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newJointOriginalUpgradeFixture(t, true)
+			repo := repository.NewModelRepository(f.db)
+			ConfigureModelOriginalAuthority(repo, f.store, NewGroupAccessService(repository.NewGroupAccessRepository(f.db)), nil)
+			models := NewModelService(repo, nil, nil, nil, nil, nil)
+			model := actualModelLiteral(uuid.NewString(), 7)
+			require.NoError(t, models.CreateModel(f.ctx, model))
+			require.NotNil(t, model.OriginalProof)
+			require.True(t, model.OriginalProof.Valid())
+			proof := *model.OriginalProof
+			var origin types.ModelDefinitionOriginal
+			require.NoError(t, f.db.Where("id=?", proof.DefinitionID).Take(&origin).Error)
+			require.Equal(t, types.MemoryOriginalBytesDigest([]byte(origin.DefinitionJSON)), origin.DefinitionDigest)
+			reader := models.(interfaces.ModelOriginalLifetimeReader)
+			read, err := reader.BeginModelOriginalRead(f.ctx, model.ID, &proof)
+			require.NoError(t, err)
+			t.Cleanup(func() {
+				if err := read.Close(); err != nil {
+					t.Error("owned current model hold cleanup failed")
+				}
+			})
+			before, _, err := read.Snapshot()
+			require.NoError(t, err)
+			require.NotNil(t, before.Parameters.OriginalChat)
+			if mode != "current" {
+				var row struct{ Parameters string }
+				require.NoError(t, f.db.Table("models").Select("CAST(parameters AS TEXT) AS parameters").Where("id=?", model.ID).Take(&row).Error)
+				var params map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal([]byte(row.Parameters), &params))
+				var chat map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(params["original_chat"], &chat))
+				var settings map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(chat["Settings"], &settings))
+				if mode == "changed_settings" {
+					var enabled bool
+					require.NoError(t, json.Unmarshal(settings["SupportsTemperature"], &enabled))
+					settings["SupportsTemperature"], err = json.Marshal(!enabled)
+					require.NoError(t, err)
+				}
+				keys := []string{}
+				for key := range settings {
+					keys = append(keys, key)
+				}
+				sort.Sort(sort.Reverse(sort.StringSlice(keys)))
+				parts := []string{}
+				for _, key := range keys {
+					quoted, err := json.Marshal(key)
+					require.NoError(t, err)
+					parts = append(parts, string(quoted)+" : "+string(settings[key]))
+				}
+				chat["Settings"] = json.RawMessage("{ " + strings.Join(parts, ", ") + " }")
+				params["original_chat"], err = json.Marshal(chat)
+				require.NoError(t, err)
+				wire, err := json.Marshal(params)
+				require.NoError(t, err)
+				write := f.db.Exec("UPDATE models SET parameters=CAST(? AS JSONB) WHERE id=?", string(wire), model.ID)
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+				var after struct{ Parameters string }
+				require.NoError(t, f.db.Table("models").Select("CAST(parameters AS TEXT) AS parameters").Where("id=?", model.ID).Take(&after).Error)
+				var readParams types.ModelParameters
+				require.NoError(t, json.Unmarshal([]byte(after.Parameters), &readParams))
+				var actualSettings map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(readParams.OriginalChat.Settings, &actualSettings))
+				var actual bool
+				require.NoError(t, json.Unmarshal(actualSettings["SupportsTemperature"], &actual))
+				var expected bool
+				require.NoError(t, json.Unmarshal(settings["SupportsTemperature"], &expected))
+				require.Equal(t, expected, actual)
+			}
+			if mode == "changed_settings" {
+				require.Error(t, read.Recheck())
+				snapshot, bound, err := read.Snapshot()
+				require.Error(t, err)
+				require.Nil(t, snapshot)
+				require.Nil(t, bound)
+			} else {
+				require.NoError(t, read.Recheck())
+				after, bound, err := read.Snapshot()
+				require.NoError(t, err)
+				require.Equal(t, proof, *bound)
+				require.Equal(t, string(before.Parameters.OriginalChat.Settings), string(after.Parameters.OriginalChat.Settings))
+				historical, err := repo.(interfaces.HistoricalModelOriginalReader).BeginHistoricalModelOriginalRead(f.ctx, proof)
+				require.NoError(t, err)
+				require.NoError(t, historical.Recheck())
+				require.NoError(t, historical.Close())
+			}
+			var retained types.ModelDefinitionOriginal
+			require.NoError(t, f.db.Where("id=?", proof.DefinitionID).Take(&retained).Error)
+			require.Equal(t, origin, retained, "raw origin bytes/digest/ID were not rewritten or resigned")
+			require.NoError(t, read.Close())
+			jointOriginalLeaseState(t, f, false)
+		})
+	}
+}
