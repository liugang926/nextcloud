+	var answers atomic.Int64
+	var mu sync.Mutex
+	var observedErr error
+	report := func(err error) { mu.Lock(); observedErr = errors.Join(observedErr, err); mu.Unlock() }
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		answers.Add(1)
+		var wire struct {
+			Stream   bool
+			Messages []struct{ Role, Content string }
+		}
+		if json.NewDecoder(r.Body).Decode(&wire) != nil || r.URL.Path != "/chat/completions" || !wire.Stream || r.Header.Get("Authorization") != "Bearer owned-ancestor-embedding" {
+			report(errors.New("actual normal answer SSE request mismatch"))
+			w.WriteHeader(400)
+			return
+		}
+		text := ""
+		for _, m := range wire.Messages {
+			text += m.Content
+		}
+		if !strings.Contains(text, personalQueryText) || !strings.Contains(text, "Original configuration influence") {
+			report(errors.New("actual normal answer lost leased human/source input"))
+			w.WriteHeader(400)
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		chunk := map[string]any{"id": "owned-normal-event-answer", "object": "chat.completion.chunk", "choices": []any{map[string]any{"index": 0, "delta": map[string]any{"role": "assistant", "content": normalOriginalEventAnswer}, "finish_reason": nil}}}
+		data, e := json.Marshal(chunk)
+		if e != nil {
+			report(e)
+			return
+		}
+		if _, e = fmt.Fprintf(w, "data: %s\n\n", data); e != nil {
+			report(e)
+			return
+		}
+		if flush, ok := w.(http.Flusher); ok {
+			flush.Flush()
+		}
+		if _, e = fmt.Fprint(w, "data: {\"id\":\"owned-normal-event-answer\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"); e != nil {
+			report(e)
+		}
+	}))
+	t.Cleanup(provider.Close)
+	// A new current answer definition is authored through the normal original
+	// model writer. KB SummaryModelID stays exactly the genuinely authored ID;
+	// no original A/vector model Space or receipt is resigned or replaced.
