+// This checks the real still-owned native consumer after the rejected model
+// selector. A pre-native guard failure cannot satisfy the unrelated-model case.
+func assertNormalScopedNativeConsumerForTest(t *testing.T, ctx context.Context, f *ScopedKnowledgePurposeFixtureForTest) {
+	t.Helper()
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	require.True(t, ok)
+	require.NotNil(t, slot)
+	queries := []*repository.KnowledgeQueryEmbeddingResultRead{}
+	vectors := []*repository.KnowledgeSQLiteEmbeddingVectorRead{}
+	slot.mu.Lock()
+	for _, resource := range slot.Models {
+		switch actual := resource.(type) {
+		case *knowledgeQueryBoundaryResource:
+			if actual != nil && actual.read != nil && actual.retained.Load() {
+				queries = append(queries, actual.read)
+			}
+		case *knowledgeEmbeddingBoundaryResource:
+			if actual != nil && actual.read != nil && actual.query != nil {
+				vectors = append(vectors, actual.read)
+			}
+		}
+	}
+	slot.mu.Unlock()
+	require.Len(t, queries, 1)
+	require.Len(t, vectors, 1)
+	require.NoError(t, normalEventOriginalContextCheck(queries[0].Context(), ctx, f.KB, f.Embedding.ID))
+	snapshot, err := queries[0].Snapshot()
+	require.NoError(t, err)
+	require.NotNil(t, snapshot)
+	require.Equal(t, f.KB, snapshot.KnowledgeBaseID)
+	require.Equal(t, f.Embedding.ID, snapshot.ModelID)
+	_, actual, err := repository.WithActualKnowledgeCompletionReads(queries[0].Context(), queries, vectors)
+	require.NoError(t, err)
+	require.Len(t, actual, 1)
+	require.Equal(t, snapshot.ReceiptID, actual[0].QueryReceiptID)
+	require.NotEmpty(t, actual[0].Candidates)
+	require.NotEmpty(t, actual[0].Hits)
+	require.NoError(t, actual[0].SourceLineage.RequireComplete())
+	require.Len(t, actual[0].SourceLineage.Sources, 1)
+	require.Equal(t, f.Knowledge, actual[0].SourceLineage.Sources[0].KnowledgeID)
+	require.NoError(t, vectors[0].Recheck())
+}
