+	guard, ok := f.messages.sourceLineageGuard.(*access.NextcloudSourceLineageGuard)
+	require.True(t, ok)
+	require.NotNil(t, guard)
+	kbs := &knowledgeBaseService{repo: repository.NewKnowledgeBaseRepository(f.DB), kgRepo: knowRepo, chunkRepo: chunkRepo, modelService: f.Models, retrieveEngine: registry, tenantRepo: repository.NewTenantRepository(f.DB), contentLeases: f.Store.ContentLeaseStore(), ragChunkSnapshots: repository.NewRAGChunkSnapshotReader(f.DB, f.Store), ragChunkLineageGuard: guard, groupAccess: f.Groups, publicationGuard: publication}
+	ConfigureKnowledgeBaseRAGChunkHydration(kbs, repository.NewRAGChunkSnapshotReader(f.DB, f.Store), guard)
