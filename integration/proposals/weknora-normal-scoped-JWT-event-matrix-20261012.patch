+	cfg := &config.Config{Conversation: &config.ConversationConfig{MaxRounds: 0, EmbeddingTopK: 1, RerankTopK: 1, EnableRewrite: false, EnableQueryExpansion: false, FallbackStrategy: "fixed", FallbackResponse: "CURRENT FIXED SAFE FALLBACK", Summary: &config.SummaryConfig{Prompt: "Answer using the admitted original source", ContextTemplate: "{{query}}\n{{contexts}}"}}}
