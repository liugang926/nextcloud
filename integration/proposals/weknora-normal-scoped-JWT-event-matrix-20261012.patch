+	answer.Parameters.BaseURL = provider.URL
+	answer.Parameters.OriginalChat = nil
+	require.NoError(t, f.Models.UpdateModel(f.Creator, &answer))
+	require.NotNil(t, answer.OriginalProof)
+	require.Equal(t, f.Answer.ID, answer.ID)
+	var kb types.KnowledgeBase
+	require.NoError(t, f.DB.Where("id=? AND tenant_id=?", f.KB, 7).Take(&kb).Error)
+	require.Equal(t, answer.ID, kb.SummaryModelID)
+	require.False(t, kb.IndexingStrategy.GraphRequired)
+	require.False(t, kb.IndexingStrategy.GraphEnabled)
+	require.True(t, kb.IndexingStrategy.VectorEnabled)
