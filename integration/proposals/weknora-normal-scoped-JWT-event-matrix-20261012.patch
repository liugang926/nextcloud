+	session := &types.Session{ID: uuid.NewString(), TenantID: 7, UserID: caller.UserID}
+	_, err = sessions.sessionRepo.Create(owner, session)
+	require.NoError(t, err)
+	user, err := messages.CreateMessage(owner, &types.Message{SessionID: session.ID, RequestID: uuid.NewString(), Role: "user", Content: personalQueryText, IsCompleted: true})
+	require.NoError(t, err)
+	assistant, err := messages.CreateMessage(owner, &types.Message{SessionID: session.ID, RequestID: user.RequestID, Role: "assistant"})
+	require.NoError(t, err)
+	deadline, cancelDeadline := context.WithTimeout(owner, 8*time.Second)
+	httpctx, attach, check, releaseHTTP := BeginMessageMaterialHTTPBoundary(deadline)
+	call, cancelCall := context.WithCancel(attach(httpctx))
+	releaseProducer := RetainMessageMaterialHTTPProducer(call)
+	observedModels.expected = call
+	var started, saveAttempted, faultApplied atomic.Bool
+	producerDone := make(chan struct{})
+	result := make(chan error, 1)
+	saved := make(chan error, 1)
+	t.Cleanup(func() {
+		cancelCall()
+		cancelDeadline()
+		if started.Load() {
+			select {
+			case <-producerDone:
+			case <-time.After(3 * time.Second):
+				t.Error("actual scoped normal producer did not join within cleanup bound")
+			}
+		}
+		f.SetQueryHook(nil)
+		releaseProducer()
+		releaseHTTP()
