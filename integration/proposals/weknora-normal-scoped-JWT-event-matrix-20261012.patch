+			require.NoError(t, f.DB.Model(&types.NextcloudSourceGrant{}).Where("knowledge_base_id=? AND object_guid=? AND publication_epoch=?", f.SecondGrantedKB, guid, 1).Count(&b).Error)
+			require.EqualValues(t, 1, b)
