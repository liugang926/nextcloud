+// RunNormalScopedOriginalEventForTest is a test-only bridge. The external test
+// supplies the real middleware-authenticated context; this runner does not mint
+// a Caller, Principal, model purpose, lease or consumer capability.
+func RunNormalScopedOriginalEventForTest(t *testing.T, f *ScopedKnowledgePurposeFixtureForTest, authenticated context.Context, guid, mode string) {
+	t.Helper()
+	baseline := f.SDKCalls()
