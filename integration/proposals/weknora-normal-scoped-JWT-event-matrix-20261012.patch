+	native := retriever.NewKVHybridRetrieveEngine(f.index, types.SQLiteRetrieverEngineType)
+	require.NoError(t, registry.Register(native))
+	knowRepo := repository.NewKnowledgeRepository(f.DB)
+	repository.ConfigureKnowledgeCurrentReadActor(knowRepo, f.Store)
+	chunkRepo := repository.NewChunkRepository(f.DB)
