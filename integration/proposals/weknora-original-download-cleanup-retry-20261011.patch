+		return types.ErrMemoryOriginalUnavailable
+	}
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-job.done:
+	}
+	job.mu.Lock()
+	owner, cleanupErr := job.releaseOwner, job.cleanupErr
+	job.mu.Unlock()
+	if cleanupErr == nil {
+		return nil
+	}
+	if owner == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	err := owner.RetryOriginalRelease(ctx)
+	job.mu.Lock()
+	job.cleanupErr = err
+	if err == nil {
+		job.releaseOwner = nil
+	}
+	job.mu.Unlock()
