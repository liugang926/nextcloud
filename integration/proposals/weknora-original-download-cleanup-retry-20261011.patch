@@ -0,0 +1,203 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"github.com/Tencent/WeKnora/internal/shutdown"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/Tencent/WeKnora/internal/utils"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func runOriginalDownloadReleaseRetryActual(t *testing.T, pg bool) {
+	for _, mode := range []string{"normal_close", "close_failure", "operation_and_close_failure", "cleaner_reports_failure"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, models, _, _ := actualOriginalModelServices(t, f)
+			life, ok := models.(interfaces.ModelOriginalDownloadLifecycle)
+			require.True(t, ok)
+			cleanup, ok := models.(interfaces.ModelOriginalDownloadCleanupLifecycle)
+			require.True(t, ok)
+			actual, ok := models.(*modelService)
+			require.True(t, ok)
+			ctx, cancel := context.WithTimeout(f.ctx, 8*time.Second)
+			defer cancel()
+			started, released := make(chan struct{}), make(chan struct{})
+			var startOnce, releaseOnce sync.Once
+			var calls atomic.Int64
+			id := "actual-owned-release-retry"
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/api/pull" {
+					w.WriteHeader(400)
+					return
+				}
+				calls.Add(1)
+				_, _ = io.Copy(io.Discard, r.Body)
+				startOnce.Do(func() { close(started) })
+				select {
+				case <-released:
+				case <-r.Context().Done():
+					return
+				}
+				w.Header().Set("Content-Type", "application/x-ndjson")
+				if mode == "operation_and_close_failure" {
+					_, _ = io.WriteString(w, "{\"error\":\"owned operation refusal\"}\n")
+				} else {
+					_, _ = io.WriteString(w, "{\"status\":\"success\"}\n")
+				}
+			}))
+			triggerInstalled := false
+			var cleanupOwner interfaces.ModelOriginalReleaseRetry
+			dropFault := func() error {
+				if !triggerInstalled {
+					return nil
+				}
+				var err error
+				if pg {
+					err = f.db.Exec("DROP TRIGGER actual_owned_release_failure ON original_body_leases").Error
+					if err == nil {
+						err = f.db.Exec("DROP FUNCTION actual_owned_release_failure()").Error
+					}
+				} else {
+					err = f.db.Exec("DROP TRIGGER actual_owned_release_failure").Error
+				}
+				if err == nil {
+					triggerInstalled = false
+				}
+				return err
+			}
+			t.Cleanup(func() {
+				_ = dropFault()
+				releaseOnce.Do(func() { close(released) })
+				cancel()
+				life.StopOriginalDownloads()
+				if cleanupOwner != nil {
+					_ = cleanupOwner.RetryOriginalRelease(context.WithoutCancel(f.ctx))
+				}
+				server.Close()
+			})
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			life.StartOriginalDownloads()
+			model := &types.Model{ID: id, TenantID: 7, Name: "nomic-embed-text:actual-owned-release", Type: types.ModelTypeEmbedding, Source: types.ModelSourceLocal, Parameters: types.ModelParameters{BaseURL: server.URL, EmbeddingParameters: types.EmbeddingParameters{Dimension: 2}}}
+			require.NoError(t, models.CreateModel(ctx, model))
+			require.NotNil(t, model.OriginalProof)
+			select {
+			case <-started:
+			case <-ctx.Done():
+				t.Fatal("actual owned download did not reach HTTP")
+			}
+			clean := func() *gorm.DB { return f.db.Session(&gorm.Session{NewDB: true, Context: f.ctx}) }
+			var receipt types.ModelOriginalBodyReceipt
+			require.NoError(t, clean().Where("origin_id=?", model.OriginalProof.DefinitionID).Take(&receipt).Error)
+			var leases []struct {
+				LeaseID, BodyID, OwnerID, Kind string
+				Epoch, ExpiresAtMS             int64
+				ReleasedAtMS                   *int64
+			}
+			require.NoError(t, clean().Table("original_body_leases").Where("body_id=? AND owner_id LIKE ? AND kind=? AND released_at_ms IS NULL", receipt.BodyID, "model-original-read/%", "read").Find(&leases).Error)
+			require.Len(t, leases, 1)
+			bound := leases[0]
+			if mode != "normal_close" {
+				literal := "'" + strings.ReplaceAll(bound.LeaseID, "'", "''") + "'"
+				if pg {
+					require.NoError(t, f.db.Exec("CREATE FUNCTION actual_owned_release_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF OLD.lease_id="+literal+" AND NEW.released_at_ms IS NOT NULL THEN RAISE EXCEPTION 'actual owned original lease release refused'; END IF; RETURN NEW; END $$").Error)
+					require.NoError(t, f.db.Exec("CREATE TRIGGER actual_owned_release_failure BEFORE UPDATE OF released_at_ms ON original_body_leases FOR EACH ROW EXECUTE FUNCTION actual_owned_release_failure()").Error)
+				} else {
+					require.NoError(t, f.db.Exec("CREATE TRIGGER actual_owned_release_failure BEFORE UPDATE OF released_at_ms ON original_body_leases WHEN OLD.lease_id="+literal+" AND NEW.released_at_ms IS NOT NULL BEGIN SELECT RAISE(ABORT,'actual owned original lease release refused'); END").Error)
+				}
+				triggerInstalled = true
+			}
+			releaseOnce.Do(func() { close(released) })
+			err := life.WaitOriginalDownload(ctx, id)
+			require.Equal(t, int64(1), calls.Load())
+			actual.downloads.mu.Lock()
+			job := actual.downloads.jobs[id]
+			actual.downloads.mu.Unlock()
+			require.NotNil(t, job)
+			job.mu.Lock()
+			operationErr, cleanupErr, terminalErr, owner := job.operationErr, job.cleanupErr, job.err, job.releaseOwner
+			job.mu.Unlock()
+			cleanupOwner = owner
+			if mode == "normal_close" {
+				require.NoError(t, err)
+				require.NoError(t, cleanupErr)
+				require.Nil(t, owner)
+				require.NoError(t, cleanup.StopOriginalDownloadsWithErrors())
+				assertMemAtomicSQLLeasesClosed(t, f)
+				return
+			}
+			require.Error(t, cleanupErr)
+			require.Contains(t, cleanupErr.Error(), "actual owned original lease release refused")
+			require.NotNil(t, owner)
+			require.True(t, errors.Is(err, cleanupErr))
+			require.True(t, errors.Is(terminalErr, cleanupErr))
+			if mode == "operation_and_close_failure" {
+				require.ErrorIs(t, operationErr, types.ErrMemoryOriginalUnavailable)
+				require.True(t, errors.Is(err, operationErr))
+			} else {
+				require.NoError(t, operationErr)
+			}
+			var held struct {
+				LeaseID, BodyID, OwnerID, Kind string
+				Epoch, ExpiresAtMS             int64
+				ReleasedAtMS                   *int64
+			}
+			require.NoError(t, clean().Table("original_body_leases").Where("lease_id=?", bound.LeaseID).Take(&held).Error)
+			require.Nil(t, held.ReleasedAtMS)
+			require.Equal(t, bound.OwnerID, held.OwnerID)
+			require.Equal(t, bound.Epoch, held.Epoch)
+			require.Equal(t, bound.ExpiresAtMS, held.ExpiresAtMS)
+			if mode == "cleaner_reports_failure" {
+				cleaner := shutdown.NewResourceCleaner()
+				cleaner.RegisterWithName("OriginalModelDownloads", func() error { return cleanup.StopOriginalDownloadsWithErrors() })
+				errs := shutdown.CleanupAfterHTTPDrain(context.Background(), time.Second, models, cleaner)
+				require.NotEmpty(t, errs)
+				for _, actualErr := range errs {
+					require.True(t, errors.Is(actualErr, cleanupErr))
+				}
+				require.ErrorIs(t, cleanup.RetryOriginalDownloadRelease(ctx, id), types.ErrMemoryOriginalUnavailable, "the stopped manager must not accept a new release operation")
+				require.NoError(t, dropFault())
+				require.NoError(t, owner.RetryOriginalRelease(ctx))
+				require.Equal(t, int64(1), calls.Load())
+				assertMemAtomicSQLLeasesClosed(t, f)
+				return
+			}
+			// The owner retry is release-only. A native SQL refusal retains the same
+			// actual lease and cannot prolong it or mint a fresh original/model call.
+			require.ErrorContains(t, cleanup.RetryOriginalDownloadRelease(ctx, id), "actual owned original lease release refused")
+			require.Equal(t, int64(1), calls.Load())
+			require.NoError(t, dropFault())
+			require.NoError(t, cleanup.RetryOriginalDownloadRelease(ctx, id))
+			require.Equal(t, int64(1), calls.Load())
+			require.NoError(t, clean().Table("original_body_leases").Where("lease_id=?", bound.LeaseID).Take(&held).Error)
+			require.NotNil(t, held.ReleasedAtMS)
+			require.Equal(t, bound.ExpiresAtMS, held.ExpiresAtMS)
+			// Terminal diagnostics retain BOTH original errors even after an actual
+			// cleanup retry succeeds. Current outstanding cleanup becomes empty.
+			historical := life.WaitOriginalDownload(ctx, id)
+			require.True(t, errors.Is(historical, cleanupErr))
+			if operationErr != nil {
+				require.True(t, errors.Is(historical, operationErr))
+			}
+			require.NoError(t, cleanup.StopOriginalDownloadsWithErrors())
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestSQLiteOriginalDownloadReleaseRetryActual(t *testing.T) {
+	runOriginalDownloadReleaseRetryActual(t, false)
+}
+func TestPostgresOriginalDownloadReleaseRetryActual(t *testing.T) {
+	runOriginalDownloadReleaseRetryActual(t, true)
+}
diff --git a/internal/application/service/model_original_initial_release_failure_actual_test.go b/internal/application/service/model_original_initial_release_failure_actual_test.go
new file mode 100644
index 00000000..e954b5d4
--- /dev/null
+++ b/internal/application/service/model_original_initial_release_failure_actual_test.go
@@ -0,0 +1,210 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/Tencent/WeKnora/internal/utils"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"net/http"
+	"net/http/httptest"
+	"runtime"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type actualModelInitialRefusalKey struct{}
+
+func runModelOriginalInitialReleaseFailureActual(t *testing.T, pg bool) {
+	for _, lane := range []string{"generic_current", "queued_download"} {
+		t.Run(lane, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, models, _, reader := actualOriginalModelServices(t, f)
+			ctx, cancel := context.WithTimeout(f.ctx, 8*time.Second)
+			defer cancel()
+			token := new(int)
+			marked := context.WithValue(ctx, actualModelInitialRefusalKey{}, token)
+			var calls atomic.Int64
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls.Add(1); w.WriteHeader(500) }))
+			t.Cleanup(server.Close)
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			id := f.model.GetModelID()
+			var model *types.Model
+			var life interfaces.ModelOriginalDownloadLifecycle
+			var cleanup interfaces.ModelOriginalDownloadCleanupLifecycle
+			if lane == "queued_download" {
+				id = "actual-initial-recheck-failed-download"
+				var ok bool
+				life, ok = models.(interfaces.ModelOriginalDownloadLifecycle)
+				require.True(t, ok)
+				cleanup, ok = models.(interfaces.ModelOriginalDownloadCleanupLifecycle)
+				require.True(t, ok)
+				model = &types.Model{ID: id, TenantID: 7, Name: "nomic-embed-text:actual-initial-refusal", Type: types.ModelTypeEmbedding, Source: types.ModelSourceLocal, Parameters: types.ModelParameters{BaseURL: server.URL, EmbeddingParameters: types.EmbeddingParameters{Dimension: 2}}}
+			}
+			quote := func(s string) string { return "'" + strings.ReplaceAll(s, "'", "''") + "'" }
+			triggerInstalled := false
+			dropFault := func() error {
+				if !triggerInstalled {
+					return nil
+				}
+				var err error
+				if pg {
+					err = f.db.Exec("DROP TRIGGER actual_initial_release_failure ON original_body_leases").Error
+					if err == nil {
+						err = f.db.Exec("DROP FUNCTION actual_initial_release_failure()").Error
+					}
+				} else {
+					err = f.db.Exec("DROP TRIGGER actual_initial_release_failure").Error
+				}
+				if err == nil {
+					triggerInstalled = false
+				}
+				return err
+			}
+			target := "EXISTS(SELECT 1 FROM model_original_body_receipts b JOIN model_definition_originals d ON d.id=b.origin_id WHERE b.body_id=OLD.body_id AND d.model_id=" + quote(id) + ")"
+			if pg {
+				require.NoError(t, f.db.Exec("CREATE FUNCTION actual_initial_release_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.released_at_ms IS NOT NULL AND "+target+" THEN RAISE EXCEPTION 'actual initial original release refused'; END IF; RETURN NEW; END $$").Error)
+				require.NoError(t, f.db.Exec("CREATE TRIGGER actual_initial_release_failure BEFORE UPDATE OF released_at_ms ON original_body_leases FOR EACH ROW EXECUTE FUNCTION actual_initial_release_failure()").Error)
+			} else {
+				require.NoError(t, f.db.Exec("CREATE TRIGGER actual_initial_release_failure BEFORE UPDATE OF released_at_ms ON original_body_leases WHEN NEW.released_at_ms IS NOT NULL AND "+target+" BEGIN SELECT RAISE(ABORT,'actual initial original release refused'); END").Error)
+			}
+			triggerInstalled = true
+			var owner interfaces.ModelOriginalReleaseRetry
+			name := "actual-post-commit-initial-model-refusal"
+			var applied atomic.Bool
+			var faultErr error
+			var acquired int64
+			require.NoError(t, f.db.Callback().Query().Before("gorm:query").Register(name, func(tx *gorm.DB) {
+				if tx.Statement.Table != "users" || tx.Statement.Context.Value(actualModelInitialRefusalKey{}) != token || applied.Load() {
+					return
+				}
+				pcs := make([]uintptr, 64)
+				frames := runtime.CallersFrames(pcs[:runtime.Callers(2, pcs)])
+				initial, recheck := false, false
+				for {
+					frame, more := frames.Next()
+					initial = initial || strings.HasSuffix(frame.Function, ".beginModelOriginalReadMode")
+					recheck = recheck || strings.HasSuffix(frame.Function, ".(*modelOriginalRead).Recheck")
+					if !more {
+						break
+					}
+				}
+				if !initial || !recheck {
+					return
+				}
+				// This first Recheck runs after the real acquisition transaction committed.
+				// Within this new transaction, actual current-user read observes a native
+				// refusal; its rollback cannot remove the already-committed two leases.
+				clean := func() *gorm.DB {
+					return tx.Session(&gorm.Session{NewDB: true, Context: context.WithValue(tx.Statement.Context, actualModelInitialRefusalKey{}, nil)})
+				}
+				faultErr = clean().Table("original_body_leases").Where("owner_id LIKE ? AND body_id IN (SELECT body_id FROM model_original_body_receipts WHERE origin_id IN (SELECT id FROM model_definition_originals WHERE model_id=? UNION SELECT id FROM model_credential_originals WHERE model_id=?)) AND kind=? AND released_at_ms IS NULL", "model-original-read/%", id, id, "read").Count(&acquired).Error
+				if faultErr == nil && acquired != 2 {
+					faultErr = fmt.Errorf("initial Recheck saw %d actual committed leases, expected2", acquired)
+					return
+				}
+				if faultErr == nil {
+					write := clean().Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false)
+					faultErr = write.Error
+					if faultErr == nil && write.RowsAffected != 1 {
+						faultErr = fmt.Errorf("real initial-user refusal changed %d rows", write.RowsAffected)
+						return
+					}
+					if faultErr == nil {
+						var user types.User
+						faultErr = clean().Where("id=?", types.CallerFromContext(f.ctx).UserID).Take(&user).Error
+						if faultErr == nil && user.IsActive {
+							faultErr = fmt.Errorf("actual initial-user readback remained active")
+							return
+						}
+					}
+				}
+				applied.Store(faultErr == nil)
+				// No AddError/fake authorizer is used. The pending real users query and
+				// actual RefreshCurrentReadActor must reject its now-inactive SQL row.
+			}))
+			t.Cleanup(func() {
+				_ = f.db.Callback().Query().Remove(name)
+				_ = dropFault()
+				cancel()
+				if life != nil {
+					life.StopOriginalDownloads()
+				}
+				if owner != nil {
+					_ = owner.RetryOriginalRelease(context.WithoutCancel(f.ctx))
+				}
+			})
+			var err error
+			var operationErr, cleanupErr error
+			if lane == "generic_current" {
+				read, beginErr := reader.BeginModelOriginalRead(marked, id, nil)
+				if read != nil {
+					t.Cleanup(func() { _ = dropFault(); _ = read.Close() })
+				}
+				err = beginErr
+				require.Nil(t, read, "initial failure exposes no usable model/read/grant")
+				require.True(t, applied.Load())
+				require.NoError(t, faultErr)
+				var failure interfaces.ModelOriginalInitializationFailure
+				require.ErrorAs(t, err, &failure)
+				operationErr, cleanupErr, owner = failure.OriginalInitializationCleanup()
+			} else {
+				life.StartOriginalDownloads()
+				require.NoError(t, models.CreateModel(marked, model))
+				require.NotNil(t, model.OriginalProof)
+				err = life.WaitOriginalDownload(ctx, id)
+				actual := models.(*modelService)
+				actual.downloads.mu.Lock()
+				job := actual.downloads.jobs[id]
+				actual.downloads.mu.Unlock()
+				require.NotNil(t, job)
+				job.mu.Lock()
+				operationErr, cleanupErr, owner = job.operationErr, job.cleanupErr, job.releaseOwner
+				job.mu.Unlock()
+			}
+			require.True(t, applied.Load())
+			require.NoError(t, faultErr)
+			require.Equal(t, int64(2), acquired)
+			require.Error(t, operationErr)
+			require.ErrorContains(t, cleanupErr, "actual initial original release refused")
+			require.NotNil(t, owner)
+			require.True(t, errors.Is(err, operationErr))
+			require.True(t, errors.Is(err, cleanupErr))
+			require.Zero(t, calls.Load())
+			_, usable := owner.(interfaces.ModelOriginalRead)
+			require.False(t, usable, "failed owner must have release-only methods")
+			var active int64
+			require.NoError(t, f.db.Table("original_body_leases").Where("owner_id LIKE ? AND released_at_ms IS NULL AND body_id IN(SELECT body_id FROM model_original_body_receipts WHERE origin_id IN(SELECT id FROM model_definition_originals WHERE model_id=? UNION SELECT id FROM model_credential_originals WHERE model_id=?))", "model-original-read/%", id, id).Count(&active).Error)
+			require.Equal(t, int64(1), active)
+			require.NoError(t, dropFault())
+			if lane == "queued_download" {
+				require.NoError(t, cleanup.RetryOriginalDownloadRelease(ctx, id))
+				require.NoError(t, cleanup.StopOriginalDownloadsWithErrors())
+			} else {
+				require.NoError(t, owner.RetryOriginalRelease(ctx))
+			}
+			require.Zero(t, calls.Load())
+			assertMemAtomicSQLLeasesClosed(t, f)
+			if lane == "queued_download" {
+				var count int64
+				require.NoError(t, f.db.Model(&types.ModelDownloadOriginal{}).Where("model_id=?", id).Count(&count).Error)
+				require.Zero(t, count)
+				var stored types.Model
+				require.NoError(t, f.db.Where("id=?", id).Take(&stored).Error)
+				require.Equal(t, types.ModelStatusDownloading, stored.Status)
+			}
+		})
+	}
+}
+func TestSQLiteModelOriginalInitialReleaseFailureActual(t *testing.T) {
+	runModelOriginalInitialReleaseFailureActual(t, false)
+}
+func TestPostgresModelOriginalInitialReleaseFailureActual(t *testing.T) {
+	runModelOriginalInitialReleaseFailureActual(t, true)
+}
