+func (s *modelService) RetryOriginalDownloadRelease(ctx context.Context, id string) error {
+	s.downloads.releaseMu.Lock()
+	defer s.downloads.releaseMu.Unlock()
+	s.downloads.mu.Lock()
+	stopped := s.downloads.stopped
+	job := s.downloads.jobs[id]
+	s.downloads.mu.Unlock()
