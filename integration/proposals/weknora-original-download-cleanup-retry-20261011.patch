@@ -20,3 +20,18 @@ type ModelOriginalDownloadLifecycle interface {
 	StopOriginalDownloads()
 	WaitOriginalDownload(context.Context, string) error
 }
+
+// Cleanup-only capability: never reopens a read, renews a lease or authorizes
+// model execution. The concrete owner retains the failed captured tuples.
+type ModelOriginalReleaseRetry interface{ RetryOriginalRelease(context.Context) error }
+type ModelOriginalDownloadCleanupLifecycle interface {
+	StopOriginalDownloadsWithErrors() error
+	RetryOriginalDownloadRelease(context.Context, string) error
+}
+
+// A failed initialization exposes errors and its CLOSED release-only owner.
+// It carries no serializable origin, Snapshot, Context or execution capability.
+type ModelOriginalInitializationFailure interface {
+	error
+	OriginalInitializationCleanup() (operationErr, cleanupErr error, owner ModelOriginalReleaseRetry)
+}
