@@ -0,0 +1,37 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+type modelOriginalClosedReleaseOwner struct{ read *modelOriginalRead }
+
+func (owner *modelOriginalClosedReleaseOwner) RetryOriginalRelease(ctx context.Context) error {
+	return owner.read.retryClosedOriginalReleases(ctx)
+}
+
+type modelOriginalInitializationFailure struct {
+	operationErr, cleanupErr error
+	owner                    *modelOriginalClosedReleaseOwner
+}
+
+func (f *modelOriginalInitializationFailure) Error() string {
+	return errors.Join(f.operationErr, f.cleanupErr).Error()
+}
+func (f *modelOriginalInitializationFailure) Unwrap() []error {
+	return []error{f.operationErr, f.cleanupErr}
+}
+func (f *modelOriginalInitializationFailure) OriginalInitializationCleanup() (error, error, interfaces.ModelOriginalReleaseRetry) {
+	return f.operationErr, f.cleanupErr, f.owner
+}
+func closeFailedModelOriginalInitialization(read *modelOriginalRead, operationErr error) error {
+	cleanupErr := read.Close()
+	if cleanupErr == nil {
+		return operationErr
+	}
+	return &modelOriginalInitializationFailure{operationErr: operationErr, cleanupErr: cleanupErr, owner: &modelOriginalClosedReleaseOwner{read: read}}
+}
+
+var _ interfaces.ModelOriginalInitializationFailure = (*modelOriginalInitializationFailure)(nil)
