--- /dev/null
+++ b/internal/application/repository/model_original_release.go
@@ -0,0 +1,88 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"sort"
+	"time"
+)
+
+// Release exactly a captured ownership tuple. No body read, current catalog
+// lookup, permission grant, lease creation or renewal occurs in this operation.
+func releaseCapturedModelLease(ctx context.Context, db *gorm.DB, bound originalBodyLease) error {
+	if bound.LeaseID == "" || bound.BodyID == "" || bound.OwnerID == "" || bound.Kind != "read" {
+		return ErrOriginalBodyUnavailable
+	}
+	return db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var actual originalBodyLease
+		if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Where("lease_id=?", bound.LeaseID).Take(&actual).Error; err != nil {
+			return err
+		}
+		if actual.BodyID != bound.BodyID || actual.OwnerID != bound.OwnerID || actual.Kind != bound.Kind || actual.Epoch != bound.Epoch {
+			return ErrOriginalBodyUnavailable
+		}
+		if actual.ReleasedAtMS != nil {
+			return ctx.Err()
+		}
+		now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+		if err != nil {
+			return err
+		}
+		write := bodyInternal(tx).Model(&originalBodyLease{}).Where("lease_id=? AND body_id=? AND owner_id=? AND kind=? AND epoch=? AND released_at_ms IS NULL", bound.LeaseID, bound.BodyID, bound.OwnerID, bound.Kind, bound.Epoch).Update("released_at_ms", now)
+		if write.Error != nil {
+			return write.Error
+		}
+		if write.RowsAffected != 1 {
+			return ErrOriginalBodyUnavailable
+		}
+		return ctx.Err()
+	}, memoryWriteOptions(db))
+}
+func (r *modelOriginalRead) retryClosedOriginalReleases(ctx context.Context) error {
+	r.mu.Lock()
+	if !r.closed {
+		r.mu.Unlock()
+		return ErrOriginalBodyUnavailable
+	}
+	joined := r.closeJoined
+	r.mu.Unlock()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-joined:
+	}
+	// This release-only mutex serializes explicit retries. It is not held by
+	// Snapshot/Recheck, and the model remains canceled/closed for its entire life.
+	r.releaseMu.Lock()
+	defer r.releaseMu.Unlock()
+	r.mu.Lock()
+	pending := map[string]originalBodyLease{}
+	for id, bound := range r.pendingReleases {
+		pending[id] = bound
+	}
+	r.mu.Unlock()
+	bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	keys := []string{}
+	for id := range pending {
+		keys = append(keys, id)
+	}
+	sort.Strings(keys)
+	remaining := map[string]originalBodyLease{}
+	var releaseErrors []error
+	for _, id := range keys {
+		bound := pending[id]
+		if err := releaseCapturedModelLease(bounded, r.db, bound); err != nil {
+			remaining[id] = bound
+			releaseErrors = append(releaseErrors, err)
+		}
+	}
+	err := errors.Join(releaseErrors...)
+	r.mu.Lock()
+	r.pendingReleases = remaining
+	r.closeErr = err
+	r.mu.Unlock()
+	return err
+}
