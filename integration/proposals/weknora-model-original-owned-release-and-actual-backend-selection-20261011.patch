@@ -0,0 +1,61 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"strings"
+
+	"github.com/mattn/go-sqlite3"
+)
+
+type modelOriginalReleaseDiagnosticKey struct{}
+
+// ModelOriginalReleaseFailure contains metadata only. It never exports a
+// lease/body/owner ID, SQL, parameters, original text, credential or error string.
+type ModelOriginalReleaseFailure struct {
+	Phase              string
+	ErrorClass         string
+	SQLiteCode         int
+	SQLiteExtendedCode int
+	OwnershipKind      string
+	LeaseKind          string
+}
+
+// WithModelOriginalReleaseFailureObserver is an opt-in diagnostic, not an
+// authority. Existing callers do not install it; no checks/results are changed.
+func WithModelOriginalReleaseFailureObserver(ctx context.Context, observer func(ModelOriginalReleaseFailure)) context.Context {
+	if ctx == nil || observer == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, modelOriginalReleaseDiagnosticKey{}, observer)
+}
+
+func observeModelOriginalReleaseFailure(ctx context.Context, bound originalBodyLease, err error) {
+	if err == nil || ctx == nil {
+		return
+	}
+	observer, _ := ctx.Value(modelOriginalReleaseDiagnosticKey{}).(func(ModelOriginalReleaseFailure))
+	if observer == nil {
+		return
+	}
+	metadata := ModelOriginalReleaseFailure{Phase: "model_original_owned_release", ErrorClass: "other", OwnershipKind: "other", LeaseKind: "read"}
+	if strings.HasPrefix(bound.OwnerID, "model-original-read/") {
+		metadata.OwnershipKind = "model_original_read"
+	}
+	if bound.Kind != "read" {
+		metadata.LeaseKind = "other"
+	}
+	var driver sqlite3.Error
+	if errors.As(err, &driver) {
+		metadata.ErrorClass = "sqlite_driver"
+		metadata.SQLiteCode = int(driver.Code)
+		metadata.SQLiteExtendedCode = int(driver.ExtendedCode)
+	} else if errors.Is(err, context.DeadlineExceeded) {
+		metadata.ErrorClass = "context_deadline"
+	} else if errors.Is(err, context.Canceled) {
+		metadata.ErrorClass = "context_cancelled"
+	} else if errors.Is(err, ErrOriginalBodyUnavailable) {
+		metadata.ErrorClass = "body_unavailable"
+	}
+	observer(metadata)
+}
