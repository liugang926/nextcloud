+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+type modelReleaseActualOwnerKey struct{}
+
+func TestModelOriginalOwnedReleaseSQLiteWALActual(t *testing.T) {
+	for _, mode := range []string{"parallel_current_model_Close", "AfterFunc_HTTP_owner_cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			store, db, base := jointFullSchemaBusinessFixture(t, false)
+			var journal string
+			require.NoError(t, db.Raw("PRAGMA journal_mode").Scan(&journal).Error)
+			require.Equal(t, "wal", strings.ToLower(journal))
+			pool, err := db.DB()
+			require.NoError(t, err)
+			pool.SetMaxOpenConns(2)
+			pool.SetMaxIdleConns(2)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(503) }))
+			t.Cleanup(server.Close)
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			modelRepo := repository.NewModelRepository(db)
+			ConfigureModelOriginalAuthority(modelRepo, store, NewGroupAccessService(repository.NewGroupAccessRepository(db)), nil)
+			models := NewModelService(modelRepo, nil, nil, nil, nil, nil)
+			model := actualModelLiteral(uuid.NewString(), 7)
+			model.Parameters.BaseURL = server.URL
+			require.NoError(t, models.CreateModel(base, model))
+			require.NotNil(t, model.OriginalProof)
+			require.True(t, model.OriginalProof.Valid())
+
+			bound, cancel := context.WithTimeout(base, 8*time.Second)
+			defer cancel()
+			ownerA, cancelA := context.WithCancel(context.WithValue(bound, modelReleaseActualOwnerKey{}, "A"))
+			ownerB, cancelB := context.WithCancel(context.WithValue(bound, modelReleaseActualOwnerKey{}, "B"))
+			ctxA, _, _, releaseA := BeginMessageMaterialHTTPBoundary(ownerA)
+			ctxB, _, _, releaseB := BeginMessageMaterialHTTPBoundary(ownerB)
+			allowA, enteredA, attemptB, enteredB := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+			var openOnce sync.Once
+			open := func() { openOnce.Do(func() { close(allowA) }) }
+			var clientA, clientB *modelOriginalChatClient
+			resultA, resultB := make(chan error, 1), make(chan error, 1)
+			startedA, startedB, joinedA, joinedB := false, false, false, false
+			queryName, rawName := "actual-model-release-read-barrier", "actual-model-release-writer-reservation"
+			queryRegistered, rawRegistered := false, false
+			// Any setup/assertion failure first unblocks real SQL, then cancels
+			// and joins the actual client closes before server/database cleanup.
+			t.Cleanup(func() {
+				open()
+				cancelA()
+				cancelB()
+				if clientA != nil {
+					if err := clientA.CloseOriginal(); err != nil {
+						t.Error(err)
+					}
+				}
+				if clientB != nil {
+					if err := clientB.CloseOriginal(); err != nil {
+						t.Error(err)
+					}
+				}
+				releaseA()
+				releaseB()
+				joinCtx, joinCancel := context.WithTimeout(context.WithoutCancel(bound), 3*time.Second)
+				defer joinCancel()
+				if startedA && !joinedA {
+					select {
+					case <-resultA:
+						joinedA = true
+					case <-joinCtx.Done():
+						t.Error("actual first Close waiter did not join")
+					}
+				}
+				if startedB && !joinedB {
+					select {
+					case <-resultB:
+						joinedB = true
+					case <-joinCtx.Done():
+						t.Error("actual second Close waiter did not join")
+					}
+				}
+				if queryRegistered {
+					if err := db.Callback().Query().Remove(queryName); err != nil {
+						t.Error(err)
+					}
+				}
+				if rawRegistered {
+					if err := db.Callback().Raw().Remove(rawName); err != nil {
+						t.Error(err)
+					}
+				}
+			})
+			valueA, err := models.GetChatModel(ctxA, model.ID)
+			require.NoError(t, err)
+			var ok bool
+			clientA, ok = valueA.(*modelOriginalChatClient)
+			require.True(t, ok)
+			valueB, err := models.GetChatModel(ctxB, model.ID)
+			require.NoError(t, err)
+			clientB, ok = valueB.(*modelOriginalChatClient)
+			require.True(t, ok)
+			require.True(t, clientA.owner)
+			require.True(t, clientB.owner)
+			require.False(t, clientA.autoClose)
+			require.False(t, clientB.autoClose)
+			idsA, err := repository.ModelOriginalLeaseIDs(clientA.read.Context())
+			require.NoError(t, err)
+			idsB, err := repository.ModelOriginalLeaseIDs(clientB.read.Context())
+			require.NoError(t, err)
+			require.Len(t, idsA, 2)
+			require.Len(t, idsB, 2)
+			ids := append(append([]string(nil), idsA...), idsB...)
+			require.NotEqual(t, idsA, idsB)
+			var live int64
+			require.NoError(t, db.Table("original_body_leases").Where("lease_id IN ? AND released_at_ms IS NULL", ids).Count(&live).Error)
+			require.EqualValues(t, 4, live)
+
+			var onceA, onceB, firstB atomic.Bool
+			var reservationA atomic.Bool
+			var observerMu sync.Mutex
+			var observerErr error
+			record := func(err error) { observerMu.Lock(); observerErr = errors.Join(observerErr, err); observerMu.Unlock() }
+			require.NoError(t, db.Callback().Raw().Before("gorm:raw").Register(rawName, func(tx *gorm.DB) {
+				statement := tx.Statement.SQL.String()
+				if !strings.Contains(statement, "UPDATE original_body_leases SET expires_at_ms=expires_at_ms WHERE 1=0") {
+					return
+				}
+				switch tx.Statement.Context.Value(modelReleaseActualOwnerKey{}) {
+				case "A":
+					reservationA.Store(true)
+				case "B":
+					if onceB.CompareAndSwap(false, true) {
+						close(attemptB)
+					}
+				}
+			}))
+			rawRegistered = true
+			require.NoError(t, db.Callback().Query().Before("gorm:query").Register(queryName, func(tx *gorm.DB) {
+				if tx.Statement.Table != "original_body_leases" {
+					return
+				}
+				switch tx.Statement.Context.Value(modelReleaseActualOwnerKey{}) {
+				case "A":
+					if !onceA.CompareAndSwap(false, true) {
+						return
+					}
+					close(enteredA)
+					select {
+					case <-allowA:
+					case <-tx.Statement.Context.Done():
+						record(errors.New("actual release read barrier expired"))
+					}
+				case "B":
+					if firstB.CompareAndSwap(false, true) {
+						close(enteredB)
+					}
+				}
+			}))
+			queryRegistered = true
+			// Callbacks never Fatal/Goexit, AddError or fabricate SQL results.
+			wait := func(ch <-chan struct{}) bool {
+				select {
+				case <-ch:
+					return true
+				case <-bound.Done():
+					return false
+				}
+			}
+			if mode == "AfterFunc_HTTP_owner_cancel" {
+				cancelA()
+				require.True(t, wait(clientA.closeSignal), "actual owner cancellation starts Close before an explicit waiter")
+			}
+			startedA = true
+			go func() { resultA <- clientA.CloseOriginal() }()
+			require.True(t, wait(enteredA))
+			require.True(t, reservationA.Load(), "actual writer reservation completed before the captured-lease read")
+			if mode == "AfterFunc_HTTP_owner_cancel" {
+				cancelB()
+				require.True(t, wait(clientB.closeSignal))
+			}
+			startedB = true
+			go func() { resultB <- clientB.CloseOriginal() }()
+			require.True(t, wait(attemptB), "second actual Close reaches its real writer reservation")
+			select {
+			case <-enteredB:
+				t.Error("second lease read passed the first transaction's retained writer")
+			case <-time.After(60 * time.Millisecond):
+			case <-bound.Done():
+				t.Error("actual parallel release boundary expired")
+			}
+			open()
+			join := func(result <-chan error, joined *bool) error {
+				select {
+				case err := <-result:
+					*joined = true
+					return err
+				case <-bound.Done():
+					return bound.Err()
+				}
+			}
+			errA, errB := join(resultA, &joinedA), join(resultB, &joinedB)
+			require.NoError(t, errA)
+			require.NoError(t, errB)
+			require.True(t, wait(enteredB))
+			observerMu.Lock()
+			actualErr := observerErr
+			observerMu.Unlock()
+			require.NoError(t, actualErr)
+			require.NoError(t, clientA.CloseOriginal(), "repeated Close preserves the actual terminal result")
+			require.NoError(t, clientB.CloseOriginal())
+			releaseA()
+			releaseB()
+			require.NoError(t, db.Table("original_body_leases").Where("lease_id IN ? AND released_at_ms IS NULL", ids).Count(&live).Error)
+			require.Zero(t, live)
+			var released int64
+			require.NoError(t, db.Table("original_body_leases").Where("lease_id IN ? AND released_at_ms IS NOT NULL", ids).Count(&released).Error)
+			require.EqualValues(t, 4, released)
+		})
+	}
+}
