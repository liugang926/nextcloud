@@ -0,0 +1,187 @@
+package service
+
+import (
+	"encoding/json"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/models/embedding"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func jointEmbeddingStableFixture(t *testing.T, provider string) (*jointOriginalUpgradeFixture, interfaces.ModelRepository, interfaces.ModelService, *types.Model) {
+	t.Helper()
+	f := newJointOriginalUpgradeFixture(t, true)
+	runJointOriginalProductionUpgrade(t, f)
+	repo := repository.NewModelRepository(f.db)
+	ConfigureModelOriginalAuthority(repo, f.store, NewGroupAccessService(repository.NewGroupAccessRepository(f.db)), nil)
+	svc := NewModelService(repo, nil, nil, nil, nil, nil)
+	model := actualModelLiteral(uuid.NewString(), 7)
+	model.Type = types.ModelTypeEmbedding
+	model.Parameters.Provider = provider
+	model.Parameters.EmbeddingParameters = types.EmbeddingParameters{Dimension: 2, SupportsDimensionOverride: true}
+	switch provider {
+	case "openai":
+		model.Name = "explicit embedding"
+	case "aliyun":
+		model.Name = "qwen3-vl-embedding"
+	case "volcengine":
+		model.Name = "doubao-embedding-vision-251215"
+	case "gemini":
+		model.Name = "gemini-embedding-001"
+	}
+	require.NoError(t, svc.CreateModel(f.ctx, model))
+	require.NotNil(t, model.OriginalProof)
+	require.True(t, model.OriginalProof.Valid())
+	return f, repo, svc, model
+}
+func TestPostgresJointStableEmbeddingFourProtocolsActual(t *testing.T) {
+	for _, provider := range []string{"openai", "aliyun", "volcengine", "gemini"} {
+		t.Run(provider, func(t *testing.T) {
+			f, repo, svc, model := jointEmbeddingStableFixture(t, provider)
+			read, err := svc.(interfaces.ModelOriginalLifetimeReader).BeginModelOriginalRead(f.ctx, model.ID, model.OriginalProof)
+			require.NoError(t, err)
+			t.Cleanup(func() {
+				if err := read.Close(); err != nil {
+					t.Error("owned embedding read cleanup failed")
+				}
+			})
+			proved, proof, err := read.Snapshot()
+			require.NoError(t, err)
+			require.Equal(t, *model.OriginalProof, *proof)
+			require.NoError(t, embedding.ValidateOriginalEmbeddingDefinition(proved.Parameters.OriginalEmbedding))
+			digest, err := types.ModelOriginalEmbeddingDigest(proved.Parameters.OriginalEmbedding)
+			require.NoError(t, err)
+			require.Equal(t, proved.Parameters.OriginalEmbedding.SpaceDigest, digest)
+			client, err := svc.GetEmbeddingModel(read.Context(), model.ID)
+			require.NoError(t, err)
+			lifetime, ok := client.(interfaces.ModelOriginalClientLifetime)
+			require.True(t, ok)
+			require.NoError(t, lifetime.CloseOriginal())
+			history, err := repo.(interfaces.HistoricalModelOriginalReader).BeginHistoricalModelOriginalRead(f.ctx, *proof)
+			require.NoError(t, err)
+			require.NoError(t, history.Recheck())
+			require.NoError(t, history.Close())
+			require.NoError(t, read.Close())
+			jointOriginalLeaseState(t, f, false)
+		})
+	}
+}
+
+func TestPostgresJointEmbeddingSpaceIdentityActual(t *testing.T) {
+	for _, mode := range []string{"same_representation", "changed_space", "changed_settings", "authorized_successor"} {
+		t.Run(mode, func(t *testing.T) {
+			f, repo, svc, model := jointEmbeddingStableFixture(t, "openai")
+			read, err := svc.(interfaces.ModelOriginalLifetimeReader).BeginModelOriginalRead(f.ctx, model.ID, model.OriginalProof)
+			require.NoError(t, err)
+			t.Cleanup(func() {
+				if err := read.Close(); err != nil {
+					t.Error("owned embedding hold cleanup failed")
+				}
+			})
+			original, proof, err := read.Snapshot()
+			require.NoError(t, err)
+			oldSpace := original.Parameters.OriginalEmbedding.SpaceDigest
+			var oldOrigin types.ModelDefinitionOriginal
+			require.NoError(t, f.db.Where("id=?", proof.DefinitionID).Take(&oldOrigin).Error)
+			if mode == "authorized_successor" {
+				replacement := *original
+				recipe := *original.Parameters.OriginalEmbedding
+				var fields map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(recipe.Settings, &fields))
+				var timeout int
+				require.NoError(t, json.Unmarshal(fields["RequestTimeout"], &timeout))
+				fields["RequestTimeout"], err = json.Marshal(timeout + 1)
+				require.NoError(t, err)
+				recipe.Settings, err = json.Marshal(fields)
+				require.NoError(t, err)
+				recipe.SpaceDigest, err = types.ModelOriginalEmbeddingDigest(&recipe)
+				require.NoError(t, err)
+				replacement.Parameters.OriginalEmbedding = &recipe
+				require.NoError(t, repo.(interfaces.ModelOriginalWriter).ReplaceModelOriginal(f.ctx, &replacement))
+				require.NotEqual(t, oldSpace, replacement.Parameters.OriginalEmbedding.SpaceDigest)
+				require.NotEqual(t, proof.DefinitionID, replacement.OriginalProof.DefinitionID)
+				history, err := repo.(interfaces.HistoricalModelOriginalReader).BeginHistoricalModelOriginalRead(f.ctx, *proof)
+				require.NoError(t, err)
+				require.NoError(t, history.Recheck())
+				require.NoError(t, history.Close())
+			} else {
+				var row struct{ Parameters string }
+				require.NoError(t, f.db.Table("models").Select("CAST(parameters AS TEXT) AS parameters").Where("id=?", model.ID).Take(&row).Error)
+				var params, recipe map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal([]byte(row.Parameters), &params))
+				require.NoError(t, json.Unmarshal(params["original_embedding"], &recipe))
+				var fields map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(recipe["Settings"], &fields))
+				if mode == "changed_settings" {
+					var timeout int
+					require.NoError(t, json.Unmarshal(fields["RequestTimeout"], &timeout))
+					fields["RequestTimeout"], err = json.Marshal(timeout + 1)
+					require.NoError(t, err)
+				}
+				if mode == "changed_space" {
+					recipe["SpaceDigest"], err = json.Marshal(strings.Repeat("0", 64))
+					require.NoError(t, err)
+					require.NotEqual(t, oldSpace, strings.Repeat("0", 64))
+				}
+				keys := []string{}
+				for key := range fields {
+					keys = append(keys, key)
+				}
+				sort.Sort(sort.Reverse(sort.StringSlice(keys)))
+				parts := []string{}
+				for _, key := range keys {
+					quoted, err := json.Marshal(key)
+					require.NoError(t, err)
+					parts = append(parts, string(quoted)+" : "+string(fields[key]))
+				}
+				recipe["Settings"] = json.RawMessage("{ " + strings.Join(parts, ", ") + " }")
+				params["original_embedding"], err = json.Marshal(recipe)
+				require.NoError(t, err)
+				wire, err := json.Marshal(params)
+				require.NoError(t, err)
+				write := f.db.Exec("UPDATE models SET parameters=CAST(? AS JSONB) WHERE id=?", string(wire), model.ID)
+				require.NoError(t, write.Error)
+				require.EqualValues(t, 1, write.RowsAffected)
+				var actualRow struct{ Parameters string }
+				require.NoError(t, f.db.Table("models").Select("CAST(parameters AS TEXT) AS parameters").Where("id=?", model.ID).Take(&actualRow).Error)
+				var actualParams types.ModelParameters
+				require.NoError(t, json.Unmarshal([]byte(actualRow.Parameters), &actualParams))
+				require.NotNil(t, actualParams.OriginalEmbedding)
+				if mode == "changed_space" {
+					require.Equal(t, strings.Repeat("0", 64), actualParams.OriginalEmbedding.SpaceDigest)
+				} else {
+					require.Equal(t, oldSpace, actualParams.OriginalEmbedding.SpaceDigest)
+				}
+				var actualFields map[string]json.RawMessage
+				require.NoError(t, json.Unmarshal(actualParams.OriginalEmbedding.Settings, &actualFields))
+				require.JSONEq(t, string(fields["RequestTimeout"]), string(actualFields["RequestTimeout"]))
+				if mode == "same_representation" {
+					require.NoError(t, read.Recheck())
+					after, bound, err := read.Snapshot()
+					require.NoError(t, err)
+					require.Equal(t, *proof, *bound)
+					require.Equal(t, oldSpace, after.Parameters.OriginalEmbedding.SpaceDigest)
+					require.Equal(t, string(original.Parameters.OriginalEmbedding.Settings), string(after.Parameters.OriginalEmbedding.Settings))
+					require.NoError(t, embedding.ValidateOriginalEmbeddingDefinition(after.Parameters.OriginalEmbedding))
+				} else {
+					require.Error(t, read.Recheck())
+					after, bound, err := read.Snapshot()
+					require.Error(t, err)
+					require.Nil(t, after)
+					require.Nil(t, bound)
+				}
+			}
+			var retained types.ModelDefinitionOriginal
+			require.NoError(t, f.db.Where("id=?", proof.DefinitionID).Take(&retained).Error)
+			require.Equal(t, oldOrigin, retained, "old raw body/hash/space was not rewritten or resigned")
+			require.NoError(t, read.Close())
+			jointOriginalLeaseState(t, f, false)
+		})
+	}
+}
