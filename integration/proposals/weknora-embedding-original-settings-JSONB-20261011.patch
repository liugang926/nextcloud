+
+// Unknown/local/cloud recipes are not granted representation equivalence by
+// this remote-only slice. Their prior exact-byte/SDK validation stays intact.
+func ModelOriginalEmbeddingStableSettingsSupported(recipe *ModelOriginalEmbeddingDefinition) bool {
+	if recipe == nil || recipe.Version != 1 {
+		return false
+	}
+	switch recipe.Recipe {
+	case "embedding/openai/full-v1":
+		return recipe.API == "openai-embeddings"
+	case "embedding/dashscope/full-v1":
+		return recipe.API == "dashscope-embeddings"
+	case "embedding/ark/full-v1":
+		return recipe.API == "ark-embeddings"
+	case "embedding/google/full-v1":
+		return recipe.API == "google-embeddings"
+	}
+	return false
+}
+func ModelOriginalEmbeddingSettingsBytes(recipe *ModelOriginalEmbeddingDefinition) (json.RawMessage, error) {
+	if !ModelOriginalEmbeddingStableSettingsSupported(recipe) {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	return modelOriginalSettingsBytes(recipe.Settings)
+}
+func modelOriginalSettingsBytes(raw json.RawMessage) (json.RawMessage, error) {
+	if !validModelSettingsStrings(raw) {
 		return nil, ErrMemoryOriginalUnavailable
 	}
-	d := json.NewDecoder(bytes.NewReader(recipe.Settings))
+	d := json.NewDecoder(bytes.NewReader(raw))
 	d.UseNumber()
 	numberBudget := 1 << 20 // Bound total decimal expansion; no precision rounding.
 	value, err := readModelSettingsJSON(d, 0, &numberBudget)
@@ -270,3 +298,24 @@ func RestoreModelOriginalChatSettings(model *Model, raw string) error {
 	model.Parameters.OriginalChat = &recipe
 	return nil
 }
+
+// This restores original opaque definition material only after the repository
+// verified its raw digest/head/body receipt. SpaceDigest is copied verbatim,
+// never recomputed from a current JSONB mirror or relabelled on an old output.
+func RestoreModelOriginalEmbeddingSettings(model *Model, raw string) error {
+	definition, err := decodeModelDefinitionOriginal(raw)
+	if err != nil {
+		return err
+	}
+	if definition.Parameters.OriginalEmbedding == nil {
+		return nil
+	}
+	if model == nil || model.Parameters.OriginalEmbedding == nil {
+		return ErrMemoryOriginalUnavailable
+	}
+	recipe := *model.Parameters.OriginalEmbedding
+	recipe.Settings = append(json.RawMessage(nil), definition.Parameters.OriginalEmbedding.Settings...)
+	recipe.SpaceDigest = definition.Parameters.OriginalEmbedding.SpaceDigest
+	model.Parameters.OriginalEmbedding = &recipe
+	return nil
+}
