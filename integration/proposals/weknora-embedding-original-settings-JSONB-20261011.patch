@@ -0,0 +1,43 @@
+package types
+
+import (
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestEmbeddingSettingsLegacySpaceProjection(t *testing.T) {
+	recipe := &ModelOriginalEmbeddingDefinition{Version: 1, Recipe: "embedding/openai/full-v1", API: "openai-embeddings", Settings: json.RawMessage(`{"z":[1,2],"a":9007199254740993}`), ExpectedDimensions: 2}
+	space, err := ModelOriginalEmbeddingDigest(recipe)
+	require.NoError(t, err)
+	recipe.SpaceDigest = space
+	model := &Model{ID: "old-author-input", TenantID: 7, Name: "old authored embedding", Type: ModelTypeEmbedding, Source: ModelSourceRemote, Parameters: ModelParameters{OriginalEmbedding: recipe}}
+	legacy, err := json.Marshal(ModelOriginalDefinition{model.ID, model.TenantID, model.Name, model.DisplayName, model.Description, model.Type, model.Source, model.IsBuiltin, model.Parameters})
+	require.NoError(t, err)
+	current := *model
+	mirror := *recipe
+	mirror.Settings = json.RawMessage(`{"a":9007199254740993,"z":[1.0,2.0]}`)
+	current.Parameters.OriginalEmbedding = &mirror
+	match, err := ModelDefinitionMatchesOriginal(&current, string(legacy))
+	require.NoError(t, err)
+	require.True(t, match)
+	require.Equal(t, space, mirror.SpaceDigest)
+	require.NoError(t, RestoreModelOriginalEmbeddingSettings(&current, string(legacy)))
+	require.Equal(t, string(recipe.Settings), string(current.Parameters.OriginalEmbedding.Settings))
+	require.Equal(t, space, current.Parameters.OriginalEmbedding.SpaceDigest)
+	restored, err := ModelOriginalEmbeddingDigest(current.Parameters.OriginalEmbedding)
+	require.NoError(t, err)
+	require.Equal(t, space, restored)
+	mirror.SpaceDigest = "different-space"
+	current.Parameters.OriginalEmbedding = &mirror
+	match, err = ModelDefinitionMatchesOriginal(&current, string(legacy))
+	require.NoError(t, err)
+	require.False(t, match)
+	mirror.SpaceDigest = space
+	mirror.Settings = json.RawMessage(`{"a":9007199254740992,"z":[1,2]}`)
+	match, err = ModelDefinitionMatchesOriginal(&current, string(legacy))
+	require.NoError(t, err)
+	require.False(t, match)
+	_, err = ModelOriginalEmbeddingSettingsBytes(&ModelOriginalEmbeddingDefinition{Version: 1, Recipe: "unknown", API: "openai-embeddings", Settings: json.RawMessage(`{}`)})
+	require.Error(t, err)
+}
