+func runModelOriginalBodySQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"missing_producer_capture_rolls_back", "real_released_lease_refuses", "same_SHA_current_head_refuses", "native_runtime_endpoint_unaccounted_refuses"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, svc, writer, reader := actualOriginalModelServices(t, f)
+			model, proof := actualModelProof(t, reader, f.ctx, f.model.GetModelID())
+			if mode == "missing_producer_capture_rolls_back" {
+				capture := f.db.Callback().Create().Get("original_body:capture")
+				require.NotNil(t, capture)
+				require.NoError(t, f.db.Callback().Create().Remove("original_body:capture"))
+				t.Cleanup(func() {
+					require.NoError(t, f.db.Callback().Create().After("gorm:create").Before("gorm:save_after_associations").Register("original_body:capture", capture))
+				})
+				requested := actualModelLiteral("unretained-model-create", 7)
+				require.Error(t, svc.CreateModel(f.ctx, requested))
+				var count int64
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", requested.ID).Count(&count).Error)
+				require.Zero(t, count)
+				require.Zero(t, actualModelOriginCount(t, f, "model_definition_originals", requested.ID))
+				return
+			}
+			if mode == "same_SHA_current_head_refuses" {
+				var oldHead struct {
+					SlotID, BodyID string
+					Revision       int64
+				}
+				require.NoError(t, f.db.Table("original_body_field_heads").Where("source_table='model_definition_originals' AND row_key=?", proof.DefinitionID).Take(&oldHead).Error)
+				require.NoError(t, writer.ReplaceModelOriginal(f.ctx, model))
+				_, next := actualModelProof(t, reader, f.ctx, model.ID)
+				var currentHead struct {
+					SlotID, BodyID string
+					Revision       int64
+				}
+				require.NoError(t, f.db.Table("original_body_field_heads").Where("source_table='model_definition_originals' AND row_key=?", next.DefinitionID).Take(&currentHead).Error)
+				require.NotEqual(t, oldHead.BodyID, currentHead.BodyID)
+				var oldFact, nextFact types.ModelDefinitionOriginal
+				require.NoError(t, f.db.Where("id=?", proof.DefinitionID).Take(&oldFact).Error)
+				require.NoError(t, f.db.Where("id=?", next.DefinitionID).Take(&nextFact).Error)
+				require.Equal(t, oldFact.DefinitionDigest, nextFact.DefinitionDigest)
+				ref, err := json.Marshal(map[string]interface{}{"_original_body_version": 1, "slot_id": currentHead.SlotID, "body_id": oldHead.BodyID, "sha256": nextFact.DefinitionDigest})
+				require.NoError(t, err)
+				require.NoError(t, f.db.Table("original_body_field_heads").Where("slot_id=?", currentHead.SlotID).Updates(map[string]interface{}{"body_id": oldHead.BodyID, "revision": currentHead.Revision + 1, "original_body_ref": string(ref)}).Error)
+				_, err = reader.BeginModelOriginalRead(f.ctx, model.ID, nil)
+				require.Error(t, err, "a current same-SHA mirror cannot replace its immutable actual body receipt")
+				return
+			}
+			if mode == "native_runtime_endpoint_unaccounted_refuses" {
+				local := actualModelLiteral("native-unaccounted-instance", 7)
+				local.Source = types.ModelSourceLocal
+				local.Status = types.ModelStatusActive
+				require.NoError(t, writer.CreateModelOriginal(f.ctx, local))
+				read, err := reader.BeginModelOriginalRead(f.ctx, local.ID, local.OriginalProof)
+				require.NoError(t, err)
+				defer func() { require.NoError(t, read.Close()) }()
+				_, err = svc.GetChatModel(read.Context(), local.ID)
+				require.Error(t, err, "global current Ollama environment is not an original runtime endpoint")
+				return
+			}
+			read, err := reader.BeginModelOriginalRead(f.ctx, model.ID, &proof)
+			require.NoError(t, err)
+			defer func() { require.NoError(t, read.Close()) }()
+			var lease struct{ LeaseID string }
+			require.NoError(t, f.db.Table("original_body_leases l").Select("l.lease_id").Joins("JOIN original_body_field_heads h ON h.body_id=l.body_id").Where("h.source_table='model_definition_originals' AND h.row_key=? AND l.kind='read' AND l.released_at_ms IS NULL", proof.DefinitionID).Take(&lease).Error)
+			require.NoError(t, repository.NewOriginalBodyRetentionStore(f.db).ReleaseLease(f.ctx, lease.LeaseID))
+			require.Error(t, read.Recheck())
+			require.Error(t, read.Recheck())
+		})
+	}
+}
