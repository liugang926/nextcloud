+)
+
+// Diagnostics expose only static stages and error identities. An error may
+// contain SQL/provider details, so neither err.Error nor model parameters are
+// logged. Every case gets its own genuine producer/SQL fixture and originals.
+func memoryEnqueuePreflightError(err error) string {
+	switch {
+	case err == nil:
+		return "none"
+	case errors.Is(err, context.Canceled):
+		return "context_canceled"
+	case errors.Is(err, context.DeadlineExceeded):
+		return "context_deadline"
+	case errors.Is(err, types.ErrMemoryOriginalUnavailable):
+		return "original_unavailable"
+	case errors.Is(err, repository.ErrOriginalBodyUnavailable):
+		return "original_body_unavailable"
+	case errors.Is(err, gorm.ErrRecordNotFound):
+		return "record_not_found"
+	default:
+		return fmt.Sprintf("other_%T", err)
+	}
+}
+
+func memoryEnqueuePreflightRequire(t *testing.T, stage string, err error) {
+	t.Helper()
+	code := memoryEnqueuePreflightError(err)
+	t.Logf("actual_enqueue_preflight stage=%s error_identity=%s", stage, code)
+	require.True(t, err == nil, "actual enqueue preflight stage %s refused (%s)", stage, code)
+}
+
+func runMemoryEnqueuePreflightSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"model_producer_read", "admissions_read", "native_schedule", "special_schedule"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			defer assertMemAtomicSQLLeasesClosed(t, f)
+			tenant, err := repository.NewTenantRepository(f.db).GetTenantByID(f.ctx, f.scope.TenantID)
+			memoryEnqueuePreflightRequire(t, "tenant_config", err)
+			require.NotNil(t, tenant.MemoryConfig)
+			require.True(t, tenant.MemoryConfig.MemoryEnabled())
+			require.True(t, tenant.MemoryConfig.AutoExtractEnabled())
+			require.Equal(t, f.model.GetModelID(), tenant.MemoryConfig.ExtractModelID)
+			scope, err := memoryservice.ResolveScope(f.ctx)
+			memoryEnqueuePreflightRequire(t, "scope", err)
+			require.Equal(t, f.scope, scope)
+			fresh, err := f.machine.f.store.RefreshCurrentReadActor(f.ctx)
+			memoryEnqueuePreflightRequire(t, "current_actor", err)
+			require.Equal(t, scope.TenantID, types.CallerFromContext(fresh).TenantID)
+			require.True(t, types.CallerFromContext(fresh).Role.HasPermission(types.TenantRoleAdmin))
+			metadata, err := (actualMemoryModels{model: f.model.actualMemoryModel, db: f.db}).GetModelByID(f.ctx, f.model.GetModelID())
+			memoryEnqueuePreflightRequire(t, "model_metadata", err)
+			require.Equal(t, scope.TenantID, metadata.TenantID)
+			require.Equal(t, f.model.GetModelID(), metadata.ID)
+			require.Equal(t, types.ModelStatusActive, metadata.Status)
+			require.Zero(t, memAtomicSQLCount(t, f, "memory_original_admissions"))
+			require.Zero(t, memAtomicSQLCount(t, f, "memory_extraction_sessions"))
+			if mode == "model_producer_read" || mode == "admissions_read" {
+				var reader interfaces.ModelOriginalLifetimeReader
+				if mode == "model_producer_read" {
+					modelRepo := repository.NewModelRepository(f.db)
+					ConfigureModelOriginalAuthority(modelRepo, f.machine.f.store, NewGroupAccessService(repository.NewGroupAccessRepository(f.db)), nil)
+					producer := NewModelService(modelRepo, nil, nil, nil, nil, nil)
+					reader = producer.(interfaces.ModelOriginalLifetimeReader)
+				} else {
+					reader = f.admissions.(interfaces.ModelOriginalLifetimeReader)
+				}
+				read, err := reader.BeginModelOriginalRead(f.ctx, metadata.ID, nil)
+				if read != nil {
+					defer func() { memoryEnqueuePreflightRequire(t, "model_close", read.Close()) }()
+				}
+				memoryEnqueuePreflightRequire(t, "model_begin", err)
+				require.NotNil(t, read)
+				snapshot, proof, err := read.Snapshot()
+				memoryEnqueuePreflightRequire(t, "model_snapshot", err)
+				require.NotNil(t, snapshot)
+				require.NotNil(t, proof)
+				require.True(t, proof.Valid())
+				require.Equal(t, metadata.ID, snapshot.ID)
+				require.Equal(t, snapshot.ID, proof.ModelID)
+				require.Equal(t, scope.TenantID, snapshot.TenantID)
+				require.Equal(t, types.ModelStatusActive, snapshot.Status)
+				memoryEnqueuePreflightRequire(t, "model_recheck", read.Recheck())
+				require.Zero(t, memAtomicSQLCount(t, f, "memory_original_admissions"))
+				require.Zero(t, memAtomicSQLCount(t, f, "memory_extraction_sessions"))
+			} else {
+				require.True(t, types.MemoryAllowedForAgent(f.ctx), "the genuine request has not opted out of memory")
+				subject, err := f.repo.GetSubject(f.ctx, scope)
+				memoryEnqueuePreflightRequire(t, "subject_existing", err)
+				require.NotNil(t, subject)
+				require.True(t, subject.Enabled)
+				ensured, err := f.repo.EnsureSubject(f.ctx, scope)
+				memoryEnqueuePreflightRequire(t, "subject_repeated_ensure", err)
+				require.NotNil(t, ensured)
+				require.Equal(t, subject.ID, ensured.ID, "an existing subject must keep its real original owner ID")
+				require.Equal(t, subject.SubjectID, ensured.SubjectID)
+				require.Equal(t, subject.TenantID, ensured.TenantID)
+				require.True(t, ensured.Enabled)
+				worker := f.service
+				if mode == "special_schedule" {
+					transport := &memFinalClockSQLChat{base: f.model}
+					models := memFinalClockSQLModels{actualMemoryModels: actualMemoryModels{model: f.model.actualMemoryModel, db: f.db, originals: f.admissions.(interfaces.ModelOriginalLifetimeReader)}, transport: transport}
+					worker = memoryservice.NewOriginalBoundMemoryService(f.repo, repository.NewTenantRepository(f.db), repository.NewMessageRepository(f.db), models, f.queue, nil, f.reader, f.admissions)
+					memoryservice.ConfigureOriginalMemoryOutbox(worker, f.outbox)
+				}
+				worker.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, metadata.ID)
+				var progress types.MemoryExtractionSession
+				err = f.db.Where("tenant_id=? AND subject_id=? AND session_id=?", scope.TenantID, scope.SubjectID, f.session.ID).Take(&progress).Error
+				memoryEnqueuePreflightRequire(t, "scheduled_pending", err)
+				require.True(t, progress.Pending)
+				require.NotEmpty(t, progress.OriginalAdmissionID)
+				require.EqualValues(t, 1, progress.Revision)
+				require.True(t, progress.Cursor.At.IsZero())
+				require.Empty(t, progress.Cursor.ID)
+				input, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, progress.OriginalAdmissionID)
+				memoryEnqueuePreflightRequire(t, "scheduled_original", err)
+				require.Equal(t, metadata.ID, input.Request.EnqueueModelID)
+				require.True(t, input.Request.EnqueueModelProof.Valid())
+				require.Equal(t, input.Request.EnqueueModelProof.Digest, input.Request.EnqueueModelDigest)
+				var dispatch types.MemoryOriginalDispatch
+				err = f.db.Where("admission_id=?", input.ID).Take(&dispatch).Error
+				memoryEnqueuePreflightRequire(t, "scheduled_dispatch", err)
+				require.Equal(t, types.MemoryOriginalBytesDigest([]byte(dispatch.Payload)), dispatch.PayloadDigest)
+				require.Nil(t, f.queue.task, "diagnostic scheduling never fabricates broker delivery")
+			}
+			require.Zero(t, f.model.calls)
+			require.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+		})
+	}
+}
+
+func TestMemoryEnqueuePreflightActualSQLite(t *testing.T)   { runMemoryEnqueuePreflightSQL(t, false) }
+func TestPostgresMemoryEnqueuePreflightActual(t *testing.T) { runMemoryEnqueuePreflightSQL(t, true) }
