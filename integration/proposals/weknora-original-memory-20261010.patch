+CREATE TRIGGER memory_original_derivations_no_delete BEFORE DELETE ON memory_original_derivations BEGIN SELECT RAISE(ABORT, 'memory original facts are immutable'); END;
+
+-- Original-bound dispatch is part of the same reserved pending migration.
+-- Merge into reserved75 AFTER memory_original_admissions. Not standalone.
+CREATE TABLE memory_original_dispatches (
