+func TestPostgresMemoryOriginalSharedAgentNoKBFinalEpochFenceActual(t *testing.T) {
+	f, agent, ownerID := newMemSharedAgentNoKBFixture(t, true)
+	input := scheduleMemSharedAgentNoKB(t, f, agent)
+	pool, err := f.db.DB()
+	require.NoError(t, err)
+	owned, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	var conn *sql.Conn
+	workerDone, writerDone := make(chan error, 1), make(chan error, 1)
+	var workerStarted, writerStarted, workerJoined, writerJoined bool
+	var createRegistered, queryRegistered bool
+	reached, release, hookErrors := make(chan int32, 1), make(chan struct{}), make(chan error, 1)
+	var reachedOnce, releaseOnce sync.Once
+	unpause := func() { releaseOnce.Do(func() { close(release) }) }
+	createHook, queryHook := "owned-shared-epoch-created-"+uuid.NewString(), "owned-shared-epoch-query-"+uuid.NewString()
+	// Register cleanup before changing pools, pinning a connection or adding
+	// hooks. Every failed assertion releases, cancels and joins actual owners.
+	t.Cleanup(func() {
+		unpause()
+		cancel()
+		if workerStarted && !workerJoined {
+			<-workerDone
+		}
+		if writerStarted && !writerJoined {
+			<-writerDone
+		}
+		if createRegistered {
+			require.NoError(t, f.db.Callback().Create().Remove(createHook))
+		}
+		if queryRegistered {
+			require.NoError(t, f.db.Callback().Query().Remove(queryHook))
+		}
+		if conn != nil {
+			require.NoError(t, conn.Close())
+		}
+		pool.SetMaxOpenConns(1)
+		pool.SetMaxIdleConns(1)
+	})
+	// This dedicated concurrent case owns three connections. Existing
+	// single-pool legal/refusal fixtures and their budgets are unchanged.
+	pool.SetMaxOpenConns(3)
+	pool.SetMaxIdleConns(3)
+	conn, err = pool.Conn(owned)
+	require.NoError(t, err)
+	writerDB, err := gorm.Open(postgres.New(postgres.Config{Conn: conn, PreferSimpleProtocol: true}), &gorm.Config{})
+	require.NoError(t, err)
+	var writerPID int32
+	require.NoError(t, writerDB.Raw("SELECT pg_backend_pid()").Scan(&writerPID).Error)
+	var checkpointWritten atomic.Bool
+	var finalPolicyReads atomic.Int64
+	require.NoError(t, f.db.Callback().Create().After("gorm:create").Register(createHook, func(query *gorm.DB) {
+		if query.Error == nil && query.Statement.Table == "memory_original_checkpoints" {
+			checkpointWritten.Store(true)
+		}
+	}))
+	createRegistered = true
+	require.NoError(t, f.db.Callback().Query().After("gorm:query").Register(queryHook, func(query *gorm.DB) {
+		if query.Error != nil || !checkpointWritten.Load() {
+			return
+		}
+		if query.Statement.Table == "resource_access_policies" {
+			if policy, ok := query.Statement.Dest.(*types.ResourceAccessPolicy); ok && policy.TenantID == 9 && policy.ResourceID == agent.ID {
+				finalPolicyReads.Add(1)
+			}
+		}
+		if query.Statement.Table != "directory_permission_versions" || finalPolicyReads.Load() == 0 {
+			return
+		}
+		version, ok := query.Statement.Dest.(*types.PermissionVersion)
+		if !ok || version.TenantID != 9 {
+			return
+		}
+		reachedOnce.Do(func() {
+			var workerPID int32
+			if err := query.Statement.ConnPool.QueryRowContext(query.Statement.Context, "SELECT pg_backend_pid()").Scan(&workerPID); err != nil {
+				hookErrors <- err
+				return
+			}
+			reached <- workerPID
+			select {
+			case <-release:
+			case <-query.Statement.Context.Done():
+			}
+		})
+	}))
+	queryRegistered = true
+	workerStarted = true
+	go func() { workerDone <- f.service.Handle(owned, f.queue.task) }()
+	var workerPID int32
+	select {
+	case workerPID = <-reached:
+	case err := <-hookErrors:
+		t.Fatalf("actual final-read PID observation failed: %v", err)
+	case err := <-workerDone:
+		workerJoined = true
+		t.Fatalf("worker ended before actual final source9 fence: %v", err)
+	case <-owned.Done():
+		t.Fatal("worker did not reach final actual source9 fence")
+	}
+	require.Positive(t, finalPolicyReads.Load())
+	writerStarted = true
+	go func() { writerDone <- revokeMemSharedAgentPolicy(owned, writerDB, agent, ownerID) }()
+	// Actual PostgreSQL lock graph, rather than elapsed sleep, must show the
+	// policy writer blocked by this exact worker backend before release.
+	ticker := time.NewTicker(5 * time.Millisecond)
+	defer ticker.Stop()
+	blocked := false
+	for !blocked {
+		var proof bool
+		err := f.db.Raw("SELECT ?::integer = ANY(pg_blocking_pids(?::integer))", workerPID, writerPID).Scan(&proof).Error
+		if err != nil {
+			t.Fatalf("actual blocking PID observation failed: %v", err)
+		}
+		if proof {
+			blocked = true
+			break
+		}
+		select {
+		case err := <-writerDone:
+			writerJoined = true
+			t.Fatalf("source9 writer published before memory terminal fence release: %v", err)
+		case <-owned.Done():
+			t.Fatal("source9 writer never demonstrated actual epoch blocking")
+		case <-ticker.C:
+		}
+	}
+	unpause()
+	workerErr, writerErr := <-workerDone, <-writerDone
+	workerJoined, writerJoined = true, true
+	// Join both actual operations before Fatal assertions or fixture cleanup.
+	require.NoError(t, workerErr)
+	require.NoError(t, writerErr)
+	require.Equal(t, 1, f.model.calls)
+	require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+	require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+	progress := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	require.False(t, progress.Pending)
+	var payload types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &payload))
+	completed, err := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payload)
+	require.NoError(t, err)
+	require.True(t, completed, "historical completion may ACK the actually committed pre-revocation result")
+	// Historical receipt ACK is distinct from a new actual material read.
+	// Test the real current source authorizer, not the already-drained loader.
+	read, readErr := f.messages.beginMessageMaterialRead(f.ctx, types.MessageMaterialReadRequest{TenantID: 7, SessionID: f.session.ID, MessageIDs: []string{f.user.ID, f.assistant.ID}})
+	if read != nil {
+		read.Close()
+	}
+	require.Error(t, readErr, "actual post-revocation material read must reject source9 Restricted authority")
+	var original types.MemoryOriginalAdmission
+	require.NoError(t, f.db.Where("id=?", input.ID).Take(&original).Error)
+	require.Equal(t, input.Digest, original.Digest)
+	policy, err := repository.NewGroupAccessRepository(f.db).GetResourceAccessPolicy(f.ctx, 9, types.GroupResourceTypeAgent, agent.ID)
+	require.NoError(t, err)
+	require.Equal(t, types.ResourceAccessRestricted, policy.Mode)
+	require.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+	assertMemAtomicSQLLeasesClosed(t, f)
+}
