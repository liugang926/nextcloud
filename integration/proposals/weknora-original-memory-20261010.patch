+// Requires the separate SDK/logprivacy patch. This is genuine SQL authoring
+// and owned current read plus actual SDK HTTP; the privacy flag must neither
+// grant a revoked actor nor disappear when caller ctx was initially ordinary.
+func runModelProviderPrivacySQLHTTP(t *testing.T, pg bool) {
+	for _, mode := range []string{"ordinary_owned_read", "marked_actor_revoked"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, svc, _, _ := actualOriginalModelServices(t, f)
+			dir := t.TempDir()
+			t.Setenv("WEKNORA_LLM_STREAM_RAW_DUMP_DIR", dir)
+			t.Setenv("WEKNORA_LLM_STREAM_RAW_DUMP", "1")
+			var logs bytes.Buffer
+			log := logrus.New()
+			log.SetOutput(&logs)
+			log.SetLevel(logrus.DebugLevel)
+			var calls int
+			joined := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				defer close(joined)
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error("actual model HTTP request read failed")
+					return
+				}
+				calls++
+				if !bytes.Contains(body, []byte("PROVED_PRIVATE_INPUT")) {
+					t.Error("actual model HTTP lost input")
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = io.WriteString(w, "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"PROVED_PRIVATE_OUTPUT\"},\"finish_reason\":null}]}\n\ndata: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n")
+			}))
+			t.Cleanup(server.Close)
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			model := actualModelLiteral("provider-private-model", 7)
