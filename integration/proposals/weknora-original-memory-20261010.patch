+// No Model.Parameters.Scan, decrypt, runtime provider or current-row signing.
+// These are exact immutable facts named by the original execution proof.
+func loadHistoricalModelFacts(tx *gorm.DB, proof types.ModelOriginalProof) (*modelOriginalFacts, error) {
+	if !proof.Valid() {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	facts := &modelOriginalFacts{Proof: proof}
+	if err := tx.Where("id=? AND model_id=? AND tenant_id=? AND revision=?", proof.DefinitionID, proof.ModelID, proof.OwnerTenantID, proof.DefinitionRevision).Take(&facts.Definition).Error; err != nil {
+		return nil, err
+	}
+	if err := tx.Where("id=? AND model_id=? AND tenant_id=? AND revision=?", proof.CredentialID, proof.ModelID, proof.OwnerTenantID, proof.CredentialRevision).Take(&facts.Credential).Error; err != nil {
+		return nil, err
+	}
+	if err := tx.Where("id=? AND model_id=? AND tenant_id=? AND epoch=?", proof.StateID, proof.ModelID, proof.OwnerTenantID, proof.StateEpoch).Take(&facts.State).Error; err != nil {
+		return nil, err
+	}
+	d, err := modelDefinitionFactDigest(facts.Definition)
+	if err != nil || d != facts.Definition.Digest || d != proof.DefinitionDigest || bodySHA([]byte(facts.Definition.DefinitionJSON)) != facts.Definition.DefinitionDigest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var identity struct {
+		ID        string
+		TenantID  uint64
+		IsBuiltin bool
+	}
+	if json.Unmarshal([]byte(facts.Definition.DefinitionJSON), &identity) != nil || identity.ID != proof.ModelID || identity.TenantID != proof.OwnerTenantID || identity.IsBuiltin != proof.IsBuiltin {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	c, err := modelCredentialFactDigest(facts.Credential)
+	if err != nil || c != facts.Credential.Digest || c != proof.CredentialDigest || len(facts.Credential.PlainDigest) != 64 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	s, err := modelStateFactDigest(facts.State)
+	if err != nil || s != facts.State.Digest || s != proof.StateDigest || facts.State.DefinitionID != proof.DefinitionID || facts.State.CredentialID != proof.CredentialID || facts.State.Status != types.ModelStatusActive {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	body, err := modelOriginalBodyHeadInTx(tx, "definition", proof.DefinitionID, proof.OwnerTenantID, d, facts.Definition.DefinitionJSON)
+	if err != nil {
+		return nil, err
+	}
+	if body.Receipt.Digest != proof.DefinitionBodyReceiptDigest {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	body, err = modelOriginalBodyHeadInTx(tx, "credential", proof.CredentialID, proof.OwnerTenantID, c, facts.Credential.CredentialJSON)
+	if err != nil {
+		return nil, err
+	}
+	if body.Receipt.Digest != proof.CredentialBodyReceiptDigest {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	actual, err := modelProofDigest(proof)
+	if err != nil || actual != proof.Digest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return facts, tx.Statement.Context.Err()
+}
+
+// Current controls remain an authority fence, not replacement historical
+// material. Opaque current ciphertext is compared without decrypting secrets.
+func currentHistoricalModelFacts(tx *gorm.DB, id string) (*modelOriginalFacts, error) {
+	var row struct {
+		ID                                                                          string
+		TenantID                                                                    uint64
+		Name, DisplayName, Description, Type, Source, Parameters, Status, ManagedBy string
+		IsBuiltin, IsDefault                                                        bool
+		DeletedAt                                                                   *time.Time
+	}
+	if err := tx.Table("models").Clauses(clause.Locking{Strength: "SHARE"}).Select("id,tenant_id,name,display_name,description,type,source,CAST(parameters AS TEXT) AS parameters,status,managed_by,is_builtin,is_default,deleted_at").Where("id=?", id).Take(&row).Error; err != nil {
+		return nil, err
+	}
+	if row.DeletedAt != nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	control, err := modelControls(tx, id)
+	if err != nil {
+		return nil, err
+	}
+	var definition types.ModelDefinitionOriginal
+	var credential types.ModelCredentialOriginal
+	var state types.ModelStateOriginal
+	for _, query := range []struct {
+		target interface{}
+		column string
+		value  uint64
+	}{{&definition, "revision", control.DefinitionRevision}, {&credential, "revision", control.CredentialRevision}, {&state, "epoch", control.StateEpoch}} {
+		if err = tx.Where("model_id=? AND "+query.column+"=?", id, query.value).Take(query.target).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return nil, ErrModelOriginalUnknown
+			}
+			return nil, err
+		}
+	}
+	var parameters types.ModelParameters
+	if json.Unmarshal([]byte(row.Parameters), &parameters) != nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	cipher, err := json.Marshal(types.ModelOriginalCredentials{APIKey: parameters.APIKey, AppSecret: parameters.AppSecret})
+	if err != nil {
+		return nil, err
+	}
+	model := &types.Model{ID: row.ID, TenantID: row.TenantID, Name: row.Name, DisplayName: row.DisplayName, Description: row.Description, Type: types.ModelType(row.Type), Source: types.ModelSource(row.Source), Parameters: parameters, IsBuiltin: row.IsBuiltin}
+	bytes, err := types.ModelDefinitionBytes(model)
+	if err != nil || string(bytes) != definition.DefinitionJSON || string(cipher) != credential.CredentialJSON || state.Status != types.ModelStatus(row.Status) || state.IsDefault != row.IsDefault || state.ManagedBy != row.ManagedBy {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	defBody, err := modelOriginalBodyHeadInTx(tx, "definition", definition.ID, row.TenantID, definition.Digest, definition.DefinitionJSON)
+	if err != nil {
+		return nil, err
+	}
+	credBody, err := modelOriginalBodyHeadInTx(tx, "credential", credential.ID, row.TenantID, credential.Digest, credential.CredentialJSON)
+	if err != nil {
+		return nil, err
+	}
+	proof := types.ModelOriginalProof{ModelID: id, OwnerTenantID: row.TenantID, IsBuiltin: row.IsBuiltin, DefinitionID: definition.ID, DefinitionDigest: definition.Digest, DefinitionBodyReceiptDigest: defBody.Receipt.Digest, DefinitionRevision: control.DefinitionRevision, CredentialID: credential.ID, CredentialDigest: credential.Digest, CredentialBodyReceiptDigest: credBody.Receipt.Digest, CredentialRevision: control.CredentialRevision, StateID: state.ID, StateDigest: state.Digest, StateEpoch: control.StateEpoch}
+	proof.Digest, err = modelProofDigest(proof)
+	if err != nil {
+		return nil, err
+	}
+	// Non-active metadata controls don't retire historical results. Deletion
+	// does; all original active execution facts still require active state.
+	facts := &modelOriginalFacts{Definition: definition, Credential: credential, State: state, Proof: proof}
+	d, err := modelDefinitionFactDigest(definition)
+	if err != nil || d != definition.Digest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	c, err := modelCredentialFactDigest(credential)
+	if err != nil || c != credential.Digest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	s, err := modelStateFactDigest(state)
+	if err != nil || s != state.Digest || state.DefinitionID != definition.ID || state.CredentialID != credential.ID {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return facts, nil
+}
+func historicalModelDescends(tx *gorm.DB, current, original *modelOriginalFacts) error {
+	if current.Proof.ModelID != original.Proof.ModelID || current.Proof.OwnerTenantID != original.Proof.OwnerTenantID || current.Proof.IsBuiltin != original.Proof.IsBuiltin {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	def := current.Definition
+	for n := 0; def.ID != original.Definition.ID; n++ {
+		if n >= 256 || def.PreviousID == "" || def.Revision <= original.Definition.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var parent types.ModelDefinitionOriginal
+		if err := tx.Where("id=? AND model_id=? AND tenant_id=?", def.PreviousID, def.ModelID, def.TenantID).Take(&parent).Error; err != nil {
+			return err
+		}
+		digest, err := modelDefinitionFactDigest(parent)
+		if err != nil || digest != parent.Digest || digest != def.PreviousDigest || parent.Revision >= def.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if _, err = modelOriginalBodyHeadInTx(tx, "definition", parent.ID, parent.TenantID, parent.Digest, parent.DefinitionJSON); err != nil {
+			return err
+		}
+		def = parent
+	}
+	if def.Digest != original.Definition.Digest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	cred := current.Credential
+	for n := 0; cred.ID != original.Credential.ID; n++ {
+		if n >= 256 || cred.PreviousID == "" || cred.Revision <= original.Credential.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var parent types.ModelCredentialOriginal
+		if err := tx.Where("id=? AND model_id=? AND tenant_id=?", cred.PreviousID, cred.ModelID, cred.TenantID).Take(&parent).Error; err != nil {
+			return err
+		}
+		digest, err := modelCredentialFactDigest(parent)
+		if err != nil || digest != parent.Digest || digest != cred.PreviousDigest || parent.Revision >= cred.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if _, err = modelOriginalBodyHeadInTx(tx, "credential", parent.ID, parent.TenantID, parent.Digest, parent.CredentialJSON); err != nil {
+			return err
+		}
+		cred = parent
+	}
+	if cred.Digest != original.Credential.Digest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return tx.Statement.Context.Err()
+}
+
+func CheckHistoricalModelOriginalHolds(ctx context.Context, tx *gorm.DB, proof types.ModelOriginalProof) error {
+	holds, ok := ctx.Value(historicalModelHoldKey{}).(map[string]historicalModelHold)
+	hold, found := holds[proof.Digest]
+	if !ok || !found || hold.Hold.Proof != proof || hold.Authorize == nil {
+		return ErrOriginalBodyUnavailable
+	}
+	fresh, err := hold.Authorize(ctx, tx, proof)
+	if err != nil {
+		return err
+	}
+	bound := tx.Session(&gorm.Session{NewDB: true, Context: fresh})
+	original, err := loadHistoricalModelFacts(bound, proof)
+	if err != nil {
+		return err
+	}
+	current, err := currentHistoricalModelFacts(bound, proof.ModelID)
+	if err != nil {
+		return err
+	}
+	if err = historicalModelDescends(bound, current, original); err != nil {
+		return err
+	}
+	checkCtx := context.WithValue(fresh, modelOriginalHoldKey{}, hold.Hold)
+	return checkModelOriginalHoldsInTx(bound.WithContext(checkCtx), proof)
+}
+
+type historicalModelRead struct {
+	db     *gorm.DB
+	ctx    context.Context
+	cancel context.CancelFunc
+	hold   historicalModelHold
+	mu     sync.Mutex
+	failed error
+	closed bool
+}
+
+func (r *modelRepository) BeginHistoricalModelOriginalRead(ctx context.Context, proof types.ModelOriginalProof) (interfaces.HistoricalModelOriginalRead, error) {
+	if r.historicalAuthorizer == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read := &historicalModelRead{db: r.db, hold: historicalModelHold{Authorize: r.historicalAuthorizer, Hold: modelOriginalHold{Proof: proof, Leases: map[string]originalBodyLease{}}}}
+	read.ctx, read.cancel = context.WithCancel(ctx)
+	err := r.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		fresh, err := r.historicalAuthorizer(read.ctx, tx, proof)
+		if err != nil {
+			return err
+		}
+		bound := tx.WithContext(fresh)
+		facts, err := loadHistoricalModelFacts(bound, proof)
+		if err != nil {
+			return err
+		}
+		current, err := currentHistoricalModelFacts(bound, proof.ModelID)
+		if err != nil {
+			return err
+		}
+		if err = historicalModelDescends(bound, current, facts); err != nil {
+			return err
+		}
+		owner := "historical-model-read/" + uuid.NewString()
+		retention := NewOriginalBodyRetentionStore(bound)
+		for _, item := range []struct{ kind, id, digest, body string }{{"definition", facts.Definition.ID, facts.Definition.Digest, facts.Definition.DefinitionJSON}, {"credential", facts.Credential.ID, facts.Credential.Digest, facts.Credential.CredentialJSON}} {
+			body, err := modelOriginalBodyHeadInTx(bound, item.kind, item.id, proof.OwnerTenantID, item.digest, item.body)
+			if err != nil {
+				return err
+			}
+			id, err := retention.acquireLeaseInTx(bound, body.Head.BodyID, "read", owner, 15*time.Minute)
+			if err != nil {
+				return err
+			}
+			var lease originalBodyLease
+			if err = bodyInternal(bound).Where("lease_id=?", id).Take(&lease).Error; err != nil {
+				return err
+			}
+			read.hold.Hold.Bodies = append(read.hold.Hold.Bodies, body)
+			read.hold.Hold.Leases[body.Head.BodyID] = lease
+		}
+		return ctx.Err()
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		read.cancel()
+		return nil, err
+	}
+	mapCopy := map[string]historicalModelHold{}
+	if previous, ok := ctx.Value(historicalModelHoldKey{}).(map[string]historicalModelHold); ok {
+		for key, value := range previous {
+			mapCopy[key] = value
+		}
+	}
+	mapCopy[proof.Digest] = read.hold
+	read.ctx = context.WithValue(read.ctx, historicalModelHoldKey{}, mapCopy)
+	if err = read.Recheck(); err != nil {
+		read.Close()
+		return nil, err
+	}
+	return read, nil
+}
+func (r *historicalModelRead) Context() context.Context { return r.ctx }
+func (r *historicalModelRead) Recheck() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.failed != nil {
+		return r.failed
+	}
+	if r.closed {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	err := r.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error { return CheckHistoricalModelOriginalHolds(r.ctx, tx, r.hold.Hold.Proof) }, memoryWriteOptions(r.db))
+	if err != nil {
+		r.failed = err
+		r.cancel()
+	}
+	return err
+}
+func (r *historicalModelRead) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return r.failed
+	}
+	r.closed = true
+	r.cancel()
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	store := NewOriginalBodyRetentionStore(r.db)
+	var first error
+	for _, lease := range r.hold.Hold.Leases {
+		if err := store.ReleaseLease(ctx, lease.LeaseID); err != nil && first == nil {
+			first = err
+		}
+	}
+	if first != nil && r.failed == nil {
+		r.failed = first
+	}
+	return first
+}
diff --git a/internal/application/repository/model_original_lease_ids.go b/internal/application/repository/model_original_lease_ids.go
new file mode 100644
index 00000000..bd1b6bfb
--- /dev/null
+++ b/internal/application/repository/model_original_lease_ids.go
@@ -0,0 +1,112 @@
+package repository
+
+import (
+	"context"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// Metadata from actual acquired lifetime holds only. This does not reauthorize
+// a model, refresh a lease, select current facts, or grant new execution. Callers
+// first run the complete model/body/source checks; their final owned transaction
+// must re-read every returned lease and compare the final actual SQL clock.
+func ModelOriginalLeaseIDs(ctx context.Context) ([]string, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	ids := map[string]bool{}
+	found := false
+	if read, ok := ctx.Value(modelOriginalSnapshotKey{}).(*modelOriginalRead); ok {
+		if read == nil || !sameModelOriginalHolder(ctx, read.hold.Proof.ModelID) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		if err := read.startCheck(); err != nil {
+			return nil, err
+		}
+		captured, err := capturedModelOriginalLeaseIDs(read.hold)
+		err = read.finishCheck(err)
+		if err != nil {
+			return nil, err
+		}
+		for _, id := range captured {
+			ids[id] = true
+		}
+		found = true
+	}
+	if holds, ok := ctx.Value(historicalModelHoldKey{}).(map[string]historicalModelHold); ok {
+		if len(holds) == 0 {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		for digest, hold := range holds {
+			if digest != hold.Hold.Proof.Digest || hold.Authorize == nil {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			captured, err := capturedModelOriginalLeaseIDs(hold.Hold)
+			if err != nil {
+				return nil, err
+			}
+			for _, id := range captured {
+				ids[id] = true
+			}
+		}
+		found = true
+	}
+	if !found || len(ids) == 0 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	result := []string{}
+	for id := range ids {
+		result = append(result, id)
+	}
+	sort.Strings(result)
+	return result, ctx.Err()
+}
+func sameModelOriginalHolder(ctx context.Context, id string) bool {
+	read, ok := OriginalModelReadFromContext(ctx, id)
+	if !ok || read == nil {
+		return false
+	}
+	left, right := types.CallerFromContext(ctx), types.CallerFromContext(read.Context())
+	if left.TenantID != right.TenantID || left.UserID != right.UserID {
+		return false
+	}
+	p, pok := types.PrincipalFromContext(ctx)
+	q, qok := types.PrincipalFromContext(read.Context())
+	if !pok || !qok || p != q {
+		return false
+	}
+	x, xok := types.TenantAPIKeyScopeFromContext(ctx)
+	y, yok := types.TenantAPIKeyScopeFromContext(read.Context())
+	return xok == yok && (!xok || x.KeyID == y.KeyID)
+}
+func capturedModelOriginalLeaseIDs(hold modelOriginalHold) ([]string, error) {
+	if !hold.Proof.Valid() || len(hold.Bodies) != 2 || len(hold.Leases) != 2 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	seenBodies := map[string]bool{}
+	seenLeases := map[string]bool{}
+	seenKinds := map[string]bool{}
+	result := []string{}
+	for _, body := range hold.Bodies {
+		receipt := body.Receipt
+		origin, digest, receiptDigest := "", "", ""
+		switch receipt.OriginKind {
+		case "definition":
+			origin, digest, receiptDigest = hold.Proof.DefinitionID, hold.Proof.DefinitionDigest, hold.Proof.DefinitionBodyReceiptDigest
+		case "credential":
+			origin, digest, receiptDigest = hold.Proof.CredentialID, hold.Proof.CredentialDigest, hold.Proof.CredentialBodyReceiptDigest
+		default:
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		lease, ok := hold.Leases[body.Head.BodyID]
+		if !ok || receipt.OriginID != origin || receipt.OriginDigest != digest || receipt.Digest != receiptDigest || receipt.TenantID != hold.Proof.OwnerTenantID || receipt.BodyID != body.Head.BodyID || receipt.SlotID != body.Head.SlotID || receipt.HeadRevision != body.Head.Revision || lease.BodyID != body.Head.BodyID || lease.Kind != "read" || lease.OwnerID == "" || lease.LeaseID == "" || seenBodies[lease.BodyID] || seenLeases[lease.LeaseID] || seenKinds[receipt.OriginKind] {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		seenBodies[lease.BodyID] = true
+		seenLeases[lease.LeaseID] = true
+		seenKinds[receipt.OriginKind] = true
+		result = append(result, lease.LeaseID)
+	}
+	return result, nil
+}
