+-- Append to reserved75. Legacy rows receive controls only, never originals.
+CREATE TABLE memory_policy_control_versions (tenant_id INTEGER PRIMARY KEY,revision INTEGER NOT NULL CHECK(revision>0));
+INSERT INTO memory_policy_control_versions SELECT id,1 FROM tenants;
+CREATE TABLE memory_policy_originals (
+ id TEXT PRIMARY KEY,tenant_id INTEGER NOT NULL,revision INTEGER NOT NULL CHECK(revision>0),
+ policy_json TEXT NOT NULL,policy_digest TEXT NOT NULL CHECK(length(policy_digest)=64),
+ previous_origin_id TEXT NOT NULL DEFAULT '',previous_origin_digest TEXT NOT NULL DEFAULT '',
+ author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at DATETIME NOT NULL,
+ UNIQUE(tenant_id,revision),CHECK((previous_origin_id='' AND previous_origin_digest='') OR (previous_origin_id<>'' AND length(previous_origin_digest)=64))
+);
+CREATE TRIGGER memory_policy_version_no_delete BEFORE DELETE ON memory_policy_control_versions BEGIN SELECT RAISE(ABORT,'memory policy controls are retained'); END;
+CREATE TRIGGER memory_policy_version_no_replace BEFORE INSERT ON memory_policy_control_versions WHEN EXISTS(SELECT 1 FROM memory_policy_control_versions WHERE tenant_id=NEW.tenant_id) BEGIN SELECT RAISE(ABORT,'memory policy controls cannot be replaced'); END;
+CREATE TRIGGER memory_policy_version_guard BEFORE UPDATE ON memory_policy_control_versions
+ WHEN NEW.tenant_id IS NOT OLD.tenant_id OR NEW.revision<>OLD.revision+1 BEGIN SELECT RAISE(ABORT,'memory policy revision must advance'); END;
+CREATE TRIGGER memory_policy_tenant_insert AFTER INSERT ON tenants BEGIN
+ UPDATE memory_policy_control_versions SET revision=revision+1 WHERE tenant_id=NEW.id;
+ INSERT INTO memory_policy_control_versions(tenant_id,revision) SELECT NEW.id,1 WHERE NOT EXISTS(SELECT 1 FROM memory_policy_control_versions WHERE tenant_id=NEW.id);
+END;
+CREATE TRIGGER memory_policy_tenant_update AFTER UPDATE OF id,memory_config,deleted_at ON tenants
+ WHEN OLD.id IS NOT NEW.id OR OLD.memory_config IS NOT NEW.memory_config OR OLD.deleted_at IS NOT NEW.deleted_at BEGIN
+ UPDATE memory_policy_control_versions SET revision=revision+1 WHERE tenant_id=OLD.id AND OLD.id IS NOT NEW.id;
+ INSERT INTO memory_policy_control_versions(tenant_id,revision) SELECT OLD.id,1 WHERE OLD.id IS NOT NEW.id AND NOT EXISTS(SELECT 1 FROM memory_policy_control_versions WHERE tenant_id=OLD.id);
+ UPDATE memory_policy_control_versions SET revision=revision+1 WHERE tenant_id=NEW.id;
+ INSERT INTO memory_policy_control_versions(tenant_id,revision) SELECT NEW.id,1 WHERE NOT EXISTS(SELECT 1 FROM memory_policy_control_versions WHERE tenant_id=NEW.id);
+END;
+CREATE TRIGGER memory_policy_tenant_delete AFTER DELETE ON tenants BEGIN
+ UPDATE memory_policy_control_versions SET revision=revision+1 WHERE tenant_id=OLD.id;
+ INSERT INTO memory_policy_control_versions(tenant_id,revision) SELECT OLD.id,1 WHERE NOT EXISTS(SELECT 1 FROM memory_policy_control_versions WHERE tenant_id=OLD.id);
+END;
+CREATE TRIGGER memory_policy_original_no_update BEFORE UPDATE ON memory_policy_originals BEGIN SELECT RAISE(ABORT,'memory policy originals are immutable'); END;
+CREATE TRIGGER memory_policy_original_no_replace BEFORE INSERT ON memory_policy_originals WHEN EXISTS(SELECT 1 FROM memory_policy_originals WHERE id=NEW.id OR (tenant_id=NEW.tenant_id AND revision=NEW.revision)) BEGIN SELECT RAISE(ABORT,'memory policy originals cannot be replaced'); END;
+CREATE TRIGGER memory_policy_original_no_delete BEFORE DELETE ON memory_policy_originals BEGIN SELECT RAISE(ABORT,'memory policy originals are immutable'); END;
+CREATE TABLE memory_policy_body_receipts (
+ origin_id TEXT PRIMARY KEY REFERENCES memory_policy_originals(id),origin_digest TEXT NOT NULL,tenant_id INTEGER NOT NULL,
+ slot_id TEXT NOT NULL,body_id TEXT NOT NULL REFERENCES original_body_payloads(id),head_revision INTEGER NOT NULL CHECK(head_revision>0),
+ source_identity_sha256 TEXT NOT NULL,policy_digest TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at DATETIME NOT NULL
+);
+CREATE TRIGGER memory_policy_body_receipt_no_update BEFORE UPDATE ON memory_policy_body_receipts BEGIN SELECT RAISE(ABORT,'memory policy body receipts are immutable'); END;
+CREATE TRIGGER memory_policy_body_receipt_no_delete BEFORE DELETE ON memory_policy_body_receipts BEGIN SELECT RAISE(ABORT,'memory policy body receipts are immutable'); END;
+CREATE TRIGGER memory_policy_body_receipt_no_replace BEFORE INSERT ON memory_policy_body_receipts WHEN EXISTS(SELECT 1 FROM memory_policy_body_receipts WHERE origin_id=NEW.origin_id) BEGIN SELECT RAISE(ABORT,'memory policy body receipts cannot be replaced'); END;
+ALTER TABLE memory_original_executions ADD COLUMN policy_origin_id TEXT NOT NULL DEFAULT '';
+ALTER TABLE memory_original_executions ADD COLUMN policy_revision INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE memory_original_executions ADD COLUMN policy_origin_digest TEXT NOT NULL DEFAULT '';
+ALTER TABLE memory_original_executions ADD COLUMN policy_body_receipt_digest TEXT NOT NULL DEFAULT '';
