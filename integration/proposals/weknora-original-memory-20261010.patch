+package service
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	memoryservice "github.com/Tencent/WeKnora/internal/application/service/memory"
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+)
+
+type memoryPrivacyTransport struct {
+	inner  chat.Chat
+	marked []bool
+}
+
+func (m *memoryPrivacyTransport) Chat(ctx context.Context, messages []chat.Message, options *chat.ChatOptions) (*types.ChatResponse, error) {
+	m.marked = append(m.marked, logprivacy.ContentSuppressed(ctx))
+	return m.inner.Chat(ctx, messages, options)
+}
+func (m *memoryPrivacyTransport) ChatStream(ctx context.Context, messages []chat.Message, options *chat.ChatOptions) (<-chan types.StreamResponse, error) {
+	return m.inner.ChatStream(ctx, messages, options)
+}
+func (m *memoryPrivacyTransport) GetModelName() string { return m.inner.GetModelName() }
+func (m *memoryPrivacyTransport) GetModelID() string   { return m.inner.GetModelID() }
+
+type memoryPrivacyModels struct {
+	memAtomicSQLModels
+	transport *memoryPrivacyTransport
+}
+
+func (m memoryPrivacyModels) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	// Preserve the existing genuine held-original production constructor.
+	if _, err := m.memAtomicSQLModels.GetChatModel(ctx, id); err != nil {
+		return nil, err
+	}
+	return m.transport, nil
+}
+
+// Genuine SQL authoring, admission, actual outbox relay and worker execution
+// prove that the initially unmarked queue context inherits telemetry privacy
+// after acquiring real original/derived reads. The bounded transport observes
+// that context; it does not provide source, actor or body authority.
+func runMemoryWorkerContentPrivacyActual(t *testing.T, pg bool) {
+	for _, mode := range []string{"legal_owned_worker", "raw_original_changed_after_queue"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, producer, _, _ := actualOriginalModelServices(t, f)
+			transport := &memoryPrivacyTransport{inner: f.model}
+			models := memoryPrivacyModels{memAtomicSQLModels: memAtomicSQLModels{actualMemoryModels: actualMemoryModels{model: f.model.actualMemoryModel, db: f.db, originals: producer.(interfaces.ModelOriginalLifetimeReader)}, actual: f.model}, transport: transport}
+			tenant := repository.NewTenantRepository(f.db)
+			ConfigureTenantMemoryPolicyAuthority(tenant, f.machine.f.store, NewGroupAccessService(repository.NewGroupAccessRepository(f.db)), nil)
+			f.service = memoryservice.NewOriginalBoundMemoryService(f.repo, tenant, repository.NewMessageRepository(f.db), models, f.queue, nil, f.reader, f.admissions)
+			memoryservice.ConfigureOriginalMemoryOutbox(f.service, f.outbox)
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			if mode == "raw_original_changed_after_queue" {
+				require.NoError(t, f.db.Exec("UPDATE messages SET content=? WHERE id=?", actualMemoryUnadmittedText, f.user.ID).Error)
+			}
+			worker := context.Background()
+			require.False(t, logprivacy.ContentSuppressed(worker))
+			err := f.service.Handle(worker, f.queue.task)
+			if mode == "legal_owned_worker" {
+				require.NoError(t, err)
+				require.Equal(t, []bool{true}, transport.marked)
+				require.Equal(t, 1, f.model.calls)
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+				var payload types.MemoryExtractPayload
+				require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &payload))
+				completed, err := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payload)
+				require.NoError(t, err)
+				require.True(t, completed)
+				require.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+			} else {
+				require.Error(t, err)
+				require.Empty(t, transport.marked, "privacy must not admit changed original input")
+				require.Zero(t, f.model.calls)
+				assertMemAtomicSQLNoEffects(t, f, before)
+			}
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+
+func TestMemoryWorkerContentPrivacyActualSQLite(t *testing.T) {
+	runMemoryWorkerContentPrivacyActual(t, false)
+}
+func TestPostgresMemoryWorkerContentPrivacyActual(t *testing.T) {
+	runMemoryWorkerContentPrivacyActual(t, true)
+}
