+				case <-joined:
+				case <-time.After(3 * time.Second):
+					t.Fatal("actual model HTTP provider did not join")
+				}
+				require.Equal(t, 1, calls)
+			}
+			entries, err := os.ReadDir(dir)
+			require.NoError(t, err)
+			require.Empty(t, entries)
+			require.NotContains(t, logs.String(), "PROVED_PRIVATE_INPUT")
+			require.NotContains(t, logs.String(), "PROVED_PRIVATE_OUTPUT")
+			var held int64
+			require.NoError(t, f.db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&held).Error)
+			require.Zero(t, held)
+		})
+	}
