@@ -0,0 +1,87 @@
+package service
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// ConfigureMemoryOriginalAtomicAuthority is used by production DI and real
+// SQL fixtures. Every repository/permission reader is bound to the same tx.
+func ConfigureMemoryOriginalAtomicAuthority(admissions interfaces.MemoryOriginalAdmissionRepository, material *repository.KnowledgeInputProvenanceStore, groups interfaces.GroupAccessService, directoryRuntime interfaces.DirectoryRuntimeService) {
+	repository.ConfigureMemoryGeneratedModelOriginals(admissions, func(db *gorm.DB) interfaces.ModelRepository {
+		models := repository.NewModelRepository(db)
+		ConfigureModelOriginalAuthority(models, material, groups, directoryRuntime)
+		return models
+	})
+	repository.ConfigureMemoryOriginalCurrentModels(admissions, func(db *gorm.DB) interfaces.ModelRepository {
+		models := repository.NewModelRepository(db)
+		ConfigureModelOriginalAuthority(models, material, groups, directoryRuntime)
+		return models
+	})
+	repository.ConfigureMemoryDerivedModelOriginals(admissions, func(db *gorm.DB) interfaces.ModelRepository {
+		models := repository.NewModelRepository(db)
+		ConfigureModelOriginalAuthority(models, material, groups, directoryRuntime)
+		return models
+	})
+	repository.ConfigureMemoryOriginalTransactionAuthority(admissions, func(tx *gorm.DB) *repository.MemoryOriginalTransactionAuthority {
+		boundGroups := NewGroupAccessService(repository.NewGroupAccessRepository(tx))
+		var statusReader directoryStatusReader = directoryRuntime
+		if original, ok := groups.(*groupAccessService); ok && directoryRuntime == nil {
+			statusReader = original.directoryRuntime
+		}
+		boundStatus, statusErr := newMemoryDirectoryStatusReader(statusReader, tx)
+		if statusErr != nil {
+			return nil
+		}
+		configureGroupAccessDirectoryStatus(boundGroups, boundStatus)
+		knowledge := repository.NewKnowledgeRepository(tx)
+		kbs := repository.NewKnowledgeBaseRepository(tx)
+		sources := repository.NewDataSourceRepository(tx)
+		shares := NewKBShareService(repository.NewKBShareRepository(tx), repository.NewOrganizationRepository(tx), kbs, knowledge, sources, repository.NewChunkRepository(tx), nil)
+		agents := NewAgentShareService(repository.NewAgentShareRepository(tx), repository.NewTenantDisabledSharedAgentRepository(tx), repository.NewOrganizationRepository(tx), repository.NewCustomAgentRepository(tx), repository.NewUserRepository(tx), repository.NewWebSearchProviderRepository(tx), kbs, knowledge, sources)
+		store := repository.MemoryOriginalTransactionStore(material, tx)
+		if store == nil {
+			return nil
+		}
+		repository.ConfigureKnowledgeInputActorGroupAccess(store, boundGroups)
+		repository.ConfigureKnowledgeInputActorShares(store, shares)
+		repository.ConfigureMessageMaterialAgentShares(store, agents)
+		repository.ConfigureKnowledgeCurrentReadActor(knowledge, store)
+		publication := access.NewNextcloudPublicationGuard(repository.NewDirectoryRepository(tx), sources)
+		snapshots, ok := knowledge.(access.NextcloudLineageSnapshotLookup)
+		if !ok {
+			return nil
+		}
+		boundKBService := &knowledgeBaseService{repo: kbs}
+		guard := access.NewNextcloudSourceLineageGuard(snapshots, boundKBService, shares, agents, boundGroups, publication, store)
+		checkRuntime := func(ctx context.Context) error {
+			// The existing group flag helper treats status errors as enabled.
+			// Refuse configuration/status failures explicitly before source reads.
+			if boundStatus != nil {
+				health, err := boundStatus.GetStatus(ctx)
+				if err != nil {
+					return err
+				}
+				if health == nil {
+					return types.ErrMemoryOriginalUnavailable
+				}
+			}
+			return ctx.Err()
+		}
+		return &repository.MemoryOriginalTransactionAuthority{Store: store, CheckRuntime: checkRuntime, CheckSource: func(ctx context.Context, plan *types.MessageMaterialReadPlan) error {
+			if err := checkRuntime(ctx); err != nil {
+				return err
+			}
+			var targets types.SearchTargets
+			for _, scope := range plan.Scopes {
+				targets = append(targets, &types.SearchTarget{Type: types.SearchTargetTypeKnowledgeBase, TenantID: scope.TenantID, KnowledgeBaseID: scope.KBID})
+			}
+			return guard.Check(ctx, plan.SourceLineage, access.LineageReadScope{Targets: targets})
+		}}
+	})
+}
