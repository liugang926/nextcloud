+package router
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/hibiken/asynq"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSyncTaskExecutorStopCancelsScheduledWorkAndRejectsNewTasks(t *testing.T) {
+	executor := NewSyncTaskExecutor()
+	t.Cleanup(executor.Stop)
+	var calls atomic.Int64
+	executor.RegisterHandler("lifecycle:scheduled", func(context.Context, *asynq.Task) error { calls.Add(1); return nil })
+	_, err := executor.Enqueue(asynq.NewTask("lifecycle:scheduled", nil), asynq.ProcessIn(time.Hour))
+	require.NoError(t, err)
+	joined := make(chan struct{})
+	go func() { executor.Stop(); close(joined) }()
+	select {
+	case <-joined:
+	case <-time.After(time.Second):
+		t.Fatal("scheduled worker did not cancel and join")
+	}
+	require.Zero(t, calls.Load())
+	_, err = executor.Enqueue(asynq.NewTask("lifecycle:scheduled", nil))
+	require.ErrorIs(t, err, ErrSyncTaskExecutorStopped)
+	_, err = executor.EnqueueContext(context.Background(), asynq.NewTask("lifecycle:scheduled", nil))
+	require.ErrorIs(t, err, ErrSyncTaskExecutorStopped)
+	executor.Stop()
+}
+
+func TestSyncTaskExecutorStopWaitsForActualHandlerCleanup(t *testing.T) {
+	executor := NewSyncTaskExecutor()
+	entered, cancelled, releaseCleanup := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	cleanupFinished := make(chan struct{})
+	var releaseOnce sync.Once
+	release := func() { releaseOnce.Do(func() { close(releaseCleanup) }) }
+	t.Cleanup(func() { release(); executor.Stop() })
+	executor.RegisterHandler("lifecycle:active", func(ctx context.Context, _ *asynq.Task) error {
+		close(entered)
+		<-ctx.Done()
+		close(cancelled)
+		<-releaseCleanup
+		close(cleanupFinished)
+		return ctx.Err()
+	})
+	_, err := executor.Enqueue(asynq.NewTask("lifecycle:active", nil))
+	require.NoError(t, err)
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("handler did not enter")
+	}
+	joined := make(chan struct{})
+	go func() { executor.Stop(); close(joined) }()
+	select {
+	case <-cancelled:
+	case <-time.After(time.Second):
+		t.Fatal("handler did not observe executor cancellation")
+	}
+	select {
+	case <-joined:
+		t.Fatal("Stop reported joined before handler cleanup")
+	default:
+	}
+	release()
+	select {
+	case <-joined:
+	case <-time.After(time.Second):
+		t.Fatal("handler cleanup was not joined")
+	}
+	select {
+	case <-cleanupFinished:
+	default:
+		t.Fatal("Stop returned before handler cleanup finished")
+	}
+}
+
+func TestSyncTaskExecutorStopCancelsRetryBackoffWithoutAnotherCall(t *testing.T) {
+	executor := NewSyncTaskExecutor()
+	t.Cleanup(executor.Stop)
+	first := make(chan struct{})
+	var calls atomic.Int64
+	executor.RegisterHandler("lifecycle:retry", func(context.Context, *asynq.Task) error {
+		if calls.Add(1) == 1 {
+			close(first)
+		}
+		return errors.New("retryable source boundary failure")
+	})
+	_, err := executor.Enqueue(asynq.NewTask("lifecycle:retry", nil), asynq.MaxRetry(3))
+	require.NoError(t, err)
+	select {
+	case <-first:
+	case <-time.After(time.Second):
+		t.Fatal("first attempt did not execute")
+	}
+	joined := make(chan struct{})
+	go func() { executor.Stop(); close(joined) }()
+	select {
+	case <-joined:
+	case <-time.After(time.Second):
+		t.Fatal("retry backoff did not cancel and join")
+	}
+	require.Equal(t, int64(1), calls.Load())
+}
+
+func TestSyncTaskExecutorAcceptedWorkerOutlivesEnqueueContext(t *testing.T) {
+	executor := NewSyncTaskExecutor()
+	entered, release, result := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	var releaseOnce sync.Once
+	releaseWorker := func() { releaseOnce.Do(func() { close(release) }) }
+	t.Cleanup(func() { releaseWorker(); executor.Stop() })
+	executor.RegisterHandler("lifecycle:accepted", func(ctx context.Context, _ *asynq.Task) error {
+		close(entered)
+		<-release
+		result <- ctx.Err()
+		return ctx.Err()
+	})
+	enqueue, cancel := context.WithCancel(context.Background())
+	_, err := executor.EnqueueContext(enqueue, asynq.NewTask("lifecycle:accepted", nil), asynq.MaxRetry(0))
+	require.NoError(t, err)
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("accepted worker did not execute")
+	}
+	cancel()
+	releaseWorker()
+	select {
+	case err := <-result:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("accepted worker did not finish")
+	}
+	executor.Stop()
+}
+
+func TestSyncTaskExecutorCancelledEnqueueDoesNotCreateWorker(t *testing.T) {
+	executor := NewSyncTaskExecutor()
+	t.Cleanup(executor.Stop)
+	var calls atomic.Int64
+	executor.RegisterHandler("lifecycle:cancelled", func(context.Context, *asynq.Task) error { calls.Add(1); return nil })
+	enqueue, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := executor.EnqueueContext(enqueue, asynq.NewTask("lifecycle:cancelled", nil))
+	require.ErrorIs(t, err, context.Canceled)
+	executor.Stop()
+	require.Zero(t, calls.Load())
+}
diff --git a/internal/tracing/langfuse/span_content_privacy_http_test.go b/internal/tracing/langfuse/span_content_privacy_http_test.go
new file mode 100644
index 00000000..8e8d2f4a
--- /dev/null
+++ b/internal/tracing/langfuse/span_content_privacy_http_test.go
@@ -0,0 +1,139 @@
+package langfuse
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/models/api"
+	"github.com/stretchr/testify/require"
+	collectorpb "go.opentelemetry.io/proto/otlp/collector/trace/v1"
+	tracepb "go.opentelemetry.io/proto/otlp/trace/v1"
+	"google.golang.org/protobuf/proto"
+)
+
+// The genuine OTLP HTTP exporter sends to an owned local endpoint. This checks
+// its actual protobuf payload, including failure events, without credentials
+// for an external service or an in-memory exporter replacing the transport.
+func TestProtectedSpanActualOTLPHTTPPreservesOrdinaryTelemetry(t *testing.T) {
+	for _, child := range []bool{false, true} {
+		for _, marked := range []bool{true, false} {
+			t.Run(fmt.Sprintf("child=%t/protected=%t", child, marked), func(t *testing.T) {
+				payloads := make(chan []byte, 8)
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if r.Method != http.MethodPost || r.URL.Path != "/api/public/otel/v1/traces" {
+						t.Error("unexpected actual OTLP request")
+					}
+					payload, err := io.ReadAll(r.Body)
+					if err != nil {
+						t.Error("actual OTLP payload read failed")
+						return
+					}
+					payloads <- payload
+					w.Header().Set("Content-Type", "application/x-protobuf")
+					w.WriteHeader(http.StatusOK)
+				}))
+				t.Cleanup(server.Close)
+				m, err := Init(Config{Enabled: true, Host: server.URL, PublicKey: "owned-pk", SecretKey: "owned-sk", FlushAt: 1, FlushInterval: time.Second, QueueSize: 32, RequestTimeout: 2 * time.Second, SampleRate: 1})
+				require.NoError(t, err)
+				t.Cleanup(func() {
+					shutdown, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+					defer cancel()
+					_ = m.Shutdown(shutdown)
+				})
+				ctx := context.Background()
+				if marked {
+					ctx = logprivacy.SuppressContent(ctx)
+				}
+				var root *Trace
+				if child {
+					ctx, root = m.StartTrace(ctx, TraceOptions{Name: "owned-parent", UserID: "owned-user", SessionID: "owned-session"})
+				}
+				options := SpanOptions{Name: "owned-content-span", Input: map[string]string{"query": "PRIVATE_SPAN_INPUT"}, Metadata: map[string]interface{}{"request_id": "owned-request"}}
+				var span *Span
+				if child {
+					_, span = m.StartChildSpan(ctx, options)
+				} else {
+					_, span = m.StartSpan(ctx, options)
+				}
+				original := &api.HTTPError{StatusCode: 400, Body: "PRIVATE_SPAN_VENDOR_ERROR"}
+				span.Finish(map[string]string{"preview": "PRIVATE_SPAN_OUTPUT"}, map[string]interface{}{"phase": "owned-recall"}, original)
+				if root != nil {
+					root.Finish(nil, nil)
+				}
+				shutdown, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				require.NoError(t, m.Shutdown(shutdown), "real exporter must finish and join its HTTP transport")
+				close(payloads)
+				var actual *tracepb.Span
+				var wire bytes.Buffer
+				for payload := range payloads {
+					wire.Write(payload)
+					request := &collectorpb.ExportTraceServiceRequest{}
+					require.NoError(t, proto.Unmarshal(payload, request))
+					for _, resource := range request.ResourceSpans {
+						for _, scope := range resource.ScopeSpans {
+							for _, exported := range scope.Spans {
+								// The automatic root trace intentionally shares this name.
+								// Select the actual requested span by its immutable ID; an
+								// invalid type or duplicate of that same ID still fails.
+								if hex.EncodeToString(exported.SpanId) != span.ID {
+									continue
+								}
+								require.Equal(t, options.Name, exported.Name)
+								observationType := ""
+								for _, attribute := range exported.Attributes {
+									if attribute.Key == attrObsType {
+										observationType = attribute.Value.GetStringValue()
+									}
+								}
+								require.Equal(t, obsTypeSpan, observationType)
+								require.Nil(t, actual, "one complete span must export once")
+								actual = exported
+							}
+						}
+					}
+				}
+				require.NotNil(t, actual, "the actual local HTTP collector must receive the span")
+				require.Equal(t, span.ID, hex.EncodeToString(actual.SpanId))
+				require.Len(t, actual.TraceId, 16)
+				require.Len(t, actual.ParentSpanId, 8)
+				if root != nil {
+					require.Equal(t, root.ID, hex.EncodeToString(actual.TraceId))
+					require.Equal(t, root.span.SpanContext().SpanID().String(), hex.EncodeToString(actual.ParentSpanId))
+				}
+				require.Greater(t, actual.StartTimeUnixNano, uint64(0))
+				require.GreaterOrEqual(t, actual.EndTimeUnixNano, actual.StartTimeUnixNano)
+				require.Equal(t, tracepb.Status_STATUS_CODE_ERROR, actual.Status.Code)
+				attributes := map[string]string{}
+				for _, attribute := range actual.Attributes {
+					attributes[attribute.Key] = attribute.Value.GetStringValue()
+				}
+				require.Equal(t, obsTypeSpan, attributes[attrObsType])
+				var metadata map[string]interface{}
+				require.NoError(t, json.Unmarshal([]byte(attributes[attrObsMetadata]), &metadata))
+				require.Equal(t, map[string]interface{}{"request_id": "owned-request", "phase": "owned-recall"}, metadata, "declared metadata is preserved without keyword filtering")
+				require.Equal(t, "PRIVATE_SPAN_VENDOR_ERROR", original.Body, "telemetry must not change the business error")
+				if marked {
+					require.NotContains(t, wire.String(), "PRIVATE_SPAN_")
+					require.NotContains(t, attributes, attrObsInput)
+					require.NotContains(t, attributes, attrObsOutput)
+					require.Contains(t, actual.Status.Message, "content logging suppressed")
+				} else {
+					for _, body := range []string{"PRIVATE_SPAN_INPUT", "PRIVATE_SPAN_OUTPUT", "PRIVATE_SPAN_VENDOR_ERROR"} {
+						require.Contains(t, wire.String(), body)
+					}
+					require.Equal(t, original.Error(), actual.Status.Message)
+				}
+			})
+		}
+	}
+}
