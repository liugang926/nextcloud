+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// SOURCE ONLY additional component negatives. Frozen3ff/c16320cases and all
+// old515/custom/existing-memory functionality remain separate and unchanged.
+// Only a valid native tenant policy field changes via its actual repository.
+// Model ID/status/body originals and the queued immutable input never change.
+func runMemOriginalQueuedPolicySQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"policy_changed_after_queue_zero_calls", "policy_changed_after_model_zero_effects"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			original, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, before.OriginalAdmissionID)
+			require.NoError(t, err)
+			require.Len(t, original.Request.EnqueuePolicyDigest, 64)
+			var originalModel types.Model
+			require.NoError(t, f.db.Where("id=? AND tenant_id=?", f.model.GetModelID(), f.scope.TenantID).Take(&originalModel).Error)
+			modelWire, err := json.Marshal(originalModel)
+			require.NoError(t, err)
+			queuedModelDigest := types.MemoryOriginalBytesDigest(modelWire)
+			require.Equal(t, original.Request.EnqueueModelID, originalModel.ID)
+			require.Equal(t, original.Request.EnqueueModelDigest, queuedModelDigest)
+			faultApplied := false
+			fault := func() error {
+				tenants := repository.NewTenantRepository(f.db)
+				tenant, err := tenants.GetTenantByID(f.ctx, f.scope.TenantID)
+				if err != nil {
+					return err
+				}
+				if tenant.MemoryConfig == nil {
+					return fmt.Errorf("actual native policy is missing")
+				}
+				cfg := *tenant.MemoryConfig
+				cfg.Normalize()
+				cfg.MaxItems = types.DefaultMemoryMaxItems + 1
+				if cfg.ExtractInstructions != "" || cfg.ExtractModelID != f.model.GetModelID() || !cfg.AutoExtractEnabled() {
+					return fmt.Errorf("policy fault changed an unrelated authority selector")
+				}
+				tenant.MemoryConfig = &cfg
+				if err = tenants.UpdateTenant(f.ctx, tenant); err != nil {
+					return err
+				}
+				reread, err := tenants.GetTenantByID(f.ctx, f.scope.TenantID)
+				if err != nil {
+					return err
+				}
+				if reread.MemoryConfig == nil || reread.MemoryConfig.MaxItems != cfg.MaxItems {
+					return fmt.Errorf("actual native policy did not roundtrip")
+				}
+				normalized := *reread.MemoryConfig
+				normalized.Normalize()
+				encoded, err := json.Marshal(&normalized)
+				if err != nil {
+					return err
+				}
+				if types.MemoryOriginalBytesDigest(encoded) == original.Request.EnqueuePolicyDigest {
+					return fmt.Errorf("policy fault did not change the captured policy digest")
+				}
+				faultApplied = true
+				return nil
+			}
+			if mode == "policy_changed_after_model_zero_effects" {
+				f.model.afterCall = fault
+			} else {
+				require.NoError(t, fault())
+			}
+			worker, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			handleErr := f.service.Handle(worker, f.queue.task)
+			cancel()
+			assert.Error(t, handleErr, "a changed queued policy cannot be freshly certified at execution")
+			assert.True(t, faultApplied)
+			expectedCalls := 0
+			if mode == "policy_changed_after_model_zero_effects" {
+				expectedCalls = 1
+			}
+			assert.Equal(t, expectedCalls, f.model.calls)
+			assertMemAtomicSQLNoEffects(t, f, before)
+			assertMemAtomicSQLLeasesClosed(t, f)
+			var actualModel types.Model
+			require.NoError(t, f.db.Where("id=? AND tenant_id=?", originalModel.ID, f.scope.TenantID).Take(&actualModel).Error)
+			afterModelWire, err := json.Marshal(actualModel)
+			require.NoError(t, err)
+			assert.Equal(t, queuedModelDigest, types.MemoryOriginalBytesDigest(afterModelWire), "model metadata is unchanged")
+			var saved types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", original.ID).Take(&saved).Error)
+			assert.Equal(t, original.Digest, saved.Digest)
+			assert.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+		})
+	}
+}
+func TestMemoryOriginalQueuedPolicyActualSQLite(t *testing.T) {
+	runMemOriginalQueuedPolicySQL(t, false)
+}
+func TestPostgresMemoryOriginalQueuedPolicyActual(t *testing.T) {
+	runMemOriginalQueuedPolicySQL(t, true)
+}
