+-- Append to reserved156. Legacy rows receive controls only, never originals.
+CREATE TABLE memory_policy_control_versions (
+ tenant_id BIGINT PRIMARY KEY, revision BIGINT NOT NULL CHECK(revision>0)
+);
+INSERT INTO memory_policy_control_versions SELECT id,1 FROM tenants;
+CREATE TABLE memory_policy_originals (
+ id TEXT PRIMARY KEY, tenant_id BIGINT NOT NULL, revision BIGINT NOT NULL CHECK(revision>0),
+ policy_json TEXT NOT NULL, policy_digest TEXT NOT NULL CHECK(length(policy_digest)=64),
+ previous_origin_id TEXT NOT NULL DEFAULT '', previous_origin_digest TEXT NOT NULL DEFAULT '',
+ author_selector TEXT NOT NULL, digest TEXT NOT NULL CHECK(length(digest)=64), created_at TIMESTAMPTZ NOT NULL,
+ UNIQUE(tenant_id,revision), CHECK((previous_origin_id='' AND previous_origin_digest='') OR (previous_origin_id<>'' AND length(previous_origin_digest)=64))
+);
+CREATE FUNCTION memory_policy_version_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'memory policy controls are retained'; END IF;
+ IF NEW.tenant_id<>OLD.tenant_id OR NEW.revision<>OLD.revision+1 THEN RAISE EXCEPTION 'memory policy revision must advance'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER memory_policy_version_guard BEFORE UPDATE OR DELETE ON memory_policy_control_versions FOR EACH ROW EXECUTE FUNCTION memory_policy_version_guard();
+CREATE FUNCTION memory_policy_bump() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='UPDATE' THEN
+  IF OLD.id=NEW.id AND OLD.memory_config IS NOT DISTINCT FROM NEW.memory_config AND OLD.deleted_at IS NOT DISTINCT FROM NEW.deleted_at THEN RETURN NEW; END IF;
+ END IF;
+ IF TG_OP='DELETE' OR (TG_OP='UPDATE' AND OLD.id<>NEW.id) THEN
+  INSERT INTO memory_policy_control_versions(tenant_id,revision) VALUES(OLD.id,1) ON CONFLICT(tenant_id) DO UPDATE SET revision=memory_policy_control_versions.revision+1;
+ END IF;
+ IF TG_OP<>'DELETE' THEN
+  INSERT INTO memory_policy_control_versions(tenant_id,revision) VALUES(NEW.id,1) ON CONFLICT(tenant_id) DO UPDATE SET revision=memory_policy_control_versions.revision+1;
+  RETURN NEW;
+ END IF;
+ RETURN OLD;
+END $$;
+CREATE TRIGGER memory_policy_tenant_insert AFTER INSERT ON tenants FOR EACH ROW EXECUTE FUNCTION memory_policy_bump();
+CREATE TRIGGER memory_policy_tenant_update AFTER UPDATE OF id,memory_config,deleted_at ON tenants FOR EACH ROW EXECUTE FUNCTION memory_policy_bump();
+CREATE TRIGGER memory_policy_tenant_delete AFTER DELETE ON tenants FOR EACH ROW EXECUTE FUNCTION memory_policy_bump();
+CREATE FUNCTION memory_policy_original_immutable() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'memory policy originals are immutable'; END $$;
+CREATE TRIGGER memory_policy_original_immutable BEFORE UPDATE OR DELETE ON memory_policy_originals FOR EACH ROW EXECUTE FUNCTION memory_policy_original_immutable();
+CREATE TABLE memory_policy_body_receipts (
+ origin_id TEXT PRIMARY KEY REFERENCES memory_policy_originals(id),origin_digest TEXT NOT NULL,tenant_id BIGINT NOT NULL,
+ slot_id TEXT NOT NULL,body_id TEXT NOT NULL REFERENCES original_body_payloads(id),head_revision BIGINT NOT NULL CHECK(head_revision>0),
+ source_identity_sha256 TEXT NOT NULL,policy_digest TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL
+);
+CREATE TRIGGER memory_policy_body_receipt_immutable BEFORE UPDATE OR DELETE ON memory_policy_body_receipts FOR EACH ROW EXECUTE FUNCTION memory_policy_original_immutable();
+ALTER TABLE memory_original_executions ADD COLUMN policy_origin_id TEXT NOT NULL DEFAULT '';
+ALTER TABLE memory_original_executions ADD COLUMN policy_revision BIGINT NOT NULL DEFAULT 0;
+ALTER TABLE memory_original_executions ADD COLUMN policy_origin_digest TEXT NOT NULL DEFAULT '';
+ALTER TABLE memory_original_executions ADD COLUMN policy_body_receipt_digest TEXT NOT NULL DEFAULT '';
