+func (m *memAtomicSQLModel) Chat(ctx context.Context, input []chat.Message, options *chat.ChatOptions) (*types.ChatResponse, error) {
+	result, err := m.actualMemoryModel.Chat(ctx, input, options)
+	if err != nil || !m.twoOperations {
+		return result, err
+	}
+	var value map[string]interface{}
+	if err = json.Unmarshal([]byte(result.Content), &value); err != nil {
+		return nil, err
+	}
+	operations, ok := value["memories"].([]interface{})
+	if !ok || len(operations) != 1 {
+		return nil, fmt.Errorf("whole-result fixture requires one real first operation")
+	}
+	value["memories"] = append(operations, map[string]interface{}{"action": "add", "kind": "fact", "topic": "development workflow", "content": actualMemoryStoredText + " It is used for coding.", "importance": 4, "source": 1})
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	result.Content = string(raw)
+	return result, nil
+}
