+// Returns every actual effect. A model operation may change an old target and
+// create its successor; neither change may disappear from the receipt.
+func memoryOriginalCreateEffectInTx(tx *gorm.DB, input *types.MemoryOriginalInput, commit *types.MemoryOriginalCommit, opID, action, kind, id, parent, role string, object interface{}, capacity *memoryOriginalCapacityDependency) (*types.MemoryOriginalDerivation, error) {
+	bodyDigest, err := KnowledgeInputDigest(object)
+	if item, ok := object.(*types.MemoryItem); ok {
+		bodyDigest, err = memoryItemMaterialDigest(item)
+	}
+	if err != nil {
+		return nil, err
+	}
+	dependency, err := json.Marshal(memoryOriginalEffectDependency{
+		InputID: input.ID, InputDigest: input.Digest, ExecutionID: commit.ExecutionAdmissionID,
+		ExecutionDigest: commit.ExecutionDigest, ModelResultDigest: commit.ModelResultDigest,
+		Recipe: commit.Recipe, Parent: parent, EffectRole: role, Capacity: capacity,
+	})
+	if err != nil {
+		return nil, err
+	}
+	origin := &types.MemoryOriginalDerivation{
+		ID: uuid.NewString(), OperationID: opID, CommitID: commit.ID,
+		InputAdmissionID: input.ID, ExecutionAdmissionID: commit.ExecutionAdmissionID,
+		TenantID: input.Request.TenantID, SubjectID: input.Request.SubjectID,
+		ObjectKind: kind, ObjectID: id, Action: action, BodyDigest: bodyDigest,
+		ParentDerivationID: parent, DependencyJSON: string(dependency), CreatedAt: memoryFactTime(),
+	}
+	origin.Digest, err = memoryDerivationDigest(origin)
+	if err != nil {
+		return nil, err
+	}
+	if err = tx.Create(origin).Error; err != nil {
+		return nil, err
+	}
+	if err = publishMemoryDerivedEffectInTx(tx, input, commit, origin, object); err != nil {
+		return nil, err
+	}
+	return origin, nil
+}
+
+func (r *memoryOriginalAdmissionRepository) applyMemoryOriginalOperation(tx *gorm.DB, input *types.MemoryOriginalInput, commit *types.MemoryOriginalCommit, op types.MemoryOriginalMutation) ([]*types.MemoryOriginalDerivation, error) {
+	if op.ID == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var effects []*types.MemoryOriginalDerivation
+	var object interface{}
+	objectKind, objectID := "", ""
+	switch op.Action {
+	case "add", "update":
+		if op.Item == nil || op.Item.ID != op.ID || op.Item.TenantID != input.Request.TenantID || op.Item.SubjectID != input.Request.SubjectID || !types.IsValidMemoryKind(op.Item.Kind) || types.SanitizeMemoryContent(op.Item.Content) != op.Item.Content || op.Item.Content == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		op.Item.ValidFrom = op.Item.ValidFrom.UTC().Truncate(time.Microsecond)
+		op.Item.ExpiresAt = memoryFactTimePointer(op.Item.ExpiresAt)
+		op.Item.InvalidAt = memoryFactTimePointer(op.Item.InvalidAt)
+		op.Item.CreatedAt = memoryFactTime()
+		op.Item.UpdatedAt = op.Item.CreatedAt
+		if op.Action == "update" {
+			target, err := memoryTargetInTx(tx, input, op)
+			if err != nil {
+				return nil, err
+			}
+			if op.Item.Status == types.MemoryStatusPending {
+				op.Item.ReplacesID = target.ID
+			} else {
+				at := memoryFactTime()
+				result := tx.Model(target).Updates(map[string]interface{}{"status": types.MemoryStatusSuperseded, "invalid_at": at, "superseded_by": op.Item.ID, "updated_at": at})
+				if result.Error != nil {
+					return nil, result.Error
+				}
+				if result.RowsAffected != 1 {
+					return nil, types.ErrMemoryOriginalUnavailable
+				}
+				target.Status = types.MemoryStatusSuperseded
+				target.InvalidAt = &at
+				target.SupersededBy = op.Item.ID
+				target.UpdatedAt = at
+				origin, err := memoryOriginalCreateEffectInTx(tx, input, commit, op.ID, "supersede", "memory_item", target.ID, op.TargetDerivationID, "model_previous_target", target, nil)
+				if err != nil {
+					return nil, err
+				}
+				effects = append(effects, origin)
+			}
+		}
+		if err := tx.Create(op.Item).Error; err != nil {
+			return nil, err
+		}
+		object, objectKind, objectID = op.Item, "memory_item", op.Item.ID
+	case "delete":
+		target, err := memoryTargetInTx(tx, input, op)
+		if err != nil {
+			return nil, err
+		}
+		at := memoryFactTime()
+		result := tx.Model(target).Updates(map[string]interface{}{"status": types.MemoryStatusSuperseded, "invalid_at": at, "superseded_by": "", "updated_at": at})
+		if result.Error != nil {
+			return nil, result.Error
+		}
+		if result.RowsAffected != 1 {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		target.Status, target.InvalidAt, target.SupersededBy, target.UpdatedAt = types.MemoryStatusSuperseded, &at, "", at
+		object, objectKind, objectID = target, "memory_item", target.ID
+	case "topic":
+		return r.applyMemoryDerivedTopicInTx(tx, input, commit, op)
+	case "tombstone":
+		if op.Fingerprint == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		row := &types.MemoryTombstone{ID: op.ID, TenantID: input.Request.TenantID, SubjectID: input.Request.SubjectID, Topic: op.Topic, Fingerprint: op.Fingerprint, SourceMessageID: op.SourceMessageID, CreatedAt: memoryFactTime()}
+		if err := tx.Create(row).Error; err != nil {
+			return nil, err
+		}
+		object, objectKind, objectID = row, "memory_tombstone", row.ID
+	default:
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	origin, err := memoryOriginalCreateEffectInTx(tx, input, commit, op.ID, op.Action, objectKind, objectID, op.TargetDerivationID, "model_result", object, nil)
+	if err != nil {
+		return nil, err
+	}
+	return append(effects, origin), nil
+}
+
+func applyMemoryOriginalCapacityInTx(tx *gorm.DB, input *types.MemoryOriginalInput, commit *types.MemoryOriginalCommit, scope interfaces.MemoryScope) ([]*types.MemoryOriginalDerivation, error) {
+	var tenant types.Tenant
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", scope.TenantID).Take(&tenant).Error; err != nil {
+		return nil, err
+	}
+	if tenant.MemoryConfig == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	cfg := *tenant.MemoryConfig
+	cfg.Normalize()
+	plan, err := memoryCapacityRetirementsInTx(tx, scope, cfg.MaxItems, commit.ID)
+	if err != nil {
+		return nil, err
+	}
+	var effects []*types.MemoryOriginalDerivation
+	for _, retirement := range plan.Retirements {
+		if retirement.Before == nil || retirement.After == nil || retirement.Parent == nil || retirement.Publication == nil || retirement.TargetID != retirement.Before.ID || retirement.TargetID != retirement.After.ID || retirement.Before.Status != types.MemoryStatusActive || retirement.After.Status != types.MemoryStatusArchived || retirement.Publication.MaterialDigest != retirement.BeforeDigest {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		beforeDigest, err := memoryItemMaterialDigest(retirement.Before)
+		if err != nil || beforeDigest != retirement.BeforeDigest {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		afterDigest, err := memoryItemMaterialDigest(retirement.After)
+		if err != nil || afterDigest != retirement.AfterDigest {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		result := tx.Model(&types.MemoryItem{}).Where("id=? AND tenant_id=? AND subject_id=? AND status=?", retirement.TargetID, scope.TenantID, scope.SubjectID, types.MemoryStatusActive).Updates(map[string]interface{}{"status": types.MemoryStatusArchived, "updated_at": retirement.After.UpdatedAt})
+		if result.Error != nil {
+			return nil, result.Error
+		}
+		if result.RowsAffected != 1 {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		dependency := &memoryOriginalCapacityDependency{Keep: plan.Keep, CurrentCommitID: commit.ID, RankedControls: plan.RankedControls, RankingDigest: plan.RankingDigest, BeforeDigest: retirement.BeforeDigest, AfterDigest: retirement.AfterDigest}
+		// This is an additional producer effect; the parent's model operation is
+		// retained separately even when the newly created item is archived.
+		operationID := retirement.Parent.OperationID
+		if operationID == "" {
+			operationID = uuid.NewString()
+		}
+		origin, err := memoryOriginalCreateEffectInTx(tx, input, commit, operationID, "archive", "memory_item", retirement.TargetID, retirement.Parent.ID, "capacity_retirement", retirement.After, dependency)
+		if err != nil {
+			return nil, err
+		}
+		effects = append(effects, origin)
+	}
+	return effects, tx.Statement.Context.Err()
+}
+
+func (r *memoryOriginalAdmissionRepository) CommitMemoryOriginalResult(ctx context.Context, commit *types.MemoryOriginalCommit) error {
+	if commit == nil || commit.ID == "" || commit.WorkerLeaseID == "" || commit.ModelResultDigest == "" || commit.Recipe != "memory.extract.atomic.v1" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		input, err := loadMemoryOriginal(tx, commit.InputAdmissionID)
+		if err != nil {
+			return err
+		}
+		q := input.Request
+		if input.Digest != commit.InputDigest || commit.Session.OriginalAdmissionID != input.ID || commit.Session.Revision != q.PendingRevision || commit.Session.SessionID != q.SessionID || !sameMemoryCursor(commit.From, commit.Session.Cursor) || commit.To.After(q.UpperCursor) || commit.From.After(commit.To) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if !sameMemoryCursor(commit.From, q.FromCursor) {
+			var prior types.MemoryOriginalCheckpoint
+			if commit.PreviousCheckpointID == "" {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			if err := tx.Where("id=? AND input_admission_id=? AND pending_revision=?", commit.PreviousCheckpointID, input.ID, q.PendingRevision).Take(&prior).Error; err != nil {
+				return err
+			}
+			digest, err := memoryCheckpointDigest(&prior)
+			if err != nil || digest != prior.Digest || !sameMemoryCursor(prior.To, commit.From) || prior.Drained {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		toIsControl := false
+		for _, control := range input.Plan.Controls {
+			if control != nil && control.ID == commit.To.ID && control.CreatedAt.Equal(commit.To.At) {
+				toIsControl = true
+			}
+		}
+		if !toIsControl || commit.Drained && !sameMemoryCursor(commit.To, q.UpperCursor) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		scope := interfaces.MemoryScope{TenantID: q.TenantID, SubjectID: q.SubjectID}
+		var subject types.MemorySubject
+		if err := tx.Clauses(forUpdateClause()).Where("tenant_id=? AND subject_id=?", q.TenantID, q.SubjectID).Take(&subject).Error; err != nil {
+			return err
+		}
+		if !subject.Enabled || !validExtractionLease(&subject, commit.WorkerLeaseID) {
+			return types.ErrMemoryExtractionLeaseLost
+		}
+		progress, err := memoryOriginalProgress(tx.Clauses(forUpdateClause()), scope, q.SessionID)
+		if err != nil {
+			return err
+		}
+		if progress == nil || !progress.Pending || progress.OriginalAdmissionID != input.ID || progress.Revision != q.PendingRevision || !sameMemoryCursor(progress.Cursor, commit.From) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if derived, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold); derived != nil {
+			if err = r.lockMemoryDerivedAuthorityInTx(ctx, tx, derived, input); err != nil {
+				return err
+			}
+		}
+		if err = r.lockMemoryOriginalFence(ctx, tx, input); err != nil {
+			return err
+		}
+		if err = r.checkMemoryOriginalInTx(ctx, tx, input); err != nil {
+			return err
+		}
+		execution, err := loadMemoryExecution(tx, commit.ExecutionAdmissionID, commit.ExecutionDigest)
+		if err != nil {
+			return err
+		}
+		if err = checkMemoryExecutionInTx(tx, input, execution); err != nil {
+			return err
+		}
+		hold, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		if hold == nil || execution.DerivedInputsDigest != hold.Manifest.Digest {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = r.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		seenOperations := map[string]bool{}
+		var expectedEffects []*types.MemoryOriginalDerivation
+		for _, op := range commit.Operations {
+			if op.ID == "" || seenOperations[op.ID] {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			seenOperations[op.ID] = true
+			effects, applyErr := r.applyMemoryOriginalOperation(tx, input, commit, op)
+			if applyErr != nil {
+				return applyErr
+			}
+			expectedEffects = append(expectedEffects, effects...)
+		}
+		capacityEffects, err := applyMemoryOriginalCapacityInTx(tx, input, commit, scope)
+		if err != nil {
+			return err
+		}
+		expectedEffects = append(expectedEffects, capacityEffects...)
+		blockEffect, err := r.publishMemoryWorkerBlockInTx(tx, input, commit, scope)
+		if err != nil {
+			return err
+		}
+		if blockEffect != nil {
+			expectedEffects = append(expectedEffects, blockEffect)
+		}
+		var origins []types.MemoryOriginalDerivation
+		if err := tx.Where("commit_id=?", commit.ID).Order("id").Find(&origins).Error; err != nil {
+			return err
+		}
+		if len(origins) != len(expectedEffects) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		expectedByID := map[string]*types.MemoryOriginalDerivation{}
+		for _, effect := range expectedEffects {
+			if effect == nil || expectedByID[effect.ID] != nil {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			expectedByID[effect.ID] = effect
+		}
+		var manifest []types.MemoryOriginalEffect
+		for _, origin := range origins {
+			expected := expectedByID[origin.ID]
+			actual, hashErr := memoryDerivationDigest(&origin)
+			if expected == nil || hashErr != nil || actual != origin.Digest || origin.Digest != expected.Digest {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			manifest = append(manifest, types.MemoryOriginalEffect{OperationID: origin.OperationID, DerivationID: origin.ID, ObjectKind: origin.ObjectKind, ObjectID: origin.ObjectID, Action: origin.Action, BodyDigest: origin.BodyDigest, ParentDerivationID: origin.ParentDerivationID})
+		}
+		operationsDigest, err := KnowledgeInputDigest(manifest)
+		if err != nil {
+			return err
+		}
+		encodedManifest, err := json.Marshal(manifest)
+		if err != nil {
+			return err
+		}
+		receipt := &types.MemoryOriginalCheckpoint{ID: commit.ID, TenantID: q.TenantID, SubjectID: q.SubjectID, SessionID: q.SessionID, InputAdmissionID: input.ID, InputDigest: input.Digest, PreviousCheckpointID: commit.PreviousCheckpointID, ExecutionAdmissionID: execution.ID, PendingRevision: q.PendingRevision, From: commit.From, To: commit.To, Drained: commit.Drained, ModelResultDigest: commit.ModelResultDigest, OperationsDigest: operationsDigest, OperationManifest: string(encodedManifest), Recipe: commit.Recipe, CreatedAt: memoryFactTime()}
+		receipt.Digest, err = memoryCheckpointDigest(receipt)
+		if err != nil {
+			return err
+		}
+		if err = tx.Create(receipt).Error; err != nil {
+			return err
+		}
+		result := extractionRows(tx, scope).Where("session_id=? AND revision=? AND original_admission_id=? AND pending=?", q.SessionID, q.PendingRevision, input.ID, true).Updates(map[string]interface{}{"cursor_at": commit.To.At, "cursor_id": commit.To.ID, "pending": !commit.Drained, "original_checkpoint_id": commit.ID, "updated_at": time.Now()})
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected != 1 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = r.checkMemoryDerivedHoldInTx(tx, hold, commit.ID); err != nil {
+			return err
+		}
+		// Final original/source/body/model/actor check is still inside the
+		// same connection and transaction: refusal rolls back every effect.
+		if err = r.checkMemoryOriginalInTx(ctx, tx, input); err != nil {
+			return err
+		}
+		if err = checkMemoryExecutionInTx(tx, input, execution); err != nil {
+			return err
+		}
+		if derived, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold); derived != nil {
+			if err = r.lockMemoryDerivedAuthorityInTx(ctx, tx, derived, input); err != nil {
+				return err
+			}
+		}
+		if err = r.lockMemoryOriginalFence(ctx, tx, input); err != nil {
+			return err
+		}
+		if !validExtractionLease(&subject, commit.WorkerLeaseID) {
+			return types.ErrMemoryExtractionLeaseLost
+		}
+		if err = checkMemoryWorkerFinalClockInTx(ctx, tx); err != nil {
+			return err
+		}
+		return ctx.Err()
+	}, memoryWriteOptions(r.db))
+}
diff --git a/internal/application/repository/memory_original_fence.go b/internal/application/repository/memory_original_fence.go
new file mode 100644
index 00000000..6363ad88
--- /dev/null
+++ b/internal/application/repository/memory_original_fence.go
@@ -0,0 +1,383 @@
+package repository
+
+import (
+	"context"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// All authority adapters must use this exact transaction connection. A
+// public collectionTransaction wrapper would reject nesting; opening another
+// connection would also lose the fence and may self-deadlock on held leases.
+type MemoryOriginalTransactionAuthority struct {
+	Store        *KnowledgeInputProvenanceStore
+	CheckRuntime func(context.Context) error
+	CheckSource  func(context.Context, *types.MessageMaterialReadPlan) error
+}
+type MemoryOriginalTransactionAuthorityFactory func(*gorm.DB) *MemoryOriginalTransactionAuthority
+
+func MemoryOriginalTransactionStore(original *KnowledgeInputProvenanceStore, tx *gorm.DB) *KnowledgeInputProvenanceStore {
+	if original == nil {
+		return nil
+	}
+	bound := *original
+	bound.db = tx
+	return &bound
+}
+
+func ConfigureMemoryOriginalTransactionAuthority(repo interfaces.MemoryOriginalAdmissionRepository, factory MemoryOriginalTransactionAuthorityFactory) {
+	if actual, ok := repo.(*memoryOriginalAdmissionRepository); ok {
+		actual.authorityFactory = factory
+	}
+}
+
+type memoryOriginalBodyHoldKey struct{}
+type memoryOriginalBodyHold struct {
+	IDs      []string
+	Bindings map[string]originalBodyLease
+}
+
+func WithMemoryOriginalBodyHolds(ctx context.Context, ids []string) context.Context {
+	return context.WithValue(ctx, memoryOriginalBodyHoldKey{}, memoryOriginalBodyHold{IDs: append([]string(nil), ids...)})
+}
+
+func (s *KnowledgeInputProvenanceStore) BindMemoryOriginalBodyHolds(ctx context.Context, ids []string) (context.Context, error) {
+	if len(ids) == 0 {
+		return ctx, ErrOriginalBodyUnavailable
+	}
+	var leases []originalBodyLease
+	if err := bodyInternal(s.db.WithContext(ctx)).Where("lease_id IN ?", ids).Find(&leases).Error; err != nil {
+		return ctx, err
+	}
+	if len(leases) != len(ids) {
+		return ctx, ErrOriginalBodyUnavailable
+	}
+	bindings := map[string]originalBodyLease{}
+	for _, lease := range leases {
+		if lease.OwnerID == "" || bindings[lease.LeaseID].LeaseID != "" {
+			return ctx, ErrOriginalBodyUnavailable
+		}
+		bindings[lease.LeaseID] = lease
+	}
+	return context.WithValue(ctx, memoryOriginalBodyHoldKey{}, memoryOriginalBodyHold{Bindings: bindings, IDs: append([]string(nil), ids...)}), nil
+}
+
+func memoryExpectedBodyHeads(tx *gorm.DB, plan *types.MessageMaterialReadPlan, seen map[*types.MessageMaterialReadPlan]bool) ([]originalBodyFieldHead, error) {
+	if plan == nil || seen[plan] || len(seen) > 128 {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	seen[plan] = true
+	var all []originalBodyFieldHead
+	for _, parent := range plan.ParentPlans {
+		heads, err := memoryExpectedBodyHeads(tx, parent, seen)
+		if err != nil {
+			return nil, err
+		}
+		all = append(all, heads...)
+	}
+	for _, control := range plan.Controls {
+		if control == nil {
+			return nil, ErrOriginalBodyUnavailable
+		}
+		var heads []originalBodyFieldHead
+		if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("(source_table='messages' AND row_key=?) OR (source_table='message_generation_origins' AND row_key=?)", control.ID, control.GenerationID).Find(&heads).Error; err != nil {
+			return nil, err
+		}
+		if len(heads) == 0 {
+			return nil, ErrOriginalBodyUnavailable
+		}
+		all = append(all, heads...)
+		var copies []originalBodyFieldHead
+		if err := bodyInternal(tx).Table("original_body_field_heads h").Clauses(clause.Locking{Strength: "SHARE"}).Select("h.*").Where("(h.source_table='message_fork_parent_origins' AND h.row_key=?) OR (h.source_table='message_generated_field_admissions' AND h.row_key IN (SELECT a.id FROM message_generated_field_admissions a JOIN message_generated_field_receipts r ON r.admission_id=a.id AND r.message_id=a.message_id AND r.field=a.field WHERE a.message_id=?))", control.GenerationID, control.ID).Find(&copies).Error; err != nil {
+			return nil, err
+		}
+		all = append(all, copies...)
+		var parents []struct{ OriginID string }
+		if err := bodyInternal(tx).Table("steer_consumption_origins").Select("origin_id").Where("user_message_id=?", control.ID).Scan(&parents).Error; err != nil {
+			return nil, err
+		}
+		for _, parent := range parents {
+			var heads []originalBodyFieldHead
+			if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("source_table='steer_authored_origins' AND row_key=?", parent.OriginID).Find(&heads).Error; err != nil {
+				return nil, err
+			}
+			if len(heads) == 0 {
+				return nil, ErrOriginalBodyUnavailable
+			}
+			all = append(all, heads...)
+		}
+	}
+	return all, nil
+}
+
+func lockMemoryPlanVersions(tx *gorm.DB, plan *types.MessageMaterialReadPlan, seen map[*types.MessageMaterialReadPlan]bool) error {
+	if plan == nil || seen[plan] || len(seen) > 128 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	seen[plan] = true
+	for _, parent := range plan.ParentPlans {
+		if err := lockMemoryPlanVersions(tx, parent, seen); err != nil {
+			return err
+		}
+	}
+	share := clause.Locking{Strength: "SHARE"}
+	for _, table := range []string{"message_session_owner_versions", "message_session_membership_versions"} {
+		var revision struct{ Revision uint64 }
+		if err := tx.Table(table).Clauses(share).Where("session_id=?", plan.Request.SessionID).Take(&revision).Error; err != nil {
+			return err
+		}
+	}
+	for _, control := range plan.Controls {
+		if control == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var revision struct{ Revision uint64 }
+		if err := tx.Table("message_material_versions").Clauses(share).Where("message_id=?", control.ID).Take(&revision).Error; err != nil {
+			return err
+		}
+		if revision.Revision != control.CurrentRevision {
+			return ErrKnowledgeInputChanged
+		}
+		var receipt messageMaterialReceipt
+		if err := tx.Clauses(share).Where("message_id=? AND admission_id=?", control.ID, control.AdmissionID).Take(&receipt).Error; err != nil {
+			return err
+		}
+		var fields []struct{ MessageID, Field, AdmissionID string }
+		if err := tx.Table("message_generated_field_receipts").Clauses(share).Where("message_id=?", control.ID).Find(&fields).Error; err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+type memoryOriginalFenceView struct {
+	TenantID  uint64
+	SubjectID string
+	Actor     types.MemoryOriginalActor
+	Plan      *types.MessageMaterialReadPlan
+	Material  *types.MessageMaterialSnapshot
+}
+
+func memoryOriginalFence(input *types.MemoryOriginalInput) *memoryOriginalFenceView {
+	if input == nil {
+		return nil
+	}
+	return &memoryOriginalFenceView{TenantID: input.Request.TenantID, SubjectID: input.Request.SubjectID, Actor: input.Actor, Plan: input.Plan, Material: input.Material}
+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryOriginalInTx(ctx context.Context, tx *gorm.DB, input *types.MemoryOriginalInput) error {
+	return r.checkMemoryReadMaterialInTx(ctx, tx, memoryOriginalFence(input))
+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryReadMaterialInTx(ctx context.Context, tx *gorm.DB, input *memoryOriginalFenceView) error {
+	if r.authorityFactory == nil || input == nil || input.Plan == nil || input.Material == nil || input.Plan.SourceLineage.RequireComplete() != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.CheckSource == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err := authority.CheckRuntime(ctx); err != nil {
+		return err
+	}
+	marked, err := WithMessageMaterialReadPlan(ctx, input.Plan)
+	if err != nil {
+		return err
+	}
+	marked, err = authority.Store.RestoreMemoryOriginalActor(marked, input.Actor, input.TenantID, input.SubjectID)
+	if err != nil {
+		return err
+	}
+	if authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = authority.CheckSource(marked, input.Plan); err != nil {
+		return err
+	}
+	actual, err := authority.Store.captureMessageMaterialInTx(tx.Session(&gorm.Session{NewDB: true}).WithContext(marked), input.Material.Request)
+	if err != nil {
+		return err
+	}
+	a, b := *actual, *input.Material
+	a.Messages = nil
+	b.Messages = nil
+	if !faqInputEqual(&a, &b) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return ctx.Err()
+}
+
+// Runtime directory readers lock their sole configured row before the shared
+// permission epochs. Directory writers use directory→epoch in the same tx.
+func (r *memoryOriginalAdmissionRepository) lockMemoryOriginalFence(ctx context.Context, tx *gorm.DB, input *types.MemoryOriginalInput) error {
+	if r.authorityFactory == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.CheckRuntime == nil || authority.Store == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if tx.Dialector.Name() == "sqlite" {
+		if err := tx.Exec("UPDATE memory_subjects SET updated_at=updated_at WHERE tenant_id=? AND subject_id=?", input.Request.TenantID, input.Request.SubjectID).Error; err != nil {
+			return err
+		}
+	}
+	if err := authority.CheckRuntime(ctx); err != nil {
+		return err
+	}
+	return lockMemoryOriginalFence(ctx, tx, input)
+}
+
+// Lock metadata/control rows, never copy bytes into a substitute original.
+// Scope identities are from the immutable plan; actor rows are from its
+// original selector. Group permission queries run on the same tx afterwards.
+func lockMemoryOriginalFence(ctx context.Context, tx *gorm.DB, input *types.MemoryOriginalInput) error {
+	return lockMemoryReadFence(ctx, tx, memoryOriginalFence(input))
+}
+func lockMemoryReadFence(ctx context.Context, tx *gorm.DB, input *memoryOriginalFenceView) error {
+	share := clause.Locking{Strength: "SHARE"}
+	if tx.Dialector.Name() == "sqlite" {
+		// Obtain SQLite's write reservation before any fence view is read.
+		if err := tx.Exec("UPDATE memory_subjects SET updated_at=updated_at WHERE tenant_id=? AND subject_id=?", input.TenantID, input.SubjectID).Error; err != nil {
+			return err
+		}
+	}
+	var tenant types.Tenant
+	if err := tx.Clauses(share).Where("id=?", input.Actor.CallerTenantID).Take(&tenant).Error; err != nil {
+		return err
+	}
+	if input.Actor.UserID != "" {
+		var user types.User
+		if err := tx.Clauses(share).Where("id=? AND is_active=?", input.Actor.UserID, true).Take(&user).Error; err != nil {
+			return err
+		}
+		var members []types.TenantMember
+		if err := tx.Clauses(share).Where("user_id=? AND tenant_id=?", input.Actor.UserID, input.Actor.CallerTenantID).Find(&members).Error; err != nil {
+			return err
+		}
+		var identities []types.DirectoryIdentity
+		if err := tx.Where("user_id=?", input.Actor.UserID).Order("directory_id,id").Find(&identities).Error; err != nil {
+			return err
+		}
+		dirs := map[string]bool{}
+		for _, identity := range identities {
+			dirs[identity.DirectoryID] = true
+		}
+		var ordered []string
+		for id := range dirs {
+			ordered = append(ordered, id)
+		}
+		sort.Strings(ordered)
+		for _, id := range ordered {
+			var dir types.Directory
+			if err := tx.Clauses(share).Where("id=?", id).Take(&dir).Error; err != nil {
+				return err
+			}
+		}
+		// Directory/group writers publish through PermissionVersion. Do not
+		// acquire identity locks after that shared version lock: LinkIdentity
+		// holds identity→version and would deadlock in the inverse order.
+	}
+	if input.Actor.APIKeyID != nil {
+		var key types.TenantAPIKey
+		if err := tx.Clauses(share).Where("id=?", *input.Actor.APIKeyID).Take(&key).Error; err != nil {
+			return err
+		}
+	}
+	tenantIDs, agentKeys, err := memorySharedReadAuthorityControls(tx, input)
+	if err != nil {
+		return err
+	}
+	// Organization writers use organization→tenant permission epoch. Lock
+	// routing organizations first, including transitive source-plan scopes.
+	if err := lockSharedAuthorityOrganizationsForMemory(tx, tenantIDs); err != nil {
+		return err
+	}
+	for _, id := range tenantIDs {
+		// The same row bumped by group policies/grants and identity/sync
+		// writers fences grant/link phantoms, not just rows already selected.
+		if err := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&types.PermissionVersion{TenantID: id, Version: 0}).Error; err != nil {
+			return err
+		}
+		var permission types.PermissionVersion
+		if err := tx.Clauses(share).Where("tenant_id=?", id).Take(&permission).Error; err != nil {
+			return err
+		}
+	}
+	// Preserve organization→permission epoch ordering before exact resource
+	// locks. Never choose a replacement Agent from current grants or config.
+	if err := lockMemoryOriginalAgentRows(tx, agentKeys); err != nil {
+		return err
+	}
+	for _, scope := range input.Plan.Scopes {
+		var kb types.KnowledgeBase
+		if err := tx.Clauses(share).Where("id=? AND tenant_id=?", scope.KBID, scope.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		var fence nextcloudContentFence
+		if err := tx.Clauses(share).Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", scope.TenantID, scope.KBID).Take(&fence).Error; err != nil {
+			return err
+		}
+	}
+	for _, source := range input.Plan.SourceLineage.Sources {
+		var fence nextcloudContentFence
+		if err := tx.Clauses(share).Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=? AND datasource_id=? AND external_id=?", source.TenantID, source.KnowledgeBaseID, source.KnowledgeID, source.DataSourceID, source.ExternalID).Take(&fence).Error; err != nil {
+			return err
+		}
+		if fence.State != "open" || uint64(fence.Epoch) != source.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var sourceRow types.DataSource
+		if err := tx.Clauses(share).Where("id=?", source.DataSourceID).Take(&sourceRow).Error; err != nil {
+			return err
+		}
+	}
+	hold, _ := ctx.Value(memoryOriginalBodyHoldKey{}).(memoryOriginalBodyHold)
+	ids := hold.IDs
+	if len(ids) == 0 || len(hold.Bindings) != len(ids) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var leases []originalBodyLease
+	if err := bodyInternal(tx).Clauses(share).Where("lease_id IN ?", ids).Order("lease_id").Find(&leases).Error; err != nil {
+		return err
+	}
+	if len(leases) != len(ids) {
+		return ErrOriginalBodyUnavailable
+	}
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	for _, lease := range leases {
+		bound, ok := hold.Bindings[lease.LeaseID]
+		if !ok || lease.Kind != "read" || lease.OwnerID != bound.OwnerID || lease.BodyID != bound.BodyID || lease.Epoch != bound.Epoch || lease.ReleasedAtMS != nil || lease.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+		var body originalBodyPayload
+		if err := bodyInternal(tx).Clauses(share).Where("id=?", lease.BodyID).Take(&body).Error; err != nil {
+			return err
+		}
+		if body.State != "live" || body.PurgeEpoch != lease.Epoch {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	heads, err := memoryExpectedBodyHeads(tx, input.Plan, map[*types.MessageMaterialReadPlan]bool{})
+	if err != nil {
+		return err
+	}
+	covered := map[string]bool{}
+	for _, lease := range leases {
+		covered[lease.BodyID] = true
+	}
+	for _, head := range heads {
+		if !covered[head.BodyID] {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	if err := lockMemoryPlanVersions(tx, input.Plan, map[*types.MessageMaterialReadPlan]bool{}); err != nil {
+		return err
+	}
+	return ctx.Err()
+}
diff --git a/internal/application/repository/memory_original_final_clock.go b/internal/application/repository/memory_original_final_clock.go
new file mode 100644
index 00000000..5ce96903
--- /dev/null
+++ b/internal/application/repository/memory_original_final_clock.go
@@ -0,0 +1,168 @@
+package repository
+
+import (
+	"context"
+	"sort"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// These are the immutable identities of genuinely acquired leases. Renewals
+// may legitimately change expiry, so final time comes from actual SQL rows.
+func mergeMemoryFinalLeaseBindings(all map[string]originalBodyLease, bindings map[string]originalBodyLease) error {
+	for _, lease := range bindings {
+		if lease.LeaseID == "" || lease.BodyID == "" || lease.OwnerID == "" || lease.Kind != "read" {
+			return ErrOriginalBodyUnavailable
+		}
+		if prior, ok := all[lease.LeaseID]; ok && (prior.BodyID != lease.BodyID || prior.OwnerID != lease.OwnerID || prior.Epoch != lease.Epoch || prior.Kind != lease.Kind) {
+			return ErrOriginalBodyUnavailable
+		}
+		all[lease.LeaseID] = lease
+	}
+	return nil
+}
+func memoryModelFinalLeaseBindings(ctx context.Context) (map[string]originalBodyLease, error) {
+	ids, err := ModelOriginalLeaseIDs(ctx)
+	if err != nil {
+		return nil, err
+	}
+	bindings := map[string]originalBodyLease{}
+	if read, ok := ctx.Value(modelOriginalSnapshotKey{}).(*modelOriginalRead); ok {
+		if err = mergeMemoryFinalLeaseBindings(bindings, read.hold.Leases); err != nil {
+			return nil, err
+		}
+	}
+	if holds, ok := ctx.Value(historicalModelHoldKey{}).(map[string]historicalModelHold); ok {
+		for _, hold := range holds {
+			if err = mergeMemoryFinalLeaseBindings(bindings, hold.Hold.Leases); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if len(bindings) != len(ids) {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	for _, id := range ids {
+		if _, ok := bindings[id]; !ok {
+			return nil, ErrOriginalBodyUnavailable
+		}
+	}
+	return bindings, ctx.Err()
+}
+func memoryWorkerFinalLeaseBindings(ctx context.Context) (map[string]originalBodyLease, []context.Context, error) {
+	all := map[string]originalBodyLease{}
+	original, ok := ctx.Value(memoryOriginalBodyHoldKey{}).(memoryOriginalBodyHold)
+	if !ok || len(original.IDs) == 0 || len(original.IDs) != len(original.Bindings) {
+		return nil, nil, ErrOriginalBodyUnavailable
+	}
+	for _, id := range original.IDs {
+		if _, ok := original.Bindings[id]; !ok {
+			return nil, nil, ErrOriginalBodyUnavailable
+		}
+	}
+	if err := mergeMemoryFinalLeaseBindings(all, original.Bindings); err != nil {
+		return nil, nil, err
+	}
+	policy, ok := ctx.Value(memoryPolicyHoldKey{}).(memoryPolicyHold)
+	if !ok || len(policy.Leases) == 0 {
+		return nil, nil, ErrOriginalBodyUnavailable
+	}
+	if err := mergeMemoryFinalLeaseBindings(all, policy.Leases); err != nil {
+		return nil, nil, err
+	}
+	model, err := memoryModelFinalLeaseBindings(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	if err = mergeMemoryFinalLeaseBindings(all, model); err != nil {
+		return nil, nil, err
+	}
+	derived, ok := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if !ok || derived == nil {
+		return nil, nil, ErrOriginalBodyUnavailable
+	}
+	if err = mergeMemoryFinalLeaseBindings(all, derived.Leases); err != nil {
+		return nil, nil, err
+	}
+	for _, policy := range derived.Policies {
+		if len(policy.Leases) == 0 {
+			return nil, nil, ErrOriginalBodyUnavailable
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, policy.Leases); err != nil {
+			return nil, nil, err
+		}
+	}
+	if len(derived.Executions) != len(derived.ModelContexts) {
+		return nil, nil, ErrOriginalBodyUnavailable
+	}
+	contexts := []context.Context{ctx}
+	for id := range derived.Executions {
+		modelCtx := derived.ModelContexts[id]
+		if modelCtx == nil {
+			return nil, nil, ErrOriginalBodyUnavailable
+		}
+		bindings, err := memoryModelFinalLeaseBindings(modelCtx)
+		if err != nil {
+			return nil, nil, err
+		}
+		if err = mergeMemoryFinalLeaseBindings(all, bindings); err != nil {
+			return nil, nil, err
+		}
+		contexts = append(contexts, modelCtx)
+	}
+	return all, contexts, ctx.Err()
+}
+
+// All entity/actor/journal/body/source checks precede this final union. This
+// uses only the caller's transaction; no global pool, new proof or lease is
+// acquired. Every row retains its exact captured owner/body/purge epoch.
+func checkMemoryWorkerFinalClockInTx(ctx context.Context, tx *gorm.DB) error {
+	bindings, contexts, err := memoryWorkerFinalLeaseBindings(ctx)
+	if err != nil {
+		return err
+	}
+	keys := []string{}
+	for id := range bindings {
+		keys = append(keys, id)
+	}
+	sort.Strings(keys)
+	var leases []originalBodyLease
+	local := bodyInternal(tx.Session(&gorm.Session{NewDB: true})).Set("memory:final_lease_clock_union", true)
+	if err = local.Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id IN ?", keys).Order("lease_id").Find(&leases).Error; err != nil {
+		return err
+	}
+	if len(leases) != len(keys) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, lease := range leases {
+		expected, ok := bindings[lease.LeaseID]
+		if !ok || lease.Kind != "read" || lease.BodyID != expected.BodyID || lease.OwnerID != expected.OwnerID || lease.Epoch != expected.Epoch || lease.ReleasedAtMS != nil {
+			return ErrOriginalBodyUnavailable
+		}
+		var body originalBodyPayload
+		if err = bodyInternal(tx.Session(&gorm.Session{NewDB: true})).Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", lease.BodyID).Take(&body).Error; err != nil {
+			return err
+		}
+		if body.State != "live" || body.PurgeEpoch != lease.Epoch {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	// No physical/body/entity IO follows this clock. Locks prevent another
+	// transaction from replacing the selected bindings before actual commit.
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx.Session(&gorm.Session{NewDB: true})))
+	if err != nil {
+		return err
+	}
+	for _, lease := range leases {
+		if lease.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	for _, held := range contexts {
+		if err = held.Err(); err != nil {
+			return err
+		}
+	}
+	return tx.Statement.Context.Err()
+}
diff --git a/internal/application/repository/memory_original_outbox.go b/internal/application/repository/memory_original_outbox.go
new file mode 100644
index 00000000..2c3ccc64
--- /dev/null
+++ b/internal/application/repository/memory_original_outbox.go
@@ -0,0 +1,256 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryOriginalOutboxRepository struct {
+	db         *gorm.DB
+	completion interfaces.MemoryOriginalCompletionReader
+}
+
+func NewMemoryOriginalOutboxRepository(db *gorm.DB, admissions interfaces.MemoryOriginalAdmissionRepository) interfaces.MemoryOriginalOutboxRepository {
+	completion, _ := admissions.(interfaces.MemoryOriginalCompletionReader)
+	return &memoryOriginalOutboxRepository{db: db, completion: completion}
+}
+
+func memoryOriginalTaskPayload(input *types.MemoryOriginalInput) types.MemoryExtractPayload {
+	q := input.Request
+	return types.MemoryExtractPayload{
+		TenantID: q.TenantID, SubjectID: q.SubjectID, SessionID: q.SessionID,
+		MessageID: q.TriggerMessageID, ChatModelID: q.ChatModelID, Language: q.Language,
+		OriginalAdmissionID: input.ID, OriginalDigest: input.Digest, OriginalRevision: q.PendingRevision,
+	}
+}
+
+// Called only inside the admission/pending transaction. Dispatch selectors are
+// copied from that newly authenticated immutable fact, never from current rows.
+func createMemoryOriginalDispatchInTx(tx *gorm.DB, input *types.MemoryOriginalInput) error {
+	if input == nil || input.ID == "" || input.Digest == "" || input.Request.DispatchNotBefore.IsZero() || !input.Request.DispatchNotBefore.Equal(input.Request.DispatchNotBefore.Truncate(time.Microsecond)) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	encoded, err := json.Marshal(memoryOriginalTaskPayload(input))
+	if err != nil {
+		return err
+	}
+	now := time.Now().UTC()
+	row := &types.MemoryOriginalDispatch{
+		AdmissionID: input.ID, Payload: string(encoded), PayloadDigest: types.MemoryOriginalBytesDigest(encoded),
+		NotBefore: input.Request.DispatchNotBefore, NextAttemptAt: input.Request.DispatchNotBefore,
+		CreatedAt: now, UpdatedAt: now,
+	}
+	return tx.Create(row).Error
+}
+
+func validateMemoryOriginalDispatch(tx *gorm.DB, row *types.MemoryOriginalDispatch) (types.MemoryExtractPayload, error) {
+	var payload types.MemoryExtractPayload
+	if row == nil || row.AdmissionID == "" || row.PayloadDigest == "" ||
+		types.MemoryOriginalBytesDigest([]byte(row.Payload)) != row.PayloadDigest ||
+		json.Unmarshal([]byte(row.Payload), &payload) != nil {
+		return payload, types.ErrMemoryOriginalUnavailable
+	}
+	input, err := loadMemoryOriginal(tx, row.AdmissionID)
+	if err != nil {
+		return payload, err
+	}
+	if !faqInputEqual(payload, memoryOriginalTaskPayload(input)) ||
+		!row.NotBefore.Equal(input.Request.DispatchNotBefore) {
+		return payload, types.ErrMemoryOriginalUnavailable
+	}
+	return payload, nil
+}
+
+// A fingerprint is only an immutable-row identity for retry metadata. It is
+// not an original producer proof and cannot authorize enqueue or completion.
+func memoryOriginalDispatchFingerprint(row *types.MemoryOriginalDispatch) (string, error) {
+	if row == nil {
+		return "", types.ErrMemoryOriginalUnavailable
+	}
+	return KnowledgeInputDigest(struct {
+		AdmissionID, Payload, PayloadDigest string
+		NotBefore, CreatedAt                time.Time
+	}{row.AdmissionID, row.Payload, row.PayloadDigest, row.NotBefore, row.CreatedAt})
+}
+
+func memoryOriginalDispatchValidationCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	if errors.Is(err, types.ErrMemoryOriginalUnavailable) || errors.Is(err, gorm.ErrRecordNotFound) {
+		return "original_intent_invalid"
+	}
+	return "original_validation_unavailable"
+}
+
+func (r *memoryOriginalOutboxRepository) VerifyMemoryOriginalCompletion(ctx context.Context, payload types.MemoryExtractPayload) (bool, error) {
+	if r.completion == nil {
+		return false, types.ErrMemoryOriginalUnavailable
+	}
+	return r.completion.VerifyMemoryOriginalCompletion(ctx, payload)
+}
+
+func (r *memoryOriginalOutboxRepository) ClaimMemoryOriginalDispatch(ctx context.Context, admissionID string, now time.Time, ttl time.Duration) (*types.MemoryOriginalDispatchClaim, error) {
+	if r == nil || r.db == nil || ctx == nil || ttl <= 0 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var claim *types.MemoryOriginalDispatchClaim
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var row types.MemoryOriginalDispatch
+		query := tx.Where("completed_at IS NULL AND next_attempt_at <= ? AND (lease_until IS NULL OR lease_until <= ?)", now, now)
+		if admissionID != "" {
+			query = query.Where("admission_id = ?", admissionID)
+		}
+		if tx.Dialector.Name() == "postgres" {
+			query = query.Clauses(clause.Locking{Strength: "UPDATE", Options: "SKIP LOCKED"})
+		}
+		result := query.Order("next_attempt_at, admission_id").Limit(1).Find(&row)
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected == 0 {
+			return ctx.Err()
+		}
+		payload, err := validateMemoryOriginalDispatch(tx, &row)
+		failureCode := memoryOriginalDispatchValidationCode(err)
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		fingerprint, err := memoryOriginalDispatchFingerprint(&row)
+		if err != nil {
+			return err
+		}
+		leaseID := uuid.NewString()
+		until := now.Add(ttl)
+		updated := tx.Model(&types.MemoryOriginalDispatch{}).
+			Where("admission_id = ? AND payload_digest = ? AND completed_at IS NULL AND next_attempt_at <= ? AND (lease_until IS NULL OR lease_until <= ?)", row.AdmissionID, row.PayloadDigest, now, now).
+			Updates(map[string]interface{}{"lease_id": leaseID, "lease_until": until, "attempts": gorm.Expr("attempts + 1"), "updated_at": now})
+		if updated.Error != nil {
+			return updated.Error
+		}
+		if updated.RowsAffected != 1 {
+			return ctx.Err()
+		}
+		claim = &types.MemoryOriginalDispatchClaim{AdmissionID: row.AdmissionID, PayloadDigest: row.PayloadDigest, LeaseID: leaseID, Attempts: row.Attempts + 1, IntentFingerprint: fingerprint, ValidationFailureCode: failureCode}
+		if failureCode == "" {
+			claim.Payload = payload
+		}
+		return ctx.Err()
+	})
+	return claim, err
+}
+
+// completed=true is accepted only after the real immutable completion verifier.
+// Success/failure of a broker relay updates retry metadata, never pending work.
+func (r *memoryOriginalOutboxRepository) FinishMemoryOriginalDispatch(ctx context.Context, claim *types.MemoryOriginalDispatchClaim, now, next time.Time, enqueued, completed bool) error {
+	if claim == nil || claim.AdmissionID == "" || claim.LeaseID == "" || next.Before(now) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if claim.IntentFingerprint == "" || (claim.ValidationFailureCode != "" && (enqueued || completed)) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if completed {
+		verified, err := r.VerifyMemoryOriginalCompletion(ctx, claim.Payload)
+		if err != nil {
+			return err
+		}
+		if !verified {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var row types.MemoryOriginalDispatch
+		if err := tx.Where("admission_id = ? AND payload_digest = ? AND lease_id = ? AND completed_at IS NULL AND lease_until > ?", claim.AdmissionID, claim.PayloadDigest, claim.LeaseID, now).Clauses(forUpdateClause()).Take(&row).Error; err != nil {
+			return err
+		}
+		fingerprint, err := memoryOriginalDispatchFingerprint(&row)
+		if err != nil {
+			return err
+		}
+		if fingerprint != claim.IntentFingerprint {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if claim.ValidationFailureCode == "" {
+			payload, err := validateMemoryOriginalDispatch(tx, &row)
+			if err != nil {
+				return err
+			}
+			if !faqInputEqual(payload, claim.Payload) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		if claim.ValidationFailureCode == "" && row.RequestedNextAt != nil && row.RequestedNextAt.Before(next) {
+			next = *row.RequestedNextAt
+		}
+		updates := map[string]interface{}{"lease_id": "", "lease_until": nil, "next_attempt_at": next, "updated_at": now}
+		updates["last_failure_code"] = claim.ValidationFailureCode
+		if claim.ValidationFailureCode == "" {
+			updates["requested_next_at"] = nil
+			if !enqueued && !completed {
+				updates["last_failure_code"] = "delivery_retry"
+			}
+		}
+		if enqueued {
+			updates["last_enqueued_at"] = now
+		}
+		if completed {
+			updates["completed_at"] = now
+		}
+		result := tx.Model(&types.MemoryOriginalDispatch{}).
+			Where("admission_id = ? AND payload_digest = ? AND lease_id = ? AND completed_at IS NULL AND lease_until > ?", row.AdmissionID, row.PayloadDigest, claim.LeaseID, now).
+			Updates(updates)
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected != 1 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		return ctx.Err()
+	})
+}
+
+func (r *memoryOriginalOutboxRepository) ScheduleMemoryOriginalDispatch(ctx context.Context, payload types.MemoryExtractPayload, due time.Time) error {
+	if payload.OriginalAdmissionID == "" || due.IsZero() {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var row types.MemoryOriginalDispatch
+		if err := tx.Where("admission_id = ? AND completed_at IS NULL", payload.OriginalAdmissionID).Clauses(forUpdateClause()).Take(&row).Error; err != nil {
+			return err
+		}
+		original, err := validateMemoryOriginalDispatch(tx, &row)
+		if err != nil {
+			return err
+		}
+		if !faqInputEqual(original, payload) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if due.Before(row.NotBefore) {
+			due = row.NotBefore
+		}
+		updates := map[string]interface{}{"updated_at": time.Now().UTC()}
+		if row.LeaseUntil != nil && row.LeaseUntil.After(time.Now().UTC()) {
+			if row.RequestedNextAt == nil || due.Before(*row.RequestedNextAt) {
+				updates["requested_next_at"] = due
+			}
+		} else {
+			updates["next_attempt_at"] = due
+		}
+		result := tx.Model(&types.MemoryOriginalDispatch{}).Where("admission_id = ? AND payload_digest = ? AND completed_at IS NULL", row.AdmissionID, row.PayloadDigest).Updates(updates)
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected != 1 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		return ctx.Err()
+	})
+}
diff --git a/internal/application/repository/memory_original_outbox_retry_test.go b/internal/application/repository/memory_original_outbox_retry_test.go
