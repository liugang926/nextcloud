+func memoryDerivedWritablePublication(tx *gorm.DB, scope interfaces.MemoryScope, kind, id, commitID string) (*types.MemoryDerivedPublication, error) {
+	fact, err := memoryDerivedCurrentPublicationInTx(tx, scope, kind, id)
+	if err != nil {
+		return nil, err
+	}
+	hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if fact.CommitID != commitID && (hold == nil || hold.Facts[fact.ID] == nil) {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return fact, nil
+}
+func (r *memoryOriginalAdmissionRepository) applyMemoryDerivedTopicInTx(tx *gorm.DB, input *types.MemoryOriginalInput, commit *types.MemoryOriginalCommit, op types.MemoryOriginalMutation) ([]*types.MemoryOriginalDerivation, error) {
+	if op.Topic == "" || op.NormalizedKey == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	scope := interfaces.MemoryScope{TenantID: input.Request.TenantID, SubjectID: input.Request.SubjectID}
+	at := memoryFactTime()
+	effects := []*types.MemoryOriginalDerivation{}
+	row := &types.MemoryTopicStat{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, NormalizedKey: op.NormalizedKey, Topic: op.Topic, Aliases: types.MemoryTopicAliases{}, Hits: 1, LastSeenAt: at, CreatedAt: at, UpdatedAt: at}
+	if op.TargetID != "" {
+		fact, err := memoryDerivedWritablePublication(tx, scope, "memory_topic", op.TargetID, commit.ID)
+		if err != nil {
+			return nil, err
+		}
+		if fact.ID != op.TargetPublicationID || fact.MaterialDigest != op.TargetDigest || fact.DerivationID != op.TargetDerivationID {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(forUpdateClause()).Where("id=? AND tenant_id=? AND subject_id=?", op.TargetID, scope.TenantID, scope.SubjectID).Take(row).Error; err != nil {
+			return nil, err
+		}
+		digest, err := KnowledgeInputDigest(row)
+		if err != nil || digest != op.TargetDigest {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		oldTopic, oldKey := row.Topic, row.NormalizedKey
+		if !row.Aliases.Has(op.Topic) && types.NormalizeTopicKey(op.Topic) != row.NormalizedKey {
+			row.Aliases = append(row.Aliases, op.Topic)
+		}
+		if op.TopicMergedLabel != "" {
+			proposed := types.SanitizeMemoryTopic(op.TopicMergedLabel)
+			key := types.NormalizeTopicKey(proposed)
+			var count int64
+			if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryTopicStat{}).Where("tenant_id=? AND subject_id=? AND normalized_key=? AND id<>?", scope.TenantID, scope.SubjectID, key, row.ID).Count(&count).Error; err != nil {
+				return nil, err
+			}
+			if count == 0 && key != "" && types.TopicLabelIsAnImprovement(oldTopic, op.Topic, proposed) {
+				if !row.Aliases.Has(oldTopic) {
+					row.Aliases = append(row.Aliases, oldTopic)
+				}
+				row.Topic = proposed
+				row.NormalizedKey = key
+				var ids []struct{ ID string }
+				if err = tx.Session(&gorm.Session{NewDB: true}).Table("memory_items").Select("id").Where("tenant_id=? AND subject_id=? AND kind=? AND normalized_key=?", scope.TenantID, scope.SubjectID, types.MemoryKindInterest, oldKey).Order("id").Find(&ids).Error; err != nil {
+					return nil, err
+				}
+				for _, id := range ids {
+					previous, err := memoryDerivedWritablePublication(tx, scope, "memory_item", id.ID, commit.ID)
+					if err != nil {
+						return nil, err
+					}
+					var item types.MemoryItem
+					if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(forUpdateClause()).Where("id=?", id.ID).Take(&item).Error; err != nil {
+						return nil, err
+					}
+					item.Topic = proposed
+					item.Content = proposed
+					item.NormalizedKey = key
+					item.UpdatedAt = at
+					if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryItem{}).Where("id=?", item.ID).Updates(map[string]interface{}{"topic": item.Topic, "content": item.Content, "normalized_key": key, "updated_at": at}).Error; err != nil {
+						return nil, err
+					}
+					origin, err := memoryOriginalCreateEffectInTx(tx, input, commit, op.ID, "topic_rename", "memory_item", item.ID, previous.DerivationID, "topic_rename_interest", &item, nil)
+					if err != nil {
+						return nil, err
+					}
+					effects = append(effects, origin)
+					if err = tx.Session(&gorm.Session{NewDB: true}).Where("item_id=?", item.ID).Delete(&types.MemoryItemEmbedding{}).Error; err != nil {
+						return nil, err
+					}
+				}
+			}
+		}
+		if len(row.Aliases) > 12 {
+			row.Aliases = row.Aliases[len(row.Aliases)-12:]
+		}
+		row.Hits++
+		row.LastSeenAt = at
+		row.UpdatedAt = at
+		if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryTopicStat{}).Where("id=?", row.ID).Updates(map[string]interface{}{"topic": row.Topic, "normalized_key": row.NormalizedKey, "aliases": row.Aliases, "hits": row.Hits, "last_seen_at": at, "updated_at": at}).Error; err != nil {
+			return nil, err
+		}
+	} else if err := tx.Session(&gorm.Session{NewDB: true}).Create(row).Error; err != nil {
+		return nil, err
+	}
+	origin, err := memoryOriginalCreateEffectInTx(tx, input, commit, op.ID, "topic", "memory_topic", row.ID, op.TargetDerivationID, "model_result", row, nil)
+	if err != nil {
+		return nil, err
+	}
+	effects = append(effects, origin)
+	var tenant types.Tenant
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("id=?", scope.TenantID).Take(&tenant).Error; err != nil {
+		return nil, err
+	}
+	if tenant.MemoryConfig == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if row.PromotedAt == nil && row.Hits >= tenant.MemoryConfig.EffectiveInterestThreshold() {
+		var ids []struct{ ID string }
+		if err = tx.Session(&gorm.Session{NewDB: true}).Table("memory_items").Select("id").Where("tenant_id=? AND subject_id=? AND normalized_key=? AND status IN ?", scope.TenantID, scope.SubjectID, row.NormalizedKey, []string{types.MemoryStatusActive, types.MemoryStatusPending}).Order("id").Find(&ids).Error; err != nil {
+			return nil, err
+		}
+		found := false
+		var old []*types.MemoryItem
+		for _, id := range ids {
+			if _, err = memoryDerivedWritablePublication(tx, scope, "memory_item", id.ID, commit.ID); err != nil {
+				return nil, err
+			}
+			var item types.MemoryItem
+			if err = tx.Session(&gorm.Session{NewDB: true}).Where("id=?", id.ID).Take(&item).Error; err != nil {
+				return nil, err
+			}
+			if item.Content == row.Topic && item.Status == types.MemoryStatusActive {
+				found = true
+			}
+			old = append(old, &item)
+		}
+		if !found {
+			item := &types.MemoryItem{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, Kind: types.MemoryKindInterest, Content: row.Topic, Topic: row.Topic, NormalizedKey: row.NormalizedKey, Importance: 3, Origin: types.MemoryOriginExtracted, Status: types.MemoryStatusActive, SourceSessionID: input.Request.SessionID, ValidFrom: at, CreatedAt: at, UpdatedAt: at}
+			if err = tx.Session(&gorm.Session{NewDB: true}).Create(item).Error; err != nil {
+				return nil, err
+			}
+			child, err := memoryOriginalCreateEffectInTx(tx, input, commit, op.ID, "add", "memory_item", item.ID, origin.ID, "topic_interest_promotion", item, nil)
+			if err != nil {
+				return nil, err
+			}
+			effects = append(effects, child)
+			for _, previous := range old {
+				pub, err := memoryDerivedWritablePublication(tx, scope, "memory_item", previous.ID, commit.ID)
+				if err != nil {
+					return nil, err
+				}
+				previous.Status = types.MemoryStatusSuperseded
+				previous.InvalidAt = &at
+				previous.SupersededBy = item.ID
+				previous.UpdatedAt = at
+				if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryItem{}).Where("id=?", previous.ID).Updates(map[string]interface{}{"status": previous.Status, "invalid_at": at, "superseded_by": item.ID, "updated_at": at}).Error; err != nil {
+					return nil, err
+				}
+				child, err := memoryOriginalCreateEffectInTx(tx, input, commit, op.ID, "supersede", "memory_item", previous.ID, pub.DerivationID, "model_previous_target", previous, nil)
+				if err != nil {
+					return nil, err
+				}
+				effects = append(effects, child)
+			}
+		}
+		row.PromotedAt = &at
+		row.UpdatedAt = at
+		if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryTopicStat{}).Where("id=?", row.ID).Updates(map[string]interface{}{"promoted_at": at, "updated_at": at}).Error; err != nil {
+			return nil, err
+		}
+		control, err := memoryOriginalCreateEffectInTx(tx, input, commit, op.ID, "promote", "memory_topic", row.ID, origin.ID, "topic_promotion_control", row, nil)
+		if err != nil {
+			return nil, err
+		}
+		effects = append(effects, control)
+	}
+	return effects, tx.Statement.Context.Err()
+}
