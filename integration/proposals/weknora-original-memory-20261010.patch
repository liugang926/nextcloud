@@ -0,0 +1,249 @@
+-- SOURCE PREPARATION: requires inventory migration155 and the full prior chain.
+-- Legacy pending work has no original admission and is deliberately not backfilled.
+CREATE TABLE memory_original_admissions (
+ id VARCHAR(36) PRIMARY KEY,
+ tenant_id BIGINT NOT NULL,
+ subject_id VARCHAR(512) NOT NULL,
+ session_id VARCHAR(36) NOT NULL,
+ pending_revision BIGINT NOT NULL CHECK (pending_revision > 0),
+ previous_admission_id VARCHAR(36) NOT NULL DEFAULT '',
+ digest VARCHAR(64) NOT NULL CHECK (length(digest) = 64),
+ envelope TEXT NOT NULL,
+ created_at TIMESTAMPTZ NOT NULL,
+ UNIQUE(tenant_id, subject_id, session_id, pending_revision),
+ FOREIGN KEY(tenant_id, subject_id) REFERENCES memory_subjects(tenant_id, subject_id)
+);
+ALTER TABLE memory_extraction_sessions ADD COLUMN original_admission_id VARCHAR(36) NOT NULL DEFAULT '';
+CREATE FUNCTION memory_original_admission_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN RAISE EXCEPTION 'memory original admissions are immutable'; END;
+$$;
+CREATE TRIGGER memory_original_admission_no_mutation
+ BEFORE UPDATE OR DELETE ON memory_original_admissions
+ FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+
+CREATE TABLE memory_original_executions (
+ id TEXT PRIMARY KEY, input_admission_id TEXT NOT NULL REFERENCES memory_original_admissions(id),
+ input_digest TEXT NOT NULL, policy_digest TEXT NOT NULL, model_id TEXT NOT NULL, model_digest TEXT NOT NULL,
+ digest TEXT NOT NULL CHECK(length(digest)=64), created_at TIMESTAMPTZ NOT NULL
+);
+CREATE TABLE memory_original_checkpoints (
+ id TEXT PRIMARY KEY, tenant_id BIGINT NOT NULL, subject_id TEXT NOT NULL, session_id TEXT NOT NULL,
+ input_admission_id TEXT NOT NULL REFERENCES memory_original_admissions(id), input_digest TEXT NOT NULL,
+ previous_checkpoint_id TEXT NOT NULL DEFAULT '', execution_admission_id TEXT NOT NULL REFERENCES memory_original_executions(id),
+ pending_revision BIGINT NOT NULL, from_at TIMESTAMPTZ, from_id TEXT NOT NULL DEFAULT '', to_at TIMESTAMPTZ NOT NULL, to_id TEXT NOT NULL,
+ drained BOOLEAN NOT NULL, model_result_digest TEXT NOT NULL, operations_digest TEXT NOT NULL, operation_manifest TEXT NOT NULL,
+ recipe TEXT NOT NULL, digest TEXT NOT NULL CHECK(length(digest)=64), created_at TIMESTAMPTZ NOT NULL
+);
+CREATE TABLE memory_original_derivations (
+ id TEXT PRIMARY KEY, operation_id TEXT NOT NULL, commit_id TEXT NOT NULL, input_admission_id TEXT NOT NULL REFERENCES memory_original_admissions(id),
+ execution_admission_id TEXT NOT NULL REFERENCES memory_original_executions(id), tenant_id BIGINT NOT NULL, subject_id TEXT NOT NULL,
+ object_kind TEXT NOT NULL, object_id TEXT NOT NULL, action TEXT NOT NULL, body_digest TEXT NOT NULL,
+ parent_derivation_id TEXT NOT NULL DEFAULT '', dependency_json TEXT NOT NULL,
+ digest TEXT NOT NULL CHECK(length(digest)=64), created_at TIMESTAMPTZ NOT NULL
+);
+CREATE INDEX memory_original_derived_objects ON memory_original_derivations(tenant_id,subject_id,object_kind,object_id);
+ALTER TABLE memory_extraction_sessions ADD COLUMN original_checkpoint_id TEXT NOT NULL DEFAULT '';
+CREATE TRIGGER memory_original_executions_immutable BEFORE UPDATE OR DELETE ON memory_original_executions FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+CREATE TRIGGER memory_original_checkpoints_immutable BEFORE UPDATE OR DELETE ON memory_original_checkpoints FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+CREATE TRIGGER memory_original_derivations_immutable BEFORE UPDATE OR DELETE ON memory_original_derivations FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+
+-- Original-bound dispatch is part of the same reserved pending migration.
+-- Merge into reserved156 AFTER memory_original_admissions. Not standalone.
+CREATE TABLE memory_original_dispatches (
+ admission_id VARCHAR(36) PRIMARY KEY REFERENCES memory_original_admissions(id),
+ payload TEXT NOT NULL,
+ payload_digest VARCHAR(64) NOT NULL CHECK(length(payload_digest)=64),
+ not_before TIMESTAMPTZ NOT NULL,
+ next_attempt_at TIMESTAMPTZ NOT NULL,
+ requested_next_at TIMESTAMPTZ,
+ attempts BIGINT NOT NULL DEFAULT 0 CHECK(attempts>=0),
+ lease_id VARCHAR(36) NOT NULL DEFAULT '',
+ lease_until TIMESTAMPTZ,
+ last_enqueued_at TIMESTAMPTZ,
+ completed_at TIMESTAMPTZ,
+ last_failure_code VARCHAR(64) NOT NULL DEFAULT '',
+ created_at TIMESTAMPTZ NOT NULL,
+ updated_at TIMESTAMPTZ NOT NULL,
+ CHECK((lease_id='' AND lease_until IS NULL) OR (lease_id<>'' AND lease_until IS NOT NULL))
+);
+CREATE INDEX memory_original_dispatch_due ON memory_original_dispatches(next_attempt_at,admission_id) WHERE completed_at IS NULL;
+CREATE FUNCTION memory_original_dispatch_guard() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'original memory dispatch facts cannot be deleted'; END IF;
+ IF OLD.admission_id IS DISTINCT FROM NEW.admission_id OR OLD.payload IS DISTINCT FROM NEW.payload OR
+    OLD.payload_digest IS DISTINCT FROM NEW.payload_digest OR OLD.not_before IS DISTINCT FROM NEW.not_before OR
+    OLD.created_at IS DISTINCT FROM NEW.created_at OR (OLD.completed_at IS NOT NULL AND OLD.completed_at IS DISTINCT FROM NEW.completed_at)
+ THEN RAISE EXCEPTION 'original memory dispatch payload is immutable'; END IF;
+ RETURN NEW;
+END;
+$$;
+CREATE TRIGGER memory_original_dispatch_no_mutation BEFORE UPDATE OR DELETE ON memory_original_dispatches FOR EACH ROW EXECUTE FUNCTION memory_original_dispatch_guard();
+
+-- Append to reserved156. Legacy rows receive controls only, never originals.
+CREATE TABLE memory_policy_control_versions (
+ tenant_id BIGINT PRIMARY KEY, revision BIGINT NOT NULL CHECK(revision>0)
+);
+INSERT INTO memory_policy_control_versions SELECT id,1 FROM tenants;
+CREATE TABLE memory_policy_originals (
+ id TEXT PRIMARY KEY, tenant_id BIGINT NOT NULL, revision BIGINT NOT NULL CHECK(revision>0),
+ policy_json TEXT NOT NULL, policy_digest TEXT NOT NULL CHECK(length(policy_digest)=64),
+ previous_origin_id TEXT NOT NULL DEFAULT '', previous_origin_digest TEXT NOT NULL DEFAULT '',
+ author_selector TEXT NOT NULL, digest TEXT NOT NULL CHECK(length(digest)=64), created_at TIMESTAMPTZ NOT NULL,
+ UNIQUE(tenant_id,revision), CHECK((previous_origin_id='' AND previous_origin_digest='') OR (previous_origin_id<>'' AND length(previous_origin_digest)=64))
+);
+CREATE FUNCTION memory_policy_version_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'memory policy controls are retained'; END IF;
+ IF NEW.tenant_id<>OLD.tenant_id OR NEW.revision<>OLD.revision+1 THEN RAISE EXCEPTION 'memory policy revision must advance'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER memory_policy_version_guard BEFORE UPDATE OR DELETE ON memory_policy_control_versions FOR EACH ROW EXECUTE FUNCTION memory_policy_version_guard();
+CREATE FUNCTION memory_policy_bump() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='UPDATE' THEN
+  IF OLD.id=NEW.id AND OLD.memory_config IS NOT DISTINCT FROM NEW.memory_config AND OLD.deleted_at IS NOT DISTINCT FROM NEW.deleted_at THEN RETURN NEW; END IF;
+ END IF;
+ IF TG_OP='DELETE' OR (TG_OP='UPDATE' AND OLD.id<>NEW.id) THEN
+  INSERT INTO memory_policy_control_versions(tenant_id,revision) VALUES(OLD.id,1) ON CONFLICT(tenant_id) DO UPDATE SET revision=memory_policy_control_versions.revision+1;
+ END IF;
+ IF TG_OP<>'DELETE' THEN
+  INSERT INTO memory_policy_control_versions(tenant_id,revision) VALUES(NEW.id,1) ON CONFLICT(tenant_id) DO UPDATE SET revision=memory_policy_control_versions.revision+1;
+  RETURN NEW;
+ END IF;
+ RETURN OLD;
+END $$;
+CREATE TRIGGER memory_policy_tenant_insert AFTER INSERT ON tenants FOR EACH ROW EXECUTE FUNCTION memory_policy_bump();
+CREATE TRIGGER memory_policy_tenant_update AFTER UPDATE OF id,memory_config,deleted_at ON tenants FOR EACH ROW EXECUTE FUNCTION memory_policy_bump();
+CREATE TRIGGER memory_policy_tenant_delete AFTER DELETE ON tenants FOR EACH ROW EXECUTE FUNCTION memory_policy_bump();
+CREATE FUNCTION memory_policy_original_immutable() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'memory policy originals are immutable'; END $$;
+CREATE TRIGGER memory_policy_original_immutable BEFORE UPDATE OR DELETE ON memory_policy_originals FOR EACH ROW EXECUTE FUNCTION memory_policy_original_immutable();
+CREATE TABLE memory_policy_body_receipts (
+ origin_id TEXT PRIMARY KEY REFERENCES memory_policy_originals(id),origin_digest TEXT NOT NULL,tenant_id BIGINT NOT NULL,
+ slot_id TEXT NOT NULL,body_id TEXT NOT NULL REFERENCES original_body_payloads(id),head_revision BIGINT NOT NULL CHECK(head_revision>0),
+ source_identity_sha256 TEXT NOT NULL,policy_digest TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL
+);
+CREATE TRIGGER memory_policy_body_receipt_immutable BEFORE UPDATE OR DELETE ON memory_policy_body_receipts FOR EACH ROW EXECUTE FUNCTION memory_policy_original_immutable();
+ALTER TABLE memory_original_executions ADD COLUMN policy_origin_id TEXT NOT NULL DEFAULT '';
+ALTER TABLE memory_original_executions ADD COLUMN policy_revision BIGINT NOT NULL DEFAULT 0;
+ALTER TABLE memory_original_executions ADD COLUMN policy_origin_digest TEXT NOT NULL DEFAULT '';
+ALTER TABLE memory_original_executions ADD COLUMN policy_body_receipt_digest TEXT NOT NULL DEFAULT '';
+
+-- Append to reserved156 after the original memory/policy schema. UNKNOWN controls only.
+CREATE TABLE model_original_control_versions(model_id TEXT PRIMARY KEY,definition_revision BIGINT NOT NULL CHECK(definition_revision>0),credential_revision BIGINT NOT NULL CHECK(credential_revision>0),state_epoch BIGINT NOT NULL CHECK(state_epoch>0));
+INSERT INTO model_original_control_versions SELECT id,1,1,1 FROM models;
+CREATE TABLE model_definition_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id BIGINT NOT NULL,revision BIGINT NOT NULL,definition_json TEXT NOT NULL,definition_digest TEXT NOT NULL,previous_id TEXT NOT NULL DEFAULT '',previous_digest TEXT NOT NULL DEFAULT '',author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL,UNIQUE(model_id,revision));
+CREATE TABLE model_credential_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id BIGINT NOT NULL,revision BIGINT NOT NULL,credential_json TEXT NOT NULL,plain_digest TEXT NOT NULL,previous_id TEXT NOT NULL DEFAULT '',previous_digest TEXT NOT NULL DEFAULT '',author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL,UNIQUE(model_id,revision));
+CREATE TABLE model_state_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id BIGINT NOT NULL,epoch BIGINT NOT NULL,definition_id TEXT NOT NULL REFERENCES model_definition_originals(id),credential_id TEXT NOT NULL REFERENCES model_credential_originals(id),status TEXT NOT NULL,is_default BOOLEAN NOT NULL,managed_by TEXT NOT NULL,author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL,UNIQUE(model_id,epoch));
