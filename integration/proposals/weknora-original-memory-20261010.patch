@@ -0,0 +1,50 @@
+package service
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// The same SQL authority readers used by original memory execution authorize
+// the settings producer on its own transaction connection, including directory
+// configuration health and current effective role. No cached request grant.
+func ConfigureTenantMemoryPolicyAuthority(repo interfaces.TenantRepository, material *repository.KnowledgeInputProvenanceStore, groups interfaces.GroupAccessService, directoryRuntime interfaces.DirectoryRuntimeService) {
+	repository.ConfigureTenantMemoryPolicyAuthorizer(repo, func(ctx context.Context, tx *gorm.DB) (context.Context, error) {
+		boundGroups := NewGroupAccessService(repository.NewGroupAccessRepository(tx))
+		var runtime directoryStatusReader = directoryRuntime
+		if original, ok := groups.(*groupAccessService); ok && directoryRuntime == nil {
+			runtime = original.directoryRuntime
+		}
+		status, err := newMemoryDirectoryStatusReader(runtime, tx)
+		if err != nil {
+			return ctx, err
+		}
+		if status != nil {
+			health, err := status.GetStatus(ctx)
+			if err != nil {
+				return ctx, err
+			}
+			if health == nil {
+				return ctx, types.ErrMemoryOriginalUnavailable
+			}
+		}
+		configureGroupAccessDirectoryStatus(boundGroups, status)
+		store := repository.MemoryOriginalTransactionStore(material, tx)
+		if store == nil {
+			return ctx, types.ErrMemoryOriginalUnavailable
+		}
+		repository.ConfigureKnowledgeInputActorGroupAccess(store, boundGroups)
+		return store.RefreshCurrentReadActor(ctx)
+	})
+}
+
+func (s *tenantService) ReplaceMemoryPolicyOriginal(ctx context.Context, tenant uint64, cfg types.MemoryConfig) (*types.MemoryConfig, *types.MemoryPolicyProof, error) {
+	writer, ok := s.repo.(interfaces.MemoryPolicyOriginalWriter)
+	if !ok {
+		return nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	return writer.ReplaceMemoryPolicyOriginal(ctx, tenant, cfg)
+}
diff --git a/internal/application/service/memory_policy_original_sql_actual_test.go b/internal/application/service/memory_policy_original_sql_actual_test.go
new file mode 100644
index 00000000..6b703e93
--- /dev/null
+++ b/internal/application/service/memory_policy_original_sql_actual_test.go
@@ -0,0 +1,488 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+type memoryPolicyRollbackContextKey struct{}
+
+// Real SQL component fixtures use reserved156/75, real current actor/groups,
+// real Schedule/outbox/Handle, original body journals and unchanged input
+// receipts. This is not the still-pending full155/74 migration/application gate.
+func actualPolicyRepository(t *testing.T, f *memAtomicSQLFixture) (interfaces.TenantRepository, interfaces.MemoryPolicyOriginalWriter, interfaces.MemoryPolicyOriginalReader) {
+	t.Helper()
+	repo := repository.NewTenantRepository(f.db)
+	ConfigureTenantMemoryPolicyAuthority(repo, f.machine.f.store, NewGroupAccessService(repository.NewGroupAccessRepository(f.db)), nil)
+	writer, ok := repo.(interfaces.MemoryPolicyOriginalWriter)
+	require.True(t, ok)
+	reader, ok := repo.(interfaces.MemoryPolicyOriginalReader)
+	require.True(t, ok)
+	return repo, writer, reader
+}
+
+func actualPolicyFacts(t *testing.T, f *memAtomicSQLFixture) (types.MemoryConfig, types.MemoryPolicyProof, uint64, int64) {
+	t.Helper()
+	repo, _, _ := actualPolicyRepository(t, f)
+	row, err := repo.GetTenantByID(f.ctx, 7)
+	require.NoError(t, err)
+	var cfg types.MemoryConfig
+	wire, err := types.MemoryPolicyBytes(row.MemoryConfig)
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(wire, &cfg))
+	var version struct{ Revision uint64 }
+	require.NoError(t, f.db.Table("memory_policy_control_versions").Where("tenant_id=7").Take(&version).Error)
+	var count int64
+	require.NoError(t, f.db.Model(&types.MemoryPolicyOriginal{}).Where("tenant_id=7").Count(&count).Error)
+	var proof types.MemoryPolicyProof
+	_, _, reader := actualPolicyRepository(t, f)
+	_, known, err := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+	if err == nil {
+		require.NotNil(t, known)
+		proof = *known
+	}
+	return cfg, proof, version.Revision, count
+}
+
+func runMemoryPolicyOriginalAuthoringSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"full_custom_replacement", "cached_role_revoked", "author_inactive", "invalid_full_replacement", "writer_transaction_rollback", "raw_sql_unknown_and_reauthor", "raw_sql_ABA_retains_revision", "immutable_origin_and_control", "delete_recreate_retains_unknown_control"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			repo, writer, reader := actualPolicyRepository(t, f)
+			before, proof, revision, count := actualPolicyFacts(t, f)
+			cfg := before
+			cfg.ExtractInstructions = actualMemoryCurrentRules
+			switch mode {
+			case "cached_role_revoked":
+				require.NoError(t, f.db.Model(&types.TenantMember{}).Where("tenant_id=7 AND user_id=?", types.CallerFromContext(f.ctx).UserID).Update("role", types.TenantRoleViewer).Error)
+			case "author_inactive":
+				require.NoError(t, f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false).Error)
+			case "invalid_full_replacement":
+				cfg.MaxItems = -1
+			case "writer_transaction_rollback":
+				owned, cancel := context.WithCancel(context.WithValue(f.ctx, memoryPolicyRollbackContextKey{}, true))
+				var hookTriggered atomic.Bool
+				name := "policy-original-cancel-after-real-insert"
+				require.NoError(t, f.db.Callback().Create().After("gorm:create").Register(name, func(tx *gorm.DB) {
+					if tx.Statement.Table == "memory_policy_originals" && tx.Statement.Context.Value(memoryPolicyRollbackContextKey{}) == true && tx.Error == nil {
+						hookTriggered.Store(true)
+						cancel()
+					}
+				}))
+				t.Cleanup(func() { f.db.Callback().Create().Remove(name); cancel() })
+				_, _, err := writer.ReplaceMemoryPolicyOriginal(owned, 7, cfg)
+				require.Error(t, err)
+				require.True(t, hookTriggered.Load(), "the real original insert must trigger the owned cancellation")
+				require.ErrorIs(t, owned.Err(), context.Canceled)
+				after, afterProof, afterRevision, afterCount := actualPolicyFacts(t, f)
+				require.Equal(t, before, after)
+				require.Equal(t, proof, afterProof)
+				require.Equal(t, revision, afterRevision)
+				require.Equal(t, count, afterCount)
+				return
+			case "raw_sql_unknown_and_reauthor", "raw_sql_ABA_retains_revision":
+				row, err := repo.GetTenantByID(f.ctx, 7)
+				require.NoError(t, err)
+				row.MemoryConfig = &cfg
+				require.NoError(t, repo.UpdateTenant(f.ctx, row), "generic CRUD never produces an origin")
+				_, _, err = reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+				require.Error(t, err)
+				if mode == "raw_sql_ABA_retains_revision" {
+					row.MemoryConfig = &before
+					require.NoError(t, repo.UpdateTenant(f.ctx, row))
+					_, _, err = reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+					require.Error(t, err, "same bytes do not restore the original revision")
+					after, unknown, afterRevision, afterCount := actualPolicyFacts(t, f)
+					require.Equal(t, before, after)
+					require.False(t, unknown.Valid())
+					require.Greater(t, afterRevision, revision)
+					require.Equal(t, count, afterCount)
+					return
+				}
+				_, newProof, err := writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, cfg)
+				require.NoError(t, err)
+				var origin types.MemoryPolicyOriginal
+				require.NoError(t, f.db.Where("id=?", newProof.OriginID).Take(&origin).Error)
+				require.Empty(t, origin.PreviousOriginID, "a real replacement of UNKNOWN starts a new root, never adopts its raw parent")
+				return
+			case "immutable_origin_and_control":
+				require.Error(t, f.db.Model(&types.MemoryPolicyOriginal{}).Where("id=?", proof.OriginID).Update("policy_json", "{}").Error)
+				require.Error(t, f.db.Where("id=?", proof.OriginID).Delete(&types.MemoryPolicyOriginal{}).Error)
+				require.Error(t, f.db.Exec("UPDATE memory_policy_control_versions SET revision=? WHERE tenant_id=7", revision-1).Error)
+				require.Error(t, f.db.Exec("DELETE FROM memory_policy_control_versions WHERE tenant_id=7").Error)
+				if !pg {
+					require.Error(t, f.db.Exec("INSERT OR REPLACE INTO memory_policy_control_versions(tenant_id,revision) VALUES(7,?)", revision).Error)
+					require.Error(t, f.db.Exec("INSERT OR REPLACE INTO memory_policy_originals SELECT * FROM memory_policy_originals WHERE id=?", proof.OriginID).Error)
+				}
+				_, loaded, err := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+				require.NoError(t, err)
+				require.Equal(t, proof, *loaded)
+				return
+			case "delete_recreate_retains_unknown_control":
+				// A separate real tenant has no knowledge/session children. Its
+				// retained policy fact/control survives actual deletion/recreation.
+				caller := types.CallerFromContext(f.ctx)
+				caller.TenantID = 19
+				ctx := types.WithExecutionTenant(types.WithCaller(f.ctx, caller), 19)
+				row := &types.Tenant{ID: 19, Name: "owned policy lifecycle fixture", Status: "active", MemoryConfig: &cfg}
+				require.NoError(t, repo.CreateTenant(ctx, row))
+				require.NoError(t, f.db.Create(&types.TenantMember{TenantID: 19, UserID: caller.UserID, Role: types.TenantRoleAdmin, Status: types.TenantMemberStatusActive}).Error)
+				_, _, err := reader.ReadMemoryPolicyOriginal(ctx, 19)
+				require.ErrorIs(t, err, repository.ErrMemoryPolicyOriginUnknown)
+				_, original, err := writer.ReplaceMemoryPolicyOriginal(ctx, 19, cfg)
+				require.NoError(t, err)
+				require.NoError(t, repo.DeleteTenant(ctx, 19))
+				require.NoError(t, f.db.Unscoped().Where("id=19").Delete(&types.Tenant{}).Error)
+				row = &types.Tenant{ID: 19, Name: "owned recreated policy lifecycle fixture", Status: "active", MemoryConfig: &cfg}
+				require.NoError(t, repo.CreateTenant(ctx, row))
+				_, _, err = reader.ReadMemoryPolicyOriginal(ctx, 19)
+				require.ErrorIs(t, err, repository.ErrMemoryPolicyOriginUnknown)
+				var retained types.MemoryPolicyOriginal
+				require.NoError(t, f.db.Where("id=?", original.OriginID).Take(&retained).Error)
+				require.Equal(t, original.OriginDigest, retained.Digest)
+				var retainedBody types.MemoryPolicyBodyReceipt
+				require.NoError(t, f.db.Where("origin_id=?", original.OriginID).Take(&retainedBody).Error)
+				require.Equal(t, original.BodyReceiptDigest, retainedBody.Digest)
+				var control struct{ Revision uint64 }
+				require.NoError(t, f.db.Table("memory_policy_control_versions").Where("tenant_id=19").Take(&control).Error)
+				require.Greater(t, control.Revision, original.Revision)
+				return
+			}
+			actual, newProof, err := writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, cfg)
+			if mode != "full_custom_replacement" {
+				require.Error(t, err)
+				after, afterProof, afterRevision, afterCount := actualPolicyFacts(t, f)
+				require.Equal(t, before, after)
+				require.Equal(t, proof, afterProof)
+				require.Equal(t, revision, afterRevision)
+				require.Equal(t, count, afterCount)
+				return
+			}
+			require.NoError(t, err)
+			require.True(t, newProof.Valid())
+			require.Equal(t, actualMemoryCurrentRules, actual.ExtractInstructions)
+			stored, loaded, err := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+			require.NoError(t, err)
+			require.Equal(t, actual, stored)
+			require.Equal(t, *newProof, *loaded)
+			var origin types.MemoryPolicyOriginal
+			require.NoError(t, f.db.Where("id=?", newProof.OriginID).Take(&origin).Error)
+			require.Equal(t, proof.OriginID, origin.PreviousOriginID)
+			require.Equal(t, proof.OriginDigest, origin.PreviousOriginDigest)
+			require.True(t, origin.CreatedAt.Equal(origin.CreatedAt.UTC().Truncate(time.Microsecond)), "PG roundtrip retains the digest's canonical timestamp")
+		})
+	}
+}
+
+func runMemoryPolicyOriginalQueueSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"custom_before_queue", "authored_current_custom_after_queue", "same_policy_reauthor_after_queue", "authored_ABA_after_queue", "raw_policy_after_queue", "raw_ABA_after_queue", "reauthor_after_raw_gap", "authored_after_model", "raw_ABA_after_model"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			repo, writer, reader := actualPolicyRepository(t, f)
+			cfg, _, err := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+			require.NoError(t, err)
+			if mode == "custom_before_queue" {
+				cfg.ExtractInstructions = actualMemoryCurrentRules
+				_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+				require.NoError(t, err)
+			}
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			input, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, before.OriginalAdmissionID)
+			require.NoError(t, err)
+			require.True(t, input.Request.EnqueuePolicyProof.Valid())
+			require.Equal(t, input.Request.EnqueuePolicyDigest, input.Request.EnqueuePolicyProof.PolicyDigest)
+			var originalRow types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", input.ID).Take(&originalRow).Error)
+			relayMemAtomicSQLScheduled(t, f)
+			rawABA := func() error {
+				row, e := repo.GetTenantByID(f.ctx, 7)
+				if e != nil {
+					return e
+				}
+				saved := *row.MemoryConfig
+				changed := saved
+				changed.MaxItems = saved.MaxItems - 1
+				row.MemoryConfig = &changed
+				if e = repo.UpdateTenant(f.ctx, row); e != nil {
+					return e
+				}
+				row.MemoryConfig = &saved
+				return repo.UpdateTenant(f.ctx, row)
+			}
+			switch mode {
+			case "authored_current_custom_after_queue":
+				cfg.ExtractInstructions = actualMemoryCurrentRules
+				_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+				require.NoError(t, err)
+			case "same_policy_reauthor_after_queue":
+				_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+				require.NoError(t, err)
+			case "authored_ABA_after_queue":
+				changed := *cfg
+				changed.MaxItems = cfg.MaxItems - 1
+				_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, changed)
+				require.NoError(t, err)
+				_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+				require.NoError(t, err)
+			case "raw_policy_after_queue":
+				row, e := repo.GetTenantByID(f.ctx, 7)
+				require.NoError(t, e)
+				row.MemoryConfig.MaxItems--
+				require.NoError(t, repo.UpdateTenant(f.ctx, row))
+			case "raw_ABA_after_queue", "reauthor_after_raw_gap":
+				require.NoError(t, rawABA())
+				if mode == "reauthor_after_raw_gap" {
+					_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+					require.NoError(t, err)
+				}
+			case "authored_after_model":
+				f.model.afterCall = func() error { _, _, e := writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg); return e }
+			case "raw_ABA_after_model":
+				f.model.afterCall = rawABA
+			}
+			worker, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			err = f.service.Handle(worker, f.queue.task)
+			cancel()
+			legal := mode == "custom_before_queue" || mode == "authored_current_custom_after_queue" || mode == "same_policy_reauthor_after_queue" || mode == "authored_ABA_after_queue"
+			if legal {
+				require.NoError(t, err)
+				require.Equal(t, 1, f.model.calls)
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+				if mode == "custom_before_queue" || mode == "authored_current_custom_after_queue" {
+					require.Contains(t, f.model.prompts[0], actualMemoryCurrentRules, "custom instructions remain a legitimate product input")
+				}
+				var execution types.MemoryOriginalExecution
+				require.NoError(t, f.db.Where("input_admission_id=?", input.ID).Take(&execution).Error)
+				_, current, e := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+				require.NoError(t, e)
+				require.Equal(t, current.OriginID, execution.PolicyOriginID)
+				require.Equal(t, current.Revision, execution.PolicyRevision)
+				require.Equal(t, current.OriginDigest, execution.PolicyOriginDigest)
+				require.Equal(t, current.BodyReceiptDigest, execution.PolicyBodyReceiptDigest)
+				var actualPayload types.MemoryExtractPayload
+				require.NotNil(t, f.queue.task)
+				require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &actualPayload))
+				completed, e := f.admissions.(interface {
+					VerifyMemoryOriginalCompletion(context.Context, types.MemoryExtractPayload) (bool, error)
+				}).VerifyMemoryOriginalCompletion(f.ctx, actualPayload)
+				require.NoError(t, e)
+				require.True(t, completed)
+			} else {
+				assert.Error(t, err)
+				want := 0
+				if mode == "authored_after_model" || mode == "raw_ABA_after_model" {
+					want = 1
+				}
+				assert.Equal(t, want, f.model.calls)
+				assertMemAtomicSQLNoEffects(t, f, before)
+			}
+			var retained types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", input.ID).Take(&retained).Error)
+			require.Equal(t, originalRow, retained, "policy selection never rewrites or re-signs the original queued input")
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
