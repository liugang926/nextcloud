@@ -0,0 +1,161 @@
+package repository
+
+import (
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+func verifyMemoryGeneratedPublicationInTx(tx *gorm.DB, fact *types.MemoryDerivedPublication, hold *memoryDerivedHold) error {
+	original, err := loadMemoryGeneratedOriginal(tx, fact.InputAdmissionID)
+	if err != nil {
+		return err
+	}
+	if fact.TenantID != original.TenantID || fact.SubjectID != original.SubjectID || fact.ExecutionAdmissionID != original.ID || fact.DerivationID != "" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var receipt types.MemoryGeneratedReceipt
+	if err = tx.Session(&gorm.Session{NewDB: true}).Select(memoryGeneratedReceiptFields).Where("id=? AND original_id=?", fact.CommitID, original.ID).Take(&receipt).Error; err != nil {
+		return err
+	}
+	digest, err := memoryGeneratedReceiptDigest(&receipt)
+	if err != nil || digest != receipt.Digest || receipt.OriginalDigest != original.Digest || receipt.TenantID != original.TenantID || receipt.SubjectID != original.SubjectID || receipt.Recipe != original.Recipe || types.MemoryOriginalBytesDigest([]byte(receipt.EffectManifest)) != receipt.EffectDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var effects []types.MemoryGeneratedEffect
+	if json.Unmarshal([]byte(receipt.EffectManifest), &effects) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var command types.MemoryConsolidationCommand
+	if json.Unmarshal([]byte(original.RequestJSON), &command) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if original.Recipe == types.MemoryConsolidationMaintenanceRecipe || !command.ObservedAt.IsZero() {
+		if err = validateMemoryConsolidationCommand(original, &command); err != nil {
+			return err
+		}
+	} else if len(command.Demotions) != 0 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	demoted := map[string]bool{}
+	found := false
+	seen := map[string]bool{}
+	for _, effect := range effects {
+		if effect.Action == "" || seen[effect.Proof.PublicationID] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[effect.Proof.PublicationID] = true
+		if original.Recipe == types.MemoryConsolidationMaintenanceRecipe && effect.Action != "stale_demote" && effect.Action != "capacity_archive" && effect.Action != "resident_block" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if effect.Action == "stale_demote" {
+			matched := false
+			for _, target := range command.Demotions {
+				if effect.Proof.ObjectKind == "memory_item" && target.Proof.ObjectID == effect.Proof.ObjectID && target.Proof.PublicationID == effect.ParentPublicationID && !demoted[effect.Proof.ObjectID] {
+					matched = true
+					break
+				}
+			}
+			if !matched {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			demoted[effect.Proof.ObjectID] = true
+		}
+		child, err := loadMemoryDerivedPublication(tx, effect.Proof.PublicationID)
+		if err != nil {
+			return err
+		}
+		if child.ProducerKind != "generated" || child.CommitID != receipt.ID || child.InputAdmissionID != original.ID || child.ParentPublicationID != effect.ParentPublicationID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		proof, _, err := memoryDerivedProofInTx(tx, child)
+		if err != nil || proof != effect.Proof {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if child.ID == fact.ID {
+			found = true
+		}
+	}
+	var count int64
+	if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryDerivedPublication{}).Where("producer_kind='generated' AND commit_id=?", receipt.ID).Count(&count).Error; err != nil {
+		return err
+	}
+	if !found || len(demoted) != len(command.Demotions) || count != int64(len(effects)) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var manifest types.MemoryDerivedManifest
+	if json.Unmarshal([]byte(original.DerivedInputsJSON), &manifest) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	actual, err := memoryDerivedManifestDigest(manifest)
+	if err != nil || actual != manifest.Digest || manifest.Digest != original.DerivedInputsDigest || manifest.TenantID != original.TenantID || manifest.SubjectID != original.SubjectID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var ids []string
+	if json.Unmarshal([]byte(fact.InputsJSON), &ids) != nil || len(ids) < len(manifest.Inputs) || fact.ObjectKind != "memory_block" && len(ids) != len(manifest.Inputs) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	for index, proof := range manifest.Inputs {
+		if ids[index] != proof.PublicationID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		parent, err := loadMemoryDerivedPublication(tx, proof.PublicationID)
+		if err != nil {
+			return err
+		}
+		actual, _, err := memoryDerivedProofInTx(tx, parent)
+		if err != nil || actual != proof {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	for _, id := range ids[len(manifest.Inputs):] {
+		child, err := loadMemoryDerivedPublication(tx, id)
+		if err != nil {
+			return err
+		}
+		if child.CommitID != receipt.ID {
+			known := false
+			for _, proof := range manifest.Inputs {
+				if proof.PublicationID == id {
+					known = true
+				}
+			}
+			if !known {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+	}
+	inputHead, err := checkMemoryGeneratedBodyReceiptInTx(tx, "memory_generated_originals", original.ID, original.TenantID, original.InputSHA256, original.Digest)
+	if err != nil {
+		return err
+	}
+	outputHead, err := checkMemoryGeneratedBodyReceiptInTx(tx, "memory_generated_receipts", receipt.ID, receipt.TenantID, receipt.ResponseSHA256, receipt.Digest)
+	if err != nil {
+		return err
+	}
+	hold.Heads[inputHead.SlotID] = inputHead
+	hold.Heads[outputHead.SlotID] = outputHead
+	hold.Generations[original.ID] = original
+	return nil
+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryGeneratedActorInTx(tx *gorm.DB, fact *types.MemoryGeneratedOriginal) error {
+	if fact == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var actor types.MemoryOriginalActor
+	if json.Unmarshal([]byte(fact.ActorSelector), &actor) != nil || actor.CallerTenantID != fact.TenantID || actor.Principal.StorageID() != fact.SubjectID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	fresh, err := authority.Store.RestoreMemoryOriginalActor(tx.Statement.Context, actor, fact.TenantID, fact.SubjectID)
+	if err != nil {
+		return err
+	}
+	if err = authority.CheckRuntime(fresh); err != nil {
+		return err
+	}
+	return lockMemoryPolicyAuthor(tx.Session(&gorm.Session{NewDB: true}), fresh, fact.TenantID)
+}
