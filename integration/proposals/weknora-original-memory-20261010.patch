+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"sort"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryOriginalAdmissionRepository struct {
+	db                  *gorm.DB
+	material            *KnowledgeInputProvenanceStore
+	authorityFactory    MemoryOriginalTransactionAuthorityFactory
+	historicalModels    *MemoryDerivedHistoricalModelAuthority
+	modelReadAuthorizer ModelOriginalHistoricalAuthorizer
+	generatedModels     *MemoryGeneratedModelAuthority
+	generatedLeaseIds   func(context.Context) ([]string, error)
+}
+
+func NewMemoryOriginalAdmissionRepository(db *gorm.DB, material *KnowledgeInputProvenanceStore) interfaces.MemoryOriginalAdmissionRepository {
+	return &memoryOriginalAdmissionRepository{db: db, material: material}
+}
+
+func originalMemoryDigest(input *types.MemoryOriginalInput) (string, error) {
+	copy := *input
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+
+func loadMemoryOriginal(tx *gorm.DB, id string) (*types.MemoryOriginalInput, error) {
+	if id == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var row types.MemoryOriginalAdmission
+	if err := tx.Where("id=?", id).Take(&row).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		return nil, err
+	}
+	var input types.MemoryOriginalInput
+	if json.Unmarshal([]byte(row.Envelope), &input) != nil || input.Material == nil || input.Plan == nil || len(input.Material.Messages) != 0 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	digest, err := originalMemoryDigest(&input)
+	q := input.Request
+	if err != nil || digest == "" || digest != row.Digest || digest != input.Digest || input.ID != row.ID || q.TenantID != row.TenantID || q.SubjectID != row.SubjectID || q.SessionID != row.SessionID || q.PendingRevision != row.PendingRevision || q.PreviousAdmissionID != row.PreviousAdmissionID || input.Actor.CallerTenantID != q.TenantID || input.Actor.Principal.StorageID() != q.SubjectID {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &input, nil
+}
+
+func sameMemoryCursor(a, b types.MemoryMessageCursor) bool { return a.ID == b.ID && a.At.Equal(b.At) }
+
+func memoryOriginalProgress(tx *gorm.DB, scope interfaces.MemoryScope, session string) (*types.MemoryExtractionSession, error) {
+	var row types.MemoryExtractionSession
+	err := extractionRows(tx, scope).Where("session_id=?", session).Take(&row).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	return &row, err
+}
+
+// Preparation reads identities only. Actual bytes/proofs are captured by the
+// original reader under its own actor/source/body leases before Admit.
+func (r *memoryOriginalAdmissionRepository) PrepareMemoryOriginalCapture(ctx context.Context, scope interfaces.MemoryScope, session, trigger, model, language, policy string) (*types.MemoryOriginalCaptureRequest, error) {
+	if !scope.Valid() || session == "" || trigger == "" || policy == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	q := &types.MemoryOriginalCaptureRequest{TenantID: scope.TenantID, SubjectID: scope.SubjectID, SessionID: session, TriggerMessageID: trigger, ChatModelID: model, Language: language, EnqueuePolicyDigest: policy, PendingRevision: 1}
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var tenant types.Tenant
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", scope.TenantID).Take(&tenant).Error; err != nil {
+			return err
+		}
+		_, origin, err := readMemoryPolicyOriginalInTx(tx, &tenant)
+		if err != nil {
+			return err
+		}
+		if origin.PolicyDigest != policy {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		q.EnqueuePolicyProof = origin.Proof()
+		progress, err := memoryOriginalProgress(tx, scope, session)
+		if err != nil {
+			return err
+		}
+		ids := map[string]bool{}
+		if progress != nil {
+			q.PendingRevision = progress.Revision + 1
+			q.FromCursor = progress.Cursor
+			q.PreviousAdmissionID = progress.OriginalAdmissionID
+			q.PreviousCheckpointID = progress.OriginalCheckpointID
+			if q.PreviousAdmissionID == "" {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			previous, err := loadMemoryOriginal(tx, q.PreviousAdmissionID)
+			if err != nil {
+				return err
+			}
+			// A nonempty cursor needs an immutable successful checkpoint. That
+			// producer is a separate required slice; current rows are not proof.
+			if !sameMemoryCursor(q.FromCursor, previous.Request.FromCursor) {
+				if err := verifyMemoryCheckpointChain(tx, previous, progress.OriginalCheckpointID, q.FromCursor); err != nil {
+					return err
+				}
+			}
+			for _, id := range previous.Request.MaterialRequest.MessageIDs {
+				ids[id] = true
+			}
+		}
+		var bound struct {
+			ID          string
+			CreatedAt   time.Time
+			Role        string
+			IsCompleted bool
+		}
+		if err := tx.Table("messages").Select("id,created_at,role,is_completed").Where("id=? AND session_id=?", trigger, session).Take(&bound).Error; err != nil {
+			return err
+		}
+		if bound.Role != "assistant" || !bound.IsCompleted {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		q.UpperCursor = types.MemoryMessageCursor{At: bound.CreatedAt, ID: bound.ID}
+		var rows []struct{ ID string }
+		query := tx.Table("messages").Select("id").Where("session_id=? AND (created_at<? OR (created_at=? AND id<=?))", session, bound.CreatedAt, bound.CreatedAt, bound.ID)
+		// Capture the bounded new page and prior context together. No worker
+		// can expand this set from a later mutable history query.
+		if err := query.Order("created_at DESC,id DESC").Limit(129).Scan(&rows).Error; err != nil {
+			return err
+		}
+		if len(rows) > 128 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		for _, row := range rows {
+			ids[row.ID] = true
+		}
+		if len(ids) == 0 || len(ids) > 128 || !ids[trigger] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		q.MaterialRequest = types.MessageMaterialReadRequest{TenantID: scope.TenantID, SessionID: session}
+		for id := range ids {
+			q.MaterialRequest.MessageIDs = append(q.MaterialRequest.MessageIDs, id)
+		}
+		sort.Strings(q.MaterialRequest.MessageIDs)
+		return ctx.Err()
+	})
+	return q, err
+}
+
+// A composite is authenticated only by a genuine new enqueue capture, with
+// every old immutable proof/control unchanged and every added ID independently
+// producer-admitted. Old bodies or lineage are never freshly signed here.
+func checkMemoryOriginalAppend(previous, next *types.MemoryOriginalInput) error {
+	if previous == nil || next == nil || previous.Material == nil || next.Material == nil || previous.Plan == nil || next.Plan == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	a, b := previous.Request, next.Request
+	if b.PreviousAdmissionID != previous.ID || b.PendingRevision != a.PendingRevision+1 || a.TenantID != b.TenantID || a.SubjectID != b.SubjectID || a.SessionID != b.SessionID || (!sameMemoryCursor(a.FromCursor, b.FromCursor) && b.PreviousCheckpointID == "") || !faqInputEqual(previous.Actor, next.Actor) || previous.Material.SessionOwnerID != next.Material.SessionOwnerID || previous.Material.SessionOwnerRevision != next.Material.SessionOwnerRevision {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	proofs := map[string]*types.MessageMaterialProof{}
+	controls := map[string]*types.MessageMaterialCandidateControl{}
+	for _, p := range next.Material.Proofs {
+		if p == nil || proofs[p.MessageID] != nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		proofs[p.MessageID] = p
+	}
+	for _, c := range next.Plan.Controls {
+		if c == nil || controls[c.ID] != nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		controls[c.ID] = c
+	}
+	for _, p := range previous.Material.Proofs {
+		if p == nil || !faqInputEqual(p, proofs[p.MessageID]) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	for _, c := range previous.Plan.Controls {
+		if c == nil || !faqInputEqual(c, controls[c.ID]) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	added := len(next.Material.Proofs) - len(previous.Material.Proofs)
+	if added < 0 || next.Material.MembershipRevision != previous.Material.MembershipRevision+uint64(added) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+
+func checkMemoryOriginalAppendInTx(tx *gorm.DB, previous, next *types.MemoryOriginalInput) error {
+	if err := checkMemoryOriginalAppend(previous, next); err != nil {
+		return err
+	}
+	if !sameMemoryCursor(previous.Request.FromCursor, next.Request.FromCursor) {
+		return verifyMemoryCheckpointChain(tx, previous, next.Request.PreviousCheckpointID, next.Request.FromCursor)
+	}
+	return nil
+}
+
+func (r *memoryOriginalAdmissionRepository) AdmitMemoryOriginal(ctx context.Context, input *types.MemoryOriginalInput, timeout time.Duration) (*types.MemorySubject, bool, error) {
+	if input == nil || input.Material == nil || input.Plan == nil || len(input.Material.Messages) != 0 || len(input.Material.Proofs) == 0 || input.ID != "" || input.Digest != "" {
+		return nil, false, types.ErrMemoryOriginalUnavailable
+	}
+	q := input.Request
+	scope := interfaces.MemoryScope{TenantID: q.TenantID, SubjectID: q.SubjectID}
+	if !scope.Valid() || q.PendingRevision == 0 || q.EnqueuePolicyDigest == "" {
+		return nil, false, types.ErrMemoryOriginalUnavailable
+	}
+	var previousSubject types.MemorySubject
+	shouldSend := false
+	input.ID = uuid.NewString()
+	err := (&memoryRepository{db: r.db}).withSubject(ctx, scope, func(tx *gorm.DB, subject *types.MemorySubject) error {
+		previousSubject = *subject
+		if !subject.Enabled || len(subject.PendingSessions) != 0 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		progress, err := memoryOriginalProgress(tx, scope, q.SessionID)
+		if err != nil {
+			return err
+		}
+		if progress == nil {
+			if q.PendingRevision != 1 || q.PreviousAdmissionID != "" || !q.FromCursor.At.IsZero() || q.FromCursor.ID != "" || subject.ExtractCursor != nil {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		} else {
+			if q.PendingRevision != progress.Revision+1 || q.PreviousAdmissionID != progress.OriginalAdmissionID || !sameMemoryCursor(q.FromCursor, progress.Cursor) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			previous, err := loadMemoryOriginal(tx, progress.OriginalAdmissionID)
+			if err != nil {
+				return err
+			}
+			if err := checkMemoryOriginalAppendInTx(tx, previous, input); err != nil {
+				return err
+			}
+		}
+		marked, err := WithMessageMaterialReadPlan(ctx, input.Plan)
+		if err != nil {
+			return err
+		}
+		if err := r.lockMemoryOriginalFence(marked, tx, input); err != nil {
+			return err
+		}
+		if err := r.checkMemoryOriginalInTx(marked, tx, input); err != nil {
+			return err
+		}
+		if err := checkMemoryEnqueueModelInTx(tx, input); err != nil {
+			return err
+		}
+		input.Digest, err = originalMemoryDigest(input)
+		if err != nil {
+			return err
+		}
+		encoded, err := json.Marshal(input)
+		if err != nil {
+			return err
+		}
+		fact := &types.MemoryOriginalAdmission{ID: input.ID, TenantID: q.TenantID, SubjectID: q.SubjectID, SessionID: q.SessionID, PendingRevision: q.PendingRevision, PreviousAdmissionID: q.PreviousAdmissionID, Digest: input.Digest, Envelope: string(encoded), CreatedAt: memoryFactTime()}
+		if err := tx.Create(fact).Error; err != nil {
+			return err
+		}
+		if progress == nil {
+			progress = &types.MemoryExtractionSession{TenantID: q.TenantID, SubjectID: q.SubjectID, SessionID: q.SessionID, Revision: q.PendingRevision, OriginalAdmissionID: input.ID, Pending: true, UpdatedAt: time.Now()}
+			if err := tx.Create(progress).Error; err != nil {
+				return err
+			}
+		} else {
+			result := extractionRows(tx, scope).Where("session_id=? AND revision=? AND original_admission_id=?", q.SessionID, progress.Revision, progress.OriginalAdmissionID).Updates(map[string]interface{}{"revision": q.PendingRevision, "original_admission_id": input.ID, "original_checkpoint_id": "", "pending": true, "updated_at": time.Now()})
+			if result.Error != nil {
+				return result.Error
+			}
+			if result.RowsAffected != 1 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		now := time.Now()
+		running := subject.ExtractionState.LeaseID != "" && subject.ExtractionState.LeaseUntil.After(now)
+		queued := subject.ExtractScheduledAt != nil && now.Sub(*subject.ExtractScheduledAt) < timeout
+		if !running && !queued {
+			subject.ExtractScheduledAt = &now
+			shouldSend = true
+		}
+		if err := createMemoryOriginalDispatchInTx(tx, input); err != nil {
+			return err
+		}
+		if err := saveExtractionState(tx, subject); err != nil {
+			return err
+		}
+		return ctx.Err()
+	})
+	return &previousSubject, shouldSend, err
+}
+
+func (r *memoryOriginalAdmissionRepository) LoadMemoryOriginalAdmission(ctx context.Context, id string) (*types.MemoryOriginalInput, error) {
+	var input *types.MemoryOriginalInput
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var err error
+		input, err = loadMemoryOriginal(tx, id)
+		if err != nil {
+			return err
+		}
+		q := input.Request
+		progress, err := memoryOriginalProgress(tx, interfaces.MemoryScope{TenantID: q.TenantID, SubjectID: q.SubjectID}, q.SessionID)
+		if err != nil {
+			return err
+		}
+		if progress == nil || !progress.Pending || progress.OriginalAdmissionID != id || progress.Revision != q.PendingRevision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if !sameMemoryCursor(progress.Cursor, q.FromCursor) {
+			if err := verifyMemoryCheckpointChain(tx, input, progress.OriginalCheckpointID, progress.Cursor); err != nil {
+				return err
+			}
+		}
+		return ctx.Err()
+	})
+	return input, err
+}
+
+func (r *memoryOriginalAdmissionRepository) ResolveMemoryOriginalTask(ctx context.Context, payload types.MemoryExtractPayload) (*types.MemoryOriginalInput, error) {
+	var latest *types.MemoryOriginalInput
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		original, err := loadMemoryOriginal(tx, payload.OriginalAdmissionID)
+		if err != nil {
+			return err
+		}
+		q := original.Request
+		if payload.OriginalDigest != original.Digest || payload.OriginalRevision != q.PendingRevision || payload.TenantID != q.TenantID || payload.SubjectID != q.SubjectID || payload.SessionID != q.SessionID || payload.MessageID != q.TriggerMessageID || payload.ChatModelID != q.ChatModelID || payload.Language != q.Language {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		progress, err := memoryOriginalProgress(tx, interfaces.MemoryScope{TenantID: q.TenantID, SubjectID: q.SubjectID}, q.SessionID)
+		if err != nil {
+			return err
+		}
+		if progress == nil || !progress.Pending {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		latest, err = loadMemoryOriginal(tx, progress.OriginalAdmissionID)
+		if err != nil {
+			return err
+		}
+		if latest.Request.PendingRevision != progress.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if !sameMemoryCursor(latest.Request.FromCursor, progress.Cursor) {
+			if err := verifyMemoryCheckpointChain(tx, latest, progress.OriginalCheckpointID, progress.Cursor); err != nil {
+				return err
+			}
+		}
+		cursor := latest
+		for n := 0; n < 128; n++ {
+			if cursor.ID == original.ID {
+				return ctx.Err()
+			}
+			parent, err := loadMemoryOriginal(tx, cursor.Request.PreviousAdmissionID)
+			if err != nil {
+				return err
+			}
+			if err := checkMemoryOriginalAppendInTx(tx, parent, cursor); err != nil {
+				return err
+			}
+			cursor = parent
+		}
+		return types.ErrMemoryOriginalUnavailable
+	})
+	return latest, err
+}
+
+// This first slice has no derived-memory original reader. Query metadata only
+// and preserve unknown rows; never fetch their current bytes as model inputs.
+func (r *memoryOriginalAdmissionRepository) CheckMemoryDerivedInputsAbsent(ctx context.Context, scope interfaces.MemoryScope) error {
+	if !scope.Valid() {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	for _, model := range []interface{}{&types.MemoryItem{}, &types.MemoryTombstone{}, &types.MemoryTopicStat{}} {
+		var count int64
+		if err := r.db.WithContext(ctx).Model(model).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Count(&count).Error; err != nil {
+			return err
+		}
+		if count != 0 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	return ctx.Err()
+}
diff --git a/internal/application/repository/memory_original_admission_test.go b/internal/application/repository/memory_original_admission_test.go
new file mode 100644
index 00000000..020aefa7
--- /dev/null
+++ b/internal/application/repository/memory_original_admission_test.go
@@ -0,0 +1,80 @@
+package repository
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+// Wire tests exercise the real immutable envelope serializer/composite
+// checker. They do not assert source authorization or an actual SQL gate.
+func memoryOriginalWireFixture() *types.MemoryOriginalInput {
+	lineage, _ := types.NewCompleteSourceLineage()
+	proof := &types.MessageMaterialProof{MessageID: "message-a", AdmissionID: "admission-a", GenerationID: "generation-a", BodyDigest: "body-a", Revision: 1, SourceLineage: lineage, GeneratedFields: []*types.MessageGeneratedFieldProof{{AdmissionID: "field-a", Field: "images", BodyDigest: "field-body-a", Revision: 1, SourceLineage: lineage}}}
+	return &types.MemoryOriginalInput{ID: "enqueue-a", Request: types.MemoryOriginalCaptureRequest{PendingRevision: 1}, Material: &types.MessageMaterialSnapshot{MembershipRevision: 1, Proofs: []*types.MessageMaterialProof{proof}}, Plan: &types.MessageMaterialReadPlan{Controls: []*types.MessageMaterialCandidateControl{{ID: "message-a", AdmissionID: "admission-a", GenerationID: "generation-a", Revision: 1}}, SourceLineage: lineage}}
+}
+
+func cloneMemoryOriginalWire(t *testing.T, input *types.MemoryOriginalInput) *types.MemoryOriginalInput {
+	t.Helper()
+	wire, err := json.Marshal(input)
+	require.NoError(t, err)
+	var out types.MemoryOriginalInput
+	require.NoError(t, json.Unmarshal(wire, &out))
+	return &out
+}
+
+func TestMemoryOriginalAdmissionWireBindsSourceProofLineage(t *testing.T) {
+	input := memoryOriginalWireFixture()
+	before, err := originalMemoryDigest(input)
+	require.NoError(t, err)
+	copy := cloneMemoryOriginalWire(t, input)
+	after, err := originalMemoryDigest(copy)
+	require.NoError(t, err)
+	require.Equal(t, before, after)
+	require.NoError(t, copy.Material.Proofs[0].SourceLineage.RequireComplete())
+	copy.Material.Proofs[0].SourceLineage = types.UnknownSourceLineage()
+	changed, err := originalMemoryDigest(copy)
+	require.NoError(t, err)
+	require.NotEqual(t, before, changed)
+	copy = cloneMemoryOriginalWire(t, input)
+	copy.Material.Proofs[0].GeneratedFields[0].SourceLineage = types.UnknownSourceLineage()
+	changed, err = originalMemoryDigest(copy)
+	require.NoError(t, err)
+	require.NotEqual(t, before, changed)
+}
+
+func TestMemoryOriginalCompositeAppendKeepsOriginalProofs(t *testing.T) {
+	for _, mode := range []string{"producer_append", "changed_source_lineage", "changed_generated_lineage", "changed_admission", "missing_old_control", "wrong_membership"} {
+		t.Run(mode, func(t *testing.T) {
+			old := memoryOriginalWireFixture()
+			next := cloneMemoryOriginalWire(t, old)
+			next.ID = "enqueue-b"
+			next.Request.PreviousAdmissionID = old.ID
+			next.Request.PendingRevision = 2
+			next.Material.MembershipRevision = 2
+			lineage, _ := types.NewCompleteSourceLineage()
+			next.Material.Proofs = append(next.Material.Proofs, &types.MessageMaterialProof{MessageID: "message-b", AdmissionID: "admission-b", GenerationID: "generation-b", Revision: 1, BodyDigest: "body-b", SourceLineage: lineage})
+			next.Plan.Controls = append(next.Plan.Controls, &types.MessageMaterialCandidateControl{ID: "message-b", AdmissionID: "admission-b", GenerationID: "generation-b", Revision: 1})
+			switch mode {
+			case "changed_source_lineage":
+				next.Material.Proofs[0].SourceLineage = types.UnknownSourceLineage()
+			case "changed_generated_lineage":
+				next.Material.Proofs[0].GeneratedFields[0].SourceLineage = types.UnknownSourceLineage()
+			case "changed_admission":
+				next.Material.Proofs[0].AdmissionID = "changed"
+			case "missing_old_control":
+				next.Plan.Controls = next.Plan.Controls[1:]
+			case "wrong_membership":
+				next.Material.MembershipRevision = 3
+			}
+			err := checkMemoryOriginalAppend(old, next)
+			if mode == "producer_append" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorIs(t, err, types.ErrMemoryOriginalUnavailable)
+			}
+		})
+	}
+}
diff --git a/internal/application/repository/memory_original_capacity.go b/internal/application/repository/memory_original_capacity.go
new file mode 100644
index 00000000..0ef9a7a6
--- /dev/null
+++ b/internal/application/repository/memory_original_capacity.go
@@ -0,0 +1,169 @@
+package repository
+
+import (
+	"encoding/json"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+type memoryCapacityRankControl struct {
+	ID                      string
+	TenantID                uint64
+	SubjectID               string
+	Importance              int
+	LastUsedAt              *time.Time
+	ValidFrom               time.Time
+	Status                  string
+	ParentPublicationID     string
+	ParentPublicationDigest string
+	ParentDerivationID      string
+	ParentDerivationDigest  string
+	BodyDigest              string
+}
+
+type memoryOriginalCapacityRetirement struct {
+	TargetID     string
+	Before       *types.MemoryItem
+	After        *types.MemoryItem
+	BeforeDigest string
+	AfterDigest  string
+	Parent       *types.MemoryOriginalDerivation
+	Publication  *types.MemoryDerivedPublication
+}
+
+type memoryOriginalCapacityPlan struct {
+	Scope           interfaces.MemoryScope
+	Keep            int
+	CurrentCommitID string
+	RankedControls  []memoryCapacityRankControl
+	RankingDigest   string
+	Retirements     []memoryOriginalCapacityRetirement
+}
+
+func memoryCapacityItemCopy(item *types.MemoryItem) (*types.MemoryItem, error) {
+	encoded, err := json.Marshal(item)
+	if err != nil {
+		return nil, err
+	}
+	var copy types.MemoryItem
+	if err := json.Unmarshal(encoded, &copy); err != nil {
+		return nil, err
+	}
+	return &copy, nil
+}
+
+// This is a read-only plan, not an output fence or a new original admission.
+// Call only inside CommitMemoryOriginalResult, after all model effects and
+// their original derivations have been created on this same transaction.
+// The caller already owns the original input/actor/source/body/model fences.
+// CurrentCommitID restricts body reads to this producer's own new effects.
+// Older existing material still requires a complete derived-original reader;
+// a matching current-row hash alone never authenticates that material here.
+func memoryCapacityRetirementsInTx(tx *gorm.DB, scope interfaces.MemoryScope, maxItems int, currentCommitID string) (*memoryOriginalCapacityPlan, error) {
+	if tx == nil || tx.Statement == nil || tx.Statement.Context == nil || !scope.Valid() || maxItems <= 0 || currentCommitID == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if _, owned := tx.Statement.ConnPool.(gorm.TxCommitter); !owned {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if tx.Dialector.Name() != "postgres" && tx.Dialector.Name() != "sqlite" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err := tx.Statement.Context.Err(); err != nil {
+		return nil, err
+	}
+
+	// ArchiveLowestRanked uses this exact ranking. Only the final ID tie break
+	// is added so the planned effect manifest is stable for equal rank inputs.
+	// Lock every rank control before choosing survivors. No body is read yet.
+	var ranked []memoryCapacityRankControl
+	if err := tx.Table("memory_items").
+		Select("id, tenant_id, subject_id, importance, last_used_at, valid_from, status").
+		Where("tenant_id=? AND subject_id=? AND status=?", scope.TenantID, scope.SubjectID, types.MemoryStatusActive).
+		Clauses(forUpdateClause()).
+		Order("importance DESC, COALESCE(last_used_at, valid_from) DESC, valid_from DESC, id ASC").
+		Find(&ranked).Error; err != nil {
+		return nil, err
+	}
+	plan := &memoryOriginalCapacityPlan{Scope: scope, Keep: maxItems, CurrentCommitID: currentCommitID, RankedControls: ranked}
+	archiveTime := memoryFactTime()
+	for index, candidate := range ranked {
+		if candidate.ID == "" || candidate.TenantID != scope.TenantID || candidate.SubjectID != scope.SubjectID || candidate.Status != types.MemoryStatusActive {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		publication, err := memoryDerivedCurrentPublicationInTx(tx, scope, "memory_item", candidate.ID)
+		if err != nil {
+			return nil, err
+		}
+		hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		if publication.CommitID != currentCommitID && (hold == nil || hold.Facts[publication.ID] == nil) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		var parent types.MemoryOriginalDerivation
+		if publication.DerivationID != "" {
+			if err := tx.Session(&gorm.Session{NewDB: true}).Where("id=?", publication.DerivationID).Take(&parent).Error; err != nil {
+				return nil, err
+			}
+			digest, err := memoryDerivationDigest(&parent)
+			if err != nil || digest != parent.Digest || parent.ObjectID != candidate.ID || parent.ObjectKind != "memory_item" || parent.BodyDigest != publication.MaterialDigest {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+		}
+		var before types.MemoryItem
+		if err := tx.Where("id=? AND tenant_id=? AND subject_id=?", candidate.ID, scope.TenantID, scope.SubjectID).
+			Clauses(forUpdateClause()).Take(&before).Error; err != nil {
+			return nil, err
+		}
+		if before.Status != types.MemoryStatusActive || before.Importance != candidate.Importance || !before.ValidFrom.Equal(candidate.ValidFrom) || !faqInputEqual(before.LastUsedAt, candidate.LastUsedAt) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		beforeDigest, err := memoryItemMaterialDigest(&before)
+		if err != nil {
+			return nil, err
+		}
+		if beforeDigest != publication.MaterialDigest {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		plan.RankedControls[index].ParentPublicationID = publication.ID
+		plan.RankedControls[index].ParentPublicationDigest = publication.Digest
+		plan.RankedControls[index].ParentDerivationID = parent.ID
+		plan.RankedControls[index].ParentDerivationDigest = parent.Digest
+		plan.RankedControls[index].BodyDigest = beforeDigest
+		if index < maxItems {
+			continue
+		}
+		beforeCopy, err := memoryCapacityItemCopy(&before)
+		if err != nil {
+			return nil, err
+		}
+		afterCopy, err := memoryCapacityItemCopy(&before)
+		if err != nil {
+			return nil, err
+		}
+		// Preserve every original model operation and its own effect origin.
+		// The caller applies this additional archive effect and its child origin
+		// in the same tx, then includes both model+archive origins in manifest.
+		afterCopy.Status = types.MemoryStatusArchived
+		afterCopy.UpdatedAt = archiveTime
+		afterDigest, err := memoryItemMaterialDigest(afterCopy)
+		if err != nil {
+			return nil, err
+		}
+		plan.Retirements = append(plan.Retirements, memoryOriginalCapacityRetirement{TargetID: candidate.ID, Before: beforeCopy, After: afterCopy, BeforeDigest: beforeDigest, AfterDigest: afterDigest, Parent: &parent, Publication: publication})
+	}
+	var err error
+	plan.RankingDigest, err = KnowledgeInputDigest(struct {
+		TenantID  uint64
+		SubjectID string
+		Keep      int
+		CommitID  string
+		Controls  []memoryCapacityRankControl
+	}{scope.TenantID, scope.SubjectID, maxItems, currentCommitID, plan.RankedControls})
+	if err != nil {
+		return nil, err
+	}
+	return plan, tx.Statement.Context.Err()
+}
diff --git a/internal/application/repository/memory_original_commit.go b/internal/application/repository/memory_original_commit.go
new file mode 100644
index 00000000..e2b976d1
--- /dev/null
+++ b/internal/application/repository/memory_original_commit.go
@@ -0,0 +1,591 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
