+
+type MemoryOriginalOutboxRunner struct {
+	store   interfaces.MemoryOriginalOutboxRepository
+	queue   interfaces.MemoryOriginalTaskEnqueuer
+	mu      sync.Mutex
+	cancel  context.CancelFunc
+	done    chan struct{}
+	stopped bool
+}
+
+func NewMemoryOriginalOutboxRunner(store interfaces.MemoryOriginalOutboxRepository, queue interfaces.TaskEnqueuer) *MemoryOriginalOutboxRunner {
+	bounded, _ := queue.(interfaces.MemoryOriginalTaskEnqueuer)
+	return &MemoryOriginalOutboxRunner{store: store, queue: bounded}
+}
+
+func memoryOriginalRelayBackoff(attempts uint64) time.Duration {
+	if attempts > 6 {
+		attempts = 6
+	}
+	if attempts == 0 {
+		attempts = 1
+	}
+	return time.Duration(1<<(attempts-1)) * 5 * time.Second
+}
+
+// RelayOne is shared by normal dispatch and startup recovery. The only payload
+// is the exact immutable intent. It does not read model/config/current history.
+func (r *MemoryOriginalOutboxRunner) RelayOne(ctx context.Context, admissionID string) (bool, error) {
+	if r == nil || r.store == nil || r.queue == nil {
+		return false, types.ErrMemoryOriginalUnavailable
+	}
+	op, cancel := context.WithTimeout(ctx, memoryOriginalRelayOperationTimeout)
+	defer cancel()
+	claim, err := r.store.ClaimMemoryOriginalDispatch(op, admissionID, time.Now().UTC(), memoryOriginalRelayClaimTTL)
+	if err != nil || claim == nil {
+		return false, err
+	}
+	if claim.ValidationFailureCode != "" {
+		// No original proof was admitted. Own only static retry metadata for
+		// this fingerprint, so another valid intent can leave the queue next.
+		return true, r.finishRelay(ctx, claim, false, false, types.ErrMemoryOriginalUnavailable)
+	}
+	completed, err := r.store.VerifyMemoryOriginalCompletion(op, claim.Payload)
+	if err != nil {
+		return true, r.finishRelay(ctx, claim, false, false, err)
+	}
+	if completed {
+		return true, r.finishRelay(ctx, claim, false, true, nil)
+	}
+	encoded, err := json.Marshal(claim.Payload)
+	if err != nil {
+		return true, r.finishRelay(ctx, claim, false, false, err)
+	}
+	// Different attempts may coexist after a crash at the broker boundary.
+	// The exact original payload and immutable completion receipt make such
+	// duplicates safe; a broker TaskID conflict is never proof of completion.
+	_, err = r.queue.EnqueueContext(op, asynq.NewTask(types.TypeMemoryExtract, encoded),
+		asynq.Queue(types.QueueMemory), asynq.TaskID("memorig:"+claim.AdmissionID+":"+claim.LeaseID), asynq.MaxRetry(2))
+	return true, r.finishRelay(ctx, claim, err == nil, false, err)
+}
+
+func (r *MemoryOriginalOutboxRunner) finishRelay(ctx context.Context, claim *types.MemoryOriginalDispatchClaim, enqueued, completed bool, relayErr error) error {
+	// Cancellation can interrupt the broker before its response reaches us.
+	// Record a retry using a small joined SQL operation; never drop the intent.
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+	defer cancel()
+	now := time.Now().UTC()
+	next := now.Add(memoryOriginalRelayBackoff(claim.Attempts))
+	if enqueued {
+		next = now.Add(memoryOriginalRelayConsumerGrace)
+	}
+	err := r.store.FinishMemoryOriginalDispatch(cleanup, claim, now, next, enqueued, completed)
+	return errors.Join(relayErr, err)
+}
+
+func (r *MemoryOriginalOutboxRunner) runOnce(ctx context.Context) {
+	for n := 0; n < memoryOriginalRelayBatch && ctx.Err() == nil; n++ {
+		claimed, err := r.RelayOne(ctx, "")
+		if err != nil {
+			// Payload bodies, credentials and broker error details are private.
+			logger.Warnf(ctx, "[MemoryOriginalOutbox] durable dispatch retry retained")
+		}
+		if !claimed {
+			return
+		}
+	}
+}
+
+// Start is called after task handlers are installed in both Redis and Lite.
+// Stop cancels and joins this relay loop. The Lite executor's independently
+// registered cleanup subsequently cancels and joins its dispatched workers.
+func (r *MemoryOriginalOutboxRunner) Start(ctx context.Context) {
+	if r == nil {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.done != nil || r.stopped {
+		return
+	}
+	owned, cancel := context.WithCancel(ctx)
+	r.cancel, r.done = cancel, make(chan struct{})
+	go func() {
+		defer close(r.done)
+		r.runOnce(owned)
+		ticker := time.NewTicker(memoryOriginalRelayInterval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-owned.Done():
+				return
+			case <-ticker.C:
+				r.runOnce(owned)
+			}
+		}
+	}()
+}
+
+func (r *MemoryOriginalOutboxRunner) Stop() {
+	if r == nil {
+		return
+	}
+	r.mu.Lock()
+	r.stopped = true
+	cancel, done := r.cancel, r.done
+	if cancel != nil {
+		cancel()
+	}
+	r.mu.Unlock()
+	if done != nil {
+		<-done
+	}
+}
diff --git a/internal/application/service/memory_original_outbox_test.go b/internal/application/service/memory_original_outbox_test.go
new file mode 100644
index 00000000..7c0f623c
--- /dev/null
+++ b/internal/application/service/memory_original_outbox_test.go
@@ -0,0 +1,211 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/hibiken/asynq"
+	"github.com/stretchr/testify/require"
+)
+
+type originalOutboxFinish struct {
+	enqueued, completed bool
+	next                time.Time
+	claim               types.MemoryOriginalDispatchClaim
+}
+type originalOutboxStoreFake struct {
+	claim      *types.MemoryOriginalDispatchClaim
+	completion bool
+	verifyErr  error
+	finishErr  error
+	finishes   []originalOutboxFinish
+}
+
+func (s *originalOutboxStoreFake) VerifyMemoryOriginalCompletion(context.Context, types.MemoryExtractPayload) (bool, error) {
+	return s.completion, s.verifyErr
+}
+func (s *originalOutboxStoreFake) ClaimMemoryOriginalDispatch(context.Context, string, time.Time, time.Duration) (*types.MemoryOriginalDispatchClaim, error) {
+	if s.claim == nil {
+		return nil, nil
+	}
+	copy := *s.claim
+	return &copy, nil
+}
+func (s *originalOutboxStoreFake) FinishMemoryOriginalDispatch(_ context.Context, claim *types.MemoryOriginalDispatchClaim, _ time.Time, next time.Time, enqueued, completed bool) error {
+	s.finishes = append(s.finishes, originalOutboxFinish{enqueued: enqueued, completed: completed, next: next, claim: *claim})
+	return s.finishErr
+}
+func (s *originalOutboxStoreFake) ScheduleMemoryOriginalDispatch(context.Context, types.MemoryExtractPayload, time.Time) error {
+	return nil
+}
+
+type originalOutboxQueueFake struct {
+	tasks   []*asynq.Task
+	opts    [][]asynq.Option
+	err     error
+	entered chan struct{}
+	exited  chan struct{}
+	block   bool
+	once    sync.Once
+}
+
+func (q *originalOutboxQueueFake) Enqueue(*asynq.Task, ...asynq.Option) (*asynq.TaskInfo, error) {
+	panic("unbounded enqueue must not be called")
+}
+func (q *originalOutboxQueueFake) EnqueueContext(ctx context.Context, task *asynq.Task, opts ...asynq.Option) (*asynq.TaskInfo, error) {
+	q.tasks = append(q.tasks, task)
+	q.opts = append(q.opts, opts)
+	if q.entered != nil {
+		q.once.Do(func() { close(q.entered) })
+	}
+	if q.block {
+		<-ctx.Done()
+		if q.exited != nil {
+			close(q.exited)
+		}
+		return nil, ctx.Err()
+	}
+	if q.err != nil {
+		return nil, q.err
+	}
+	return &asynq.TaskInfo{ID: "real-boundary-test-response"}, nil
+}
+
+func originalOutboxClaimFixture() *types.MemoryOriginalDispatchClaim {
+	return &types.MemoryOriginalDispatchClaim{
+		AdmissionID: "original-1", PayloadDigest: "payload-digest", LeaseID: "relay-1", Attempts: 1,
+		Payload: types.MemoryExtractPayload{TenantID: 7, SubjectID: "web:user", SessionID: "session", MessageID: "completed-message", ChatModelID: "original-model", Language: "Chinese", OriginalAdmissionID: "original-1", OriginalDigest: "original-digest", OriginalRevision: 3},
+	}
+}
+
+// These are relay unit tests. They do not authenticate SQL/actor/source proofs
+// or substitute for the full-chain real-broker/restore acceptance gate.
+func TestMemoryOriginalOutboxBrokerFailureRetainsExactIntent(t *testing.T) {
+	claim := originalOutboxClaimFixture()
+	store := &originalOutboxStoreFake{claim: claim}
+	queue := &originalOutboxQueueFake{err: errors.New("broker unavailable")}
+	runner := NewMemoryOriginalOutboxRunner(store, queue)
+	claimed, err := runner.RelayOne(context.Background(), claim.AdmissionID)
+	require.True(t, claimed)
+	require.ErrorIs(t, err, queue.err)
+	require.Len(t, store.finishes, 1)
+	require.False(t, store.finishes[0].enqueued)
+	require.False(t, store.finishes[0].completed)
+	require.Equal(t, *claim, store.finishes[0].claim)
+	require.True(t, store.finishes[0].next.After(time.Now()))
+	require.Len(t, queue.tasks, 1)
+	var queued types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal(queue.tasks[0].Payload(), &queued))
+	require.Equal(t, claim.Payload, queued)
+}
+
+func TestMemoryOriginalOutboxBrokerSuccessIsNotCompletion(t *testing.T) {
+	store := &originalOutboxStoreFake{claim: originalOutboxClaimFixture()}
+	queue := &originalOutboxQueueFake{}
+	claimed, err := NewMemoryOriginalOutboxRunner(store, queue).RelayOne(context.Background(), "")
+	require.True(t, claimed)
+	require.NoError(t, err)
+	require.Len(t, store.finishes, 1)
+	require.True(t, store.finishes[0].enqueued)
+	require.False(t, store.finishes[0].completed)
+	require.True(t, store.finishes[0].next.After(time.Now().Add(10*time.Minute)))
+}
+
+func TestMemoryOriginalOutboxProvenReceiptStopsWithoutBroker(t *testing.T) {
+	store := &originalOutboxStoreFake{claim: originalOutboxClaimFixture(), completion: true}
+	queue := &originalOutboxQueueFake{}
+	claimed, err := NewMemoryOriginalOutboxRunner(store, queue).RelayOne(context.Background(), "")
+	require.True(t, claimed)
+	require.NoError(t, err)
+	require.Empty(t, queue.tasks)
+	require.True(t, store.finishes[0].completed)
+	require.False(t, store.finishes[0].enqueued)
+}
+
+func TestMemoryOriginalOutboxMissingReceiptCapabilityRefusesAndRetains(t *testing.T) {
+	store := &originalOutboxStoreFake{claim: originalOutboxClaimFixture(), verifyErr: types.ErrMemoryOriginalUnavailable}
+	queue := &originalOutboxQueueFake{}
+	claimed, err := NewMemoryOriginalOutboxRunner(store, queue).RelayOne(context.Background(), "")
+	require.True(t, claimed)
+	require.ErrorIs(t, err, types.ErrMemoryOriginalUnavailable)
+	require.Empty(t, queue.tasks)
+	require.False(t, store.finishes[0].completed)
+}
+
+func TestMemoryOriginalOutboxRelayCrashBoundaryRepeatsSameOriginal(t *testing.T) {
+	store := &originalOutboxStoreFake{claim: originalOutboxClaimFixture(), finishErr: errors.New("commit response lost")}
+	queue := &originalOutboxQueueFake{}
+	runner := NewMemoryOriginalOutboxRunner(store, queue)
+	_, err := runner.RelayOne(context.Background(), "")
+	require.Error(t, err)
+	store.finishErr = nil
+	store.claim.LeaseID = "recovered-relay-2"
+	store.claim.Attempts++
+	_, err = runner.RelayOne(context.Background(), "")
+	require.NoError(t, err)
+	require.Len(t, queue.tasks, 2)
+	require.Equal(t, queue.tasks[0].Payload(), queue.tasks[1].Payload())
+	require.False(t, store.finishes[0].completed)
+	require.False(t, store.finishes[1].completed)
+}
+
+func TestMemoryOriginalOutboxStopCancelsAndJoinsBrokerOperation(t *testing.T) {
+	store := &originalOutboxStoreFake{claim: originalOutboxClaimFixture()}
+	queue := &originalOutboxQueueFake{entered: make(chan struct{}), exited: make(chan struct{}), block: true}
+	runner := NewMemoryOriginalOutboxRunner(store, queue)
+	runner.Start(context.Background())
+	select {
+	case <-queue.entered:
+	case <-time.After(time.Second):
+		t.Fatal("relay did not enter broker")
+	}
+	stopped := make(chan struct{})
+	go func() { runner.Stop(); close(stopped) }()
+	select {
+	case <-stopped:
+	case <-time.After(time.Second):
+		t.Fatal("relay did not join")
+	}
+	select {
+	case <-queue.exited:
+	default:
+		t.Fatal("Stop returned before broker operation exited")
+	}
+	require.Len(t, store.finishes, 1)
+	require.False(t, store.finishes[0].completed)
+	runner.Stop()
+}
+
+func TestMemoryOriginalOutboxStopBeforeStartDoesNotSpawn(t *testing.T) {
+	store := &originalOutboxStoreFake{claim: originalOutboxClaimFixture()}
+	queue := &originalOutboxQueueFake{}
+	runner := NewMemoryOriginalOutboxRunner(store, queue)
+	runner.Stop()
+	runner.Start(context.Background())
+	require.Empty(t, queue.tasks)
+}
+
+func TestMemoryOriginalOutboxInvalidClaimOnlyRetriesMetadata(t *testing.T) {
+	claim := originalOutboxClaimFixture()
+	claim.Payload = types.MemoryExtractPayload{}
+	claim.ValidationFailureCode = "original_intent_invalid"
+	claim.IntentFingerprint = "bound-row-fingerprint"
+	// A receipt verifier must never upgrade a failed original validation even
+	// when an unrelated result would otherwise report completion.
+	store := &originalOutboxStoreFake{claim: claim, completion: true}
+	queue := &originalOutboxQueueFake{}
+	claimed, err := NewMemoryOriginalOutboxRunner(store, queue).RelayOne(context.Background(), "")
+	require.True(t, claimed)
+	require.ErrorIs(t, err, types.ErrMemoryOriginalUnavailable)
+	require.Empty(t, queue.tasks)
+	require.Len(t, store.finishes, 1)
+	require.False(t, store.finishes[0].enqueued)
+	require.False(t, store.finishes[0].completed)
+	require.Equal(t, claim.IntentFingerprint, store.finishes[0].claim.IntentFingerprint)
+	require.True(t, store.finishes[0].next.After(time.Now()))
+}
diff --git a/internal/application/service/memory_original_source.go b/internal/application/service/memory_original_source.go
new file mode 100644
index 00000000..aa86003c
--- /dev/null
+++ b/internal/application/service/memory_original_source.go
@@ -0,0 +1,386 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+)
+
+type memoryOriginalSourceReader struct {
+	messages   *messageService
+	admissions interfaces.MemoryOriginalAdmissionReader
+}
+
+// NewMemoryOriginalSourceReader intentionally has no current-row fallback.
+// Registration/wiring waits for the durable admission repository; a missing
+// original store never upgrades a legacy task into an authorized task.
+func NewMemoryOriginalSourceReader(messages interfaces.MessageService, admissions interfaces.MemoryOriginalAdmissionReader) interfaces.MemoryOriginalSourceReader {
+	service, _ := messages.(*messageService)
+	return &memoryOriginalSourceReader{messages: service, admissions: admissions}
+}
+
+func (r *memoryOriginalSourceReader) available() bool {
+	return r != nil && r.messages != nil && r.messages.materialStore != nil && r.messages.sourceLineageGuard != nil
+}
+
+func validateMemoryOriginalRequest(request types.MemoryOriginalCaptureRequest) error {
+	if request.TenantID == 0 || request.SubjectID == "" || request.SessionID == "" || request.TriggerMessageID == "" || request.MaterialRequest.TenantID != request.TenantID || request.MaterialRequest.SessionID != request.SessionID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if request.MaterialRequest.AllSession || request.MaterialRequest.IncludeOriginalUserFields || len(request.MaterialRequest.MessageIDs) == 0 {
+		// The scheduling adapter must freeze an explicit bounded selection,
+		// including prior context. Reading future session rows is not allowed.
+		return types.ErrMemoryOriginalUnavailable
+	}
+	seen := map[string]bool{}
+	for _, id := range request.MaterialRequest.MessageIDs {
+		if id == "" || seen[id] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[id] = true
+	}
+	if !seen[request.TriggerMessageID] {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+
+func validateMemoryOriginalDescriptor(input *types.MemoryOriginalInput) error {
+	if input == nil || validateMemoryOriginalRequest(input.Request) != nil || input.Plan == nil || input.Material == nil || len(input.Material.Messages) != 0 || input.Plan.MetadataDigest == "" || input.Material.MetadataDigest != input.Plan.MetadataDigest || input.Plan.SourceLineage.RequireComplete() != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if input.Actor.CallerTenantID != input.Request.TenantID || input.Actor.Principal.StorageID() != input.Request.SubjectID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	for _, value := range []types.MessageMaterialReadRequest{input.Plan.Request, input.Material.Request} {
+		a, _ := repository.KnowledgeInputDigest(value)
+		b, _ := repository.KnowledgeInputDigest(input.Request.MaterialRequest)
+		if a == "" || a != b {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	seen := map[string]bool{}
+	for _, proof := range input.Material.Proofs {
+		if proof == nil || proof.TenantID != input.Request.TenantID || proof.SessionID != input.Request.SessionID || proof.MessageID == "" || proof.AdmissionID == "" || proof.GenerationID == "" || proof.BodyDigest == "" || proof.Revision == 0 || proof.SourceLineage.RequireComplete() != nil || seen[proof.MessageID] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[proof.MessageID] = true
+	}
+	if len(seen) != len(input.Request.MaterialRequest.MessageIDs) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	for _, id := range input.Request.MaterialRequest.MessageIDs {
+		if !seen[id] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	return nil
+}
+
+func (r *memoryOriginalSourceReader) CaptureMemoryOriginalInput(ctx context.Context, request types.MemoryOriginalCaptureRequest) (*types.MemoryOriginalInput, error) {
+	return r.captureMemoryOriginal(ctx, request, nil)
+}
+
+func (r *memoryOriginalSourceReader) CaptureAndPersistMemoryOriginal(ctx context.Context, request types.MemoryOriginalCaptureRequest, persist func(context.Context, *types.MemoryOriginalInput) error) (*types.MemoryOriginalInput, error) {
+	if persist == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return r.captureMemoryOriginal(ctx, request, persist)
+}
+
+func (r *memoryOriginalSourceReader) captureMemoryOriginal(ctx context.Context, request types.MemoryOriginalCaptureRequest, persist func(context.Context, *types.MemoryOriginalInput) error) (result *types.MemoryOriginalInput, resultErr error) {
+	if !r.available() || validateMemoryOriginalRequest(request) != nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	models, ok := r.admissions.(interfaces.ModelOriginalLifetimeReader)
+	if !ok || !request.EnqueueModelProof.Valid() {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	modelRead, err := models.BeginModelOriginalRead(ctx, request.EnqueueModelID, &request.EnqueueModelProof)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err := modelRead.Close(); err != nil && resultErr == nil {
+			result = nil
+			resultErr = err
+		}
+	}()
+	ctx = modelRead.Context()
+	policies, ok := r.admissions.(interfaces.MemoryPolicyOriginalLifetimeReader)
+	if !ok || !request.EnqueuePolicyProof.Valid() {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	policyRead, err := policies.BeginMemoryPolicyOriginalRead(ctx, request.TenantID, request.EnqueuePolicyProof)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		if err := policyRead.Close(); err != nil && resultErr == nil {
+			result = nil
+			resultErr = err
+		}
+	}()
+	ctx = policyRead.Context()
+	_, policyProof, err := policyRead.Policy()
+	if err != nil {
+		return nil, err
+	}
+	if policyProof == nil || *policyProof != request.EnqueuePolicyProof {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	request.MaterialRequest.MessageIDs = append([]string(nil), request.MaterialRequest.MessageIDs...)
+	sort.Strings(request.MaterialRequest.MessageIDs)
+	actor, err := r.messages.materialStore.CaptureMemoryOriginalActor(ctx)
+	if err != nil {
+		return nil, err
+	}
+	marked, err := r.messages.materialStore.RestoreMemoryOriginalActor(ctx, *actor, request.TenantID, request.SubjectID)
+	if err != nil {
+		return nil, err
+	}
+	guard, err := r.messages.beginMessageMaterialRead(marked, request.MaterialRequest)
+	if err != nil {
+		return nil, err
+	}
+	defer guard.Close()
+	if err = guard.Recheck(); err != nil {
+		return nil, err
+	}
+	triggerComplete := false
+	for _, message := range guard.snapshot.Messages {
+		if message.ID == request.TriggerMessageID && message.Role == "assistant" && message.IsCompleted {
+			triggerComplete = true
+		}
+	}
+	if !triggerComplete {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	metadata := *guard.snapshot
+	metadata.Messages = nil
+	input := &types.MemoryOriginalInput{Request: request, Actor: *actor, Plan: guard.plan, Material: &metadata}
+	encoded, err := json.Marshal(input)
+	if err != nil {
+		return nil, err
+	}
+	var detached types.MemoryOriginalInput
+	if err = json.Unmarshal(encoded, &detached); err != nil {
+		return nil, err
+	}
+	if err = validateMemoryOriginalDescriptor(&detached); err != nil {
+		return nil, err
+	}
+	if persist != nil {
+		// Keep this capture's own original-body and exact source leases until
+		// durable admission+pending binding has committed or rolled back.
+		if err = guard.Recheck(); err != nil {
+			return nil, err
+		}
+		bound, bindErr := r.messages.materialStore.BindMemoryOriginalBodyHolds(guard.Context(), guard.bodyLeases)
+		if bindErr != nil {
+			return nil, bindErr
+		}
+		if err = persist(bound, &detached); err != nil {
+			return nil, err
+		}
+		if err = policyRead.Recheck(); err != nil {
+			return nil, err
+		}
+		if err = modelRead.Recheck(); err != nil {
+			return nil, err
+		}
+		if err = guard.Recheck(); err != nil {
+			return nil, err
+		}
+	}
+	return &detached, nil
+}
+
+func (r *memoryOriginalSourceReader) BeginMemoryOriginalRead(ctx context.Context, admissionID string) (interfaces.MemoryOriginalRead, error) {
+	if !r.available() || r.admissions == nil || admissionID == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	input, err := r.admissions.LoadMemoryOriginalAdmission(ctx, admissionID)
+	if err != nil {
+		return nil, err
+	}
+	if input == nil || input.ID != admissionID || validateMemoryOriginalDescriptor(input) != nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	marked, err := r.messages.materialStore.RestoreMemoryOriginalActor(ctx, input.Actor, input.Request.TenantID, input.Request.SubjectID)
+	if err != nil {
+		return nil, err
+	}
+	leaseCtx, cancel := context.WithCancel(marked)
+	guard := &MessageMaterialGuard{store: r.messages.materialStore, verifier: r.messages, plan: input.Plan, ctx: leaseCtx, cancel: cancel, leases: []repository.NextcloudContentLease{}, heartbeatStop: make(chan struct{})}
+	read := &memoryOriginalRead{source: r, input: input, guard: guard}
+	ok := false
+	defer func() {
+		if !ok {
+			guard.Close()
+		}
+	}()
+	owner := uuid.NewString()
+	store := guard.store.ContentLeaseStore()
+	broad := map[types.KnowledgeSearchScope]repository.NextcloudContentLease{}
+	for _, scope := range input.Plan.Scopes {
+		lease, err := store.AcquireKBRead(leaseCtx, scope.TenantID, scope.KBID, owner, 2*time.Minute)
+		if err != nil {
+			return nil, err
+		}
+		broad[scope] = lease
+		guard.leases = append(guard.leases, lease)
+	}
+	for _, source := range input.Plan.SourceLineage.Sources {
+		lease, covered := broad[types.KnowledgeSearchScope{TenantID: source.TenantID, KBID: source.KnowledgeBaseID}]
+		if !covered {
+			return nil, repository.ErrNextcloudContentGCUncovered
+		}
+		exact, err := store.UpgradeKBRead(leaseCtx, lease.ID, repository.NextcloudContentScope{TenantID: source.TenantID, KnowledgeBaseID: source.KnowledgeBaseID, KnowledgeID: source.KnowledgeID, DataSourceID: source.DataSourceID, ExternalID: source.ExternalID}, owner, 2*time.Minute)
+		if err != nil {
+			return nil, err
+		}
+		guard.leases = append(guard.leases, exact)
+		if uint64(exact.Epoch) != source.Revision {
+			return nil, repository.ErrKnowledgeInputChanged
+		}
+	}
+	if len(guard.leases) > 0 {
+		leaseCtx, err = repository.WithFAQReadLeaseCoverage(leaseCtx, guard.leases)
+		if err != nil {
+			return nil, err
+		}
+	}
+	leaseCtx, err = repository.WithMessageMaterialReadPlan(leaseCtx, input.Plan)
+	if err != nil {
+		return nil, err
+	}
+	guard.ctx = leaseCtx
+	guard.bodyLeases, err = guard.store.AcquireMessageBodyReadLeases(leaseCtx, input.Plan, owner, 2*time.Minute)
+	if err != nil {
+		return nil, err
+	}
+	// Recheck the queued proofs before exposing current physical bytes. The
+	// current read must match the original plan and all immutable receipts.
+	if err = guard.store.RecheckMessageMaterialInputs(leaseCtx, input.Material); err != nil {
+		return nil, err
+	}
+	guard.snapshot, err = guard.store.CaptureMessageMaterialInputs(leaseCtx, input.Material.Request)
+	if err != nil {
+		return nil, err
+	}
+	if err = read.Recheck(); err != nil {
+		return nil, err
+	}
+	guard.stop.Add(1)
+	go func() {
+		defer guard.stop.Done()
+		ticker := time.NewTicker(30 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-guard.ctx.Done():
+				return
+			case <-guard.heartbeatStop:
+				return
+			case <-ticker.C:
+				if read.Recheck() != nil {
+					guard.cancel()
+					return
+				}
+			}
+		}
+	}()
+	ok = true
+	return read, nil
+}
+
+type memoryOriginalRead struct {
+	source *memoryOriginalSourceReader
+	input  *types.MemoryOriginalInput
+	guard  *MessageMaterialGuard
+	mu     sync.Mutex
+	failed error
+}
+
+func (r *memoryOriginalRead) Context() context.Context {
+	bound, err := r.guard.store.BindMemoryOriginalBodyHolds(r.guard.Context(), r.guard.bodyLeases)
+	if err != nil {
+		r.guard.cancel()
+		return r.guard.Context()
+	}
+	return bound
+}
+func (r *memoryOriginalRead) Close() { r.guard.Close() }
+
+func (r *memoryOriginalRead) Recheck() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.failed != nil {
+		return r.failed
+	}
+	check := func() error {
+		if err := r.guard.Recheck(); err != nil {
+			return err
+		}
+		targets := []*types.SearchTarget{}
+		for _, scope := range r.input.Plan.Scopes {
+			targets = append(targets, &types.SearchTarget{Type: types.SearchTargetTypeKnowledgeBase, TenantID: scope.TenantID, KnowledgeBaseID: scope.KBID})
+		}
+		if err := r.source.messages.sourceLineageGuard.Check(r.guard.Context(), r.input.Plan.SourceLineage, access.LineageReadScope{Targets: targets}); err != nil {
+			return err
+		}
+		return r.guard.store.RecheckMessageMaterialInputs(r.guard.Context(), r.input.Material)
+	}
+	if err := check(); err != nil {
+		r.failed = err
+		r.guard.cancel()
+		return err
+	}
+	return nil
+}
+
+func (r *memoryOriginalRead) Snapshot() (*types.MessageMaterialSnapshot, error) {
+	if err := r.Recheck(); err != nil {
+		return nil, err
+	}
+	// Keep private proof ownership and hidden SourceLineage separate from the
+	// ordinary Message serializer, which deliberately omits that field.
+	encoded, err := json.Marshal(struct {
+		Snapshot *types.MessageMaterialSnapshot
+		Lineages []*types.SourceLineage
+	}{Snapshot: r.guard.snapshot, Lineages: memoryOriginalMessageLineages(r.guard.snapshot)})
+	if err != nil {
+		return nil, err
+	}
+	var detached struct {
+		Snapshot *types.MessageMaterialSnapshot
+		Lineages []*types.SourceLineage
+	}
+	if err = json.Unmarshal(encoded, &detached); err != nil {
+		return nil, err
+	}
+	for i, message := range detached.Snapshot.Messages {
+		message.SourceLineage = detached.Lineages[i]
+	}
+	if err = r.Recheck(); err != nil {
+		return nil, err
+	}
+	return detached.Snapshot, nil
+}
+
+func memoryOriginalMessageLineages(snapshot *types.MessageMaterialSnapshot) []*types.SourceLineage {
+	lineages := make([]*types.SourceLineage, len(snapshot.Messages))
+	for i, message := range snapshot.Messages {
+		lineages[i] = message.SourceLineage
+	}
+	return lineages
+}
