@@ -0,0 +1,95 @@
+package chat
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/models/utils/ollama"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSourceContentOllamaActualHTTPStreamErrorKeepsCallerAndSuppressesLog(t *testing.T) {
+	for _, mode := range []string{"private-marker", "private-lineage", "ordinary"} {
+		t.Run(mode, func(t *testing.T) {
+			label := "PUBLIC_ORDINARY"
+			if mode != "ordinary" {
+				label = "PRIVATE_SOURCE"
+			}
+			var mu sync.Mutex
+			var requestBody []byte
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch r.URL.Path {
+				case "/":
+					w.WriteHeader(http.StatusOK)
+				case "/api/tags":
+					w.Header().Set("Content-Type", "application/json")
+					_, _ = w.Write([]byte(`{"models":[{"name":"controlled:latest","model":"controlled:latest"}]}`))
+				case "/api/chat":
+					body, err := io.ReadAll(r.Body)
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					mu.Lock()
+					requestBody = body
+					mu.Unlock()
+					w.Header().Set("Content-Type", "application/json")
+					w.WriteHeader(http.StatusInternalServerError)
+					_, _ = w.Write([]byte(`{"error":"` + label + `_PROVIDER_ERROR"}`))
+				default:
+					w.WriteHeader(http.StatusNotFound)
+				}
+			}))
+			defer server.Close()
+			t.Setenv("OLLAMA_BASE_URL", server.URL)
+			service, err := ollama.GetOllamaService()
+			require.NoError(t, err)
+			client, err := NewOllamaChat(&ChatConfig{ModelName: "controlled", ModelID: "controlled"}, service)
+			require.NoError(t, err)
+			var logs bytes.Buffer
+			log := logrus.New()
+			log.SetOutput(&logs)
+			log.SetLevel(logrus.DebugLevel)
+			ctx := context.WithValue(context.Background(), types.LoggerContextKey, logrus.NewEntry(log))
+			if mode == "private-marker" {
+				ctx = logprivacy.SuppressContent(ctx)
+			}
+			if mode == "private-lineage" {
+				ctx = types.WithRAGSourceLineage(ctx, types.NewRAGSourceLineage(nil))
+			}
+			stream, err := client.ChatStream(ctx, []Message{{Role: "user", Content: label + "_PROMPT"}}, nil)
+			require.NoError(t, err, "native Ollama reports this HTTP error through the stream")
+			var last types.StreamResponse
+			for response := range stream {
+				last = response
+			}
+			require.Equal(t, types.ResponseTypeError, last.ResponseType)
+			require.True(t, last.Done)
+			require.Contains(t, last.Content, label+"_PROVIDER_ERROR", "the original native provider error still reaches the caller")
+			mu.Lock()
+			body := append([]byte(nil), requestBody...)
+			mu.Unlock()
+			require.Contains(t, string(body), label+"_PROMPT")
+			var request map[string]any
+			require.NoError(t, json.Unmarshal(body, &request))
+			require.Equal(t, true, request["stream"])
+			require.Equal(t, "controlled", request["model"])
+			if mode != "ordinary" {
+				require.NotContains(t, logs.String(), "PRIVATE_SOURCE")
+				require.Contains(t, logs.String(), "content logging suppressed")
+			} else {
+				require.True(t, strings.Contains(logs.String(), "PUBLIC_ORDINARY_PROVIDER_ERROR"), "ordinary error diagnostics remain available")
+			}
+		})
+	}
+}
diff --git a/internal/models/chat/original_definition.go b/internal/models/chat/original_definition.go
new file mode 100644
index 00000000..bc0b7105
--- /dev/null
+++ b/internal/models/chat/original_definition.go
@@ -0,0 +1,236 @@
+package chat
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/Tencent/WeKnora/internal/models/api"
+	"github.com/Tencent/WeKnora/internal/models/api/anthropicmessages"
+	"github.com/Tencent/WeKnora/internal/models/api/googlegenai"
+	"github.com/Tencent/WeKnora/internal/models/api/openaicompletions"
+	"github.com/Tencent/WeKnora/internal/models/api/openairesponses"
+	"github.com/Tencent/WeKnora/internal/models/catalog"
+	modelutils "github.com/Tencent/WeKnora/internal/models/utils"
+	"github.com/Tencent/WeKnora/internal/types"
+	secutils "github.com/Tencent/WeKnora/internal/utils"
+	"github.com/google/uuid"
+	"net/http"
+	"strings"
+)
+
+const OriginalWeKnoraSigner = "weknora-cloud-hmac-sha256-json-v1"
+
+// Authoring uses explicit complete input, or these exact code-owned defaults.
+// This never calls Resolve/GetOrGeneric/overlay/default-key or reads ENV.
+func NormalizeAuthoredChatDefinition(model *types.Model) error {
+	if model.Source != types.ModelSourceRemote {
+		return nil
+	}
+	if model.Parameters.OriginalChat == nil {
+		if model.Parameters.Spec != nil {
+			return fmt.Errorf("complete original definition is required for catalog overrides")
+		}
+		for key := range model.Parameters.ExtraConfig {
+			if key != "remote_model_name" {
+				return fmt.Errorf("complete original definition is required for provider extra config")
+			}
+		}
+		provider := strings.ToLower(strings.TrimSpace(model.Parameters.Provider))
+		if provider != "openai" && provider != "generic" && provider != "weknoracloud" {
+			return fmt.Errorf("complete original provider definition is required")
+		}
+		settings := catalog.DefaultOpenAICompletions()
+		recipe := &types.ModelOriginalChatDefinition{Version: 1, Recipe: "chat/openai-completions/full-v1", Provider: provider, API: string(api.APIOpenAICompletions), BaseURL: strings.TrimRight(model.Parameters.BaseURL, "/"), RemoteModel: model.Name, Auth: "none", ThinkingLevels: map[string]*string{}, Headers: map[string]string{}}
+		if model.Parameters.APIKey != "" || model.Parameters.AppSecret != "" {
+			recipe.Auth = "bearer"
+			recipe.RequiresAuth = true
+		}
+		if remote := model.Parameters.ExtraConfig["remote_model_name"]; remote != "" {
+			recipe.RemoteModel = remote
+		}
+		for key, value := range model.Parameters.CustomHeaders {
+			recipe.Headers[key] = value
+		}
+		if provider == "weknoracloud" {
+			recipe.Auth = "signed"
+			recipe.RequiresAuth = true
+			recipe.SignerRecipe = OriginalWeKnoraSigner
+			recipe.URL = recipe.BaseURL + "/api/v1/chat/completions"
+			settings.SupportsMultiContent = false
+			settings.PromptCacheAccounting = false
+		}
+		wire, err := json.Marshal(settings)
+		if err != nil {
+			return err
+		}
+		recipe.Settings = wire
+		model.Parameters.OriginalChat = recipe
+	}
+	return ValidateOriginalChatDefinition(model.Parameters.OriginalChat)
+}
+
+func completeSettings(data json.RawMessage, destination interface{}) error {
+	if len(data) == 0 {
+		return fmt.Errorf("complete original settings are required")
+	}
+	var keys map[string]json.RawMessage
+	if json.Unmarshal(data, &keys) != nil {
+		return fmt.Errorf("invalid original settings")
+	}
+	if err := json.Unmarshal(data, destination); err != nil {
+		return err
+	}
+	canonical, err := json.Marshal(destination)
+	if err != nil {
+		return err
+	}
+	var expected map[string]json.RawMessage
+	if json.Unmarshal(canonical, &expected) != nil {
+		return fmt.Errorf("invalid original settings schema")
+	}
+	if len(keys) != len(expected) {
+		return fmt.Errorf("original settings must include every field")
+	}
+	for key := range expected {
+		if _, ok := keys[key]; !ok {
+			return fmt.Errorf("original settings field is missing")
+		}
+	}
+	return nil
+}
+func ValidateOriginalChatDefinition(recipe *types.ModelOriginalChatDefinition) error {
+	if recipe == nil || recipe.Version != 1 || recipe.Provider == "" || recipe.RemoteModel == "" || recipe.BaseURL == "" {
+		return fmt.Errorf("complete original remote definition is unavailable")
+	}
+	switch recipe.Auth {
+	case "none":
+		if recipe.RequiresAuth || recipe.SignerRecipe != "" {
+			return fmt.Errorf("invalid original unauthenticated mode")
+		}
+	case "bearer", "api-key", "x-api-key", "x-goog-api-key":
+		if recipe.SignerRecipe != "" {
+			return fmt.Errorf("invalid original key-auth recipe")
+		}
+	case "signed":
+		if recipe.SignerRecipe != OriginalWeKnoraSigner {
+			return fmt.Errorf("unknown original signing implementation")
+		}
+	default:
+		return fmt.Errorf("unknown original auth mode")
+	}
+	switch api.API(recipe.API) {
+	case api.APIOpenAICompletions:
+		if recipe.Recipe != "chat/openai-completions/full-v1" {
+			return fmt.Errorf("unknown original protocol recipe")
+		}
+		return completeSettings(recipe.Settings, &catalog.OpenAICompletionsSettings{})
+	case api.APIOpenAIResponses:
+		if recipe.Recipe != "chat/openai-responses/full-v1" {
+			return fmt.Errorf("unknown original protocol recipe")
+		}
+		return completeSettings(recipe.Settings, &catalog.OpenAIResponsesSettings{})
+	case api.APIAnthropicMessages:
+		if recipe.Recipe != "chat/anthropic-messages/full-v1" {
+			return fmt.Errorf("unknown original protocol recipe")
+		}
+		return completeSettings(recipe.Settings, &catalog.AnthropicMessagesSettings{})
+	case api.APIGoogleGenerativeAI:
+		if recipe.Recipe != "chat/google-generative-ai/full-v1" {
+			return fmt.Errorf("unknown original protocol recipe")
+		}
+		return completeSettings(recipe.Settings, &catalog.GoogleGenerativeAISettings{})
+	default:
+		return fmt.Errorf("unknown original chat protocol")
+	}
+}
+
+// This constructor consumes ONLY the immutable complete recipe and credential
+// snapshot. It performs no live catalog resolution, key/header fallback,
+// function-hook lookup, tenant fallback or environment access.
+func NewOriginalRemoteChat(model *types.Model) (Chat, error) {
+	if model == nil || model.Source != types.ModelSourceRemote {
+		return nil, fmt.Errorf("original remote model is required")
+	}
+	recipe := model.Parameters.OriginalChat
+	if err := ValidateOriginalChatDefinition(recipe); err != nil {
+		return nil, err
+	}
+	if err := secutils.ValidateURLForSSRF(recipe.BaseURL); err != nil {
+		return nil, err
+	}
+	if recipe.URL != "" {
+		if err := secutils.ValidateURLForSSRF(recipe.URL); err != nil {
+			return nil, err
+		}
+	}
+	var auth api.AuthFunc
+	switch recipe.Auth {
+	case "none":
+		auth = api.NoAuth()
+	case "bearer":
+		if model.Parameters.APIKey == "" {
+			return nil, fmt.Errorf("original bearer key is absent")
+		}
+		auth = api.BearerAuth(model.Parameters.APIKey)
+	case "api-key", "x-api-key", "x-goog-api-key":
+		if model.Parameters.APIKey == "" {
+			return nil, fmt.Errorf("original header key is absent")
+		}
+		auth = api.HeaderAuth(recipe.Auth, model.Parameters.APIKey)
+	case "signed":
+		if model.Parameters.AppID == "" || model.Parameters.AppSecret == "" {
+			return nil, fmt.Errorf("original signing credential is absent")
+		}
+		appID, secret := model.Parameters.AppID, model.Parameters.AppSecret
+		auth = func(request *http.Request, body []byte) {
+			for key, value := range modelutils.Sign(appID, secret, uuid.NewString(), string(body)) {
+				request.Header.Set(key, value)
+			}
+		}
+	}
+	headers := map[string]string{}
+	for key, value := range recipe.Headers {
+		headers[key] = value
+	}
+	query := map[string]string{}
+	for key, value := range recipe.Query {
+		query[key] = value
+	}
+	endpoint := api.Endpoint{BaseURL: recipe.BaseURL, URL: recipe.URL, Query: query, Model: recipe.RemoteModel, ModelID: model.ID, Auth: auth, Headers: headers}
+	levels := api.ThinkingLevelMap{}
+	for key, value := range recipe.ThinkingLevels {
+		levels[api.ReasoningEffort(key)] = value
+	}
+	var client Chat
+	switch api.API(recipe.API) {
+	case api.APIOpenAICompletions:
+		var settings catalog.OpenAICompletionsSettings
+		if err := completeSettings(recipe.Settings, &settings); err != nil {
+			return nil, err
+		}
+		client = openaicompletions.New(openaicompletions.Config{Endpoint: endpoint, Settings: settings, ThinkingLevels: levels, Reasoning: recipe.Reasoning})
+	case api.APIOpenAIResponses:
+		var settings catalog.OpenAIResponsesSettings
+		if err := completeSettings(recipe.Settings, &settings); err != nil {
+			return nil, err
+		}
+		client = openairesponses.New(openairesponses.Config{Endpoint: endpoint, Settings: settings, ThinkingLevels: levels, Reasoning: recipe.Reasoning})
+	case api.APIAnthropicMessages:
+		var settings catalog.AnthropicMessagesSettings
+		if err := completeSettings(recipe.Settings, &settings); err != nil {
+			return nil, err
+		}
+		client = anthropicmessages.New(anthropicmessages.Config{Endpoint: endpoint, Settings: settings, ThinkingLevels: levels, Reasoning: recipe.Reasoning})
+	case api.APIGoogleGenerativeAI:
+		var settings catalog.GoogleGenerativeAISettings
+		if err := completeSettings(recipe.Settings, &settings); err != nil {
+			return nil, err
+		}
+		client = googlegenai.New(googlegenai.Config{Endpoint: endpoint, Settings: settings, ThinkingLevels: levels, Reasoning: recipe.Reasoning})
+	}
+	client, err := wrapChatDebug(client, nil)
+	if err != nil {
+		return nil, err
+	}
+	client, err = wrapChatLangfuse(client, nil)
+	return wrapChatConcurrency(client, model.Parameters.MaxConcurrency, err)
+}
