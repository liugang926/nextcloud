+type actualMemoryOriginalFacts struct {
+	GenerationID       string
+	AdmissionID        string
+	BodyDigest         string
+	ReceiptRevision    uint64
+	OriginalBodyID     string
+	OriginalBodySHA256 string
+	OriginalBodyState  string
+	RawBodyID          string
+	RawBodySHA256      string
+	RawBodyState       string
+}
+
+func actualMemoryFacts(t *testing.T, db *gorm.DB, messageID string) actualMemoryOriginalFacts {
+	t.Helper()
+	var facts actualMemoryOriginalFacts
+	require.NoError(t, db.Raw(`SELECT a.generation_id,a.id AS admission_id,a.body_digest,a.revision AS receipt_revision,
+	 h.body_id AS original_body_id,b.body_sha256 AS original_body_sha256,b.state AS original_body_state,
+	 raw_h.body_id AS raw_body_id,raw_b.body_sha256 AS raw_body_sha256,raw_b.state AS raw_body_state
+	 FROM message_material_receipts r JOIN message_material_admissions a ON a.id=r.admission_id
+	 JOIN original_body_field_heads h ON h.source_table='message_generation_origins' AND h.row_key=a.generation_id AND h.column_name='initial_input'
+	 JOIN original_body_payloads b ON b.id=h.body_id
+	 JOIN original_body_field_heads raw_h ON raw_h.source_table='messages' AND raw_h.row_key=a.message_id AND raw_h.column_name='content'
+	 JOIN original_body_payloads raw_b ON raw_b.id=raw_h.body_id
+	 WHERE r.message_id=?`, messageID).Scan(&facts).Error)
+	require.NotEmpty(t, facts.GenerationID)
+	require.NotEmpty(t, facts.AdmissionID)
+	require.NotEmpty(t, facts.OriginalBodyID)
+	require.NotEmpty(t, facts.RawBodyID)
+	require.Len(t, facts.OriginalBodySHA256, 64)
+	require.Len(t, facts.RawBodySHA256, 64)
+	require.Equal(t, "live", facts.OriginalBodyState)
+	require.Equal(t, "live", facts.RawBodyState)
+	return facts
+}
