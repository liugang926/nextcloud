+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	memoryservice "github.com/Tencent/WeKnora/internal/application/service/memory"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"github.com/hibiken/asynq"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+const (
+	actualMemoryAuthoredText   = "My preferred development editor is Neovim."
+	actualMemoryUnadmittedText = "My preferred development editor is UNADMITTED_CURRENT_EDIT."
+	actualMemoryStoredText     = "The user's development editor is Neovim."
+	actualMemoryPriorText      = "The previously admitted project code is ORIGINAL_PRIOR_ALPHA."
+	actualMemoryCurrentRules   = "Use the current authorized workspace extraction policy."
+)
+
+// This is a bounded transport spy, not an alternate memory implementation.
+// It deliberately answers even if unadmitted text reaches it: refusing inside
+// the spy would hide a missing production original-material boundary.
+type actualMemoryModel struct {
+	calls     int
+	prompts   []string
+	noop      bool
+	afterCall func() error
+}
+
+func (m *actualMemoryModel) Chat(ctx context.Context, input []chat.Message, _ *chat.ChatOptions) (*types.ChatResponse, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	m.calls++
+	if m.calls > 1 {
+		return nil, fmt.Errorf("bounded actual memory model accepts one extraction call")
+	}
+	var prompt strings.Builder
+	for _, message := range input {
+		prompt.WriteString(message.Content)
+		prompt.WriteByte('\n')
+	}
+	m.prompts = append(m.prompts, prompt.String())
+	content := actualMemoryStoredText
+	if strings.Contains(prompt.String(), "UNADMITTED_CURRENT_EDIT") {
+		content = actualMemoryUnadmittedText
+	}
+	decisions := []map[string]interface{}{{"action": "add", "kind": "fact", "topic": "development editor", "content": content, "importance": 4, "source": 1}}
+	if m.noop {
+		decisions = []map[string]interface{}{}
+	}
+	data, err := json.Marshal(map[string]interface{}{
+		"memories": decisions,
+		"topics":   []string{},
+	})
+	if err != nil {
+		return nil, err
+	}
+	if m.afterCall != nil {
+		if err := m.afterCall(); err != nil {
+			return nil, err
+		}
+	}
+	return &types.ChatResponse{Content: string(data)}, nil
+}
+
