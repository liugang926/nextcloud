+// Every sharing mutation publishes in the original permission-epoch tx.
+func (r *kbShareRepository) memorySharedKBWrite(ctx context.Context, where string, args []interface{}, orgIDs []string, tenantIDs []uint64, kbID string, write func(*gorm.DB) error) error {
+	return sharedAuthorityWrite(ctx, r.db, func(tx *gorm.DB) (*sharedAuthorityTargets, error) {
+		targets, err := sharedAuthorityShareTargets(tx, "kb_shares", where, args, orgIDs, tenantIDs)
+		if err != nil {
+			return nil, err
+		}
+		// Bind bulk deletion to the actual resource's tenant even when a new
+		// share is inserted in an organization outside the first selected set.
+		if kbID != "" {
+			var keys []struct{ TenantID uint64 }
+			if err := tx.Model(&types.KnowledgeBase{}).Select("tenant_id").Where("id=?", kbID).Scan(&keys).Error; err != nil {
+				return nil, err
+			}
+			for _, key := range keys {
+				targets.Tenants = append(targets.Tenants, key.TenantID)
+			}
+		}
+		return targets, nil
+	}, write)
+}
