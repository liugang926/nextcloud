+-- Refuse retained facts or observed control mutations before any destructive DOWN.
+DO $$ BEGIN IF EXISTS(SELECT 1 FROM memory_original_admissions) OR EXISTS(SELECT 1 FROM memory_original_executions) OR EXISTS(SELECT 1 FROM memory_original_checkpoints) OR EXISTS(SELECT 1 FROM memory_original_derivations) OR EXISTS(SELECT 1 FROM memory_original_dispatches) OR EXISTS(SELECT 1 FROM memory_policy_originals) OR EXISTS(SELECT 1 FROM memory_policy_body_receipts) OR EXISTS(SELECT 1 FROM model_definition_originals) OR EXISTS(SELECT 1 FROM model_credential_originals) OR EXISTS(SELECT 1 FROM model_state_originals) OR EXISTS(SELECT 1 FROM model_original_body_receipts) OR EXISTS(SELECT 1 FROM memory_derived_controls) OR EXISTS(SELECT 1 FROM memory_derived_publications) OR EXISTS(SELECT 1 FROM memory_derived_body_receipts) OR EXISTS(SELECT 1 FROM memory_generated_originals) OR EXISTS(SELECT 1 FROM memory_generated_receipts) OR EXISTS(SELECT 1 FROM memory_generated_body_receipts) OR EXISTS(SELECT 1 FROM memory_policy_control_versions WHERE revision>1) OR EXISTS(SELECT 1 FROM model_original_control_versions WHERE definition_revision>1 OR credential_revision>1 OR state_epoch>1) OR EXISTS(SELECT 1 FROM memory_derived_collections WHERE revision>1) THEN RAISE EXCEPTION 'retained original facts or control mutations prevent DOWN'; END IF; END; $$;
+DO $$ BEGIN IF EXISTS(SELECT 1 FROM model_definition_originals) OR EXISTS(SELECT 1 FROM model_credential_originals) OR EXISTS(SELECT 1 FROM model_state_originals) OR EXISTS(SELECT 1 FROM model_original_body_receipts) THEN RAISE EXCEPTION 'observed model originals prevent DOWN'; END IF; END $$;
+ALTER TABLE memory_original_executions DROP COLUMN model_proof_json;
+DROP TRIGGER model_original_insert ON models;
+DROP TRIGGER model_original_update ON models;
+DROP TRIGGER model_original_delete ON models;
+DROP TABLE model_original_body_receipts;
+DROP TABLE model_state_originals;
+DROP TABLE model_credential_originals;
+DROP TABLE model_definition_originals;
+DROP TABLE model_original_control_versions;
+DROP FUNCTION model_original_bump();
+DROP FUNCTION model_original_version_guard();
+DROP FUNCTION model_original_immutable();
+
+DO $$ BEGIN IF EXISTS(SELECT 1 FROM memory_generated_originals) OR EXISTS(SELECT 1 FROM memory_generated_receipts) OR EXISTS(SELECT 1 FROM memory_generated_body_receipts) THEN RAISE EXCEPTION 'generated memory originals must be preserved'; END IF; END; $$;
+DROP TABLE memory_generated_body_receipts;
+DROP TABLE memory_generated_receipts;
+DROP TABLE memory_generated_originals;
+
+DO $$ BEGIN IF EXISTS(SELECT 1 FROM memory_derived_controls) OR EXISTS(SELECT 1 FROM memory_derived_publications) OR EXISTS(SELECT 1 FROM memory_derived_body_receipts) THEN RAISE EXCEPTION 'memory derived original facts must be preserved'; END IF; END; $$;
+DROP TRIGGER memory_items_derived_control ON memory_items;
+DROP TRIGGER memory_items_derived_identity ON memory_items;
+DROP FUNCTION memory_items_derived_control();
+DROP FUNCTION memory_items_derived_identity();
+DROP TRIGGER memory_topic_stats_derived_control ON memory_topic_stats;
+DROP TRIGGER memory_topic_stats_derived_identity ON memory_topic_stats;
+DROP FUNCTION memory_topic_stats_derived_control();
+DROP FUNCTION memory_topic_stats_derived_identity();
+DROP TRIGGER memory_tombstones_derived_control ON memory_tombstones;
+DROP TRIGGER memory_tombstones_derived_identity ON memory_tombstones;
+DROP FUNCTION memory_tombstones_derived_control();
+DROP FUNCTION memory_tombstones_derived_identity();
+DROP TRIGGER memory_subjects_derived_block ON memory_subjects;
+DROP TRIGGER memory_subjects_derived_presence ON memory_subjects;
+DROP FUNCTION memory_subjects_derived_block();
+DROP FUNCTION memory_subjects_derived_presence();
+DROP TRIGGER memory_derived_collections_guard ON memory_derived_collections;
+DROP FUNCTION memory_derived_collections_guard();
+DROP TRIGGER memory_derived_controls_guard ON memory_derived_controls;
+DROP FUNCTION memory_derived_controls_guard();
+DROP TABLE memory_derived_body_receipts;
+DROP TABLE memory_derived_publications;
+DROP TABLE memory_derived_controls;
+DROP TABLE memory_derived_collections;
+ALTER TABLE memory_original_executions DROP COLUMN derived_inputs_json;
+ALTER TABLE memory_original_executions DROP COLUMN derived_inputs_digest;
+
+-- Prepend to reserved156 DOWN. Observed originals cannot be removed.
+DO $$ BEGIN IF EXISTS(SELECT 1 FROM memory_policy_originals) OR EXISTS(SELECT 1 FROM memory_policy_body_receipts) THEN RAISE EXCEPTION 'observed memory policy originals prevent DOWN'; END IF; END $$;
+ALTER TABLE memory_original_executions DROP COLUMN policy_body_receipt_digest;
+ALTER TABLE memory_original_executions DROP COLUMN policy_origin_digest;
+ALTER TABLE memory_original_executions DROP COLUMN policy_revision;
+ALTER TABLE memory_original_executions DROP COLUMN policy_origin_id;
+DROP TRIGGER memory_policy_tenant_insert ON tenants;
+DROP TRIGGER memory_policy_tenant_update ON tenants;
+DROP TRIGGER memory_policy_tenant_delete ON tenants;
+DROP TABLE memory_policy_body_receipts;
+DROP TABLE memory_policy_originals;
+DROP TABLE memory_policy_control_versions;
+DROP FUNCTION memory_policy_original_immutable();
+DROP FUNCTION memory_policy_version_guard();
+DROP FUNCTION memory_policy_bump();
+
+-- Place before dropping original156 schema. Preserve all observed intent facts.
+DO $$ BEGIN IF EXISTS(SELECT 1 FROM memory_original_dispatches) THEN RAISE EXCEPTION 'observed original memory dispatch facts prevent DOWN'; END IF; END $$;
+DROP TABLE memory_original_dispatches;
+DROP FUNCTION memory_original_dispatch_guard();
+
+-- Durable originals must survive rollback rather than become unproved work.
+DO $$ BEGIN
+ IF EXISTS (SELECT 1 FROM memory_original_admissions) OR EXISTS(SELECT 1 FROM memory_original_executions) OR EXISTS(SELECT 1 FROM memory_original_checkpoints) OR EXISTS(SELECT 1 FROM memory_original_derivations) THEN
+  RAISE EXCEPTION 'cannot remove retained memory original admissions';
+ END IF;
+END $$;
+ALTER TABLE memory_extraction_sessions DROP COLUMN original_checkpoint_id;
+ALTER TABLE memory_extraction_sessions DROP COLUMN original_admission_id;
+DROP TABLE memory_original_derivations;
+DROP TABLE memory_original_checkpoints;
