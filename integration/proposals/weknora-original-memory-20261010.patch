+func (r *memoryOriginalAdmissionRepository) BeginMemoryGenerated(ctx context.Context, scope interfaces.MemoryScope, capture types.MemoryGeneratedCapture) (interfaces.MemoryGeneratedRead, error) {
+	hold, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if !scope.Valid() || hold == nil || hold.Manifest.TenantID != scope.TenantID || hold.Manifest.SubjectID != scope.SubjectID || len(capture.Clusters) == 0 && !capture.Review || len(capture.Clusters) > 0 && (capture.ModelID == "" || r.generatedModels == nil || r.generatedModels.Begin == nil || r.generatedModels.Check == nil) || r.authorityFactory == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read := &memoryGeneratedRead{repo: r, hold: &memoryGeneratedHold{Maintenance: len(capture.Clusters) == 0}}
+	read.ctx, read.cancel = context.WithCancel(ctx)
+	var policy types.MemoryPolicyProof
+	err := r.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		revision, err := memoryPolicyRevision(tx, scope.TenantID)
+		if err != nil {
