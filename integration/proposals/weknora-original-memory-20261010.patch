+package container
+
+import (
+	"github.com/Tencent/WeKnora/internal/router"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+// Register before the relay cleanup. ResourceCleaner is LIFO, so shutdown stops
+// relays first, then cancels and joins every Lite worker. It does not manufacture
+// a terminal original receipt or discard persisted queue intents.
+func registerSyncTaskExecutorCleanup(executor *router.SyncTaskExecutor, cleaner interfaces.ResourceCleaner) {
+	cleaner.RegisterWithName("SyncTaskExecutor", func() error {
+		executor.Stop()
+		return nil
+	})
+}
