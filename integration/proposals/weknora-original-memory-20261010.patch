+package service
+
+import (
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+)
+
+// Getter metadata is not permission. These cases use real authoring and actual
+// acquired current/historical body leases; final SQL expiry-union tests remain
+// required independently for worker and generated commits.
+func runModelOriginalLeaseIDsSQL(t *testing.T, pg bool) {
+	f := newMemAtomicSQLFixture(t, pg)
+	repo, svc, _, reader := actualOriginalModelServices(t, f)
+	_, err := repository.ModelOriginalLeaseIDs(f.ctx)
+	require.Error(t, err, "unheld context cannot mint model lease IDs")
+	read, err := reader.BeginModelOriginalRead(f.ctx, f.model.GetModelID(), nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = read.Close() })
+	model, proof, err := read.Snapshot()
+	require.NoError(t, err)
+	ids, err := repository.ModelOriginalLeaseIDs(read.Context())
+	require.NoError(t, err)
+	require.Len(t, ids, 2)
+	var live int64
+	require.NoError(t, f.db.Table("original_body_leases").Where("lease_id IN ? AND kind='read' AND released_at_ms IS NULL", ids).Count(&live).Error)
+	require.EqualValues(t, 2, live)
+	require.NoError(t, read.Close())
+	_, err = repository.ModelOriginalLeaseIDs(read.Context())
+	require.Error(t, err)
+	model.Description = "genuine authored successor for historical lease metadata"
+	require.NoError(t, svc.UpdateModel(f.ctx, model))
+	historyRepo, ok := repo.(interfaces.HistoricalModelOriginalReader)
+	require.True(t, ok)
+	history, err := historyRepo.BeginHistoricalModelOriginalRead(f.ctx, *proof)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = history.Close() })
+	oldIDs, err := repository.ModelOriginalLeaseIDs(history.Context())
+	require.NoError(t, err)
+	require.Len(t, oldIDs, 2)
+	require.NoError(t, f.db.Table("original_body_leases").Where("lease_id IN ? AND kind='read' AND released_at_ms IS NULL", oldIDs).Count(&live).Error)
+	require.EqualValues(t, 2, live)
+	for _, old := range oldIDs {
+		require.NotContains(t, ids, old, "historical reader reports its own acquired lease IDs")
+	}
+	require.NoError(t, history.Close())
+	_, err = repository.ModelOriginalLeaseIDs(history.Context())
+	require.Error(t, err)
+	require.NoError(t, f.db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&live).Error)
+	require.Zero(t, live)
+}
+func TestModelOriginalLeaseIDsActualSQLite(t *testing.T)   { runModelOriginalLeaseIDsSQL(t, false) }
+func TestPostgresModelOriginalLeaseIDsActual(t *testing.T) { runModelOriginalLeaseIDsSQL(t, true) }
diff --git a/internal/application/service/model_original_lifetime.go b/internal/application/service/model_original_lifetime.go
new file mode 100644
index 00000000..1fc5fc06
--- /dev/null
+++ b/internal/application/service/model_original_lifetime.go
@@ -0,0 +1,296 @@
+package service
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"sync"
+	"time"
+)
+
+type originalModelClientLifetime interface {
+	RecheckOriginal() error
+	CloseOriginal() error
+}
+type modelOriginalChatClient struct {
+	inner       chat.Chat
+	read        interfaces.ModelOriginalRead
+	owner       bool
+	autoClose   bool
+	mu          sync.Mutex
+	closed      bool
+	closeErr    error
+	closeJoined chan struct{}
+	closeSignal chan struct{}
+	calls       map[uint64]context.CancelFunc
+	next        uint64
+	wg          sync.WaitGroup
+}
+
+func (w *modelOriginalChatClient) GetModelName() string { return w.inner.GetModelName() }
+func (w *modelOriginalChatClient) GetModelID() string   { return w.inner.GetModelID() }
+func (w *modelOriginalChatClient) RecheckOriginal() error {
+	w.mu.Lock()
+	closed := w.closed
+	w.mu.Unlock()
+	if closed {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return w.read.Recheck()
+}
+func sameOriginalModelCaller(a, b context.Context) bool {
+	left, right := types.CallerFromContext(a), types.CallerFromContext(b)
+	if left.TenantID != right.TenantID || left.UserID != right.UserID {
+		return false
+	}
+	p, ok := types.PrincipalFromContext(a)
+	q, qok := types.PrincipalFromContext(b)
+	if !ok || !qok || p != q {
+		return false
+	}
+	x, xok := types.TenantAPIKeyScopeFromContext(a)
+	y, yok := types.TenantAPIKeyScopeFromContext(b)
+	return xok == yok && (!xok || x.KeyID == y.KeyID)
+}
+func (w *modelOriginalChatClient) begin(ctx context.Context) (context.Context, func(), context.CancelFunc, error) {
+	if !sameOriginalModelCaller(ctx, w.read.Context()) {
+		return ctx, nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err := w.RecheckOriginal(); err != nil {
+		return ctx, nil, nil, err
+	}
+	// Provider contexts may originate from an ordinary unmarked caller even
+	// though this instance owns proved original definition/credential bodies.
+	// Keep every caller/actor/cancel check above; this flag grants no access.
+	ctx = logprivacy.SuppressContent(ctx)
+	call, cancel := context.WithCancel(ctx)
+	stopParent := context.AfterFunc(w.read.Context(), cancel)
+	w.mu.Lock()
+	if w.closed {
+		w.mu.Unlock()
+		stopParent()
+		cancel()
+		return ctx, nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	w.next++
+	id := w.next
+	w.calls[id] = cancel
+	w.wg.Add(1)
+	w.mu.Unlock()
+	watchStop := make(chan struct{})
+	watchJoined := make(chan struct{})
+	go func() {
+		defer close(watchJoined)
+		ticker := time.NewTicker(time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-watchStop:
+				return
+			case <-call.Done():
+				return
+			case <-ticker.C:
+				if w.read.Recheck() != nil {
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	var once sync.Once
+	finish := func() {
+		once.Do(func() {
+			cancel()
+			stopParent()
+			close(watchStop)
+			<-watchJoined
+			w.mu.Lock()
+			delete(w.calls, id)
+			w.mu.Unlock()
+			w.wg.Done()
+		})
+	}
+	return call, finish, cancel, nil
+}
+func (w *modelOriginalChatClient) Chat(ctx context.Context, messages []chat.Message, options *chat.ChatOptions) (response *types.ChatResponse, resultErr error) {
+	call, finish, _, err := w.begin(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		finish()
+		if w.autoClose {
+			if err := w.CloseOriginal(); err != nil && resultErr == nil {
+				response = nil
+				resultErr = err
+			}
+		}
+	}()
+	response, err = w.inner.Chat(call, messages, options)
+	if err != nil {
+		return nil, err
+	}
+	if err = w.read.Recheck(); err != nil {
+		return nil, err
+	}
+	return response, nil
+}
+func (w *modelOriginalChatClient) ChatStream(ctx context.Context, messages []chat.Message, options *chat.ChatOptions) (<-chan types.StreamResponse, error) {
+	call, finish, abort, err := w.begin(ctx)
+	if err != nil {
+		return nil, err
+	}
+	input, err := w.inner.ChatStream(call, messages, options)
+	if err != nil || input == nil {
+		finish()
+		if w.autoClose {
+			w.CloseOriginal()
+		}
+		if err == nil {
+			err = types.ErrMemoryOriginalUnavailable
+		}
+		return nil, err
+	}
+	output := make(chan types.StreamResponse)
+	go func() {
+		defer close(output)
+		defer func() {
+			finish()
+			if w.autoClose {
+				w.CloseOriginal()
+			}
+		}()
+		refuse := func() {
+			abort()
+			for range input {
+			}
+			if ctx.Err() == nil {
+				select {
+				case output <- types.StreamResponse{ResponseType: types.ResponseTypeError, Content: "Original model input is unavailable", Done: true, FinishReason: "error"}:
+				case <-ctx.Done():
+				case <-w.closeSignal:
+				}
+			}
+		}
+		for {
+			select {
+			case <-call.Done():
+				refuse()
+				return
+			case frame, ok := <-input:
+				if !ok {
+					if w.read.Recheck() != nil {
+						select {
+						case output <- types.StreamResponse{ResponseType: types.ResponseTypeError, Content: "Original model input is unavailable", Done: true, FinishReason: "error"}:
+						case <-ctx.Done():
+						case <-w.closeSignal:
+						}
+						return
+					}
+					return
+				}
+				if w.read.Recheck() != nil {
+					refuse()
+					return
+				}
+				if frame.ResponseType == types.ResponseTypeAnswer && frame.Done {
+					// A legal terminal may precede HTTP EOF. Cancel the actual
+					// owned child and join upstream before publishing completion.
+					abort()
+					invalidTail := false
+					for tail := range input {
+						if (tail.ResponseType != types.ResponseTypeError && tail.Content != "") || len(tail.ToolCalls) > 0 || len(tail.KnowledgeReferences) > 0 {
+							invalidTail = true
+						}
+					}
+					if invalidTail || w.read.Recheck() != nil {
+						refuse()
+						return
+					}
+					select {
+					case output <- frame:
+					case <-ctx.Done():
+					case <-w.closeSignal:
+					}
+					return
+				}
+				select {
+				case output <- frame:
+				case <-call.Done():
+					refuse()
+					return
+				case <-w.closeSignal:
+					refuse()
+					return
+				}
+			}
+		}
+	}()
+	return output, nil
+}
+func (w *modelOriginalChatClient) CloseOriginal() error {
+	w.mu.Lock()
+	if w.closed {
+		joined := w.closeJoined
+		w.mu.Unlock()
+		<-joined
+		w.mu.Lock()
+		err := w.closeErr
+		w.mu.Unlock()
+		return err
+	}
+	w.closed = true
+	close(w.closeSignal)
+	cancels := []context.CancelFunc{}
+	for _, cancel := range w.calls {
+		cancels = append(cancels, cancel)
+	}
+	w.mu.Unlock()
+	for _, cancel := range cancels {
+		cancel()
+	}
+	w.wg.Wait()
+	var err error
+	if w.owner {
+		err = w.read.Close()
+	}
+	w.mu.Lock()
+	w.closeErr = err
+	close(w.closeJoined)
+	w.mu.Unlock()
+	return err
+}
+func bindOriginalModelClient(ctx context.Context, inner chat.Chat, read interfaces.ModelOriginalRead, owner bool) (chat.Chat, error) {
+	wrapper := &modelOriginalChatClient{inner: inner, read: read, owner: owner, autoClose: owner, calls: map[uint64]context.CancelFunc{}, closeJoined: make(chan struct{}), closeSignal: make(chan struct{})}
+	if owner {
+		retained, err := retainOriginalModelClient(ctx, wrapper)
+		if err != nil {
+			read.Close()
+			return nil, err
+		}
+		wrapper.autoClose = !retained
+	}
+	if owner {
+		context.AfterFunc(ctx, func() { _ = wrapper.CloseOriginal() })
+	}
+	return wrapper, nil
+}
+
+func retainOriginalModelClient(ctx context.Context, client originalModelClientLifetime) (bool, error) {
+	slot, ok := ctx.Value(messageMaterialOutputKey{}).(*messageMaterialOutputSlot)
+	if !ok {
+		return false, nil
+	}
+	if err := client.RecheckOriginal(); err != nil {
+		return false, err
+	}
+	slot.mu.Lock()
+	defer slot.mu.Unlock()
+	if slot.Closed || slot.Failed != nil {
+		return false, types.ErrMemoryOriginalUnavailable
+	}
+	slot.Models = append(slot.Models, client)
+	return true, nil
+}
