+			session := &types.Session{ID: uuid.NewString(), TenantID: 7, UserID: types.CallerFromContext(f.ctx).UserID}
+			_, err := f.messages.sessionRepo.Create(f.ctx, session)
+			require.NoError(t, err)
+			user, assistant := appendActualMemoryTurn(t, f.messages, f.ctx, session, "My preferred development editor is VS Code.")
+			f.session, f.user, f.assistant = session, user, assistant
+			f.queue.task = nil
+			f.service.ScheduleExtraction(f.ctx, session.ID, assistant.ID, model.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			before := actualMemoryProgress(t, f.db, f.scope, session.ID)
+			bInput, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, before.OriginalAdmissionID)
+			require.NoError(t, err)
+			for _, proof := range bInput.Material.Proofs {
+				require.Empty(t, proof.AgentID)
+				require.Zero(t, proof.AgentTenantID)
+			}
+			var original types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", bInput.ID).Take(&original).Error)
+			beforeEffects := memAtomicSQLCount(t, f, "memory_original_derivations")
+			beforeReceipts := memAtomicSQLCount(t, f, "memory_original_checkpoints")
+			faultApplied := false
+			fault := func() error {
+				var result *gorm.DB
+				switch mode {
+				case "raw_target_ABA_before_model":
+					if err := f.db.Model(&types.MemoryItem{}).Where("id=?", old.ID).Update("content", old.Content+" raw unknown").Error; err != nil {
+						return err
+					}
+					if err := f.db.Model(&types.MemoryItem{}).Where("id=?", old.ID).Update("content", old.Content).Error; err != nil {
+						return err
+					}
+					faultApplied = true
+					return nil
+				case "source_before_model", "source_after_model":
+					err := revokeMemSharedAgentPolicy(f.ctx, f.db, agent, ownerID)
+					if err == nil {
+						faultApplied = true
+					}
+					return err
+				case "body_before_model", "body_after_model":
+					result = f.db.Table("original_body_payloads").Where("id=?", body.BodyID).Update("state", "purged")
+				// This fixture shares A/B's actual user selector. It proves withdrawal,
+				// not an independently scoped old API-key ancestor case.
+				case "actor_before_model", "actor_after_model":
+					result = f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false)
+				case "lease_after_model":
