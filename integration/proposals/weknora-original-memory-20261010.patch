+)
+
+type privacySDKStream interface {
+	ChatStream(context.Context, []api.Message, *api.Options) (<-chan types.StreamResponse, error)
+}
+
+func privacyActualSDK(protocol string, endpoint api.Endpoint) privacySDKStream {
+	switch protocol {
+	case "completions":
+		return openaicompletions.New(openaicompletions.Config{Endpoint: endpoint, Settings: catalog.DefaultOpenAICompletions()})
+	case "responses":
+		return openairesponses.New(openairesponses.Config{Endpoint: endpoint, Settings: catalog.DefaultOpenAIResponses()})
+	case "anthropic":
+		return anthropicmessages.New(anthropicmessages.Config{Endpoint: endpoint, Settings: catalog.DefaultAnthropicMessages()})
+	case "google":
+		return googlegenai.New(googlegenai.Config{Endpoint: endpoint, Settings: catalog.DefaultGoogleGenerativeAI()})
+	}
+	panic("unknown test protocol")
+}
+func privacyOutputFrame(protocol string) string {
+	switch protocol {
+	case "completions":
+		return `{"choices":[{"index":0,"delta":{"content":"PRIVACY_OUTPUT_SENTINEL"},"finish_reason":null}]}`
+	case "responses":
+		return `{"type":"response.output_text.delta","delta":"PRIVACY_OUTPUT_SENTINEL"}`
+	case "anthropic":
+		return `{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"PRIVACY_OUTPUT_SENTINEL"}}`
+	case "google":
+		return `{"candidates":[{"content":{"parts":[{"text":"PRIVACY_OUTPUT_SENTINEL"}]}}]}`
+	}
+	panic("unknown test protocol")
+}
+func privacyLastFrame(protocol, outcome string) string {
+	if outcome == "error" {
+		if protocol == "responses" {
+			return `{"type":"response.failed","response":{"status":"failed","error":{"message":"PRIVACY_ERROR_SENTINEL"}}}`
+		} else {
+			return `{"error":{"message":"PRIVACY_ERROR_SENTINEL"}}`
+		}
+	}
+	switch protocol {
+	case "completions":
+		return `{"choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}`
+	case "responses":
+		return `{"type":"response.completed","response":{"status":"completed","output":[]}}`
+	case "anthropic":
+		return `{"type":"message_stop"}`
+	case "google":
+		return `{"candidates":[{"content":{"parts":[]},"finishReason":"STOP"}]}`
+	}
+	panic("unknown test protocol")
+}
+
+// Actual four-protocol HTTP/SSE calls with raw dump explicitly enabled. This
+// proves only content telemetry/dump behavior and real cancel/transport joins;
+// it is not SQL/source authorization, full app or body-lifetime acceptance.
+func TestProtectedSDKStreamsKeepOrdinaryDumpAndLogging(t *testing.T) {
+	for _, protocol := range []string{"completions", "responses", "anthropic", "google"} {
+		t.Run(protocol, func(t *testing.T) {
+			for _, outcome := range []string{"complete", "error", "cancel"} {
+				t.Run(outcome, func(t *testing.T) {
+					for _, marked := range []bool{true, false} {
+						t.Run(fmt.Sprint(marked), func(t *testing.T) {
+							dir := t.TempDir()
+							t.Setenv("WEKNORA_LLM_STREAM_RAW_DUMP_DIR", dir)
+							t.Setenv("WEKNORA_LLM_STREAM_RAW_DUMP", "1")
+							var logs bytes.Buffer
+							log := logrus.New()
+							log.SetOutput(&logs)
+							log.SetLevel(logrus.DebugLevel)
+							utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+							t.Cleanup(utils.ResetSSRFWhitelistForTest)
+							started, joined := make(chan struct{}), make(chan struct{})
+							server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+								defer close(joined)
+								body, err := io.ReadAll(r.Body)
+								if err != nil {
+									t.Error("actual SDK request read failed")
+									return
+								}
+								if !bytes.Contains(body, []byte("PRIVACY_INPUT_SENTINEL")) {
+									t.Error("actual SDK request lost input")
+								}
+								close(started)
+								w.Header().Set("Content-Type", "text/event-stream")
+								_, _ = fmt.Fprintf(w, "data: %s\n\n", privacyOutputFrame(protocol))
+								w.(http.Flusher).Flush()
+								if outcome == "cancel" {
+									<-r.Context().Done()
+									return
+								}
+								_, _ = fmt.Fprintf(w, "data: %s\n\n", privacyLastFrame(protocol, outcome))
+								_, _ = io.WriteString(w, "data: [DONE]\n\n")
+							}))
+							t.Cleanup(server.Close)
+							base := context.WithValue(context.Background(), types.LoggerContextKey, logrus.NewEntry(log))
+							ctx, cancel := context.WithTimeout(base, 8*time.Second)
+							defer cancel()
+							if marked {
+								ctx = logprivacy.SuppressContent(ctx)
+							}
+							client := privacyActualSDK(protocol, api.Endpoint{BaseURL: server.URL, URL: server.URL, Model: "actual-privacy-sdk", ModelID: "actual-privacy-sdk", Auth: api.NoAuth()})
+							frames, err := client.ChatStream(ctx, []api.Message{{Role: "user", Content: "PRIVACY_INPUT_SENTINEL"}}, nil)
+							require.NoError(t, err)
+							select {
+							case <-started:
+							case <-ctx.Done():
+								t.Fatal("actual SDK provider did not start")
+							}
+							if outcome == "cancel" {
+								cancel()
+							}
+							var answer strings.Builder
+							seenError := false
+							for frame := range frames {
+								if frame.ResponseType == types.ResponseTypeAnswer {
+									answer.WriteString(frame.Content)
+								}
+								if frame.ResponseType == types.ResponseTypeError {
+									seenError = true
+								}
+							}
+							select {
+							case <-joined:
+							case <-time.After(3 * time.Second):
+								t.Fatal("actual SDK HTTP provider did not join")
+							}
+							if outcome != "cancel" {
