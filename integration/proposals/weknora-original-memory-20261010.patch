+ digest TEXT NOT NULL,created_at TIMESTAMPTZ NOT NULL);
+CREATE TABLE memory_generated_receipts (
+ id TEXT PRIMARY KEY,original_id TEXT NOT NULL REFERENCES memory_generated_originals(id),original_digest TEXT NOT NULL,
+ tenant_id BIGINT NOT NULL,subject_id TEXT NOT NULL,recipe TEXT NOT NULL,response_json TEXT NOT NULL,response_sha256 TEXT NOT NULL,
+ effect_manifest TEXT NOT NULL,effect_digest TEXT NOT NULL,digest TEXT NOT NULL,created_at TIMESTAMPTZ NOT NULL,
+ UNIQUE(original_id));
