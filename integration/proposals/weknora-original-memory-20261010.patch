+								data, err := os.ReadFile(filepath.Join(dir, entries[0].Name()))
+								require.NoError(t, err)
+								require.Contains(t, string(data), "PRIVACY_INPUT_SENTINEL")
+								require.Contains(t, logs.String(), "PRIVACY_INPUT_SENTINEL")
