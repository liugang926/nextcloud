+func memoryGeneratedClusterIDs(clusters []types.MemoryGeneratedCluster) [][]string {
+	ids := [][]string{}
+	for _, cluster := range clusters {
+		ids = append(ids, append([]string(nil), cluster.ItemIDs...))
