diff --git a/internal/application/service/memory/derived.go b/internal/application/service/memory/derived.go
new file mode 100644
index 00000000..90780252
--- /dev/null
+++ b/internal/application/service/memory/derived.go
@@ -0,0 +1,286 @@
+package memory
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+)
+
+type memoryDerivedContextKey struct{}
+type memoryDerivedOwner struct {
+	read     interfaces.MemoryDerivedRead
+	snapshot *types.MemoryDerivedSnapshot
+}
+
+func (s *Service) beginDerivedInputs(ctx context.Context, scope interfaces.MemoryScope) (context.Context, interfaces.MemoryDerivedRead, error) {
+	reader, ok := s.admissions.(interfaces.MemoryDerivedLifetimeReader)
+	if !ok {
+		return ctx, nil, types.ErrMemoryOriginalUnavailable
+	}
+	read, err := reader.BeginMemoryDerivedRead(ctx, scope)
+	if err != nil {
+		return ctx, nil, err
+	}
+	snapshot, err := read.Snapshot()
+	if err != nil {
+		read.Close()
+		return ctx, nil, err
+	}
+	return context.WithValue(logprivacy.SuppressContent(read.Context()), memoryDerivedContextKey{}, &memoryDerivedOwner{read: read, snapshot: snapshot}), read, nil
+}
+func checkDerivedInputs(ctx context.Context) error {
+	owner, _ := ctx.Value(memoryDerivedContextKey{}).(*memoryDerivedOwner)
+	if owner == nil || owner.read == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return owner.read.Recheck()
+}
+func derivedProof(snapshot *types.MemoryDerivedSnapshot, kind, id string) (types.MemoryDerivedInputProof, bool) {
+	for _, proof := range snapshot.Manifest.Inputs {
+		if proof.ObjectKind == kind && proof.ObjectID == id {
+			return proof, true
+		}
+	}
+	return types.MemoryDerivedInputProof{}, false
+}
+func liveDerivedItems(snapshot *types.MemoryDerivedSnapshot) []*types.MemoryItem {
+	items := []*types.MemoryItem{}
+	now := time.Now()
+	for _, item := range snapshot.Items {
+		if item != nil && item.Status == types.MemoryStatusActive && (item.ExpiresAt == nil || item.ExpiresAt.After(now)) {
+			items = append(items, item)
+		}
+	}
+	sort.SliceStable(items, func(i, j int) bool {
+		a, b := items[i], items[j]
+		if a.Importance != b.Importance {
+			return a.Importance > b.Importance
+		}
+		if !a.ValidFrom.Equal(b.ValidFrom) {
+			return a.ValidFrom.After(b.ValidFrom)
+		}
+		return a.ID < b.ID
+	})
+	return items
+}
+func (s *Service) relevantDerivedInputs(ctx context.Context, scope interfaces.MemoryScope, cfg *types.MemoryConfig, segment transcriptSegment) ([]*types.MemoryItem, *types.MemoryDerivedSnapshot, error) {
+	if err := checkDerivedInputs(ctx); err != nil {
+		return nil, nil, err
+	}
+	owner, _ := ctx.Value(memoryDerivedContextKey{}).(*memoryDerivedOwner)
+	snapshot := owner.snapshot
+	items := liveDerivedItems(snapshot)
+	if len(items) <= extractRelevantCandidates {
+		return items, snapshot, nil
+	}
+	query := strings.Builder{}
+	for _, line := range segment.lines {
+		query.WriteString(line.content)
+		query.WriteString("\n")
+	}
+	hits, _ := s.vectorSearch(ctx, scope, cfg, query.String(), types.MemoryKinds, extractRelevantCandidates)
+	if err := checkDerivedInputs(ctx); err != nil {
+		return nil, nil, err
+	}
+	byID := map[string]*types.MemoryItem{}
+	for _, item := range items {
+		byID[item.ID] = item
+	}
+	selected := []*types.MemoryItem{}
+	for _, hit := range hits {
+		if hit.Item != nil {
+			if item := byID[hit.Item.ID]; item != nil {
+				selected = append(selected, item)
+			}
+		}
+	}
+	if len(selected) == 0 {
+		selected = items[:extractRelevantCandidates]
+	}
+	return selected, snapshot, nil
+}
+func prepareDerivedMutations(scope interfaces.MemoryScope, segment transcriptSegment, parsed extractionResponse, existing []*types.MemoryItem, snapshot *types.MemoryDerivedSnapshot) ([]types.MemoryOriginalMutation, error) {
+	if snapshot == nil || len(parsed.Memories) > extractMaxItemsPerRun {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	ops := []types.MemoryOriginalMutation{}
+	seen := map[string]bool{}
+	for _, decision := range parsed.Memories {
+		action := strings.ToLower(strings.TrimSpace(decision.Action))
+		if action == "none" || action == "noop" {
+			continue
+		}
+		if action != "add" && action != "update" && action != "delete" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		if !types.IsValidMemoryKind(decision.Kind) && (action != "delete" || decision.Kind != "") {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		topic := types.SanitizeMemoryTopic(decision.Topic)
+		var target *types.MemoryItem
+		targetMarked := false
+		if action == "update" || action == "delete" {
+			if decision.Target != nil {
+				if *decision.Target < 0 || *decision.Target >= len(existing) {
+					return nil, types.ErrMemoryOriginalUnavailable
+				}
+				target = existing[*decision.Target]
+			} else {
+				key := types.MemoryItemKey(topic, decision.Content)
+				for _, item := range liveDerivedItems(snapshot) {
+					if item.NormalizedKey == key {
+						target = item
+						break
+					}
+				}
+			}
+			if target == nil {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			topic = target.Topic
+			if seen["target:"+target.ID] {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			seen["target:"+target.ID] = true
+			targetMarked = true
+		}
+		content := types.SanitizeMemoryContent(decision.Content)
+		if action != "delete" && content == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		if redacted, changed := types.RedactSensitive(content); changed {
+			if types.IsMostlyRedacted(redacted) {
+				return nil, ErrSensitiveContent
+			}
+			content = types.SanitizeMemoryContent(redacted)
+		}
+		key := types.MemoryItemKey(topic, content)
+		if action != "delete" && key == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		if action != "delete" {
+			if seen["key:"+key] {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			seen["key:"+key] = true
+		}
+		source := decision.resolveSource(segment)
+		if source.messageID == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		forgotten := false
+		for _, tomb := range snapshot.Tombstones {
+			if tomb.Fingerprint == types.MemoryFingerprint(content) || tomb.SourceMessageID != "" && tomb.SourceMessageID == source.messageID && tomb.CreatedAt.After(time.Now().Add(-rejectedMessageWindow)) {
+				forgotten = true
+				break
+			}
+		}
+		if action != "delete" && forgotten {
+			continue
+		}
+		if action == "add" {
+			for _, item := range snapshot.Items {
+				if item.Status != types.MemoryStatusActive && item.Status != types.MemoryStatusPending {
+					continue
+				}
+				sameKey := item.NormalizedKey == key && key != ""
+				contained := item.Kind == decision.Kind && strings.Contains(types.NormalizeMemoryForMatch(item.Content), types.NormalizeMemoryForMatch(content))
+				if sameKey && item.Content == content || contained {
+					forgotten = true
+					break
+				}
+				if sameKey {
+					target = item
+					action = "update"
+					break
+				}
+			}
+			if forgotten {
+				continue
+			}
+		}
+		op := types.MemoryOriginalMutation{ID: uuid.NewString(), Action: action, SourceMessageID: source.messageID}
+		if target != nil {
+			if !targetMarked {
+				if seen["target:"+target.ID] {
+					return nil, types.ErrMemoryOriginalUnavailable
+				}
+				seen["target:"+target.ID] = true
+			}
+			proof, ok := derivedProof(snapshot, "memory_item", target.ID)
+			if !ok {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			op.TargetID = target.ID
+			op.TargetPublicationID = proof.PublicationID
+			op.TargetDerivationID = proof.DerivationID
+			op.TargetDigest = proof.MaterialDigest
+		}
+		if action != "delete" {
+			kind := decision.Kind
+			item := &types.MemoryItem{ID: op.ID, TenantID: scope.TenantID, SubjectID: scope.SubjectID, Kind: kind, Content: content, Topic: topic, NormalizedKey: key, Importance: types.ClampMemoryImportance(decision.Importance), Origin: types.MemoryOriginExtracted, SourceSessionID: source.sessionID, SourceMessageID: source.messageID, ValidFrom: time.Now().UTC(), ExpiresAt: parseExpiry(decision.ExpiresAt), Inferred: decision.Inferred}
+			item.Status = statusForWrite(*item)
+			op.Item = item
+		}
+		ops = append(ops, op)
+	}
+
+	return ops, nil
+}
+
+func (s *Service) prepareDerivedTopics(ctx context.Context, scope interfaces.MemoryScope, cfg *types.MemoryConfig, payload types.MemoryExtractPayload, topics []string, snapshot *types.MemoryDerivedSnapshot) ([]types.MemoryOriginalMutation, error) {
+	if err := s.checkMemoryExecutionControl(ctx); err != nil {
+		return nil, err
+	}
+	resolutions := s.resolveTopics(ctx, scope, s.extractionModelID(ctx, cfg, payload), topics)
+	if err := s.checkMemoryExecutionControl(ctx); err != nil {
+		return nil, err
+	}
+	ops := []types.MemoryOriginalMutation{}
+	seen := map[string]bool{}
+	for _, resolution := range resolutions {
+		surface := types.SanitizeMemoryTopic(resolution.Surface)
+		if surface == "" {
+			continue
+		}
+		topic := surface
+		key := types.NormalizeTopicKey(topic)
+		if resolution.Canonical != nil {
+			topic = resolution.Canonical.Topic
+			key = resolution.Canonical.NormalizedKey
+		}
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		blocked := false
+		for _, tomb := range snapshot.Tombstones {
+			if types.NormalizeTopicKey(tomb.Topic) == key || types.NormalizeTopicKey(tomb.Topic) == types.NormalizeTopicKey(surface) {
+				blocked = true
+				break
+			}
+		}
+		if blocked {
+			continue
+		}
+		op := types.MemoryOriginalMutation{ID: uuid.NewString(), Action: "topic", Topic: surface, NormalizedKey: key, TopicMergedLabel: resolution.MergedLabel}
+		if resolution.Canonical != nil {
+			proof, ok := derivedProof(snapshot, "memory_topic", resolution.Canonical.ID)
+			if !ok {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			op.TargetID = resolution.Canonical.ID
+			op.TargetPublicationID = proof.PublicationID
+			op.TargetDerivationID = proof.DerivationID
+			op.TargetDigest = proof.MaterialDigest
+		}
+		ops = append(ops, op)
+	}
+	return ops, nil
+}
