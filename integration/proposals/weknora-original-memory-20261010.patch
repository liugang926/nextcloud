new file mode 100644
index 00000000..11495bf3
--- /dev/null
+++ b/internal/router/sync_task_lifecycle.go
@@ -0,0 +1,42 @@
+package router
+
+import (
+	"context"
+	"errors"
+	"time"
+)
+
+var ErrSyncTaskExecutorStopped = errors.New("sync task executor is stopped")
+
+func waitSyncTaskDelay(ctx context.Context, delay time.Duration) bool {
+	if ctx.Err() != nil {
+		return false
+	}
+	if delay <= 0 {
+		return true
+	}
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return ctx.Err() == nil
+	}
+}
+
+// Stop refuses new work before cancelling existing tasks. Add occurs under the
+// same mutex as stopped, so no worker can appear after the join starts. A task
+// handler must return before this reports success, including cleanup defers.
+func (e *SyncTaskExecutor) Stop() {
+	if e == nil {
+		return
+	}
+	e.mu.Lock()
+	if !e.stopped {
+		e.stopped = true
+		e.cancel()
+	}
+	e.mu.Unlock()
+	e.workers.Wait()
+}
