+						fault = f.DB.Model(&types.User{}).Where("id=?", f.Session.UserID).Update("is_active", false).Error
+					} else {
+						fault = f.DB.Model(&types.Model{}).Where("id=?", "normal-reference-model").Update("status", types.ModelStatusDownloadFailed).Error
+					}
+					if fault != nil {
+						t.Error("actual model/actor mutation failed")
+						return
+					}
+					_, _ = io.WriteString(w, "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"POST_REVOKE_MODEL_TAIL\"},\"finish_reason\":\"stop\"}]}\n\n")
+					w.(http.Flusher).Flush()
+					<-r.Context().Done()
+					cancelled.Store(true)
+					return
+				}
+				_, _ = io.WriteString(w, "data: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n")
+				w.(http.Flusher).Flush()
