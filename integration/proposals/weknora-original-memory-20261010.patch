+// SOURCE ONLY additional component coverage, never a substitute for frozen
+// original30cases/14units/custom/existing-memory/fullmigration/app acceptance.
+// MaxItems1 is a legitimate tenant setting saved before original capture.
+func runMemOriginalCapacityWholeResultSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"two_model_operations_plus_archive_origin", "archive_SQL_fault_rolls_back_whole_result"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			tenants := repository.NewTenantRepository(f.db)
+			tenant, err := tenants.GetTenantByID(f.ctx, f.scope.TenantID)
+			require.NoError(t, err)
+			require.NotNil(t, tenant.MemoryConfig)
+			cfg := *tenant.MemoryConfig
+			cfg.Normalize()
+			cfg.MaxItems = 1
+			require.Equal(t, f.model.GetModelID(), cfg.ExtractModelID)
+			require.Empty(t, cfg.ExtractInstructions)
+			tenant.MemoryConfig = &cfg
+			require.NoError(t, tenants.UpdateTenant(f.ctx, tenant))
+			saved, err := tenants.GetTenantByID(f.ctx, f.scope.TenantID)
+			require.NoError(t, err)
+			require.Equal(t, 1, saved.MemoryConfig.MaxItems)
+			f.model.twoOperations = true
+			successfulCreates := 0
+			observer := "owned_capacity_model_create_" + uuid.NewString()
+			require.NoError(t, f.db.Callback().Create().After("gorm:create").Register(observer, func(tx *gorm.DB) {
+				if tx.Statement != nil && tx.Statement.Table == "memory_items" && tx.Error == nil {
+					successfulCreates++
+				}
+			}))
+			defer f.db.Callback().Create().Remove(observer)
+			if mode == "archive_SQL_fault_rolls_back_whole_result" {
+				// Genuine driver fault on the archive UPDATE, after both model
+				// INSERT statements. No forged authority or callback error.
+				ddl := `CREATE TRIGGER owned_capacity_archive_denied BEFORE UPDATE OF status ON memory_items
+                    WHEN NEW.status='archived' AND OLD.status<>'archived'
+                    BEGIN SELECT RAISE(ABORT,'bounded archive SQL fault'); END;`
+				if pg {
+					ddl = `CREATE FUNCTION owned_capacity_archive_denied() RETURNS trigger LANGUAGE plpgsql AS $$
+                    BEGIN IF NEW.status='archived' AND OLD.status<>'archived' THEN RAISE EXCEPTION 'bounded archive SQL fault'; END IF; RETURN NEW; END; $$;
+                    CREATE TRIGGER owned_capacity_archive_denied BEFORE UPDATE OF status ON memory_items
+                    FOR EACH ROW EXECUTE FUNCTION owned_capacity_archive_denied();`
+				}
+				require.NoError(t, f.db.Exec(ddl).Error)
+			}
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			input, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, before.OriginalAdmissionID)
+			require.NoError(t, err)
+			worker, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			handleErr := f.service.Handle(worker, f.queue.task)
+			cancel()
+			require.Equal(t, 1, f.model.calls)
+			assert.Equal(t, 2, successfulCreates, "both real model-operation INSERTs were executed inside the atomic result transaction")
+			if mode == "archive_SQL_fault_rolls_back_whole_result" {
+				require.ErrorContains(t, handleErr, "bounded archive SQL fault")
+				assertMemAtomicSQLNoEffects(t, f, before)
+				var payload types.MemoryExtractPayload
+				require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &payload))
+				completed, err := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payload)
+				require.NoError(t, err)
+				assert.False(t, completed)
+				assert.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_admissions"), "valid input is retained, not deleted to hide a rollback")
+			} else {
+				require.NoError(t, handleErr)
+				after := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+				require.False(t, after.Pending)
+				require.True(t, after.Cursor.After(before.Cursor))
+				// Metadata only: do not treat current item body lookup as an
+				// original input or grant an unimplemented derived reader.
+				var items []struct {
+					ID     string
+					Status string
+				}
+				require.NoError(t, f.db.Table("memory_items").Select("id,status").Where("tenant_id=? AND subject_id=?", f.scope.TenantID, f.scope.SubjectID).Find(&items).Error)
+				require.Len(t, items, 2)
+				statuses := map[string]int{}
+				archivedID := ""
+				for _, item := range items {
+					statuses[item.Status]++
+					if item.Status == types.MemoryStatusArchived {
+						archivedID = item.ID
+					}
+				}
+				assert.Equal(t, 1, statuses[types.MemoryStatusActive])
+				assert.Equal(t, 1, statuses[types.MemoryStatusArchived])
+				var receipt types.MemoryOriginalCheckpoint
+				require.NoError(t, f.db.Where("id=?", after.OriginalCheckpointID).Take(&receipt).Error)
+				require.Equal(t, input.ID, receipt.InputAdmissionID)
+				require.True(t, receipt.Drained)
+				var manifest []types.MemoryOriginalEffect
+				require.NoError(t, json.Unmarshal([]byte(receipt.OperationManifest), &manifest))
+				require.Len(t, manifest, 3)
+				operationsDigest, err := repository.KnowledgeInputDigest(manifest)
+				require.NoError(t, err)
+				assert.Equal(t, receipt.OperationsDigest, operationsDigest)
+				var origins []types.MemoryOriginalDerivation
+				require.NoError(t, f.db.Where("commit_id=?", receipt.ID).Find(&origins).Error)
+				require.Len(t, origins, 3)
+				modelOrigins := map[string]types.MemoryOriginalDerivation{}
+				var archive *types.MemoryOriginalDerivation
+				for index := range origins {
+					origin := origins[index]
+					copy := origin
+					copy.Digest = ""
+					digest, err := repository.KnowledgeInputDigest(copy)
+					require.NoError(t, err)
+					assert.Equal(t, origin.Digest, digest)
+					assert.Equal(t, input.ID, origin.InputAdmissionID)
+					assert.Equal(t, receipt.ExecutionAdmissionID, origin.ExecutionAdmissionID)
+					if origin.Action == "add" {
+						modelOrigins[origin.ID] = origin
+					}
+					if origin.Action == "archive" {
+						archive = &origins[index]
+					}
+				}
+				require.Len(t, modelOrigins, 2)
+				require.NotNil(t, archive)
+				assert.Equal(t, archivedID, archive.ObjectID)
+				parent, exists := modelOrigins[archive.ParentDerivationID]
+				require.True(t, exists)
+				assert.Equal(t, parent.ObjectID, archive.ObjectID)
+				assert.Equal(t, parent.OperationID, archive.OperationID)
+				var dependency struct {
+					InputID, InputDigest, ExecutionID, ExecutionDigest, ModelResultDigest, Recipe, Parent, EffectRole string
+					Capacity                                                                                          *struct {
+						Keep            int
+						CurrentCommitID string
+						RankingDigest   string
+						BeforeDigest    string
+						AfterDigest     string
+						RankedControls  []json.RawMessage
+					}
+				}
+				require.NoError(t, json.Unmarshal([]byte(archive.DependencyJSON), &dependency))
+				require.NotNil(t, dependency.Capacity)
+				assert.Equal(t, "capacity_retirement", dependency.EffectRole)
+				assert.Equal(t, input.ID, dependency.InputID)
+				assert.Equal(t, input.Digest, dependency.InputDigest)
+				assert.Equal(t, receipt.ExecutionAdmissionID, dependency.ExecutionID)
+				assert.Equal(t, receipt.ModelResultDigest, dependency.ModelResultDigest)
+				assert.Equal(t, receipt.Recipe, dependency.Recipe)
+				assert.Equal(t, parent.ID, dependency.Parent)
+				assert.Equal(t, 1, dependency.Capacity.Keep)
+				assert.Equal(t, receipt.ID, dependency.Capacity.CurrentCommitID)
+				assert.Len(t, dependency.Capacity.RankedControls, 2)
+				assert.Len(t, dependency.Capacity.RankingDigest, 64)
+				assert.Equal(t, parent.BodyDigest, dependency.Capacity.BeforeDigest)
+				assert.Equal(t, archive.BodyDigest, dependency.Capacity.AfterDigest)
+				var payload types.MemoryExtractPayload
+				require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &payload))
+				completed, err := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payload)
+				require.NoError(t, err)
+				assert.True(t, completed)
+				assert.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+			}
+			assert.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryOriginalCapacityWholeResultActualSQLite(t *testing.T) {
+	runMemOriginalCapacityWholeResultSQL(t, false)
+}
+func TestPostgresMemoryOriginalCapacityWholeResultActual(t *testing.T) {
+	runMemOriginalCapacityWholeResultSQL(t, true)
+}
