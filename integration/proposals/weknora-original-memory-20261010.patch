+func appendActualMemoryTurn(t *testing.T, messages *messageService, ctx context.Context, session *types.Session, content string) (*types.Message, *types.Message) {
+	t.Helper()
+	requestID := uuid.NewString()
+	user, err := messages.CreateMessage(ctx, &types.Message{SessionID: session.ID, RequestID: requestID, Role: "user", Content: content, IsCompleted: true})
+	require.NoError(t, err)
+	assistant, err := messages.CreateMessage(ctx, &types.Message{SessionID: session.ID, RequestID: requestID, Role: "assistant"})
+	require.NoError(t, err)
+	writer := WithMessageMaterialOutputBoundary(ctx)
+	defer CloseMessageMaterialOutputBoundary(writer)
+	// The actual model-reader path retains its admitted original envelope.
+	// Public raw-human display intentionally strips generated/source fields.
+	writer = context.WithValue(writer, agentHistoryCurrentRequestKey{}, requestID)
+	writer = types.WithRAGSourceLineage(writer, types.NewRAGSourceLineage(func(check context.Context, source *types.SourceLineage) error {
+		return messages.sourceLineageGuard.Check(check, source, access.LineageReadScope{})
+	}))
+	actualUser, err := messages.GetMessage(writer, session.ID, user.ID)
+	require.NoError(t, err)
+	require.Equal(t, content, actualUser.Content)
+	require.NoError(t, messages.bindInitialMessageMaterial(writer, assistant.ID, user.ID, requestID))
+	// A real authorized ordinary completion records the input manifest. Its
+	// output does not become extraction input: extraction reads raw users only.
+	producer := &enrichmentTestModel{response: "The ordinary input was received."}
+	require.NoError(t, CheckMessageMaterialOutputBoundary(writer))
+	response, err := producer.Chat(writer, []chat.Message{{Role: "user", Content: actualUser.Content, SourceLineage: actualUser.SourceLineage}}, &chat.ChatOptions{})
+	require.NoError(t, err)
+	require.Equal(t, 1, producer.calls)
+	require.NoError(t, CheckMessageMaterialOutputBoundary(writer))
+	assistant.Content = response.Content
+	assistant.IsCompleted = true
+	assistant.SourceLineage, err = types.UnionSourceLineage(actualUser.SourceLineage)
+	require.NoError(t, err)
+	require.NoError(t, messages.UpdateMessage(writer, assistant))
+	return user, assistant
+}
