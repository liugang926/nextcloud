+)
+
+// SOURCE ONLY. Reuse the frozen3ff/c163 genuine SQL fixture, leave its20
+// single-call cases unchanged. This explicit two-call transport never resets
+// counters and does not write admissions, cursors, receipts or body authority.
+// A is a real noop model run; B is a real new admitted human/assistant turn.
+type memCrossInputSQLModel struct {
+	calls   int
+	prompts []string
+	modelID string
+}
+
+func (m *memCrossInputSQLModel) Chat(ctx context.Context, input []chat.Message, _ *chat.ChatOptions) (*types.ChatResponse, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	m.calls++
+	if m.calls > 2 {
+		return nil, fmt.Errorf("cross-input transport permits exactly two genuine provider calls")
+	}
+	var prompt strings.Builder
+	for _, message := range input {
+		prompt.WriteString(message.Content)
+		prompt.WriteByte('\n')
+	}
+	m.prompts = append(m.prompts, prompt.String())
+	decisions := []map[string]interface{}{}
+	if m.calls == 2 {
+		decisions = append(decisions, map[string]interface{}{"action": "add", "kind": "fact", "topic": "development editor", "content": actualMemoryStoredText, "importance": 4, "source": 1})
+	}
+	encoded, err := json.Marshal(map[string]interface{}{"memories": decisions, "topics": []string{}})
+	if err != nil {
+		return nil, err
+	}
+	return &types.ChatResponse{Content: string(encoded)}, nil
+}
+func (m *memCrossInputSQLModel) ChatStream(context.Context, []chat.Message, *chat.ChatOptions) (<-chan types.StreamResponse, error) {
+	return nil, fmt.Errorf("cross-input extraction is nonstreaming")
+}
+func (m *memCrossInputSQLModel) GetModelID() string { return m.modelID }
+func (m *memCrossInputSQLModel) GetModelName() string {
+	return "bounded two-call original memory transport"
+}
+
+type memCrossInputSQLModels struct {
+	actualMemoryModels
+	actual *memCrossInputSQLModel
+}
+
+func (m memCrossInputSQLModels) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	if _, err := m.actualMemoryModels.GetChatModel(ctx, id); err != nil {
+		return nil, err
+	}
+	return m.actual, nil
+}
+
+// This queue captures only the two tasks really emitted by the real outbox.
+// No fabricated authoritative task or direct-enqueue fallback is accepted.
+type memCrossInputSQLQueue struct {
+	tasks   []*asynq.Task
+	options [][]asynq.Option
+}
+
+func (q *memCrossInputSQLQueue) Enqueue(task *asynq.Task, options ...asynq.Option) (*asynq.TaskInfo, error) {
+	return q.EnqueueContext(context.Background(), task, options...)
+}
+func (q *memCrossInputSQLQueue) EnqueueContext(ctx context.Context, task *asynq.Task, options ...asynq.Option) (*asynq.TaskInfo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if task.Type() != types.TypeMemoryExtract || len(q.tasks) >= 2 {
+		return nil, fmt.Errorf("bounded cross-input queue refuses another task")
+	}
+	q.tasks = append(q.tasks, task)
+	q.options = append(q.options, append([]asynq.Option(nil), options...))
+	return &asynq.TaskInfo{ID: uuid.NewString(), Type: task.Type(), Queue: types.QueueMemory}, nil
+}
+func relayMemCrossInputSQL(t *testing.T, f *memAtomicSQLFixture, runner *MemoryOriginalOutboxRunner, queue *memCrossInputSQLQueue, priorTasks int) (*types.MemoryOriginalInput, types.MemoryExtractPayload, *asynq.Task) {
+	t.Helper()
+	require.Len(t, queue.tasks, priorTasks, "Schedule must only commit an immutable intent")
+	progress := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	input, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, progress.OriginalAdmissionID)
+	require.NoError(t, err)
+	var intent types.MemoryOriginalDispatch
+	require.NoError(t, f.db.Where("admission_id=?", input.ID).Take(&intent).Error)
+	require.Equal(t, input.ID, intent.AdmissionID)
+	require.Equal(t, types.MemoryOriginalBytesDigest([]byte(intent.Payload)), intent.PayloadDigest)
+	require.True(t, intent.NotBefore.Equal(input.Request.DispatchNotBefore))
+	var expected types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal([]byte(intent.Payload), &expected))
+	require.Equal(t, input.ID, expected.OriginalAdmissionID)
+	require.Equal(t, input.Digest, expected.OriginalDigest)
+	wait := time.Until(intent.NotBefore)
+	require.LessOrEqual(t, wait, time.Duration(types.MinMemoryExtractDelaySeconds+2)*time.Second)
+	if wait > 0 {
+		time.Sleep(wait + 10*time.Millisecond)
+	}
+	operation, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	claimed, err := runner.RelayOne(operation, input.ID)
+	require.NoError(t, err)
+	require.True(t, claimed)
+	require.Len(t, queue.tasks, priorTasks+1)
+	task := queue.tasks[priorTasks]
+	var actual types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal(task.Payload(), &actual))
+	require.Equal(t, expected, actual)
+	var after types.MemoryOriginalDispatch
+	require.NoError(t, f.db.Where("admission_id=?", input.ID).Take(&after).Error)
+	require.Equal(t, intent.Payload, after.Payload)
+	require.Equal(t, intent.PayloadDigest, after.PayloadDigest)
+	require.True(t, intent.NotBefore.Equal(after.NotBefore))
+	require.Empty(t, after.LeaseID)
+	require.Nil(t, after.LeaseUntil)
+	return input, actual, task
+}
+func runMemCrossInputCheckpointSQL(t *testing.T, pg bool) {
+	f := newMemAtomicSQLFixture(t, pg)
+	// Set a legitimate component-fixture product interval before A captures
+	// policy. Default production interval300s is unchanged in source/config;
+	// this fixture uses1s, below its real5s dispatchdelay, for both A and B.
+	tenants := repository.NewTenantRepository(f.db)
+	tenant, err := tenants.GetTenantByID(f.ctx, f.scope.TenantID)
+	require.NoError(t, err)
+	require.NotNil(t, tenant.MemoryConfig)
+	cfg := *tenant.MemoryConfig
+	cfg.Normalize()
+	require.Equal(t, types.MinMemoryExtractDelaySeconds, cfg.ExtractDelaySeconds)
+	require.Equal(t, f.model.GetModelID(), cfg.ExtractModelID)
+	require.Empty(t, cfg.ExtractInstructions)
+	cfg.ExtractMinIntervalSeconds = 1
+	tenant.MemoryConfig = &cfg
+	require.NoError(t, tenants.UpdateTenant(f.ctx, tenant))
+	persisted, err := tenants.GetTenantByID(f.ctx, f.scope.TenantID)
+	require.NoError(t, err)
+	require.NotNil(t, persisted.MemoryConfig)
+	require.Equal(t, 1, persisted.MemoryConfig.ExtractMinIntervalSeconds)
+	require.Equal(t, time.Second, persisted.MemoryConfig.ExtractMinInterval())
+	require.Equal(t, time.Duration(types.MinMemoryExtractDelaySeconds)*time.Second, persisted.MemoryConfig.ExtractDelay())
+	queue := &memCrossInputSQLQueue{}
+	model := &memCrossInputSQLModel{modelID: f.model.GetModelID()}
+	models := memCrossInputSQLModels{actualMemoryModels: actualMemoryModels{model: f.model.actualMemoryModel, db: f.db, originals: f.admissions.(interfaces.ModelOriginalLifetimeReader)}, actual: model}
+	worker := memoryservice.NewOriginalBoundMemoryService(f.repo, repository.NewTenantRepository(f.db), repository.NewMessageRepository(f.db), models, queue, nil, f.reader, f.admissions)
+	memoryservice.ConfigureOriginalMemoryOutbox(worker, f.outbox)
+	runner := NewMemoryOriginalOutboxRunner(f.outbox, queue)
+	// No relay/executor background loop is started in this bounded component.
+	// It still invokes the exact production RelayOne and Handle methods.
+	worker.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, model.GetModelID())
+	inputA, payloadA, taskA := relayMemCrossInputSQL(t, f, runner, queue, 0)
+	runA, cancelA := context.WithTimeout(context.Background(), 10*time.Second)
+	err = worker.Handle(runA, taskA)
+	cancelA()
+	require.NoError(t, err)
+	require.Equal(t, 1, model.calls)
+	require.Len(t, model.prompts, 1)
+	require.Contains(t, model.prompts[0], actualMemoryAuthoredText)
+	progressA := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	require.False(t, progressA.Pending)
+	require.NotEmpty(t, progressA.OriginalCheckpointID)
+	require.True(t, progressA.Cursor.After(inputA.Request.FromCursor))
+	require.EqualValues(t, 0, memAtomicSQLCount(t, f, "memory_items"))
+	require.EqualValues(t, 0, memAtomicSQLCount(t, f, "memory_original_derivations"))
+	var receiptA types.MemoryOriginalCheckpoint
+	require.NoError(t, f.db.Where("id=?", progressA.OriginalCheckpointID).Take(&receiptA).Error)
+	require.True(t, receiptA.Drained)
+	require.Equal(t, inputA.ID, receiptA.InputAdmissionID)
+	completedA, err := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payloadA)
+	require.NoError(t, err)
+	require.True(t, completedA)
+	firstUserID := f.user.ID
+	firstFacts := f.originals
+
+	// B is authored/admitted by the real message producer. No current SQL
+	// repair, cursor seed, admission import or receipt re-signing occurs.
+	userB, assistantB := appendActualMemoryTurn(t, f.messages, f.ctx, f.session, actualMemoryPriorText)
+	f.user, f.assistant = userB, assistantB
+	f.originals = actualMemoryFacts(t, f.db, userB.ID)
+	worker.ScheduleExtraction(f.ctx, f.session.ID, assistantB.ID, model.GetModelID())
+	inputB, payloadB, taskB := relayMemCrossInputSQL(t, f, runner, queue, 1)
+	require.NotEqual(t, inputA.ID, inputB.ID)
+	require.Equal(t, inputA.ID, inputB.Request.PreviousAdmissionID)
+	require.Equal(t, receiptA.ID, inputB.Request.PreviousCheckpointID)
+	require.True(t, receiptA.To.At.Equal(inputB.Request.FromCursor.At), "B starts at the exact prior checkpoint instant")
+	require.Equal(t, receiptA.To.ID, inputB.Request.FromCursor.ID, "B starts at the exact prior checkpoint message")
+	require.Equal(t, firstFacts, actualMemoryFacts(t, f.db, firstUserID), "B does not upgrade the old original body")
+	runB, cancelB := context.WithTimeout(context.Background(), 10*time.Second)
+	err = worker.Handle(runB, taskB)
+	cancelB()
+	require.NoError(t, err)
+	require.Equal(t, 2, model.calls, "two genuine calls; transport counters are never reset")
+	require.Len(t, model.prompts, 2)
+	require.Contains(t, model.prompts[1], actualMemoryAuthoredText)
+	require.Contains(t, model.prompts[1], actualMemoryPriorText)
+	progressB := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	require.False(t, progressB.Pending)
+	require.True(t, progressB.Cursor.After(progressA.Cursor))
+	var receiptB types.MemoryOriginalCheckpoint
+	require.NoError(t, f.db.Where("id=?", progressB.OriginalCheckpointID).Take(&receiptB).Error)
+	require.Equal(t, inputB.ID, receiptB.InputAdmissionID)
+	require.Equal(t, inputB.Digest, receiptB.InputDigest)
+	require.True(t, receiptA.To.At.Equal(receiptB.From.At), "B's receipt retains the exact prior checkpoint instant")
+	require.Equal(t, receiptA.To.ID, receiptB.From.ID, "B's receipt retains the exact prior checkpoint message")
+	require.True(t, receiptB.Drained)
+	assert.Empty(t, receiptB.PreviousCheckpointID, "a new input's first checkpoint is separate from its captured prior-input anchor")
+	completedB, err := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payloadB)
+	require.NoError(t, err, "B must not traverse cA as if cA were a same-input checkpoint")
+	require.True(t, completedB)
+	completedA, err = f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payloadA)
+	require.NoError(t, err)
+	require.True(t, completedA)
+	require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+	require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_derivations"))
+	require.EqualValues(t, 2, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+	require.Equal(t, firstFacts, actualMemoryFacts(t, f.db, firstUserID))
+	assertMemAtomicSQLLeasesClosed(t, f)
+}
+func TestMemoryOriginalCrossInputCheckpointActualSQLite(t *testing.T) {
+	runMemCrossInputCheckpointSQL(t, false)
+}
+func TestPostgresMemoryOriginalCrossInputCheckpointActual(t *testing.T) {
+	runMemCrossInputCheckpointSQL(t, true)
