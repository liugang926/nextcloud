+	tenant.MemoryConfig = &types.MemoryConfig{Enabled: true, WriteMode: types.MemoryWriteAuto, ExtractModelID: model.GetModelID(), ExtractInstructions: "", ExtractDelaySeconds: types.MinMemoryExtractDelaySeconds}
+	ConfigureTenantMemoryPolicyAuthority(tenantRepo, machine.f.store, NewGroupAccessService(repository.NewGroupAccessRepository(db)), nil)
+	policyWriter, ok := tenantRepo.(interfaces.MemoryPolicyOriginalWriter)
+	require.True(t, ok)
+	policyReader, ok := tenantRepo.(interfaces.MemoryPolicyOriginalReader)
+	require.True(t, ok)
+	_, _, err = policyReader.ReadMemoryPolicyOriginal(ctx, 7)
+	require.ErrorIs(t, err, repository.ErrMemoryPolicyOriginUnknown, "migration controls never authenticate an old configuration")
+	_, proof, err := policyWriter.ReplaceMemoryPolicyOriginal(ctx, 7, *tenant.MemoryConfig)
+	require.NoError(t, err)
+	require.True(t, proof.Valid(), "the fixture obtains its policy only from the real authorized full replacement producer")
+	require.Empty(t, tenant.MemoryConfig.ExtractInstructions, "native minimal fixture deliberately contains no custom policy body")
+	repo := repository.NewMemoryRepository(db)
+	admissions := repository.NewMemoryOriginalAdmissionRepository(db, machine.f.store)
+	groups := NewGroupAccessService(repository.NewGroupAccessRepository(db))
+	// Native515 fixture has real SQL groups and no DirectoryRuntime instance.
+	// The production helper rebuilds actual permission/publication readers on tx.
+	ConfigureMemoryOriginalAtomicAuthority(admissions, machine.f.store, groups, nil)
+	reader := NewMemoryOriginalSourceReader(messages, admissions)
+	queue := &memAtomicSQLQueue{}
+	models := memAtomicSQLModels{actualMemoryModels: actualMemoryModels{model: model.actualMemoryModel, db: db, originals: modelProducer.(interfaces.ModelOriginalLifetimeReader)}, actual: model}
+	service := memoryservice.NewOriginalBoundMemoryService(repo, tenantRepo, repository.NewMessageRepository(db), models, queue, nil, reader, admissions)
+	outbox := repository.NewMemoryOriginalOutboxRepository(db, admissions)
+	memoryservice.ConfigureOriginalMemoryOutbox(service, outbox)
+	relay := NewMemoryOriginalOutboxRunner(outbox, queue)
+	scope, err := memoryservice.ResolveScope(ctx)
+	require.NoError(t, err)
+	subject, err := repo.EnsureSubject(ctx, scope)
+	require.NoError(t, err)
+	require.True(t, subject.Enabled)
+	session, user, assistant := createActualMemoryTurn(t, messages, ctx)
+	return &memAtomicSQLFixture{machine, messages, ctx, db, repo, admissions, reader, service, scope, model, queue, outbox, relay, session, user, assistant, actualMemoryFacts(t, db, user.ID)}
+}
+func relayMemAtomicSQLScheduled(t *testing.T, f *memAtomicSQLFixture) {
+	t.Helper()
+	require.Nil(t, f.queue.task, "Schedule must not bypass its durable same-TX dispatch intent")
+	progress := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	require.NotEmpty(t, progress.OriginalAdmissionID)
+	input, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, progress.OriginalAdmissionID)
+	require.NoError(t, err)
+	var dispatch types.MemoryOriginalDispatch
+	require.NoError(t, f.db.Where("admission_id=?", input.ID).Take(&dispatch).Error)
+	require.Equal(t, input.ID, dispatch.AdmissionID)
+	require.Equal(t, types.MemoryOriginalBytesDigest([]byte(dispatch.Payload)), dispatch.PayloadDigest)
+	require.True(t, dispatch.NotBefore.Equal(input.Request.DispatchNotBefore))
+	var payload types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal([]byte(dispatch.Payload), &payload))
+	require.Equal(t, input.ID, payload.OriginalAdmissionID)
+	require.Equal(t, input.Digest, payload.OriginalDigest)
+	require.Equal(t, input.Request.PendingRevision, payload.OriginalRevision)
+	require.Equal(t, input.Request.TenantID, payload.TenantID)
+	require.Equal(t, input.Request.SubjectID, payload.SubjectID)
+	require.Equal(t, input.Request.SessionID, payload.SessionID)
+	require.Equal(t, input.Request.TriggerMessageID, payload.MessageID)
+	require.Equal(t, input.Request.ChatModelID, payload.ChatModelID)
+	// Wait only the actual newly captured minimum legitimate product delay.
+	// Never edit not_before, clock, leases, SQL pending controls or payload.
+	wait := time.Until(dispatch.NotBefore)
+	require.LessOrEqual(t, wait, time.Duration(types.MinMemoryExtractDelaySeconds+2)*time.Second)
+	if wait > 0 {
+		time.Sleep(wait + 10*time.Millisecond)
+	}
+	operation, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	claimed, err := f.relay.RelayOne(operation, input.ID)
+	require.NoError(t, err)
+	require.True(t, claimed)
+	require.NotNil(t, f.queue.task)
+	var delivered types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &delivered))
+	require.Equal(t, payload, delivered)
+	var after types.MemoryOriginalDispatch
+	require.NoError(t, f.db.Where("admission_id=?", input.ID).Take(&after).Error)
+	require.Equal(t, dispatch.Payload, after.Payload)
+	require.Equal(t, dispatch.PayloadDigest, after.PayloadDigest)
+	require.True(t, dispatch.NotBefore.Equal(after.NotBefore))
+	require.EqualValues(t, 1, after.Attempts)
+	require.NotNil(t, after.LastEnqueuedAt)
+	require.Nil(t, after.CompletedAt)
+	require.Empty(t, after.LeaseID)
+	require.Nil(t, after.LeaseUntil)
+}
