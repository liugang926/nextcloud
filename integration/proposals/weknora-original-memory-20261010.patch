+package interfaces
+
+import (
+	"context"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// MemoryOriginalAdmissionReader loads a trusted append-only enqueue record.
+// It must validate its immutable digest, original actor and exact pending
+// session revision/cursor binding. Task fields or current rows cannot stand
+// in for a missing record. This is separate from mutable MemoryRepository.
+type MemoryOriginalAdmissionReader interface {
+	LoadMemoryOriginalAdmission(context.Context, string) (*types.MemoryOriginalInput, error)
+}
+
+// This store binds the original capture and pending revision in one checked
+// transaction. It never creates its schema at runtime or imports legacy work.
+type MemoryOriginalAdmissionRepository interface {
+	MemoryOriginalAdmissionReader
+	PrepareMemoryOriginalCapture(context.Context, MemoryScope, string, string, string, string, string) (*types.MemoryOriginalCaptureRequest, error)
+	AdmitMemoryOriginal(context.Context, *types.MemoryOriginalInput, time.Duration) (*types.MemorySubject, bool, error)
+	ResolveMemoryOriginalTask(context.Context, types.MemoryExtractPayload) (*types.MemoryOriginalInput, error)
+	CheckMemoryDerivedInputsAbsent(context.Context, MemoryScope) error
+	AdmitMemoryOriginalExecution(context.Context, string, string, string, string) (*types.MemoryOriginalExecution, error)
+	CommitMemoryOriginalResult(context.Context, *types.MemoryOriginalCommit) error
+}
+
+// MemoryOriginalSourceReader is implemented outside the memory package to
+// share the real message/source authority without importing that package.
+// Capture is used on the original scheduling context. Begin accepts only an
+// admission ID and reloads its original descriptor through the durable reader.
+type MemoryOriginalSourceReader interface {
+	CaptureAndPersistMemoryOriginal(context.Context, types.MemoryOriginalCaptureRequest, func(context.Context, *types.MemoryOriginalInput) error) (*types.MemoryOriginalInput, error)
+	CaptureMemoryOriginalInput(context.Context, types.MemoryOriginalCaptureRequest) (*types.MemoryOriginalInput, error)
+	BeginMemoryOriginalRead(context.Context, string) (MemoryOriginalRead, error)
+}
+
+type MemoryOriginalRead interface {
+	Context() context.Context
+	Snapshot() (*types.MessageMaterialSnapshot, error)
+	Recheck() error
+	Close()
+}
