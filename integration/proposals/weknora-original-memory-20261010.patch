index 00000000..aff9b3f6
--- /dev/null
+++ b/internal/application/service/memory/generated_consolidation.go
@@ -0,0 +1,167 @@
+package memory
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+func consolidationMessages(cluster []*types.MemoryItem) []chat.Message {
+	var b strings.Builder
+	for _, item := range cluster {
+		fmt.Fprintf(&b, "- (%s) %s\n", item.ValidFrom.Format("2006-01-02"), types.SanitizeMemoryContent(item.Content))
+	}
+	return []chat.Message{{Role: "system", Content: consolidationSystemPrompt}, {Role: "user", Content: b.String()}}
+}
+
+// The original-bound native path owns a leased complete input, the current
+// actual model provider and one complete result transaction. It never calls
+// write/SaveItem with generated text inheriting a manual human origin.
+func (s *Service) reviewOriginalStore(ctx context.Context, scope interfaces.MemoryScope, cfg *types.MemoryConfig, modelID string, force bool) (result *types.MemoryConsolidationResult, retErr error) {
+	// Manual-memory inputs also need explicit content suppression; inherit it
+	// through the actual derived, policy and current model reader contexts.
+	ctx = logprivacy.SuppressContent(ctx)
+	result = &types.MemoryConsolidationResult{}
+	repository, ok := s.admissions.(interfaces.MemoryGeneratedRepository)
+	if !ok {
+		return result, types.ErrMemoryOriginalUnavailable
+	}
+	// Native expiry already has an exact controlled-publication producer. Close
+	// its old snapshot before opening the model's new complete input snapshot.
+	expired, err := s.repo.ExpireOverdue(ctx, scope)
+	if err != nil {
+		return result, err
+	}
+	result.Expired = int(expired)
+	owned, derived, err := s.beginDerivedInputs(ctx, scope)
+	if err != nil {
+		return result, err
+	}
+	defer func() {
+		if err := derived.Close(); err != nil && retErr == nil {
+			retErr = err
+		}
+	}()
+	subject, err := s.repo.GetSubject(owned, scope)
+	if err != nil {
+		return result, err
+	}
+	if subject == nil || !subject.Enabled {
+		return result, ErrMemoryDisabled
+	}
+	last, interval := subject.ConsolidatedAt, consolidateInterval
+	if force {
+		last, interval = subject.ForcedConsolidatedAt, forcedConsolidateInterval
+	}
+	if last != nil && time.Since(*last) < interval {
+		result.Skipped = types.MemoryConsolidationSkipTooSoon
+		return result, nil
+	}
+	owner := owned.Value(memoryDerivedContextKey{}).(*memoryDerivedOwner)
+	items := liveDerivedItems(owner.snapshot)
+	result.Reviewed = len(items)
+	if !force && len(items) < consolidateMinItems {
+		result.Skipped = types.MemoryConsolidationSkipTooFewItems
+	}
+	minOverlap, minCosine, maxClusters := consolidateMinOverlap, consolidateMinCosine, consolidateMaxClusters
+	if force {
+		minOverlap, minCosine, maxClusters = forcedMinOverlap, forcedMinCosine, forcedMaxClusters
+	}
+	// Candidate heuristics only select what to show. The actual model is the
+	// sole merge decision maker and receives only the leased genuine item bytes.
+	clusters := [][]*types.MemoryItem{}
+	if force || len(items) >= consolidateMinItems {
+		clusters = s.mergeCandidates(owned, scope, cfg, items, minOverlap, minCosine)
+	}
+	result.Candidates = len(clusters)
+	if err = checkDerivedInputs(owned); err != nil {
+		return result, err
+	}
+	if len(clusters) == 0 && result.Skipped == "" {
+		result.Skipped = types.MemoryConsolidationSkipNoCandidates
+	}
+	if len(clusters) > maxClusters {
+		clusters = clusters[:maxClusters]
+	}
+	if len(clusters) > 0 && s.modelService == nil {
+		return result, types.ErrMemoryOriginalUnavailable
+	}
+	capture := types.MemoryGeneratedCapture{ModelID: modelID, Force: force, Review: true}
+	for _, cluster := range clusters {
+		ids := []string{}
+		for _, item := range cluster {
+			ids = append(ids, item.ID)
+		}
+		prompt, err := json.Marshal(consolidationMessages(cluster))
+		if err != nil {
+			return result, err
+		}
+		capture.Clusters = append(capture.Clusters, types.MemoryGeneratedCluster{ItemIDs: ids, PromptJSON: string(prompt)})
+	}
+	generated, err := repository.BeginMemoryGenerated(owned, scope, capture)
+	if err != nil {
+		return result, err
+	}
+	defer func() {
+		if err := generated.Close(); err != nil && retErr == nil {
+			retErr = err
+		}
+	}()
+	original := generated.Original()
+	if original == nil {
+		return result, types.ErrMemoryOriginalUnavailable
+	}
+	var command types.MemoryConsolidationCommand
+	if json.Unmarshal([]byte(original.RequestJSON), &command) != nil {
+		return result, types.ErrMemoryOriginalUnavailable
+	}
+	prepared := types.MemoryGeneratedResult{OriginalID: original.ID, OriginalDigest: original.Digest, Decisions: []types.MemoryGeneratedDecision{}}
+	for index, cluster := range clusters {
+		if err = generated.Recheck(); err != nil {
+			return result, err
+		}
+		model, err := s.modelService.GetChatModel(generated.Context(), modelID)
+		if err != nil || model == nil {
+			return result, types.ErrMemoryOriginalUnavailable
+		}
+		thinking := false
+		response, err := model.Chat(generated.Context(), consolidationMessages(cluster), &chat.ChatOptions{Temperature: 0, MaxCompletionTokens: 600, Thinking: &thinking, Format: consolidationSchema})
+		if err != nil {
+			return result, err
+		}
+		if response == nil {
+			return result, types.ErrMemoryOriginalUnavailable
+		}
+		if err = generated.Recheck(); err != nil {
+			return result, err
+		}
+		content := strings.TrimSpace(response.Content)
+		start, end := strings.Index(content, "{"), strings.LastIndex(content, "}")
+		if start < 0 || end <= start {
+			return result, types.ErrMemoryOriginalUnavailable
+		}
+		actual := content[start : end+1]
+		statement, err := types.DecodeMemoryConsolidationDecision(actual)
+		if err != nil {
+			return result, err
+		}
+		prepared.Decisions = append(prepared.Decisions, types.MemoryGeneratedDecision{ClusterIndex: index, Statement: statement, ResponseJSON: actual, RawResponse: response.Content})
+	}
+	merged, err := repository.CommitMemoryGenerated(generated.Context(), prepared)
+	if err != nil {
+		return result, err
+	}
+	result.Merged = merged
+	result.Demoted = len(command.Demotions)
+	if merged == 0 && len(clusters) > 0 {
+		result.Skipped = types.MemoryConsolidationSkipModelDeclined
+	}
+	return result, nil
+}
