+package types
+
+import (
+	"encoding/json"
+	"errors"
+	"time"
+)
+
+// A policy proof names a real full-replacement authoring fact. Equal current
+// bytes, legacy configuration and a request-supplied origin marker are not one.
+type MemoryPolicyProof struct {
+	OriginID          string
+	Revision          uint64
+	PolicyDigest      string
+	OriginDigest      string
+	BodyReceiptDigest string
+}
+
+func (p MemoryPolicyProof) Valid() bool {
+	return p.OriginID != "" && p.Revision > 0 && len(p.PolicyDigest) == 64 && len(p.OriginDigest) == 64 && len(p.BodyReceiptDigest) == 64
+}
+
+type MemoryPolicyOriginal struct {
+	ID                   string `gorm:"primaryKey"`
+	TenantID             uint64
+	Revision             uint64
+	PolicyJSON           string
+	PolicyDigest         string
+	PreviousOriginID     string
+	PreviousOriginDigest string
+	AuthorSelector       string
+	Digest               string
+	CreatedAt            time.Time
+	BodyReceiptDigest    string `gorm:"-" json:"-"`
+}
+
+func (MemoryPolicyOriginal) TableName() string { return "memory_policy_originals" }
+
+func (o MemoryPolicyOriginal) Proof() MemoryPolicyProof {
+	return MemoryPolicyProof{o.ID, o.Revision, o.PolicyDigest, o.Digest, o.BodyReceiptDigest}
+}
+
+// Separately appended after body152 capture, in the same authoring transaction.
+// An immutable origin must not inherit a replacement current mirror by hash.
+type MemoryPolicyBodyReceipt struct {
+	OriginID             string `gorm:"primaryKey"`
+	OriginDigest         string
+	TenantID             uint64
+	SlotID               string
+	BodyID               string
+	HeadRevision         int64
+	SourceIdentitySHA256 string
+	PolicyDigest         string
+	Digest               string
+	CreatedAt            time.Time
+}
+
+func (MemoryPolicyBodyReceipt) TableName() string { return "memory_policy_body_receipts" }
+
+// Canonicalization is part of the authorized full-replacement input boundary.
+// Readers also canonicalize the persisted policy before comparing the fact.
+func MemoryPolicyBytes(cfg *MemoryConfig) ([]byte, error) {
+	if cfg == nil {
+		return nil, ErrMemoryOriginalUnavailable
+	}
+	copy := *cfg
+	copy.Normalize()
+	return json.Marshal(&copy)
+}
+
+func ValidateMemoryPolicyReplacement(cfg MemoryConfig) error {
+	if cfg.WriteMode != "" && cfg.WriteMode != MemoryWriteAuto && cfg.WriteMode != MemoryWriteExplicitOnly ||
+		cfg.MaxItems < 0 || cfg.MaxItems > 2000 ||
+		cfg.ExtractDelaySeconds < 0 || cfg.ExtractDelaySeconds > MaxMemoryExtractDelaySeconds ||
+		cfg.ExtractMinIntervalSeconds < 0 || cfg.ExtractMinIntervalSeconds > MaxMemoryExtractMinIntervalSeconds ||
+		len(cfg.ExtractModelID) > 64 || len(cfg.EmbeddingModelID) > 64 ||
+		cfg.InterestThreshold < 0 || cfg.InterestThreshold > MaxMemoryInterestThreshold ||
+		len([]rune(cfg.ExtractInstructions)) > MaxMemoryExtractInstructionsRunes {
+		return errors.New("invalid memory policy replacement")
+	}
+	return nil
+}
