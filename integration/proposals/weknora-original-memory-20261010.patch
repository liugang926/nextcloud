diff --git a/internal/application/repository/memory_generated_body.go b/internal/application/repository/memory_generated_body.go
new file mode 100644
index 00000000..19dc74f1
--- /dev/null
+++ b/internal/application/repository/memory_generated_body.go
@@ -0,0 +1,88 @@
+package repository
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryGeneratedProducerKey struct{}
+type memoryGeneratedProducerBoundary struct {
+	Table, ID  string
+	Tenant     uint64
+	BodySHA256 string
+}
+
+func memoryGeneratedOriginalDigest(fact *types.MemoryGeneratedOriginal) (string, error) {
+	copy := *fact
+	copy.Digest = ""
+	copy.InputJSON = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryGeneratedReceiptDigest(fact *types.MemoryGeneratedReceipt) (string, error) {
+	copy := *fact
+	copy.Digest = ""
+	copy.ResponseJSON = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryGeneratedBodyReceiptDigest(fact *types.MemoryGeneratedBodyReceipt) (string, error) {
+	copy := *fact
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryGeneratedBodyHeadInTx(tx *gorm.DB, table, id string, tenant uint64, sha string) (originalBodyFieldHead, error) {
+	if !originalBodySchemaPresent(tx) {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	var heads []originalBodyFieldHead
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("source_table=? AND row_key=?", table, id).Find(&heads).Error; err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	if len(heads) != 1 {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	head := heads[0]
+	column := "input_json"
+	if table == "memory_generated_receipts" {
+		column = "response_json"
+	}
+	ref, ok := bodyReference(head.OriginalBodyRef)
+	if !ok || head.SourceTable != table || head.ColumnName != column || head.TenantID != tenant || head.KnowledgeBaseID != "" || head.KnowledgeID != "" || head.OwnerKind != table || head.OwnerID != id || ref.SHA256 != sha || ref.BodyID != head.BodyID || ref.SlotID != head.SlotID {
+		return head, ErrOriginalBodyUnavailable
+	}
+	if err := checkOriginalBodyAvailableForHeads(tx.Statement.Context, tx, table, id, heads); err != nil {
+		return head, err
+	}
+	return head, nil
+}
+func createMemoryGeneratedBodyReceiptInTx(tx *gorm.DB, table, id string, tenant uint64, sha, digest string) error {
+	head, err := memoryGeneratedBodyHeadInTx(tx, table, id, tenant, sha)
+	if err != nil {
+		return err
+	}
+	fact := &types.MemoryGeneratedBodyReceipt{OriginKind: table, OriginID: id, OriginDigest: digest, BodySHA256: sha, SlotID: head.SlotID, BodyID: head.BodyID, HeadRevision: head.Revision, SourceIdentitySHA256: head.SourceIdentitySHA256, CreatedAt: memoryFactTime()}
+	fact.Digest, err = memoryGeneratedBodyReceiptDigest(fact)
+	if err != nil {
+		return err
+	}
+	return tx.Session(&gorm.Session{NewDB: true}).Create(fact).Error
+}
+func checkMemoryGeneratedBodyReceiptInTx(tx *gorm.DB, table, id string, tenant uint64, sha, digest string) (originalBodyFieldHead, error) {
+	head, err := memoryGeneratedBodyHeadInTx(tx, table, id, tenant, sha)
+	if err != nil {
+		return head, err
+	}
+	var receipt types.MemoryGeneratedBodyReceipt
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("origin_kind=? AND origin_id=?", table, id).Take(&receipt).Error; err != nil {
+		return head, err
+	}
+	actual, err := memoryGeneratedBodyReceiptDigest(&receipt)
+	if err != nil || actual != receipt.Digest || receipt.OriginDigest != digest || receipt.BodySHA256 != sha || receipt.BodyID != head.BodyID || receipt.SlotID != head.SlotID || receipt.HeadRevision != head.Revision || receipt.SourceIdentitySHA256 != head.SourceIdentitySHA256 {
+		return head, ErrOriginalBodyUnavailable
+	}
+	return head, nil
+}
+func memoryGeneratedProducerContext(ctx context.Context, table, id string, tenant uint64, sha string) context.Context {
+	return context.WithValue(ctx, memoryGeneratedProducerKey{}, memoryGeneratedProducerBoundary{table, id, tenant, sha})
+}
diff --git a/internal/application/repository/memory_generated_clock.go b/internal/application/repository/memory_generated_clock.go
new file mode 100644
index 00000000..e6c91a59
--- /dev/null
+++ b/internal/application/repository/memory_generated_clock.go
@@ -0,0 +1,200 @@
+package repository
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"sort"
+)
+
+// The concrete model callback only exposes captured private-hold identities.
+func ConfigureMemoryGeneratedLeaseIds(admissions interfaces.MemoryOriginalAdmissionRepository, ids func(context.Context) ([]string, error)) {
+	if actual, ok := admissions.(*memoryOriginalAdmissionRepository); ok {
+		actual.generatedLeaseIds = ids
+	}
+}
+func (r *memoryOriginalAdmissionRepository) memoryGeneratedModelLeaseIDs(hold *memoryGeneratedHold, derived *memoryDerivedHold) ([]string, error) {
+	if hold == nil || derived == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	ids := map[string]bool{}
+	contexts := []context.Context{}
+	if !hold.Maintenance {
+		if hold.ModelContext == nil {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		contexts = append(contexts, hold.ModelContext)
+	} else if hold.ModelContext != nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	for _, ctx := range derived.ModelContexts {
+		contexts = append(contexts, ctx)
+	}
+	for _, ctx := range derived.GeneratedModelContexts {
+		contexts = append(contexts, ctx)
+	}
+	if len(contexts) > 0 && r.generatedLeaseIds == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	for _, ctx := range contexts {
+		captured, err := r.generatedLeaseIds(ctx)
+		if err != nil {
+			return nil, err
+		}
+		if len(captured) == 0 {
+			return nil, ErrOriginalBodyUnavailable
+		}
+		for _, id := range captured {
+			if id == "" {
+				return nil, ErrOriginalBodyUnavailable
+			}
+			ids[id] = true
+		}
+	}
+	keys := []string{}
+	for id := range ids {
+		keys = append(keys, id)
+	}
+	sort.Strings(keys)
+	return keys, nil
+}
+
+// Invoke only after the current and every historical concrete model Check
+// has verified its real private hold on this same tx. Locked actual row copies
+// record those proven bindings; a row lookup never creates model authority.
+func (r *memoryOriginalAdmissionRepository) captureMemoryGeneratedModelBindingsInTx(tx *gorm.DB, hold *memoryGeneratedHold, derived *memoryDerivedHold) error {
+	keys, err := r.memoryGeneratedModelLeaseIDs(hold, derived)
+	if err != nil {
+		return err
+	}
+	if len(keys) == 0 {
+		hold.ModelBindings = map[string]originalBodyLease{}
+		return tx.Statement.Context.Err()
+	}
+	var rows []originalBodyLease
+	if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id IN ?", keys).Order("lease_id").Find(&rows).Error; err != nil {
+		return err
+	}
+	if len(rows) != len(keys) {
+		return ErrOriginalBodyUnavailable
+	}
+	hold.ModelBindings = map[string]originalBodyLease{}
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	for _, row := range rows {
+		if row.Kind != "read" || row.ReleasedAtMS != nil || row.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+		hold.ModelBindings[row.LeaseID] = row
+	}
+	return tx.Statement.Context.Err()
+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryGeneratedFinalClockInTx(tx *gorm.DB, hold *memoryGeneratedHold, derived *memoryDerivedHold) error {
+	if hold == nil || derived == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	expected := map[string]originalBodyLease{}
+	add := func(lease originalBodyLease) error {
+		if lease.LeaseID == "" || lease.BodyID == "" || lease.OwnerID == "" || lease.Kind != "read" || lease.ReleasedAtMS != nil {
+			return ErrOriginalBodyUnavailable
+		}
+		if old, ok := expected[lease.LeaseID]; ok && (old.BodyID != lease.BodyID || old.OwnerID != lease.OwnerID || old.Epoch != lease.Epoch) {
+			return ErrOriginalBodyUnavailable
+		}
+		expected[lease.LeaseID] = lease
+		return nil
+	}
+	if err := add(hold.Lease); err != nil {
+		return err
+	}
+	for _, lease := range derived.Leases {
+		if err := add(lease); err != nil {
+			return err
+		}
+	}
+	for _, policy := range derived.Policies {
+		for _, lease := range policy.Leases {
+			if err := add(lease); err != nil {
+				return err
+			}
+		}
+	}
+	for _, lease := range hold.Policy.Leases {
+		if err := add(lease); err != nil {
+			return err
+		}
+	}
+	modelIDs, err := r.memoryGeneratedModelLeaseIDs(hold, derived)
+	if err != nil {
+		return err
+	}
+	if len(modelIDs) != len(hold.ModelBindings) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, id := range modelIDs {
+		binding, ok := hold.ModelBindings[id]
+		if !ok {
+			return ErrOriginalBodyUnavailable
+		}
+		if err = add(binding); err != nil {
+			return err
+		}
+	}
+	keys := []string{}
+	for id := range expected {
+		keys = append(keys, id)
+	}
+	sort.Strings(keys)
+	var leases []originalBodyLease
+	if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id IN ?", keys).Order("lease_id").Find(&leases).Error; err != nil {
+		return err
+	}
+	if len(leases) != len(keys) {
+		return ErrOriginalBodyUnavailable
+	}
+	bodyIDs := map[string]bool{}
+	for _, lease := range leases {
+		captured, ok := expected[lease.LeaseID]
+		if !ok || lease.BodyID != captured.BodyID || lease.OwnerID != captured.OwnerID || lease.Epoch != captured.Epoch || lease.Kind != "read" || lease.ReleasedAtMS != nil {
+			return ErrOriginalBodyUnavailable
+		}
+		bodyIDs[lease.BodyID] = true
+	}
+	bodies := []string{}
+	for id := range bodyIDs {
+		bodies = append(bodies, id)
+	}
+	sort.Strings(bodies)
+	var payloads []originalBodyPayload
+	if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("id IN ?", bodies).Order("id").Find(&payloads).Error; err != nil {
+		return err
+	}
+	if len(payloads) != len(bodies) {
+		return ErrOriginalBodyUnavailable
+	}
+	actual := map[string]originalBodyPayload{}
+	for _, body := range payloads {
+		actual[body.ID] = body
+	}
+	for _, lease := range leases {
+		body, ok := actual[lease.BodyID]
+		if !ok || body.State != "live" || body.PurgeEpoch != lease.Epoch {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	// This SQL clock is last: no model/policy/body IO follows it before commit.
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	for _, lease := range leases {
+		if lease.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
diff --git a/internal/application/repository/memory_generated_graph.go b/internal/application/repository/memory_generated_graph.go
