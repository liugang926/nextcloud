+type memoryOriginalEffectDependency struct {
+	InputID           string
+	InputDigest       string
+	ExecutionID       string
+	ExecutionDigest   string
+	ModelResultDigest string
+	Recipe            string
+	Parent            string
+	EffectRole        string
+	Capacity          *memoryOriginalCapacityDependency `json:",omitempty"`
+}
+
+type memoryOriginalCapacityDependency struct {
+	Keep            int
+	CurrentCommitID string
+	RankedControls  []memoryCapacityRankControl
+	RankingDigest   string
+	BeforeDigest    string
+	AfterDigest     string
+}
