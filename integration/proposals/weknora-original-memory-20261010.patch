+WHEN OLD.admission_id IS NOT NEW.admission_id OR OLD.payload IS NOT NEW.payload OR OLD.payload_digest IS NOT NEW.payload_digest OR
+ OLD.not_before IS NOT NEW.not_before OR OLD.created_at IS NOT NEW.created_at OR (OLD.completed_at IS NOT NULL AND OLD.completed_at IS NOT NEW.completed_at)
+BEGIN SELECT RAISE(ABORT,'original memory dispatch payload is immutable'); END;
