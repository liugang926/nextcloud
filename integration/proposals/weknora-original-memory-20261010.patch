+package repository
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// All item/rank writers serialize with CommitMemoryOriginalResult on the
+// same real subject row. The existing producer owns the public mutation;
+// this creates no material admission, derivation or authorization proof.
+func (r *memoryRepository) withItemScopeWrite(ctx context.Context, scope interfaces.MemoryScope, write func(*gorm.DB) error) (retErr error) {
+	if !scope.Valid() || write == nil {
+		return types.ErrMemoryConflict
+	}
+	owned, read, err := r.prepareMemoryNativeWrite(ctx, scope)
+	if err != nil {
+		return err
+	}
+	if read != nil {
+		defer func() {
+			if err := read.Close(); err != nil && retErr == nil {
+				retErr = err
+			}
+		}()
+	}
+	ctx = owned
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if read != nil {
+			tx = tx.Session(&gorm.Session{NewDB: true}).WithContext(context.WithValue(ctx, memoryDerivedOwnPublicationsKey{}, map[string]bool{}))
+		}
+		if tx.Dialector.Name() == "sqlite" {
+			if err := tx.Exec("UPDATE memory_subjects SET updated_at=updated_at WHERE tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Error; err != nil {
+				return err
+			}
+		}
+		// Preserve public repository mutations on a new legitimate scope by
+		// using the existing native subject initializer, on this connection.
+		local := &memoryRepository{db: tx.Session(&gorm.Session{NewDB: true})}
+		if _, err := local.EnsureSubject(ctx, scope); err != nil {
+			return err
+		}
+		var subject types.MemorySubject
+		if err := tx.Clauses(forUpdateClause()).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Take(&subject).Error; err != nil {
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if hold, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold); read != nil && hold != nil {
+			if err := r.derived.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+				return err
+			}
+		}
+		if err := write(tx.Session(&gorm.Session{NewDB: true})); err != nil {
+			return err
+		}
+		if read != nil {
+			if err := r.publishMemoryNativeWriteInTx(tx, scope); err != nil {
+				return err
+			}
+			hold, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+			if err := r.derived.checkMemoryDerivedHoldInTx(tx, hold, "native"); err != nil {
+				return err
+			}
+		}
+		return ctx.Err()
+	})
+}
