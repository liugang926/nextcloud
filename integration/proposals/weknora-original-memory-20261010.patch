@@ -0,0 +1,44 @@
+package repository
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+func (s *KnowledgeInputProvenanceStore) CaptureMemoryOriginalActor(ctx context.Context) (*types.MemoryOriginalActor, error) {
+	fresh, err := s.RefreshCurrentReadActor(ctx)
+	if err != nil {
+		return nil, err
+	}
+	actor, err := captureKnowledgeActorSelector(fresh, "")
+	if err != nil {
+		return nil, err
+	}
+	return &types.MemoryOriginalActor{
+		CallerTenantID: actor.CallerTenantID,
+		UserID:         actor.UserID,
+		Principal:      types.Principal{Type: actor.PrincipalType, ID: actor.PrincipalID},
+		APIKeyID:       actor.APIKeyID,
+	}, nil
+}
+
+func (s *KnowledgeInputProvenanceStore) RestoreMemoryOriginalActor(ctx context.Context, actor types.MemoryOriginalActor, tenant uint64, subject string) (context.Context, error) {
+	if tenant == 0 || tenant != actor.CallerTenantID || subject == "" || actor.Principal != actor.Principal.Normalize() || actor.Principal.StorageID() != subject {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	selector := knowledgeBuildActorSelector{
+		CallerTenantID: actor.CallerTenantID,
+		UserID:         actor.UserID,
+		PrincipalType:  actor.Principal.Type,
+		PrincipalID:    actor.Principal.ID,
+		APIKeyID:       actor.APIKeyID,
+	}
+	fresh, err := s.restoreCurrentKnowledgeActor(ctx, selector, tenant)
+	if err != nil {
+		return ctx, err
+	}
+	// Apply the same current read capability policy as ordinary source reads.
+	// No original caller role or queued grant is restored as current authority.
+	return s.RefreshCurrentReadActor(fresh)
+}
