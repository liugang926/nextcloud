+func runModelOriginalProducerSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"genuine_create_and_instance", "known_partial_definition", "unknown_partial_refuses", "explicit_full_unknown_reauthor", "credential_epoch_definition_stable", "credential_clear_idempotent", "downloader_state_definition_stable", "raw_definition_ABA_unknown", "raw_credentials_ABA_unknown", "raw_status_ABA_unknown", "retained_control_and_facts", "cross_tenant_author_refuses", "builtin_cached_flag_refuses", "builtin_real_system_admin"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			repo, svc, writer, reader := actualOriginalModelServices(t, f)
+			id := f.model.GetModelID()
+			model, before := actualModelProof(t, reader, f.ctx, id)
+			switch mode {
+			case "genuine_create_and_instance":
+				created := actualModelLiteral("genuine-new-model", 7)
+				require.NoError(t, svc.CreateModel(f.ctx, created))
+				require.NotNil(t, created.OriginalProof)
+				require.True(t, created.OriginalProof.Valid())
+				read, err := reader.BeginModelOriginalRead(f.ctx, created.ID, created.OriginalProof)
+				require.NoError(t, err)
+				defer func() { require.NoError(t, read.Close()) }()
+				client, err := svc.GetChatModel(read.Context(), created.ID)
+				require.NoError(t, err)
+				require.Equal(t, created.ID, client.GetModelID())
+				require.Equal(t, created.Name, client.GetModelName())
+				ordinary, err := svc.GetChatModel(f.ctx, created.ID)
+				require.NoError(t, err, "ordinary construction acquires a genuine lifetime reader rather than a current-row fallback")
+				lifetime, ok := ordinary.(originalModelClientLifetime)
+				require.True(t, ok)
+				require.NoError(t, lifetime.CloseOriginal())
+				_, proof, err := read.Snapshot()
+				require.NoError(t, err)
+				require.Equal(t, *created.OriginalProof, *proof)
+			case "known_partial_definition":
+				model.Description = "new complete description field"
+				require.NoError(t, svc.UpdateModel(f.ctx, model))
+				_, after := actualModelProof(t, reader, f.ctx, id)
+				require.Greater(t, after.DefinitionRevision, before.DefinitionRevision)
+				require.NotEqual(t, before.DefinitionID, after.DefinitionID)
+				var fact types.ModelDefinitionOriginal
+				require.NoError(t, f.db.Where("id=?", after.DefinitionID).Take(&fact).Error)
+				require.Equal(t, before.DefinitionID, fact.PreviousID)
+				require.Equal(t, before.DefinitionDigest, fact.PreviousDigest)
+			case "unknown_partial_refuses", "explicit_full_unknown_reauthor":
+				legacy := actualModelLiteral("unknown-legacy-model", 7)
+				legacy.Status = types.ModelStatusActive
+				require.NoError(t, repo.Create(f.ctx, legacy))
+				legacy.Description = "partial edit of unknown model"
+				if mode == "unknown_partial_refuses" {
+					require.ErrorIs(t, svc.UpdateModel(f.ctx, legacy), repository.ErrModelOriginalUnknown)
+					require.Zero(t, actualModelOriginCount(t, f, "model_definition_originals", legacy.ID))
+					return
+				}
+				// A new literal full input, not a GetByID snapshot relabeled by a worker.
+				fresh := actualModelLiteral(legacy.ID, 7)
+				fresh.Name = "new explicit full author input"
+				fresh.Status = types.ModelStatusActive
+				require.NoError(t, writer.ReplaceModelOriginal(f.ctx, fresh))
+				_, known := actualModelProof(t, reader, f.ctx, fresh.ID)
+				var fact types.ModelDefinitionOriginal
+				require.NoError(t, f.db.Where("id=?", known.DefinitionID).Take(&fact).Error)
+				require.Empty(t, fact.PreviousID)
+			case "credential_epoch_definition_stable", "credential_clear_idempotent":
+				key := "fixture-synthetic-credential-A"
+				updated, err := svc.UpdateModelCredentials(f.ctx, id, &key, nil)
+				require.NoError(t, err)
+				require.Equal(t, key, updated.Parameters.APIKey)
+				_, after := actualModelProof(t, reader, f.ctx, id)
+				require.Equal(t, before.DefinitionID, after.DefinitionID)
+				require.Equal(t, before.DefinitionRevision, after.DefinitionRevision)
+				require.Greater(t, after.CredentialRevision, before.CredentialRevision)
+				var credential types.ModelCredentialOriginal
+				require.NoError(t, f.db.Where("id=?", after.CredentialID).Take(&credential).Error)
+				require.Equal(t, before.CredentialID, credential.PreviousID)
+				require.True(t, credential.CreatedAt.Equal(credential.CreatedAt.UTC().Truncate(time.Microsecond)))
+				if mode == "credential_clear_idempotent" {
+					require.NoError(t, svc.ClearModelCredential(f.ctx, id, "api_key"))
+					empty, cleared := actualModelProof(t, reader, f.ctx, id)
+					require.Empty(t, empty.Parameters.APIKey)
+					require.NoError(t, svc.ClearModelCredential(f.ctx, id, "api_key"))
+					_, noOp := actualModelProof(t, reader, f.ctx, id)
+					require.Equal(t, cleared, noOp)
+				}
+			case "downloader_state_definition_stable":
+				local := actualModelLiteral("owned-download-definition", 7)
+				local.Source = types.ModelSourceLocal
+				local.Status = types.ModelStatusDownloading
+				require.NoError(t, writer.CreateModelOriginal(f.ctx, local))
+				require.NotNil(t, local.OriginalProof)
+				_, err := reader.BeginModelOriginalRead(f.ctx, local.ID, local.OriginalProof)
+				require.Error(t, err, "a genuine definition is not an active runtime")
+				require.NoError(t, writer.SetModelOriginalStatus(f.ctx, local.ID, *local.OriginalProof, types.ModelStatusActive))
+				_, active := actualModelProof(t, reader, f.ctx, local.ID)
+				require.Equal(t, local.OriginalProof.DefinitionID, active.DefinitionID)
+				require.Equal(t, local.OriginalProof.CredentialID, active.CredentialID)
+				require.Greater(t, active.StateEpoch, local.OriginalProof.StateEpoch)
+			case "raw_definition_ABA_unknown":
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", id).Update("name", model.Name+" raw drift").Error)
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", id).Update("name", model.Name).Error)
+				_, err := reader.BeginModelOriginalRead(f.ctx, id, &before)
+				require.Error(t, err)
+				require.EqualValues(t, 1, actualModelOriginCount(t, f, "model_definition_originals", id))
+			case "raw_credentials_ABA_unknown":
+				original := model.Parameters
+				changed := original
+				changed.APIKey = "fixture-synthetic-unadmitted-credential"
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", id).Update("parameters", changed).Error)
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", id).Update("parameters", original).Error)
+				_, err := reader.BeginModelOriginalRead(f.ctx, id, &before)
+				require.Error(t, err)
+				require.EqualValues(t, 1, actualModelOriginCount(t, f, "model_credential_originals", id))
+			case "raw_status_ABA_unknown":
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", id).Update("status", types.ModelStatusDownloadFailed).Error)
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", id).Update("status", types.ModelStatusActive).Error)
+				_, err := reader.BeginModelOriginalRead(f.ctx, id, &before)
+				require.Error(t, err)
+				require.EqualValues(t, 1, actualModelOriginCount(t, f, "model_state_originals", id))
+			case "retained_control_and_facts":
+				require.Error(t, f.db.Exec("DELETE FROM model_original_control_versions WHERE model_id=?", id).Error)
+				require.Error(t, f.db.Exec("UPDATE model_original_control_versions SET definition_revision=definition_revision-1 WHERE model_id=?", id).Error)
+				for _, table := range []string{"model_definition_originals", "model_credential_originals", "model_state_originals"} {
+					require.Error(t, f.db.Table(table).Where("model_id=?", id).Update("digest", "unadmitted").Error)
+					require.Error(t, f.db.Exec("DELETE FROM "+table+" WHERE model_id=?", id).Error)
+				}
+				_, known := actualModelProof(t, reader, f.ctx, id)
+				require.Equal(t, before, known)
+			case "cross_tenant_author_refuses", "builtin_cached_flag_refuses", "builtin_real_system_admin":
+				require.NoError(t, repository.NewTenantRepository(f.db).CreateTenant(f.ctx, &types.Tenant{ID: 19, Name: "owned builtin tenant fixture", Status: "active"}))
+				other := actualModelLiteral("scoped-or-builtin-model", 19)
+				ctx := context.WithValue(f.ctx, types.SystemAdminContextKey, true)
+				if mode != "cross_tenant_author_refuses" {
+					other.IsBuiltin = true
+				}
+				if mode == "builtin_real_system_admin" {
+					require.NoError(t, f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_system_admin", true).Error)
+					require.NoError(t, svc.CreateModel(ctx, other))
+					_, known := actualModelProof(t, reader, f.ctx, other.ID)
+					require.True(t, known.IsBuiltin)
+					require.EqualValues(t, 19, known.OwnerTenantID)
+					require.NoError(t, f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_system_admin", false).Error)
+					other.Description = "attempt stale system-admin edit"
+					require.Error(t, svc.UpdateModel(ctx, other))
+				} else {
+					require.Error(t, svc.CreateModel(ctx, other))
+					require.Zero(t, actualModelOriginCount(t, f, "model_definition_originals", other.ID))
+				}
+			}
+		})
+	}
+}
