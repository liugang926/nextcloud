+package service
+
+import (
+	"errors"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"testing"
+)
+
+func runModelHistoricalOriginalSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"exact_history", "genuine_successor_history", "raw_gap_history_closed", "raw_gap_full_reauthor_closed", "original_body_unavailable_closed", "explicit_delete_closed", "current_actor_withdrawn_closed", "opaque_no_ModelParameters_hydrator"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			repo, svc, writer, currentReader := actualOriginalModelServices(t, f)
+			model, original := actualModelProof(t, currentReader, f.ctx, f.model.GetModelID())
+			history, ok := repo.(interfaces.HistoricalModelOriginalReader)
+			require.True(t, ok)
+			switch mode {
+			case "genuine_successor_history":
+				model.Description = "genuinely authored successor definition"
+				require.NoError(t, svc.UpdateModel(f.ctx, model))
+				_, now := actualModelProof(t, currentReader, f.ctx, model.ID)
+				require.NotEqual(t, original, now)
+			case "raw_gap_history_closed", "raw_gap_full_reauthor_closed":
+				require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", model.ID).Update("name", model.Name+" unknown").Error)
+				if mode == "raw_gap_full_reauthor_closed" {
+					fresh := actualModelLiteral(model.ID, 7)
+					fresh.Status = types.ModelStatusActive
+					require.NoError(t, writer.ReplaceModelOriginal(f.ctx, fresh))
+					_, known := actualModelProof(t, currentReader, f.ctx, model.ID)
+					require.NotEqual(t, original.DefinitionID, known.DefinitionID)
+				}
+			case "original_body_unavailable_closed":
+				require.NoError(t, f.db.Exec("DELETE FROM original_body_field_heads WHERE source_table='model_definition_originals' AND row_key=?", original.DefinitionID).Error)
+			case "explicit_delete_closed":
+				require.NoError(t, writer.DeleteModelOriginal(f.ctx, 7, model.ID))
+			case "current_actor_withdrawn_closed":
+				require.NoError(t, f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false).Error)
+			case "opaque_no_ModelParameters_hydrator":
+				name := "historical-no-Model-Parameters-Scan"
+				require.NoError(t, f.db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
+					if tx.Statement.Table == "models" {
+						if _, typed := tx.Statement.Dest.(*types.Model); typed {
+							tx.AddError(errors.New("historical reader attempted runtime ModelParameters hydrator"))
+						}
+					}
+				}))
+				t.Cleanup(func() { f.db.Callback().Query().Remove(name) })
+			}
+			read, err := history.BeginHistoricalModelOriginalRead(f.ctx, original)
+			legal := mode == "exact_history" || mode == "genuine_successor_history" || mode == "opaque_no_ModelParameters_hydrator"
+			if !legal {
+				require.Error(t, err)
+				require.Nil(t, read)
+				return
+			}
+			require.NoError(t, err)
+			defer func() { require.NoError(t, read.Close()) }()
+			require.NoError(t, read.Recheck())
+			require.NoError(t, f.db.WithContext(read.Context()).Transaction(func(tx *gorm.DB) error {
+				return repository.CheckHistoricalModelOriginalHolds(read.Context(), tx, original)
+			}))
+			_, _, err = repository.OriginalModelSnapshotFromContext(read.Context(), model.ID)
+			require.Error(t, err, "historical provenance context grants no old provider construction/secret snapshot")
+			require.Zero(t, f.model.calls)
+		})
+	}
+}
+func TestModelHistoricalOriginalActualSQLite(t *testing.T)   { runModelHistoricalOriginalSQL(t, false) }
+func TestPostgresModelHistoricalOriginalActual(t *testing.T) { runModelHistoricalOriginalSQL(t, true) }
