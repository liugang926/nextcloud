+	}
+	select {
+	case seen := <-writerSaw:
+		require.NoError(t, seen.Err)
+		assert.EqualValues(t, 1, seen.Receipt)
+		assert.EqualValues(t, 3, seen.Origins)
+		assert.EqualValues(t, 1, seen.Active)
+		assert.EqualValues(t, 1, seen.Archived)
+		// These were read inside the writer's actual subject-fenced TX before
+		// its own insertion, proving commit visibility rather than Go timing.
