--- /dev/null
+++ b/internal/application/service/memory_worker_final_clock_sql_actual_test.go
@@ -0,0 +1,158 @@
+package service
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	memoryservice "github.com/Tencent/WeKnora/internal/application/service/memory"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+type memFinalClockSQLChat struct {
+	base   *memAtomicSQLModel
+	target string
+}
+
+func (m *memFinalClockSQLChat) GetModelName() string { return m.base.GetModelName() }
+func (m *memFinalClockSQLChat) GetModelID() string   { return m.base.GetModelID() }
+func (m *memFinalClockSQLChat) ChatStream(ctx context.Context, input []chat.Message, opts *chat.ChatOptions) (<-chan types.StreamResponse, error) {
+	return m.base.ChatStream(ctx, input, opts)
+}
+func (m *memFinalClockSQLChat) Chat(ctx context.Context, input []chat.Message, opts *chat.ChatOptions) (*types.ChatResponse, error) {
+	ids, err := repository.ModelOriginalLeaseIDs(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if len(ids) != 2 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	m.target = ids[0]
+	return m.base.Chat(ctx, input, opts)
+}
+
+type memFinalClockSQLModels struct {
+	actualMemoryModels
+	transport *memFinalClockSQLChat
+}
+
+func (m memFinalClockSQLModels) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	if _, err := m.actualMemoryModels.GetChatModel(ctx, id); err != nil {
+		return nil, err
+	}
+	return m.transport, nil
+}
+
+// Real SQL final-phase fault: every earlier entity/body/model check succeeded.
+// Immediately before the exact final union query, shorten its actual acquired
+// model lease. After that real query, wait for the same driver's actual clock
+// to cross that expiry; the final clock must roll back effects+cursor together.
+// The unchanged legal control commits through the same real producer path.
+func runMemoryWorkerFinalClockSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"current", "late_current_model_expiry"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			transport := &memFinalClockSQLChat{base: f.model}
+			models := memFinalClockSQLModels{actualMemoryModels: actualMemoryModels{model: f.model.actualMemoryModel, db: f.db, originals: f.admissions.(interfaces.ModelOriginalLifetimeReader)}, transport: transport}
+			worker := memoryservice.NewOriginalBoundMemoryService(f.repo, repository.NewTenantRepository(f.db), repository.NewMessageRepository(f.db), models, f.queue, nil, f.reader, f.admissions)
+			memoryservice.ConfigureOriginalMemoryOutbox(worker, f.outbox)
+			worker.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			relayMemAtomicSQLScheduled(t, f)
+			var expiry int64
+			beforeObserved, afterObserved := false, false
+			clock := func(tx *gorm.DB) (int64, error) {
+				clean := tx.Session(&gorm.Session{NewDB: true}).Set("memory:final_lease_clock_union", false)
+				var now int64
+				query := "SELECT CAST((julianday('now')-2440587.5)*86400000 AS INTEGER)"
+				if pg {
+					query = "SELECT CAST(EXTRACT(EPOCH FROM clock_timestamp())*1000 AS BIGINT)"
+				}
+				err := clean.Raw(query).Scan(&now).Error
+				return now, err
+			}
+			isFinal := func(tx *gorm.DB) bool {
+				value, ok := tx.Statement.Settings.Load("memory:final_lease_clock_union")
+				return ok && value == true && tx.Statement.Table == "original_body_leases"
+			}
+			name := "actual-worker-final-lease-clock"
+			require.NoError(t, f.db.Callback().Query().Before("gorm:query").Register(name+"-before", func(tx *gorm.DB) {
+				if !isFinal(tx) || beforeObserved {
+					return
+				}
+				beforeObserved = true
+				if mode == "current" {
+					return
+				}
+				if transport.target == "" {
+					tx.AddError(types.ErrMemoryOriginalUnavailable)
+					return
+				}
+				now, err := clock(tx)
+				if err != nil {
+					tx.AddError(err)
+					return
+				}
+				expiry = now + 25
+				clean := tx.Session(&gorm.Session{NewDB: true}).Set("memory:final_lease_clock_union", false)
+				result := clean.Table("original_body_leases").Where("lease_id=? AND kind='read' AND released_at_ms IS NULL", transport.target).Update("expires_at_ms", expiry)
+				if result.Error != nil {
+					tx.AddError(result.Error)
+				} else if result.RowsAffected != 1 {
+					tx.AddError(types.ErrMemoryOriginalUnavailable)
+				}
+			}))
+			require.NoError(t, f.db.Callback().Query().After("gorm:query").Register(name+"-after", func(tx *gorm.DB) {
+				if !isFinal(tx) || afterObserved || tx.Error != nil {
+					return
+				}
+				afterObserved = true
+				if mode == "current" {
+					return
+				}
+				for {
+					if err := tx.Statement.Context.Err(); err != nil {
+						tx.AddError(err)
+						return
+					}
+					now, err := clock(tx)
+					if err != nil {
+						tx.AddError(err)
+						return
+					}
+					if now >= expiry {
+						return
+					}
+				}
+			}))
+			defer f.db.Callback().Query().Remove(name + "-before")
+			defer f.db.Callback().Query().Remove(name + "-after")
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			err := worker.Handle(ctx, f.queue.task)
+			cancel()
+			require.True(t, beforeObserved, "the actual exact final union query was reached")
+			require.True(t, afterObserved, "the actual final union rows were read before the last SQL clock")
+			require.Equal(t, 1, f.model.calls)
+			if mode == "current" {
+				require.NoError(t, err)
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+				after := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+				require.False(t, after.Pending)
+				require.True(t, after.Cursor.After(before.Cursor))
+			} else {
+				require.Error(t, err)
+				require.Positive(t, expiry)
+				assertMemAtomicSQLNoEffects(t, f, before)
+			}
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryWorkerFinalClockActualSQLite(t *testing.T)   { runMemoryWorkerFinalClockSQL(t, false) }
+func TestPostgresMemoryWorkerFinalClockActual(t *testing.T) { runMemoryWorkerFinalClockSQL(t, true) }
