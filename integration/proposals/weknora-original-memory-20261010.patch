diff --git a/internal/application/repository/shared_authority_fence.go b/internal/application/repository/shared_authority_fence.go
new file mode 100644
index 00000000..5a44c134
--- /dev/null
+++ b/internal/application/repository/shared_authority_fence.go
@@ -0,0 +1,472 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type sharedAuthorityTargets struct {
+	Organizations []string
+	Tenants       []uint64
+}
+
+type sharedAuthorityTargetReader func(*gorm.DB) (*sharedAuthorityTargets, error)
+
+func sharedAuthorityOrganizations(values []string) []string {
+	set := map[string]bool{}
+	for _, id := range values {
+		if id != "" {
+			set[id] = true
+		}
+	}
+	var result []string
+	for id := range set {
+		result = append(result, id)
+	}
+	sort.Strings(result)
+	return result
+}
+
+// The organization row closes membership/share phantoms while affected
+// tenant epochs are discovered. Memory's read fence acquires the same
+// organizations before the same epochs, in this exact lock order.
+func sharedAuthorityWrite(ctx context.Context, db *gorm.DB, targets sharedAuthorityTargetReader, write func(*gorm.DB) error) error {
+	if db == nil || targets == nil || write == nil {
+		return ErrKnowledgeInputChanged
+	}
+	run := func(tx *gorm.DB) error {
+		selected, err := targets(tx.Session(&gorm.Session{NewDB: true}))
+		if err != nil {
+			return err
+		}
+		if selected == nil {
+			return ErrKnowledgeInputChanged
+		}
+		organizations := sharedAuthorityOrganizations(selected.Organizations)
+		for _, id := range organizations {
+			var organization types.Organization
+			if err := tx.Unscoped().Clauses(clause.Locking{Strength: "UPDATE"}).Select("id").Where("id=?", id).Take(&organization).Error; err != nil {
+				return err
+			}
+		}
+		// An update may move a share to another organization. Detect a changed
+		// routing selector before mutation; never operate outside locked scope.
+		current, err := targets(tx.Session(&gorm.Session{NewDB: true}))
+		if err != nil {
+			return err
+		}
+		if current == nil {
+			return ErrKnowledgeInputChanged
+		}
+		if !faqInputEqual(sharedAuthorityOrganizations(current.Organizations), organizations) {
+			return ErrKnowledgeInputChanged
+		}
+		tenantSet := map[uint64]bool{}
+		for _, id := range append(append([]uint64(nil), selected.Tenants...), current.Tenants...) {
+			if id != 0 {
+				tenantSet[id] = true
+			}
+		}
+		if len(organizations) != 0 {
+			var members []types.OrganizationTenantMember
+			if err := tx.Where("organization_id IN ?", organizations).Find(&members).Error; err != nil {
+				return err
+			}
+			for _, member := range members {
+				tenantSet[member.TenantID] = true
+			}
+		}
+		var tenantIDs []uint64
+		for id := range tenantSet {
+			tenantIDs = append(tenantIDs, id)
+		}
+		sort.Slice(tenantIDs, func(i, j int) bool { return tenantIDs[i] < tenantIDs[j] })
+		for _, id := range tenantIDs {
+			if _, err := bumpPermissionVersion(tx.Session(&gorm.Session{NewDB: true}), id); err != nil {
+				return err
+			}
+		}
+		// Check the complete source selector again after all epoch locks.
+		// Holding organization locks protects link/share writers; a resource
+		// metadata route outside those writers must not silently change scope.
+		final, err := targets(tx.Session(&gorm.Session{NewDB: true}))
+		if err != nil {
+			return err
+		}
+		if final == nil || !faqInputEqual(sharedAuthorityOrganizations(final.Organizations), organizations) || !faqInputEqual(sharedAuthorityTenants(final.Tenants), sharedAuthorityTenants(current.Tenants)) {
+			return ErrKnowledgeInputChanged
+		}
+		if len(organizations) != 0 {
+			var finalMembers []types.OrganizationTenantMember
+			if err := tx.Where("organization_id IN ?", organizations).Find(&finalMembers).Error; err != nil {
+				return err
+			}
+			finalTenants := append(append([]uint64(nil), selected.Tenants...), final.Tenants...)
+			for _, member := range finalMembers {
+				finalTenants = append(finalTenants, member.TenantID)
+			}
+			if !faqInputEqual(sharedAuthorityTenants(finalTenants), tenantIDs) {
+				return ErrKnowledgeInputChanged
+			}
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := write(tx.Session(&gorm.Session{NewDB: true})); err != nil {
+			return err
+		}
+		return ctx.Err()
+	}
+	bound := db.WithContext(ctx)
+	// GORM uses a savepoint when the caller already owns a transaction.
+	// Roll back epochs and mutations together even if an outer owner handles
+	// a returned error; never leave a partially bumped/changed authority.
+	return bound.Transaction(run)
+}
+
+func sharedAuthorityTenants(values []uint64) []uint64 {
+	set := map[uint64]bool{}
+	for _, id := range values {
+		if id != 0 {
+			set[id] = true
+		}
+	}
+	var result []uint64
+	for id := range set {
+		result = append(result, id)
+	}
+	sort.Slice(result, func(i, j int) bool { return result[i] < result[j] })
+	return result
+}
+
+func sharedAuthorityShareTargets(tx *gorm.DB, table, where string, args []interface{}, fixedOrganizations []string, fixedTenants []uint64) (*sharedAuthorityTargets, error) {
+	var shares []struct {
+		OrganizationID string
+		SourceTenantID uint64
+	}
+	if err := tx.Table(table).Select("organization_id, source_tenant_id").Where(where, args...).Where("deleted_at IS NULL").Scan(&shares).Error; err != nil {
+		return nil, err
+	}
+	targets := &sharedAuthorityTargets{Organizations: append([]string(nil), fixedOrganizations...), Tenants: append([]uint64(nil), fixedTenants...)}
+	for _, share := range shares {
+		targets.Organizations = append(targets.Organizations, share.OrganizationID)
+		targets.Tenants = append(targets.Tenants, share.SourceTenantID)
+	}
+	return targets, nil
+}
+
+func lockSharedAuthorityOrganizationsForMemory(tx *gorm.DB, tenantIDs []uint64) error {
+	var links []struct{ OrganizationID string }
+	if err := tx.Model(&types.OrganizationTenantMember{}).Select("organization_id").Where("tenant_id IN ?", tenantIDs).Scan(&links).Error; err != nil {
+		return err
+	}
+	var ids []string
+	for _, link := range links {
+		ids = append(ids, link.OrganizationID)
+	}
+	for _, id := range sharedAuthorityOrganizations(ids) {
+		var organization types.Organization
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Select("id").Where("id=?", id).Take(&organization).Error; err != nil {
+			return err
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+
+type memoryOriginalAgentKey struct {
+	ID       string
+	TenantID uint64
+}
+
+// Preserve the existing tenant-only metadata helper. Lock consumers use the
+// single discovery result including original agent selectors below.
+func memorySharedAuthorityTenantIDs(tx *gorm.DB, input *types.MemoryOriginalInput) ([]uint64, error) {
+	ids, _, err := memorySharedAuthorityControls(tx, input)
+	return ids, err
+}
+
+func memorySharedAuthorityControls(tx *gorm.DB, input *types.MemoryOriginalInput) ([]uint64, []memoryOriginalAgentKey, error) {
+	return memorySharedReadAuthorityControls(tx, memoryOriginalFence(input))
+}
+func memorySharedReadAuthorityControls(tx *gorm.DB, input *memoryOriginalFenceView) ([]uint64, []memoryOriginalAgentKey, error) {
+	if input == nil || input.Plan == nil {
+		return nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	tenants := map[uint64]bool{input.Actor.CallerTenantID: true, input.TenantID: true}
+	agents := map[memoryOriginalAgentKey]bool{}
+	seen := map[*types.MessageMaterialReadPlan]bool{}
+	visiting := map[*types.MessageMaterialReadPlan]bool{}
+	var visit func(*types.MessageMaterialReadPlan) error
+	visit = func(plan *types.MessageMaterialReadPlan) error {
+		if plan == nil || visiting[plan] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if seen[plan] {
+			return nil
+		}
+		if len(seen) >= 128 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[plan] = true
+		visiting[plan] = true
+		defer delete(visiting, plan)
+		for _, scope := range plan.Scopes {
+			if scope.TenantID == 0 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			tenants[scope.TenantID] = true
+		}
+		if plan.SourceLineage == nil || plan.SourceLineage.RequireComplete() != nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		for _, source := range plan.SourceLineage.Sources {
+			if source.TenantID == 0 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			tenants[source.TenantID] = true
+		}
+		for _, parent := range plan.ParentPlans {
+			if err := visit(parent); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := visit(input.Plan); err != nil {
+		return nil, nil, err
+	}
+	if err := memoryReadAgentAuthorityTenants(tx, input, tenants, agents); err != nil {
+		return nil, nil, err
+	}
+	var ids []uint64
+	for id := range tenants {
+		if id == 0 {
+			return nil, nil, types.ErrMemoryOriginalUnavailable
+		}
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	var agentKeys []memoryOriginalAgentKey
+	for key := range agents {
+		agentKeys = append(agentKeys, key)
+	}
+	sort.Slice(agentKeys, func(i, j int) bool {
+		if agentKeys[i].TenantID != agentKeys[j].TenantID {
+			return agentKeys[i].TenantID < agentKeys[j].TenantID
+		}
+		return agentKeys[i].ID < agentKeys[j].ID
+	})
+	return ids, agentKeys, nil
+}
+
+// Agent ownership is a producer selector even when no knowledge base was
+// consumed. Read only original admission IDs/proofs; never replace this with
+// a current Agent or currently effective grant/share selector.
+func memoryReadAgentAuthorityTenants(tx *gorm.DB, input *memoryOriginalFenceView, tenants map[uint64]bool, agents map[memoryOriginalAgentKey]bool) error {
+	seenAdmissions := map[string]bool{}
+	visitingAdmissions := map[string]bool{}
+	seenFields := map[string]bool{}
+	var addSnapshot func(*types.MessageMaterialSnapshot) error
+	var addAdmission func(string, *types.MessageMaterialProof) error
+	addSource := func(source *types.SourceLineage) error {
+		if source == nil || source.RequireComplete() != nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		for _, entry := range source.Sources {
+			if entry.TenantID == 0 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			tenants[entry.TenantID] = true
+		}
+		return nil
+	}
+	addAdmission = func(id string, expected *types.MessageMaterialProof) error {
+		if id == "" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if visitingAdmissions[id] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var fact messageMaterialAdmission
+		if err := tx.Select("id, generation_id, message_id, session_id, owner_id, body_digest, tenant_id, owner_revision, revision, agent_id, agent_tenant_id, source_lineage,execution_context").Where("id=?", id).Take(&fact).Error; err != nil {
+			return err
+		}
+		if expected != nil {
+			if fact.ID != expected.AdmissionID || fact.GenerationID != expected.GenerationID || fact.MessageID != expected.MessageID || fact.SessionID != expected.SessionID || fact.TenantID != expected.TenantID || fact.Revision != expected.Revision || fact.OwnerID != expected.OwnerID || fact.OwnerRevision != expected.OwnerRevision || fact.BodyDigest != expected.BodyDigest || fact.AgentID != expected.AgentID || fact.AgentTenantID != expected.AgentTenantID {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		if fact.TenantID == 0 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		tenants[fact.TenantID] = true
+		if fact.AgentID != "" {
+			if fact.AgentTenantID == 0 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			tenants[fact.AgentTenantID] = true
+		}
+		var source types.SourceLineage
+		if json.Unmarshal([]byte(fact.SourceLineage), &source) != nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if expected != nil {
+			var execution types.MessageExecutionContext
+			if json.Unmarshal([]byte(fact.ExecutionContext), &execution) != nil || !faqInputEqual(execution, expected.Execution) || !faqInputEqual(&source, expected.SourceLineage) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		if err := addSource(&source); err != nil {
+			return err
+		}
+		// Keep exactly the selector verified against original admission metadata.
+		// Builtin/non-builtin semantics are left to the existing authorizer;
+		// its current SQL existence lookup runs for every nonempty AgentID.
+		if fact.AgentID != "" {
+			agents[memoryOriginalAgentKey{ID: fact.AgentID, TenantID: fact.AgentTenantID}] = true
+		}
+		alreadySeen := seenAdmissions[id]
+		if !alreadySeen {
+			if len(seenAdmissions) >= 1024 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			seenAdmissions[id] = true
+			visitingAdmissions[id] = true
+			defer delete(visitingAdmissions, id)
+		}
+		// Each copied parent remains an original metadata snapshot. Strip its
+		// Messages at SQL projection, before any value reaches Go/authorization.
+		if expected != nil {
+			for _, field := range expected.GeneratedFields {
+				if field == nil || field.AdmissionID == "" || field.Field == "" {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				var record struct{ ParentMaterials, SourceLineage, BodyDigest string }
+				if err := tx.Table("message_generated_field_admissions").Select(parentCopyMetadataSelect(tx, "parent_materials", true)+" AS parent_materials,source_lineage,body_digest").Where("id=? AND message_id=? AND generation_id=? AND field=? AND field_revision=?", field.AdmissionID, fact.MessageID, fact.GenerationID, field.Field, field.Revision).Take(&record).Error; err != nil {
+					return err
+				}
+				if record.BodyDigest != field.BodyDigest {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				var lineage types.SourceLineage
+				if json.Unmarshal([]byte(record.SourceLineage), &lineage) != nil {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				if !faqInputEqual(&lineage, field.SourceLineage) {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				if err := addSource(&lineage); err != nil {
+					return err
+				}
+				// Seen skips recursion only; every occurrence was tuple-checked.
+				if seenFields[field.AdmissionID] {
+					continue
+				}
+				seenFields[field.AdmissionID] = true
+				if len(seenFields) > 4096 {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				var parents []*types.MessageMaterialSnapshot
+				if json.Unmarshal([]byte(record.ParentMaterials), &parents) != nil {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				for _, parent := range parents {
+					if err := addSnapshot(parent); err != nil {
+						return err
+					}
+				}
+			}
+		}
+		if alreadySeen {
+			return nil
+		}
+		var forks []struct{ ParentMaterials string }
+		if err := tx.Table("message_fork_parent_origins").Select(parentCopyMetadataSelect(tx, "parent_materials", false)+" AS parent_materials").Where("generation_id=?", fact.GenerationID).Scan(&forks).Error; err != nil {
+			return err
+		}
+		for _, fork := range forks {
+			var parent types.MessageMaterialSnapshot
+			if json.Unmarshal([]byte(fork.ParentMaterials), &parent) != nil {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			if err := addSnapshot(&parent); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	addSnapshot = func(snapshot *types.MessageMaterialSnapshot) error {
+		if snapshot == nil || len(snapshot.Messages) != 0 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		for _, proof := range snapshot.Proofs {
+			if proof == nil {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			if err := addSource(proof.SourceLineage); err != nil {
+				return err
+			}
+			if err := addAdmission(proof.AdmissionID, proof); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := addSnapshot(input.Material); err != nil {
+		return err
+	}
+	seenPlans := map[*types.MessageMaterialReadPlan]bool{}
+	var addPlan func(*types.MessageMaterialReadPlan) error
+	addPlan = func(plan *types.MessageMaterialReadPlan) error {
+		if plan == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if seenPlans[plan] {
+			return nil
+		}
+		seenPlans[plan] = true
+		for _, control := range plan.Controls {
+			if control == nil {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			var fact messageMaterialAdmission
+			if err := tx.Select("id, generation_id, message_id, session_id, tenant_id, revision").Where("id=? AND message_id=? AND generation_id=? AND session_id=? AND tenant_id=? AND revision=?", control.AdmissionID, control.ID, control.GenerationID, plan.Request.SessionID, plan.Request.TenantID, control.Revision).Take(&fact).Error; err != nil {
+				return err
+			}
+			if err := addAdmission(fact.ID, nil); err != nil {
+				return err
+			}
+		}
+		for _, parent := range plan.ParentPlans {
+			if err := addPlan(parent); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	return addPlan(input.Plan)
+}
+
+// Existing Agent update/soft-delete writers modify this same row. SHARE
+// holds current existence/configuration until the original output commits;
+// metadata-only selection does not replace any captured material/proof.
+func lockMemoryOriginalAgentRows(tx *gorm.DB, agents []memoryOriginalAgentKey) error {
+	for _, key := range agents {
+		if key.ID == "" || key.TenantID == 0 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var current types.CustomAgent
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Select("id,tenant_id").Where("id=? AND tenant_id=?", key.ID, key.TenantID).Take(&current).Error; err != nil {
+			return err
+		}
+		if current.ID != key.ID || current.TenantID != key.TenantID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
