+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+)
+
+// These are real original-admission/dispatch/Handle component cases. Only the
+// provider transport returns a bounded model result; no input, permission,
+// receipt, cursor or output provenance is manufactured by this fixture.
+type memDerivedWholeResultChat struct {
+	*actualMemoryModel
+	mode  string
+	calls int
+}
+
+func (m *memDerivedWholeResultChat) Chat(ctx context.Context, _ []chat.Message, _ *chat.ChatOptions) (*types.ChatResponse, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	m.calls++
+	valid := map[string]interface{}{"action": "add", "kind": "fact", "topic": "development editor", "content": actualMemoryStoredText, "importance": 5, "source": 1}
+	invalid := map[string]interface{}{"action": "replace", "kind": "fact", "topic": "development editor", "content": "The user also runs a terminal editor.", "importance": 5, "source": 1}
+	if m.mode == "invalid_target" {
+		invalid["action"] = "update"
+		invalid["target"] = 99
+	}
+	encoded, err := json.Marshal(map[string]interface{}{"memories": []map[string]interface{}{valid, invalid}, "topics": []string{}})
+	if err != nil {
+		return nil, err
+	}
+	return &types.ChatResponse{Content: string(encoded)}, nil
+}
+
+type memDerivedWholeResultModels struct {
+	actualMemoryModels
+	reader    interfaces.ModelOriginalLifetimeReader
+	transport *memDerivedWholeResultChat
+}
+
+func (m memDerivedWholeResultModels) BeginModelOriginalRead(ctx context.Context, id string, expected *types.ModelOriginalProof) (interfaces.ModelOriginalRead, error) {
+	if m.reader == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return m.reader.BeginModelOriginalRead(ctx, id, expected)
+}
+
+func (m memDerivedWholeResultModels) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	// Handle already owns the current original model read. The production
+	// constructor consumes that held snapshot before transport is replaced.
+	if _, err := m.actualMemoryModels.GetChatModel(ctx, id); err != nil {
+		return nil, err
+	}
+	return m.transport, nil
+}
+
+func runMemoryDerivedWholeResultRefusalSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"unsupported_action", "invalid_target"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			reader, ok := f.admissions.(interfaces.ModelOriginalLifetimeReader)
+			require.True(t, ok)
+			transport := &memDerivedWholeResultChat{actualMemoryModel: f.model.actualMemoryModel, mode: mode}
+			models := memDerivedWholeResultModels{actualMemoryModels: actualMemoryModels{model: f.model.actualMemoryModel, db: f.db}, reader: reader, transport: transport}
+			f.service = memoryservice.NewOriginalBoundMemoryService(f.repo, repository.NewTenantRepository(f.db), repository.NewMessageRepository(f.db), models, f.queue, nil, f.reader, f.admissions)
+			memoryservice.ConfigureOriginalMemoryOutbox(f.service, f.outbox)
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, transport.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			require.NotNil(t, f.queue.task)
+			payload := append([]byte(nil), f.queue.task.Payload()...)
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			require.True(t, before.Pending)
+			var original types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", before.OriginalAdmissionID).Take(&original).Error)
+			worker, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+			err := f.service.Handle(worker, f.queue.task)
+			cancel()
+			require.Equal(t, 1, transport.calls, "refusal must follow the actual model result, not fixture setup")
+			require.ErrorIs(t, err, types.ErrMemoryOriginalUnavailable)
+			assertMemAtomicSQLNoEffects(t, f, before)
+			assertMemAtomicSQLLeasesClosed(t, f)
+			require.Equal(t, payload, f.queue.task.Payload())
+			var retained types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", original.ID).Take(&retained).Error)
+			require.Equal(t, original, retained)
+		})
+	}
+}
+
+func TestMemoryDerivedWholeResultRefusalActualSQLite(t *testing.T) {
+	runMemoryDerivedWholeResultRefusalSQL(t, false)
+}
+
+func TestPostgresMemoryDerivedWholeResultRefusalActual(t *testing.T) {
+	runMemoryDerivedWholeResultRefusalSQL(t, true)
+}
