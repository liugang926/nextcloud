index 00000000..0e519525
--- /dev/null
+++ b/internal/application/service/memory/original.go
@@ -0,0 +1,295 @@
+package memory
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/logger"
+	"github.com/Tencent/WeKnora/internal/logprivacy"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+type memoryOriginalContextKey struct{}
+type memoryOriginalOwner struct {
+	input    *types.MemoryOriginalInput
+	read     interfaces.MemoryOriginalRead
+	snapshot *types.MessageMaterialSnapshot
+}
+
+type memoryExecutionControlKey struct{}
+type memoryExecutionControl struct {
+	policyDigest string
+	modelDigest  string
+	modelID      string
+	tenant       uint64
+	original     *types.MemoryOriginalExecution
+}
+
+func (s *Service) beginMemoryExecutionControl(ctx context.Context, scope interfaces.MemoryScope, cfg *types.MemoryConfig, payload types.MemoryExtractPayload) (context.Context, error) {
+	if err := checkMemoryOriginal(ctx); err != nil {
+		return ctx, err
+	}
+	reader, ok := s.tenantRepo.(interfaces.MemoryPolicyOriginalReader)
+	if !ok || cfg == nil {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	actual, proof, err := reader.ReadMemoryPolicyOriginal(ctx, scope.TenantID)
+	if err != nil {
+		return ctx, err
+	}
+	policy, err := memoryPolicyDigest(cfg)
+	if err != nil {
+		return ctx, err
+	}
+	actualPolicy, err := memoryPolicyDigest(actual)
+	if err != nil || proof == nil || !proof.Valid() || policy != actualPolicy || policy != proof.PolicyDigest {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	id := s.extractionModelID(ctx, cfg, payload)
+	model, modelProof, err := repository.OriginalModelSnapshotFromContext(ctx, id)
+	if err != nil {
+		return ctx, err
+	}
+	if model == nil || (model.TenantID != scope.TenantID && !model.IsBuiltin) || model.Status != types.ModelStatusActive || modelProof == nil || !modelProof.Valid() {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	control := &memoryExecutionControl{policyDigest: policy, modelDigest: modelProof.Digest, modelID: id, tenant: scope.TenantID}
+	owner := memoryOriginalOwnerFromContext(ctx)
+	control.original, err = s.admissions.AdmitMemoryOriginalExecution(ctx, owner.input.ID, policy, id, control.modelDigest)
+	if err != nil {
+		return ctx, err
+	}
+	if control.original.PolicyOriginID != proof.OriginID || control.original.PolicyRevision != proof.Revision || control.original.PolicyOriginDigest != proof.OriginDigest || control.original.PolicyBodyReceiptDigest != proof.BodyReceiptDigest {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	return context.WithValue(ctx, memoryExecutionControlKey{}, control), nil
+}
+
+func (s *Service) checkMemoryExecutionControl(ctx context.Context) error {
+	if err := checkDerivedInputs(ctx); err != nil {
+		return err
+	}
+	if err := checkMemoryOriginal(ctx); err != nil {
+		return err
+	}
+	control, _ := ctx.Value(memoryExecutionControlKey{}).(*memoryExecutionControl)
+	if control == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	reader, ok := s.tenantRepo.(interfaces.MemoryPolicyOriginalReader)
+	if !ok {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	cfg, proof, err := reader.ReadMemoryPolicyOriginal(ctx, control.tenant)
+	if err != nil {
+		return err
+	}
+	if proof == nil || control.original == nil || proof.OriginID != control.original.PolicyOriginID || proof.Revision != control.original.PolicyRevision || proof.OriginDigest != control.original.PolicyOriginDigest || proof.BodyReceiptDigest != control.original.PolicyBodyReceiptDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	policy, err := memoryPolicyDigest(cfg)
+	if err != nil {
+		return err
+	}
+	model, modelProof, err := repository.OriginalModelSnapshotFromContext(ctx, control.modelID)
+	if err != nil {
+		return err
+	}
+	if model == nil || model.Status != types.ModelStatusActive || (model.TenantID != control.tenant && !model.IsBuiltin) || modelProof == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if policy != control.policyDigest || modelProof.Digest != control.modelDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return checkMemoryOriginal(ctx)
+}
+
+func memoryOriginalOwnerFromContext(ctx context.Context) *memoryOriginalOwner {
+	owner, _ := ctx.Value(memoryOriginalContextKey{}).(*memoryOriginalOwner)
+	return owner
+}
+
+func memoryPolicyDigest(cfg *types.MemoryConfig) (string, error) {
+	encoded, err := types.MemoryPolicyBytes(cfg)
+	if err != nil {
+		return "", err
+	}
+	// Selector digest alone is never proof: enqueue/execution additionally pin
+	// the genuine SQL policy origin and its retained control revision.
+	return types.MemoryOriginalBytesDigest(encoded), nil
+}
+
+func (s *Service) scheduleOriginalExtraction(ctx context.Context, scope interfaces.MemoryScope, cfg *types.MemoryConfig, session, message, model string) {
+	if s.originals == nil || s.admissions == nil {
+		logger.Warnf(ctx, "memory: original admission dependencies unavailable")
+		return
+	}
+	subject, err := s.repo.EnsureSubject(ctx, scope)
+	if err != nil || subject == nil || !subject.Enabled {
+		return
+	}
+	policy, err := memoryPolicyDigest(cfg)
+	if err != nil {
+		return
+	}
+	request, err := s.admissions.PrepareMemoryOriginalCapture(ctx, scope, session, message, model, types.LanguageNameFromContext(ctx), policy)
+	if err != nil {
+		logger.Warnf(ctx, "memory: original scheduling selection refused")
+		return
+	}
+	selected := s.extractionModelID(ctx, cfg, types.MemoryExtractPayload{ChatModelID: model})
+	models, ok := s.modelService.(interfaces.ModelOriginalLifetimeReader)
+	if !ok {
+		return
+	}
+	modelRead, err := models.BeginModelOriginalRead(ctx, selected, nil)
+	if err != nil {
+		return
+	}
+	defer func() {
+		if err := modelRead.Close(); err != nil {
+			logger.Warnf(ctx, "memory: original model lease cleanup failed")
+		}
+	}()
+	ctx = modelRead.Context()
+	metadata, modelProof, err := modelRead.Snapshot()
+	if err != nil || metadata == nil || (metadata.TenantID != scope.TenantID && !metadata.IsBuiltin) || metadata.Status != types.ModelStatusActive || modelProof == nil {
+		return
+	}
+	request.EnqueueModelID = selected
+	request.EnqueueModelDigest = modelProof.Digest
+	request.EnqueueModelProof = *modelProof
+	delay := cfg.ExtractDelay()
+	if subject.LastExtractedAt != nil {
+		if remaining := cfg.ExtractMinInterval() - time.Since(*subject.LastExtractedAt); remaining > delay {
+			delay = remaining
+		}
+	}
+	// Freeze the same UTC microsecond instant in the original envelope and intent.
+	request.DispatchNotBefore = time.Now().UTC().Add(delay).Truncate(time.Microsecond)
+	_, err = s.originals.CaptureAndPersistMemoryOriginal(ctx, *request, func(owned context.Context, input *types.MemoryOriginalInput) error {
+		_, _, admissionErr := s.admissions.AdmitMemoryOriginal(owned, input, cfg.ExtractMinInterval()+delay+extractInFlightGrace)
+		return admissionErr
+	})
+	if err != nil {
+		logger.Warnf(ctx, "memory: original admission refused")
+		return
+	}
+	// The original, pending revision and dispatch intent committed together.
+	// A post-commit refusal retains that exact intent for the production relay.
+}
+
+func payloadMatchesMemoryOriginal(payload types.MemoryExtractPayload, input *types.MemoryOriginalInput) bool {
+	if input == nil {
+		return false
+	}
+	q := input.Request
+	return payload.OriginalAdmissionID == input.ID && payload.OriginalDigest == input.Digest && payload.OriginalRevision == q.PendingRevision && payload.TenantID == q.TenantID && payload.SubjectID == q.SubjectID && payload.SessionID == q.SessionID && payload.MessageID == q.TriggerMessageID && payload.ChatModelID == q.ChatModelID && payload.Language == q.Language
+}
+
+func payloadForMemoryOriginal(payload types.MemoryExtractPayload, input *types.MemoryOriginalInput) types.MemoryExtractPayload {
+	q := input.Request
+	payload.OriginalAdmissionID, payload.OriginalDigest, payload.OriginalRevision = input.ID, input.Digest, q.PendingRevision
+	payload.TenantID, payload.SubjectID, payload.SessionID = q.TenantID, q.SubjectID, q.SessionID
+	payload.MessageID, payload.ChatModelID, payload.Language = q.TriggerMessageID, q.ChatModelID, q.Language
+	return payload
+}
+
+func (s *Service) beginOriginalTask(ctx context.Context, payload types.MemoryExtractPayload) (context.Context, types.MemoryExtractPayload, interfaces.MemoryOriginalRead, error) {
+	if s.originals == nil || s.admissions == nil || payload.OriginalAdmissionID == "" || payload.OriginalDigest == "" || payload.OriginalRevision == 0 {
+		return ctx, payload, nil, types.ErrMemoryOriginalUnavailable
+	}
+	// Resolve authentic enqueue-composite descendants, never fresh history.
+	input, err := s.admissions.ResolveMemoryOriginalTask(ctx, payload)
+	if err != nil {
+		return ctx, payload, nil, fmt.Errorf("memory original task refused: %w", err)
+	}
+	read, err := s.originals.BeginMemoryOriginalRead(ctx, input.ID)
+	if err != nil {
+		return ctx, payload, nil, err
+	}
+	snapshot, err := read.Snapshot()
+	if err != nil {
+		read.Close()
+		return ctx, payload, nil, err
+	}
+	owner := &memoryOriginalOwner{input: input, read: read, snapshot: snapshot}
+	// Only a successfully acquired and read original enters this protected
+	// worker context. The flag suppresses telemetry; all read checks remain.
+	return context.WithValue(logprivacy.SuppressContent(read.Context()), memoryOriginalContextKey{}, owner), payloadForMemoryOriginal(payload, input), read, nil
+}
+
+func checkMemoryOriginal(ctx context.Context) error {
+	owner := memoryOriginalOwnerFromContext(ctx)
+	if owner == nil || owner.read == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return owner.read.Recheck()
+}
+
+// Worker transcript selection is derived solely from the loaded original
+// snapshot. New current rows cannot become model input or checkpoint bounds.
+func originalTranscriptRows(ctx context.Context, session types.MemoryExtractionSession) ([]*types.Message, error) {
+	owner := memoryOriginalOwnerFromContext(ctx)
+	if owner == nil || owner.input == nil || owner.snapshot == nil || owner.input.Request.SessionID != session.SessionID || owner.input.Request.PendingRevision != session.Revision || owner.input.ID != session.OriginalAdmissionID {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err := checkMemoryOriginal(ctx); err != nil {
+		return nil, err
+	}
+	rows := append([]*types.Message(nil), owner.snapshot.Messages...)
+	for _, row := range rows {
+		if row == nil {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+	}
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].CreatedAt.Equal(rows[j].CreatedAt) {
+			return rows[i].ID < rows[j].ID
+		}
+		return rows[i].CreatedAt.Before(rows[j].CreatedAt)
+	})
+	var after []*types.Message
+	for _, row := range rows {
+		if row == nil {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		cursor := types.MemoryMessageCursor{At: row.CreatedAt, ID: row.ID}
+		if cursor.After(session.Cursor) && !cursor.After(owner.input.Request.UpperCursor) {
+			after = append(after, row)
+		}
+	}
+	return after, nil
+}
+
+func originalPriorContext(ctx context.Context, session string, before time.Time) []string {
+	owner := memoryOriginalOwnerFromContext(ctx)
+	if owner == nil || owner.snapshot == nil || owner.input.Request.SessionID != session {
+		return nil
+	}
+	rows := append([]*types.Message(nil), owner.snapshot.Messages...)
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].CreatedAt.Equal(rows[j].CreatedAt) {
+			return rows[i].ID < rows[j].ID
+		}
+		return rows[i].CreatedAt.Before(rows[j].CreatedAt)
+	})
+	var lines []transcriptLine
+	for _, row := range rows {
+		if row.Role == "user" && row.CreatedAt.Before(before) {
+			content := strings.TrimSpace(row.Content)
+			if runes := []rune(content); len(runes) > extractMaxLineRunes {
+				content = string(runes[:extractMaxLineRunes])
+			}
+			if content != "" {
+				lines = append(lines, transcriptLine{content: content})
+			}
+		}
+	}
+	return tailContents(lines, extractContextLines)
+}
