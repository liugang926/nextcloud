+	memoryOriginalRelayClaimTTL         = time.Minute
+	memoryOriginalRelayOperationTimeout = 20 * time.Second
+	// Keep the intent after broker acceptance. A consumer crash or exhausted
+	// broker retry remains recoverable; receipt verification ends redelivery.
+	memoryOriginalRelayConsumerGrace = 11 * time.Minute
+	memoryOriginalRelayBatch         = 32
