@@ -0,0 +1,53 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// Depends on the separately prepared derived original slice's real factory
+// interface. It must be fused before compiling this production adapter.
+func ConfigureMemoryDerivedModelOriginals(admissions interfaces.MemoryOriginalAdmissionRepository, factory func(*gorm.DB) interfaces.ModelRepository) {
+	actual, ok := admissions.(*memoryOriginalAdmissionRepository)
+	if !ok || factory == nil {
+		return
+	}
+	decode := func(execution *types.MemoryOriginalExecution) (types.ModelOriginalProof, error) {
+		var proof types.ModelOriginalProof
+		if execution == nil || execution.ID == "" || json.Unmarshal([]byte(execution.ModelProofJSON), &proof) != nil || !proof.Valid() || proof.ModelID != execution.ModelID || proof.Digest != execution.ModelDigest {
+			return proof, types.ErrMemoryOriginalUnavailable
+		}
+		digest, err := memoryExecutionDigest(execution)
+		if err != nil || digest != execution.Digest {
+			return proof, types.ErrMemoryOriginalUnavailable
+		}
+		return proof, nil
+	}
+	ConfigureMemoryDerivedHistoricalModels(admissions, &MemoryDerivedHistoricalModelAuthority{
+		Begin: func(ctx context.Context, execution *types.MemoryOriginalExecution) (interfaces.MemoryDerivedExecutionRead, error) {
+			proof, err := decode(execution)
+			if err != nil {
+				return nil, err
+			}
+			reader, ok := factory(actual.db).(interfaces.HistoricalModelOriginalReader)
+			if !ok {
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			return reader.BeginHistoricalModelOriginalRead(ctx, proof)
+		},
+		Check: func(ctx context.Context, tx *gorm.DB, execution *types.MemoryOriginalExecution) error {
+			proof, err := decode(execution)
+			if err != nil {
+				return err
+			}
+			bound, ok := factory(tx).(*modelRepository)
+			if !ok || bound.db.Statement.ConnPool != tx.Statement.ConnPool {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			return CheckHistoricalModelOriginalHolds(ctx, tx.WithContext(ctx), proof)
+		},
+	})
+}
