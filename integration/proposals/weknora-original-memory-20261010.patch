+		read.hold.ModelContext = read.model.Context()
+	} else {
+		effectiveModelID = ""
+	}
+	err = r.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := r.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+		if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		actor, err := authority.Store.CaptureMemoryOriginalActor(read.ctx)
+		if err != nil {
+			return err
+		}
+		if actor == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		fresh, err := authority.Store.RestoreMemoryOriginalActor(read.ctx, *actor, scope.TenantID, scope.SubjectID)
+		if err != nil {
+			return err
+		}
+		if err = authority.CheckRuntime(fresh); err != nil {
+			return err
+		}
+		if err = lockMemoryPolicyAuthor(tx, fresh, scope.TenantID); err != nil {
+			return err
+		}
+		boundPolicy := tx.Session(&gorm.Session{NewDB: true}).WithContext(context.WithValue(tx.Statement.Context, memoryPolicyHoldKey{}, read.hold.Policy))
+		if err = checkMemoryPolicyHoldsInTx(boundPolicy, scope.TenantID, read.hold.Policy.Current, read.hold.Policy.Queued); err != nil {
+			return err
+		}
+		if !read.hold.Maintenance {
+			if err = r.generatedModels.Check(read.hold.ModelContext, tx.Session(&gorm.Session{NewDB: true}), scope.TenantID, capture.ModelID, modelProof, modelDigest); err != nil {
+				return err
+			}
+		}
+		if err = r.captureMemoryGeneratedModelBindingsInTx(tx, read.hold, hold); err != nil {
