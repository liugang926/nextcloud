+
+// SOURCE ONLY: requires the frozen native atomic fixture and the fused real
+// atomic result/receipt/outbox source. This negative faults one ORM response
+// copy after its actual SQL query. It is not a production-created bad payload,
+// real database corruption, broker fault, full migration-chain or restore gate.
+// The original admission, input/body facts, intent and immutable triggers stay
+// intact; the only committed negative change is owned retry/lease metadata.
+
+type memOutboxSQLImmutableIntent struct {
+	AdmissionID, Payload, PayloadDigest string
+	NotBefore, CreatedAt                time.Time
+}
+
+func memOutboxSQLSnapshot(t *testing.T, f *memAtomicSQLFixture) ([]byte, []byte, types.MemoryOriginalDispatch, types.MemoryExtractPayload) {
+	t.Helper()
+	progress := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	require.NotEmpty(t, progress.OriginalAdmissionID, "only genuine Schedule may create the tested original and intent")
+	var original types.MemoryOriginalAdmission
+	require.NoError(t, f.db.Where("id=?", progress.OriginalAdmissionID).Take(&original).Error)
+	var intent types.MemoryOriginalDispatch
+	require.NoError(t, f.db.Where("admission_id=?", original.ID).Take(&intent).Error)
+	require.Equal(t, types.MemoryOriginalBytesDigest([]byte(intent.Payload)), intent.PayloadDigest)
+	var payload types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal([]byte(intent.Payload), &payload))
+	require.Equal(t, original.ID, payload.OriginalAdmissionID)
+	require.Equal(t, original.Digest, payload.OriginalDigest)
+	require.Equal(t, original.PendingRevision, payload.OriginalRevision)
+	require.Equal(t, f.scope.TenantID, payload.TenantID)
+	require.Equal(t, f.scope.SubjectID, payload.SubjectID)
+	require.Equal(t, f.session.ID, payload.SessionID)
+	require.Equal(t, f.assistant.ID, payload.MessageID)
+	originalBytes, err := json.Marshal(original)
+	require.NoError(t, err)
+	immutableBytes, err := json.Marshal(memOutboxSQLImmutableIntent{intent.AdmissionID, intent.Payload, intent.PayloadDigest, intent.NotBefore, intent.CreatedAt})
+	require.NoError(t, err)
+	return originalBytes, immutableBytes, intent, payload
+}
+
+func waitMemOutboxSQLDue(t *testing.T, due time.Time) {
+	t.Helper()
+	wait := time.Until(due)
+	require.LessOrEqual(t, wait, time.Duration(types.MinMemoryExtractDelaySeconds+2)*time.Second)
+	if wait <= 0 {
+		return
+	}
+	timer := time.NewTimer(wait + 10*time.Millisecond)
+	defer timer.Stop()
+	<-timer.C
+}
+
+// Different real native users avoid the explicitly unsupported multi-session
+// batch case. Current authority reads the actual user/member rows, not a grant
+// returned by this fixture. Both scopes share the same real SQL outbox scan.
+func newMemOutboxSQLHealthySubject(t *testing.T, base *memAtomicSQLFixture) *memAtomicSQLFixture {
+	t.Helper()
+	userID := uuid.NewString()
+	user := &types.User{ID: userID, Username: "owned-outbox-" + userID, Email: userID + "@owned.invalid", PasswordHash: "owned-native-fixture-hash", TenantID: base.scope.TenantID, IsActive: true}
+	require.NoError(t, repository.NewUserRepository(base.db).CreateUser(base.ctx, user))
+	require.NoError(t, repository.NewTenantMemberRepository(base.db).Create(base.ctx, &types.TenantMember{UserID: userID, TenantID: base.scope.TenantID, Role: types.TenantRoleOwner, Status: types.TenantMemberStatusActive}))
+	ctx := types.WithCaller(base.ctx, types.Caller{TenantID: base.scope.TenantID, UserID: userID, Role: types.TenantRoleOwner})
+	ctx = types.WithPrincipal(ctx, types.Principal{Type: types.PrincipalWebUser, ID: userID})
+	ctx = context.WithValue(ctx, types.UserIDContextKey, userID)
+	model := &memAtomicSQLModel{actualMemoryModel: &actualMemoryModel{}}
+	models := memAtomicSQLModels{actualMemoryModels: actualMemoryModels{model: model.actualMemoryModel, db: base.db, originals: base.admissions.(interfaces.ModelOriginalLifetimeReader)}, actual: model}
+	queue := &memAtomicSQLQueue{}
+	worker := memoryservice.NewOriginalBoundMemoryService(base.repo, repository.NewTenantRepository(base.db), repository.NewMessageRepository(base.db), models, queue, nil, base.reader, base.admissions)
+	memoryservice.ConfigureOriginalMemoryOutbox(worker, base.outbox)
+	scope, err := memoryservice.ResolveScope(ctx)
+	require.NoError(t, err)
+	require.NotEqual(t, base.scope.SubjectID, scope.SubjectID)
+	subject, err := base.repo.EnsureSubject(ctx, scope)
+	require.NoError(t, err)
+	require.True(t, subject.Enabled)
+	session, authored, assistant := createActualMemoryTurn(t, base.messages, ctx)
+	return &memAtomicSQLFixture{machine: base.machine, messages: base.messages, ctx: ctx, db: base.db, repo: base.repo, admissions: base.admissions, reader: base.reader, service: worker, scope: scope, model: model, queue: queue, outbox: base.outbox, relay: NewMemoryOriginalOutboxRunner(base.outbox, queue), session: session, user: authored, assistant: assistant, originals: actualMemoryFacts(t, base.db, authored.ID)}
+}
+
+func memOutboxSQLFaultedOriginalTransport(t *testing.T, db *gorm.DB, badID string) (*gorm.DB, *atomic.Int64) {
+	t.Helper()
+	pool, err := db.DB()
+	require.NoError(t, err)
+	var dialect gorm.Dialector = sqlite.New(sqlite.Config{Conn: pool})
+	if db.Dialector.Name() == "postgres" {
+		dialect = postgres.New(postgres.Config{Conn: pool, PreferSimpleProtocol: true})
+	}
+	// A fresh gorm.Open owns callback registry independently. Session/NewDB
+	// would share it and could accidentally fault the authoritative source ORM.
+	transport, err := gorm.Open(dialect, &gorm.Config{})
+	require.NoError(t, err)
+	require.NotSame(t, db.Callback().Query(), transport.Callback().Query())
+	applied := &atomic.Int64{}
+	name := "owned-original-response-" + uuid.NewString()
+	require.NoError(t, transport.Callback().Query().After("gorm:query").Register(name, func(query *gorm.DB) {
+		if query.Error != nil || query.Statement.Table != "memory_original_admissions" {
+			return
+		}
+		row, ok := query.Statement.Dest.(*types.MemoryOriginalAdmission)
+		if !ok || row.ID != badID {
+			return
+		}
+		// The real SELECT has returned. Fault only this owned returned copy;
+		// never change source SQL, facts, payload, controls or digest/signature.
+		row.Envelope = "invalid original response copy"
+		applied.Add(1)
+	}))
+	t.Cleanup(func() { require.NoError(t, transport.Callback().Query().Remove(name)) })
+	return transport, applied
+}
+
+func assertMemOutboxSQLBadScopeRetained(t *testing.T, bad *memAtomicSQLFixture, before types.MemoryExtractionSession) {
+	t.Helper()
+	require.Zero(t, bad.model.calls)
+	require.Nil(t, bad.queue.task)
+	after := actualMemoryProgress(t, bad.db, bad.scope, bad.session.ID)
+	require.Equal(t, before.OriginalAdmissionID, after.OriginalAdmissionID)
+	require.Equal(t, before.Revision, after.Revision)
+	require.Equal(t, before.Cursor, after.Cursor)
+	require.True(t, after.Pending)
+	for _, table := range []string{"memory_items", "memory_tombstones", "memory_topic_stats", "memory_doc_affinity", "memory_item_embeddings", "memory_original_derivations", "memory_original_checkpoints"} {
+		require.Zero(t, memAtomicSQLCount(t, bad, table), "transport refusal must not leak an effect or successful receipt into the bad scope")
+	}
+	require.Equal(t, bad.originals, actualMemoryFacts(t, bad.db, bad.user.ID))
+}
+
+func runMemOutboxSQLTransportPoison(t *testing.T, pg bool) {
+	bad := newMemAtomicSQLFixture(t, pg)
+	bad.service.ScheduleExtraction(bad.ctx, bad.session.ID, bad.assistant.ID, bad.model.GetModelID())
+	badOriginal, badImmutable, badIntent, _ := memOutboxSQLSnapshot(t, bad)
+	badBefore := actualMemoryProgress(t, bad.db, bad.scope, bad.session.ID)
+	healthy := newMemOutboxSQLHealthySubject(t, bad)
+	healthy.service.ScheduleExtraction(healthy.ctx, healthy.session.ID, healthy.assistant.ID, healthy.model.GetModelID())
+	healthyOriginal, healthyImmutable, healthyIntent, healthyPayload := memOutboxSQLSnapshot(t, healthy)
+	require.True(t, badIntent.NotBefore.Before(healthyIntent.NotBefore), "genuine Schedule order must put the faulted intent first")
+	require.Nil(t, bad.queue.task)
+	require.Nil(t, healthy.queue.task)
+	transport, applied := memOutboxSQLFaultedOriginalTransport(t, bad.db, badIntent.AdmissionID)
+	faulted := repository.NewMemoryOriginalOutboxRepository(transport, bad.admissions)
+	badRelay := NewMemoryOriginalOutboxRunner(faulted, bad.queue)
+	healthyRelay := NewMemoryOriginalOutboxRunner(faulted, healthy.queue)
+	waitMemOutboxSQLDue(t, healthyIntent.NotBefore)
+	operation, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	claimed, err := badRelay.RelayOne(operation, "")
+	require.True(t, claimed)
+	require.ErrorIs(t, err, types.ErrMemoryOriginalUnavailable)
+	require.EqualValues(t, 1, applied.Load(), "fault must hit precisely the bad original SELECT response")
+	_, _, retried, _ := memOutboxSQLSnapshot(t, bad)
+	require.EqualValues(t, 1, retried.Attempts)
+	require.Equal(t, "original_intent_invalid", retried.LastFailureCode)
+	require.True(t, retried.NextAttemptAt.After(time.Now().UTC()), "failed intent retry must move off the due queue head")
+	require.Empty(t, retried.LeaseID)
+	require.Nil(t, retried.LeaseUntil)
+	require.Nil(t, retried.LastEnqueuedAt)
+	require.Nil(t, retried.CompletedAt)
+	assertMemOutboxSQLBadScopeRetained(t, bad, badBefore)
+	// The same production SQL scan must now choose the healthy subject. There
+	// is no inserted fake claim and no WHERE override to skip the bad ID.
+	claimed, err = healthyRelay.RelayOne(operation, "")
+	require.NoError(t, err)
+	require.True(t, claimed)
+	require.EqualValues(t, 1, applied.Load(), "healthy original/receipt/source reads must use unfaulted results")
+	require.NotNil(t, healthy.queue.task)
+	var delivered types.MemoryExtractPayload
+	require.NoError(t, json.Unmarshal(healthy.queue.task.Payload(), &delivered))
+	require.Equal(t, healthyPayload, delivered)
+	worker, stop := context.WithTimeout(context.Background(), 10*time.Second)
+	handleErr := healthy.service.Handle(worker, healthy.queue.task)
+	stop()
+	require.NoError(t, handleErr)
+	require.Equal(t, 1, healthy.model.calls)
+	require.EqualValues(t, 1, memAtomicSQLCount(t, healthy, "memory_items"))
+	require.EqualValues(t, 1, memAtomicSQLCount(t, healthy, "memory_original_derivations"))
+	require.EqualValues(t, 1, memAtomicSQLCount(t, healthy, "memory_original_checkpoints"))
+	progress := actualMemoryProgress(t, healthy.db, healthy.scope, healthy.session.ID)
+	require.False(t, progress.Pending)
+	require.True(t, progress.Cursor.After(types.MemoryMessageCursor{}))
+	completed, err := healthy.outbox.VerifyMemoryOriginalCompletion(healthy.ctx, healthyPayload)
+	require.NoError(t, err)
+	require.True(t, completed, "real original dependencies and successful whole-result receipt must prove completion")
+	// A real recovery wake-up only re-arms the existing payload. The second
+	// relay must close it from that actual receipt and perform no second model.
+	require.NoError(t, healthy.outbox.ScheduleMemoryOriginalDispatch(healthy.ctx, healthyPayload, time.Now().UTC()))
+	claimed, err = healthyRelay.RelayOne(operation, healthyIntent.AdmissionID)
+	require.NoError(t, err)
+	require.True(t, claimed)
+	_, _, completedIntent, _ := memOutboxSQLSnapshot(t, healthy)
+	require.NotNil(t, completedIntent.CompletedAt)
+	require.EqualValues(t, 2, completedIntent.Attempts)
+	require.Equal(t, 1, healthy.model.calls)
+	require.EqualValues(t, 1, memAtomicSQLCount(t, healthy, "memory_original_checkpoints"))
+	assertMemOutboxSQLBadScopeRetained(t, bad, badBefore)
+	badAfter, badImmutableAfter, _, _ := memOutboxSQLSnapshot(t, bad)
+	healthyAfter, healthyImmutableAfter, _, _ := memOutboxSQLSnapshot(t, healthy)
+	require.Equal(t, badOriginal, badAfter, "original DB admission bytes must survive transport fault unchanged")
+	require.Equal(t, badImmutable, badImmutableAfter, "retry cannot rewrite original intent payload or selectors")
+	require.Equal(t, healthyOriginal, healthyAfter)
+	require.Equal(t, healthyImmutable, healthyImmutableAfter)
+	require.Equal(t, healthy.originals, actualMemoryFacts(t, healthy.db, healthy.user.ID))
+	assertMemAtomicSQLLeasesClosed(t, bad)
+	assertMemAtomicSQLLeasesClosed(t, healthy)
+	// Immutable guards remain active. This negative statement is expected to
+	// fail; no trigger is dropped and no fact or pending row is deleted.
+	require.Error(t, bad.db.Exec("UPDATE memory_original_dispatches SET payload=? WHERE admission_id=?", "unadmitted payload mutation", badIntent.AdmissionID).Error)
+	_, unchanged, _, _ := memOutboxSQLSnapshot(t, bad)
+	require.Equal(t, badImmutable, unchanged)
+}
+
+func runMemOutboxSQLRequestedNext(t *testing.T, pg bool) {
+	f := newMemAtomicSQLFixture(t, pg)
+	f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+	original, immutable, intent, payload := memOutboxSQLSnapshot(t, f)
+	before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	waitMemOutboxSQLDue(t, intent.NotBefore)
+	operation, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	claim, err := f.outbox.ClaimMemoryOriginalDispatch(operation, intent.AdmissionID, time.Now().UTC(), time.Minute)
+	require.NoError(t, err)
+	require.NotNil(t, claim)
+	require.Empty(t, claim.ValidationFailureCode)
+	require.NotEmpty(t, claim.IntentFingerprint)
+	require.Equal(t, payload, claim.Payload)
+	due := time.Now().UTC().Add(10 * time.Second).Truncate(time.Microsecond)
+	start, scheduled, finished := make(chan struct{}), make(chan error, 1), make(chan error, 1)
+	go func() { <-start; scheduled <- f.outbox.ScheduleMemoryOriginalDispatch(operation, payload, due) }()
+	go func() {
+		<-start
+		now := time.Now().UTC()
+		finished <- f.outbox.FinishMemoryOriginalDispatch(operation, claim, now, now.Add(time.Hour), false, false)
+	}()
+	close(start)
+	// Join both actual SQL operations before any Fatal assertion can start
+	// fixture cleanup. Do not report a completed concurrency oracle early.
+	scheduleErr, finishErr := <-scheduled, <-finished
+	require.NoError(t, scheduleErr)
+	require.NoError(t, finishErr)
+	afterOriginal, afterImmutable, after, _ := memOutboxSQLSnapshot(t, f)
+	require.True(t, due.Equal(after.NextAttemptAt), "either SQL lock order must retain the actual requested next attempt")
+	require.Nil(t, after.RequestedNextAt)
+	require.Empty(t, after.LeaseID)
+	require.Nil(t, after.LeaseUntil)
+	require.Nil(t, after.LastEnqueuedAt, "metadata concurrency is not broker acceptance")
+	require.Nil(t, after.CompletedAt, "metadata concurrency is not a successful receipt")
+	require.Equal(t, original, afterOriginal)
+	require.Equal(t, immutable, afterImmutable)
+	assertMemAtomicSQLNoEffects(t, f, before)
+	assert.Zero(t, f.model.calls)
+	require.Nil(t, f.queue.task)
+	assertMemAtomicSQLLeasesClosed(t, f)
+}
+
+func TestMemoryOriginalOutboxTransportPoisonActualSQLite(t *testing.T) {
+	runMemOutboxSQLTransportPoison(t, false)
+}
+func TestPostgresMemoryOriginalOutboxTransportPoisonActual(t *testing.T) {
+	runMemOutboxSQLTransportPoison(t, true)
+}
+func TestMemoryOriginalOutboxRequestedNextActualSQLite(t *testing.T) {
+	runMemOutboxSQLRequestedNext(t, false)
+}
+func TestPostgresMemoryOriginalOutboxRequestedNextActual(t *testing.T) {
+	runMemOutboxSQLRequestedNext(t, true)
+}
