+
+func (l *productionSQLTraceCapture) ParamsFilter(ctx context.Context, sql string, params ...interface{}) (string, []interface{}) {
+	return l.Interface.(gorm.ParamsFilter).ParamsFilter(ctx, sql, params...)
+}
+
+func (l *productionSQLTraceCapture) Trace(ctx context.Context, begin time.Time, sql func() (string, int64), err error) {
+	l.lastSQL, l.lastRows = sql()
+	l.lastError = err
+	l.Interface.Trace(ctx, begin, sql, err)
+}
+
+func newProductionSQLTestDatabase(t *testing.T) (*gorm.DB, *productionSQLTraceCapture, *bytes.Buffer) {
+	t.Helper()
+	output := &bytes.Buffer{}
+	logger := &productionSQLTraceCapture{Interface: newProductionSQLLogger(log.New(output, "", 0))}
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger})
+	require.NoError(t, err)
+	pool, err := db.DB()
+	require.NoError(t, err)
+	pool.SetMaxOpenConns(1)
+	t.Cleanup(func() { _ = pool.Close() })
+	require.NoError(t, db.Exec("CREATE TABLE sql_privacy_records (id INTEGER PRIMARY KEY, content TEXT NOT NULL)").Error)
+	return db, logger, output
+}
+
+func TestProductionSQLLoggerHidesBoundParametersActualSQLite(t *testing.T) {
+	db, captured, logs := newProductionSQLTestDatabase(t)
+	const initial = "PRIVATE_STORED_BOUND_VALUE"
+	const refused = "PRIVATE_REFUSED_BOUND_VALUE"
+	statement := "INSERT INTO sql_privacy_records (id,content) VALUES (?,?)"
+	require.NoError(t, db.Exec(statement, 1, initial).Error)
+	logs.Reset()
+	result := db.Exec(statement, 1, refused)
+	require.Error(t, result.Error, "real SQLite primary-key conflict drives the error trace")
+	require.Equal(t, result.Error, captured.lastError, "the original driver error reaches the logger unchanged")
+	require.Equal(t, result.RowsAffected, captured.lastRows)
+	require.Zero(t, captured.lastRows)
+	require.Equal(t, statement, captured.lastSQL)
+	require.Contains(t, logs.String(), "UNIQUE constraint failed")
+	require.Contains(t, logs.String(), statement)
+	require.Contains(t, logs.String(), "rows:0")
+	require.NotContains(t, logs.String(), initial)
+	require.NotContains(t, logs.String(), refused)
+	var content string
+	require.NoError(t, db.Raw("SELECT content FROM sql_privacy_records WHERE id=?", 1).Scan(&content).Error)
+	require.Equal(t, initial, content, "logging never changes bound SQL input or stored material")
+}
+
+// Parameter filtering is intentionally narrower than body-safe SQL logging:
+// literal SQL text and database error messages remain diagnostic inputs.
+func TestProductionSQLLoggerPreservesRawLiteralBoundaryActualSQLite(t *testing.T) {
+	db, captured, logs := newProductionSQLTestDatabase(t)
+	require.NoError(t, db.Exec("INSERT INTO sql_privacy_records (id,content) VALUES (?,?)", 1, "owned-row").Error)
+	logs.Reset()
+	statement := "INSERT INTO sql_privacy_records (id,content) VALUES (1,'PRIVATE_RAW_SQL_LITERAL')"
+	result := db.Exec(statement)
+	require.Error(t, result.Error)
+	require.Equal(t, result.Error, captured.lastError)
+	require.Equal(t, statement, captured.lastSQL)
+	require.Contains(t, logs.String(), "PRIVATE_RAW_SQL_LITERAL", "raw literals are outside this bound-variable-only fix")
+	require.Contains(t, logs.String(), "UNIQUE constraint failed")
+	require.Contains(t, logs.String(), "rows:0")
+}
