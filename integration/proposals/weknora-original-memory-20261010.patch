+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryGeneratedHoldInTx(tx *gorm.DB, hold *memoryGeneratedHold, selfCommit string) error {
+	if hold == nil || hold.Original == nil || !hold.Maintenance && hold.ModelContext == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	fact, err := loadMemoryGeneratedOriginal(tx, hold.Original.ID)
+	if err != nil {
+		return err
+	}
+	if fact.Digest != hold.Original.Digest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	derived, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if derived == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = r.checkMemoryDerivedHoldInTx(tx, derived, selfCommit); err != nil {
+		return err
+	}
+	// Match the real policy writer's tenant -> actor -> policy-control order.
+	// Lock only tenant identity here; a changed policy is rejected from control
+	// metadata before any unleased successor policy plaintext is selected.
+	var currentTenant types.Tenant
+	if err = tx.Session(&gorm.Session{NewDB: true}).Select("id").Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", fact.TenantID).Take(&currentTenant).Error; err != nil {
+		return err
+	}
+	var actor types.MemoryOriginalActor
+	if json.Unmarshal([]byte(fact.ActorSelector), &actor) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	fresh, err := authority.Store.RestoreMemoryOriginalActor(tx.Statement.Context, actor, fact.TenantID, fact.SubjectID)
+	if err != nil {
+		return err
+	}
+	if err = authority.CheckRuntime(fresh); err != nil {
+		return err
+	}
+	if err = lockMemoryPolicyAuthor(tx, fresh, fact.TenantID); err != nil {
+		return err
+	}
+	local := tx.Session(&gorm.Session{NewDB: true}).WithContext(context.WithValue(tx.Statement.Context, memoryPolicyHoldKey{}, hold.Policy))
+	revision, err := memoryPolicyRevision(local.Session(&gorm.Session{NewDB: true}), fact.TenantID)
+	if err != nil {
+		return err
+	}
+	if revision != hold.Policy.Current.Revision {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = checkMemoryPolicyHoldsInTx(local, fact.TenantID, hold.Policy.Current, hold.Policy.Queued); err != nil {
+		return err
+	}
+	if err = local.Session(&gorm.Session{NewDB: true}).Select("id,memory_config").Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", fact.TenantID).Take(&currentTenant).Error; err != nil {
+		return err
+	}
+	_, currentPolicy, err := readMemoryPolicyOriginalInTx(local.Session(&gorm.Session{NewDB: true}), &currentTenant)
+	if err != nil {
+		return err
+	}
+	if currentPolicy.Proof() != hold.Policy.Current {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if fact.Recipe == types.MemoryConsolidationMaintenanceRecipe {
+		if !hold.Maintenance || hold.ModelContext != nil || fact.ModelID != "" || fact.ModelProofJSON != "" || fact.ModelDigest != "" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	} else {
+		if hold.Maintenance || r.generatedModels == nil || r.generatedModels.Check == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = r.generatedModels.Check(hold.ModelContext, tx.Session(&gorm.Session{NewDB: true}), fact.TenantID, fact.ModelID, fact.ModelProofJSON, fact.ModelDigest); err != nil {
+			return err
+		}
+	}
+	head, err := checkMemoryGeneratedBodyReceiptInTx(tx, "memory_generated_originals", fact.ID, fact.TenantID, fact.InputSHA256, fact.Digest)
+	if err != nil || head != hold.Head {
+		return ErrOriginalBodyUnavailable
+	}
+	var lease originalBodyLease
+	if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id=?", hold.Lease.LeaseID).Take(&lease).Error; err != nil {
+		return err
+	}
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	if lease.BodyID != hold.Head.BodyID || lease.OwnerID != hold.Lease.OwnerID || lease.Kind != "read" || lease.Epoch != hold.Lease.Epoch || lease.ReleasedAtMS != nil || lease.ExpiresAtMS <= now {
+		return ErrOriginalBodyUnavailable
+	}
+	return r.checkMemoryGeneratedFinalClockInTx(tx, hold, derived)
+}
+func (r *memoryGeneratedRead) Context() context.Context { return r.ctx }
+func (r *memoryGeneratedRead) Original() *types.MemoryGeneratedOriginal {
+	if r.hold.Original == nil {
+		return nil
+	}
+	copy := *r.hold.Original
+	copy.InputJSON = ""
+	return &copy
+}
+func (r *memoryGeneratedRead) Recheck() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.failed != nil {
+		return r.failed
+	}
+	if r.closed {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	err := r.repo.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error { return r.repo.checkMemoryGeneratedHoldInTx(tx, r.hold, "") }, memoryWriteOptions(r.repo.db))
+	if err != nil {
+		r.failed = err
+		r.cancel()
+	}
+	return err
+}
+func (r *memoryGeneratedRead) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return r.failed
+	}
+	r.closed = true
+	r.cancel()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	var first error
+	if r.hold.Lease.LeaseID != "" {
+		first = NewOriginalBodyRetentionStore(r.repo.db).ReleaseLease(cleanup, r.hold.Lease.LeaseID)
+	}
+	if r.model != nil {
+		if err := r.model.Close(); err != nil && first == nil {
+			first = err
+		}
+	}
+	if r.policy != nil {
+		if err := r.policy.Close(); err != nil && first == nil {
+			first = err
+		}
+	}
+	return first
+}
diff --git a/internal/application/repository/memory_generated_maintenance.go b/internal/application/repository/memory_generated_maintenance.go
new file mode 100644
index 00000000..044b0b88
--- /dev/null
+++ b/internal/application/repository/memory_generated_maintenance.go
@@ -0,0 +1,178 @@
+package repository
+
+import (
+	"encoding/json"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+func memoryConsolidationItemInTx(tx *gorm.DB, hold *memoryDerivedHold, proof types.MemoryDerivedInputProof) (*types.MemoryItem, error) {
+	fact := hold.Facts[proof.PublicationID]
+	if fact == nil || proof.ObjectKind != "memory_item" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	actual, head, err := memoryDerivedProofInTx(tx, fact)
+	if err != nil || actual != proof {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if _, ok := hold.Leases[head.BodyID]; !ok {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	var body struct{ MaterialJSON string }
+	if err = tx.Session(&gorm.Session{NewDB: true}).Table("memory_derived_publications").Select("material_json").Where("id=?", fact.ID).Take(&body).Error; err != nil {
+		return nil, err
+	}
+	if types.MemoryOriginalBytesDigest([]byte(body.MaterialJSON)) != fact.MaterialSHA256 {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	if fact.ProducerKind == "authored" || fact.ProducerKind == "control" {
+		var native memoryNativeMaterial
+		if json.Unmarshal([]byte(body.MaterialJSON), &native) != nil {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		body.MaterialJSON = string(native.After)
+	}
+	var item types.MemoryItem
+	if json.Unmarshal([]byte(body.MaterialJSON), &item) != nil || item.ID != proof.ObjectID || item.TenantID != hold.Manifest.TenantID || item.SubjectID != hold.Manifest.SubjectID {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	digest, err := memoryItemMaterialDigest(&item)
+	if err != nil || digest != proof.MaterialDigest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var physical types.MemoryItem
+	if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(forUpdateClause()).Where("id=? AND tenant_id=? AND subject_id=?", item.ID, item.TenantID, item.SubjectID).Take(&physical).Error; err != nil {
+		return nil, err
+	}
+	digest, err = memoryItemMaterialDigest(&physical)
+	if err != nil || digest != proof.MaterialDigest || !faqInputEqual(memoryFactTimePointer(physical.LastUsedAt), memoryFactTimePointer(item.LastUsedAt)) {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &physical, nil
+}
+func memoryConsolidationCommandInTx(tx *gorm.DB, hold *memoryDerivedHold, capture types.MemoryGeneratedCapture, last *time.Time) (types.MemoryConsolidationCommand, []types.MemoryItem, error) {
+	nowMS, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return types.MemoryConsolidationCommand{}, nil, err
+	}
+	observed := time.UnixMilli(nowMS).UTC()
+	command := types.MemoryConsolidationCommand{Force: capture.Force, Review: capture.Review, Clusters: memoryGeneratedClusterIDs(capture.Clusters), LastConsolidatedAt: memoryFactTimePointer(last), ObservedAt: observed, Cutoff: observed.Add(-types.MemoryConsolidationStaleTaskAge), Demotions: []types.MemoryConsolidationDemotion{}}
+	materials := []types.MemoryItem{}
+	if !capture.Review {
+		return command, materials, nil
+	}
+	for _, proof := range hold.Manifest.Inputs {
+		if proof.ObjectKind != "memory_item" {
+			continue
+		}
+		item, err := memoryConsolidationItemInTx(tx, hold, proof)
+		if err != nil {
+			return command, nil, err
+		}
+		if item.Status != types.MemoryStatusActive || item.Kind != types.MemoryKindTask || item.Importance <= 1 || item.ExpiresAt != nil && !item.ExpiresAt.After(observed) {
+			continue
+		}
+		recent := item.ValidFrom
+		if item.LastUsedAt != nil && item.LastUsedAt.After(recent) {
+			recent = *item.LastUsedAt
+		}
+		if recent.After(command.Cutoff) {
+			continue
+		}
+		command.Demotions = append(command.Demotions, types.MemoryConsolidationDemotion{Proof: proof, Importance: item.Importance, ValidFrom: item.ValidFrom, LastUsedAt: memoryFactTimePointer(item.LastUsedAt)})
+		materials = append(materials, *item)
+	}
+	return command, materials, tx.Statement.Context.Err()
+}
+func validateMemoryConsolidationCommand(original *types.MemoryGeneratedOriginal, command *types.MemoryConsolidationCommand) error {
+	if command == nil || command.ObservedAt.IsZero() || !command.Cutoff.Equal(command.ObservedAt.Add(-types.MemoryConsolidationStaleTaskAge)) || !command.Review && len(command.Demotions) > 0 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if original.Recipe == types.MemoryConsolidationMaintenanceRecipe && (!command.Review || len(command.Clusters) != 0 || original.ModelID != "" || original.ModelProofJSON != "" || original.ModelDigest != "") {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if original.Recipe == types.MemoryConsolidationOriginalRecipe && len(command.Clusters) == 0 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var manifest types.MemoryDerivedManifest
+	if json.Unmarshal([]byte(original.DerivedInputsJSON), &manifest) != nil || manifest.TenantID != original.TenantID || manifest.SubjectID != original.SubjectID || manifest.Digest != original.DerivedInputsDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	seen := map[string]bool{}
+	for _, target := range command.Demotions {
+		proof := target.Proof
+		found := false
+		for _, input := range manifest.Inputs {
+			if input == proof {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if proof.ObjectKind != "memory_item" || proof.PublicationID == "" || seen[proof.ObjectID] || target.Importance <= 1 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[proof.ObjectID] = true
+		recent := target.ValidFrom
+		if target.LastUsedAt != nil && target.LastUsedAt.After(recent) {
+			recent = *target.LastUsedAt
+		}
+		if recent.After(command.Cutoff) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	return nil
+}
+func (r *memoryOriginalAdmissionRepository) applyMemoryConsolidationDemotionsInTx(tx *gorm.DB, original *types.MemoryGeneratedOriginal, receiptID string, command types.MemoryConsolidationCommand) ([]types.MemoryGeneratedEffect, error) {
+	effects := []types.MemoryGeneratedEffect{}
+	hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if hold == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	scope := interfaces.MemoryScope{TenantID: original.TenantID, SubjectID: original.SubjectID}
+	for _, target := range command.Demotions {
+		pub, err := memoryDerivedWritablePublication(tx, scope, "memory_item", target.Proof.ObjectID, receiptID)
+		if err != nil {
+			return nil, err
+		}
+		proof, _, err := memoryDerivedProofInTx(tx, pub)
+		if err != nil || proof != target.Proof {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		item, err := memoryConsolidationItemInTx(tx, hold, proof)
+		if err != nil {
+			return nil, err
+		}
+		if item.Kind != types.MemoryKindTask || item.Status != types.MemoryStatusActive || item.Importance != target.Importance || !item.ValidFrom.Equal(target.ValidFrom) || !faqInputEqual(memoryFactTimePointer(item.LastUsedAt), target.LastUsedAt) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		recent := item.ValidFrom
+		if item.LastUsedAt != nil && item.LastUsedAt.After(recent) {
+			recent = *item.LastUsedAt
+		}
+		if recent.After(command.Cutoff) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		at := memoryFactTime()
+		write := tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryItem{}).Where("id=? AND importance=? AND status=?", item.ID, item.Importance, types.MemoryStatusActive).Updates(map[string]interface{}{"importance": 1, "updated_at": at})
+		if write.Error != nil {
+			return nil, write.Error
+		}
+		if write.RowsAffected != 1 {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		item.Importance = 1
+		item.UpdatedAt = at
+		effect, err := r.publishMemoryGeneratedEffectInTx(tx, original, receiptID, "stale_demote", "memory_item", item.ID, pub.ID, item)
+		if err != nil {
+			return nil, err
+		}
+		effects = append(effects, effect)
+	}
+	return effects, nil
+}
diff --git a/internal/application/repository/memory_generated_model_bridge.go b/internal/application/repository/memory_generated_model_bridge.go
new file mode 100644
index 00000000..477d8374
--- /dev/null
+++ b/internal/application/repository/memory_generated_model_bridge.go
@@ -0,0 +1,182 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+
+	modelchat "github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// Requires the separately frozen generated-authority ABI (3259bc09). The
+// opaque wire value is the actual immutable model proof, never a digest of a
+// freshly loaded mutable model or a context manufactured from metadata.
+type memoryGeneratedCurrentModelRead struct {
+	read   interfaces.ModelOriginalRead
+	id     string
+	tenant uint64
+}
+
+func (r *memoryGeneratedCurrentModelRead) Context() context.Context { return r.read.Context() }
+func (r *memoryGeneratedCurrentModelRead) Recheck() error           { return r.read.Recheck() }
+func (r *memoryGeneratedCurrentModelRead) Close() error             { return r.read.Close() }
+func (r *memoryGeneratedCurrentModelRead) Snapshot() (*types.Model, string, string, error) {
+	model, proof, err := r.read.Snapshot()
+	if err != nil {
+		return nil, "", "", err
+	}
+	if model == nil || proof == nil || !proof.Valid() || proof.ModelID != r.id || model.ID != r.id || model.Status != types.ModelStatusActive || model.TenantID != r.tenant && !model.IsBuiltin {
+		return nil, "", "", types.ErrMemoryOriginalUnavailable
+	}
+	if model.Source != types.ModelSourceRemote || (model.Type != types.ModelTypeKnowledgeQA && model.Type != types.ModelTypeVLLM) {
+		return nil, "", "", types.ErrMemoryOriginalUnavailable
+	}
+	if err = modelchat.ValidateOriginalChatDefinition(model.Parameters.OriginalChat); err != nil {
+		return nil, "", "", err
+	}
+	wire, err := json.Marshal(proof)
+	if err != nil {
+		return nil, "", "", err
+	}
+	return model, string(wire), proof.Digest, r.read.Context().Err()
+}
+func generatedModelProof(id, wire, digest string) (types.ModelOriginalProof, error) {
+	var proof types.ModelOriginalProof
+	if id == "" || json.Unmarshal([]byte(wire), &proof) != nil || !proof.Valid() || proof.ModelID != id || proof.Digest != digest {
+		return proof, types.ErrMemoryOriginalUnavailable
+	}
+	canonical, err := json.Marshal(proof)
+	if err != nil || string(canonical) != wire {
+		return proof, types.ErrMemoryOriginalUnavailable
+	}
+	return proof, nil
+}
+func generatedModelScope(ctx context.Context, tenant uint64) error {
+	execution, ok := types.TenantIDFromContext(ctx)
+	if !ok || tenant == 0 || execution != tenant || types.CallerFromContext(ctx).TenantID != tenant {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return ctx.Err()
+}
+func generatedModelRepository(factory func(*gorm.DB) interfaces.ModelRepository, db *gorm.DB) (*modelRepository, error) {
+	if factory == nil || db == nil || db.Statement == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	actual, ok := factory(db).(*modelRepository)
+	if !ok || actual == nil || actual.db == nil || actual.db.Statement == nil || actual.db.Statement.ConnPool != db.Statement.ConnPool || actual.currentReadAuthorizer == nil || actual.historicalAuthorizer == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return actual, nil
+}
+
+// Metadata/body provenance only: decode the immutable definition, not the
+// opaque credential ciphertext. No SQL ModelParameters.Scan/provider occurs.
+func checkGeneratedHistoricalRecipe(tx *gorm.DB, proof types.ModelOriginalProof) error {
+	facts, err := loadHistoricalModelFacts(tx.Session(&gorm.Session{NewDB: true}), proof)
+	if err != nil {
+		return err
+	}
+	var definition types.ModelOriginalDefinition
+	if json.Unmarshal([]byte(facts.Definition.DefinitionJSON), &definition) != nil || definition.Source != types.ModelSourceRemote || (definition.Type != types.ModelTypeKnowledgeQA && definition.Type != types.ModelTypeVLLM) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return modelchat.ValidateOriginalChatDefinition(definition.Parameters.OriginalChat)
+}
+func ConfigureMemoryGeneratedModelOriginals(admissions interfaces.MemoryOriginalAdmissionRepository, factory func(*gorm.DB) interfaces.ModelRepository) {
+	actual, ok := admissions.(*memoryOriginalAdmissionRepository)
+	if !ok {
+		return
+	}
+	if factory == nil {
+		ConfigureMemoryGeneratedModels(admissions, nil)
+		return
+	}
+	ConfigureMemoryGeneratedLeaseIds(admissions, ModelOriginalLeaseIDs)
+	ConfigureMemoryGeneratedModels(admissions, &MemoryGeneratedModelAuthority{
+		Begin: func(ctx context.Context, id string) (interfaces.MemoryGeneratedModelRead, error) {
+			tenant, _ := types.TenantIDFromContext(ctx)
+			if err := generatedModelScope(ctx, tenant); err != nil {
+				return nil, err
+			}
+			models, err := generatedModelRepository(factory, actual.db)
+			if err != nil {
+				return nil, err
+			}
+			read, err := models.BeginModelOriginalRead(ctx, id, nil)
+			if err != nil {
+				return nil, err
+			}
+			wrapped := &memoryGeneratedCurrentModelRead{read: read, id: id, tenant: tenant}
+			if _, _, _, err = wrapped.Snapshot(); err != nil {
+				_ = read.Close()
+				return nil, err
+			}
+			return wrapped, nil
+		},
+		Check: func(ctx context.Context, tx *gorm.DB, tenant uint64, id, wire, digest string) error {
+			if err := generatedModelScope(ctx, tenant); err != nil {
+				return err
+			}
+			proof, err := generatedModelProof(id, wire, digest)
+			if err != nil {
+				return err
+			}
+			if _, err = generatedModelRepository(factory, tx); err != nil {
+				return err
+			}
+			if !sameModelOriginalHolder(ctx, id) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			return CheckCurrentModelOriginalHolds(ctx, tx, proof)
+		},
+		BeginHistory: func(ctx context.Context, id, wire, digest string) (interfaces.MemoryDerivedExecutionRead, error) {
+			tenant, _ := types.TenantIDFromContext(ctx)
+			if err := generatedModelScope(ctx, tenant); err != nil {
+				return nil, err
+			}
+			proof, err := generatedModelProof(id, wire, digest)
+			if err != nil {
+				return nil, err
+			}
+			models, err := generatedModelRepository(factory, actual.db)
+			if err != nil {
+				return nil, err
+			}
+			read, err := models.BeginHistoricalModelOriginalRead(ctx, proof)
+			if err != nil {
+				return nil, err
+			}
+			err = actual.db.WithContext(read.Context()).Transaction(func(tx *gorm.DB) error { return checkGeneratedHistoricalRecipe(tx, proof) }, memoryWriteOptions(actual.db))
+			if err == nil {
+				err = read.Recheck()
+			}
+			if err != nil {
+				_ = read.Close()
+				return nil, err
+			}
+			return read, nil
+		},
+		CheckHistory: func(ctx context.Context, tx *gorm.DB, tenant uint64, id, wire, digest string) error {
+			if err := generatedModelScope(ctx, tenant); err != nil {
+				return err
+			}
+			proof, err := generatedModelProof(id, wire, digest)
+			if err != nil {
+				return err
+			}
+			if _, err = generatedModelRepository(factory, tx); err != nil {
+				return err
+			}
+			bound := tx.Session(&gorm.Session{NewDB: true}).WithContext(ctx)
+			if err = CheckHistoricalModelOriginalHolds(ctx, bound, proof); err != nil {
+				return err
+			}
+			if err = checkGeneratedHistoricalRecipe(bound, proof); err != nil {
+				return err
+			}
+			return CheckHistoricalModelOriginalHolds(ctx, bound, proof)
+		},
+	})
+}
