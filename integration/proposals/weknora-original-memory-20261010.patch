@@ -0,0 +1,77 @@
+package service
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// A narrow read view owns no worker, login/sync writer or global DB access.
+// It retains the real runtime only for current deployment config and its
+// mutex-protected health projection; every persisted read is on this tx.
+type memoryDirectoryStatusReader struct {
+	runtime     *directoryRuntimeService
+	directories interfaces.DirectoryRepository
+}
+
+func newMemoryDirectoryStatusReader(original directoryStatusReader, tx *gorm.DB) (directoryStatusReader, error) {
+	if original == nil {
+		return nil, nil
+	}
+	runtime, ok := original.(*directoryRuntimeService)
+	if !ok || runtime == nil || tx == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if _, owned := tx.Statement.ConnPool.(gorm.TxCommitter); !owned {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &memoryDirectoryStatusReader{runtime: runtime, directories: repository.NewDirectoryRepository(tx.Clauses(clause.Locking{Strength: "SHARE"}))}, nil
+}
+
+func (s *memoryDirectoryStatusReader) GetStatus(ctx context.Context) (*types.DirectoryHealth, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	runtime := s.runtime
+	var directory *types.Directory
+	if runtime.fileManaged() {
+		// File materialization is a writer owned by runtime initialization, not
+		// by an extraction read transaction. Never call ensureFileDirectory here.
+		desired, err := directoryFromDeployment(runtime.deploymentConfig())
+		if err != nil {
+			return nil, err
+		}
+		current, err := s.directories.Get(ctx, desired.ID)
+		if err != nil {
+			return nil, err
+		}
+		if current == nil {
+			if desired.Enabled {
+				return nil, ErrDirectoryNotConfigured
+			}
+			directory = desired
+		} else {
+			if !sameDirectorySettings(current, desired) {
+				return nil, ErrDirectoryUnavailable
+			}
+			directory = current
+		}
+	} else {
+		current, err := s.directories.Get(ctx, runtime.directoryID())
+		if err != nil {
+			return nil, err
+		}
+		if current == nil {
+			return &types.DirectoryHealth{}, ctx.Err()
+		}
+		directory = current
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return runtime.directoryHealthForRead(directory), nil
+}
