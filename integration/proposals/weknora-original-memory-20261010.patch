+func runMemoryPolicyOriginalBodySQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"producer_without_body_capture_closed", "exact_policy_body_scope_and_hold", "released_actual_lease_refuses", "actual_TTL_expiry_refuses", "TTL_crosses_during_final_read", "missing_journal_key_refuses", "same_SHA_new_head_not_original", "unsafe_observed_fact_not_bootstrapped"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, writer, reader := actualPolicyRepository(t, f)
+			cfg, proof, err := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+			require.NoError(t, err)
+			if mode == "same_SHA_new_head_not_original" || mode == "unsafe_observed_fact_not_bootstrapped" {
+				before, _, _, count := actualPolicyFacts(t, f)
+				if mode == "unsafe_observed_fact_not_bootstrapped" {
+					require.NoError(t, f.db.Exec("DELETE FROM original_body_field_heads WHERE source_table='memory_policy_originals' AND row_key=?", proof.OriginID).Error)
+					_, _, err = reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+					require.Error(t, err)
+					_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+					require.Error(t, err, "an observed unsafe original is never reclassified as an absent legacy fact")
+					_, _, _, afterCount := actualPolicyFacts(t, f)
+					require.Equal(t, count, afterCount)
+					return
+				}
+				_, next, err := writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+				require.NoError(t, err)
+				require.Equal(t, proof.PolicyDigest, next.PolicyDigest)
+				var oldHead, newHead struct {
+					SlotID, BodyID string
+					Revision       int64
+				}
+				require.NoError(t, f.db.Table("original_body_field_heads").Where("source_table='memory_policy_originals' AND row_key=?", proof.OriginID).Take(&oldHead).Error)
+				require.NoError(t, f.db.Table("original_body_field_heads").Where("source_table='memory_policy_originals' AND row_key=?", next.OriginID).Take(&newHead).Error)
+				require.NotEqual(t, oldHead.BodyID, newHead.BodyID, "distinct genuine producers own distinct storage domains")
+				ref, err := json.Marshal(map[string]interface{}{"_original_body_version": 1, "slot_id": oldHead.SlotID, "body_id": newHead.BodyID, "sha256": proof.PolicyDigest})
+				require.NoError(t, err)
+				require.NoError(t, f.db.Table("original_body_field_heads").Where("source_table='memory_policy_originals' AND row_key=?", proof.OriginID).Updates(map[string]interface{}{"body_id": newHead.BodyID, "revision": oldHead.Revision + 1, "original_body_ref": string(ref)}).Error)
+				repo, _, _ := actualPolicyRepository(t, f)
+				lifetime := repo.(interfaces.MemoryPolicyOriginalLifetimeReader)
+				_, err = lifetime.BeginMemoryPolicyOriginalRead(f.ctx, 7, *proof)
+				require.Error(t, err, "same bytes in a later current mirror cannot replace an original body receipt")
+				stored, known, err := reader.ReadMemoryPolicyOriginal(f.ctx, 7)
+				require.NoError(t, err)
+				require.Equal(t, before, *stored)
+				require.Equal(t, *next, *known)
+				return
+			}
+			if mode == "producer_without_body_capture_closed" {
+				before, old, revision, count := actualPolicyFacts(t, f)
+				capture := f.db.Callback().Create().Get("original_body:capture")
+				require.NotNil(t, capture)
+				require.NoError(t, f.db.Callback().Create().Remove("original_body:capture"))
+				t.Cleanup(func() {
+					require.NoError(t, f.db.Callback().Create().After("gorm:create").Before("gorm:save_after_associations").Register("original_body:capture", capture))
+				})
+				cfg.ExtractInstructions = actualMemoryCurrentRules
+				_, _, err = writer.ReplaceMemoryPolicyOriginal(f.ctx, 7, *cfg)
+				require.Error(t, err, "authoring cannot produce an unretained policy fact")
+				after, known, afterRev, afterCount := actualPolicyFacts(t, f)
+				require.Equal(t, before, after)
+				require.Equal(t, old, known)
+				require.Equal(t, revision, afterRev)
+				require.Equal(t, count, afterCount)
+				return
+			}
+			repo, _, _ := actualPolicyRepository(t, f)
+			lifetime, ok := repo.(interfaces.MemoryPolicyOriginalLifetimeReader)
+			require.True(t, ok)
+			read, err := lifetime.BeginMemoryPolicyOriginalRead(f.ctx, 7, *proof)
+			require.NoError(t, err)
+			closed := false
+			t.Cleanup(func() {
+				if !closed {
+					require.NoError(t, read.Close())
+				}
+			})
+			actual, pinned, err := read.Policy()
+			require.NoError(t, err)
+			require.Equal(t, cfg, actual)
+			require.Equal(t, proof, pinned)
+			var head struct {
+				BodyID, OwnerID, ColumnName string
+				TenantID                    uint64
+			}
+			require.NoError(t, f.db.Table("original_body_field_heads").Where("source_table='memory_policy_originals' AND row_key=?", proof.OriginID).Take(&head).Error)
+			require.Equal(t, proof.OriginID, head.OwnerID)
+			require.EqualValues(t, 7, head.TenantID)
+			require.Equal(t, "policy_json", head.ColumnName)
+			var scopes []struct {
+				TenantID        uint64
+				KnowledgeBaseID string
+			}
+			require.NoError(t, f.db.Table("original_body_lease_scopes").Where("body_id=?", head.BodyID).Find(&scopes).Error)
+			require.Len(t, scopes, 1)
+			require.EqualValues(t, 7, scopes[0].TenantID)
+			require.Empty(t, scopes[0].KnowledgeBaseID)
+			var lease struct {
+				LeaseID, OwnerID string
+				Epoch            int64
+			}
+			require.NoError(t, f.db.Table("original_body_leases").Where("body_id=? AND kind='read' AND released_at_ms IS NULL", head.BodyID).Take(&lease).Error)
+			require.NotEmpty(t, lease.OwnerID)
+			retention := repository.NewOriginalBodyRetentionStore(f.db)
+			switch mode {
+			case "released_actual_lease_refuses":
+				require.NoError(t, retention.ReleaseLease(f.ctx, lease.LeaseID))
+				require.Error(t, read.Recheck())
+				require.Error(t, read.Recheck(), "failure is sticky")
+			case "actual_TTL_expiry_refuses":
+				// Public renewal sets a real bounded TTL; no SQL clock/lease/head or
+				// proof is fabricated. Wait for the actual wall-clock expiration.
+				require.NoError(t, retention.RenewLease(f.ctx, lease.LeaseID, 20*time.Millisecond))
+				time.Sleep(30 * time.Millisecond)
+				require.Error(t, read.Recheck())
+			case "TTL_crosses_during_final_read":
+				require.NoError(t, retention.RenewLease(f.ctx, lease.LeaseID, time.Second))
+				observed := false
+				removed := false
+				name := "policy-original-real-lease-expiry-after-query"
+				require.NoError(t, f.db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
+					if observed || tx.Error != nil || tx.Statement.Table != "original_body_leases" || tx.Statement.Schema == nil {
+						return
+					}
+					idField := tx.Statement.Schema.FieldsByDBName["lease_id"]
+					expiryField := tx.Statement.Schema.FieldsByDBName["expires_at_ms"]
+					if idField == nil || expiryField == nil {
+						return
+					}
+					id, _ := idField.ValueOf(tx.Statement.Context, tx.Statement.ReflectValue)
+					if id != lease.LeaseID {
+						return
+					}
+					expiry, _ := expiryField.ValueOf(tx.Statement.Context, tx.Statement.ReflectValue)
+					expires, ok := expiry.(int64)
+					require.True(t, ok)
+					require.Greater(t, expires, time.Now().UnixMilli(), "the genuine lease is still live after its SQL query and before the controlled wait")
+					observed = true
+					// Real driver returned the actual lease row after the checker took
+					// its initial clock. Let its genuine TTL cross before final IO.
+					timer := time.NewTimer(time.Until(time.UnixMilli(expires).Add(5 * time.Millisecond)))
+					defer timer.Stop()
+					select {
+					case <-timer.C:
+					case <-tx.Statement.Context.Done():
+					}
+				}))
+				t.Cleanup(func() {
+					if !removed {
+						f.db.Callback().Query().Remove(name)
+					}
+				})
+				require.Error(t, read.Recheck())
+				require.True(t, observed, "the actual locked lease query was reached")
+				require.NoError(t, f.db.Callback().Query().Remove(name))
+				removed = true
+			case "missing_journal_key_refuses":
+				key := os.Getenv("WEKNORA_ORIGINAL_BODY_JOURNAL_KEY")
+				require.NotEmpty(t, key)
+				moved := key + ".policy-test-unavailable"
+				require.NoError(t, os.Rename(key, moved))
+				t.Cleanup(func() {
+					if _, err := os.Lstat(moved); err == nil {
+						require.NoError(t, os.Rename(moved, key))
+					}
+				})
+				require.Error(t, read.Recheck())
+				require.NoError(t, os.Rename(moved, key), "restore exact original file, never regenerate a key or resign a pin")
+			default:
+				require.NoError(t, read.Recheck())
+			}
+			require.NoError(t, read.Close())
+			closed = true
+			var active int64
+			require.NoError(t, f.db.Table("original_body_leases").Where("body_id=? AND kind='read' AND released_at_ms IS NULL", head.BodyID).Count(&active).Error)
+			require.Zero(t, active)
+		})
+	}
+}
