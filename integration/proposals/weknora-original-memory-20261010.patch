+-- Merge into reserved156 AFTER memory_original_admissions. Not standalone.
+CREATE TABLE memory_original_dispatches (
+ admission_id VARCHAR(36) PRIMARY KEY REFERENCES memory_original_admissions(id),
+ payload TEXT NOT NULL,
+ payload_digest VARCHAR(64) NOT NULL CHECK(length(payload_digest)=64),
+ not_before TIMESTAMPTZ NOT NULL,
+ next_attempt_at TIMESTAMPTZ NOT NULL,
+ requested_next_at TIMESTAMPTZ,
+ attempts BIGINT NOT NULL DEFAULT 0 CHECK(attempts>=0),
+ lease_id VARCHAR(36) NOT NULL DEFAULT '',
+ lease_until TIMESTAMPTZ,
+ last_enqueued_at TIMESTAMPTZ,
+ completed_at TIMESTAMPTZ,
+ last_failure_code VARCHAR(64) NOT NULL DEFAULT '',
+ created_at TIMESTAMPTZ NOT NULL,
+ updated_at TIMESTAMPTZ NOT NULL,
+ CHECK((lease_id='' AND lease_until IS NULL) OR (lease_id<>'' AND lease_until IS NOT NULL))
+);
+CREATE INDEX memory_original_dispatch_due ON memory_original_dispatches(next_attempt_at,admission_id) WHERE completed_at IS NULL;
+CREATE FUNCTION memory_original_dispatch_guard() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'original memory dispatch facts cannot be deleted'; END IF;
+ IF OLD.admission_id IS DISTINCT FROM NEW.admission_id OR OLD.payload IS DISTINCT FROM NEW.payload OR
+    OLD.payload_digest IS DISTINCT FROM NEW.payload_digest OR OLD.not_before IS DISTINCT FROM NEW.not_before OR
+    OLD.created_at IS DISTINCT FROM NEW.created_at OR (OLD.completed_at IS NOT NULL AND OLD.completed_at IS DISTINCT FROM NEW.completed_at)
+ THEN RAISE EXCEPTION 'original memory dispatch payload is immutable'; END IF;
+ RETURN NEW;
+END;
+$$;
+CREATE TRIGGER memory_original_dispatch_no_mutation BEFORE UPDATE OR DELETE ON memory_original_dispatches FOR EACH ROW EXECUTE FUNCTION memory_original_dispatch_guard();
