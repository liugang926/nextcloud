@@ -0,0 +1,94 @@
+package chat
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/models/api"
+	"github.com/Tencent/WeKnora/internal/models/catalog"
+	"github.com/Tencent/WeKnora/internal/types"
+	secutils "github.com/Tencent/WeKnora/internal/utils"
+	"github.com/stretchr/testify/require"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestOriginalRemoteConstructorHasNoLiveCatalogFallback(t *testing.T) {
+	for _, mode := range []string{"bearer", "unauthenticated", "signed", "unsigned_empty_key_nonempty_secret"} {
+		t.Run(mode, func(t *testing.T) {
+			var calls atomic.Int64
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				require.Equal(t, "original-provider", r.Header.Get("X-Original-Provider"))
+				require.Empty(t, r.Header.Get("X-Unproved-Overlay"))
+				switch mode {
+				case "bearer":
+					require.Equal(t, "Bearer authored-key", r.Header.Get("Authorization"))
+				case "unauthenticated":
+					require.Empty(t, r.Header.Get("Authorization"))
+				case "signed":
+					require.Equal(t, "authored-app", r.Header.Get("x-appid"))
+					require.Equal(t, "authored-secret", r.Header.Get("x-api-key"))
+				}
+				var input map[string]interface{}
+				require.NoError(t, json.NewDecoder(r.Body).Decode(&input))
+				require.Equal(t, "actual-authored-model", input["model"])
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"id":"real-provider-response","choices":[{"index":0,"message":{"role":"assistant","content":"original provider response"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1}}`))
+			}))
+			defer server.Close()
+			secutils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(secutils.ResetSSRFWhitelistForTest)
+			settings, err := json.Marshal(catalog.DefaultOpenAICompletions())
+			require.NoError(t, err)
+			recipe := &types.ModelOriginalChatDefinition{Version: 1, Recipe: "chat/openai-completions/full-v1", Provider: "openai", API: string(api.APIOpenAICompletions), BaseURL: server.URL, RemoteModel: "actual-authored-model", Headers: map[string]string{"X-Original-Provider": "original-provider"}, Auth: "bearer", RequiresAuth: true, Settings: settings}
+			model := &types.Model{ID: "actual-authored-id", Name: "actual-authored-model", Source: types.ModelSourceRemote, Parameters: types.ModelParameters{OriginalChat: recipe, APIKey: "authored-key"}}
+			if mode == "unauthenticated" {
+				recipe.Auth = "none"
+				recipe.RequiresAuth = false
+				model.Parameters.APIKey = ""
+			}
+			if mode == "signed" {
+				recipe.Auth = "signed"
+				recipe.SignerRecipe = OriginalWeKnoraSigner
+				model.Parameters.APIKey = ""
+				model.Parameters.AppID = "authored-app"
+				model.Parameters.AppSecret = "authored-secret"
+			}
+			if mode == "unsigned_empty_key_nonempty_secret" {
+				model.Parameters.APIKey = ""
+				model.Parameters.AppSecret = "authored-secret"
+			}
+			original, ok := catalog.Get("openai")
+			require.True(t, ok)
+			changed := *original
+			changed.DefaultAPIKey = "UNPROVED_DEFAULT_KEY"
+			changed.Headers = map[string]string{"X-Unproved-Overlay": "UNPROVED"}
+			changed.API = api.APIAnthropicMessages
+			changed.Auth = catalog.AuthXAPIKey
+			catalog.Register(&changed)
+			t.Cleanup(func() { catalog.Register(original) })
+			client, err := NewOriginalRemoteChat(model)
+			if mode == "unsigned_empty_key_nonempty_secret" {
+				require.Error(t, err)
+				require.Zero(t, calls.Load())
+				return
+			}
+			require.NoError(t, err)
+			result, err := client.Chat(context.Background(), []Message{{Role: "user", Content: "Actual authored constructor input"}}, &ChatOptions{})
+			require.NoError(t, err)
+			require.Equal(t, "original provider response", strings.TrimSpace(result.Content))
+			require.EqualValues(t, 1, calls.Load())
+		})
+	}
+}
+
+func TestOriginalRemoteRecipeRequiresCompleteSettings(t *testing.T) {
+	model := &types.Model{ID: "recipe-field-test", Name: "recipe-field-test", Source: types.ModelSourceRemote, Parameters: types.ModelParameters{Provider: "openai", BaseURL: "https://example.invalid", APIKey: "authored-key"}}
+	require.NoError(t, NormalizeAuthoredChatDefinition(model))
+	require.NoError(t, ValidateOriginalChatDefinition(model.Parameters.OriginalChat))
+	model.Parameters.OriginalChat.Settings = json.RawMessage(`{}`)
+	require.Error(t, ValidateOriginalChatDefinition(model.Parameters.OriginalChat))
+}
