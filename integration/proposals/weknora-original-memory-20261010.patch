+CREATE TRIGGER memory_tombstones_derived_control AFTER INSERT OR UPDATE OR DELETE ON memory_tombstones FOR EACH ROW EXECUTE FUNCTION memory_tombstones_derived_control();
+CREATE TRIGGER memory_derived_publications_immutable BEFORE UPDATE OR DELETE ON memory_derived_publications FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+CREATE TRIGGER memory_derived_body_receipts_immutable BEFORE UPDATE OR DELETE ON memory_derived_body_receipts FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+CREATE FUNCTION memory_items_derived_identity() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF OLD.id IS DISTINCT FROM NEW.id OR OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.subject_id IS DISTINCT FROM NEW.subject_id THEN RAISE EXCEPTION 'memory object scope identity is immutable'; END IF; RETURN NEW; END; $$;
+CREATE TRIGGER memory_items_derived_identity BEFORE UPDATE ON memory_items FOR EACH ROW EXECUTE FUNCTION memory_items_derived_identity();
+CREATE FUNCTION memory_topic_stats_derived_identity() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF OLD.id IS DISTINCT FROM NEW.id OR OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.subject_id IS DISTINCT FROM NEW.subject_id THEN RAISE EXCEPTION 'memory object scope identity is immutable'; END IF; RETURN NEW; END; $$;
+CREATE TRIGGER memory_topic_stats_derived_identity BEFORE UPDATE ON memory_topic_stats FOR EACH ROW EXECUTE FUNCTION memory_topic_stats_derived_identity();
+CREATE FUNCTION memory_tombstones_derived_identity() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF OLD.id IS DISTINCT FROM NEW.id OR OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.subject_id IS DISTINCT FROM NEW.subject_id THEN RAISE EXCEPTION 'memory object scope identity is immutable'; END IF; RETURN NEW; END; $$;
+CREATE TRIGGER memory_tombstones_derived_identity BEFORE UPDATE ON memory_tombstones FOR EACH ROW EXECUTE FUNCTION memory_tombstones_derived_identity();
+CREATE FUNCTION memory_subjects_derived_block() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ INSERT INTO memory_derived_collections(tenant_id,subject_id,revision) VALUES(NEW.tenant_id,NEW.subject_id,1) ON CONFLICT(tenant_id,subject_id) DO UPDATE SET revision=memory_derived_collections.revision+1;
+ INSERT INTO memory_derived_controls(tenant_id,subject_id,object_kind,object_id,revision,present) VALUES(NEW.tenant_id,NEW.subject_id,'memory_block',NEW.id,1,TRUE) ON CONFLICT(tenant_id,subject_id,object_kind,object_id) DO UPDATE SET revision=memory_derived_controls.revision+1,present=TRUE;
+ RETURN NEW;
+END; $$;
+CREATE TRIGGER memory_subjects_derived_block AFTER UPDATE ON memory_subjects FOR EACH ROW WHEN (OLD.block_text IS DISTINCT FROM NEW.block_text OR OLD.item_count IS DISTINCT FROM NEW.item_count) EXECUTE FUNCTION memory_subjects_derived_block();
+CREATE FUNCTION memory_subjects_derived_presence() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE r memory_subjects%ROWTYPE; alive BOOLEAN;
+BEGIN
+ IF TG_OP='DELETE' THEN r:=OLD;alive:=FALSE; ELSE r:=NEW;alive:=TRUE; END IF;
+ IF TG_OP='INSERT' AND r.block_text='' AND r.item_count=0 THEN RETURN r; END IF;
+ INSERT INTO memory_derived_collections(tenant_id,subject_id,revision) VALUES(r.tenant_id,r.subject_id,1) ON CONFLICT(tenant_id,subject_id) DO UPDATE SET revision=memory_derived_collections.revision+1;
+ INSERT INTO memory_derived_controls(tenant_id,subject_id,object_kind,object_id,revision,present) VALUES(r.tenant_id,r.subject_id,'memory_block',r.id,1,alive) ON CONFLICT(tenant_id,subject_id,object_kind,object_id) DO UPDATE SET revision=memory_derived_controls.revision+1,present=excluded.present;
+ RETURN r; END; $$;
+CREATE TRIGGER memory_subjects_derived_presence AFTER INSERT OR DELETE ON memory_subjects FOR EACH ROW EXECUTE FUNCTION memory_subjects_derived_presence();
+CREATE FUNCTION memory_derived_collections_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF TG_OP='DELETE' THEN RAISE EXCEPTION 'memory derived controls are retained'; END IF; IF OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.subject_id IS DISTINCT FROM NEW.subject_id OR NEW.revision<>OLD.revision+1 THEN RAISE EXCEPTION 'memory derived control revision is monotonic'; END IF; RETURN NEW; END; $$;
+CREATE TRIGGER memory_derived_collections_guard BEFORE UPDATE OR DELETE ON memory_derived_collections FOR EACH ROW EXECUTE FUNCTION memory_derived_collections_guard();
+CREATE FUNCTION memory_derived_controls_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF TG_OP='DELETE' THEN RAISE EXCEPTION 'memory derived controls are retained'; END IF; IF OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.subject_id IS DISTINCT FROM NEW.subject_id OR OLD.object_kind IS DISTINCT FROM NEW.object_kind OR OLD.object_id IS DISTINCT FROM NEW.object_id OR NEW.revision<>OLD.revision+1 THEN RAISE EXCEPTION 'memory derived control revision is monotonic'; END IF; RETURN NEW; END; $$;
+CREATE TRIGGER memory_derived_controls_guard BEFORE UPDATE OR DELETE ON memory_derived_controls FOR EACH ROW EXECUTE FUNCTION memory_derived_controls_guard();
