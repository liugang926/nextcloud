+	require.NoError(t, db.AutoMigrate(&types.MemorySubject{}, &types.MemoryItem{}, &types.MemoryTombstone{},
+		&types.MemoryTopicStat{}, &types.MemoryDocAffinity{}, &types.MemoryItemEmbedding{}, &types.MemoryExtractionSession{}))
+	require.NoError(t, repository.InstallOriginalBodyRetentionTriggers(db))
+	messageRepo := repository.NewMessageRepository(db)
+	messages := &messageService{messageRepo: messageRepo, sessionRepo: repository.NewSessionRepository(db), sourceLineageGuard: m.f.guard, kbService: m.f.s.kbService, knowService: m.f.s}
+	ConfigureMessageMaterialProvenance(messages, m.f.store)
