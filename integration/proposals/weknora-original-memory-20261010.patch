@@ -0,0 +1,132 @@
+package memory
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+)
+
+// Prepare a whole result without writes. Unsupported/missing target origins,
+// excess decisions and sensitive/unknown output refuse the entire result.
+func prepareOriginalMutations(scope interfaces.MemoryScope, segment transcriptSegment, parsed extractionResponse) ([]types.MemoryOriginalMutation, error) {
+	if len(parsed.Memories) > extractMaxItemsPerRun {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var ops []types.MemoryOriginalMutation
+	seen := map[string]bool{}
+	for _, decision := range parsed.Memories {
+		action := strings.ToLower(strings.TrimSpace(decision.Action))
+		if action == "none" || action == "noop" {
+			continue
+		}
+		if action != "add" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		} // genuine target-original reader remains required
+		content := types.SanitizeMemoryContent(decision.Content)
+		if content == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		if redacted, changed := types.RedactSensitive(content); changed {
+			if types.IsMostlyRedacted(redacted) {
+				return nil, ErrSensitiveContent
+			}
+			content = types.SanitizeMemoryContent(redacted)
+		}
+		if !types.IsValidMemoryKind(decision.Kind) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		topic := types.SanitizeMemoryTopic(decision.Topic)
+		key := types.MemoryItemKey(topic, content)
+		if key == "" || seen[key] {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		seen[key] = true
+		source := decision.resolveSource(segment)
+		if source.messageID == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		item := &types.MemoryItem{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, Kind: decision.Kind, Content: content, Topic: topic, NormalizedKey: key, Importance: types.ClampMemoryImportance(decision.Importance), Origin: types.MemoryOriginExtracted, SourceSessionID: source.sessionID, SourceMessageID: source.messageID, ValidFrom: time.Now().UTC(), ExpiresAt: parseExpiry(decision.ExpiresAt), Inferred: decision.Inferred}
+		item.Status = statusForWrite(*item)
+		ops = append(ops, types.MemoryOriginalMutation{ID: item.ID, Action: action, Item: item, SourceMessageID: source.messageID})
+	}
+	for _, value := range parsed.Topics {
+		topic := types.SanitizeMemoryTopic(value)
+		if topic == "" {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		key := types.MemoryItemKey(topic, topic)
+		if seen["topic:"+key] {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		seen["topic:"+key] = true
+		ops = append(ops, types.MemoryOriginalMutation{ID: uuid.NewString(), Action: "topic", Topic: topic, NormalizedKey: key})
+	}
+	return ops, nil
+}
+
+func (s *Service) prepareOriginalSessionResult(ctx context.Context, scope interfaces.MemoryScope, cfg *types.MemoryConfig, payload types.MemoryExtractPayload, session types.MemoryExtractionSession, worker string) (*types.MemoryOriginalCommit, error) {
+	if err := checkDerivedInputs(ctx); err != nil {
+		return nil, err
+	}
+	segments, more, err := s.collectSessionSegments(ctx, session)
+	if err != nil {
+		return nil, err
+	}
+	ctx, err = s.beginMemoryExecutionControl(ctx, scope, cfg, payload)
+	if err != nil {
+		return nil, err
+	}
+	control, _ := ctx.Value(memoryExecutionControlKey{}).(*memoryExecutionControl)
+	owner := memoryOriginalOwnerFromContext(ctx)
+	result := &types.MemoryOriginalCommit{ID: uuid.NewString(), InputAdmissionID: owner.input.ID, InputDigest: owner.input.Digest, ExecutionAdmissionID: control.original.ID, ExecutionDigest: control.original.Digest, WorkerLeaseID: worker, PreviousCheckpointID: session.OriginalCheckpointID, Session: session, From: session.Cursor, To: session.Cursor, Recipe: "memory.extract.atomic.v1"}
+	var responses []extractionResponse
+	for index, segment := range segments {
+		if index >= 1 {
+			more = true
+			break
+		}
+		if len(segment.lines) > 0 {
+			existing, snapshot, err := s.relevantDerivedInputs(ctx, scope, cfg, segment)
+			if err != nil {
+				return nil, err
+			}
+			parsed, err := s.callExtractionModel(ctx, cfg, payload, segment, existing, snapshot.Tombstones, snapshot.Topics)
+			if err != nil {
+				return nil, err
+			}
+			if err = s.checkMemoryExecutionControl(ctx); err != nil {
+				return nil, err
+			}
+			ops, err := prepareDerivedMutations(scope, segment, parsed, existing, snapshot)
+			if err != nil {
+				return nil, err
+			}
+			topics, err := s.prepareDerivedTopics(ctx, scope, cfg, payload, parsed.Topics, snapshot)
+			if err != nil {
+				return nil, err
+			}
+			result.Operations = append(result.Operations, ops...)
+			result.Operations = append(result.Operations, topics...)
+			responses = append(responses, parsed)
+		}
+		result.To = types.MemoryMessageCursor{At: segment.end, ID: segment.endID}
+	}
+	if len(segments) == 0 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	result.Drained = !more
+	encoded, err := json.Marshal(responses)
+	if err != nil {
+		return nil, err
+	}
+	result.ModelResultDigest = types.MemoryOriginalBytesDigest(encoded)
+	if err = s.checkMemoryExecutionControl(ctx); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
