+-- Generated native consolidation originals: append to the reserved 000156 chain only.
+CREATE TABLE memory_generated_originals (
+ id TEXT PRIMARY KEY,tenant_id BIGINT NOT NULL,subject_id TEXT NOT NULL,recipe TEXT NOT NULL,request_json TEXT NOT NULL,
+ derived_inputs_json TEXT NOT NULL,derived_inputs_digest TEXT NOT NULL,actor_selector TEXT NOT NULL,policy_proof_json TEXT NOT NULL,
