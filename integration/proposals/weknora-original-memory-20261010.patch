new file mode 100644
index 00000000..8f59e698
--- /dev/null
+++ b/internal/application/service/model_original.go
@@ -0,0 +1,128 @@
+package service
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func ConfigureModelOriginalAuthority(repo interfaces.ModelRepository, material *repository.KnowledgeInputProvenanceStore, groups interfaces.GroupAccessService, directoryRuntime interfaces.DirectoryRuntimeService) {
+	repository.ConfigureModelOriginalAuthorizer(repo, func(ctx context.Context, tx *gorm.DB, tenant uint64, builtin bool) (context.Context, error) {
+		boundGroups := NewGroupAccessService(repository.NewGroupAccessRepository(tx))
+		var runtime directoryStatusReader = directoryRuntime
+		if original, ok := groups.(*groupAccessService); ok && directoryRuntime == nil {
+			runtime = original.directoryRuntime
+		}
+		status, err := newMemoryDirectoryStatusReader(runtime, tx)
+		if err != nil {
+			return ctx, err
+		}
+		if status != nil {
+			health, err := status.GetStatus(ctx)
+			if err != nil {
+				return ctx, err
+			}
+			if health == nil {
+				return ctx, types.ErrMemoryOriginalUnavailable
+			}
+		}
+		configureGroupAccessDirectoryStatus(boundGroups, status)
+		caller := types.CallerFromContext(ctx)
+		principal, ok := types.PrincipalFromContext(ctx)
+		if !ok || caller.TenantID == 0 {
+			return ctx, access.ErrForbidden
+		}
+		var owner types.Tenant
+		if err = tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=?", tenant).Take(&owner).Error; err != nil {
+			return ctx, err
+		}
+		if builtin {
+			if principal.Type != types.PrincipalWebUser || principal.ID != caller.UserID || caller.UserID == "" {
+				return ctx, access.ErrForbidden
+			}
+			var user types.User
+			if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND is_active=? AND is_system_admin=?", caller.UserID, true, true).Take(&user).Error; err != nil {
+				return ctx, err
+			}
+			return context.WithValue(ctx, types.SystemAdminContextKey, true), ctx.Err()
+		}
+		if caller.TenantID != tenant {
+			return ctx, access.ErrForbidden
+		}
+		if err = repository.LockMemoryPolicyOriginalAuthor(tx, ctx, tenant); err != nil {
+			return ctx, err
+		}
+		store := repository.MemoryOriginalTransactionStore(material, tx)
+		if store == nil {
+			return ctx, types.ErrMemoryOriginalUnavailable
+		}
+		repository.ConfigureKnowledgeInputActorGroupAccess(store, boundGroups)
+		fresh, err := store.RefreshCurrentReadActor(ctx)
+		if err != nil {
+			return ctx, err
+		}
+		if !types.CallerFromContext(fresh).Role.HasPermission(types.TenantRoleAdmin) {
+			return ctx, access.ErrForbidden
+		}
+		return fresh, ctx.Err()
+	})
+	readAuthority := func(ctx context.Context, tx *gorm.DB, proof types.ModelOriginalProof) (context.Context, error) {
+		boundGroups := NewGroupAccessService(repository.NewGroupAccessRepository(tx))
+		var runtime directoryStatusReader = directoryRuntime
+		if original, ok := groups.(*groupAccessService); ok && directoryRuntime == nil {
+			runtime = original.directoryRuntime
+		}
+		status, err := newMemoryDirectoryStatusReader(runtime, tx)
+		if err != nil {
+			return ctx, err
+		}
+		if status != nil {
+			health, err := status.GetStatus(ctx)
+			if err != nil {
+				return ctx, err
+			}
+			if health == nil {
+				return ctx, types.ErrMemoryOriginalUnavailable
+			}
+		}
+		configureGroupAccessDirectoryStatus(boundGroups, status)
+		caller := types.CallerFromContext(ctx)
+		if caller.TenantID == 0 || (!proof.IsBuiltin && caller.TenantID != proof.OwnerTenantID) {
+			return ctx, access.ErrForbidden
+		}
+		var tenant types.Tenant
+		if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", caller.TenantID).Take(&tenant).Error; err != nil {
+			return ctx, err
+		}
+		if err = repository.LockMemoryPolicyOriginalAuthor(tx, ctx, caller.TenantID); err != nil {
+			return ctx, err
+		}
+		store := repository.MemoryOriginalTransactionStore(material, tx)
+		if store == nil {
+			return ctx, types.ErrMemoryOriginalUnavailable
+		}
+		repository.ConfigureKnowledgeInputActorGroupAccess(store, boundGroups)
+		return store.RefreshCurrentReadActor(ctx)
+	}
+	repository.ConfigureModelOriginalHistoricalAuthorizer(repo, readAuthority)
+	repository.ConfigureModelOriginalCurrentReadAuthorizer(repo, readAuthority)
+}
+
+func (s *modelService) BeginModelOriginalRead(ctx context.Context, id string, expected *types.ModelOriginalProof) (interfaces.ModelOriginalRead, error) {
+	reader, ok := s.repo.(interfaces.ModelOriginalLifetimeReader)
+	if !ok {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return reader.BeginModelOriginalRead(ctx, id, expected)
+}
+func (s *modelService) ReplaceModelOriginal(ctx context.Context, model *types.Model) error {
+	writer, ok := s.repo.(interfaces.ModelOriginalWriter)
+	if !ok {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return writer.ReplaceModelOriginal(ctx, model)
+}
