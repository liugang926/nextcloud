+package repository
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// The concrete model-original slice supplies these adapters. Current reads
+// authorize this operation's new call; historical reads prove its provenance
+// later, without returning a runnable old provider or old secret snapshot.
+type MemoryGeneratedModelAuthority struct {
+	Begin        func(context.Context, string) (interfaces.MemoryGeneratedModelRead, error)
+	Check        func(context.Context, *gorm.DB, uint64, string, string, string) error
+	BeginHistory func(context.Context, string, string, string) (interfaces.MemoryDerivedExecutionRead, error)
+	CheckHistory func(context.Context, *gorm.DB, uint64, string, string, string) error
+}
+
+func ConfigureMemoryGeneratedModels(admissions interfaces.MemoryOriginalAdmissionRepository, authority *MemoryGeneratedModelAuthority) {
