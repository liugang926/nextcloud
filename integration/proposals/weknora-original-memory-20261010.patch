+ payload TEXT NOT NULL,
+ payload_digest TEXT NOT NULL CHECK(length(payload_digest)=64),
+ not_before DATETIME NOT NULL,
+ next_attempt_at DATETIME NOT NULL,
+ requested_next_at DATETIME,
+ attempts BIGINT NOT NULL DEFAULT 0 CHECK(attempts>=0),
+ lease_id TEXT NOT NULL DEFAULT '',
+ lease_until DATETIME,
+ last_enqueued_at DATETIME,
+ completed_at DATETIME,
+ last_failure_code TEXT NOT NULL DEFAULT '',
+ created_at DATETIME NOT NULL,
+ updated_at DATETIME NOT NULL,
+ CHECK((lease_id='' AND lease_until IS NULL) OR (lease_id<>'' AND lease_until IS NOT NULL))
+);
+CREATE INDEX memory_original_dispatch_due ON memory_original_dispatches(next_attempt_at,admission_id) WHERE completed_at IS NULL;
+CREATE TRIGGER memory_original_dispatch_no_delete BEFORE DELETE ON memory_original_dispatches BEGIN SELECT RAISE(ABORT,'original memory dispatch facts cannot be deleted'); END;
