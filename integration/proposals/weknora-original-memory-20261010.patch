@@ -0,0 +1,142 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/config"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// SOURCE ONLY. Real configured runtime and real SQL repository, never fake
+// GetStatus or nil runtime. This covers status/config/DB authority only; no
+// runtime.Start/Authenticate/Sync/TestConnection or LDAP network is invoked.
+// Enabled-configured positive means module/config present, not LDAP sync or
+// login availability. No synthetic fresh snapshot or LastSuccess is written.
+func newMemConfiguredDirectoryRuntime(t *testing.T, f *memAtomicSQLFixture, mode string) (interfaces.DirectoryRuntimeService, *config.Config) {
+	t.Helper()
+	directoryConfig := &config.DirectoryConfig{ID: "memory-status-configured", ManagementSource: config.DirectoryManagementDatabase}
+	if mode == "file_matching" || mode == "file_drift_after_queue" {
+		directoryConfig = &config.DirectoryConfig{ID: "memory-status-configured", ManagementSource: config.DirectoryManagementFile, Enabled: true, ProviderDisplayName: "owned component status directory", Servers: []config.DirectoryServerConfig{{URL: "ldaps://127.0.0.1:9", TLSMode: config.DirectoryTLSLDAPS}}, BaseDN: "DC=example,DC=test", BindDN: "CN=status-reader,DC=example,DC=test", BindPassword: "owned-status-only-fixture", UserFilter: "(objectClass=user)", GroupFilter: "(objectClass=group)", ConnectTimeout: time.Second, QueryTimeout: time.Second, PageSize: 100, ResultLimit: 1000, SyncInterval: time.Minute, StaleAfter: 15 * time.Minute}
+	}
+	cfg := &config.Config{Directory: directoryConfig}
+	directoriesRepo := repository.NewDirectoryRepository(f.db)
+	directories := NewDirectoryService(directoriesRepo)
+	runtime := NewDirectoryRuntimeService(cfg, directories, directoriesRepo, nil, nil, nil, nil, nil)
+	require.NotNil(t, runtime)
+	if mode == "database_disabled" || mode == "database_enabled_configured" {
+		secret := "owned-status-only-fixture"
+		saved, err := runtime.UpdateConfig(f.ctx, &types.DirectoryAdminConfigUpdate{Enabled: mode == "database_enabled_configured", DisplayName: "owned component status directory", Servers: []types.DirectoryAdminServer{{Address: "ldaps://127.0.0.1:9"}}, Transport: types.DirectoryTLSLDAPS, BaseDN: "DC=example,DC=test", BindDN: "CN=status-reader,DC=example,DC=test", BindPassword: &secret, UserFilter: "(objectClass=user)", GroupFilter: "(objectClass=group)", ConnectTimeoutSeconds: 1, QueryTimeoutSeconds: 1, PageSize: 100, ResultLimit: 1000, SyncIntervalSeconds: 60, StaleAfterSeconds: 900})
+		require.NoError(t, err)
+		require.Equal(t, mode == "database_enabled_configured", saved.Enabled)
+		require.True(t, saved.HasBindPassword)
+	}
+	// Real file initialization may materialize configuration outside a memory
+	// TX. The transaction-bound adapter must subsequently perform reads only.
+	health, err := runtime.GetStatus(f.ctx)
+	require.NoError(t, err)
+	require.NotNil(t, health)
+	require.Equal(t, mode != "database_disabled", health.Enabled)
+	return runtime, cfg
+}
+func runMemConfiguredDirectorySinglePool(t *testing.T, pg bool) {
+	for _, mode := range []string{"database_disabled", "database_enabled_configured", "file_matching", "file_drift_after_queue"} {
+		t.Run(mode, func(t *testing.T) {
+			// Owned test credentials are set before the genuine base fixture
+			// creates any pairing/config; no existing runtime key is rotated.
+			t.Setenv("SYSTEM_AES_KEY", "0123456789abcdef0123456789abcdef")
+			t.Setenv("JWT_SECRET", "owned-component-directory-status-key")
+			f := newMemAtomicSQLFixture(t, pg)
+			pool, err := f.db.DB()
+			require.NoError(t, err)
+			pool.SetMaxOpenConns(1)
+			pool.SetMaxIdleConns(1)
+			require.Equal(t, 1, pool.Stats().MaxOpenConnections)
+			runtime, cfg := newMemConfiguredDirectoryRuntime(t, f, mode)
+			groups := NewGroupAccessService(repository.NewGroupAccessRepository(f.db))
+			ConfigureGroupAccessDirectoryRuntime(groups, runtime)
+			ConfigureMemoryOriginalAtomicAuthority(f.admissions, f.machine.f.store, groups, runtime)
+			// With the only connection already owned by this transaction, a
+			// call to runtime's global repository would wait until deadline.
+			waits := pool.Stats().WaitCount
+			check, cancelCheck := context.WithTimeout(f.ctx, 3*time.Second)
+			err = f.db.WithContext(check).Transaction(func(tx *gorm.DB) error {
+				status, err := newMemoryDirectoryStatusReader(runtime, tx)
+				if err != nil {
+					return err
+				}
+				health, err := status.GetStatus(check)
+				if err != nil {
+					return err
+				}
+				require.NotNil(t, health)
+				require.Equal(t, mode != "database_disabled", health.Enabled)
+				return check.Err()
+			})
+			cancelCheck()
+			require.NoError(t, err)
+			assert.Equal(t, waits, pool.Stats().WaitCount, "status must not acquire global pool while TX owns its only connection")
+			// Actual Schedule uses the real original CaptureAndPersist/Admit
+			// path. A real descriptor and real model/body proofs must commit.
+			capture, cancelCapture := context.WithTimeout(f.ctx, 10*time.Second)
+			f.service.ScheduleExtraction(capture, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			cancelCapture()
+			progress := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			require.NotEmpty(t, progress.OriginalAdmissionID)
+			input, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, progress.OriginalAdmissionID)
+			require.NoError(t, err)
+			require.NotEmpty(t, input.Digest)
+			require.Empty(t, input.Material.Messages)
+			require.NotEmpty(t, input.Material.Proofs)
+			relayMemAtomicSQLScheduled(t, f)
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			var persisted *types.Directory
+			if mode == "file_drift_after_queue" {
+				persisted, err = repository.NewDirectoryRepository(f.db).Get(f.ctx, cfg.Directory.ID)
+				require.NoError(t, err)
+				require.NotNil(t, persisted)
+				// Only the real deployment config changes. Do not call global
+				// GetStatus afterwards: its initializer would materialize it.
+				cfg.Directory.BaseDN = "OU=changed,DC=example,DC=test"
+			}
+			worker, cancelWorker := context.WithTimeout(context.Background(), 10*time.Second)
+			handleErr := f.service.Handle(worker, f.queue.task)
+			cancelWorker()
+			if mode == "file_drift_after_queue" {
+				assert.Error(t, handleErr)
+				assert.Zero(t, f.model.calls)
+				assertMemAtomicSQLNoEffects(t, f, before)
+				current, err := repository.NewDirectoryRepository(f.db).Get(f.ctx, cfg.Directory.ID)
+				require.NoError(t, err)
+				assert.Equal(t, persisted.SecurityConfigFingerprint, current.SecurityConfigFingerprint)
+				assert.Equal(t, persisted.BaseDN, current.BaseDN, "TX read must not repair drift by writing configuration")
+			} else {
+				require.NoError(t, handleErr)
+				require.Equal(t, 1, f.model.calls)
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+				var payload types.MemoryExtractPayload
+				require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &payload))
+				complete, err := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payload)
+				require.NoError(t, err)
+				require.True(t, complete)
+			}
+			assert.Equal(t, waits, pool.Stats().WaitCount, "capture/Handle/completion must not deadlock or acquire a second connection from the pool")
+			require.Equal(t, 1, pool.Stats().MaxOpenConnections)
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryConfiguredDirectorySinglePoolActualSQLite(t *testing.T) {
+	runMemConfiguredDirectorySinglePool(t, false)
+}
+func TestPostgresMemoryConfiguredDirectorySinglePoolActual(t *testing.T) {
+	runMemConfiguredDirectorySinglePool(t, true)
+}
