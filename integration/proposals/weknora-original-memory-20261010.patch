+		var origin types.MemoryPolicyOriginal
+		if err = tx.Select("id,tenant_id,revision,policy_digest,digest").Where("tenant_id=? AND revision=?", scope.TenantID, revision).Take(&origin).Error; err != nil {
+			return err
