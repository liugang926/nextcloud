+// A real topic adjudication call and real SDK HTTP error exercise the caller
+// logging sink. Model selection is a component adapter: no original source,
+// actor, SQL or model-lifetime capability is fabricated or claimed here.
+func TestTopicAdjudicationActualHTTPErrorContentPrivacy(t *testing.T) {
+	for _, marked := range []bool{true, false} {
+		name := "ordinary"
+		if marked {
+			name = "protected"
+		}
+		t.Run(name, func(t *testing.T) {
+			const privateBody = "TOPIC_PRIVATE_PROVIDER_BODY"
+			var logs bytes.Buffer
+			log := logrus.New()
+			log.SetOutput(&logs)
+			log.SetLevel(logrus.DebugLevel)
+			joined := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				defer close(joined)
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error("topic provider request read failed")
+					return
+				}
+				if !bytes.Contains(body, []byte("topic-owned-input")) {
+					t.Error("topic input did not reach actual provider")
+				}
+				w.WriteHeader(http.StatusBadRequest)
+				_, _ = io.WriteString(w, privateBody)
+			}))
+			t.Cleanup(server.Close)
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			client := openaicompletions.New(openaicompletions.Config{
+				Endpoint: api.Endpoint{BaseURL: server.URL, Model: "topic-owned-model", Auth: api.NoAuth()},
+				Settings: catalog.DefaultOpenAICompletions(),
+			})
+			model := &topicPrivacyRecordingChat{inner: client}
+			svc := &Service{modelService: &topicPrivacyModelService{model: model}}
+			base := context.WithValue(context.Background(), types.LoggerContextKey, logrus.NewEntry(log))
+			ctx, cancel := context.WithTimeout(base, 8*time.Second)
+			defer cancel()
+			if marked {
+				ctx = logprivacy.SuppressContent(ctx)
+			}
+			resolutions := []topicResolution{{Surface: "topic-owned-input"}}
+			svc.adjudicateTopics(ctx, "topic-owned-model", []*types.MemoryTopicStat{{Topic: "existing-owned-topic"}}, resolutions, []int{0})
+			select {
+			case <-joined:
+			case <-ctx.Done():
+				t.Fatal("actual topic provider did not join")
+			}
+			require.Equal(t, 1, model.calls)
+			var actual *api.HTTPError
+			require.True(t, errors.As(model.returned, &actual), "actual SDK provider error remains an HTTPError")
+			require.Equal(t, http.StatusBadRequest, actual.StatusCode)
+			require.Equal(t, privateBody, actual.Body, "privacy must not rewrite the provider error")
+			require.Equal(t, []topicResolution{{Surface: "topic-owned-input"}}, resolutions, "failed adjudication must retain its unresolved input")
+			if marked {
+				require.Contains(t, logs.String(), "topic adjudication failed (content logging suppressed)")
+				require.NotContains(t, logs.String(), privateBody)
+				require.NotContains(t, logs.String(), "topic-owned-input")
+			} else {
+				require.Contains(t, logs.String(), privateBody)
+				require.Contains(t, logs.String(), "topic-owned-input")
+			}
+		})
+	}
+}
