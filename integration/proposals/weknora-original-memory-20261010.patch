+// ScheduleExtraction itself creates this task and its SQL pending-session
+// entry. The spy only retains the exact task/options for serial delivery to
+// the real Handle with a bare worker context. Corrupt-task cases alone mutate
+// a copy of that actual payload as a negative transport fault; no new admission
+// or authoritative task is invented for it.
+type actualMemoryQueue struct {
+	task    *asynq.Task
+	options []asynq.Option
+}
+
+func (q *actualMemoryQueue) Enqueue(task *asynq.Task, options ...asynq.Option) (*asynq.TaskInfo, error) {
+	if q.task != nil || task.Type() != types.TypeMemoryExtract {
+		return nil, fmt.Errorf("bounded actual memory queue refused another task")
+	}
+	q.task = task
+	q.options = append([]asynq.Option(nil), options...)
+	return &asynq.TaskInfo{ID: uuid.NewString(), Type: task.Type(), Queue: types.QueueMemory}, nil
+}
