+package repository
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"strings"
+)
+
+func validateMemoryGeneratedPromptInTx(tx *gorm.DB, hold *memoryDerivedHold, cluster types.MemoryGeneratedCluster) error {
+	var messages []struct{ Role, Content string }
+	if json.Unmarshal([]byte(cluster.PromptJSON), &messages) != nil || len(messages) != 2 || messages[0].Role != "system" || messages[0].Content != types.MemoryConsolidationOriginalPrompt || messages[1].Role != "user" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var expected strings.Builder
+	for _, id := range cluster.ItemIDs {
+		var proof *types.MemoryDerivedInputProof
+		for index := range hold.Manifest.Inputs {
+			entry := &hold.Manifest.Inputs[index]
+			if entry.ObjectKind == "memory_item" && entry.ObjectID == id {
+				proof = entry
+				break
+			}
+		}
+		if proof == nil || hold.Facts[proof.PublicationID] == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		fact := hold.Facts[proof.PublicationID]
+		var body struct{ MaterialJSON string }
+		if err := tx.Session(&gorm.Session{NewDB: true}).Table("memory_derived_publications").Select("material_json").Where("id=?", fact.ID).Take(&body).Error; err != nil {
+			return err
+		}
+		if types.MemoryOriginalBytesDigest([]byte(body.MaterialJSON)) != fact.MaterialSHA256 {
+			return ErrOriginalBodyUnavailable
+		}
+		if fact.ProducerKind == "authored" || fact.ProducerKind == "control" {
+			var native memoryNativeMaterial
+			if json.Unmarshal([]byte(body.MaterialJSON), &native) != nil {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			body.MaterialJSON = string(native.After)
+		}
+		var item types.MemoryItem
+		if json.Unmarshal([]byte(body.MaterialJSON), &item) != nil || item.ID != id || item.TenantID != hold.Manifest.TenantID || item.SubjectID != hold.Manifest.SubjectID || item.Status != types.MemoryStatusActive {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		digest, err := memoryItemMaterialDigest(&item)
+		if err != nil || digest != proof.MaterialDigest {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		fmt.Fprintf(&expected, "- (%s) %s\n", item.ValidFrom.Format("2006-01-02"), types.SanitizeMemoryContent(item.Content))
+	}
+	if messages[1].Content != expected.String() {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return tx.Statement.Context.Err()
+}
