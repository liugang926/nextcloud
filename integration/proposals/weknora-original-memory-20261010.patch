+ origin_id TEXT NOT NULL,origin_kind TEXT NOT NULL,origin_digest TEXT NOT NULL,body_sha256 TEXT NOT NULL,
+ slot_id TEXT NOT NULL,body_id TEXT NOT NULL,head_revision BIGINT NOT NULL,source_identity_sha256 TEXT NOT NULL,
+ digest TEXT NOT NULL,created_at TIMESTAMPTZ NOT NULL,PRIMARY KEY(origin_kind,origin_id));
+CREATE TRIGGER memory_generated_originals_immutable BEFORE UPDATE OR DELETE ON memory_generated_originals FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
+CREATE TRIGGER memory_generated_receipts_immutable BEFORE UPDATE OR DELETE ON memory_generated_receipts FOR EACH ROW EXECUTE FUNCTION memory_original_admission_immutable();
