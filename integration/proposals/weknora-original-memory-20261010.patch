+
+func runMemoryDerivedPartialSQL(t *testing.T, pg bool) {
+	f := newMemAtomicSQLFixture(t, pg)
+	model := attachMemDerivedSQLTransport(f)
+	model.partial = true
+	// Actual message producers receive these fixture-authored event timestamps;
+	// no original/pending cursor or body is edited after its production.
+	start := f.user.CreatedAt
+	var last *types.Message
+	for index := 1; index < 7; index++ {
+		user, err := f.messages.CreateMessage(f.ctx, &types.Message{SessionID: f.session.ID, RequestID: uuid.NewString(), Role: "user", Content: actualMemoryAuthoredText, IsCompleted: true, CreatedAt: start.Add(time.Duration(index) * 90 * time.Minute)})
+		require.NoError(t, err)
+		require.NotEmpty(t, user.ID)
+		last = user
+	}
+	assistant := completeMemDerivedTimestampedTurn(t, f, last, start.Add(6*90*time.Minute+time.Minute))
+	require.True(t, assistant.CreatedAt.After(last.CreatedAt))
+	f.assistant = assistant
+	f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, model.GetModelID())
+	relayMemAtomicSQLScheduled(t, f)
+	originalTask := f.queue.task
+	payload := append([]byte(nil), originalTask.Payload()...)
+	first := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	var original types.MemoryOriginalAdmission
+	require.NoError(t, f.db.Where("id=?", first.OriginalAdmissionID).Take(&original).Error)
+	require.NoError(t, handleMemDerivedSQL(t, f))
+	partial := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	require.True(t, partial.Pending)
+	require.True(t, partial.Cursor.After(first.Cursor))
+	require.Equal(t, 3, model.actualCalls)
+	require.EqualValues(t, 3, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+	require.Positive(t, memAtomicSQLCount(t, f, "memory_items"))
+	for attempt := 0; attempt < 3 && actualMemoryProgress(t, f.db, f.scope, f.session.ID).Pending; attempt++ {
+		f.queue.task = originalTask
+		require.NoError(t, handleMemDerivedSQL(t, f))
+		require.Equal(t, payload, originalTask.Payload())
+	}
+	final := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+	require.False(t, final.Pending)
+	require.Equal(t, first.Revision, final.Revision)
+	require.Equal(t, first.OriginalAdmissionID, final.OriginalAdmissionID)
+	var kept types.MemoryOriginalAdmission
+	require.NoError(t, f.db.Where("id=?", original.ID).Take(&kept).Error)
+	require.Equal(t, original, kept)
+	calls := model.actualCalls
+	require.NoError(t, handleMemDerivedSQL(t, f))
+	require.Equal(t, calls, model.actualCalls, "completed replay is receipt-only")
+	require.Contains(t, model.prompts[1], "segment 1")
+	assertMemAtomicSQLLeasesClosed(t, f)
+}
+func TestMemoryDerivedOriginalPartialActualSQLite(t *testing.T) { runMemoryDerivedPartialSQL(t, false) }
+func TestPostgresMemoryDerivedOriginalPartialActual(t *testing.T) {
+	runMemoryDerivedPartialSQL(t, true)
+}
+
+func completeMemDerivedTimestampedTurn(t *testing.T, f *memAtomicSQLFixture, user *types.Message, at time.Time) *types.Message {
+	t.Helper()
+	assistant, err := f.messages.CreateMessage(f.ctx, &types.Message{SessionID: f.session.ID, RequestID: user.RequestID, Role: "assistant", CreatedAt: at})
+	require.NoError(t, err)
+	writer := WithMessageMaterialOutputBoundary(f.ctx)
+	defer CloseMessageMaterialOutputBoundary(writer)
+	writer = context.WithValue(writer, agentHistoryCurrentRequestKey{}, user.RequestID)
+	writer = types.WithRAGSourceLineage(writer, types.NewRAGSourceLineage(func(ctx context.Context, source *types.SourceLineage) error {
+		return f.messages.sourceLineageGuard.Check(ctx, source, access.LineageReadScope{})
+	}))
+	actual, err := f.messages.GetMessage(writer, f.session.ID, user.ID)
+	require.NoError(t, err)
+	require.Equal(t, user.Content, actual.Content)
+	require.NoError(t, f.messages.bindInitialMessageMaterial(writer, assistant.ID, user.ID, user.RequestID))
+	provider := &enrichmentTestModel{response: "The ordinary input was received."}
+	require.NoError(t, CheckMessageMaterialOutputBoundary(writer))
+	response, err := provider.Chat(writer, []chat.Message{{Role: "user", Content: actual.Content, SourceLineage: actual.SourceLineage}}, &chat.ChatOptions{})
+	require.NoError(t, err)
+	require.Equal(t, 1, provider.calls)
+	require.NoError(t, CheckMessageMaterialOutputBoundary(writer))
+	assistant.Content = response.Content
+	assistant.IsCompleted = true
+	assistant.SourceLineage, err = types.UnionSourceLineage(actual.SourceLineage)
+	require.NoError(t, err)
+	require.NoError(t, f.messages.UpdateMessage(writer, assistant))
+	return assistant
+}
