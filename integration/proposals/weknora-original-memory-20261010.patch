+		own, _ := tx.Statement.Context.Value(memoryDerivedOwnPublicationsKey{}).(map[string]bool)
+		hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		if pub.CommitID != commitID && !own[pub.ID] && (hold == nil || hold.Facts[pub.ID] == nil) {
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		proof, _, err := memoryDerivedProofInTx(tx, pub)
+		if err != nil {
+			return nil, err
+		}
+		block.Inputs = append(block.Inputs, proof)
+		var item types.MemoryItem
+		if err = tx.Session(&gorm.Session{NewDB: true}).Where("id=?", id.ID).Take(&item).Error; err != nil {
+			return nil, err
+		}
+		block.ItemCount++
+		if types.IsResidentMemoryKind(item.Kind) && (item.ExpiresAt == nil || item.ExpiresAt.After(time.Now())) {
+			resident = append(resident, &item)
+		}
+	}
+	sort.SliceStable(resident, func(i, j int) bool {
+		if resident[i].Importance != resident[j].Importance {
+			return resident[i].Importance > resident[j].Importance
+		}
+		if !resident[i].ValidFrom.Equal(resident[j].ValidFrom) {
+			return resident[i].ValidFrom.After(resident[j].ValidFrom)
+		}
+		return resident[i].ID < resident[j].ID
+	})
+	if len(resident) > 60 {
+		resident = resident[:60]
+	}
+	block.BlockText = types.RenderMemoryBlock(resident)
+	if subject.BlockText != block.BlockText || subject.ItemCount != block.ItemCount {
+		if err := tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemorySubject{}).Where("id=?", subject.ID).Updates(map[string]interface{}{"block_text": block.BlockText, "item_count": block.ItemCount, "block_updated_at": memoryFactTime(), "updated_at": memoryFactTime()}).Error; err != nil {
+			return nil, err
+		}
+	}
+	return block, nil
+}
+func (r *memoryOriginalAdmissionRepository) publishMemoryWorkerBlockInTx(tx *gorm.DB, input *types.MemoryOriginalInput, commit *types.MemoryOriginalCommit, scope interfaces.MemoryScope) (*types.MemoryOriginalDerivation, error) {
+	block, err := memoryDerivedBlockInTx(tx, scope, commit.ID)
+	if err != nil {
+		return nil, err
+	}
+	control, err := memoryDerivedControlInTx(tx, scope, "memory_block", block.ID)
+	if err == gorm.ErrRecordNotFound {
+		// An empty no-op result leaves the initial empty cache unobserved. The
+		// receipt still records its complete empty operation manifest.
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var count int64
+	if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryDerivedPublication{}).Where("tenant_id=? AND subject_id=? AND object_kind='memory_block' AND object_id=? AND revision=?", scope.TenantID, scope.SubjectID, block.ID, control.Revision).Count(&count).Error; err != nil {
+		return nil, err
+	}
+	if count != 0 {
+		return nil, nil
+	}
+	parent := ""
+	if hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold); hold != nil {
+		for _, proof := range hold.Manifest.Inputs {
+			if proof.ObjectKind == "memory_block" && proof.ObjectID == block.ID {
+				parent = proof.DerivationID
+			}
+		}
+	}
+	return memoryOriginalCreateEffectInTx(tx, input, commit, uuid.NewString(), "render", "memory_block", block.ID, parent, "resident_block", block, nil)
+}
+func (r *memoryOriginalAdmissionRepository) publishMemoryNativeBlockInTx(tx *gorm.DB, scope interfaces.MemoryScope, request memoryNativeRequest, selector string, hold *memoryDerivedHold) error {
+	block, err := memoryDerivedBlockInTx(tx, scope, "native")
+	if err != nil {
+		return err
+	}
+	control, err := memoryDerivedControlInTx(tx, scope, "memory_block", block.ID)
+	if err == gorm.ErrRecordNotFound {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var count int64
+	if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryDerivedPublication{}).Where("tenant_id=? AND subject_id=? AND object_kind='memory_block' AND object_id=? AND revision=?", scope.TenantID, scope.SubjectID, block.ID, control.Revision).Count(&count).Error; err != nil {
+		return err
+	}
+	if count != 0 {
+		return nil
+	}
+	after, err := json.Marshal(block)
+	if err != nil {
+		return err
+	}
+	body, err := json.Marshal(memoryNativeMaterial{Request: request, After: after})
+	if err != nil {
+		return err
+	}
+	material, err := KnowledgeInputDigest(block)
+	if err != nil {
+		return err
+	}
+	ids := []string{}
+	parent := ""
+	for _, proof := range hold.Manifest.Inputs {
+		ids = append(ids, proof.PublicationID)
+		if proof.ObjectKind == "memory_block" && proof.ObjectID == block.ID {
+			parent = proof.PublicationID
+		}
+	}
+	for _, proof := range block.Inputs {
+		ids = append(ids, proof.PublicationID)
+	}
+	inputs, err := json.Marshal(ids)
+	if err != nil {
+		return err
+	}
+	fact := &types.MemoryDerivedPublication{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, ObjectKind: "memory_block", ObjectID: block.ID, Revision: control.Revision, Present: true, ProducerKind: "control", ParentPublicationID: parent, InputsJSON: string(inputs), AuthorSelector: selector, MaterialJSON: string(body), MaterialSHA256: types.MemoryOriginalBytesDigest(body), MaterialDigest: material, CreatedAt: memoryFactTime()}
+	return createMemoryDerivedPublicationInTx(tx, fact)
+}
diff --git a/internal/application/repository/memory_derived_fence.go b/internal/application/repository/memory_derived_fence.go
new file mode 100644
index 00000000..bc437dcf
--- /dev/null
+++ b/internal/application/repository/memory_derived_fence.go
@@ -0,0 +1,168 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// Discover the entire graph first. Organization/epoch/resource locks may not
+// be acquired one ancestor at a time after the consumer's epoch is held.
+func (r *memoryOriginalAdmissionRepository) lockMemoryDerivedAuthorityInTx(ctx context.Context, tx *gorm.DB, hold *memoryDerivedHold, extra *types.MemoryOriginalInput) error {
+	inputs := []*memoryOriginalFenceView{}
+	for _, input := range hold.Originals {
+		inputs = append(inputs, memoryOriginalFence(input))
+	}
+	if extra != nil {
+		inputs = append(inputs, memoryOriginalFence(extra))
+	}
+	for _, source := range hold.NativeSources {
+		inputs = append(inputs, memoryNativeSourceFence(source, hold.Manifest.TenantID, hold.Manifest.SubjectID))
+	}
+	if hold.NativeSource != nil {
+		inputs = append(inputs, memoryNativeSourceFence(hold.NativeSource, hold.Manifest.TenantID, hold.Manifest.SubjectID))
+	}
+	sort.Slice(inputs, func(i, j int) bool { return inputs[i].Plan.MetadataDigest < inputs[j].Plan.MetadataDigest })
+	tenants := map[uint64]bool{}
+	agents := map[memoryOriginalAgentKey]bool{}
+	users := map[string]bool{}
+	keys := map[uint64]bool{}
+	for _, input := range inputs {
+		authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+		if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err := authority.CheckRuntime(ctx); err != nil {
+			return err
+		}
+		if input.Actor.UserID != "" {
+			users[input.Actor.UserID] = true
+		}
+		if input.Actor.APIKeyID != nil {
+			keys[*input.Actor.APIKeyID] = true
+		}
+		ids, resources, err := memorySharedReadAuthorityControls(tx, input)
+		if err != nil {
+			return err
+		}
+		for _, id := range ids {
+			tenants[id] = true
+		}
+		for _, key := range resources {
+			agents[key] = true
+		}
+	}
+	for _, fact := range hold.Facts {
+		if fact.ProducerKind == "worker" || fact.ProducerKind == "generated" {
+			continue
+		}
+		var author memoryNativeAuthor
+		if err := decodeMemoryNativeAuthor(fact, &author); err != nil {
+			return err
+		}
+		tenants[author.Actor.CallerTenantID] = true
+		if author.Actor.UserID != "" {
+			users[author.Actor.UserID] = true
+		}
+		if author.Actor.APIKeyID != nil {
+			keys[*author.Actor.APIKeyID] = true
+		}
+	}
+	for _, original := range hold.Generations {
+		var actor types.MemoryOriginalActor
+		if json.Unmarshal([]byte(original.ActorSelector), &actor) != nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		tenants[actor.CallerTenantID] = true
+		if actor.UserID != "" {
+			users[actor.UserID] = true
+		}
+		if actor.APIKeyID != nil {
+			keys[*actor.APIKeyID] = true
+		}
+	}
+	share := clause.Locking{Strength: "SHARE"}
+	tenantIDs := []uint64{}
+	for id := range tenants {
+		tenantIDs = append(tenantIDs, id)
+	}
+	sort.Slice(tenantIDs, func(i, j int) bool { return tenantIDs[i] < tenantIDs[j] })
+	for _, id := range tenantIDs {
+		var tenant types.Tenant
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(share).Where("id=?", id).Take(&tenant).Error; err != nil {
+			return err
+		}
+	}
+	userIDs := []string{}
+	for id := range users {
+		userIDs = append(userIDs, id)
+	}
+	sort.Strings(userIDs)
+	directoryIDs := map[string]bool{}
+	for _, id := range userIDs {
+		var user types.User
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(share).Where("id=? AND is_active=?", id, true).Take(&user).Error; err != nil {
+			return err
+		}
+		var members []types.TenantMember
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(share).Where("user_id=? AND tenant_id IN ?", id, tenantIDs).Order("tenant_id,id").Find(&members).Error; err != nil {
+			return err
+		}
+		var identities []types.DirectoryIdentity
+		if err := tx.Session(&gorm.Session{NewDB: true}).Where("user_id=?", id).Find(&identities).Error; err != nil {
+			return err
+		}
+		for _, identity := range identities {
+			directoryIDs[identity.DirectoryID] = true
+		}
+	}
+	dirs := []string{}
+	for id := range directoryIDs {
+		dirs = append(dirs, id)
+	}
+	sort.Strings(dirs)
+	for _, id := range dirs {
+		var directory types.Directory
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(share).Where("id=?", id).Take(&directory).Error; err != nil {
+			return err
+		}
+	}
+	keyIDs := []uint64{}
+	for id := range keys {
+		keyIDs = append(keyIDs, id)
+	}
+	sort.Slice(keyIDs, func(i, j int) bool { return keyIDs[i] < keyIDs[j] })
+	for _, id := range keyIDs {
+		var key types.TenantAPIKey
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(share).Where("id=?", id).Take(&key).Error; err != nil {
+			return err
+		}
+	}
+	if err := lockSharedAuthorityOrganizationsForMemory(tx, tenantIDs); err != nil {
+		return err
+	}
+	for _, id := range tenantIDs {
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.OnConflict{DoNothing: true}).Create(&types.PermissionVersion{TenantID: id, Version: 0}).Error; err != nil {
+			return err
+		}
+		var version types.PermissionVersion
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(share).Where("tenant_id=?", id).Take(&version).Error; err != nil {
+			return err
+		}
+	}
+	resources := []memoryOriginalAgentKey{}
+	for key := range agents {
+		resources = append(resources, key)
+	}
+	sort.Slice(resources, func(i, j int) bool {
+		if resources[i].TenantID == resources[j].TenantID {
+			return resources[i].ID < resources[j].ID
+		}
+		return resources[i].TenantID < resources[j].TenantID
+	})
+	return lockMemoryOriginalAgentRows(tx, resources)
+}
diff --git a/internal/application/repository/memory_derived_models.go b/internal/application/repository/memory_derived_models.go
new file mode 100644
index 00000000..0423b690
--- /dev/null
+++ b/internal/application/repository/memory_derived_models.go
@@ -0,0 +1,23 @@
+package repository
+
+import (
+	"context"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// The model-original slice supplies this real historical reader. It returns
+// neither a runnable model nor a hydrated old credential. A current provider
+// reader cannot substitute for it when a definition has a legal successor.
+type MemoryDerivedHistoricalModelAuthority struct {
+	Begin func(context.Context, *types.MemoryOriginalExecution) (interfaces.MemoryDerivedExecutionRead, error)
+	Check func(context.Context, *gorm.DB, *types.MemoryOriginalExecution) error
+}
+
+func ConfigureMemoryDerivedHistoricalModels(repo interfaces.MemoryOriginalAdmissionRepository, authority *MemoryDerivedHistoricalModelAuthority) {
+	if actual, ok := repo.(*memoryOriginalAdmissionRepository); ok {
+		actual.historicalModels = authority
+	}
+}
diff --git a/internal/application/repository/memory_derived_native.go b/internal/application/repository/memory_derived_native.go
new file mode 100644
index 00000000..41eaa2f8
--- /dev/null
+++ b/internal/application/repository/memory_derived_native.go
@@ -0,0 +1,255 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryNativeRequestKey struct{}
+type memoryNativeOwnedKey struct{}
+type memoryNativeRequest struct {
+	Operation string
+	Arguments json.RawMessage
+	Error     error `json:"-"`
+}
+type memoryNativeAuthor struct {
+	Actor  types.MemoryOriginalActor
+	Policy types.MemoryPolicyProof
+	Source *types.MemoryDerivedNativeSource
+}
+type memoryNativeMaterial struct {
+	Request memoryNativeRequest
+	After   json.RawMessage
+}
+
+// Called only by the actual native repository entry point, with its real
+// arguments. It does not promote an item loaded from storage into human input.
+func memoryNativeRequestContext(ctx context.Context, operation string, arguments ...interface{}) context.Context {
+	bytes, err := json.Marshal(arguments)
+	return context.WithValue(ctx, memoryNativeRequestKey{}, memoryNativeRequest{Operation: operation, Arguments: bytes, Error: err})
+}
+func (r *memoryRepository) BindMemoryDerivedAuthority(admissions interfaces.MemoryOriginalAdmissionRepository) {
+	r.derived, _ = admissions.(*memoryOriginalAdmissionRepository)
+}
+func (r *memoryRepository) prepareMemoryNativeWrite(ctx context.Context, scope interfaces.MemoryScope) (context.Context, interfaces.MemoryDerivedRead, error) {
+	if _, ok := ctx.Value(memoryNativeOwnedKey{}).(bool); ok {
+		hold, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		if hold == nil || hold.Manifest.TenantID != scope.TenantID || hold.Manifest.SubjectID != scope.SubjectID {
+			return ctx, nil, types.ErrMemoryOriginalUnavailable
+		}
+		return ctx, nil, nil
+	}
+	request, ok := ctx.Value(memoryNativeRequestKey{}).(memoryNativeRequest)
+	if !ok || !r.db.Migrator().HasTable(&types.MemoryDerivedControl{}) {
+		return ctx, nil, nil
+	}
+	if request.Error != nil {
+		return ctx, nil, request.Error
+	}
+	if r.derived == nil {
+		return ctx, nil, types.ErrMemoryOriginalUnavailable
+	}
+	read, err := r.derived.BeginMemoryDerivedRead(ctx, scope)
+	if err != nil {
+		return ctx, nil, err
+	}
+	var proof types.MemoryPolicyProof
+	err = r.derived.db.WithContext(read.Context()).Transaction(func(tx *gorm.DB) error {
+		revision, err := memoryPolicyRevision(tx, scope.TenantID)
+		if err != nil {
+			return err
+		}
+		var origin types.MemoryPolicyOriginal
+		if err = tx.Select("id,tenant_id,revision,policy_digest,digest").Where("tenant_id=? AND revision=?", scope.TenantID, revision).Take(&origin).Error; err != nil {
+			return err
+		}
+		proof, err = memoryPolicyProofInTx(tx, &origin)
+		return err
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		read.Close()
+		return ctx, nil, err
+	}
+	policy, err := beginMemoryPolicyOriginalRead(read.Context(), r.db, scope.TenantID, proof)
+	if err != nil {
+		read.Close()
+		return ctx, nil, err
+	}
+	actual := read.(*memoryDerivedRead)
+	actual.policies = append(actual.policies, policy)
+	hold, ok := policy.Context().Value(memoryPolicyHoldKey{}).(memoryPolicyHold)
+	if !ok {
+		read.Close()
+		return ctx, nil, ErrOriginalBodyUnavailable
+	}
+	actual.hold.Policies["native-author"] = hold
+	if err = r.derived.captureMemoryNativeSource(actual, request, scope); err != nil {
+		read.Close()
+		return ctx, nil, err
+	}
+	return context.WithValue(read.Context(), memoryNativeOwnedKey{}, true), read, nil
+}
+func decodeMemoryNativeAuthor(fact *types.MemoryDerivedPublication, author *memoryNativeAuthor) error {
+	if json.Unmarshal([]byte(fact.AuthorSelector), author) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+func verifyMemoryDerivedNativeInTx(tx *gorm.DB, fact *types.MemoryDerivedPublication, hold *memoryDerivedHold) error {
+	var author memoryNativeAuthor
+	if json.Unmarshal([]byte(fact.AuthorSelector), &author) != nil || author.Actor.CallerTenantID != fact.TenantID || author.Actor.Principal.StorageID() != fact.SubjectID || !author.Policy.Valid() || fact.DerivationID != "" || fact.CommitID != "" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if author.Source != nil {
+		if err := validateMemoryNativeSource(author.Source, fact.TenantID, fact.SubjectID); err != nil {
+			return err
+		}
+		hold.NativeSources[fact.ID] = author.Source
+	}
+	return nil
+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryNativeAuthorInTx(tx *gorm.DB, fact *types.MemoryDerivedPublication) error {
+	var author memoryNativeAuthor
+	if json.Unmarshal([]byte(fact.AuthorSelector), &author) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err := authority.CheckRuntime(tx.Statement.Context); err != nil {
+		return err
+	}
+	fresh, err := authority.Store.RestoreMemoryOriginalActor(tx.Statement.Context, author.Actor, fact.TenantID, fact.SubjectID)
+	if err != nil {
+		return err
+	}
+	return lockMemoryPolicyAuthor(tx.Session(&gorm.Session{NewDB: true}).WithContext(fresh), fresh, fact.TenantID)
+}
+func memoryNativeObjectInTx(tx *gorm.DB, control *types.MemoryDerivedControl) (interface{}, error) {
+	if !control.Present {
+		return struct{ ObjectKind, ObjectID string }{control.ObjectKind, control.ObjectID}, nil
+	}
+	local := tx.Session(&gorm.Session{NewDB: true}).Where("id=? AND tenant_id=? AND subject_id=?", control.ObjectID, control.TenantID, control.SubjectID)
+	switch control.ObjectKind {
+	case "memory_item":
+		var row types.MemoryItem
+		err := local.Take(&row).Error
+		return &row, err
+	case "memory_topic":
+		var row types.MemoryTopicStat
+		err := local.Take(&row).Error
+		return &row, err
+	case "memory_block":
+		var row types.MemorySubject
+		err := local.Take(&row).Error
+		return &types.MemoryDerivedBlock{ID: row.ID, TenantID: row.TenantID, SubjectID: row.SubjectID, BlockText: row.BlockText, ItemCount: row.ItemCount}, err
+	case "memory_tombstone":
+		var row types.MemoryTombstone
+		err := local.Take(&row).Error
+		return &row, err
+	}
+	return nil, types.ErrMemoryOriginalUnavailable
+}
+func (r *memoryRepository) publishMemoryNativeWriteInTx(tx *gorm.DB, scope interfaces.MemoryScope) error {
+	request, ok := tx.Statement.Context.Value(memoryNativeRequestKey{}).(memoryNativeRequest)
+	if !ok {
+		return nil
+	}
+	hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if hold == nil {
+		return nil
+	}
+	if r.derived == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	authority := r.derived.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	actor, err := authority.Store.CaptureMemoryOriginalActor(tx.Statement.Context)
+	if err != nil {
+		return err
+	}
+	fresh, err := authority.Store.RestoreMemoryOriginalActor(tx.Statement.Context, *actor, scope.TenantID, scope.SubjectID)
+	if err != nil {
+		return err
+	}
+	if err = authority.CheckRuntime(fresh); err != nil {
+		return err
+	}
+	if err = lockMemoryPolicyAuthor(tx.Session(&gorm.Session{NewDB: true}), fresh, scope.TenantID); err != nil {
+		return err
+	}
+	var tenant types.Tenant
+	if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", scope.TenantID).Take(&tenant).Error; err != nil {
+		return err
+	}
+	_, policy, err := readMemoryPolicyOriginalInTx(tx, &tenant)
+	if err != nil {
+		return err
+	}
+	selector, err := json.Marshal(memoryNativeAuthor{Actor: *actor, Policy: policy.Proof(), Source: hold.NativeSource})
+	if err != nil {
+		return err
+	}
+	before := map[string]types.MemoryDerivedInputProof{}
+	inputs := []string{}
+	for _, proof := range hold.Manifest.Inputs {
+		before[proof.ObjectKind+"/"+proof.ObjectID] = proof
+		inputs = append(inputs, proof.PublicationID)
+	}
+	inputJSON, err := json.Marshal(inputs)
+	if err != nil {
+		return err
+	}
+	var controls []types.MemoryDerivedControl
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Order("object_kind,object_id").Find(&controls).Error; err != nil {
+		return err
+	}
+	for _, control := range controls {
+		old := before[control.ObjectKind+"/"+control.ObjectID]
+		if old.PublicationID != "" && old.Revision == control.Revision {
+			continue
+		}
+		if control.ObjectKind == "memory_block" {
+			continue
+		}
+		// Tombstones of objects absent before this write do not become fabricated
+		// effects of a later unrelated operation.
+		if !control.Present && old.PublicationID == "" {
+			continue
+		}
+		object, err := memoryNativeObjectInTx(tx, &control)
+		if err != nil {
+			return err
+		}
+		material, err := memoryDerivedObjectDigest(object)
+		if err != nil {
+			return err
+		}
+		after, err := json.Marshal(object)
+		if err != nil {
+			return err
+		}
+		body, err := json.Marshal(memoryNativeMaterial{Request: request, After: after})
+		if err != nil {
+			return err
+		}
+		producer := "authored"
+		if request.Operation == "TouchUsed" || request.Operation == "ExpireOverdue" || request.Operation == "ArchiveLowestRanked" {
+			producer = "control"
+		}
+		fact := &types.MemoryDerivedPublication{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, ObjectKind: control.ObjectKind, ObjectID: control.ObjectID, Revision: control.Revision, Present: control.Present, ProducerKind: producer, ParentPublicationID: old.PublicationID, InputsJSON: string(inputJSON), AuthorSelector: string(selector), MaterialJSON: string(body), MaterialSHA256: types.MemoryOriginalBytesDigest(body), MaterialDigest: material, CreatedAt: memoryFactTime()}
+		if err = createMemoryDerivedPublicationInTx(tx, fact); err != nil {
+			return err
+		}
+	}
+	return r.derived.publishMemoryNativeBlockInTx(tx, scope, request, string(selector), hold)
+}
diff --git a/internal/application/repository/memory_derived_native_source.go b/internal/application/repository/memory_derived_native_source.go
new file mode 100644
index 00000000..aa3a498c
--- /dev/null
+++ b/internal/application/repository/memory_derived_native_source.go
@@ -0,0 +1,147 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+func memoryNativeSourceFence(source *types.MemoryDerivedNativeSource, tenant uint64, subject string) *memoryOriginalFenceView {
+	return &memoryOriginalFenceView{TenantID: tenant, SubjectID: subject, Actor: source.Actor, Plan: source.Plan, Material: source.Material}
+}
+func validateMemoryNativeSource(source *types.MemoryDerivedNativeSource, tenant uint64, subject string) error {
+	if source == nil || source.Plan == nil || source.Material == nil || len(source.Material.Messages) != 0 || source.Actor.CallerTenantID != tenant || source.Actor.Principal.StorageID() != subject || source.Plan.SourceLineage.RequireComplete() != nil || source.Material.MetadataDigest != source.Plan.MetadataDigest || !faqInputEqual(source.Material.Request, source.Plan.Request) || len(source.Material.Proofs) != len(source.Plan.Request.MessageIDs) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryNativeSourceInTx(tx *gorm.DB, ctx context.Context, source *types.MemoryDerivedNativeSource, scope interfaces.MemoryScope) error {
+	if err := validateMemoryNativeSource(source, scope.TenantID, scope.SubjectID); err != nil {
+		return err
+	}
+	frame := memoryNativeSourceFence(source, scope.TenantID, scope.SubjectID)
+	authority := r.authorityFactory(tx.Session(&gorm.Session{NewDB: true}))
+	if authority == nil || authority.Store == nil || authority.CheckRuntime == nil || authority.Store.db.Statement.ConnPool != tx.Statement.ConnPool {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err := authority.CheckRuntime(ctx); err != nil {
+		return err
+	}
+	if err := lockMemoryReadFence(ctx, tx.Session(&gorm.Session{NewDB: true}).WithContext(ctx), frame); err != nil {
+		return err
+	}
+	return r.checkMemoryReadMaterialInTx(ctx, tx.Session(&gorm.Session{NewDB: true}).WithContext(ctx), frame)
+}
+func (r *memoryOriginalAdmissionRepository) captureMemoryNativeSource(read *memoryDerivedRead, request memoryNativeRequest, scope interfaces.MemoryScope) error {
+	// Generated native topics and extracted items need their real model-result
+	// producer protocol. They cannot be minted as a human full replacement.
+	if request.Operation == "BumpTopic" || request.Operation == "MarkTopicPromoted" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if request.Operation != "SaveItem" && request.Operation != "CreateItem" {
+		return nil
+	}
+	var args []json.RawMessage
+	if json.Unmarshal(request.Arguments, &args) != nil || len(args) == 0 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var item types.MemoryItem
+	if json.Unmarshal(args[0], &item) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if item.Origin == types.MemoryOriginExtracted {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if item.SourceMessageID == "" {
+		return nil
+	}
+	if item.SourceSessionID == "" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	actor, err := r.material.CaptureMemoryOriginalActor(read.ctx)
+	if err != nil {
+		return err
+	}
+	fresh, err := r.material.RestoreMemoryOriginalActor(read.ctx, *actor, scope.TenantID, scope.SubjectID)
+	if err != nil {
+		return err
+	}
+	req := types.MessageMaterialReadRequest{TenantID: scope.TenantID, SessionID: item.SourceSessionID, MessageIDs: []string{item.SourceMessageID}}
+	plan, err := r.material.PeekMessageMaterialReadPlan(fresh, req)
+	if err != nil {
+		return err
+	}
+	marked, err := WithMessageMaterialReadPlan(fresh, plan)
+	if err != nil {
+		return err
+	}
+	existing := []string{}
+	for _, lease := range read.hold.Leases {
+		existing = append(existing, lease.LeaseID)
+	}
+	ids, err := r.material.AcquireMessageBodyReadLeases(marked, plan, "memory-native-source/"+uuid.NewString(), 15*time.Minute, existing)
+	if err != nil {
+		return err
+	}
+	// Add actual returned leases immediately so every subsequent failure owns
+	// cleanup. Never fabricate a body lease from a publication digest.
+	var leases []originalBodyLease
+	if err = bodyInternal(r.db.WithContext(read.ctx)).Where("lease_id IN ?", ids).Find(&leases).Error; err != nil {
+		cleanup, cancel := context.WithTimeout(context.WithoutCancel(read.ctx), 5*time.Second)
+		defer cancel()
+		for _, id := range ids {
+			NewOriginalBodyRetentionStore(r.db).ReleaseLease(cleanup, id)
+		}
+		return err
+	}
+	if len(leases) != len(ids) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, lease := range leases {
+		read.hold.Leases[lease.BodyID] = lease
+	}
+	heads, err := memoryExpectedBodyHeads(r.db.WithContext(read.ctx), plan, map[*types.MessageMaterialReadPlan]bool{})
+	if err != nil {
+		return err
+	}
+	for _, head := range heads {
+		read.hold.Heads[head.SlotID] = head
+	}
+	marked = memoryDerivedSourceContext(marked, read.hold)
+	material, err := r.material.CaptureMessageMaterialInputs(marked, req)
+	if err != nil {
+		return err
+	}
+	matched := false
+	for _, message := range material.Messages {
+		if message.ID == item.SourceMessageID && message.Role == "user" {
+			original := types.NormalizeMemoryForMatch(message.Content)
+			content := types.NormalizeMemoryForMatch(item.Content)
+			if item.Origin != types.MemoryOriginExplicit || content != "" && strings.Contains(original, content) {
+				matched = true
+			}
+		}
+	}
+	if !matched {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	material.Messages = nil
+	source := &types.MemoryDerivedNativeSource{Actor: *actor, Plan: plan, Material: material}
+	if err = validateMemoryNativeSource(source, scope.TenantID, scope.SubjectID); err != nil {
+		return err
+	}
+	read.hold.NativeSource = source
+	err = r.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := r.lockMemoryDerivedAuthorityInTx(marked, tx, read.hold, nil); err != nil {
+			return err
+		}
+		return r.checkMemoryNativeSourceInTx(tx, marked, source, scope)
+	}, memoryWriteOptions(r.db))
+	return err
+}
diff --git a/internal/application/repository/memory_derived_publication.go b/internal/application/repository/memory_derived_publication.go
new file mode 100644
index 00000000..3b00cb2e
--- /dev/null
+++ b/internal/application/repository/memory_derived_publication.go
@@ -0,0 +1,201 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryDerivedOwnPublicationsKey struct{}
+type memoryDerivedProducerKey struct{}
+type memoryDerivedProducerBoundary struct {
+	ID             string
+	Tenant         uint64
+	MaterialSHA256 string
+}
+
+const memoryDerivedPublicationFields = "id,tenant_id,subject_id,object_kind,object_id,revision,producer_kind,derivation_id,input_admission_id,execution_admission_id,commit_id,parent_publication_id,inputs_json,author_selector,material_sha256,material_digest,present,digest,created_at"
+
+func memoryDerivedPublicationDigest(fact *types.MemoryDerivedPublication) (string, error) {
+	copy := *fact
+	copy.Digest = ""
+	copy.MaterialJSON = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryDerivedBodyReceiptDigest(fact *types.MemoryDerivedBodyReceipt) (string, error) {
+	copy := *fact
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryDerivedManifestDigest(fact types.MemoryDerivedManifest) (string, error) {
+	fact.Digest = ""
+	return KnowledgeInputDigest(fact)
+}
+func memoryDerivedControlInTx(tx *gorm.DB, scope interfaces.MemoryScope, kind, id string) (*types.MemoryDerivedControl, error) {
+	var control types.MemoryDerivedControl
+	if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND subject_id=? AND object_kind=? AND object_id=?", scope.TenantID, scope.SubjectID, kind, id).Take(&control).Error; err != nil {
+		return nil, err
+	}
+	if control.Revision == 0 {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &control, nil
+}
+func loadMemoryDerivedPublication(tx *gorm.DB, id string) (*types.MemoryDerivedPublication, error) {
+	if id == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var fact types.MemoryDerivedPublication
+	if err := tx.Session(&gorm.Session{NewDB: true}).Select(memoryDerivedPublicationFields).Where("id=?", id).Take(&fact).Error; err != nil {
+		return nil, err
+	}
+	digest, err := memoryDerivedPublicationDigest(&fact)
+	if err != nil || digest != fact.Digest || fact.Revision == 0 || fact.MaterialSHA256 == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &fact, nil
+}
+func memoryDerivedCapturedHeadInTx(tx *gorm.DB, fact *types.MemoryDerivedPublication) (originalBodyFieldHead, error) {
+	if !originalBodySchemaPresent(tx) {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	var heads []originalBodyFieldHead
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("source_table='memory_derived_publications' AND row_key=?", fact.ID).Find(&heads).Error; err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	if len(heads) != 1 {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	head := heads[0]
+	ref, ok := bodyReference(head.OriginalBodyRef)
+	if !ok || head.ColumnName != "material_json" || head.OwnerKind != "memory_derived_publications" || head.OwnerID != fact.ID || head.TenantID != fact.TenantID || head.KnowledgeBaseID != "" || head.KnowledgeID != "" || ref.SHA256 != fact.MaterialSHA256 || ref.SlotID != head.SlotID || ref.BodyID != head.BodyID {
+		return head, ErrOriginalBodyUnavailable
+	}
+	if err := checkOriginalBodyAvailableForHeads(tx.Statement.Context, tx, "memory_derived_publications", fact.ID, heads); err != nil {
+		return head, err
+	}
+	return head, tx.Statement.Context.Err()
+}
+func memoryDerivedProofInTx(tx *gorm.DB, fact *types.MemoryDerivedPublication) (types.MemoryDerivedInputProof, originalBodyFieldHead, error) {
+	head, err := memoryDerivedCapturedHeadInTx(tx, fact)
+	if err != nil {
+		return types.MemoryDerivedInputProof{}, head, err
+	}
+	var receipt types.MemoryDerivedBodyReceipt
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("publication_id=?", fact.ID).Take(&receipt).Error; err != nil {
+		return types.MemoryDerivedInputProof{}, head, err
+	}
+	digest, err := memoryDerivedBodyReceiptDigest(&receipt)
+	if err != nil || digest != receipt.Digest || receipt.PublicationDigest != fact.Digest || receipt.MaterialSHA256 != fact.MaterialSHA256 || receipt.SlotID != head.SlotID || receipt.BodyID != head.BodyID || receipt.HeadRevision != head.Revision || receipt.SourceIdentitySHA256 != head.SourceIdentitySHA256 {
+		return types.MemoryDerivedInputProof{}, head, ErrOriginalBodyUnavailable
+	}
+	return types.MemoryDerivedInputProof{DerivationID: fact.DerivationID, PublicationID: fact.ID, PublicationDigest: fact.Digest, BodyReceiptDigest: receipt.Digest, ObjectKind: fact.ObjectKind, ObjectID: fact.ObjectID, Revision: fact.Revision, MaterialDigest: fact.MaterialDigest}, head, nil
+}
+func memoryDerivedObjectDigest(object interface{}) (string, error) {
+	if item, ok := object.(*types.MemoryItem); ok {
+		return memoryItemMaterialDigest(item)
+	}
+	return KnowledgeInputDigest(object)
+}
+
+// Called with the exact object just written by the worker. It cannot publish
+// arbitrary old rows: derivation, revision, effects and checkpoint share a tx.
+func publishMemoryDerivedEffectInTx(tx *gorm.DB, input *types.MemoryOriginalInput, commit *types.MemoryOriginalCommit, origin *types.MemoryOriginalDerivation, object interface{}) error {
+	scope := interfaces.MemoryScope{TenantID: input.Request.TenantID, SubjectID: input.Request.SubjectID}
+	control, err := memoryDerivedControlInTx(tx, scope, origin.ObjectKind, origin.ObjectID)
+	if err != nil {
+		return err
+	}
+	if !control.Present {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	encoded, err := json.Marshal(object)
+	if err != nil {
+		return err
+	}
+	material, err := memoryDerivedObjectDigest(object)
+	if err != nil || material != origin.BodyDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	parents := []string{}
+	if hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold); hold != nil {
+		for _, proof := range hold.Manifest.Inputs {
+			parents = append(parents, proof.PublicationID)
+		}
+	}
+	parent := ""
+	if hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold); hold != nil {
+		for _, proof := range hold.Manifest.Inputs {
+			if proof.ObjectKind == origin.ObjectKind && proof.ObjectID == origin.ObjectID {
+				parent = proof.PublicationID
+				break
+			}
+		}
+	}
+	if origin.ParentDerivationID != "" {
+		var previous types.MemoryDerivedPublication
+		if err := tx.Session(&gorm.Session{NewDB: true}).Select(memoryDerivedPublicationFields).Where("derivation_id=?", origin.ParentDerivationID).Take(&previous).Error; err != nil {
+			return err
+		}
+		parent = previous.ID
+	}
+	if block, ok := object.(*types.MemoryDerivedBlock); ok {
+		for _, proof := range block.Inputs {
+			parents = append(parents, proof.PublicationID)
+		}
+	}
+	parentJSON, err := json.Marshal(parents)
+	if err != nil {
+		return err
+	}
+	fact := &types.MemoryDerivedPublication{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, ObjectKind: origin.ObjectKind, ObjectID: origin.ObjectID, Revision: control.Revision, Present: true, ProducerKind: "worker", DerivationID: origin.ID, InputAdmissionID: input.ID, ExecutionAdmissionID: commit.ExecutionAdmissionID, CommitID: commit.ID, ParentPublicationID: parent, InputsJSON: string(parentJSON), MaterialJSON: string(encoded), MaterialSHA256: types.MemoryOriginalBytesDigest(encoded), MaterialDigest: material, CreatedAt: memoryFactTime()}
+	return createMemoryDerivedPublicationInTx(tx, fact)
+}
+func createMemoryDerivedPublicationInTx(tx *gorm.DB, fact *types.MemoryDerivedPublication) error {
+	var err error
+	fact.Digest, err = memoryDerivedPublicationDigest(fact)
+	if err != nil {
+		return err
+	}
+	producer := context.WithValue(tx.Statement.Context, memoryDerivedProducerKey{}, memoryDerivedProducerBoundary{fact.ID, fact.TenantID, fact.MaterialSHA256})
+	if err = tx.Session(&gorm.Session{NewDB: true}).WithContext(producer).Create(fact).Error; err != nil {
+		return err
+	}
+	head, err := memoryDerivedCapturedHeadInTx(tx, fact)
+	if err != nil {
+		return err
+	}
+	receipt := &types.MemoryDerivedBodyReceipt{PublicationID: fact.ID, PublicationDigest: fact.Digest, SlotID: head.SlotID, BodyID: head.BodyID, HeadRevision: head.Revision, SourceIdentitySHA256: head.SourceIdentitySHA256, MaterialSHA256: fact.MaterialSHA256, CreatedAt: memoryFactTime()}
+	receipt.Digest, err = memoryDerivedBodyReceiptDigest(receipt)
+	if err != nil {
+		return err
+	}
+	if err = tx.Session(&gorm.Session{NewDB: true}).Create(receipt).Error; err != nil {
+		return err
+	}
+	if own, _ := tx.Statement.Context.Value(memoryDerivedOwnPublicationsKey{}).(map[string]bool); own != nil {
+		own[fact.ID] = true
+	}
+	return tx.Statement.Context.Err()
+}
+func memoryDerivedCurrentPublicationInTx(tx *gorm.DB, scope interfaces.MemoryScope, kind, id string) (*types.MemoryDerivedPublication, error) {
+	control, err := memoryDerivedControlInTx(tx, scope, kind, id)
+	if err != nil {
+		return nil, err
+	}
+	var row types.MemoryDerivedPublication
+	err = tx.Session(&gorm.Session{NewDB: true}).Select(memoryDerivedPublicationFields).Where("tenant_id=? AND subject_id=? AND object_kind=? AND object_id=? AND revision=?", scope.TenantID, scope.SubjectID, kind, id, control.Revision).Take(&row).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err != nil {
+		return nil, err
+	}
+	return loadMemoryDerivedPublication(tx, row.ID)
+}
diff --git a/internal/application/repository/memory_derived_reader.go b/internal/application/repository/memory_derived_reader.go
new file mode 100644
index 00000000..eb0714ec
--- /dev/null
+++ b/internal/application/repository/memory_derived_reader.go
@@ -0,0 +1,708 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryDerivedHoldKey struct{}
+type memoryDerivedHold struct {
+	Manifest               types.MemoryDerivedManifest
+	Facts                  map[string]*types.MemoryDerivedPublication
+	Heads                  map[string]originalBodyFieldHead
+	Leases                 map[string]originalBodyLease
+	Originals              map[string]*types.MemoryOriginalInput
+	Generations            map[string]*types.MemoryGeneratedOriginal
+	GeneratedModelContexts map[string]context.Context
+	Executions             map[string]*types.MemoryOriginalExecution
+	ModelContexts          map[string]context.Context
+	NativeSource           *types.MemoryDerivedNativeSource
+	NativeSources          map[string]*types.MemoryDerivedNativeSource
+	Policies               map[string]memoryPolicyHold
+}
+type memoryDerivedRead struct {
+	repo     *memoryOriginalAdmissionRepository
+	ctx      context.Context
+	cancel   context.CancelFunc
+	hold     *memoryDerivedHold
+	models   []interfaces.MemoryDerivedExecutionRead
+	policies []interfaces.MemoryPolicyOriginalRead
+	mu       sync.Mutex
+	failed   error
+	closed   bool
+}
+
+func memoryDerivedCollectionInTx(tx *gorm.DB, scope interfaces.MemoryScope) (uint64, error) {
+	var collection types.MemoryDerivedCollection
+	if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Take(&collection).Error; err != nil {
+		return 0, err
+	}
+	return collection.Revision, tx.Statement.Context.Err()
+}
+func discoverMemoryDerivedCurrentInTx(tx *gorm.DB, scope interfaces.MemoryScope) ([]*types.MemoryDerivedPublication, error) {
+	var facts []*types.MemoryDerivedPublication
+	// Select identities only. No current plaintext or cached output is accepted
+	// before the graph's actual physical bodies have been leased.
+	for _, kind := range []struct{ Kind, Table string }{{"memory_item", "memory_items"}, {"memory_topic", "memory_topic_stats"}, {"memory_tombstone", "memory_tombstones"}} {
+		var rows []struct{ ID string }
+		if err := tx.Session(&gorm.Session{NewDB: true}).Table(kind.Table).Select("id").Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Order("id").Find(&rows).Error; err != nil {
+			return nil, err
+		}
+		for _, row := range rows {
+			fact, err := memoryDerivedCurrentPublicationInTx(tx, scope, kind.Kind, row.ID)
+			if err != nil {
+				return nil, err
+			}
+			facts = append(facts, fact)
+		}
+	}
+	var subject struct{ ID string }
+	if err := tx.Session(&gorm.Session{NewDB: true}).Table("memory_subjects").Select("id").Where("tenant_id=? AND subject_id=? AND (block_text<>'' OR item_count<>0)", scope.TenantID, scope.SubjectID).Take(&subject).Error; err == nil {
+		fact, err := memoryDerivedCurrentPublicationInTx(tx, scope, "memory_block", subject.ID)
+		if err != nil {
+			return nil, err
+		}
+		facts = append(facts, fact)
+	} else if err != gorm.ErrRecordNotFound {
+		return nil, err
+	}
+	return facts, nil
+}
+func verifyMemoryDerivedWorkerInTx(tx *gorm.DB, fact *types.MemoryDerivedPublication, hold *memoryDerivedHold) error {
+	input, err := loadMemoryOriginal(tx, fact.InputAdmissionID)
+	if err != nil {
+		return err
+	}
+	if input.Request.TenantID != fact.TenantID || input.Request.SubjectID != fact.SubjectID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var receipt types.MemoryOriginalCheckpoint
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("id=? AND input_admission_id=?", fact.CommitID, input.ID).Take(&receipt).Error; err != nil {
+		return err
+	}
+	if err = verifyMemoryCheckpoint(tx, input, &receipt); err != nil {
+		return err
+	}
+	var origin types.MemoryOriginalDerivation
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("id=? AND commit_id=?", fact.DerivationID, receipt.ID).Take(&origin).Error; err != nil {
+		return err
+	}
+	digest, err := memoryDerivationDigest(&origin)
+	if err != nil || digest != origin.Digest || origin.BodyDigest != fact.MaterialDigest || origin.ObjectKind != fact.ObjectKind || origin.ObjectID != fact.ObjectID || origin.ExecutionAdmissionID != fact.ExecutionAdmissionID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if origin.ParentDerivationID != "" {
+		parent, err := loadMemoryDerivedPublication(tx, fact.ParentPublicationID)
+		if err != nil {
+			return err
+		}
+		if parent.DerivationID != origin.ParentDerivationID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	var execution types.MemoryOriginalExecution
+	if err = tx.Session(&gorm.Session{NewDB: true}).Where("id=?", fact.ExecutionAdmissionID).Take(&execution).Error; err != nil {
+		return err
+	}
+	var manifest types.MemoryDerivedManifest
+	if json.Unmarshal([]byte(execution.DerivedInputsJSON), &manifest) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	actual, err := memoryDerivedManifestDigest(manifest)
+	if err != nil || actual != manifest.Digest || manifest.Digest != execution.DerivedInputsDigest || manifest.TenantID != fact.TenantID || manifest.SubjectID != fact.SubjectID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var ids []string
+	if json.Unmarshal([]byte(fact.InputsJSON), &ids) != nil || len(ids) < len(manifest.Inputs) || fact.ObjectKind != "memory_block" && len(ids) != len(manifest.Inputs) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	for index, proof := range manifest.Inputs {
+		if ids[index] != proof.PublicationID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		parent, err := loadMemoryDerivedPublication(tx, proof.PublicationID)
+		if err != nil {
+			return err
+		}
+		actual, _, err := memoryDerivedProofInTx(tx, parent)
+		if err != nil || actual != proof {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	for _, id := range ids[len(manifest.Inputs):] {
+		child, err := loadMemoryDerivedPublication(tx, id)
+		if err != nil {
+			return err
+		}
+		if child.CommitID != fact.CommitID {
+			found := false
+			for _, proof := range manifest.Inputs {
+				if proof.PublicationID == id {
+					found = true
+				}
+			}
+			if !found {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+	}
+	hold.Executions[execution.ID] = &execution
+	hold.Originals[input.ID] = input
+	return nil
+}
+func loadMemoryDerivedGraphInTx(tx *gorm.DB, scope interfaces.MemoryScope, current []*types.MemoryDerivedPublication, hold *memoryDerivedHold) error {
+	visiting := map[string]bool{}
+	var visit func(string) error
+	visit = func(id string) error {
+		if visiting[id] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if hold.Facts[id] != nil {
+			return nil
+		}
+		visiting[id] = true
+		defer delete(visiting, id)
+		fact, err := loadMemoryDerivedPublication(tx, id)
+		if err != nil {
+			return err
+		}
+		if fact.TenantID != scope.TenantID || fact.SubjectID != scope.SubjectID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		_, head, err := memoryDerivedProofInTx(tx, fact)
+		if err != nil {
+			return err
+		}
+		hold.Heads[head.SlotID] = head
+		switch fact.ProducerKind {
+		case "worker":
+			if err = verifyMemoryDerivedWorkerInTx(tx, fact, hold); err != nil {
+				return err
+			}
+		case "generated":
+			if err = verifyMemoryGeneratedPublicationInTx(tx, fact, hold); err != nil {
+				return err
+			}
+		case "authored", "control":
+			if err = verifyMemoryDerivedNativeInTx(tx, fact, hold); err != nil {
+				return err
+			}
+		default:
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var inputs []string
+		if json.Unmarshal([]byte(fact.InputsJSON), &inputs) != nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if fact.ParentPublicationID != "" {
+			inputs = append(inputs, fact.ParentPublicationID)
+		}
+		for _, parent := range inputs {
+			if parent == id {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			if err = visit(parent); err != nil {
+				return err
+			}
+		}
+		hold.Facts[id] = fact
+		return tx.Statement.Context.Err()
+	}
+	for _, fact := range current {
+		if err := visit(fact.ID); err != nil {
+			return err
+		}
+		proof, _, err := memoryDerivedProofInTx(tx, fact)
+		if err != nil {
+			return err
+		}
+		hold.Manifest.Inputs = append(hold.Manifest.Inputs, proof)
+	}
+	for _, source := range hold.NativeSources {
+		heads, err := memoryExpectedBodyHeads(tx, source.Plan, map[*types.MessageMaterialReadPlan]bool{})
+		if err != nil {
+			return err
+		}
+		for _, head := range heads {
+			hold.Heads[head.SlotID] = head
+		}
+	}
+	for _, input := range hold.Originals {
+		heads, err := memoryExpectedBodyHeads(tx, input.Plan, map[*types.MessageMaterialReadPlan]bool{})
+		if err != nil {
+			return err
+		}
+		for _, head := range heads {
+			hold.Heads[head.SlotID] = head
+		}
+	}
+	return nil
+}
+func (r *memoryOriginalAdmissionRepository) BeginMemoryDerivedRead(ctx context.Context, scope interfaces.MemoryScope) (interfaces.MemoryDerivedRead, error) {
+	if !scope.Valid() || r.authorityFactory == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read := &memoryDerivedRead{repo: r, hold: &memoryDerivedHold{Manifest: types.MemoryDerivedManifest{TenantID: scope.TenantID, SubjectID: scope.SubjectID}, Facts: map[string]*types.MemoryDerivedPublication{}, Heads: map[string]originalBodyFieldHead{}, Leases: map[string]originalBodyLease{}, Originals: map[string]*types.MemoryOriginalInput{}, Generations: map[string]*types.MemoryGeneratedOriginal{}, GeneratedModelContexts: map[string]context.Context{}, Executions: map[string]*types.MemoryOriginalExecution{}, ModelContexts: map[string]context.Context{}, NativeSources: map[string]*types.MemoryDerivedNativeSource{}, Policies: map[string]memoryPolicyHold{}}}
+	read.ctx, read.cancel = context.WithCancel(ctx)
+	err := r.db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Exec("INSERT INTO memory_derived_collections(tenant_id,subject_id,revision) SELECT ?,?,1 WHERE NOT EXISTS(SELECT 1 FROM memory_derived_collections WHERE tenant_id=? AND subject_id=?)", scope.TenantID, scope.SubjectID, scope.TenantID, scope.SubjectID).Error; err != nil {
+			return err
+		}
+		revision, err := memoryDerivedCollectionInTx(tx, scope)
+		if err != nil {
+			return err
+		}
+		read.hold.Manifest.CollectionRevision = revision
+		current, err := discoverMemoryDerivedCurrentInTx(tx, scope)
+		if err != nil {
+			return err
+		}
+		if err = loadMemoryDerivedGraphInTx(tx, scope, current, read.hold); err != nil {
+			return err
+		}
+		owner := "memory-derived-read/" + uuid.NewString()
+		bodies := map[string]bool{}
+		for _, head := range read.hold.Heads {
+			bodies[head.BodyID] = true
+		}
+		ids := []string{}
+		for id := range bodies {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		store := NewOriginalBodyRetentionStore(tx)
+		for _, id := range ids {
+			leaseID, err := store.acquireLeaseInTx(tx, id, "read", owner, 15*time.Minute)
+			if err != nil {
+				return err
+			}
+			var lease originalBodyLease
+			if err = bodyInternal(tx).Where("lease_id=?", leaseID).Take(&lease).Error; err != nil {
+				return err
+			}
+			read.hold.Leases[id] = lease
+		}
+		read.hold.Manifest.Digest, err = memoryDerivedManifestDigest(read.hold.Manifest)
+		return err
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		read.cancel()
+		return nil, err
+	}
+	read.ctx = context.WithValue(read.ctx, memoryDerivedHoldKey{}, read.hold)
+	// Policy leases are acquired by the existing genuine policy lifetime reader,
+	// not fabricated from an execution's policy digest or current tenant bytes.
+	if len(read.hold.Executions) > 0 && (r.historicalModels == nil || r.historicalModels.Begin == nil || r.historicalModels.Check == nil) {
+		read.Close()
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	executions := []string{}
+	for id := range read.hold.Executions {
+		executions = append(executions, id)
+	}
+	sort.Strings(executions)
+	for _, id := range executions {
+		model, err := r.historicalModels.Begin(read.ctx, read.hold.Executions[id])
+		if err != nil {
+			read.Close()
+			return nil, err
+		}
+		if model == nil {
+			read.Close()
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		read.models = append(read.models, model)
+		read.hold.ModelContexts[id] = model.Context()
+	}
+	generatedIDs := []string{}
+	for id := range read.hold.Generations {
+		generatedIDs = append(generatedIDs, id)
+	}
+	sort.Strings(generatedIDs)
+	for _, id := range generatedIDs {
+		if read.hold.Generations[id].Recipe == types.MemoryConsolidationMaintenanceRecipe {
+			continue
+		}
+		if r.generatedModels == nil || r.generatedModels.BeginHistory == nil || r.generatedModels.CheckHistory == nil {
+			read.Close()
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		original := read.hold.Generations[id]
+		model, err := r.generatedModels.BeginHistory(read.ctx, original.ModelID, original.ModelProofJSON, original.ModelDigest)
+		if err != nil {
+			read.Close()
+			return nil, err
+		}
+		if model == nil {
+			read.Close()
+			return nil, types.ErrMemoryOriginalUnavailable
+		}
+		read.models = append(read.models, model)
+		read.hold.GeneratedModelContexts[id] = model.Context()
+	}
+	ids := []string{}
+	for id := range read.hold.Facts {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		fact := read.hold.Facts[id]
+		var queued types.MemoryPolicyProof
+		if fact.ProducerKind == "worker" {
+			var execution types.MemoryOriginalExecution
+			if err = r.db.WithContext(read.ctx).Where("id=?", fact.ExecutionAdmissionID).Take(&execution).Error; err != nil {
+				read.Close()
+				return nil, err
+			}
+			queued = types.MemoryPolicyProof{OriginID: execution.PolicyOriginID, Revision: execution.PolicyRevision, PolicyDigest: execution.PolicyDigest, OriginDigest: execution.PolicyOriginDigest, BodyReceiptDigest: execution.PolicyBodyReceiptDigest}
+		} else if fact.ProducerKind == "generated" {
+			original := read.hold.Generations[fact.InputAdmissionID]
+			if original == nil || json.Unmarshal([]byte(original.PolicyProofJSON), &queued) != nil {
+				read.Close()
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+		} else {
+			var author memoryNativeAuthor
+			if json.Unmarshal([]byte(fact.AuthorSelector), &author) != nil {
+				read.Close()
+				return nil, types.ErrMemoryOriginalUnavailable
+			}
+			queued = author.Policy
+		}
+		policy, err := beginMemoryPolicyOriginalRead(read.ctx, r.db, scope.TenantID, queued)
+		if err != nil {
+			read.Close()
+			return nil, err
+		}
+		read.policies = append(read.policies, policy)
+		bound, ok := policy.Context().Value(memoryPolicyHoldKey{}).(memoryPolicyHold)
+		if !ok {
+			read.Close()
+			return nil, ErrOriginalBodyUnavailable
+		}
+		read.hold.Policies[id] = bound
+	}
+	if err = read.Recheck(); err != nil {
+		read.Close()
+		return nil, err
+	}
+	return read, nil
+}
+func memoryDerivedSourceContext(ctx context.Context, hold *memoryDerivedHold) context.Context {
+	bound := memoryOriginalBodyHold{Bindings: map[string]originalBodyLease{}}
+	for _, lease := range hold.Leases {
+		bound.IDs = append(bound.IDs, lease.LeaseID)
+		bound.Bindings[lease.LeaseID] = lease
+	}
+	sort.Strings(bound.IDs)
+	return context.WithValue(ctx, memoryOriginalBodyHoldKey{}, bound)
+}
+func (r *memoryOriginalAdmissionRepository) checkMemoryDerivedHoldInTx(tx *gorm.DB, hold *memoryDerivedHold, selfCommit string) error {
+	scope := interfaces.MemoryScope{TenantID: hold.Manifest.TenantID, SubjectID: hold.Manifest.SubjectID}
+	if err := r.lockMemoryDerivedAuthorityInTx(tx.Statement.Context, tx, hold, nil); err != nil {
+		return err
+	}
+	revision, err := memoryDerivedCollectionInTx(tx, scope)
+	if err != nil {
+		return err
+	}
+	if selfCommit == "" && revision != hold.Manifest.CollectionRevision {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	for _, proof := range hold.Manifest.Inputs {
+		current, err := memoryDerivedCurrentPublicationInTx(tx, scope, proof.ObjectKind, proof.ObjectID)
+		if err != nil {
+			return err
+		}
+		if current.ID != proof.PublicationID {
+			own, _ := tx.Statement.Context.Value(memoryDerivedOwnPublicationsKey{}).(map[string]bool)
+			nativeSelf := selfCommit == "native" && own[current.ID]
+			if !nativeSelf && (selfCommit == "" || current.CommitID != selfCommit) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		if _, _, err = memoryDerivedProofInTx(tx, current); err != nil {
+			return err
+		}
+		old, err := loadMemoryDerivedPublication(tx, proof.PublicationID)
+		if err != nil {
+			return err
+		}
+		actual, _, err := memoryDerivedProofInTx(tx, old)
+		if err != nil || actual != proof {
+			return types.ErrMemoryOriginalUnavailable
+		}
+	}
+	store := NewOriginalBodyRetentionStore(tx)
+	if err = store.checkJournalInTx(tx); err != nil {
+		return err
+	}
+	locked := []originalBodyLease{}
+	headKeys := []string{}
+	for key := range hold.Heads {
+		headKeys = append(headKeys, key)
+	}
+	sort.Strings(headKeys)
+	for _, key := range headKeys {
+		head := hold.Heads[key]
+		if err = checkOriginalBodyAvailableForHeads(tx.Statement.Context, tx, head.SourceTable, head.RowKey, nil); err != nil {
+			return err
+		}
+		expected, ok := hold.Leases[head.BodyID]
+		if !ok {
+			return ErrOriginalBodyUnavailable
+		}
+		var lease originalBodyLease
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id=?", expected.LeaseID).Take(&lease).Error; err != nil {
+			return err
+		}
+		if lease.BodyID != expected.BodyID || lease.OwnerID != expected.OwnerID || lease.Kind != "read" || lease.Epoch != expected.Epoch || lease.ReleasedAtMS != nil {
+			return ErrOriginalBodyUnavailable
+		}
+		var body originalBodyPayload
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", head.BodyID).Take(&body).Error; err != nil {
+			return err
+		}
+		if body.State != "live" || body.PurgeEpoch != lease.Epoch {
+			return ErrOriginalBodyUnavailable
+		}
+		locked = append(locked, lease)
+	}
+	ids := []string{}
+	for id := range hold.Originals {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	sourceCtx := memoryDerivedSourceContext(tx.Statement.Context, hold)
+	for _, id := range ids {
+		input := hold.Originals[id]
+		local := tx.Session(&gorm.Session{NewDB: true}).WithContext(sourceCtx)
+		if err = r.lockMemoryOriginalFence(sourceCtx, local, input); err != nil {
+			return err
+		}
+		if err = r.checkMemoryOriginalInTx(sourceCtx, local, input); err != nil {
+			return err
+		}
+	}
+	for _, source := range hold.NativeSources {
+		if err = r.checkMemoryNativeSourceInTx(tx, sourceCtx, source, scope); err != nil {
+			return err
+		}
+	}
+	if hold.NativeSource != nil {
+		if err = r.checkMemoryNativeSourceInTx(tx, sourceCtx, hold.NativeSource, scope); err != nil {
+			return err
+		}
+	}
+	facts := []string{}
+	for id := range hold.Facts {
+		facts = append(facts, id)
+	}
+	sort.Strings(facts)
+	for _, id := range facts {
+		fact := hold.Facts[id]
+		if fact.ProducerKind == "generated" {
+			if err = r.checkMemoryGeneratedActorInTx(tx, hold.Generations[fact.InputAdmissionID]); err != nil {
+				return err
+			}
+		} else if fact.ProducerKind != "worker" {
+			if err = r.checkMemoryNativeAuthorInTx(tx, fact); err != nil {
+				return err
+			}
+		}
+		policy, ok := hold.Policies[id]
+		if !ok {
+			return ErrOriginalBodyUnavailable
+		}
+		local := tx.Session(&gorm.Session{NewDB: true}).WithContext(context.WithValue(sourceCtx, memoryPolicyHoldKey{}, policy))
+		if err = checkMemoryPolicyHoldsInTx(local, scope.TenantID, policy.Current, policy.Queued); err != nil {
+			return err
+		}
+	}
+	if policy, ok := hold.Policies["native-author"]; ok {
+		local := tx.Session(&gorm.Session{NewDB: true}).WithContext(context.WithValue(sourceCtx, memoryPolicyHoldKey{}, policy))
+		if err = checkMemoryPolicyHoldsInTx(local, scope.TenantID, policy.Current, policy.Queued); err != nil {
+			return err
+		}
+	}
+	executions := []string{}
+	for id := range hold.Executions {
+		executions = append(executions, id)
+	}
+	sort.Strings(executions)
+	for _, id := range executions {
+		if r.historicalModels == nil || r.historicalModels.Check == nil || hold.ModelContexts[id] == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = r.historicalModels.Check(hold.ModelContexts[id], tx.Session(&gorm.Session{NewDB: true}), hold.Executions[id]); err != nil {
+			return err
+		}
+	}
+	generatedIDs := []string{}
+	for id := range hold.Generations {
+		generatedIDs = append(generatedIDs, id)
+	}
+	sort.Strings(generatedIDs)
+	for _, id := range generatedIDs {
+		original := hold.Generations[id]
+		if original.Recipe == types.MemoryConsolidationMaintenanceRecipe {
+			continue
+		}
+		if r.generatedModels == nil || r.generatedModels.CheckHistory == nil || hold.GeneratedModelContexts[id] == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = r.generatedModels.CheckHistory(hold.GeneratedModelContexts[id], tx.Session(&gorm.Session{NewDB: true}), original.TenantID, original.ModelID, original.ModelProofJSON, original.ModelDigest); err != nil {
+			return err
+		}
+	}
+	if err = store.checkJournalInTx(tx); err != nil {
+		return err
+	}
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	for _, lease := range locked {
+		if lease.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+func (r *memoryDerivedRead) Context() context.Context { return r.ctx }
+func (r *memoryDerivedRead) Recheck() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.failed != nil {
+		return r.failed
+	}
+	if r.closed {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	err := r.repo.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error { return r.repo.checkMemoryDerivedHoldInTx(tx, r.hold, "") }, memoryWriteOptions(r.repo.db))
+	if err != nil {
+		r.failed = err
+		r.cancel()
+	}
+	return err
+}
+func (r *memoryDerivedRead) Snapshot() (*types.MemoryDerivedSnapshot, error) {
+	if err := r.Recheck(); err != nil {
+		return nil, err
+	}
+	snapshot := &types.MemoryDerivedSnapshot{Manifest: r.hold.Manifest}
+	err := r.repo.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		if err := r.repo.checkMemoryDerivedHoldInTx(tx, r.hold, ""); err != nil {
+			return err
+		}
+		for _, proof := range r.hold.Manifest.Inputs {
+			fact := r.hold.Facts[proof.PublicationID]
+			var material struct{ MaterialJSON string }
+			if err := tx.Session(&gorm.Session{NewDB: true}).Table("memory_derived_publications").Select("material_json").Where("id=?", fact.ID).Take(&material).Error; err != nil {
+				return err
+			}
+			if types.MemoryOriginalBytesDigest([]byte(material.MaterialJSON)) != fact.MaterialSHA256 {
+				return ErrOriginalBodyUnavailable
+			}
+			if fact.ProducerKind == "authored" || fact.ProducerKind == "control" {
+				var native memoryNativeMaterial
+				if json.Unmarshal([]byte(material.MaterialJSON), &native) != nil || native.Request.Operation == "" || len(native.Request.Arguments) == 0 {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				material.MaterialJSON = string(native.After)
+			}
+			var object interface{}
+			switch fact.ObjectKind {
+			case "memory_item":
+				item := &types.MemoryItem{}
+				object = item
+				if err := json.Unmarshal([]byte(material.MaterialJSON), item); err != nil {
+					return err
+				}
+				snapshot.Items = append(snapshot.Items, item)
+			case "memory_topic":
+				topic := &types.MemoryTopicStat{}
+				object = topic
+				if err := json.Unmarshal([]byte(material.MaterialJSON), topic); err != nil {
+					return err
+				}
+				snapshot.Topics = append(snapshot.Topics, topic)
+			case "memory_block":
+				block := &types.MemoryDerivedBlock{}
+				object = block
+				if err := json.Unmarshal([]byte(material.MaterialJSON), block); err != nil {
+					return err
+				}
+				for _, input := range block.Inputs {
+					if r.hold.Facts[input.PublicationID] == nil {
+						return types.ErrMemoryOriginalUnavailable
+					}
+					actual, _, err := memoryDerivedProofInTx(tx, r.hold.Facts[input.PublicationID])
+					if err != nil || actual != input {
+						return types.ErrMemoryOriginalUnavailable
+					}
+				}
+				snapshot.Block = block
+			case "memory_tombstone":
+				tomb := &types.MemoryTombstone{}
+				object = tomb
+				if err := json.Unmarshal([]byte(material.MaterialJSON), tomb); err != nil {
+					return err
+				}
+				snapshot.Tombstones = append(snapshot.Tombstones, tomb)
+			default:
+				return types.ErrMemoryOriginalUnavailable
+			}
+			digest, err := memoryDerivedObjectDigest(object)
+			if err != nil || digest != proof.MaterialDigest {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		return r.repo.checkMemoryDerivedHoldInTx(tx, r.hold, "")
+	}, memoryWriteOptions(r.repo.db))
+	if err != nil {
+		return nil, err
+	}
+	if err = r.Recheck(); err != nil {
+		return nil, err
+	}
+	return snapshot, nil
+}
+func (r *memoryDerivedRead) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return r.failed
+	}
+	r.closed = true
+	r.cancel()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	var first error
+	for _, model := range r.models {
+		if err := model.Close(); err != nil && first == nil {
+			first = err
+		}
+	}
+	for _, policy := range r.policies {
+		if err := policy.Close(); err != nil && first == nil {
+			first = err
+		}
+	}
+	store := NewOriginalBodyRetentionStore(r.repo.db)
+	for _, lease := range r.hold.Leases {
+		if err := store.ReleaseLease(cleanup, lease.LeaseID); err != nil && first == nil {
+			first = err
+		}
+	}
+	return first
+}
