@@ -0,0 +1,285 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+	"strings"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func (r *memoryOriginalAdmissionRepository) publishMemoryGeneratedEffectInTx(tx *gorm.DB, original *types.MemoryGeneratedOriginal, receiptID, action, kind, id, parent string, object interface{}) (types.MemoryGeneratedEffect, error) {
+	scope := interfaces.MemoryScope{TenantID: original.TenantID, SubjectID: original.SubjectID}
+	control, err := memoryDerivedControlInTx(tx, scope, kind, id)
+	if err != nil {
+		return types.MemoryGeneratedEffect{}, err
+	}
+	hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if hold == nil {
+		return types.MemoryGeneratedEffect{}, types.ErrMemoryOriginalUnavailable
+	}
+	ids := []string{}
+	for _, proof := range hold.Manifest.Inputs {
+		ids = append(ids, proof.PublicationID)
+	}
+	if block, ok := object.(*types.MemoryDerivedBlock); ok {
+		for _, proof := range block.Inputs {
+			ids = append(ids, proof.PublicationID)
+		}
+	}
+	inputs, err := json.Marshal(ids)
+	if err != nil {
+		return types.MemoryGeneratedEffect{}, err
+	}
+	body, err := json.Marshal(object)
+	if err != nil {
+		return types.MemoryGeneratedEffect{}, err
+	}
+	material, err := memoryDerivedObjectDigest(object)
+	if err != nil {
+		return types.MemoryGeneratedEffect{}, err
+	}
+	publication := &types.MemoryDerivedPublication{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, ObjectKind: kind, ObjectID: id, Revision: control.Revision, Present: control.Present, ProducerKind: "generated", InputAdmissionID: original.ID, ExecutionAdmissionID: original.ID, CommitID: receiptID, ParentPublicationID: parent, InputsJSON: string(inputs), MaterialJSON: string(body), MaterialSHA256: types.MemoryOriginalBytesDigest(body), MaterialDigest: material, CreatedAt: memoryFactTime()}
+	if err = createMemoryDerivedPublicationInTx(tx, publication); err != nil {
+		return types.MemoryGeneratedEffect{}, err
+	}
+	proof, _, err := memoryDerivedProofInTx(tx, publication)
+	if err != nil {
+		return types.MemoryGeneratedEffect{}, err
+	}
+	return types.MemoryGeneratedEffect{Action: action, Proof: proof, ParentPublicationID: parent}, nil
+}
+func (r *memoryOriginalAdmissionRepository) CommitMemoryGenerated(ctx context.Context, result types.MemoryGeneratedResult) (int, error) {
+	hold, _ := ctx.Value(memoryGeneratedHoldKey{}).(*memoryGeneratedHold)
+	if hold == nil || hold.Original == nil || hold.Original.ID != result.OriginalID || hold.Original.Digest != result.OriginalDigest {
+		return 0, types.ErrMemoryOriginalUnavailable
+	}
+	merged := 0
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		scope := interfaces.MemoryScope{TenantID: hold.Original.TenantID, SubjectID: hold.Original.SubjectID}
+		tx = tx.Session(&gorm.Session{NewDB: true}).WithContext(context.WithValue(ctx, memoryDerivedOwnPublicationsKey{}, map[string]bool{}))
+		if tx.Dialector.Name() == "sqlite" {
+			if err := tx.Exec("UPDATE memory_subjects SET updated_at=updated_at WHERE tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Error; err != nil {
+				return err
+			}
+		}
+		var subject types.MemorySubject
+		if err := tx.Session(&gorm.Session{NewDB: true}).Clauses(forUpdateClause()).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Take(&subject).Error; err != nil {
+			return err
+		}
+		if !subject.Enabled {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err := r.checkMemoryGeneratedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		original, err := loadMemoryGeneratedOriginal(tx, result.OriginalID)
+		if err != nil {
+			return err
+		}
+		var command types.MemoryConsolidationCommand
+		if json.Unmarshal([]byte(original.RequestJSON), &command) != nil || len(result.Decisions) != len(command.Clusters) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		last := subject.ConsolidatedAt
+		if command.Force {
+			last = subject.ForcedConsolidatedAt
+		}
+		if !faqInputEqual(memoryFactTimePointer(last), command.LastConsolidatedAt) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen := map[int]bool{}
+		receiptID := uuid.NewString()
+		effects := []types.MemoryGeneratedEffect{}
+		if err = validateMemoryConsolidationCommand(original, &command); err != nil {
+			return err
+		}
+		demotions, err := r.applyMemoryConsolidationDemotionsInTx(tx, original, receiptID, command)
+		if err != nil {
+			return err
+		}
+		effects = append(effects, demotions...)
+		for _, decision := range result.Decisions {
+			if decision.ClusterIndex < 0 || decision.ClusterIndex >= len(command.Clusters) || seen[decision.ClusterIndex] || decision.ResponseJSON == "" || decision.RawResponse == "" {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			seen[decision.ClusterIndex] = true
+			actual := strings.TrimSpace(decision.RawResponse)
+			start, end := strings.Index(actual, "{"), strings.LastIndex(actual, "}")
+			if start < 0 || end <= start || actual[start:end+1] != decision.ResponseJSON {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			parsed, err := types.DecodeMemoryConsolidationDecision(decision.ResponseJSON)
+			if err != nil || parsed != decision.Statement {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			if decision.Statement == "" {
+				continue
+			} // The model's explicit declined merge is receipted.
+			statement := types.SanitizeMemoryContent(decision.Statement)
+			if statement == "" || statement != decision.Statement {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			if _, changed := types.RedactSensitive(statement); changed {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			targets := []*types.MemoryItem{}
+			parents := []*types.MemoryDerivedPublication{}
+			for _, id := range command.Clusters[decision.ClusterIndex] {
+				pub, err := memoryDerivedWritablePublication(tx, scope, "memory_item", id, receiptID)
+				if err != nil {
+					return err
+				}
+				var item types.MemoryItem
+				if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(forUpdateClause()).Where("id=? AND tenant_id=? AND subject_id=?", id, scope.TenantID, scope.SubjectID).Take(&item).Error; err != nil {
+					return err
+				}
+				actual, err := memoryItemMaterialDigest(&item)
+				if err != nil || actual != pub.MaterialDigest || item.Status != types.MemoryStatusActive {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				targets = append(targets, &item)
+				parents = append(parents, pub)
+			}
+			if len(targets) < 2 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			primary := targets[0]
+			at := memoryFactTime()
+			replacement := &types.MemoryItem{ID: uuid.NewString(), TenantID: scope.TenantID, SubjectID: scope.SubjectID, Kind: primary.Kind, Topic: primary.Topic, NormalizedKey: types.MemoryItemKey(primary.Topic, statement), Content: statement, Importance: primary.Importance, Origin: types.MemoryOriginExtracted, Status: types.MemoryStatusActive, SourceSessionID: primary.SourceSessionID, SourceMessageID: primary.SourceMessageID, ValidFrom: at, CreatedAt: at, UpdatedAt: at}
+			// Forgotten material is still a consumed input; no model result can silently
+			// undo it. Its decline is explicit rather than a dropped unaccounted effect.
+			derived, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+			for _, proof := range derived.Manifest.Inputs {
+				if proof.ObjectKind == "memory_tombstone" {
+					var tomb types.MemoryTombstone
+					if err = tx.Session(&gorm.Session{NewDB: true}).Where("id=?", proof.ObjectID).Take(&tomb).Error; err != nil {
+						return err
+					}
+					if tomb.Fingerprint == types.MemoryFingerprint(statement) {
+						return types.ErrMemoryOriginalUnavailable
+					}
+				}
+			}
+			if err = tx.Session(&gorm.Session{NewDB: true}).Create(replacement).Error; err != nil {
+				return err
+			}
+			effect, err := r.publishMemoryGeneratedEffectInTx(tx, original, receiptID, "merge_add", "memory_item", replacement.ID, "", replacement)
+			if err != nil {
+				return err
+			}
+			effects = append(effects, effect)
+			for index, target := range targets {
+				target.Status = types.MemoryStatusSuperseded
+				target.InvalidAt = &at
+				target.SupersededBy = replacement.ID
+				target.UpdatedAt = at
+				update := tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryItem{}).Where("id=? AND status=?", target.ID, types.MemoryStatusActive).Updates(map[string]interface{}{"status": target.Status, "invalid_at": at, "superseded_by": replacement.ID, "updated_at": at})
+				if update.Error != nil {
+					return update.Error
+				}
+				if update.RowsAffected != 1 {
+					return types.ErrMemoryOriginalUnavailable
+				}
+				effect, err = r.publishMemoryGeneratedEffectInTx(tx, original, receiptID, "merge_supersede", "memory_item", target.ID, parents[index].ID, target)
+				if err != nil {
+					return err
+				}
+				effects = append(effects, effect)
+			}
+			merged++
+		}
+		// Every rank survivor is checked through its own exact publication. The
+		// generated replacements and all capacity retirements stay in this tx.
+		var tenant types.Tenant
+		if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", scope.TenantID).Take(&tenant).Error; err != nil {
+			return err
+		}
+		if tenant.MemoryConfig == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		plan, err := memoryCapacityRetirementsInTx(tx.Session(&gorm.Session{NewDB: true}), scope, tenant.MemoryConfig.EffectiveMaxItems(), receiptID)
+		if err != nil {
+			return err
+		}
+		for _, retirement := range plan.Retirements {
+			write := tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryItem{}).Where("id=? AND status=?", retirement.TargetID, types.MemoryStatusActive).Updates(map[string]interface{}{"status": types.MemoryStatusArchived, "updated_at": retirement.After.UpdatedAt})
+			if write.Error != nil {
+				return write.Error
+			}
+			if write.RowsAffected != 1 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			effect, err := r.publishMemoryGeneratedEffectInTx(tx, original, receiptID, "capacity_archive", "memory_item", retirement.TargetID, retirement.Publication.ID, retirement.After)
+			if err != nil {
+				return err
+			}
+			effects = append(effects, effect)
+		}
+		block, err := memoryDerivedBlockInTx(tx, scope, receiptID)
+		if err != nil {
+			return err
+		}
+		if control, err := memoryDerivedControlInTx(tx, scope, "memory_block", block.ID); err == nil {
+			var count int64
+			if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemoryDerivedPublication{}).Where("object_kind='memory_block' AND object_id=? AND revision=?", block.ID, control.Revision).Count(&count).Error; err != nil {
+				return err
+			}
+			if count == 0 {
+				parent := ""
+				for _, proof := range ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold).Manifest.Inputs {
+					if proof.ObjectKind == "memory_block" && proof.ObjectID == block.ID {
+						parent = proof.PublicationID
+					}
+				}
+				effect, err := r.publishMemoryGeneratedEffectInTx(tx, original, receiptID, "resident_block", "memory_block", block.ID, parent, block)
+				if err != nil {
+					return err
+				}
+				effects = append(effects, effect)
+			}
+		} else if err != gorm.ErrRecordNotFound {
+			return err
+		}
+		sort.Slice(effects, func(i, j int) bool { return effects[i].Proof.PublicationID < effects[j].Proof.PublicationID })
+		manifest, err := json.Marshal(effects)
+		if err != nil {
+			return err
+		}
+		responses, err := json.Marshal(result.Decisions)
+		if err != nil {
+			return err
+		}
+		receipt := &types.MemoryGeneratedReceipt{ID: receiptID, OriginalID: original.ID, OriginalDigest: original.Digest, TenantID: scope.TenantID, SubjectID: scope.SubjectID, Recipe: original.Recipe, ResponseJSON: string(responses), ResponseSHA256: types.MemoryOriginalBytesDigest(responses), EffectManifest: string(manifest), EffectDigest: types.MemoryOriginalBytesDigest(manifest), CreatedAt: memoryFactTime()}
+		receipt.Digest, err = memoryGeneratedReceiptDigest(receipt)
+		if err != nil {
+			return err
+		}
+		producer := memoryGeneratedProducerContext(tx.Statement.Context, "memory_generated_receipts", receipt.ID, scope.TenantID, receipt.ResponseSHA256)
+		if err = tx.Session(&gorm.Session{NewDB: true}).WithContext(producer).Create(receipt).Error; err != nil {
+			return err
+		}
+		if err = createMemoryGeneratedBodyReceiptInTx(tx, "memory_generated_receipts", receipt.ID, scope.TenantID, receipt.ResponseSHA256, receipt.Digest); err != nil {
+			return err
+		}
+		clock := "consolidated_at"
+		if command.Force {
+			clock = "forced_consolidated_at"
+		}
+		if err = tx.Session(&gorm.Session{NewDB: true}).Model(&types.MemorySubject{}).Where("id=?", subject.ID).Update(clock, memoryFactTime()).Error; err != nil {
+			return err
+		}
+		// The same publication set, model/policy/actor/source/body holds and final
+		// clock are checked after every physical effect and before SQL commit.
+		return r.checkMemoryGeneratedHoldInTx(tx, hold, "native")
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		return 0, err
+	}
+	return merged, nil
+}
