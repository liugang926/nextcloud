diff --git a/internal/types/memory_generated_decision.go b/internal/types/memory_generated_decision.go
new file mode 100644
index 00000000..a4ed60ce
--- /dev/null
+++ b/internal/types/memory_generated_decision.go
@@ -0,0 +1,44 @@
+package types
+
+import (
+	"encoding/json"
+	"io"
+	"strings"
+)
+
+// An empty statement is an explicit model decline. Missing, repeated or
+// unsupported fields must not be converted into a successful empty result.
+func DecodeMemoryConsolidationDecision(body string) (string, error) {
+	decoder := json.NewDecoder(strings.NewReader(body))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return "", ErrMemoryOriginalUnavailable
+	}
+	seen := false
+	statement := ""
+	for decoder.More() {
+		key, err := decoder.Token()
+		if err != nil || key != "statement" || seen {
+			return "", ErrMemoryOriginalUnavailable
+		}
+		seen = true
+		value, err := decoder.Token()
+		if err != nil {
+			return "", ErrMemoryOriginalUnavailable
+		}
+		text, ok := value.(string)
+		if !ok {
+			return "", ErrMemoryOriginalUnavailable
+		}
+		statement = text
+	}
+	token, err = decoder.Token()
+	if err != nil || token != json.Delim('}') || !seen {
+		return "", ErrMemoryOriginalUnavailable
+	}
+	var extra interface{}
+	if decoder.Decode(&extra) != io.EOF {
+		return "", ErrMemoryOriginalUnavailable
+	}
+	return strings.TrimSpace(statement), nil
+}
