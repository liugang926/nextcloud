+package types
+
+import "time"
+
+// Controls survive deletion. SQL triggers advance them for every physical
+// mutation, including raw writes; equal bytes at a later revision are unknown.
+type MemoryDerivedControl struct {
+	TenantID   uint64 `gorm:"primaryKey"`
+	SubjectID  string `gorm:"primaryKey"`
+	ObjectKind string `gorm:"primaryKey"`
+	ObjectID   string `gorm:"primaryKey"`
+	Revision   uint64
+	Present    bool
+}
+
+func (MemoryDerivedControl) TableName() string { return "memory_derived_controls" }
+
+type MemoryDerivedCollection struct {
+	TenantID  uint64 `gorm:"primaryKey"`
+	SubjectID string `gorm:"primaryKey"`
+	Revision  uint64
+}
+
+func (MemoryDerivedCollection) TableName() string { return "memory_derived_collections" }
+
+// MaterialJSON is the actual producer output. It is a retained body152 slot,
+// not a digest-current admission. The fact binds its exact original bytes.
+type MemoryDerivedPublication struct {
+	ID                   string `gorm:"primaryKey"`
+	TenantID             uint64
+	SubjectID            string
+	ObjectKind           string
+	ObjectID             string
+	Revision             uint64
+	ProducerKind         string
+	DerivationID         string
+	InputAdmissionID     string
+	ExecutionAdmissionID string
+	CommitID             string
+	ParentPublicationID  string
+	InputsJSON           string
+	AuthorSelector       string
+	MaterialJSON         string `json:"-"`
+	MaterialSHA256       string
+	MaterialDigest       string
+	Present              bool
+	Digest               string
+	CreatedAt            time.Time
+}
+
+func (MemoryDerivedPublication) TableName() string { return "memory_derived_publications" }
+
+type MemoryDerivedBodyReceipt struct {
+	PublicationID        string `gorm:"primaryKey"`
+	PublicationDigest    string
+	SlotID               string
+	BodyID               string
+	HeadRevision         int64
+	SourceIdentitySHA256 string
+	MaterialSHA256       string
+	Digest               string
+	CreatedAt            time.Time
+}
+
+func (MemoryDerivedBodyReceipt) TableName() string { return "memory_derived_body_receipts" }
+
+type MemoryDerivedInputProof struct {
+	DerivationID      string
+	PublicationID     string
+	PublicationDigest string
+	BodyReceiptDigest string
+	ObjectKind        string
+	ObjectID          string
+	Revision          uint64
+	MaterialDigest    string
+}
+type MemoryDerivedManifest struct {
+	TenantID           uint64
+	SubjectID          string
+	CollectionRevision uint64
+	Inputs             []MemoryDerivedInputProof
+	Digest             string
+}
+type MemoryDerivedBlock struct {
+	ID        string
+	TenantID  uint64
+	SubjectID string
+	BlockText string
+	ItemCount int
+	Inputs    []MemoryDerivedInputProof
+}
+type MemoryDerivedSnapshot struct {
+	Manifest   MemoryDerivedManifest
+	Block      *MemoryDerivedBlock
+	Items      []*MemoryItem
+	Topics     []*MemoryTopicStat
+	Tombstones []*MemoryTombstone
+}
+
+// A native explicit producer captures this through the actual message reader.
+// It is not an extraction enqueue admission or an editable cached body.
+type MemoryDerivedNativeSource struct {
+	Actor    MemoryOriginalActor
+	Plan     *MessageMaterialReadPlan
+	Material *MessageMaterialSnapshot
+}
