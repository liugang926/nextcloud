diff --git a/internal/application/service/model_current_lifetime_sql_actual_test.go b/internal/application/service/model_current_lifetime_sql_actual_test.go
new file mode 100644
index 00000000..ea9a9d23
--- /dev/null
+++ b/internal/application/service/model_current_lifetime_sql_actual_test.go
@@ -0,0 +1,158 @@
+package service
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/utils"
+	"github.com/stretchr/testify/require"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func runCurrentModelLifetimeSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"ordinary_unary", "held_actor_before_snapshot", "held_actor_before_call", "actor_revoked_inside_unary", "state_revoked_inside_stream", "ordinary_stream_current", "unconsumed_stream_close"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, svc, _, reader := actualOriginalModelServices(t, f)
+			var calls atomic.Int64
+			providerStarted := make(chan struct{})
+			providerJoined := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				_, _ = io.Copy(io.Discard, r.Body)
+				calls.Add(1)
+				defer close(providerJoined)
+				close(providerStarted)
+				if mode == "unconsumed_stream_close" {
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"ADMITTED_PREFIX\"},\"finish_reason\":null}]}\n\n"))
+					w.(http.Flusher).Flush()
+					<-r.Context().Done()
+					return
+				}
+				if mode == "actor_revoked_inside_unary" {
+					require.NoError(t, f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false).Error)
+					<-r.Context().Done()
+					return
+				}
+				if mode == "state_revoked_inside_stream" {
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"ADMITTED_PREFIX\"},\"finish_reason\":null}]}\n\n"))
+					w.(http.Flusher).Flush()
+					require.NoError(t, f.db.Model(&types.Model{}).Where("id=?", "real-current-model").Update("status", types.ModelStatusDownloadFailed).Error)
+					_, _ = w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"POST_REVOKE_TAIL\"},\"finish_reason\":\"stop\"}]}\n\n"))
+					w.(http.Flusher).Flush()
+					<-r.Context().Done()
+					return
+				}
+				if mode == "ordinary_stream_current" {
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = w.Write([]byte("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"AUTHORED_OUTPUT\"},\"finish_reason\":null}]}\n\ndata: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"))
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"id":"actual-current-provider","choices":[{"index":0,"message":{"role":"assistant","content":"AUTHORED_OUTPUT"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1}}`))
+			}))
+			defer server.Close()
+			utils.SetSSRFWhitelistFromRaw("127.0.0.1")
+			t.Cleanup(utils.ResetSSRFWhitelistForTest)
+			model := actualModelLiteral("real-current-model", 7)
+			model.Parameters.BaseURL = server.URL
+			require.NoError(t, svc.CreateModel(f.ctx, model))
+			ctx, cancel := context.WithTimeout(f.ctx, 8*time.Second)
+			defer cancel()
+			if mode == "held_actor_before_snapshot" || mode == "held_actor_before_call" {
+				read, err := reader.BeginModelOriginalRead(ctx, model.ID, model.OriginalProof)
+				require.NoError(t, err)
+				if mode == "held_actor_before_snapshot" {
+					require.NoError(t, f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false).Error)
+					_, _, err = read.Snapshot()
+					require.Error(t, err)
+				} else {
+					client, err := svc.GetChatModel(read.Context(), model.ID)
+					require.NoError(t, err)
+					require.NoError(t, f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false).Error)
+					_, err = client.Chat(read.Context(), []chat.Message{{Role: "user", Content: "genuine input"}}, &chat.ChatOptions{})
+					require.Error(t, err)
+				}
+				require.NoError(t, read.Close())
+				require.Zero(t, calls.Load())
+			} else {
+				client, err := svc.GetChatModel(ctx, model.ID)
+				require.NoError(t, err)
+				if mode == "unconsumed_stream_close" {
+					frames, err := client.ChatStream(ctx, []chat.Message{{Role: "user", Content: "genuine ordinary input"}}, &chat.ChatOptions{})
+					require.NoError(t, err)
+					select {
+					case <-providerStarted:
+					case <-ctx.Done():
+						t.Fatal("actual provider did not start")
+					}
+					lifetime, ok := client.(originalModelClientLifetime)
+					require.True(t, ok)
+					closed := make(chan error, 1)
+					go func() { closed <- lifetime.CloseOriginal() }()
+					select {
+					case err := <-closed:
+						require.NoError(t, err)
+					case <-ctx.Done():
+						t.Fatal("owned close failed to join an unconsumed actual provider")
+					}
+					for frame := range frames {
+						t.Errorf("closed unconsumed stream published frame type %s", frame.ResponseType)
+					}
+					require.Error(t, lifetime.RecheckOriginal(), "the output boundary observes closed material even if no error frame is consumed")
+				} else if mode == "ordinary_stream_current" || mode == "state_revoked_inside_stream" {
+					frames, err := client.ChatStream(ctx, []chat.Message{{Role: "user", Content: "genuine ordinary input"}}, &chat.ChatOptions{})
+					require.NoError(t, err)
+					content := ""
+					completed := false
+					for frame := range frames {
+						if frame.ResponseType == types.ResponseTypeAnswer {
+							content += frame.Content
+							if frame.Done {
+								completed = true
+							}
+						}
+					}
+					if mode == "ordinary_stream_current" {
+						require.Equal(t, "AUTHORED_OUTPUT", content)
+						require.True(t, completed)
+					} else {
+						require.False(t, completed)
+						require.NotContains(t, content, "POST_REVOKE_TAIL")
+					}
+				} else {
+					result, err := client.Chat(ctx, []chat.Message{{Role: "user", Content: "genuine ordinary input"}}, &chat.ChatOptions{})
+					if mode == "actor_revoked_inside_unary" {
+						require.Error(t, err)
+						require.Nil(t, result)
+					} else {
+						require.NoError(t, err)
+						require.Equal(t, "AUTHORED_OUTPUT", result.Content)
+					}
+				}
+				select {
+				case <-providerStarted:
+				case <-ctx.Done():
+					t.Fatal("actual provider did not start")
+				}
+				select {
+				case <-providerJoined:
+				case <-ctx.Done():
+					t.Fatal("actual provider did not join")
+				}
+				require.EqualValues(t, 1, calls.Load())
+			}
+			var leases int64
+			require.NoError(t, f.db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&leases).Error)
+			require.Zero(t, leases)
+		})
+	}
+}
+func TestCurrentModelLifetimeActualSQLite(t *testing.T)   { runCurrentModelLifetimeSQL(t, false) }
+func TestPostgresCurrentModelLifetimeActual(t *testing.T) { runCurrentModelLifetimeSQL(t, true) }
diff --git a/internal/application/service/model_current_single_pool_sql_actual_test.go b/internal/application/service/model_current_single_pool_sql_actual_test.go
new file mode 100644
index 00000000..4a5895b8
--- /dev/null
+++ b/internal/application/service/model_current_single_pool_sql_actual_test.go
@@ -0,0 +1,49 @@
+package service
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"testing"
+	"time"
+)
+
+// Real single-pool ordering: final SQL owns the sole connection first. The
+// same production Recheck used by the stream watcher then demonstrably waits
+// for that pool. Final recheck must use its owned tx without waiting for a
+// mutex held by the outside pool waiter. No injected DB error or sleep barrier.
+func runCurrentModelSinglePoolSQL(t *testing.T, pg bool) {
+	f := newMemAtomicSQLFixture(t, pg)
+	_, _, _, reader := actualOriginalModelServices(t, f)
+	ctx, cancel := context.WithTimeout(f.ctx, 8*time.Second)
+	defer cancel()
+	read, err := reader.BeginModelOriginalRead(ctx, f.model.GetModelID(), nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { cancel(); _ = read.Close() })
+	_, proof, err := read.Snapshot()
+	require.NoError(t, err)
+	pool, err := f.db.DB()
+	require.NoError(t, err)
+	pool.SetMaxOpenConns(1)
+	watcherResult := make(chan error, 1)
+	err = f.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		waitBefore := pool.Stats().WaitCount
+		go func() { watcherResult <- read.Recheck() }()
+		require.Eventually(t, func() bool { return pool.Stats().WaitCount > waitBefore }, time.Second, 10*time.Millisecond, "actual driver pool records the live watcher waiting for the already-owned final connection")
+		return repository.CheckCurrentModelOriginalHolds(read.Context(), tx, *proof)
+	})
+	require.NoError(t, err, "final commit does not wait on a state mutex held by a pool waiter")
+	select {
+	case err = <-watcherResult:
+		require.NoError(t, err)
+	case <-ctx.Done():
+		t.Fatal("actual pool waiter did not join after final transaction released its connection")
+	}
+	require.NoError(t, read.Close())
+	var leases int64
+	require.NoError(t, f.db.Table("original_body_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&leases).Error)
+	require.Zero(t, leases)
+}
+func TestCurrentModelSinglePoolActualSQLite(t *testing.T)   { runCurrentModelSinglePoolSQL(t, false) }
