+func runMemAtomicSQLAdmission(t *testing.T, pg bool) {
+	for _, mode := range []string{"minimal_native_admission_commit", "minimal_native_scheduler_queue"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			if mode == "minimal_native_admission_commit" {
+				tenant, err := repository.NewTenantRepository(f.db).GetTenantByID(f.ctx, f.scope.TenantID)
+				require.NoError(t, err)
+				cfg := *tenant.MemoryConfig
+				cfg.Normalize()
+				policy, err := json.Marshal(&cfg)
+				require.NoError(t, err)
+				request, err := f.admissions.PrepareMemoryOriginalCapture(f.ctx, f.scope, f.session.ID, f.assistant.ID, f.model.GetModelID(), types.LanguageNameFromContext(f.ctx), types.MemoryOriginalBytesDigest(policy))
+				require.NoError(t, err)
+				selectedModel, err := (actualMemoryModels{model: f.model.actualMemoryModel, db: f.db}).GetModelByID(f.ctx, f.model.GetModelID())
+				require.NoError(t, err)
+				require.Equal(t, f.scope.TenantID, selectedModel.TenantID)
+				require.Equal(t, types.ModelStatusActive, selectedModel.Status)
+				modelRead, err := f.admissions.(interfaces.ModelOriginalLifetimeReader).BeginModelOriginalRead(f.ctx, selectedModel.ID, nil)
+				require.NoError(t, err)
+				_, modelProof, err := modelRead.Snapshot()
+				require.NoError(t, err)
+				require.NoError(t, modelRead.Close())
+				request.EnqueueModelID = selectedModel.ID
+				request.EnqueueModelDigest = modelProof.Digest
+				request.EnqueueModelProof = *modelProof
+				request.DispatchNotBefore = time.Now().UTC().Add(cfg.ExtractDelay()).Truncate(time.Microsecond)
+				input, err := f.reader.CaptureAndPersistMemoryOriginal(f.ctx, *request, func(owned context.Context, input *types.MemoryOriginalInput) error {
+					_, send, err := f.admissions.AdmitMemoryOriginal(owned, input, time.Minute)
+					if err == nil && !send {
+						return fmt.Errorf("legitimate first admission did not schedule")
+					}
+					return err
+				})
+				require.NoError(t, err, "the real nested subject transaction must allow valid original admission")
+				require.NotEmpty(t, input.ID)
+				require.Len(t, input.Digest, 64)
+				require.Empty(t, input.Material.Messages)
+				loaded, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, input.ID)
+				require.NoError(t, err)
+				require.Equal(t, input.Digest, loaded.Digest)
+				var dispatch types.MemoryOriginalDispatch
+				require.NoError(t, f.db.Where("admission_id=?", input.ID).Take(&dispatch).Error)
+				require.Equal(t, input.ID, dispatch.AdmissionID)
+				require.True(t, dispatch.NotBefore.Equal(input.Request.DispatchNotBefore))
+				require.Equal(t, types.MemoryOriginalBytesDigest([]byte(dispatch.Payload)), dispatch.PayloadDigest)
+				require.Nil(t, dispatch.LastEnqueuedAt)
+				require.Nil(t, dispatch.CompletedAt)
+				require.Zero(t, dispatch.Attempts)
+				require.Nil(t, f.queue.task, "admit commits the outbox intent without bypassing relay")
+			} else {
+				f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+				relayMemAtomicSQLScheduled(t, f)
+				require.NotNil(t, f.queue.task, "real Schedule plus durable outbox relay must enqueue without a fabricated task")
+				var payload types.MemoryExtractPayload
+				require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &payload))
+				require.NotEmpty(t, payload.OriginalAdmissionID)
+				require.Len(t, payload.OriginalDigest, 64)
+				require.EqualValues(t, 1, payload.OriginalRevision)
+				loaded, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, payload.OriginalAdmissionID)
+				require.NoError(t, err)
+				require.Equal(t, payload.OriginalDigest, loaded.Digest)
+				require.Equal(t, f.assistant.ID, loaded.Request.TriggerMessageID)
+			}
+			assert.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_admissions"))
+			progress := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			assert.True(t, progress.Pending)
+			assert.True(t, progress.Cursor.At.IsZero())
+			assert.Empty(t, progress.Cursor.ID)
+			assert.EqualValues(t, 1, progress.Revision)
+			assert.NotEmpty(t, progress.OriginalAdmissionID)
+			assert.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+			assert.Zero(t, f.model.calls)
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func runMemAtomicSQLWholeResult(t *testing.T, pg bool) {
+	for _, mode := range []string{"whole_two_operation_success", "whole_noop_success", "original_changed_after_queue", "actor_changed_after_queue", "model_changed_after_queue", "original_changed_after_model", "actor_changed_after_model", "model_changed_after_model"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			f.model.twoOperations = mode == "whole_two_operation_success"
+			f.model.noop = mode == "whole_noop_success"
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			require.NotNil(t, f.queue.task, "the genuine original intent relay must enqueue before the fault")
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			require.True(t, before.Pending)
+			require.True(t, before.Cursor.At.IsZero())
+			require.Empty(t, before.Cursor.ID)
+			faultApplied := false
+			applyFault := func() error {
+				var result *gorm.DB
+				switch mode {
+				case "original_changed_after_queue", "original_changed_after_model":
+					result = f.db.Exec("UPDATE messages SET content=? WHERE id=?", actualMemoryUnadmittedText, f.user.ID)
+				case "actor_changed_after_queue", "actor_changed_after_model":
+					result = f.db.Model(&types.User{}).Where("id=?", f.session.UserID).Update("is_active", false)
+				default:
+					result = f.db.Model(&types.Model{}).Where("id=? AND tenant_id=?", f.model.GetModelID(), f.scope.TenantID).Update("name", "Changed active model selector after captured admission")
+				}
+				if result.Error != nil {
+					return result.Error
+				}
+				if result.RowsAffected != 1 {
+					return fmt.Errorf("fault failed to update one real SQL row")
+				}
+				faultApplied = true
+				return nil
+			}
+			afterModel := mode == "original_changed_after_model" || mode == "actor_changed_after_model" || mode == "model_changed_after_model"
+			positive := mode == "whole_two_operation_success" || mode == "whole_noop_success"
+			if afterModel {
+				f.model.afterCall = applyFault
+			} else if !positive {
+				require.NoError(t, applyFault())
+			}
+			require.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+			worker, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			handleErr := f.service.Handle(worker, f.queue.task)
+			if positive {
+				require.NoError(t, handleErr)
+				require.Equal(t, 1, f.model.calls)
+				expected := int64(0)
+				if mode == "whole_two_operation_success" {
+					expected = 2
+				}
+				assert.Equal(t, expected, memAtomicSQLCount(t, f, "memory_items"))
+				assert.Equal(t, expected, memAtomicSQLCount(t, f, "memory_original_derivations"), "each committed operation has its own original dependency fact")
+				assert.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"), "whole result has one successful immutable checkpoint")
+				after := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+				assert.False(t, after.Pending)
+				assert.True(t, after.Cursor.After(before.Cursor))
+				var receipt types.MemoryOriginalCheckpoint
+				require.NoError(t, f.db.Table("memory_original_checkpoints").Where("tenant_id=? AND subject_id=? AND session_id=?", f.scope.TenantID, f.scope.SubjectID, f.session.ID).Take(&receipt).Error)
+				assert.Equal(t, before.OriginalAdmissionID, receipt.InputAdmissionID)
+				assert.Equal(t, before.Revision, receipt.PendingRevision)
+				assert.Equal(t, before.Cursor, receipt.From)
+				assert.Equal(t, after.Cursor, receipt.To)
+				assert.Len(t, receipt.InputDigest, 64)
+				assert.Len(t, receipt.ModelResultDigest, 64)
+				assert.Len(t, receipt.OperationsDigest, 64)
+				assert.Len(t, receipt.Digest, 64)
+				assert.NotEmpty(t, receipt.ExecutionAdmissionID)
+				assert.NotEmpty(t, receipt.Recipe)
+				// Executions intentionally have no tenant/subject columns;
+				// authority is its exact immutable admission dependency.
+				var execution types.MemoryOriginalExecution
+				require.NoError(t, f.db.Table("memory_original_executions").Where("id=?", receipt.ExecutionAdmissionID).Take(&execution).Error)
+				assert.Equal(t, receipt.ExecutionAdmissionID, execution.ID)
+				assert.Equal(t, receipt.InputAdmissionID, execution.InputAdmissionID)
+				assert.Equal(t, receipt.InputDigest, execution.InputDigest)
+				assert.Equal(t, f.model.GetModelID(), execution.ModelID)
+				assert.Len(t, execution.ModelDigest, 64)
+				assert.Len(t, execution.PolicyDigest, 64)
+				assert.Len(t, execution.Digest, 64)
+				// Verify existing append-only producer facts after actual DB
+				// roundtrip; this does not update or freshly sign any body/fact.
+				executionCopy := execution
+				executionCopy.Digest = ""
+				expectedExecutionDigest, digestErr := repository.KnowledgeInputDigest(executionCopy)
+				require.NoError(t, digestErr)
+				assert.Equal(t, execution.Digest, expectedExecutionDigest, "PG timestamp precision must preserve the original execution digest")
+				receiptCopy := receipt
+				receiptCopy.Digest = ""
+				expectedReceiptDigest, digestErr := repository.KnowledgeInputDigest(receiptCopy)
+				require.NoError(t, digestErr)
+				assert.Equal(t, receipt.Digest, expectedReceiptDigest, "PG roundtrip must preserve the successful checkpoint digest")
+				var origins []types.MemoryOriginalDerivation
+				require.NoError(t, f.db.Where("commit_id=?", receipt.ID).Find(&origins).Error)
+				assert.Len(t, origins, int(expected))
+				for _, origin := range origins {
+					originCopy := origin
+					originCopy.Digest = ""
+					expectedOriginDigest, digestErr := repository.KnowledgeInputDigest(originCopy)
+					require.NoError(t, digestErr)
+					assert.Equal(t, origin.Digest, expectedOriginDigest, "the SQL derivation is the original canonical producer fact")
+					assert.Equal(t, receipt.InputAdmissionID, origin.InputAdmissionID)
+					assert.Equal(t, receipt.ExecutionAdmissionID, origin.ExecutionAdmissionID)
+				}
+				var payload types.MemoryExtractPayload
+				require.NoError(t, json.Unmarshal(f.queue.task.Payload(), &payload))
+				completed, verifyErr := f.outbox.VerifyMemoryOriginalCompletion(f.ctx, payload)
+				require.NoError(t, verifyErr)
+				assert.True(t, completed, "only actual original/result receipts prove whole completion")
+				assert.Equal(t, f.originals, actualMemoryFacts(t, f.db, f.user.ID))
+			} else {
+				assert.Error(t, handleErr)
+				assert.True(t, faultApplied)
+				expectedCalls := 0
+				if afterModel {
+					expectedCalls = 1
+				}
+				assert.Equal(t, expectedCalls, f.model.calls)
+				assertMemAtomicSQLNoEffects(t, f, before)
+			}
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryOriginalAtomicAdmissionActualSQLite(t *testing.T)   { runMemAtomicSQLAdmission(t, false) }
+func TestPostgresMemoryOriginalAtomicAdmissionActual(t *testing.T) { runMemAtomicSQLAdmission(t, true) }
+func TestMemoryOriginalAtomicWholeResultActualSQLite(t *testing.T) {
+	runMemAtomicSQLWholeResult(t, false)
+}
+func TestPostgresMemoryOriginalAtomicWholeResultActual(t *testing.T) {
+	runMemAtomicSQLWholeResult(t, true)
+}
