+		Topics   []string                 `json:"topics"`
+	}{Memories: []map[string]interface{}{{"action": action, "kind": "fact", "topic": "development editor", "content": content, "importance": 5, "source": 1, "target": target}}, Topics: []string{"development editor"}}
+	bytes, err := json.Marshal(response)
