+CREATE TABLE model_definition_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id INTEGER NOT NULL,revision BIGINT NOT NULL,definition_json TEXT NOT NULL,definition_digest TEXT NOT NULL,previous_id TEXT NOT NULL DEFAULT '',previous_digest TEXT NOT NULL DEFAULT '',author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at DATETIME NOT NULL,UNIQUE(model_id,revision));
+CREATE TABLE model_credential_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id INTEGER NOT NULL,revision BIGINT NOT NULL,credential_json TEXT NOT NULL,plain_digest TEXT NOT NULL,previous_id TEXT NOT NULL DEFAULT '',previous_digest TEXT NOT NULL DEFAULT '',author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at DATETIME NOT NULL,UNIQUE(model_id,revision));
+CREATE TABLE model_state_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id INTEGER NOT NULL,epoch BIGINT NOT NULL,definition_id TEXT NOT NULL REFERENCES model_definition_originals(id),credential_id TEXT NOT NULL REFERENCES model_credential_originals(id),status TEXT NOT NULL,is_default BOOLEAN NOT NULL,managed_by TEXT NOT NULL,author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at DATETIME NOT NULL,UNIQUE(model_id,epoch));
+CREATE TABLE model_original_body_receipts(origin_id TEXT PRIMARY KEY,origin_kind TEXT NOT NULL CHECK(origin_kind IN('definition','credential')),origin_digest TEXT NOT NULL,tenant_id INTEGER NOT NULL,slot_id TEXT NOT NULL,body_id TEXT NOT NULL REFERENCES original_body_payloads(id),head_revision BIGINT NOT NULL CHECK(head_revision>0),source_identity_sha256 TEXT NOT NULL,body_digest TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at DATETIME NOT NULL);
+ALTER TABLE memory_original_executions ADD COLUMN model_proof_json TEXT NOT NULL DEFAULT '';
+CREATE TRIGGER model_original_version_no_delete BEFORE DELETE ON model_original_control_versions BEGIN SELECT RAISE(ABORT,'model controls are retained'); END;
+CREATE TRIGGER model_original_version_no_replace BEFORE INSERT ON model_original_control_versions WHEN EXISTS(SELECT 1 FROM model_original_control_versions WHERE model_id=NEW.model_id) BEGIN SELECT RAISE(ABORT,'model controls cannot be replaced'); END;
