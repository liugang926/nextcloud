+func memoryWriteOptions(db *gorm.DB) *sql.TxOptions {
+	options := &sql.TxOptions{}
+	if db.Dialector.Name() == "postgres" {
+		options.Isolation = sql.LevelRepeatableRead
+	}
+	return options
+}
+
+func memoryExecutionDigest(value *types.MemoryOriginalExecution) (string, error) {
+	copy := *value
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryCheckpointDigest(value *types.MemoryOriginalCheckpoint) (string, error) {
+	copy := *value
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryDerivationDigest(value *types.MemoryOriginalDerivation) (string, error) {
+	copy := *value
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryFactTime() time.Time { return time.Now().UTC().Truncate(time.Microsecond) }
+func memoryFactTimePointer(value *time.Time) *time.Time {
+	if value == nil {
+		return nil
+	}
+	canonical := value.UTC().Truncate(time.Microsecond)
+	return &canonical
+}
+
+func checkMemoryEnqueueModelInTx(tx *gorm.DB, input *types.MemoryOriginalInput) error {
+	if input.Request.EnqueueModelID == "" || input.Request.EnqueueModelDigest == "" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var tenant types.Tenant
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", input.Request.TenantID).Take(&tenant).Error; err != nil {
+		return err
+	}
+	_, origin, err := readMemoryPolicyOriginalInTx(tx, &tenant)
+	if err != nil {
+		return err
+	}
+	if !input.Request.EnqueuePolicyProof.Valid() || origin.Proof() != input.Request.EnqueuePolicyProof || origin.PolicyDigest != input.Request.EnqueuePolicyDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = checkMemoryPolicyHoldsInTx(tx, tenant.ID, origin.Proof(), input.Request.EnqueuePolicyProof); err != nil {
+		return err
+	}
+	if input.Request.EnqueueModelProof.ModelID != input.Request.EnqueueModelID || input.Request.EnqueueModelProof.Digest != input.Request.EnqueueModelDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = checkQueuedModelOriginalInTx(tx, input.Request.TenantID, input.Request.EnqueueModelProof); err != nil {
+		return err
+	}
+	return tx.Statement.Context.Err()
+}
+
+// Operational touch/use counters are not immutable body material.
+func memoryItemMaterialDigest(item *types.MemoryItem) (string, error) {
+	return KnowledgeInputDigest(struct {
+		Kind, Content, Topic, NormalizedKey, Origin, Status, SourceSessionID, SourceMessageID, ReplacesID, SupersededBy string
+		Importance                                                                                                      int
+		ValidFrom                                                                                                       time.Time
+		ExpiresAt, InvalidAt                                                                                            *time.Time
+	}{item.Kind, item.Content, item.Topic, item.NormalizedKey, item.Origin, item.Status, item.SourceSessionID, item.SourceMessageID, item.ReplacesID, item.SupersededBy, item.Importance, item.ValidFrom, item.ExpiresAt, item.InvalidAt})
+}
+
+func checkMemoryExecutionInTx(tx *gorm.DB, input *types.MemoryOriginalInput, execution *types.MemoryOriginalExecution) error {
+	if execution == nil || execution.InputAdmissionID != input.ID || execution.InputDigest != input.Digest || input.Request.EnqueuePolicyDigest != input.Request.EnqueuePolicyProof.PolicyDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if execution.ModelID != input.Request.EnqueueModelID || execution.ModelDigest != input.Request.EnqueueModelDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var tenant types.Tenant
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", input.Request.TenantID).Take(&tenant).Error; err != nil {
+		return err
+	}
+	cfg, origin, err := readMemoryPolicyOriginalInTx(tx, &tenant)
+	if err != nil {
+		return err
+	}
+	if !cfg.AutoExtractEnabled() || origin.Proof() != (types.MemoryPolicyProof{OriginID: execution.PolicyOriginID, Revision: execution.PolicyRevision, PolicyDigest: execution.PolicyDigest, OriginDigest: execution.PolicyOriginDigest, BodyReceiptDigest: execution.PolicyBodyReceiptDigest}) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = memoryPolicyDescendsFrom(tx, tenant.ID, origin, input.Request.EnqueuePolicyProof); err != nil {
+		return err
+	}
+	if err = checkMemoryPolicyHoldsInTx(tx, tenant.ID, origin.Proof(), input.Request.EnqueuePolicyProof); err != nil {
+		return err
+	}
+	var modelProof types.ModelOriginalProof
+	if json.Unmarshal([]byte(execution.ModelProofJSON), &modelProof) != nil || modelProof != input.Request.EnqueueModelProof || modelProof.Digest != execution.ModelDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err = checkQueuedModelOriginalInTx(tx, input.Request.TenantID, modelProof); err != nil {
+		return err
+	}
+	return tx.Statement.Context.Err()
+}
+
+func (r *memoryOriginalAdmissionRepository) AdmitMemoryOriginalExecution(ctx context.Context, inputID, policy, modelID, modelDigest string) (*types.MemoryOriginalExecution, error) {
+	var execution *types.MemoryOriginalExecution
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		input, err := loadMemoryOriginal(tx, inputID)
+		if err != nil {
+			return err
+		}
+		if derived, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold); derived != nil {
+			if err = r.lockMemoryDerivedAuthorityInTx(ctx, tx, derived, input); err != nil {
+				return err
+			}
+		}
+		if err = r.lockMemoryOriginalFence(ctx, tx, input); err != nil {
+			return err
+		}
+		if err = r.checkMemoryOriginalInTx(ctx, tx, input); err != nil {
+			return err
+		}
+		execution = &types.MemoryOriginalExecution{ID: uuid.NewString(), InputAdmissionID: input.ID, InputDigest: input.Digest, PolicyDigest: policy, ModelID: modelID, ModelDigest: modelDigest, CreatedAt: memoryFactTime()}
+		modelProof, err := json.Marshal(input.Request.EnqueueModelProof)
+		if err != nil {
+			return err
+		}
+		execution.ModelProofJSON = string(modelProof)
+		var tenant types.Tenant
+		if err = tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", input.Request.TenantID).Take(&tenant).Error; err != nil {
+			return err
+		}
+		_, origin, err := readMemoryPolicyOriginalInTx(tx, &tenant)
+		if err != nil {
+			return err
+		}
+		execution.PolicyOriginID = origin.ID
+		execution.PolicyRevision = origin.Revision
+		execution.PolicyOriginDigest = origin.Digest
+		execution.PolicyBodyReceiptDigest = origin.BodyReceiptDigest
+		if err = checkMemoryExecutionInTx(tx, input, execution); err != nil {
+			return err
+		}
+		hold, _ := ctx.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+		if hold == nil {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = r.checkMemoryDerivedHoldInTx(tx, hold, ""); err != nil {
+			return err
+		}
+		derived, err := json.Marshal(hold.Manifest)
+		if err != nil {
+			return err
+		}
+		execution.DerivedInputsJSON = string(derived)
+		execution.DerivedInputsDigest = hold.Manifest.Digest
+		execution.Digest, err = memoryExecutionDigest(execution)
+		if err != nil {
+			return err
+		}
+		if err = tx.Create(execution).Error; err != nil {
+			return err
+		}
+		return ctx.Err()
+	}, memoryWriteOptions(r.db))
+	return execution, err
+}
+
+func loadMemoryExecution(tx *gorm.DB, id, digest string) (*types.MemoryOriginalExecution, error) {
+	var row types.MemoryOriginalExecution
+	if id == "" || digest == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err := tx.Where("id=?", id).Take(&row).Error; err != nil {
+		return nil, err
+	}
+	actual, err := memoryExecutionDigest(&row)
+	if err != nil || actual != row.Digest || actual != digest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &row, nil
+}
+
+func memoryTargetInTx(tx *gorm.DB, input *types.MemoryOriginalInput, op types.MemoryOriginalMutation) (*types.MemoryItem, error) {
+	if op.TargetID == "" || op.TargetPublicationID == "" || op.TargetDigest == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	hold, _ := tx.Statement.Context.Value(memoryDerivedHoldKey{}).(*memoryDerivedHold)
+	if hold == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	scope := interfaces.MemoryScope{TenantID: input.Request.TenantID, SubjectID: input.Request.SubjectID}
+	fact, err := memoryDerivedCurrentPublicationInTx(tx, scope, "memory_item", op.TargetID)
+	if err != nil {
+		return nil, err
+	}
+	if fact.ID != op.TargetPublicationID || fact.MaterialDigest != op.TargetDigest || fact.DerivationID != op.TargetDerivationID || hold.Facts[fact.ID] == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var item types.MemoryItem
+	if err = tx.Session(&gorm.Session{NewDB: true}).Clauses(forUpdateClause()).Where("id=? AND tenant_id=? AND subject_id=?", op.TargetID, scope.TenantID, scope.SubjectID).Take(&item).Error; err != nil {
+		return nil, err
+	}
+	actual, err := memoryItemMaterialDigest(&item)
+	if err != nil || actual != fact.MaterialDigest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	return &item, nil
+}
