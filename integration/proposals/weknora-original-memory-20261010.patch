new file mode 100644
index 00000000..6f5919b5
--- /dev/null
+++ b/internal/application/service/memory_subject_idempotence_sql_actual_test.go
@@ -0,0 +1,120 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+type memEnsureRaceContextKey struct{}
+
+// Real SQL/body callbacks are retained. The race pauses the original caller
+// after its actual missing scoped read, lets another genuine EnsureSubject
+// commit that scope, then resumes the original no-op INSERT/AfterCreate path.
+// Neither a winner row nor body availability/proof is injected by the test.
+func runMemorySubjectIdempotenceSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"first_and_repeat", "real_concurrent_winner", "preSQL_error_refuses", "cancelled_refuses"} {
+		t.Run(mode, func(t *testing.T) {
+			machine, _, ctx := newMemAtomicSQLMessages(t, pg)
+			db := machine.f.db
+			repo := repository.NewMemoryRepository(db)
+			scope := interfaces.MemoryScope{TenantID: 7, SubjectID: types.CallerFromContext(ctx).UserID + "/owned-ensure-subject"}
+			var creates int
+			createName := "actual-ensure-create-observer"
+			require.NoError(t, db.Callback().Create().After("gorm:create").Before("original_body:capture").Register(createName, func(tx *gorm.DB) {
+				if tx.Statement.Table == "memory_subjects" {
+					creates++
+				}
+			}))
+			defer db.Callback().Create().Remove(createName)
+			if mode == "cancelled_refuses" {
+				cancelled, cancel := context.WithCancel(ctx)
+				cancel()
+				subject, err := repo.EnsureSubject(cancelled, scope)
+				require.ErrorIs(t, err, context.Canceled)
+				require.Nil(t, subject)
+				require.Zero(t, creates)
+				return
+			}
+			if mode == "preSQL_error_refuses" {
+				failure := errors.New("owned EnsureSubject preSQL guard refusal")
+				name := "actual-ensure-preSQL-refusal"
+				require.NoError(t, db.Callback().Create().Before("gorm:create").Register(name, func(tx *gorm.DB) {
+					if tx.Statement.Table == "memory_subjects" {
+						tx.AddError(failure)
+					}
+				}))
+				defer db.Callback().Create().Remove(name)
+				subject, err := repo.EnsureSubject(ctx, scope)
+				require.ErrorIs(t, err, failure)
+				require.Nil(t, subject)
+				var rows int64
+				require.NoError(t, db.Model(&types.MemorySubject{}).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Count(&rows).Error)
+				require.Zero(t, rows)
+				return
+			}
+			var winner *types.MemorySubject
+			raceReached := false
+			if mode == "real_concurrent_winner" {
+				owned := context.WithValue(ctx, memEnsureRaceContextKey{}, true)
+				name := "actual-ensure-missing-read-barrier"
+				require.NoError(t, db.Callback().Query().After("gorm:query").Before("original_body:resolve").Register(name, func(tx *gorm.DB) {
+					if raceReached || tx.Statement.Context.Value(memEnsureRaceContextKey{}) != true || tx.Statement.Table != "memory_subjects" || !errors.Is(tx.Error, gorm.ErrRecordNotFound) {
+						return
+					}
+					raceReached = true
+					type result struct {
+						Subject *types.MemorySubject
+						Err     error
+					}
+					done := make(chan result, 1)
+					go func() { other, err := repo.EnsureSubject(ctx, scope); done <- result{other, err} }()
+					select {
+					case result := <-done:
+						if result.Err != nil {
+							tx.AddError(result.Err)
+						} else {
+							winner = result.Subject
+						}
+					case <-time.After(3 * time.Second):
+						tx.AddError(context.DeadlineExceeded)
+					}
+				}))
+				defer db.Callback().Query().Remove(name)
+				ctx = owned
+			}
+			first, err := repo.EnsureSubject(ctx, scope)
+			require.NoError(t, err)
+			require.NotNil(t, first)
+			require.Equal(t, scope.TenantID, first.TenantID)
+			require.Equal(t, scope.SubjectID, first.SubjectID)
+			if mode == "real_concurrent_winner" {
+				require.True(t, raceReached)
+				require.NotNil(t, winner)
+				require.Equal(t, winner.ID, first.ID)
+				require.Equal(t, 2, creates, "winner inserted and losing actual no-op INSERT still reached unchanged body capture path")
+			} else {
+				require.Equal(t, 1, creates)
+			}
+			before := creates
+			again, err := repo.EnsureSubject(ctx, scope)
+			require.NoError(t, err)
+			require.Equal(t, first.ID, again.ID)
+			require.Equal(t, before, creates, "repeat scoped read cannot invoke another no-op create callback")
+			var rows int64
+			require.NoError(t, db.Model(&types.MemorySubject{}).Where("tenant_id=? AND subject_id=?", scope.TenantID, scope.SubjectID).Count(&rows).Error)
+			require.EqualValues(t, 1, rows)
+		})
+	}
+}
+func TestMemorySubjectIdempotenceActualSQLite(t *testing.T) { runMemorySubjectIdempotenceSQL(t, false) }
+func TestPostgresMemorySubjectIdempotenceActual(t *testing.T) {
+	runMemorySubjectIdempotenceSQL(t, true)
+}
