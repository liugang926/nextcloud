+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/hibiken/asynq"
+)
+
+// A completed mutable queue row is never a completion receipt. The atomic
+// result producer owns this verifier and proves all original dependencies.
+type MemoryOriginalCompletionReader interface {
+	VerifyMemoryOriginalCompletion(context.Context, types.MemoryExtractPayload) (bool, error)
+}
+
+type MemoryOriginalOutboxRepository interface {
+	MemoryOriginalCompletionReader
+	ClaimMemoryOriginalDispatch(context.Context, string, time.Time, time.Duration) (*types.MemoryOriginalDispatchClaim, error)
+	FinishMemoryOriginalDispatch(context.Context, *types.MemoryOriginalDispatchClaim, time.Time, time.Time, bool, bool) error
+	ScheduleMemoryOriginalDispatch(context.Context, types.MemoryExtractPayload, time.Time) error
+}
+
+// A worker follow-up re-arms its already persisted original dispatch. It never
+// creates a new original admission from its currently observed transcript.
+type MemoryOriginalDispatchScheduler interface {
+	ScheduleMemoryOriginalDispatch(context.Context, types.MemoryExtractPayload, time.Time) error
+}
+
+// Recovery shutdown cancels and joins its own broker operation. Both the
+// Redis client and Lite adapter expose this context-aware boundary.
+type MemoryOriginalTaskEnqueuer interface {
+	EnqueueContext(context.Context, *asynq.Task, ...asynq.Option) (*asynq.TaskInfo, error)
+}
