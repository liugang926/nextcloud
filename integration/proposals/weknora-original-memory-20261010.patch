+-- Append to reserved156 after the original memory/policy schema. UNKNOWN controls only.
+CREATE TABLE model_original_control_versions(model_id TEXT PRIMARY KEY,definition_revision BIGINT NOT NULL CHECK(definition_revision>0),credential_revision BIGINT NOT NULL CHECK(credential_revision>0),state_epoch BIGINT NOT NULL CHECK(state_epoch>0));
+INSERT INTO model_original_control_versions SELECT id,1,1,1 FROM models;
+CREATE TABLE model_definition_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id BIGINT NOT NULL,revision BIGINT NOT NULL,definition_json TEXT NOT NULL,definition_digest TEXT NOT NULL,previous_id TEXT NOT NULL DEFAULT '',previous_digest TEXT NOT NULL DEFAULT '',author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL,UNIQUE(model_id,revision));
+CREATE TABLE model_credential_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id BIGINT NOT NULL,revision BIGINT NOT NULL,credential_json TEXT NOT NULL,plain_digest TEXT NOT NULL,previous_id TEXT NOT NULL DEFAULT '',previous_digest TEXT NOT NULL DEFAULT '',author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL,UNIQUE(model_id,revision));
+CREATE TABLE model_state_originals(id TEXT PRIMARY KEY,model_id TEXT NOT NULL,tenant_id BIGINT NOT NULL,epoch BIGINT NOT NULL,definition_id TEXT NOT NULL REFERENCES model_definition_originals(id),credential_id TEXT NOT NULL REFERENCES model_credential_originals(id),status TEXT NOT NULL,is_default BOOLEAN NOT NULL,managed_by TEXT NOT NULL,author_selector TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL,UNIQUE(model_id,epoch));
+CREATE TABLE model_original_body_receipts(origin_id TEXT PRIMARY KEY,origin_kind TEXT NOT NULL CHECK(origin_kind IN('definition','credential')),origin_digest TEXT NOT NULL,tenant_id BIGINT NOT NULL,slot_id TEXT NOT NULL,body_id TEXT NOT NULL REFERENCES original_body_payloads(id),head_revision BIGINT NOT NULL CHECK(head_revision>0),source_identity_sha256 TEXT NOT NULL,body_digest TEXT NOT NULL,digest TEXT NOT NULL CHECK(length(digest)=64),created_at TIMESTAMPTZ NOT NULL);
+ALTER TABLE memory_original_executions ADD COLUMN model_proof_json TEXT NOT NULL DEFAULT '';
+CREATE FUNCTION model_original_version_guard() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'model original controls are retained'; END IF;
+ IF NEW.model_id<>OLD.model_id OR NEW.definition_revision<OLD.definition_revision OR NEW.definition_revision>OLD.definition_revision+1 OR NEW.credential_revision<OLD.credential_revision OR NEW.credential_revision>OLD.credential_revision+1 OR NEW.state_epoch<OLD.state_epoch OR NEW.state_epoch>OLD.state_epoch+1 OR (NEW.definition_revision=OLD.definition_revision AND NEW.credential_revision=OLD.credential_revision AND NEW.state_epoch=OLD.state_epoch) THEN RAISE EXCEPTION 'model control must advance monotonically'; END IF; RETURN NEW;
+END $$;
+CREATE TRIGGER model_original_version_guard BEFORE UPDATE OR DELETE ON model_original_control_versions FOR EACH ROW EXECUTE FUNCTION model_original_version_guard();
+CREATE FUNCTION model_original_bump() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+ IF TG_OP='UPDATE' THEN
+  IF OLD.id=NEW.id THEN
+   IF OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.name IS DISTINCT FROM NEW.name OR OLD.display_name IS DISTINCT FROM NEW.display_name OR OLD.type IS DISTINCT FROM NEW.type OR OLD.source IS DISTINCT FROM NEW.source OR OLD.description IS DISTINCT FROM NEW.description OR OLD.is_builtin IS DISTINCT FROM NEW.is_builtin OR (OLD.parameters::jsonb-'api_key'-'app_secret') IS DISTINCT FROM (NEW.parameters::jsonb-'api_key'-'app_secret') OR (OLD.parameters::jsonb->'api_key') IS DISTINCT FROM (NEW.parameters::jsonb->'api_key') OR (OLD.parameters::jsonb->'app_secret') IS DISTINCT FROM (NEW.parameters::jsonb->'app_secret') OR OLD.status IS DISTINCT FROM NEW.status OR OLD.is_default IS DISTINCT FROM NEW.is_default OR OLD.managed_by IS DISTINCT FROM NEW.managed_by OR OLD.deleted_at IS DISTINCT FROM NEW.deleted_at THEN UPDATE model_original_control_versions SET definition_revision=definition_revision+CASE WHEN OLD.tenant_id IS DISTINCT FROM NEW.tenant_id OR OLD.name IS DISTINCT FROM NEW.name OR OLD.display_name IS DISTINCT FROM NEW.display_name OR OLD.type IS DISTINCT FROM NEW.type OR OLD.source IS DISTINCT FROM NEW.source OR OLD.description IS DISTINCT FROM NEW.description OR OLD.is_builtin IS DISTINCT FROM NEW.is_builtin OR (OLD.parameters::jsonb-'api_key'-'app_secret') IS DISTINCT FROM (NEW.parameters::jsonb-'api_key'-'app_secret') THEN 1 ELSE 0 END,credential_revision=credential_revision+CASE WHEN (OLD.parameters::jsonb->'api_key') IS DISTINCT FROM (NEW.parameters::jsonb->'api_key') OR (OLD.parameters::jsonb->'app_secret') IS DISTINCT FROM (NEW.parameters::jsonb->'app_secret') THEN 1 ELSE 0 END,state_epoch=state_epoch+CASE WHEN OLD.status IS DISTINCT FROM NEW.status OR OLD.is_default IS DISTINCT FROM NEW.is_default OR OLD.managed_by IS DISTINCT FROM NEW.managed_by OR OLD.deleted_at IS DISTINCT FROM NEW.deleted_at THEN 1 ELSE 0 END WHERE model_id=NEW.id; END IF;
+   RETURN NEW;
+  END IF;
+ END IF;
+ IF TG_OP='DELETE' OR TG_OP='UPDATE' THEN INSERT INTO model_original_control_versions VALUES(OLD.id,1,1,1) ON CONFLICT(model_id) DO UPDATE SET definition_revision=model_original_control_versions.definition_revision+1,credential_revision=model_original_control_versions.credential_revision+1,state_epoch=model_original_control_versions.state_epoch+1; END IF;
+ IF TG_OP<>'DELETE' THEN INSERT INTO model_original_control_versions VALUES(NEW.id,1,1,1) ON CONFLICT(model_id) DO UPDATE SET definition_revision=model_original_control_versions.definition_revision+1,credential_revision=model_original_control_versions.credential_revision+1,state_epoch=model_original_control_versions.state_epoch+1; RETURN NEW; END IF; RETURN OLD;
+END $$;
+CREATE TRIGGER model_original_insert AFTER INSERT ON models FOR EACH ROW EXECUTE FUNCTION model_original_bump();
+CREATE TRIGGER model_original_update AFTER UPDATE ON models FOR EACH ROW EXECUTE FUNCTION model_original_bump();
+CREATE TRIGGER model_original_delete AFTER DELETE ON models FOR EACH ROW EXECUTE FUNCTION model_original_bump();
+CREATE FUNCTION model_original_immutable() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'model original facts are immutable'; END $$;
+CREATE TRIGGER model_definition_originals_immutable BEFORE UPDATE OR DELETE ON model_definition_originals FOR EACH ROW EXECUTE FUNCTION model_original_immutable();
+CREATE TRIGGER model_credential_originals_immutable BEFORE UPDATE OR DELETE ON model_credential_originals FOR EACH ROW EXECUTE FUNCTION model_original_immutable();
+CREATE TRIGGER model_state_originals_immutable BEFORE UPDATE OR DELETE ON model_state_originals FOR EACH ROW EXECUTE FUNCTION model_original_immutable();
+CREATE TRIGGER model_original_body_receipts_immutable BEFORE UPDATE OR DELETE ON model_original_body_receipts FOR EACH ROW EXECUTE FUNCTION model_original_immutable();
