+				require.NoError(t, err)
+				require.NotNil(t, result)
+				expected := 0
+				if mode == "one_stale_no_candidates" || mode == "model_decline_still_demotes" || mode == "productive_merge_after_demote" {
+					expected = 1
+				}
+				require.Equal(t, expected, result.Demoted)
+				if expected == 1 {
+					require.Equal(t, 1, after.Importance)
+				} else {
+					require.Equal(t, before.Importance, after.Importance)
+				}
+				if mode == "expired_task_is_archived" {
+					require.Equal(t, 1, result.Expired)
+					require.Equal(t, types.MemoryStatusArchived, after.Status)
+				} else if mode != "productive_merge_after_demote" {
+					require.Equal(t, types.MemoryStatusActive, after.Status)
+				}
+				require.Equal(t, before.Content, after.Content)
+				require.Equal(t, before.Origin, after.Origin)
+				require.True(t, before.ValidFrom.Equal(after.ValidFrom))
+				var original types.MemoryGeneratedOriginal
+				require.NoError(t, f.db.Where("tenant_id=? AND subject_id=?", f.scope.TenantID, f.scope.SubjectID).Take(&original).Error)
+				var command types.MemoryConsolidationCommand
+				require.NoError(t, json.Unmarshal([]byte(original.RequestJSON), &command))
+				require.True(t, command.Review)
+				require.False(t, command.ObservedAt.IsZero())
+				require.True(t, command.Cutoff.Equal(command.ObservedAt.Add(-types.MemoryConsolidationStaleTaskAge)))
+				require.Len(t, command.Demotions, expected)
+				if !modelBranch {
+					require.Equal(t, 0, transport.mergeCalls)
+					require.Equal(t, types.MemoryConsolidationMaintenanceRecipe, original.Recipe)
+					require.Empty(t, original.ModelID)
+					require.Empty(t, original.ModelProofJSON)
+					require.Empty(t, original.ModelDigest)
+					require.Equal(t, types.MemoryConsolidationSkipNoCandidates, result.Skipped)
+				} else {
+					require.Equal(t, 1, transport.mergeCalls)
+				}
+				var receipt types.MemoryGeneratedReceipt
+				require.NoError(t, f.db.Where("original_id=?", original.ID).Take(&receipt).Error)
+				require.Equal(t, original.Digest, receipt.OriginalDigest)
+				var effects []types.MemoryGeneratedEffect
+				require.NoError(t, json.Unmarshal([]byte(receipt.EffectManifest), &effects))
+				demotions := 0
+				for _, effect := range effects {
+					if effect.Action != "stale_demote" {
+						continue
+					}
+					demotions++
+					require.Equal(t, task.ID, effect.Proof.ObjectID)
+					require.Equal(t, old.ID, effect.ParentPublicationID)
+					var fact types.MemoryDerivedPublication
+					require.NoError(t, f.db.Where("id=?", effect.Proof.PublicationID).Take(&fact).Error)
+					require.Equal(t, receipt.ID, fact.CommitID)
+					require.Empty(t, fact.AuthorSelector, "time maintenance is not a fabricated human replacement")
+					var body types.MemoryDerivedBodyReceipt
+					require.NoError(t, f.db.Where("publication_id=?", fact.ID).Take(&body).Error)
+					require.NotEmpty(t, body.BodyID)
+				}
+				require.Equal(t, expected, demotions)
+				if mode == "model_decline_still_demotes" {
+					require.Equal(t, 0, result.Merged)
+					require.Equal(t, types.MemoryConsolidationSkipModelDeclined, result.Skipped)
+				}
+				if mode == "productive_merge_after_demote" {
+					require.Equal(t, 1, result.Merged)
+					require.Equal(t, types.MemoryStatusSuperseded, after.Status)
+					require.NotEmpty(t, after.SupersededBy)
+				}
+				lifetime, ok := f.admissions.(interfaces.MemoryDerivedLifetimeReader)
+				require.True(t, ok)
+				read, err := lifetime.BeginMemoryDerivedRead(f.ctx, f.scope)
+				require.NoError(t, err)
+				snapshot, readErr := read.Snapshot()
+				closeErr := read.Close()
+				require.NoError(t, readErr)
+				require.NoError(t, closeErr)
+				found := false
+				for _, item := range snapshot.Items {
+					if item.ID == task.ID {
+						found = true
+						require.Equal(t, after.Importance, item.Importance)
+						require.Equal(t, after.Status, item.Status)
+					}
+				}
+				require.True(t, found)
+				// Even a no-candidate review records its clock: pressing again cannot
+				// mint a second successful maintenance original inside the same minute.
+				count := memAtomicSQLCount(t, f, "memory_generated_receipts")
+				again, err := f.service.ConsolidateNow(f.ctx)
+				require.NoError(t, err)
+				require.Equal(t, types.MemoryConsolidationSkipTooSoon, again.Skipped)
+				require.Equal(t, count, memAtomicSQLCount(t, f, "memory_generated_receipts"))
+			}
+			var retained types.MemoryDerivedPublication
+			require.NoError(t, f.db.Select("id,digest,material_sha256").Where("id=?", old.ID).Take(&retained).Error)
+			require.Equal(t, old.ID, retained.ID)
+			require.Equal(t, old.Digest, retained.Digest)
+			require.Equal(t, old.MaterialSHA256, retained.MaterialSHA256)
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryStaleTaskMaintenanceActualSQLite(t *testing.T) { runMemoryStaleMaintenanceSQL(t, false) }
+func TestPostgresMemoryStaleTaskMaintenanceActual(t *testing.T) {
+	runMemoryStaleMaintenanceSQL(t, true)
+}
