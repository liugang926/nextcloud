+func runModelOriginalMemorySQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"genuine_create_scheduler_Handle", "definition_after_queue", "credential_after_queue", "state_after_queue", "raw_ABA_after_queue", "definition_after_model", "credential_after_model", "state_after_model"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newMemAtomicSQLFixture(t, pg)
+			_, svc, writer, reader := actualOriginalModelServices(t, f)
+			model, proof := actualModelProof(t, reader, f.ctx, f.model.GetModelID())
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, f.model.GetModelID())
+			before := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+			input, err := f.admissions.LoadMemoryOriginalAdmission(f.ctx, before.OriginalAdmissionID)
+			require.NoError(t, err)
+			require.Equal(t, proof, input.Request.EnqueueModelProof)
+			require.Equal(t, proof.Digest, input.Request.EnqueueModelDigest)
+			var original types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", input.ID).Take(&original).Error)
+			relayMemAtomicSQLScheduled(t, f)
+			fault := func() error {
+				switch mode {
+				case "definition_after_queue", "definition_after_model":
+					model.Description = "new genuinely authored definition"
+					return svc.UpdateModel(f.ctx, model)
+				case "credential_after_queue", "credential_after_model":
+					key := "fixture-synthetic-successor-credential"
+					_, err := svc.UpdateModelCredentials(f.ctx, model.ID, &key, nil)
+					return err
+				case "state_after_queue", "state_after_model":
+					return writer.SetModelOriginalStatus(f.ctx, model.ID, proof, types.ModelStatusDownloadFailed)
+				case "raw_ABA_after_queue":
+					if err := f.db.Model(&types.Model{}).Where("id=?", model.ID).Update("name", model.Name+" raw").Error; err != nil {
+						return err
+					}
+					return f.db.Model(&types.Model{}).Where("id=?", model.ID).Update("name", model.Name).Error
+				}
+				return nil
+			}
+			late := mode == "definition_after_model" || mode == "credential_after_model" || mode == "state_after_model"
+			if late {
+				f.model.afterCall = fault
+			} else {
+				require.NoError(t, fault())
+			}
+			worker, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			err = f.service.Handle(worker, f.queue.task)
+			cancel()
+			if mode == "genuine_create_scheduler_Handle" {
+				require.NoError(t, err)
+				require.Equal(t, 1, f.model.calls)
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_items"))
+				require.EqualValues(t, 1, memAtomicSQLCount(t, f, "memory_original_checkpoints"))
+				after := actualMemoryProgress(t, f.db, f.scope, f.session.ID)
+				require.False(t, after.Pending)
+				require.True(t, after.Cursor.After(before.Cursor))
+				var execution types.MemoryOriginalExecution
+				require.NoError(t, f.db.Where("input_admission_id=?", input.ID).Take(&execution).Error)
+				var retained types.ModelOriginalProof
+				require.NoError(t, json.Unmarshal([]byte(execution.ModelProofJSON), &retained))
+				require.Equal(t, proof, retained)
+				require.Equal(t, proof.Digest, execution.ModelDigest)
+			} else {
+				assert.Error(t, err)
+				calls := 0
+				if late {
+					calls = 1
+				}
+				assert.Equal(t, calls, f.model.calls)
+				assertMemAtomicSQLNoEffects(t, f, before)
+			}
+			var unchanged types.MemoryOriginalAdmission
+			require.NoError(t, f.db.Where("id=?", input.ID).Take(&unchanged).Error)
+			require.Equal(t, original, unchanged, "the model producer never rewrites/resigns queued original inputs")
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
