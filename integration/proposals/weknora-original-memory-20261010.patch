+-- SOURCE PREPARATION: requires inventory migration74 and the full prior chain.
+CREATE TABLE memory_original_admissions (
+ id TEXT PRIMARY KEY,
+ tenant_id INTEGER NOT NULL,
+ subject_id TEXT NOT NULL,
+ session_id TEXT NOT NULL,
+ pending_revision INTEGER NOT NULL CHECK (pending_revision > 0),
+ previous_admission_id TEXT NOT NULL DEFAULT '',
+ digest TEXT NOT NULL CHECK (length(digest) = 64),
+ envelope TEXT NOT NULL,
+ created_at DATETIME NOT NULL,
+ UNIQUE(tenant_id, subject_id, session_id, pending_revision),
+ FOREIGN KEY(tenant_id, subject_id) REFERENCES memory_subjects(tenant_id, subject_id)
+);
+ALTER TABLE memory_extraction_sessions ADD COLUMN original_admission_id TEXT NOT NULL DEFAULT '';
+CREATE TRIGGER memory_original_admission_no_update BEFORE UPDATE ON memory_original_admissions
+ BEGIN SELECT RAISE(ABORT, 'memory original admissions are immutable'); END;
+CREATE TRIGGER memory_original_admission_no_delete BEFORE DELETE ON memory_original_admissions
+ BEGIN SELECT RAISE(ABORT, 'memory original admissions are immutable'); END;
+
+CREATE TABLE memory_original_executions (
+ id TEXT PRIMARY KEY, input_admission_id TEXT NOT NULL REFERENCES memory_original_admissions(id),
+ input_digest TEXT NOT NULL, policy_digest TEXT NOT NULL, model_id TEXT NOT NULL, model_digest TEXT NOT NULL,
+ digest TEXT NOT NULL CHECK(length(digest)=64), created_at DATETIME NOT NULL
+);
+CREATE TABLE memory_original_checkpoints (
+ id TEXT PRIMARY KEY, tenant_id INTEGER NOT NULL, subject_id TEXT NOT NULL, session_id TEXT NOT NULL,
+ input_admission_id TEXT NOT NULL REFERENCES memory_original_admissions(id), input_digest TEXT NOT NULL,
+ previous_checkpoint_id TEXT NOT NULL DEFAULT '', execution_admission_id TEXT NOT NULL REFERENCES memory_original_executions(id),
+ pending_revision INTEGER NOT NULL, from_at DATETIME, from_id TEXT NOT NULL DEFAULT '', to_at DATETIME NOT NULL, to_id TEXT NOT NULL,
+ drained INTEGER NOT NULL, model_result_digest TEXT NOT NULL, operations_digest TEXT NOT NULL, operation_manifest TEXT NOT NULL,
+ recipe TEXT NOT NULL, digest TEXT NOT NULL CHECK(length(digest)=64), created_at DATETIME NOT NULL
+);
+CREATE TABLE memory_original_derivations (
+ id TEXT PRIMARY KEY, operation_id TEXT NOT NULL, commit_id TEXT NOT NULL, input_admission_id TEXT NOT NULL REFERENCES memory_original_admissions(id),
+ execution_admission_id TEXT NOT NULL REFERENCES memory_original_executions(id), tenant_id INTEGER NOT NULL, subject_id TEXT NOT NULL,
+ object_kind TEXT NOT NULL, object_id TEXT NOT NULL, action TEXT NOT NULL, body_digest TEXT NOT NULL,
+ parent_derivation_id TEXT NOT NULL DEFAULT '', dependency_json TEXT NOT NULL,
+ digest TEXT NOT NULL CHECK(length(digest)=64), created_at DATETIME NOT NULL
+);
