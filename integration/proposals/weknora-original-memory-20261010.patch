diff --git a/internal/application/repository/model_original.go b/internal/application/repository/model_original.go
new file mode 100644
index 00000000..4168f4e3
--- /dev/null
+++ b/internal/application/repository/model_original.go
@@ -0,0 +1,485 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	modelchat "github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/Tencent/WeKnora/internal/utils"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+var ErrModelOriginalUnknown = errors.New("model original is unknown at the current revision")
+var errModelOriginalNoMutation = errors.New("model original credential mutation is a no-op")
+
+type ModelOriginalAuthorizer func(context.Context, *gorm.DB, uint64, bool) (context.Context, error)
+
+func ConfigureModelOriginalAuthorizer(repo interfaces.ModelRepository, authorize ModelOriginalAuthorizer) {
+	if actual, ok := repo.(*modelRepository); ok {
+		actual.originalAuthorizer = authorize
+	}
+}
+
+type modelOriginalControl struct {
+	ModelID                                            string
+	DefinitionRevision, CredentialRevision, StateEpoch uint64
+}
+
+func (modelOriginalControl) TableName() string              { return "model_original_control_versions" }
+func modelOriginalDigest(value interface{}) (string, error) { return KnowledgeInputDigest(value) }
+func modelDefinitionFactDigest(value types.ModelDefinitionOriginal) (string, error) {
+	value.Digest = ""
+	value.CreatedAt = value.CreatedAt.UTC()
+	return modelOriginalDigest(value)
+}
+func modelCredentialFactDigest(value types.ModelCredentialOriginal) (string, error) {
+	value.Digest = ""
+	value.CreatedAt = value.CreatedAt.UTC()
+	return modelOriginalDigest(value)
+}
+func modelStateFactDigest(value types.ModelStateOriginal) (string, error) {
+	value.Digest = ""
+	value.CreatedAt = value.CreatedAt.UTC()
+	return modelOriginalDigest(value)
+}
+func modelProofDigest(value types.ModelOriginalProof) (string, error) {
+	value.Digest = ""
+	return modelOriginalDigest(value)
+}
+func modelBodyReceiptDigest(value types.ModelOriginalBodyReceipt) (string, error) {
+	value.Digest = ""
+	value.CreatedAt = value.CreatedAt.UTC()
+	return modelOriginalDigest(value)
+}
+func modelControls(tx *gorm.DB, id string) (modelOriginalControl, error) {
+	var row modelOriginalControl
+	err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("model_id=?", id).Take(&row).Error
+	if err == nil && (row.DefinitionRevision == 0 || row.CredentialRevision == 0 || row.StateEpoch == 0) {
+		err = types.ErrMemoryOriginalUnavailable
+	}
+	return row, err
+}
+func modelCredentialCipherInTx(tx *gorm.DB, model *types.Model) (string, string, error) {
+	var row struct{ Parameters string }
+	if err := tx.Table("models").Select("CAST(parameters AS TEXT) AS parameters").Where("id=?", model.ID).Take(&row).Error; err != nil {
+		return "", "", err
+	}
+	var raw struct {
+		APIKey    string `json:"api_key"`
+		AppSecret string `json:"app_secret"`
+	}
+	if json.Unmarshal([]byte(row.Parameters), &raw) != nil {
+		return "", "", types.ErrMemoryOriginalUnavailable
+	}
+	key, keyOK := utils.DecryptStoredSecretLenient(raw.APIKey)
+	secret, secretOK := utils.DecryptStoredSecretLenient(raw.AppSecret)
+	if !keyOK || !secretOK || key != model.Parameters.APIKey || secret != model.Parameters.AppSecret {
+		return "", "", types.ErrMemoryOriginalUnavailable
+	}
+	wire, err := json.Marshal(types.ModelOriginalCredentials{APIKey: raw.APIKey, AppSecret: raw.AppSecret})
+	if err != nil {
+		return "", "", err
+	}
+	digest, err := types.ModelCredentialPlainDigest(model)
+	return string(wire), digest, err
+}
+
+type modelOriginalFacts struct {
+	Definition types.ModelDefinitionOriginal
+	Credential types.ModelCredentialOriginal
+	State      types.ModelStateOriginal
+	Proof      types.ModelOriginalProof
+}
+
+func readModelOriginalInTx(tx *gorm.DB, model *types.Model) (*modelOriginalFacts, error) {
+	control, err := modelControls(tx, model.ID)
+	if err != nil {
+		return nil, err
+	}
+	facts := &modelOriginalFacts{}
+	for _, query := range []struct {
+		value    interface{}
+		where    string
+		revision uint64
+	}{{&facts.Definition, "model_id=? AND revision=?", control.DefinitionRevision}, {&facts.Credential, "model_id=? AND revision=?", control.CredentialRevision}, {&facts.State, "model_id=? AND epoch=?", control.StateEpoch}} {
+		if err = tx.Where(query.where, model.ID, query.revision).Take(query.value).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return nil, ErrModelOriginalUnknown
+			}
+			return nil, err
+		}
+	}
+	definition, err := types.ModelDefinitionBytes(model)
+	if err != nil {
+		return nil, err
+	}
+	defDigest, err := modelDefinitionFactDigest(facts.Definition)
+	if err != nil || defDigest != facts.Definition.Digest || facts.Definition.TenantID != model.TenantID || facts.Definition.DefinitionJSON != string(definition) || facts.Definition.DefinitionDigest != types.MemoryOriginalBytesDigest(definition) {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	cipher, plain, err := modelCredentialCipherInTx(tx, model)
+	if err != nil {
+		return nil, err
+	}
+	credDigest, err := modelCredentialFactDigest(facts.Credential)
+	if err != nil || credDigest != facts.Credential.Digest || facts.Credential.TenantID != model.TenantID || cipher != facts.Credential.CredentialJSON || plain != facts.Credential.PlainDigest {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	stateDigest, err := modelStateFactDigest(facts.State)
+	if err != nil || stateDigest != facts.State.Digest || facts.State.TenantID != model.TenantID || facts.State.DefinitionID != facts.Definition.ID || facts.State.CredentialID != facts.Credential.ID || facts.State.Status != model.Status || facts.State.IsDefault != model.IsDefault || facts.State.ManagedBy != model.ManagedBy || model.DeletedAt.Valid {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	defBody, err := modelOriginalBodyHeadInTx(tx, "definition", facts.Definition.ID, model.TenantID, facts.Definition.Digest, facts.Definition.DefinitionJSON)
+	if err != nil {
+		return nil, err
+	}
+	credBody, err := modelOriginalBodyHeadInTx(tx, "credential", facts.Credential.ID, model.TenantID, facts.Credential.Digest, facts.Credential.CredentialJSON)
+	if err != nil {
+		return nil, err
+	}
+	facts.Proof = types.ModelOriginalProof{ModelID: model.ID, OwnerTenantID: model.TenantID, IsBuiltin: model.IsBuiltin, DefinitionID: facts.Definition.ID, DefinitionDigest: defDigest, DefinitionBodyReceiptDigest: defBody.Receipt.Digest, DefinitionRevision: control.DefinitionRevision, CredentialID: facts.Credential.ID, CredentialDigest: credDigest, CredentialBodyReceiptDigest: credBody.Receipt.Digest, CredentialRevision: control.CredentialRevision, StateID: facts.State.ID, StateDigest: stateDigest, StateEpoch: control.StateEpoch}
+	facts.Proof.Digest, err = modelProofDigest(facts.Proof)
+	return facts, err
+}
+
+func (r *modelRepository) authorizeModelOriginal(ctx context.Context, tx *gorm.DB, tenant uint64, builtin bool) (context.Context, error) {
+	if r.originalAuthorizer == nil {
+		return ctx, types.ErrMemoryOriginalUnavailable
+	}
+	return r.originalAuthorizer(ctx, tx, tenant, builtin)
+}
+func validateModelOriginalInput(model *types.Model) error {
+	if model == nil || model.ID == "" || len(model.ID) > types.ModelIDMaxLen || model.TenantID == 0 || strings.TrimSpace(model.Name) == "" || model.Type == "" || model.Source == "" || model.DeletedAt.Valid || (model.Status != types.ModelStatusActive && model.Status != types.ModelStatusDownloading && model.Status != types.ModelStatusDownloadFailed) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+
+// Full creation/replacement is authoring; partial edits require the old
+// definition AND credential origins. An UNKNOWN current row cannot be adopted.
+func (r *modelRepository) writeModelOriginal(ctx context.Context, requested *types.Model, mode string) error {
+	return r.writeModelOriginalMutation(ctx, requested, mode, nil)
+}
+func (r *modelRepository) writeModelOriginalMutation(ctx context.Context, requested *types.Model, mode string, mutate func(*types.Model) error) error {
+	if requested == nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	copy := *requested
+	if mode == "create" && copy.ID == "" {
+		copy.ID = uuid.NewString()
+	}
+	if mutate == nil {
+		if err := validateModelOriginalInput(&copy); err != nil {
+			return err
+		}
+	}
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if tx.Dialector.Name() == "sqlite" {
+			if err := tx.Exec("UPDATE tenants SET updated_at=updated_at WHERE id=?", types.CallerFromContext(ctx).TenantID).Error; err != nil {
+				return err
+			}
+		}
+		if mutate != nil {
+			var routing types.Model
+			if err := tx.Select("id,tenant_id,is_builtin").Where("id=? AND (tenant_id=? OR is_builtin=?)", copy.ID, types.CallerFromContext(ctx).TenantID, true).Take(&routing).Error; err != nil {
+				return err
+			}
+			copy.TenantID = routing.TenantID
+			copy.IsBuiltin = routing.IsBuiltin
+		}
+		fresh, err := r.authorizeModelOriginal(ctx, tx, copy.TenantID, copy.IsBuiltin)
+		if err != nil {
+			return err
+		}
+		var old *modelOriginalFacts
+		var oldRow types.Model
+		var beforeControl modelOriginalControl
+		if mode != "create" {
+			if err = tx.Clauses(forUpdateClause()).Where("id=?", copy.ID).Take(&oldRow).Error; err != nil {
+				return err
+			}
+			if oldRow.TenantID != copy.TenantID || oldRow.IsBuiltin != copy.IsBuiltin {
+				return access.ErrForbidden
+			}
+			old, err = readModelOriginalInTx(tx, &oldRow)
+			if err != nil && (mode != "replace" || !errors.Is(err, ErrModelOriginalUnknown)) {
+				return err
+			}
+			if mode == "update" && (requested.OriginalProof == nil || *requested.OriginalProof != old.Proof) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			beforeControl, err = modelControls(tx, copy.ID)
+			if err != nil {
+				return err
+			}
+			if mutate != nil {
+				copy = oldRow
+				if err = mutate(&copy); err != nil {
+					if errors.Is(err, errModelOriginalNoMutation) {
+						*requested = oldRow
+						proof := old.Proof
+						requested.OriginalProof = &proof
+						return ctx.Err()
+					}
+					return err
+				}
+			} else if mode == "update" && (copy.Parameters.APIKey != oldRow.Parameters.APIKey || copy.Parameters.AppSecret != oldRow.Parameters.AppSecret) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			copy.CreatedAt = oldRow.CreatedAt
+		} else {
+			copy.CreatedAt = memoryFactTime()
+		}
+		if err = modelchat.NormalizeAuthoredChatDefinition(&copy); err != nil {
+			return err
+		}
+		copy.UpdatedAt = memoryFactTime()
+		if mode == "create" {
+			err = tx.Create(&copy).Error
+		} else {
+			write := tx.Model(&types.Model{}).Where("id=? AND tenant_id=?", copy.ID, copy.TenantID).Select("*").Updates(&copy)
+			err = write.Error
+			if err == nil && write.RowsAffected != 1 {
+				err = types.ErrMemoryOriginalUnavailable
+			}
+		}
+		if err != nil {
+			return err
+		}
+		var actual types.Model
+		if err = tx.Where("id=?", copy.ID).Take(&actual).Error; err != nil {
+			return err
+		}
+		wanted, err := types.ModelDefinitionBytes(&copy)
+		if err != nil {
+			return err
+		}
+		persisted, err := types.ModelDefinitionBytes(&actual)
+		if err != nil || string(wanted) != string(persisted) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		wantCred, err := types.ModelCredentialPlainDigest(&copy)
+		if err != nil {
+			return err
+		}
+		_, gotCred, err := modelCredentialCipherInTx(tx, &actual)
+		if err != nil || wantCred != gotCred {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		control, err := modelControls(tx, actual.ID)
+		if err != nil {
+			return err
+		}
+		// A same-byte human full replacement still creates a new authored
+		// revision. Only this transaction may mint the successor facts.
+		retainDefinition := old != nil && mode != "replace" && string(persisted) == old.Definition.DefinitionJSON
+		if retainDefinition && control.DefinitionRevision != beforeControl.DefinitionRevision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if mode != "create" && !retainDefinition && control.DefinitionRevision == beforeControl.DefinitionRevision {
+			if err = advanceModelControl(tx, actual.ID, "definition_revision", control.DefinitionRevision); err != nil {
+				return err
+			}
+			control.DefinitionRevision++
+		}
+		if mode != "create" && control.CredentialRevision == beforeControl.CredentialRevision {
+			if err = advanceModelControl(tx, actual.ID, "credential_revision", control.CredentialRevision); err != nil {
+				return err
+			}
+			control.CredentialRevision++
+		}
+		if mode != "create" && control.StateEpoch == beforeControl.StateEpoch {
+			if err = advanceModelControl(tx, actual.ID, "state_epoch", control.StateEpoch); err != nil {
+				return err
+			}
+			control.StateEpoch++
+		}
+		actor, err := captureKnowledgeActorSelector(fresh, "")
+		if err != nil {
+			return err
+		}
+		selector, err := json.Marshal(actor)
+		if err != nil {
+			return err
+		}
+		definition := &types.ModelDefinitionOriginal{ID: uuid.NewString(), ModelID: actual.ID, TenantID: actual.TenantID, Revision: control.DefinitionRevision, DefinitionJSON: string(persisted), DefinitionDigest: types.MemoryOriginalBytesDigest(persisted), AuthorSelector: string(selector), CreatedAt: memoryFactTime()}
+		cipher, plain, err := modelCredentialCipherInTx(tx, &actual)
+		if err != nil {
+			return err
+		}
+		credential := &types.ModelCredentialOriginal{ID: uuid.NewString(), ModelID: actual.ID, TenantID: actual.TenantID, Revision: control.CredentialRevision, CredentialJSON: cipher, PlainDigest: plain, AuthorSelector: string(selector), CreatedAt: memoryFactTime()}
+		if old != nil {
+			definition.PreviousID = old.Definition.ID
+			definition.PreviousDigest = old.Definition.Digest
+			credential.PreviousID = old.Credential.ID
+			credential.PreviousDigest = old.Credential.Digest
+		}
+		definition.Digest, err = modelDefinitionFactDigest(*definition)
+		if err != nil {
+			return err
+		}
+		credential.Digest, err = modelCredentialFactDigest(*credential)
+		if err != nil {
+			return err
+		}
+		if retainDefinition {
+			definition = &old.Definition
+		}
+		for _, input := range []struct {
+			kind, id, body, digest string
+			value                  interface{}
+		}{{"definition", definition.ID, definition.DefinitionJSON, definition.Digest, definition}, {"credential", credential.ID, credential.CredentialJSON, credential.Digest, credential}} {
+			if retainDefinition && input.kind == "definition" {
+				continue
+			}
+			producer := context.WithValue(ctx, modelOriginalProducerKey{}, modelOriginalProducerBoundary{Kind: input.kind, ID: input.id, Tenant: actual.TenantID, BodyDigest: bodySHA([]byte(input.body))})
+			if err = tx.WithContext(producer).Create(input.value).Error; err != nil {
+				return err
+			}
+			if err = createModelOriginalBodyReceiptInTx(tx, input.kind, input.id, actual.TenantID, input.digest, input.body); err != nil {
+				return err
+			}
+		}
+		state := &types.ModelStateOriginal{ID: uuid.NewString(), ModelID: actual.ID, TenantID: actual.TenantID, Epoch: control.StateEpoch, DefinitionID: definition.ID, CredentialID: credential.ID, Status: actual.Status, IsDefault: actual.IsDefault, ManagedBy: actual.ManagedBy, AuthorSelector: string(selector), CreatedAt: memoryFactTime()}
+		state.Digest, err = modelStateFactDigest(*state)
+		if err != nil {
+			return err
+		}
+		if err = tx.Create(state).Error; err != nil {
+			return err
+		}
+		facts, err := readModelOriginalInTx(tx, &actual)
+		if err != nil {
+			return err
+		}
+		*requested = actual
+		proof := facts.Proof
+		requested.OriginalProof = &proof
+		return ctx.Err()
+	}, memoryWriteOptions(r.db))
+}
+func advanceModelControl(tx *gorm.DB, id, column string, current uint64) error {
+	if column != "definition_revision" && column != "credential_revision" && column != "state_epoch" {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	result := tx.Table("model_original_control_versions").Where("model_id=? AND "+column+"=?", id, current).Update(column, current+1)
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 1 {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+func (r *modelRepository) CreateModelOriginal(ctx context.Context, model *types.Model) error {
+	return r.writeModelOriginal(ctx, model, "create")
+}
+func (r *modelRepository) UpdateModelOriginal(ctx context.Context, model *types.Model) error {
+	return r.writeModelOriginal(ctx, model, "update")
+}
+func (r *modelRepository) ReplaceModelOriginal(ctx context.Context, model *types.Model) error {
+	return r.writeModelOriginal(ctx, model, "replace")
+}
+
+func (r *modelRepository) UpdateModelCredentialOriginal(ctx context.Context, id string, key, secret *string, clear bool) (*types.Model, error) {
+	result := &types.Model{ID: id}
+	err := r.writeModelOriginalMutation(ctx, result, "credential", func(model *types.Model) error {
+		changed := false
+		if key != nil && (clear || *key != "") && model.Parameters.APIKey != *key {
+			model.Parameters.APIKey = *key
+			changed = true
+		}
+		if secret != nil && (clear || *secret != "") && model.Parameters.AppSecret != *secret {
+			model.Parameters.AppSecret = *secret
+			changed = true
+		}
+		if !changed {
+			return errModelOriginalNoMutation
+		}
+		if model.IsBuiltin {
+			model.ManagedBy = ""
+		}
+		return nil
+	})
+	return result, err
+}
+
+// Downloader has no power to create/rewrite definitions or credential facts.
+// The original immutable definition is its capability; revoked current human
+// write authority is also checked rather than copied from a queued role.
+func (r *modelRepository) SetModelOriginalStatus(ctx context.Context, id string, expected types.ModelOriginalProof, status types.ModelStatus) error {
+	if status != types.ModelStatusActive && status != types.ModelStatusDownloadFailed && status != types.ModelStatusDownloading {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var routing types.Model
+		if err := tx.Select("id,tenant_id,is_builtin").Where("id=?", id).Take(&routing).Error; err != nil {
+			return err
+		}
+		fresh, err := r.authorizeModelOriginal(ctx, tx, routing.TenantID, routing.IsBuiltin)
+		if err != nil {
+			return err
+		}
+		var model types.Model
+		if err = tx.Clauses(forUpdateClause()).Where("id=?", id).Take(&model).Error; err != nil {
+			return err
+		}
+		facts, err := readModelOriginalInTx(tx, &model)
+		if err != nil {
+			return err
+		}
+		if facts.Proof != expected {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if model.Status == status {
+			return ctx.Err()
+		}
+		write := tx.Model(&types.Model{}).Where("id=?", id).Updates(map[string]interface{}{"status": status, "updated_at": memoryFactTime()})
+		if write.Error != nil {
+			return write.Error
+		}
+		if write.RowsAffected != 1 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		control, err := modelControls(tx, id)
+		if err != nil {
+			return err
+		}
+		actor, err := captureKnowledgeActorSelector(fresh, "")
+		if err != nil {
+			return err
+		}
+		selector, err := json.Marshal(actor)
+		if err != nil {
+			return err
+		}
+		state := types.ModelStateOriginal{ID: uuid.NewString(), ModelID: id, TenantID: model.TenantID, Epoch: control.StateEpoch, DefinitionID: facts.Definition.ID, CredentialID: facts.Credential.ID, Status: status, IsDefault: model.IsDefault, ManagedBy: model.ManagedBy, AuthorSelector: string(selector), CreatedAt: memoryFactTime()}
+		state.Digest, err = modelStateFactDigest(state)
+		if err != nil {
+			return err
+		}
+		return tx.Create(&state).Error
+	}, memoryWriteOptions(r.db))
+}
+func (r *modelRepository) DeleteModelOriginal(ctx context.Context, tenant uint64, id string) error {
+	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if _, err := r.authorizeModelOriginal(ctx, tx, tenant, false); err != nil {
+			return err
+		}
+		var model types.Model
+		if err := tx.Clauses(forUpdateClause()).Where("id=? AND tenant_id=?", id, tenant).Take(&model).Error; err != nil {
+			return err
+		}
+		if model.IsBuiltin {
+			return access.ErrForbidden
+		}
+		return tx.Delete(&model).Error
+	}, memoryWriteOptions(r.db))
+}
diff --git a/internal/application/repository/model_original_body.go b/internal/application/repository/model_original_body.go
new file mode 100644
index 00000000..b2566ff3
--- /dev/null
+++ b/internal/application/repository/model_original_body.go
@@ -0,0 +1,488 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"sync"
+	"time"
+)
+
+type modelOriginalProducerKey struct{}
+type modelOriginalProducerBoundary struct {
+	Kind, ID   string
+	Tenant     uint64
+	BodyDigest string
+}
+
+func modelOriginalTable(kind string) (string, string, error) {
+	switch kind {
+	case "definition":
+		return "model_definition_originals", "definition_json", nil
+	case "credential":
+		return "model_credential_originals", "credential_json", nil
+	}
+	return "", "", ErrOriginalBodyUnavailable
+}
+
+type modelOriginalBody struct {
+	Head    originalBodyFieldHead
+	Receipt types.ModelOriginalBodyReceipt
+}
+
+func modelOriginalCapturedHead(tx *gorm.DB, kind, id string, tenant uint64, body string) (originalBodyFieldHead, error) {
+	if err := tx.Statement.Context.Err(); err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	if !originalBodySchemaPresent(tx) {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	table, column, err := modelOriginalTable(kind)
+	if err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	var heads []originalBodyFieldHead
+	if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("source_table=? AND row_key=?", table, id).Find(&heads).Error; err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	if len(heads) != 1 {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	head := heads[0]
+	ref, ok := bodyReference(head.OriginalBodyRef)
+	if !ok || head.ColumnName != column || head.TenantID != tenant || head.OwnerKind != table || head.OwnerID != id || head.KnowledgeBaseID != "" || head.KnowledgeID != "" || ref.SlotID != head.SlotID || ref.BodyID != head.BodyID || ref.SHA256 != bodySHA([]byte(body)) {
+		return head, ErrOriginalBodyUnavailable
+	}
+	var scopes []originalBodyLeaseScope
+	if err = bodyInternal(tx).Where("body_id=?", head.BodyID).Find(&scopes).Error; err != nil {
+		return head, err
+	}
+	if len(scopes) != 1 || scopes[0].TenantID != tenant || scopes[0].KnowledgeBaseID != "" {
+		return head, ErrOriginalBodyUnavailable
+	}
+	return head, checkOriginalBodyAvailableForHeads(tx.Statement.Context, tx, table, id, heads)
+}
+func createModelOriginalBodyReceiptInTx(tx *gorm.DB, kind, id string, tenant uint64, originDigest, body string) error {
+	head, err := modelOriginalCapturedHead(tx, kind, id, tenant, body)
+	if err != nil {
+		return err
+	}
+	receipt := types.ModelOriginalBodyReceipt{OriginID: id, OriginKind: kind, OriginDigest: originDigest, TenantID: tenant, SlotID: head.SlotID, BodyID: head.BodyID, HeadRevision: head.Revision, SourceIdentitySHA256: head.SourceIdentitySHA256, BodyDigest: bodySHA([]byte(body)), CreatedAt: memoryFactTime()}
+	receipt.Digest, err = modelBodyReceiptDigest(receipt)
+	if err != nil {
+		return err
+	}
+	return tx.Create(&receipt).Error
+}
+func modelOriginalBodyHeadInTx(tx *gorm.DB, kind, id string, tenant uint64, originDigest, body string) (modelOriginalBody, error) {
+	head, err := modelOriginalCapturedHead(tx, kind, id, tenant, body)
+	if err != nil {
+		return modelOriginalBody{}, err
+	}
+	var receipt types.ModelOriginalBodyReceipt
+	if err = tx.Where("origin_id=?", id).Take(&receipt).Error; err != nil {
+		return modelOriginalBody{}, err
+	}
+	digest, err := modelBodyReceiptDigest(receipt)
+	if err != nil || digest != receipt.Digest || receipt.OriginKind != kind || receipt.OriginDigest != originDigest || receipt.TenantID != tenant || receipt.SlotID != head.SlotID || receipt.BodyID != head.BodyID || receipt.HeadRevision != head.Revision || receipt.SourceIdentitySHA256 != head.SourceIdentitySHA256 || receipt.BodyDigest != bodySHA([]byte(body)) {
+		return modelOriginalBody{}, ErrOriginalBodyUnavailable
+	}
+	return modelOriginalBody{head, receipt}, tx.Statement.Context.Err()
+}
+
+type modelOriginalHoldKey struct{}
+type modelOriginalHold struct {
+	Proof  types.ModelOriginalProof
+	Bodies []modelOriginalBody
+	Leases map[string]originalBodyLease
+}
+
+func checkModelOriginalHoldsInTx(tx *gorm.DB, proof types.ModelOriginalProof) error {
+	hold, ok := tx.Statement.Context.Value(modelOriginalHoldKey{}).(modelOriginalHold)
+	if !ok || hold.Proof != proof || len(hold.Bodies) != 2 || len(hold.Leases) != 2 {
+		return ErrOriginalBodyUnavailable
+	}
+	retention := NewOriginalBodyRetentionStore(tx)
+	if err := retention.checkJournalInTx(tx); err != nil {
+		return err
+	}
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	locked := []originalBodyLease{}
+	for _, body := range hold.Bodies {
+		var receipt types.ModelOriginalBodyReceipt
+		if err = tx.Where("origin_id=?", body.Receipt.OriginID).Take(&receipt).Error; err != nil {
+			return err
+		}
+		originalTime := body.Receipt.CreatedAt
+		actualTime := receipt.CreatedAt
+		receipt.CreatedAt = body.Receipt.CreatedAt
+		if receipt != body.Receipt || !actualTime.Equal(originalTime) {
+			return ErrOriginalBodyUnavailable
+		}
+		var head originalBodyFieldHead
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("slot_id=?", body.Head.SlotID).Take(&head).Error; err != nil {
+			return err
+		}
+		if head != body.Head {
+			return ErrOriginalBodyUnavailable
+		}
+		bound, ok := hold.Leases[head.BodyID]
+		if !ok {
+			return ErrOriginalBodyUnavailable
+		}
+		var lease originalBodyLease
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id=?", bound.LeaseID).Take(&lease).Error; err != nil {
+			return err
+		}
+		if lease.Kind != "read" || lease.BodyID != bound.BodyID || lease.OwnerID != bound.OwnerID || lease.Epoch != bound.Epoch || lease.ReleasedAtMS != nil || lease.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+		locked = append(locked, lease)
+		var payload originalBodyPayload
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", head.BodyID).Take(&payload).Error; err != nil {
+			return err
+		}
+		if payload.State != "live" || payload.PurgeEpoch != lease.Epoch || payload.BodySHA256 != receipt.BodyDigest {
+			return ErrOriginalBodyUnavailable
+		}
+		if err = checkOriginalBodyAvailableForHeads(tx.Statement.Context, tx, head.SourceTable, head.RowKey, []originalBodyFieldHead{head}); err != nil {
+			return err
+		}
+	}
+	if err = retention.checkJournalInTx(tx); err != nil {
+		return err
+	}
+	finalNow, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	for _, lease := range locked {
+		if lease.ExpiresAtMS <= finalNow {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+
+type modelOriginalRead struct {
+	db          *gorm.DB
+	ctx         context.Context
+	cancel      context.CancelFunc
+	model       *types.Model
+	hold        modelOriginalHold
+	authorize   ModelOriginalHistoricalAuthorizer
+	mu          sync.Mutex
+	failed      error
+	closed      bool
+	checks      sync.WaitGroup
+	closeJoined chan struct{}
+	closeErr    error
+}
+
+func cloneOriginalModel(model *types.Model) (*types.Model, error) {
+	wire, err := json.Marshal(model)
+	if err != nil {
+		return nil, err
+	}
+	var result types.Model
+	err = json.Unmarshal(wire, &result)
+	return &result, err
+}
+func beginModelOriginalRead(ctx context.Context, db *gorm.DB, id string, expected *types.ModelOriginalProof, authorize ModelOriginalHistoricalAuthorizer) (interfaces.ModelOriginalRead, error) {
+	tenant, ok := types.TenantIDFromContext(ctx)
+	if !ok || tenant == 0 || id == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if authorize == nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	read := &modelOriginalRead{db: db, authorize: authorize, hold: modelOriginalHold{Leases: map[string]originalBodyLease{}}, closeJoined: make(chan struct{})}
+	read.ctx, read.cancel = context.WithCancel(ctx)
+	err := db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		var routing struct {
+			TenantID  uint64
+			IsBuiltin bool
+		}
+		if err := tx.Table("models").Select("tenant_id,is_builtin").Where("id=?", id).Take(&routing).Error; err != nil {
+			return err
+		}
+		fresh, err := authorize(read.ctx, tx, types.ModelOriginalProof{ModelID: id, OwnerTenantID: routing.TenantID, IsBuiltin: routing.IsBuiltin})
+		if err != nil {
+			return err
+		}
+		tx = tx.WithContext(fresh)
+		var model types.Model
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND (tenant_id=? OR is_builtin=?)", id, tenant, true).Take(&model).Error; err != nil {
+			return err
+		}
+		if model.Status != types.ModelStatusActive {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		facts, err := readModelOriginalInTx(tx, &model)
+		if err != nil {
+			return err
+		}
+		if expected != nil && facts.Proof != *expected {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		read.model, err = cloneOriginalModel(&model)
+		if err != nil {
+			return err
+		}
+		read.hold.Proof = facts.Proof
+		owner := "model-original-read/" + uuid.NewString()
+		retention := NewOriginalBodyRetentionStore(tx)
+		for _, input := range []struct{ kind, id, digest, body string }{{"definition", facts.Definition.ID, facts.Definition.Digest, facts.Definition.DefinitionJSON}, {"credential", facts.Credential.ID, facts.Credential.Digest, facts.Credential.CredentialJSON}} {
+			body, err := modelOriginalBodyHeadInTx(tx, input.kind, input.id, model.TenantID, input.digest, input.body)
+			if err != nil {
+				return err
+			}
+			leaseID, err := retention.acquireLeaseInTx(tx, body.Head.BodyID, "read", owner, 15*time.Minute)
+			if err != nil {
+				return err
+			}
+			var lease originalBodyLease
+			if err = bodyInternal(tx).Where("lease_id=?", leaseID).Take(&lease).Error; err != nil {
+				return err
+			}
+			read.hold.Bodies = append(read.hold.Bodies, body)
+			read.hold.Leases[body.Head.BodyID] = lease
+		}
+		return ctx.Err()
+	}, memoryWriteOptions(db))
+	if err != nil {
+		read.cancel()
+		return nil, err
+	}
+	read.ctx = context.WithValue(read.ctx, modelOriginalHoldKey{}, read.hold)
+	read.ctx = context.WithValue(read.ctx, modelOriginalSnapshotKey{}, read)
+	if err = read.Recheck(); err != nil {
+		read.Close()
+		return nil, err
+	}
+	return read, nil
+}
+func (r *modelRepository) BeginModelOriginalRead(ctx context.Context, id string, expected *types.ModelOriginalProof) (interfaces.ModelOriginalRead, error) {
+	return beginModelOriginalRead(ctx, r.db, id, expected, r.currentReadAuthorizer)
+}
+func (r *memoryOriginalAdmissionRepository) BeginModelOriginalRead(ctx context.Context, id string, expected *types.ModelOriginalProof) (interfaces.ModelOriginalRead, error) {
+	return beginModelOriginalRead(ctx, r.db, id, expected, r.modelReadAuthorizer)
+}
+func ConfigureMemoryOriginalCurrentModels(admissions interfaces.MemoryOriginalAdmissionRepository, factory func(*gorm.DB) interfaces.ModelRepository) {
+	if actual, ok := admissions.(*memoryOriginalAdmissionRepository); ok && factory != nil {
+		actual.modelReadAuthorizer = func(ctx context.Context, tx *gorm.DB, proof types.ModelOriginalProof) (context.Context, error) {
+			models, ok := factory(tx).(*modelRepository)
+			if !ok || models.currentReadAuthorizer == nil || models.db.Statement.ConnPool != tx.Statement.ConnPool {
+				return ctx, types.ErrMemoryOriginalUnavailable
+			}
+			return models.currentReadAuthorizer(ctx, tx, proof)
+		}
+	}
+}
+func (r *modelOriginalRead) Context() context.Context { return r.ctx }
+func (r *modelOriginalRead) checkInTx(tx *gorm.DB) error {
+	if err := tx.Statement.Context.Err(); err != nil {
+		return err
+	}
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	fresh, err := r.authorize(r.ctx, tx, r.hold.Proof)
+	if err != nil {
+		return err
+	}
+	tx = tx.Session(&gorm.Session{NewDB: true}).WithContext(fresh)
+	var model types.Model
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", r.hold.Proof.ModelID).Take(&model).Error; err != nil {
+		return err
+	}
+	facts, err := readModelOriginalInTx(tx, &model)
+	if err != nil {
+		return err
+	}
+	if model.Status != types.ModelStatusActive || facts.Proof != r.hold.Proof {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return checkModelOriginalHoldsInTx(tx, facts.Proof)
+}
+func (r *modelOriginalRead) Recheck() error {
+	if err := r.startCheck(); err != nil {
+		return err
+	}
+	err := r.db.WithContext(r.ctx).Transaction(r.checkInTx, memoryWriteOptions(r.db))
+	return r.finishCheck(err)
+}
+func (r *modelOriginalRead) startCheck() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.failed != nil {
+		return r.failed
+	}
+	if r.closed {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	r.checks.Add(1)
+	return nil
+}
+func (r *modelOriginalRead) finishCheck(err error) error {
+	r.mu.Lock()
+	if err == nil {
+		err = r.ctx.Err()
+	}
+	if err != nil && r.failed == nil {
+		r.failed = err
+		r.cancel()
+	}
+	if r.closed && err == nil {
+		err = types.ErrMemoryOriginalUnavailable
+	}
+	r.mu.Unlock()
+	r.checks.Done()
+	return err
+}
+func (r *modelOriginalRead) Snapshot() (*types.Model, *types.ModelOriginalProof, error) {
+	if err := r.Recheck(); err != nil {
+		return nil, nil, err
+	}
+	model, err := cloneOriginalModel(r.model)
+	proof := r.hold.Proof
+	if model != nil {
+		copy := proof
+		model.OriginalProof = &copy
+	}
+	return model, &proof, err
+}
+func (r *modelOriginalRead) Close() error {
+	r.mu.Lock()
+	if r.closed {
+		joined := r.closeJoined
+		r.mu.Unlock()
+		<-joined
+		r.mu.Lock()
+		err := r.closeErr
+		r.mu.Unlock()
+		return err
+	}
+	r.closed = true
+	r.cancel()
+	r.mu.Unlock()
+	r.checks.Wait()
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	store := NewOriginalBodyRetentionStore(r.db)
+	var first error
+	for _, lease := range r.hold.Leases {
+		if err := store.ReleaseLease(ctx, lease.LeaseID); err != nil && first == nil {
+			first = err
+		}
+	}
+	r.mu.Lock()
+	if first != nil && r.failed == nil {
+		r.failed = first
+	}
+	r.closeErr = first
+	close(r.closeJoined)
+	r.mu.Unlock()
+	return first
+}
+
+type modelOriginalSnapshotKey struct{}
+
+func OriginalModelSnapshotFromContext(ctx context.Context, id string) (*types.Model, *types.ModelOriginalProof, error) {
+	read, ok := ctx.Value(modelOriginalSnapshotKey{}).(*modelOriginalRead)
+	if !ok || read.hold.Proof.ModelID != id {
+		return nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	return read.Snapshot()
+}
+func OriginalModelReadFromContext(ctx context.Context, id string) (interfaces.ModelOriginalRead, bool) {
+	read, ok := ctx.Value(modelOriginalSnapshotKey{}).(*modelOriginalRead)
+	return read, ok && read.hold.Proof.ModelID == id
+}
+
+type actualModelOriginalReadsKey struct{}
+
+func WithActualModelOriginalReads(ctx context.Context, reads []interfaces.ModelOriginalRead) (context.Context, error) {
+	actual := []*modelOriginalRead{}
+	for _, read := range reads {
+		r, ok := read.(*modelOriginalRead)
+		if !ok || !r.hold.Proof.Valid() {
+			return ctx, types.ErrMemoryOriginalUnavailable
+		}
+		actual = append(actual, r)
+	}
+	return context.WithValue(ctx, actualModelOriginalReadsKey{}, actual), ctx.Err()
+}
+
+// Exact current lifetime capability, for a caller's already-owned transaction.
+// A digest/current row alone cannot create this context or authorize this read.
+func CheckCurrentModelOriginalHolds(ctx context.Context, tx *gorm.DB, proof types.ModelOriginalProof) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	read, ok := ctx.Value(modelOriginalSnapshotKey{}).(*modelOriginalRead)
+	if !ok || read.hold.Proof != proof {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	marked, err := WithActualModelOriginalReads(ctx, []interfaces.ModelOriginalRead{read})
+	if err != nil {
+		return err
+	}
+	if err = checkActualModelOriginalReadsInTx(tx.Session(&gorm.Session{NewDB: true}).WithContext(marked)); err != nil {
+		return err
+	}
+	return ctx.Err()
+}
+func checkActualModelOriginalReadsInTx(tx *gorm.DB) error {
+	reads, _ := tx.Statement.Context.Value(actualModelOriginalReadsKey{}).([]*modelOriginalRead)
+	for _, read := range reads {
+		// Same physical SQL pool, current principal and exact held originals;
+		// this must not borrow another global connection inside final commit.
+		pool, err := tx.DB()
+		if err != nil {
+			return err
+		}
+		originalPool, err := read.db.DB()
+		if err != nil {
+			return err
+		}
+		if pool != originalPool {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = read.startCheck(); err != nil {
+			return err
+		}
+		err = read.checkInTx(tx.Session(&gorm.Session{NewDB: true}))
+		if err = read.finishCheck(err); err != nil {
+			return err
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+func checkQueuedModelOriginalInTx(tx *gorm.DB, tenant uint64, proof types.ModelOriginalProof) error {
+	if !proof.Valid() {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var model types.Model
+	if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=? AND (tenant_id=? OR is_builtin=?)", proof.ModelID, tenant, true).Take(&model).Error; err != nil {
+		return err
+	}
+	facts, err := readModelOriginalInTx(tx, &model)
+	if err != nil {
+		return err
+	}
+	if model.Status != types.ModelStatusActive || facts.Proof != proof {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return checkModelOriginalHoldsInTx(tx, proof)
+}
