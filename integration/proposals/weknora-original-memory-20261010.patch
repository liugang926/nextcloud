@@ -0,0 +1,37 @@
+package repository
+
+import (
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+// Pure immutable-selector fingerprint tests do not prove the real SQL retry
+// path; the complete schema/poison-first healthy-next SQL gate remains required.
+func TestMemoryOriginalDispatchRetryFingerprintBindsOnlyImmutableIntent(t *testing.T) {
+	row := &types.MemoryOriginalDispatch{AdmissionID: "original", Payload: "original payload", PayloadDigest: "original payload digest", NotBefore: time.Unix(100, 0).UTC(), CreatedAt: time.Unix(90, 0).UTC()}
+	before, err := memoryOriginalDispatchFingerprint(row)
+	require.NoError(t, err)
+	copy := *row
+	copy.LeaseID, copy.Attempts, copy.LastFailureCode = "claimed", 4, "original_intent_invalid"
+	copy.NextAttemptAt = time.Unix(200, 0).UTC()
+	after, err := memoryOriginalDispatchFingerprint(&copy)
+	require.NoError(t, err)
+	require.Equal(t, before, after)
+	copy.Payload = "changed payload"
+	changed, err := memoryOriginalDispatchFingerprint(&copy)
+	require.NoError(t, err)
+	require.NotEqual(t, before, changed)
+	copy = *row
+	copy.PayloadDigest = "changed digest"
+	changed, err = memoryOriginalDispatchFingerprint(&copy)
+	require.NoError(t, err)
+	require.NotEqual(t, before, changed)
+	copy = *row
+	copy.NotBefore = copy.NotBefore.Add(time.Second)
+	changed, err = memoryOriginalDispatchFingerprint(&copy)
+	require.NoError(t, err)
+	require.NotEqual(t, before, changed)
+}
diff --git a/internal/application/repository/memory_original_receipt.go b/internal/application/repository/memory_original_receipt.go
new file mode 100644
index 00000000..e9dcbb14
--- /dev/null
+++ b/internal/application/repository/memory_original_receipt.go
@@ -0,0 +1,217 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+func verifyMemoryCheckpoint(tx *gorm.DB, input *types.MemoryOriginalInput, receipt *types.MemoryOriginalCheckpoint) error {
+	digest, err := memoryCheckpointDigest(receipt)
+	q := input.Request
+	if err != nil || digest != receipt.Digest || receipt.InputAdmissionID != input.ID || receipt.InputDigest != input.Digest || receipt.PendingRevision != q.PendingRevision || receipt.TenantID != q.TenantID || receipt.SubjectID != q.SubjectID || receipt.SessionID != q.SessionID || receipt.Recipe != "memory.extract.atomic.v1" || receipt.From.After(receipt.To) || receipt.To.After(q.UpperCursor) || receipt.Drained && !sameMemoryCursor(receipt.To, q.UpperCursor) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	toIsControl := false
+	for _, control := range input.Plan.Controls {
+		if control != nil && control.ID == receipt.To.ID && control.CreatedAt.Equal(receipt.To.At) {
+			toIsControl = true
+		}
+	}
+	if !toIsControl {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var execution types.MemoryOriginalExecution
+	if err = tx.Where("id=? AND input_admission_id=?", receipt.ExecutionAdmissionID, input.ID).Take(&execution).Error; err != nil {
+		return err
+	}
+	actualExecution, err := memoryExecutionDigest(&execution)
+	if err != nil || actualExecution != execution.Digest || execution.InputDigest != input.Digest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	var manifest []types.MemoryOriginalEffect
+	if json.Unmarshal([]byte(receipt.OperationManifest), &manifest) != nil {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	opsDigest, err := KnowledgeInputDigest(manifest)
+	if err != nil || opsDigest != receipt.OperationsDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	seen := map[string]bool{}
+	for _, effect := range manifest {
+		if seen[effect.DerivationID] || effect.OperationID == "" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[effect.DerivationID] = true
+		var origin types.MemoryOriginalDerivation
+		if err = tx.Where("id=? AND commit_id=?", effect.DerivationID, receipt.ID).Take(&origin).Error; err != nil {
+			return err
+		}
+		digest, err := memoryDerivationDigest(&origin)
+		if err != nil || digest != origin.Digest || origin.OperationID != effect.OperationID || origin.ObjectKind != effect.ObjectKind || origin.ObjectID != effect.ObjectID || origin.Action != effect.Action || origin.BodyDigest != effect.BodyDigest || origin.ParentDerivationID != effect.ParentDerivationID || origin.InputAdmissionID != input.ID || origin.ExecutionAdmissionID != execution.ID || origin.TenantID != q.TenantID || origin.SubjectID != q.SubjectID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = verifyMemoryOriginalEffectDependency(tx, input, receipt, &execution, &origin); err != nil {
+			return err
+		}
+	}
+	var count int64
+	if err = tx.Model(&types.MemoryOriginalDerivation{}).Where("commit_id=?", receipt.ID).Count(&count).Error; err != nil {
+		return err
+	}
+	if count != int64(len(manifest)) {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return nil
+}
+
+// Historical completion verifies the immutable effect dependencies only.
+// This never reads a current item body or grants recall authority to it.
+func verifyMemoryOriginalEffectDependency(tx *gorm.DB, input *types.MemoryOriginalInput, receipt *types.MemoryOriginalCheckpoint, execution *types.MemoryOriginalExecution, origin *types.MemoryOriginalDerivation) error {
+	var dependency memoryOriginalEffectDependency
+	if json.Unmarshal([]byte(origin.DependencyJSON), &dependency) != nil || dependency.InputID != input.ID || dependency.InputDigest != input.Digest || dependency.ExecutionID != execution.ID || dependency.ExecutionDigest != execution.Digest || dependency.ModelResultDigest != receipt.ModelResultDigest || dependency.Recipe != receipt.Recipe || dependency.Parent != origin.ParentDerivationID {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	if dependency.Capacity == nil {
+		if dependency.EffectRole == "capacity_retirement" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		// Empty role preserves the already-defined original effect recipe.
+		if dependency.EffectRole != "" && dependency.EffectRole != "model_result" && dependency.EffectRole != "model_previous_target" && dependency.EffectRole != "topic_interest_promotion" && dependency.EffectRole != "topic_rename_interest" && dependency.EffectRole != "topic_promotion_control" && dependency.EffectRole != "resident_block" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		return nil
+	}
+	capacity := dependency.Capacity
+	if dependency.EffectRole != "capacity_retirement" || origin.Action != "archive" || origin.ObjectKind != "memory_item" || capacity.Keep <= 0 || capacity.CurrentCommitID != receipt.ID || capacity.AfterDigest != origin.BodyDigest || capacity.BeforeDigest == "" || len(capacity.RankedControls) <= capacity.Keep {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	digest, err := KnowledgeInputDigest(struct {
+		TenantID  uint64
+		SubjectID string
+		Keep      int
+		CommitID  string
+		Controls  []memoryCapacityRankControl
+	}{input.Request.TenantID, input.Request.SubjectID, capacity.Keep, capacity.CurrentCommitID, capacity.RankedControls})
+	if err != nil || digest != capacity.RankingDigest {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	seen := map[string]bool{}
+	retired := false
+	for index, control := range capacity.RankedControls {
+		if control.ID == "" || seen[control.ID] || control.TenantID != input.Request.TenantID || control.SubjectID != input.Request.SubjectID || control.Status != types.MemoryStatusActive || control.ParentPublicationID == "" || control.ParentPublicationDigest == "" || control.BodyDigest == "" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[control.ID] = true
+		publication, err := loadMemoryDerivedPublication(tx, control.ParentPublicationID)
+		if err != nil {
+			return err
+		}
+		if publication.Digest != control.ParentPublicationDigest || publication.ObjectKind != "memory_item" || publication.ObjectID != control.ID || publication.TenantID != control.TenantID || publication.SubjectID != control.SubjectID || publication.MaterialDigest != control.BodyDigest || publication.DerivationID != control.ParentDerivationID {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var parent types.MemoryOriginalDerivation
+		if control.ParentDerivationID != "" {
+			if err := tx.Session(&gorm.Session{NewDB: true}).Where("id=?", control.ParentDerivationID).Take(&parent).Error; err != nil {
+				return err
+			}
+			digest, err := memoryDerivationDigest(&parent)
+			if err != nil || digest != parent.Digest || parent.Digest != control.ParentDerivationDigest || parent.ObjectID != control.ID || parent.BodyDigest != control.BodyDigest {
+				return types.ErrMemoryOriginalUnavailable
+			}
+		}
+		if control.ID == origin.ObjectID {
+			if index < capacity.Keep || publication.DerivationID != origin.ParentDerivationID || publication.MaterialDigest != capacity.BeforeDigest {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			retired = true
+		}
+	}
+	if !retired {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	return tx.Statement.Context.Err()
+}
+
+func verifyMemoryCheckpointChain(tx *gorm.DB, input *types.MemoryOriginalInput, id string, to types.MemoryMessageCursor) error {
+	seen := map[string]bool{}
+	for n := 0; n < 128; n++ {
+		if id == "" || seen[id] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[id] = true
+		var receipt types.MemoryOriginalCheckpoint
+		if err := tx.Where("id=?", id).Take(&receipt).Error; err != nil {
+			return err
+		}
+		if err := verifyMemoryCheckpoint(tx, input, &receipt); err != nil {
+			return err
+		}
+		if !sameMemoryCursor(receipt.To, to) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if receipt.PreviousCheckpointID == "" {
+			if !sameMemoryCursor(receipt.From, input.Request.FromCursor) {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			return nil
+		}
+		id = receipt.PreviousCheckpointID
+		to = receipt.From
+	}
+	return types.ErrMemoryOriginalUnavailable
+}
+
+// This is historical task acknowledgment only. It returns no derived body
+// and grants no subsequent recall/embedding/source read capability.
+func (r *memoryOriginalAdmissionRepository) VerifyMemoryOriginalCompletion(ctx context.Context, payload types.MemoryExtractPayload) (bool, error) {
+	complete := false
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		original, err := loadMemoryOriginal(tx, payload.OriginalAdmissionID)
+		if err != nil {
+			return err
+		}
+		q := original.Request
+		if payload.OriginalDigest != original.Digest || payload.OriginalRevision != q.PendingRevision || payload.TenantID != q.TenantID || payload.SubjectID != q.SubjectID || payload.SessionID != q.SessionID || payload.MessageID != q.TriggerMessageID || payload.ChatModelID != q.ChatModelID || payload.Language != q.Language {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var receipts []types.MemoryOriginalCheckpoint
+		if err = tx.Where("tenant_id=? AND subject_id=? AND session_id=? AND drained=?", q.TenantID, q.SubjectID, q.SessionID, true).Order("created_at,id").Find(&receipts).Error; err != nil {
+			return err
+		}
+		for _, receipt := range receipts {
+			input, err := loadMemoryOriginal(tx, receipt.InputAdmissionID)
+			if err != nil {
+				return err
+			}
+			cursor := input
+			ancestor := false
+			for n := 0; n < 128; n++ {
+				if cursor.ID == original.ID {
+					ancestor = true
+					break
+				}
+				parent, err := loadMemoryOriginal(tx, cursor.Request.PreviousAdmissionID)
+				if err != nil {
+					break
+				}
+				if err = checkMemoryOriginalAppendInTx(tx, parent, cursor); err != nil {
+					return err
+				}
+				cursor = parent
+			}
+			if !ancestor || q.UpperCursor.After(receipt.To) {
+				continue
+			}
+			if err = verifyMemoryCheckpointChain(tx, input, receipt.ID, receipt.To); err != nil {
+				return err
+			}
+			complete = true
+			return ctx.Err()
+		}
+		return ctx.Err()
+	})
+	return complete, err
+}
diff --git a/internal/application/repository/memory_policy_body.go b/internal/application/repository/memory_policy_body.go
new file mode 100644
index 00000000..7c354cea
--- /dev/null
+++ b/internal/application/repository/memory_policy_body.go
@@ -0,0 +1,333 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"sync"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type memoryPolicyProducerKey struct{}
+type memoryPolicyProducerBoundary struct {
+	ID           string
+	Tenant       uint64
+	PolicyDigest string
+}
+type memoryPolicyHoldKey struct{}
+type memoryPolicyHold struct {
+	Tenant  uint64
+	Current types.MemoryPolicyProof
+	Queued  types.MemoryPolicyProof
+	Heads   map[string]originalBodyFieldHead
+	Leases  map[string]originalBodyLease
+}
+
+func memoryPolicyCapturedBodyHeadInTx(tx *gorm.DB, origin *types.MemoryPolicyOriginal) (originalBodyFieldHead, error) {
+	if err := tx.Statement.Context.Err(); err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	if origin == nil || !originalBodySchemaPresent(tx) {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	var heads []originalBodyFieldHead
+	if err := bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("source_table='memory_policy_originals' AND row_key=?", origin.ID).Find(&heads).Error; err != nil {
+		return originalBodyFieldHead{}, err
+	}
+	if len(heads) != 1 {
+		return originalBodyFieldHead{}, ErrOriginalBodyUnavailable
+	}
+	head := heads[0]
+	if head.ColumnName != "policy_json" || head.TenantID != origin.TenantID || head.KnowledgeBaseID != "" || head.KnowledgeID != "" || head.OwnerKind != "memory_policy_originals" || head.OwnerID != origin.ID {
+		return head, ErrOriginalBodyUnavailable
+	}
+	ref, ok := bodyReference(head.OriginalBodyRef)
+	if !ok || ref.SlotID != head.SlotID || ref.BodyID != head.BodyID || ref.SHA256 != origin.PolicyDigest {
+		return head, ErrOriginalBodyUnavailable
+	}
+	var scope []originalBodyLeaseScope
+	if err := bodyInternal(tx).Where("body_id=?", head.BodyID).Find(&scope).Error; err != nil {
+		return head, err
+	}
+	if len(scope) != 1 || scope[0].TenantID != origin.TenantID || scope[0].KnowledgeBaseID != "" {
+		return head, ErrOriginalBodyUnavailable
+	}
+	if err := checkOriginalBodyAvailableForHeads(tx.Statement.Context, tx, "memory_policy_originals", origin.ID, heads); err != nil {
+		return head, err
+	}
+	return head, tx.Statement.Context.Err()
+}
+
+func memoryPolicyBodyReceiptDigest(receipt *types.MemoryPolicyBodyReceipt) (string, error) {
+	copy := *receipt
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+func memoryPolicyProofInTx(tx *gorm.DB, origin *types.MemoryPolicyOriginal) (types.MemoryPolicyProof, error) {
+	var receipt types.MemoryPolicyBodyReceipt
+	if err := tx.Where("origin_id=?", origin.ID).Take(&receipt).Error; err != nil {
+		return types.MemoryPolicyProof{}, err
+	}
+	digest, err := memoryPolicyBodyReceiptDigest(&receipt)
+	if err != nil || digest != receipt.Digest || receipt.TenantID != origin.TenantID || receipt.OriginDigest != origin.Digest || receipt.PolicyDigest != origin.PolicyDigest {
+		return types.MemoryPolicyProof{}, ErrOriginalBodyUnavailable
+	}
+	origin.BodyReceiptDigest = receipt.Digest
+	return origin.Proof(), nil
+}
+func memoryPolicyBodyHeadInTx(tx *gorm.DB, origin *types.MemoryPolicyOriginal) (originalBodyFieldHead, error) {
+	head, err := memoryPolicyCapturedBodyHeadInTx(tx, origin)
+	if err != nil {
+		return head, err
+	}
+	proof, err := memoryPolicyProofInTx(tx, origin)
+	if err != nil {
+		return head, err
+	}
+	var receipt types.MemoryPolicyBodyReceipt
+	if err = tx.Where("origin_id=? AND digest=?", origin.ID, proof.BodyReceiptDigest).Take(&receipt).Error; err != nil {
+		return head, err
+	}
+	if receipt.SlotID != head.SlotID || receipt.BodyID != head.BodyID || receipt.HeadRevision != head.Revision || receipt.SourceIdentitySHA256 != head.SourceIdentitySHA256 {
+		return head, ErrOriginalBodyUnavailable
+	}
+	return head, tx.Statement.Context.Err()
+}
+
+func memoryPolicyChainInTx(tx *gorm.DB, tenant uint64, current *types.MemoryPolicyOriginal, queued types.MemoryPolicyProof) ([]*types.MemoryPolicyOriginal, error) {
+	if err := memoryPolicyDescendsFrom(tx, tenant, current, queued); err != nil {
+		return nil, err
+	}
+	chain := []*types.MemoryPolicyOriginal{current}
+	for current.Proof() != queued {
+		var parent types.MemoryPolicyOriginal
+		if err := tx.Where("id=? AND tenant_id=?", current.PreviousOriginID, tenant).Take(&parent).Error; err != nil {
+			return nil, err
+		}
+		proof, err := memoryPolicyProofInTx(tx, &parent)
+		if err != nil {
+			return nil, err
+		}
+		checked, err := loadMemoryPolicyOriginal(tx, tenant, proof)
+		if err != nil {
+			return nil, err
+		}
+		chain = append(chain, checked)
+		current = checked
+	}
+	return chain, nil
+}
+
+func checkMemoryPolicyHoldsInTx(tx *gorm.DB, tenant uint64, current, queued types.MemoryPolicyProof) error {
+	hold, ok := tx.Statement.Context.Value(memoryPolicyHoldKey{}).(memoryPolicyHold)
+	if !ok || hold.Tenant != tenant || hold.Current != current || hold.Queued != queued || len(hold.Heads) == 0 || len(hold.Leases) != len(hold.Heads) {
+		return ErrOriginalBodyUnavailable
+	}
+	origin, err := loadMemoryPolicyOriginal(tx, tenant, current)
+	if err != nil {
+		return err
+	}
+	chain, err := memoryPolicyChainInTx(tx, tenant, origin, queued)
+	if err != nil {
+		return err
+	}
+	if len(chain) != len(hold.Heads) {
+		return ErrOriginalBodyUnavailable
+	}
+	store := NewOriginalBodyRetentionStore(tx)
+	if err = store.checkJournalInTx(tx); err != nil {
+		return err
+	}
+	now, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	lockedLeases := []originalBodyLease{}
+	for _, fact := range chain {
+		head, err := memoryPolicyBodyHeadInTx(tx, fact)
+		if err != nil {
+			return err
+		}
+		if old, ok := hold.Heads[fact.ID]; !ok || old != head {
+			return ErrOriginalBodyUnavailable
+		}
+		bound, ok := hold.Leases[head.BodyID]
+		if !ok || bound.LeaseID == "" {
+			return ErrOriginalBodyUnavailable
+		}
+		var lease originalBodyLease
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("lease_id=?", bound.LeaseID).Take(&lease).Error; err != nil {
+			return err
+		}
+		if lease.Kind != "read" || lease.OwnerID != bound.OwnerID || lease.BodyID != bound.BodyID || lease.Epoch != bound.Epoch || lease.ReleasedAtMS != nil || lease.ExpiresAtMS <= now {
+			return ErrOriginalBodyUnavailable
+		}
+		lockedLeases = append(lockedLeases, lease)
+		var body originalBodyPayload
+		if err = bodyInternal(tx).Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", head.BodyID).Take(&body).Error; err != nil {
+			return err
+		}
+		if body.State != "live" || body.PurgeEpoch != lease.Epoch || body.BodySHA256 != fact.PolicyDigest {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	if err = store.checkJournalInTx(tx); err != nil {
+		return err
+	}
+	// The final journal/physical reads may take time. SQL-held rows still need
+	// a live lease at the final boundary, not merely at the earlier clock read.
+	finalNow, err := nextcloudLeaseNowMS(bodyInternal(tx))
+	if err != nil {
+		return err
+	}
+	for _, lease := range lockedLeases {
+		if lease.ExpiresAtMS <= finalNow {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return tx.Statement.Context.Err()
+}
+
+type memoryPolicyOriginalRead struct {
+	db     *gorm.DB
+	ctx    context.Context
+	cancel context.CancelFunc
+	hold   memoryPolicyHold
+	mu     sync.Mutex
+	failed error
+	closed bool
+}
+
+func beginMemoryPolicyOriginalRead(ctx context.Context, db *gorm.DB, tenant uint64, queued types.MemoryPolicyProof) (interfaces.MemoryPolicyOriginalRead, error) {
+	read := &memoryPolicyOriginalRead{db: db, hold: memoryPolicyHold{Tenant: tenant, Queued: queued, Heads: map[string]originalBodyFieldHead{}, Leases: map[string]originalBodyLease{}}}
+	read.ctx, read.cancel = context.WithCancel(ctx)
+	err := db.WithContext(read.ctx).Transaction(func(tx *gorm.DB) error {
+		var row types.Tenant
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", tenant).Take(&row).Error; err != nil {
+			return err
+		}
+		_, current, err := readMemoryPolicyOriginalInTx(tx, &row)
+		if err != nil {
+			return err
+		}
+		chain, err := memoryPolicyChainInTx(tx, tenant, current, queued)
+		if err != nil {
+			return err
+		}
+		read.hold.Current = current.Proof()
+		owner := "memory-policy-read/" + uuid.NewString()
+		retention := NewOriginalBodyRetentionStore(tx)
+		for _, origin := range chain {
+			head, err := memoryPolicyBodyHeadInTx(tx, origin)
+			if err != nil {
+				return err
+			}
+			id, err := retention.acquireLeaseInTx(tx, head.BodyID, "read", owner, 15*time.Minute)
+			if err != nil {
+				return err
+			}
+			var lease originalBodyLease
+			if err = bodyInternal(tx).Where("lease_id=?", id).Take(&lease).Error; err != nil {
+				return err
+			}
+			read.hold.Heads[origin.ID] = head
+			read.hold.Leases[head.BodyID] = lease
+		}
+		return ctx.Err()
+	}, memoryWriteOptions(db))
+	if err != nil {
+		read.cancel()
+		return nil, err
+	}
+	read.ctx = context.WithValue(read.ctx, memoryPolicyHoldKey{}, read.hold)
+	if err = read.Recheck(); err != nil {
+		read.Close()
+		return nil, err
+	}
+	return read, nil
+}
+
+func (r *tenantRepository) BeginMemoryPolicyOriginalRead(ctx context.Context, tenant uint64, queued types.MemoryPolicyProof) (interfaces.MemoryPolicyOriginalRead, error) {
+	return beginMemoryPolicyOriginalRead(ctx, r.db, tenant, queued)
+}
+func (r *memoryOriginalAdmissionRepository) BeginMemoryPolicyOriginalRead(ctx context.Context, tenant uint64, queued types.MemoryPolicyProof) (interfaces.MemoryPolicyOriginalRead, error) {
+	return beginMemoryPolicyOriginalRead(ctx, r.db, tenant, queued)
+}
+func (r *memoryPolicyOriginalRead) Context() context.Context { return r.ctx }
+func (r *memoryPolicyOriginalRead) Recheck() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.failed != nil {
+		return r.failed
+	}
+	if r.closed {
+		return types.ErrMemoryOriginalUnavailable
+	}
+	err := r.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		var row types.Tenant
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", r.hold.Tenant).Take(&row).Error; err != nil {
+			return err
+		}
+		_, origin, err := readMemoryPolicyOriginalInTx(tx, &row)
+		if err != nil {
+			return err
+		}
+		if origin.Proof() != r.hold.Current {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		return checkMemoryPolicyHoldsInTx(tx, r.hold.Tenant, r.hold.Current, r.hold.Queued)
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		r.failed = err
+		r.cancel()
+	}
+	return err
+}
+func (r *memoryPolicyOriginalRead) Policy() (*types.MemoryConfig, *types.MemoryPolicyProof, error) {
+	if err := r.Recheck(); err != nil {
+		return nil, nil, err
+	}
+	var cfg types.MemoryConfig
+	err := r.db.WithContext(r.ctx).Transaction(func(tx *gorm.DB) error {
+		origin, err := loadMemoryPolicyOriginal(tx, r.hold.Tenant, r.hold.Current)
+		if err != nil {
+			return err
+		}
+		return json.Unmarshal([]byte(origin.PolicyJSON), &cfg)
+	}, memoryWriteOptions(r.db))
+	if err != nil {
+		return nil, nil, err
+	}
+	if err = r.Recheck(); err != nil {
+		return nil, nil, err
+	}
+	proof := r.hold.Current
+	return &cfg, &proof, nil
+}
+func (r *memoryPolicyOriginalRead) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return r.failed
+	}
+	r.closed = true
+	r.cancel()
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.ctx), 5*time.Second)
+	defer cancel()
+	store := NewOriginalBodyRetentionStore(r.db)
+	var first error
+	for _, lease := range r.hold.Leases {
+		if err := store.ReleaseLease(cleanup, lease.LeaseID); err != nil && first == nil {
+			first = err
+		}
+	}
+	if first != nil && r.failed == nil {
+		r.failed = first
+	}
+	return first
+}
diff --git a/internal/application/repository/memory_policy_original.go b/internal/application/repository/memory_policy_original.go
new file mode 100644
index 00000000..415e011c
--- /dev/null
+++ b/internal/application/repository/memory_policy_original.go
@@ -0,0 +1,359 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type MemoryPolicyAuthorizer func(context.Context, *gorm.DB) (context.Context, error)
+
+// Only absence of a fact at the retained current revision is UNKNOWN. A
+// missing physical body/unsafe observed fact is a different, closed error.
+var ErrMemoryPolicyOriginUnknown = errors.New("memory policy original is unknown at the current revision")
+
+func ConfigureTenantMemoryPolicyAuthorizer(repo interfaces.TenantRepository, authorize MemoryPolicyAuthorizer) {
+	if actual, ok := repo.(*tenantRepository); ok {
+		actual.policyAuthorizer = authorize
+	}
+}
+
+func memoryPolicyOriginDigest(origin *types.MemoryPolicyOriginal) (string, error) {
+	copy := *origin
+	copy.Digest = ""
+	return KnowledgeInputDigest(copy)
+}
+
+func memoryPolicyRevision(tx *gorm.DB, tenant uint64) (uint64, error) {
+	var control struct{ Revision uint64 }
+	if err := tx.Table("memory_policy_control_versions").Clauses(clause.Locking{Strength: "SHARE"}).Where("tenant_id=?", tenant).Take(&control).Error; err != nil {
+		return 0, err
+	}
+	if control.Revision == 0 {
+		return 0, types.ErrMemoryOriginalUnavailable
+	}
+	return control.Revision, nil
+}
+
+func loadMemoryPolicyOriginal(tx *gorm.DB, tenant uint64, proof types.MemoryPolicyProof) (*types.MemoryPolicyOriginal, error) {
+	if !proof.Valid() {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var origin types.MemoryPolicyOriginal
+	if err := tx.Where("id=? AND tenant_id=? AND revision=?", proof.OriginID, tenant, proof.Revision).Take(&origin).Error; err != nil {
+		return nil, err
+	}
+	if _, err := memoryPolicyProofInTx(tx, &origin); err != nil {
+		return nil, err
+	}
+	digest, err := memoryPolicyOriginDigest(&origin)
+	var policy types.MemoryConfig
+	if err != nil || digest != origin.Digest || origin.Proof() != proof || json.Unmarshal([]byte(origin.PolicyJSON), &policy) != nil {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	encoded, err := types.MemoryPolicyBytes(&policy)
+	if err != nil || string(encoded) != origin.PolicyJSON || types.MemoryOriginalBytesDigest(encoded) != origin.PolicyDigest || origin.AuthorSelector == "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if (origin.PreviousOriginID == "") != (origin.PreviousOriginDigest == "") {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	var author knowledgeBuildActorSelector
+	if json.Unmarshal([]byte(origin.AuthorSelector), &author) != nil || author.CallerTenantID != tenant || author.AdmissionID != "" {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	principal := types.Principal{Type: author.PrincipalType, ID: author.PrincipalID}
+	if !principal.Valid() || principal != principal.Normalize() || author.PrincipalType == types.PrincipalWebUser && (author.UserID == "" || author.UserID != author.PrincipalID || author.APIKeyID != nil) || author.PrincipalType != types.PrincipalWebUser && ((author.PrincipalType != types.PrincipalAPITenant && author.PrincipalType != types.PrincipalAPIExternalUser) || author.UserID != "" || author.APIKeyID == nil) {
+		return nil, types.ErrMemoryOriginalUnavailable
+	}
+	if _, err := memoryPolicyBodyHeadInTx(tx, &origin); err != nil {
+		return nil, err
+	}
+	return &origin, tx.Statement.Context.Err()
+}
+
+func readMemoryPolicyOriginalInTx(tx *gorm.DB, tenant *types.Tenant) (*types.MemoryConfig, *types.MemoryPolicyOriginal, error) {
+	revision, err := memoryPolicyRevision(tx, tenant.ID)
+	if err != nil {
+		return nil, nil, err
+	}
+	var origin types.MemoryPolicyOriginal
+	if err = tx.Where("tenant_id=? AND revision=?", tenant.ID, revision).Take(&origin).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil, ErrMemoryPolicyOriginUnknown
+		}
+		return nil, nil, err
+	}
+	proof, err := memoryPolicyProofInTx(tx, &origin)
+	if err != nil {
+		return nil, nil, err
+	}
+	checked, err := loadMemoryPolicyOriginal(tx, tenant.ID, proof)
+	if err != nil {
+		return nil, nil, err
+	}
+	encoded, err := types.MemoryPolicyBytes(tenant.MemoryConfig)
+	if err != nil || string(encoded) != checked.PolicyJSON {
+		return nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	var cfg types.MemoryConfig
+	if err = json.Unmarshal(encoded, &cfg); err != nil {
+		return nil, nil, err
+	}
+	return &cfg, checked, tx.Statement.Context.Err()
+}
+
+// The successor edge comes only from a previous, validated current fact in the
+// writer transaction. A raw/legacy gap starts a new root and cannot authorize
+// work queued under an earlier root, even when bytes were restored by ABA.
+func memoryPolicyDescendsFrom(tx *gorm.DB, tenant uint64, current *types.MemoryPolicyOriginal, queued types.MemoryPolicyProof) error {
+	if _, err := loadMemoryPolicyOriginal(tx, tenant, queued); err != nil {
+		return err
+	}
+	seen := map[string]bool{}
+	for i := 0; i < 256; i++ {
+		if current == nil || seen[current.ID] {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		seen[current.ID] = true
+		if current.Proof() == queued {
+			return tx.Statement.Context.Err()
+		}
+		if current.Revision <= queued.Revision || current.PreviousOriginID == "" {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var parent types.MemoryPolicyOriginal
+		if err := tx.Where("id=? AND tenant_id=?", current.PreviousOriginID, tenant).Take(&parent).Error; err != nil {
+			return err
+		}
+		if parent.Digest != current.PreviousOriginDigest || parent.Revision >= current.Revision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		var err error
+		parentProof, proofErr := memoryPolicyProofInTx(tx, &parent)
+		if proofErr != nil {
+			return proofErr
+		}
+		current, err = loadMemoryPolicyOriginal(tx, tenant, parentProof)
+		if err != nil {
+			return err
+		}
+	}
+	return types.ErrMemoryOriginalUnavailable
+}
+
+func (r *tenantRepository) ReadMemoryPolicyOriginal(ctx context.Context, tenant uint64) (*types.MemoryConfig, *types.MemoryPolicyProof, error) {
+	var cfg *types.MemoryConfig
+	var proof *types.MemoryPolicyProof
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var row types.Tenant
+		if err := tx.Clauses(clause.Locking{Strength: "SHARE"}).Where("id=?", tenant).Take(&row).Error; err != nil {
+			return err
+		}
+		actual, origin, err := readMemoryPolicyOriginalInTx(tx, &row)
+		if err != nil {
+			return err
+		}
+		if hold, ok := ctx.Value(memoryPolicyHoldKey{}).(memoryPolicyHold); ok {
+			if err = checkMemoryPolicyHoldsInTx(tx, tenant, origin.Proof(), hold.Queued); err != nil {
+				return err
+			}
+		}
+		cfg = actual
+		value := origin.Proof()
+		proof = &value
+		return ctx.Err()
+	}, memoryWriteOptions(r.db))
+	return cfg, proof, err
+}
+
+func lockMemoryPolicyAuthor(tx *gorm.DB, ctx context.Context, tenant uint64) error {
+	actor, err := captureKnowledgeActorSelector(ctx, "")
+	if err != nil || actor.CallerTenantID != tenant {
+		return access.ErrForbidden
+	}
+	share := clause.Locking{Strength: "SHARE"}
+	if actor.UserID != "" {
+		var user types.User
+		if err = tx.Clauses(share).Where("id=? AND is_active=?", actor.UserID, true).Take(&user).Error; err != nil {
+			return err
+		}
+		var members []types.TenantMember
+		if err = tx.Clauses(share).Where("user_id=? AND tenant_id=?", actor.UserID, tenant).Find(&members).Error; err != nil {
+			return err
+		}
+		var links []types.DirectoryIdentity
+		if err = tx.Where("user_id=?", actor.UserID).Order("directory_id,id").Find(&links).Error; err != nil {
+			return err
+		}
+		dirs := map[string]bool{}
+		for _, link := range links {
+			dirs[link.DirectoryID] = true
+		}
+		ids := []string{}
+		for id := range dirs {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		for _, id := range ids {
+			var row types.Directory
+			if err = tx.Clauses(share).Where("id=?", id).Take(&row).Error; err != nil {
+				return err
+			}
+		}
+	}
+	if actor.APIKeyID != nil {
+		var key types.TenantAPIKey
+		if err = tx.Clauses(share).Where("id=?", *actor.APIKeyID).Take(&key).Error; err != nil {
+			return err
+		}
+	}
+	if err = tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&types.PermissionVersion{TenantID: tenant, Version: 0}).Error; err != nil {
+		return err
+	}
+	var version types.PermissionVersion
+	return tx.Clauses(share).Where("tenant_id=?", tenant).Take(&version).Error
+}
+
+// Shared current-author fence; it creates no policy/model originals.
+func LockMemoryPolicyOriginalAuthor(tx *gorm.DB, ctx context.Context, tenant uint64) error {
+	return lockMemoryPolicyAuthor(tx, ctx, tenant)
+}
+
+func (r *tenantRepository) ReplaceMemoryPolicyOriginal(ctx context.Context, tenant uint64, replacement types.MemoryConfig) (*types.MemoryConfig, *types.MemoryPolicyProof, error) {
+	if r.policyAuthorizer == nil || tenant == 0 {
+		return nil, nil, types.ErrMemoryOriginalUnavailable
+	}
+	if err := types.ValidateMemoryPolicyReplacement(replacement); err != nil {
+		return nil, nil, err
+	}
+	encoded, err := types.MemoryPolicyBytes(&replacement)
+	if err != nil {
+		return nil, nil, err
+	}
+	var result *types.MemoryConfig
+	var proof *types.MemoryPolicyProof
+	err = r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if tx.Dialector.Name() == "sqlite" {
+			if err := tx.Exec("UPDATE tenants SET updated_at=updated_at WHERE id=?", tenant).Error; err != nil {
+				return err
+			}
+		}
+		// Resolve/lock configured runtime routing before actor permission epochs,
+		// matching the original execution directory→tenant→epoch order. This
+		// preliminary view is never the grant used to create a policy fact.
+		if _, err := r.policyAuthorizer(ctx, tx); err != nil {
+			return err
+		}
+		var row types.Tenant
+		if err := tx.Clauses(forUpdateClause()).Where("id=?", tenant).Take(&row).Error; err != nil {
+			return err
+		}
+		if err := lockMemoryPolicyAuthor(tx, ctx, tenant); err != nil {
+			return err
+		}
+		fresh, err := r.policyAuthorizer(ctx, tx)
+		if err != nil {
+			return err
+		}
+		caller := types.CallerFromContext(fresh)
+		if caller.TenantID != tenant || !caller.Role.HasPermission(types.TenantRoleAdmin) {
+			return access.ErrForbidden
+		}
+		previousRevision, err := memoryPolicyRevision(tx, tenant)
+		if err != nil {
+			return err
+		}
+		_, previous, oldErr := readMemoryPolicyOriginalInTx(tx, &row)
+		// Missing origin is UNKNOWN, never a digest-current bootstrap. Database
+		// failures and malformed observed facts cannot be hidden as missing.
+		if oldErr != nil && !errors.Is(oldErr, ErrMemoryPolicyOriginUnknown) {
+			return oldErr
+		}
+		var normalized types.MemoryConfig
+		if err = json.Unmarshal(encoded, &normalized); err != nil {
+			return err
+		}
+		write := tx.Model(&types.Tenant{}).Where("id=?", tenant).Updates(map[string]interface{}{"memory_config": &normalized, "updated_at": memoryFactTime()})
+		if write.Error != nil {
+			return write.Error
+		}
+		if write.RowsAffected != 1 {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		revision, err := memoryPolicyRevision(tx, tenant)
+		if err != nil {
+			return err
+		}
+		if revision == previousRevision {
+			advance := tx.Table("memory_policy_control_versions").Where("tenant_id=? AND revision=?", tenant, previousRevision).Update("revision", previousRevision+1)
+			if advance.Error != nil {
+				return advance.Error
+			}
+			if advance.RowsAffected != 1 {
+				return types.ErrMemoryOriginalUnavailable
+			}
+			revision++
+		}
+		if revision <= previousRevision {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		if err = tx.Where("id=?", tenant).Take(&row).Error; err != nil {
+			return err
+		}
+		actual, err := types.MemoryPolicyBytes(row.MemoryConfig)
+		if err != nil || string(actual) != string(encoded) {
+			return types.ErrMemoryOriginalUnavailable
+		}
+		actor, err := captureKnowledgeActorSelector(fresh, "")
+		if err != nil {
+			return err
+		}
+		selector, err := json.Marshal(actor)
+		if err != nil {
+			return err
+		}
+		origin := &types.MemoryPolicyOriginal{ID: uuid.NewString(), TenantID: tenant, Revision: revision, PolicyJSON: string(encoded), PolicyDigest: types.MemoryOriginalBytesDigest(encoded), AuthorSelector: string(selector), CreatedAt: memoryFactTime()}
+		if previous != nil {
+			origin.PreviousOriginID = previous.ID
+			origin.PreviousOriginDigest = previous.Digest
+		}
+		origin.Digest, err = memoryPolicyOriginDigest(origin)
+		if err != nil {
+			return err
+		}
+		producer := context.WithValue(ctx, memoryPolicyProducerKey{}, memoryPolicyProducerBoundary{origin.ID, tenant, origin.PolicyDigest})
+		if err = tx.WithContext(producer).Create(origin).Error; err != nil {
+			return err
+		}
+		head, err := memoryPolicyCapturedBodyHeadInTx(tx, origin)
+		if err != nil {
+			return err
+		}
+		receipt := &types.MemoryPolicyBodyReceipt{OriginID: origin.ID, OriginDigest: origin.Digest, TenantID: tenant, SlotID: head.SlotID, BodyID: head.BodyID, HeadRevision: head.Revision, SourceIdentitySHA256: head.SourceIdentitySHA256, PolicyDigest: origin.PolicyDigest, CreatedAt: memoryFactTime()}
+		receipt.Digest, err = memoryPolicyBodyReceiptDigest(receipt)
+		if err != nil {
+			return err
+		}
+		if err = tx.Create(receipt).Error; err != nil {
+			return err
+		}
+		origin.BodyReceiptDigest = receipt.Digest
+		if _, err = memoryPolicyBodyHeadInTx(tx, origin); err != nil {
+			return err
+		}
+		result = &normalized
+		value := origin.Proof()
+		proof = &value
+		return ctx.Err()
+	}, memoryWriteOptions(r.db))
+	return result, proof, err
+}
