@@ -0,0 +1,269 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	memoryservice "github.com/Tencent/WeKnora/internal/application/service/memory"
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// Source-only integration draft. Requires the genuine model fixture/producer,
+// e144 generated model bridge and its captured-lease-ID successor fused with
+// this source. No input, model proof, publication or result receipt is seeded.
+// Availability faults are real SQL controls, not a claim of actual GC/restore.
+const memoryGeneratedSecondText = "The user's preferred development editor is Neovim for daily coding."
+const memoryGeneratedMergedText = "The user's preferred editor for daily development is Neovim."
+
+type memoryGeneratedSQLChat struct {
+	*actualMemoryModel
+	mergeCalls int
+	prompts    [][]chat.Message
+	afterMerge func() error
+	reply      string
+}
+
+func (m *memoryGeneratedSQLChat) Chat(ctx context.Context, input []chat.Message, options *chat.ChatOptions) (*types.ChatResponse, error) {
+	if len(input) == 0 || input[0].Content != types.MemoryConsolidationOriginalPrompt {
+		return m.actualMemoryModel.Chat(ctx, input, options)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	m.mergeCalls++
+	m.prompts = append(m.prompts, append([]chat.Message(nil), input...))
+	if m.afterMerge != nil {
+		if err := m.afterMerge(); err != nil {
+			return nil, err
+		}
+	}
+	if m.reply != "" {
+		return &types.ChatResponse{Content: m.reply}, nil
+	}
+	body, err := json.Marshal(map[string]string{"statement": memoryGeneratedMergedText})
+	return &types.ChatResponse{Content: string(body)}, err
+}
+
+type memoryGeneratedSQLModels struct {
+	actualMemoryModels
+	transport *memoryGeneratedSQLChat
+}
+
+func (m memoryGeneratedSQLModels) GetChatModel(ctx context.Context, id string) (chat.Chat, error) {
+	// Construct through the actual original-bound provider first, replacing only
+	// the network roundtrip. The transport cannot authenticate a model itself.
+	if _, err := m.actualMemoryModels.GetChatModel(ctx, id); err != nil {
+		return nil, err
+	}
+	return m.transport, nil
+}
+func attachMemoryGeneratedSQL(t *testing.T, f *memAtomicSQLFixture) *memoryGeneratedSQLChat {
+	t.Helper()
+	transport := &memoryGeneratedSQLChat{actualMemoryModel: f.model.actualMemoryModel}
+	_, originalService, _, _ := actualOriginalModelServices(t, f)
+	originals, ok := originalService.(interfaces.ModelOriginalLifetimeReader)
+	require.True(t, ok, "the transport retains the genuine configured model lifetime capability")
+	require.NotNil(t, originals)
+	models := memoryGeneratedSQLModels{actualMemoryModels: actualMemoryModels{model: f.model.actualMemoryModel, db: f.db, originals: originals}, transport: transport}
+	f.service = memoryservice.NewOriginalBoundMemoryService(f.repo, repository.NewTenantRepository(f.db), repository.NewMessageRepository(f.db), models, f.queue, nil, f.reader, f.admissions)
+	memoryservice.ConfigureOriginalMemoryOutbox(f.service, f.outbox)
+	return transport
+}
+func runMemoryGeneratedConsolidationSQL(t *testing.T, pg bool) {
+	for _, mode := range []string{"productive_then_model_successor", "source_after_model", "body_after_model", "actor_after_model", "input_lease_after_model", "current_model_after_model", "unsupported_model_result"} {
+		t.Run(mode, func(t *testing.T) {
+			f, agent, ownerID := newMemSharedAgentNoKBFixture(t, pg)
+			transport := attachMemoryGeneratedSQL(t, f)
+			if mode == "productive_then_model_successor" {
+				before := memAtomicSQLCount(t, f, "memory_derived_publications")
+				unproven := &types.MemoryItem{ID: uuid.NewString(), TenantID: f.scope.TenantID, SubjectID: f.scope.SubjectID, Kind: types.MemoryKindFact, Origin: types.MemoryOriginExtracted, Content: "Unproven generated body must not become human authored material.", Status: types.MemoryStatusActive}
+				require.ErrorIs(t, f.repo.SaveItem(f.ctx, f.scope, unproven, ""), types.ErrMemoryOriginalUnavailable)
+				_, err := f.repo.BumpTopic(f.ctx, f.scope, "unproven generated topic", "unproven generated topic", "")
+				require.ErrorIs(t, err, types.ErrMemoryOriginalUnavailable)
+				require.Equal(t, before, memAtomicSQLCount(t, f, "memory_derived_publications"))
+				require.Zero(t, transport.calls)
+			}
+			f.service.ScheduleExtraction(f.ctx, f.session.ID, f.assistant.ID, transport.GetModelID())
+			relayMemAtomicSQLScheduled(t, f)
+			require.NoError(t, handleMemDerivedSQL(t, f))
+			require.Equal(t, 1, transport.calls)
+			var first types.MemoryItem
+			require.NoError(t, f.db.Where("tenant_id=? AND subject_id=? AND status=?", f.scope.TenantID, f.scope.SubjectID, types.MemoryStatusActive).Take(&first).Error)
+			require.Equal(t, actualMemoryStoredText, first.Content)
+			// A real explicit manual command authors a second distinct identity. Its
+			// text overlaps the first without matching its key or containing its body.
+			second, err := f.service.Remember(f.ctx, types.MemoryItem{Kind: types.MemoryKindFact, Topic: "daily coding editor", Content: memoryGeneratedSecondText, Importance: 5, Origin: types.MemoryOriginManual})
+			require.NoError(t, err)
+			require.NotEqual(t, first.ID, second.ID)
+			require.NoError(t, f.db.Where("id=?", second.ID).Take(second).Error, "compare persisted SQL material including canonical timestamps")
+			var publication types.MemoryDerivedPublication
+			require.NoError(t, f.db.Where("object_kind='memory_item' AND object_id=?", first.ID).Order("revision DESC").Take(&publication).Error)
+			var body types.MemoryDerivedBodyReceipt
+			require.NoError(t, f.db.Where("publication_id=?", publication.ID).Take(&body).Error)
+			beforeFacts := memAtomicSQLCount(t, f, "memory_derived_publications")
+			beforeReceipts := memAtomicSQLCount(t, f, "memory_generated_receipts")
+			var beforeSubject types.MemorySubject
+			require.NoError(t, f.db.Where("tenant_id=? AND subject_id=?", f.scope.TenantID, f.scope.SubjectID).Take(&beforeSubject).Error)
+			faultApplied := false
+			transport.afterMerge = func() error {
+				var write *gorm.DB
+				switch mode {
+				case "productive_then_model_successor":
+					return nil
+				case "unsupported_model_result":
+					transport.reply = `{"unsupported":"unaccounted model decision"}`
+					faultApplied = true
+					return nil
+				case "source_after_model":
+					err := revokeMemSharedAgentPolicy(f.ctx, f.db, agent, ownerID)
+					faultApplied = err == nil
+					return err
+				case "body_after_model":
+					write = f.db.Table("original_body_payloads").Where("id=?", body.BodyID).Update("state", "purged")
+				case "actor_after_model":
+					write = f.db.Model(&types.User{}).Where("id=?", types.CallerFromContext(f.ctx).UserID).Update("is_active", false)
+				case "input_lease_after_model":
+					write = f.db.Table("original_body_leases").Where("owner_id LIKE ? AND released_at_ms IS NULL", "memory-generated-read/%").Update("expires_at_ms", 0)
+				case "current_model_after_model":
+					_, svc, _, reader := actualOriginalModelServices(t, f)
+					model, _ := actualModelProof(t, reader, f.ctx, transport.GetModelID())
+					model.Description = "authorized successor during actual generated call"
+					err := svc.UpdateModel(f.ctx, model)
+					faultApplied = err == nil
+					return err
+				default:
+					return fmt.Errorf("unknown actual generated fixture mode")
+				}
+				if write.Error != nil {
+					return write.Error
+				}
+				if write.RowsAffected != 1 {
+					return fmt.Errorf("owned actual control fault affected %d rows", write.RowsAffected)
+				}
+				faultApplied = true
+				return nil
+			}
+			result, err := f.service.ConsolidateNow(f.ctx)
+			require.Equal(t, 1, transport.mergeCalls)
+			require.Len(t, transport.prompts, 1)
+			require.Equal(t, types.MemoryConsolidationOriginalPrompt, transport.prompts[0][0].Content)
+			require.Contains(t, transport.prompts[0][1].Content, first.Content)
+			require.Contains(t, transport.prompts[0][1].Content, second.Content)
+			var original types.MemoryGeneratedOriginal
+			require.NoError(t, f.db.Where("tenant_id=? AND subject_id=?", f.scope.TenantID, f.scope.SubjectID).Take(&original).Error)
+			require.Equal(t, types.MemoryConsolidationOriginalRecipe, original.Recipe)
+			require.Len(t, original.ModelDigest, 64)
+			require.NotEmpty(t, original.ModelProofJSON)
+			var input types.MemoryDerivedManifest
+			require.NoError(t, json.Unmarshal([]byte(original.DerivedInputsJSON), &input))
+			require.Equal(t, input.Digest, original.DerivedInputsDigest)
+			require.Equal(t, types.MemoryOriginalBytesDigest([]byte(original.InputJSON)), original.InputSHA256)
+			if mode != "productive_then_model_successor" {
+				require.Error(t, err)
+				require.True(t, faultApplied)
+				require.Equal(t, beforeReceipts, memAtomicSQLCount(t, f, "memory_generated_receipts"))
+				require.Equal(t, beforeFacts, memAtomicSQLCount(t, f, "memory_derived_publications"))
+				for _, item := range []*types.MemoryItem{&first, second} {
+					var retained types.MemoryItem
+					require.NoError(t, f.db.Where("id=?", item.ID).Take(&retained).Error)
+					require.Equal(t, *item, retained)
+				}
+				var subject types.MemorySubject
+				require.NoError(t, f.db.Where("id=?", beforeSubject.ID).Take(&subject).Error)
+				require.Equal(t, beforeSubject.BlockText, subject.BlockText)
+				require.Equal(t, beforeSubject.ItemCount, subject.ItemCount)
+				require.Equal(t, beforeSubject.ForcedConsolidatedAt, subject.ForcedConsolidatedAt)
+			} else {
+				require.NoError(t, err)
+				require.Equal(t, 1, result.Merged)
+				var receipt types.MemoryGeneratedReceipt
+				require.NoError(t, f.db.Where("original_id=?", original.ID).Take(&receipt).Error)
+				require.Equal(t, original.Digest, receipt.OriginalDigest)
+				require.Equal(t, types.MemoryOriginalBytesDigest([]byte(receipt.ResponseJSON)), receipt.ResponseSHA256)
+				var decisions []types.MemoryGeneratedDecision
+				require.NoError(t, json.Unmarshal([]byte(receipt.ResponseJSON), &decisions))
+				require.Len(t, decisions, 1)
+				require.Contains(t, decisions[0].RawResponse, memoryGeneratedMergedText)
+				var effects []types.MemoryGeneratedEffect
+				require.NoError(t, json.Unmarshal([]byte(receipt.EffectManifest), &effects))
+				actions := map[string]int{}
+				for _, effect := range effects {
+					actions[effect.Action]++
+					var fact types.MemoryDerivedPublication
+					require.NoError(t, f.db.Where("id=?", effect.Proof.PublicationID).Take(&fact).Error)
+					require.Equal(t, "generated", fact.ProducerKind)
+					require.Empty(t, fact.AuthorSelector, "model output must not be authored as human text")
+					require.Equal(t, receipt.ID, fact.CommitID)
+					require.Equal(t, original.ID, fact.InputAdmissionID)
+					var body types.MemoryDerivedBodyReceipt
+					require.NoError(t, f.db.Where("publication_id=?", fact.ID).Take(&body).Error)
+					require.NotEmpty(t, body.BodyID)
+				}
+				require.Equal(t, 1, actions["merge_add"])
+				require.Equal(t, 2, actions["merge_supersede"])
+				require.Equal(t, 1, actions["resident_block"])
+				var replacement types.MemoryItem
+				require.NoError(t, f.db.Where("tenant_id=? AND subject_id=? AND status=?", f.scope.TenantID, f.scope.SubjectID, types.MemoryStatusActive).Take(&replacement).Error)
+				require.Equal(t, memoryGeneratedMergedText, replacement.Content)
+				require.Equal(t, types.MemoryOriginExtracted, replacement.Origin)
+				for _, item := range []*types.MemoryItem{&first, second} {
+					var retired types.MemoryItem
+					require.NoError(t, f.db.Where("id=?", item.ID).Take(&retired).Error)
+					require.Equal(t, types.MemoryStatusSuperseded, retired.Status)
+					require.Equal(t, replacement.ID, retired.SupersededBy)
+				}
+				for _, kind := range []string{"memory_generated_originals", "memory_generated_receipts"} {
+					id := original.ID
+					if strings.HasSuffix(kind, "receipts") {
+						id = receipt.ID
+					}
+					var bound types.MemoryGeneratedBodyReceipt
+					require.NoError(t, f.db.Where("origin_kind=? AND origin_id=?", kind, id).Take(&bound).Error)
+					require.NotEmpty(t, bound.BodyID)
+				}
+				// A lawful later model definition must preserve historical provenance,
+				// while the next consumer still obtains its own current model authority.
+				_, svc, _, reader := actualOriginalModelServices(t, f)
+				model, _ := actualModelProof(t, reader, f.ctx, transport.GetModelID())
+				model.Description = "authorized successor after generated commit"
+				require.NoError(t, svc.UpdateModel(f.ctx, model))
+				lifetime, ok := f.admissions.(interfaces.MemoryDerivedLifetimeReader)
+				require.True(t, ok)
+				read, err := lifetime.BeginMemoryDerivedRead(f.ctx, f.scope)
+				require.NoError(t, err)
+				snapshot, readErr := read.Snapshot()
+				closeErr := read.Close()
+				require.NoError(t, readErr)
+				require.NoError(t, closeErr)
+				found := false
+				for _, item := range snapshot.Items {
+					if item.ID == replacement.ID {
+						require.Equal(t, replacement.Content, item.Content)
+						found = true
+					}
+				}
+				require.True(t, found)
+			}
+			// Retained input/digest is immutable even after a failed model roundtrip.
+			var retained types.MemoryGeneratedOriginal
+			require.NoError(t, f.db.Where("id=?", original.ID).Take(&retained).Error)
+			require.Equal(t, original, retained)
+			assertMemAtomicSQLLeasesClosed(t, f)
+		})
+	}
+}
+func TestMemoryGeneratedConsolidationOriginalActualSQLite(t *testing.T) {
+	runMemoryGeneratedConsolidationSQL(t, false)
+}
+func TestPostgresMemoryGeneratedConsolidationOriginalActual(t *testing.T) {
+	runMemoryGeneratedConsolidationSQL(t, true)
+}
