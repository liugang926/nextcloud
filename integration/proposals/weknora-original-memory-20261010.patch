+	for _, message := range input {
+		b.WriteString(message.Content)
+		b.WriteString("\n")
+	}
+	prompt := b.String()
+	m.prompts = append(m.prompts, prompt)
+	action, content := "add", actualMemoryStoredText
+	var target *int
+	if strings.Contains(prompt, actualMemoryStoredText) {
+		action = "update"
+		index := 0
+		target = &index
+		content = "The user's development editor is VS Code."
+	}
+	if m.partial {
