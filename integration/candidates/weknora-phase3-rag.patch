+CREATE TRIGGER knowledge_enrichment_routing_delete AFTER DELETE ON knowledge_bases BEGIN INSERT INTO knowledge_enrichment_row_versions(row_kind,row_id,revision) VALUES('routing',CAST(OLD.id AS TEXT),1) ON CONFLICT(row_kind,row_id) DO UPDATE SET revision=revision+1; END;
