+	t.Setenv("WEKNORA_ORIGINAL_BODY_JOURNAL_PIN", pin)
+	require.NoError(t, repository.NewOriginalBodyRetentionStore(f.db).InitializeJournal())
+	require.NoError(t, f.db.AutoMigrate(&types.KnowledgeProcessingSpan{}))
