+		VALUES ('event-connection', 1, ?, 'upsert', 77, 'etag-v1', '/Published/file.md', 'file.md', 'dispatched')`, strings.Repeat("0", 64)).Error)
+	now := time.Now().UTC().Truncate(time.Second)
