+package repository
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+// This test adapter reads current membership/policy from the writer tx. HTTP
+// integration uses the real group service through the same factory interface.
+type displayTestGroups struct {
+	interfaces.GroupAccessService
+	db *gorm.DB
+}
+
+func (g displayTestGroups) EffectiveTenantRole(ctx context.Context, id string, tenant uint64, now time.Time) (types.EffectiveTenantRole, error) {
+	role, err := NewGroupAccessRepository(g.db).GetDirectTenantRole(ctx, id, tenant)
+	result := types.EffectiveTenantRole{TenantID: tenant}
+	if role != nil {
+		result.Member = true
+		result.Role = *role
+	}
+	return result, err
+}
+func (g displayTestGroups) EffectivePermission(ctx context.Context, tenant uint64, kind types.ResourceType, id string, action types.ResourceAction, now time.Time) (types.EffectiveResourcePermission, error) {
+	policy, err := NewGroupAccessRepository(g.db).GetResourceAccessPolicy(ctx, tenant, kind, id)
