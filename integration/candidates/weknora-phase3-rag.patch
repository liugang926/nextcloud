diff --git a/internal/application/repository/knowledge_output_recheck.go b/internal/application/repository/knowledge_output_recheck.go
new file mode 100644
index 0000000000000000000000000000000000000000..6eb734c940aac93986ccc8c2563d13491c67cd3b
