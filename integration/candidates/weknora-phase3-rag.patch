+func runNextcloudActualGraphBuildPurpose(t *testing.T, pg bool) {
+	for _, withdraw := range []bool{false, true} {
+		name := "actual staging graph extract worker and public original input verifier"
+		if withdraw {
+			name = "graph model source withdrawal denies graph commit"
+		}
+		t.Run(name, func(t *testing.T) {
+			f, ctx, original, allow, _ := sourceBuildFixture(t, pg)
+			snapshot, e := f.store.CaptureKnowledgeBuildInputs(ctx, types.KnowledgeBuildInputCaptureRequest{Projection: types.KnowledgeBuildProjectionGraph, TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: f.k.ID, ChunkIDs: []string{f.chunks[0].ID}, Expected: original})
+			require.NoError(t, e)
+			empty, _ := types.NewCompleteSourceLineage()
+			template, e := types.BindGraphPromptTemplateOrigin(&types.PromptTemplateStructured{Description: "code-owned graph protocol %s"}, empty)
+			require.NoError(t, e)
+			model := &graphEntryModel{}
+			if withdraw {
+				model.call = func(_ []chat.Message, _ *chat.ChatOptions) { allow.Store(false) }
+			}
+			graph := &enrichmentBuildGraphRepository{}
+			svc := &ChunkExtractService{buildInputs: f.store, template: template, modelService: &graphEntryModels{model: model}, graphEngine: graph}
+			p := types.ExtractChunkPayload{TenantID: 7, KnowledgeID: f.k.ID, ChunkID: f.chunks[0].ID, ModelID: "summary", OriginalInput: snapshot.Proof}
+			e = svc.Handle(ctx, enrichmentTask(t, types.TypeChunkExtract, p))
+			require.Equal(t, 1, model.calls)
+			if withdraw {
+				require.Error(t, e)
+				require.Empty(t, graph.graphs)
+				return
+			}
+			require.NoError(t, e)
+			require.Len(t, graph.graphs, 1)
+			require.NoError(t, NewGraphOriginalInputVerifier(f.store).RecheckGraphOriginalInputs(ctx, graph.graphs[0].SourceReceipt))
+			require.Error(t, NewGraphOriginalInputVerifier(f.store).RecheckGraphOriginalInputs(f.ctx, graph.graphs[0].SourceReceipt))
+		})
+	}
+}
+func TestKnowledgeNextcloudActualGraphBuildPurposeSQLite(t *testing.T) {
+	runNextcloudActualGraphBuildPurpose(t, false)
+}
+func TestPostgresKnowledgeNextcloudActualGraphBuildPurpose(t *testing.T) {
+	runNextcloudActualGraphBuildPurpose(t, true)
+}
diff --git a/internal/application/service/knowledge_output_file.go b/internal/application/service/knowledge_output_file.go
new file mode 100644
index 0000000000000000000000000000000000000000..d2b97767df7c8cf0bf4abd9b31079c4d42623ab7
--- /dev/null
+++ b/internal/application/service/knowledge_output_file.go
@@ -0,0 +1,117 @@
+package service
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"sync"
+	"unicode/utf8"
+
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+type knowledgeOutputFileSnapshot struct {
+	*os.File
+	directory string
+	once      sync.Once
+	err       error
+}
+
+func (f *knowledgeOutputFileSnapshot) Close() error {
+	f.once.Do(func() {
+		f.err = errors.Join(f.File.Close(), os.Remove(f.File.Name()), os.Remove(f.directory))
+	})
+	return f.err
+}
+
+// BindFile snapshots the actual opened artifact before any public byte leaves
+// the process. Its digest must match the retained original input, not current
+// filename/hash metadata. The returned private file supports HTTP ranges and
+// is removed on Close; permission/proof guards still apply to its delivery.
+func (g *KnowledgeOutputGuard) BindFile(ctx context.Context, row *types.Knowledge, input io.ReadCloser) (io.ReadSeekCloser, error) {
+	if input == nil {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	defer input.Close()
+	if err := g.Check(ctx, []*types.Knowledge{row}); err != nil {
+		return nil, err
+	}
+	entry, exists := g.entries[knowledgeOutputKey(row)]
+	if !exists {
+		return nil, repository.ErrKnowledgeInputChanged
+	}
+	if row.Type != "file" && row.Type != types.KnowledgeTypeManual {
+		// URL/passage/other physical artifacts need a typed original artifact
+		// receipt. A URL string or generated passage cannot certify bytes.
+		return nil, types.ErrSourceLineageUnknown
+	}
+	directory, err := os.MkdirTemp("", "weknora-output-")
+	if err != nil {
+		return nil, err
+	}
+	file, err := os.OpenFile(directory+"/artifact", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+	if err != nil {
+		_ = os.Remove(directory)
+		return nil, err
+	}
+	snapshot := &knowledgeOutputFileSnapshot{File: file, directory: directory}
+	keep := false
+	defer func() {
+		if !keep {
+			_ = snapshot.Close()
+		}
+	}()
+	var digest string
+	if row.Type == types.KnowledgeTypeManual {
+		// Manual authoring is capped at 200,000 Unicode runes. This bound is
+		// larger than its maximal UTF-8 byte representation, without allowing
+		// an unrelated unbounded reader to masquerade as manual input.
+		body, err := io.ReadAll(io.LimitReader(input, 1024*1024+1))
+		if err != nil {
+			return nil, err
+		}
+		if len(body) > 1024*1024 {
+			return nil, types.ErrSourceLineageLimit
+		}
+		if !utf8.Valid(body) {
+			return nil, repository.ErrKnowledgeInputChanged
+		}
+		digest, err = repository.KnowledgeInputDigest(string(body))
+		if err != nil {
+			return nil, err
+		}
+		if _, err := file.Write(body); err != nil {
+			return nil, err
+		}
+	} else {
+		// KnowledgeInputDigest([]byte) is SHA-256 of the canonical JSON
+		// base64 string. Encode the exact copied bytes incrementally so large
+		// uploads do not require an equally large heap allocation.
+		hash := sha256.New()
+		_, _ = hash.Write([]byte{'"'})
+		encoder := base64.NewEncoder(base64.StdEncoding, hash)
+		_, copyErr := io.Copy(io.MultiWriter(file, encoder), input)
+		encodeErr := encoder.Close()
+		if err := errors.Join(copyErr, encodeErr); err != nil {
+			return nil, err
+		}
+		_, _ = hash.Write([]byte{'"'})
+		digest = hex.EncodeToString(hash.Sum(nil))
+	}
+	if digest != entry.proof.InputDigest {
+		return nil, repository.ErrKnowledgeInputChanged
+	}
+	if err := g.Check(ctx, []*types.Knowledge{row}); err != nil {
+		return nil, err
+	}
+	if _, err := file.Seek(0, io.SeekStart); err != nil {
+		return nil, err
+	}
+	keep = true
+	return snapshot, nil
+}
