+	for _, name := range []string{"000032_nextcloud_event_inbox.up.sql", "000033_nextcloud_event_dispatch.up.sql", "000049_nextcloud_event_hint_etag.up.sql"} {
+		schema, err := os.ReadFile("../../../migrations/sqlite/" + name)
