@@ -0,0 +1,83 @@
+package repository
+
+import (
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+	"github.com/stretchr/testify/require"
+)
+
+func nextcloudWithdrawalInventorySQLiteDB(t *testing.T) *sql.DB {
+	t.Helper()
+	db, err := sql.Open("sqlite3", "file:"+filepath.Join(t.TempDir(), "withdrawal.db")+"?_foreign_keys=on")
+	require.NoError(t, err)
+	db.SetMaxOpenConns(1)
+	t.Cleanup(func() { _ = db.Close() })
+	_, err = db.Exec(`CREATE TABLE nextcloud_source_pairings (operation_id TEXT PRIMARY KEY);
+		CREATE TABLE nextcloud_source_decommissions (pair_operation_id TEXT NOT NULL);
+		CREATE TABLE data_sources (id TEXT PRIMARY KEY, status TEXT NOT NULL);
+		INSERT INTO nextcloud_source_pairings (operation_id) VALUES ('pair');
+		INSERT INTO data_sources (id, status) VALUES ('ds', 'paused')`)
+	require.NoError(t, err)
+	script, err := os.ReadFile("../../../migrations/sqlite/000044_nextcloud_indexed_withdrawal.up.sql")
+	require.NoError(t, err)
+	_, err = db.Exec(string(script))
+	require.NoError(t, err)
+	_, err = db.Exec(`INSERT INTO nextcloud_indexed_withdrawals
+		(operation_id, pair_operation_id, tenant_id, knowledge_base_id,
+		 datasource_id, nextcloud_instance_id, binding_id, publication_epoch, key_id)
+		VALUES ('withdrawal', 'pair', 7, 'kb', 'ds', 'instance', 'binding', 1, 'key');
+		INSERT INTO nextcloud_indexed_withdrawal_items
+		(operation_id, kind, object_ref, knowledge_id)
+		VALUES ('withdrawal', 'source_version', 'source', 'current')`)
+	require.NoError(t, err)
+	return db
+}
+
+func TestSQLiteNextcloudWithdrawalRevisionInventoryMigration(t *testing.T) {
+	for _, keepRevision := range []bool{false, true} {
+		t.Run(map[bool]string{false: "reversible_empty", true: "retained_revision"}[keepRevision],
+			func(t *testing.T) {
+				db := nextcloudWithdrawalInventorySQLiteDB(t)
+				up, err := os.ReadFile("../../../migrations/sqlite/000048_nextcloud_withdrawal_revision_inventory.up.sql")
+				require.NoError(t, err)
+				_, err = db.Exec(string(up))
+				require.NoError(t, err)
+				var count int
+				require.NoError(t, db.QueryRow(`SELECT COUNT(*) FROM nextcloud_indexed_withdrawal_items
+					WHERE operation_id = 'withdrawal' AND kind = 'source_version'
+					AND object_ref = 'source' AND knowledge_id = 'current'`).Scan(&count))
+				require.Equal(t, 1, count, "the old inventory must survive the table rebuild")
+				_, err = db.Exec(`UPDATE nextcloud_indexed_withdrawal_items SET knowledge_id = 'forged'
+					WHERE operation_id = 'withdrawal'`)
+				require.ErrorContains(t, err, "nextcloud_indexed_withdrawal_item_immutable")
+				if keepRevision {
+					_, err = db.Exec(`INSERT INTO nextcloud_indexed_withdrawal_items
+						(operation_id, kind, object_ref, knowledge_id)
+						VALUES ('withdrawal', 'source_revision', '["source",2]', 'old-copy')`)
+					require.NoError(t, err)
+				}
+				down, err := os.ReadFile("../../../migrations/sqlite/000048_nextcloud_withdrawal_revision_inventory.down.sql")
+				require.NoError(t, err)
+				_, err = db.Exec(string(down))
+				if keepRevision {
+					require.Error(t, err, "observed revisions must block a destructive downgrade")
+					require.NoError(t, db.QueryRow(`SELECT COUNT(*) FROM nextcloud_indexed_withdrawal_items
+						WHERE kind = 'source_revision'`).Scan(&count))
+					require.Equal(t, 1, count)
+					return
+				}
+				require.NoError(t, err)
+				_, err = db.Exec(`INSERT INTO nextcloud_indexed_withdrawal_items
+					(operation_id, kind, object_ref, knowledge_id)
+					VALUES ('withdrawal', 'source_revision', '["source",2]', 'old-copy')`)
+				require.Error(t, err, "the old schema must reject the new inventory kind")
+				require.NoError(t, db.QueryRow(`SELECT COUNT(*) FROM nextcloud_indexed_withdrawal_items
+					WHERE kind = 'source_version'`).Scan(&count))
+				require.Equal(t, 1, count)
+			})
+	}
+}
diff --git a/internal/application/repository/original_body_audit.go b/internal/application/repository/original_body_audit.go
new file mode 100644
index 0000000000000000000000000000000000000000..e0c81acb2853ad9d4e6b96e1092a541697b93f6a
--- /dev/null
+++ b/internal/application/repository/original_body_audit.go
@@ -0,0 +1,177 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"gorm.io/gorm"
+	"strings"
+)
+
+// gcOriginalBodyAuditMetadata preserves stable metadata fingerprints only
+// after independently checking each known body's live bytes or purge receipt.
+// Existing untracked rows enter the body protocol under their actual SQL scope;
+// this does not create or authenticate an input provenance origin.
+func gcOriginalBodyAuditMetadata(tx *gorm.DB, table, key string, row map[string]any) ([]byte, error) {
+	if !originalBodySchemaPresent(tx) {
+		return json.Marshal(row)
+	}
+	d, known := bodyDescriptor(table)
+	if !known {
+		return json.Marshal(row)
+	}
+	store := NewOriginalBodyRetentionStore(tx)
+	scope, e := bodyScopeFromRow(tx, d, key, row)
+	if e != nil {
+		return nil, e
+	}
+	metadata := map[string]any{}
+	for k, v := range row {
+		metadata[k] = v
+	}
+	for _, field := range d.Columns {
+		raw, e := bodyFieldValue(row, field)
+		if e != nil {
+			return nil, e
+		}
+		var head originalBodyFieldHead
+		e = bodyInternal(tx).Where("source_table=? AND row_key=? AND column_name=?", table, key, field).Take(&head).Error
+		if errors.Is(e, gorm.ErrRecordNotFound) {
+			if raw == "" || raw == "null" {
+				continue
+			}
+			if e = store.captureField(tx, d, key, field, raw, scope); e != nil {
+				return nil, e
+			}
+			if e = bodyInternal(tx).Where("source_table=? AND row_key=? AND column_name=?", table, key, field).Take(&head).Error; e != nil {
+				return nil, e
+			}
+		} else if e != nil {
+			return nil, e
+		}
+		// Capture may have moved a legacy vault column into its reference. Reload
+		// the exact physical row, bypassing consumer body resolution.
+		actual, e := bodySourceRow(tx, d, key)
+		if e != nil {
+			return nil, e
+		}
+		raw, e = bodyFieldValue(actual, field)
+		if e != nil {
+			return nil, e
+		}
+		if e = store.verifyFieldStorageInTx(tx, d, head, raw, scope); e != nil {
+			return nil, e
+		}
+		if strings.Contains(field, ".") {
+			base := bodyFieldColumn(field)
+			full := bodyText(metadata[base])
+			if raw != "null" {
+				cleared, e := bodyNestedReplace(full, field, raw, "")
+				if e != nil {
+					return nil, e
+				}
+				metadata[base] = json.RawMessage(cleared)
+			}
+		} else {
+			delete(metadata, field)
+		}
+	}
+	return json.Marshal(metadata)
+}
+
+func (s *OriginalBodyRetentionStore) verifyFieldStorageInTx(tx *gorm.DB, d originalBodyFieldDescriptor, head originalBodyFieldHead, raw string, scope originalBodyScope) error {
+	if bodyIdentity(d.Table, head.RowKey, head.ColumnName, scope) != head.SourceIdentitySHA256 {
+		return ErrOriginalBodyUnavailable
+	}
+	if e := s.checkJournalInTx(tx); e != nil {
+		return e
+	}
+	var body originalBodyPayload
+	if e := bodyInternal(tx).Where("id=?", head.BodyID).Take(&body).Error; e != nil {
+		return e
+	}
+	if body.State == "live" {
+		if d.Mode == "vault" {
+			ref, ok := bodyReference(raw)
+			if !ok || raw != head.OriginalBodyRef {
+				return ErrOriginalBodyUnavailable
+			}
+			_, e := s.resolveInTx(tx, head, ref)
+			return e
+		}
+		if bodySHA([]byte(raw)) != body.BodySHA256 {
+			return ErrOriginalBodyUnavailable
+		}
+		return s.checkExternalBody(body.ID)
+	}
+	if body.State != "purged" || body.Payload != nil {
+		return ErrOriginalBodyUnavailable
+	}
+	if d.Mode == "vault" {
+		if raw != head.OriginalBodyRef {
+			return ErrOriginalBodyUnavailable
+		}
+	} else if raw != "" && raw != "null" {
+		return ErrOriginalBodyUnavailable
+	}
+	var receipt originalBodyPurgeReceipt
+	if e := bodyInternal(tx).Where("body_id=?", body.ID).Take(&receipt).Error; e != nil {
+		return e
+	}
+	if receipt.AfterBytes != 0 || receipt.BodySHA256 != body.BodySHA256 {
+		return ErrOriginalBodyUnavailable
+	}
+	events, _, e := s.journal.read()
+	if e != nil {
+		return e
+	}
+	for _, event := range events {
+		if event.BodyID == body.ID {
+			if event.BodySHA256 != body.BodySHA256 || event.ScopeSHA256 != receipt.ScopeSHA256 || event.Sequence != receipt.JournalSequence || event.HeadSHA256 != receipt.JournalHeadSHA256 {
+				return ErrOriginalBodyUnavailable
+			}
+			for _, identity := range event.Fields {
+				if identity == head.SourceIdentitySHA256 {
+					return nil
+				}
+			}
+		}
+	}
+	return ErrOriginalBodyUnavailable
+}
+
+// InventorySelectedJob captures pre-protocol body columns in the same exact
+// SQL inventory that local derived GC keeps as metadata. It verifies already
+// purged references/empty leaves rather than admitting restored inline text.
+func (s *OriginalBodyRetentionStore) inventorySelectedJob(ctx context.Context, job nextcloudGCJob) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if e := gcValidateManualAdmin(ctx, bodyInternal(tx), job); e != nil {
+			return e
+		}
+		if _, e := gcAuditInventory(bodyInternal(tx), job); e != nil {
+			return e
+		}
+		for _, table := range []string{"knowledges", "chunks"} {
+			d, _ := bodyDescriptor(table)
+			if !tx.Migrator().HasTable(table) {
+				continue
+			}
+			query := bodyInternal(tx).Table(table).Where("tenant_id=? AND knowledge_base_id=?", job.TenantID, job.KnowledgeBaseID)
+			if table == "knowledges" {
+				query = query.Where("id=?", job.KnowledgeID)
+			} else {
+				query = query.Where("knowledge_id=?", job.KnowledgeID)
+			}
+			var rows []map[string]any
+			if e := query.Find(&rows).Error; e != nil {
+				return e
+			}
+			for _, row := range rows {
+				if _, e := gcOriginalBodyAuditMetadata(tx, table, bodyText(row[d.Key]), row); e != nil {
+					return e
+				}
+			}
+		}
+		return nil
+	})
+}
diff --git a/internal/application/repository/original_body_fields.go b/internal/application/repository/original_body_fields.go
new file mode 100644
index 0000000000000000000000000000000000000000..3cd6c818cb0698bb0e871cb31263eb290e2fcd5c
--- /dev/null
+++ b/internal/application/repository/original_body_fields.go
@@ -0,0 +1,787 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+type originalBodyFieldDescriptor struct {
+	Table, Key, Mode string
+	Columns          []string
+}
+
+var originalBodyFields = []originalBodyFieldDescriptor{
+	{"datasource_name_inputs", "id", "vault", []string{"actual_inputs"}},
+	{"nextcloud_original_upload_inputs", "knowledge_id", "vault", []string{"actual_inputs"}},
+	{"knowledge_auto_tag_input_manifests", "manifest_id", "vault", []string{"actual_inputs"}},
+	{"knowledge_display_input_origins", "origin_id", "vault", []string{"actual_input"}},
+	{"knowledge_span_start_manifests", "run_token", "vault", []string{"original_input", "actual_inputs"}},
+	{"knowledge_enrichment_template_inputs", "id", "vault", []string{"parents"}},
+	{"faq_input_sessions", "id", "vault", []string{"input_body", "original_snapshot", "current_snapshot"}},
+	{"faq_import_output_admissions", "id", "vault", []string{"body"}},
+	{"message_generation_origins", "id", "vault", []string{"initial_input"}},
+	// Old generated/fork parent snapshots can contain a second Messages copy.
+	// Inventory recognizes only that leaf, preserving proof metadata. With no
+	// durable copy/closure receipt these copies remain explicit blockers.
+	{"message_generated_field_admissions", "id", "unsupported", []string{"parent_materials.*.Messages"}},
+	{"message_fork_parent_origins", "generation_id", "unsupported", []string{"parent_materials.*.Messages"}},
+	// Current entity columns keep their SQL search/storage representation. Their
+	// exact mirror receipts permit clearing only after actual lifecycle closure.
+	{"knowledge_processing_spans", "id", "inline", []string{"input", "output", "error_message", "error_detail"}},
+	{"knowledges", "id", "inline", []string{"title", "file_name", "description", "profile", "custom_metadata", "metadata.manual.content"}},
+	{"chunks", "id", "inline", []string{"content", "source_content", "context_header", "metadata", "image_info"}},
+	{"messages", "id", "inline", []string{"content", "rendered_content", "context_checkpoint", "agent_trace", "agent_steps", "images", "attachments", "knowledge_references", "used_memories"}},
+	{"sessions", "id", "inline", []string{"title", "description"}},
+	{"wiki_pages", "id", "unsupported", []string{"content", "summary", "page_metadata"}},
+	{"wiki_page_revisions", "id", "unsupported", []string{"content", "summary"}},
+}
+
+func bodyDescriptor(table string) (originalBodyFieldDescriptor, bool) {
+	for _, d := range originalBodyFields {
+		if d.Table == table {
+			return d, true
+		}
+	}
+	return originalBodyFieldDescriptor{}, false
+}
+
+// Nested fields are exact JSON leaves. Whole metadata is never a body slot.
+func bodyFieldColumn(field string) string { return strings.Split(field, ".")[0] }
+func bodyFieldValue(row map[string]any, field string) (string, error) {
+	parts := strings.Split(field, ".")
+	raw := bodyText(row[parts[0]])
+	if field == "parent_materials.*.Messages" {
+		return legacyParentMessageBodies(raw)
+	}
+	if len(parts) == 1 || raw == "" || raw == "null" {
+		return raw, nil
+	}
+	var value any
+	if e := json.Unmarshal([]byte(raw), &value); e != nil {
+		return "", fmt.Errorf("body JSON %s type %T: %w", field, row[parts[0]], e)
+	}
+	for _, part := range parts[1:] {
+		object, ok := value.(map[string]any)
+		if !ok {
+			return "", nil
+		}
+		value = object[part]
+	}
+	if value == nil {
+		return "", nil
+	}
+	result, ok := value.(string)
+	if !ok {
+		return "", ErrOriginalBodyUnavailable
+	}
+	return result, nil
+}
+func bodyNestedReplace(raw, field, old, replacement string) (string, error) {
+	parts := strings.Split(field, ".")
+	var object map[string]any
+	if e := json.Unmarshal([]byte(raw), &object); e != nil {
+		return "", e
+	}
+	current := object
+	for _, part := range parts[1 : len(parts)-1] {
+		next, ok := current[part].(map[string]any)
+		if !ok {
+			return "", ErrOriginalBodyUnavailable
+		}
+		current = next
+	}
+	leaf := parts[len(parts)-1]
+	if value, ok := current[leaf].(string); !ok || value != old {
+		return "", ErrOriginalBodyUnavailable
+	}
+	current[leaf] = replacement
+	data, e := json.Marshal(object)
+	return string(data), e
+}
+func bodyText(v any) string {
+	if v != nil {
+		value := reflect.ValueOf(v)
+		if value.Kind() == reflect.Pointer {
+			if value.IsNil() {
+				return ""
+			}
+			return bodyText(value.Elem().Interface())
+		}
+	}
+	switch value := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return value
+	case []byte:
+		return string(value)
+	default:
+		return fmt.Sprint(value)
+	}
+}
+func bodyUint(v any) uint64 { n, _ := strconv.ParseUint(bodyText(v), 10, 64); return n }
+func bodySourceRow(tx *gorm.DB, d originalBodyFieldDescriptor, key string) (map[string]any, error) {
+	var rows []map[string]any
+	e := bodyInternal(tx).Table(d.Table).Where(d.Key+"=?", key).Find(&rows).Error
+	if e != nil {
+		return nil, e
+	}
+	if len(rows) == 0 {
+		return nil, gorm.ErrRecordNotFound
+	}
+	if len(rows) != 1 {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	return rows[0], nil
+}
+func bodyScopeFromRow(tx *gorm.DB, d originalBodyFieldDescriptor, key string, row map[string]any) (originalBodyScope, error) {
+	scope := originalBodyScope{Tenant: bodyUint(row["tenant_id"]), KB: bodyText(row["knowledge_base_id"]), Knowledge: bodyText(row["knowledge_id"]), OwnerKind: d.Table, OwnerID: key, AdmissionID: bodyText(row["admission_id"]), Lineage: bodyText(row["source_lineage"])}
+	if d.Table == "knowledges" {
+		scope.Knowledge = key
+	}
+	if d.Table == "messages" || d.Table == "message_generation_origins" {
+		// The immutable origin is inserted before its message. Its scope comes
+		// from that origin/session, never a later mutable indexed-knowledge link.
+		sessionID := bodyText(row["session_id"])
+		session, e := bodySourceRow(tx, originalBodyFieldDescriptor{Table: "sessions", Key: "id"}, sessionID)
+		if e != nil {
+			return scope, e
+		}
+		tenant := bodyUint(session["tenant_id"])
+		if d.Table == "message_generation_origins" && scope.Tenant != tenant {
+			return scope, ErrOriginalBodyUnavailable
+		}
+		scope.Tenant = tenant
+		scope.KB = ""
+		scope.Knowledge = ""
+		scope.OwnerID = sessionID + "/" + key
+	}
+
+	if d.Table == "message_fork_parent_origins" {
+		origin, e := bodySourceRow(tx, originalBodyFieldDescriptor{Table: "message_generation_origins", Key: "id"}, key)
+		if e != nil {
+			return scope, e
+		}
+		scope.Tenant = bodyUint(origin["tenant_id"])
+		scope.Knowledge = ""
+		scope.KB = ""
+		scope.OwnerID = bodyText(origin["session_id"]) + "/" + key
+	}
+	if scope.Knowledge != "" && (scope.Tenant == 0 || scope.KB == "") {
+		knowledge, e := bodySourceRow(tx, originalBodyFieldDescriptor{Table: "knowledges", Key: "id"}, scope.Knowledge)
+		if e != nil {
+			return scope, e
+		}
+		if scope.Tenant == 0 {
+			scope.Tenant = bodyUint(knowledge["tenant_id"])
+		}
+		if scope.KB == "" {
+			scope.KB = bodyText(knowledge["knowledge_base_id"])
+		}
+	}
+	if d.Table == "sessions" {
+		scope.Tenant = bodyUint(row["tenant_id"])
+	}
+	if scope.Tenant == 0 {
+		return scope, ErrOriginalBodyUnavailable
+	}
+	return scope, nil
+}
+func (s *OriginalBodyRetentionStore) captureField(tx *gorm.DB, d originalBodyFieldDescriptor, key, col, raw string, scope originalBodyScope) error {
+	if e := s.checkJournalInTx(tx); e != nil {
+		return e
+	}
+	if raw == "" || raw == "null" {
+		return nil
+	}
+	if _, ok := bodyReference(raw); ok {
+		var head originalBodyFieldHead
+		if e := bodyInternal(tx).Where("source_table=? AND row_key=? AND column_name=?", d.Table, key, col).Take(&head).Error; e != nil {
+			return ErrOriginalBodyUnavailable
+		}
+		if head.OriginalBodyRef != raw {
+			return ErrOriginalBodyUnavailable
+		}
+		return CheckOriginalBodyAvailableInTx(tx.Statement.Context, tx, d.Table, key)
+	}
+	sha := bodySHA([]byte(raw))
+	identity := bodyIdentity(d.Table, key, col, scope)
+	var prior originalBodyFieldHead
+	e := bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Where("source_table=? AND row_key=? AND column_name=?", d.Table, key, col).Take(&prior).Error
+	if e != nil && !errors.Is(e, gorm.ErrRecordNotFound) {
+		return e
+	}
+	now, e := nextcloudLeaseNowMS(bodyInternal(tx))
+	if e != nil {
+		return e
+	}
+	if prior.SlotID != "" {
+		if prior.SourceIdentitySHA256 != identity {
+			return ErrOriginalBodyUnavailable
+		}
+		var old originalBodyPayload
+		if e := bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=?", prior.BodyID).Take(&old).Error; e != nil {
+			return e
+		}
+		if old.State != "live" {
+			return ErrOriginalBodyUnavailable
+		}
+		if e := s.checkExternalBody(old.ID); e != nil {
+			return e
+		}
+		if old.BodySHA256 == sha {
+			return nil
+		}
+		// A genuine producer change retires the prior representation. Cached
+		// originals are still checked by their own original producer before writing.
+		if old.RetiredAtMS == nil {
+			if e := bodyInternal(tx).Model(&old).Updates(map[string]any{"retired_at_ms": now, "body_deadline_ms": now + int64(3600000), "metadata_deadline_ms": now + int64(90*86400000)}).Error; e != nil {
+				return e
+			}
+		}
+	}
+	domain := scope.OwnerKind + "/" + scope.OwnerID
+	if scope.AdmissionID != "" {
+		domain = "admission/" + scope.AdmissionID
+	}
+	domainSHA := bodySHA([]byte(fmt.Sprintf("%d/%s/%s/%s", scope.Tenant, scope.KB, scope.Knowledge, domain)))
+	var body originalBodyPayload
+	e = bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Where("tenant_id=? AND origin_domain_sha256=? AND body_sha256=? AND storage_kind=? AND state='live'", scope.Tenant, domainSHA, sha, d.Mode).Order("created_at_ms,id").Take(&body).Error
+	if errors.Is(e, gorm.ErrRecordNotFound) {
+		id := uuid.NewString()
+		var payload *string
+		if d.Mode == "vault" {
+			payload = &raw
+		}
+		body = originalBodyPayload{ID: id, TenantID: scope.Tenant, BodySHA256: sha, OriginDomainSHA256: domainSHA, Payload: payload, BodyBytes: int64(len([]byte(raw))), StorageKind: d.Mode, State: "live", CreatedAtMS: now}
+		if e = bodyInternal(tx).Create(&body).Error; e != nil {
+			return e
+		}
+	} else if e != nil {
+		return e
+	}
+	if e := s.recordMessageLeaseScopes(tx, body.ID, d, key, raw, scope); e != nil {
+		return e
+	}
+	id := body.ID
+	slot := prior.SlotID
+	if slot == "" {
+		slot = uuid.NewString()
+	}
+	ref := bodyRefString(slot, id, sha)
+	if d.Mode == "vault" && tx.Dialector.Name() == "postgres" {
+		// JSON columns canonicalize object references in PostgreSQL; text fields
+		// preserve exact producer bytes. Authority compares the actual stored form.
+		if jsonCol, e := originalBodyColumnIsJSON(tx, d.Table, col); e != nil {
+			return e
+		} else if jsonCol {
+			if e = bodyInternal(tx).Raw("SELECT CAST(? AS jsonb)::text", ref).Scan(&ref).Error; e != nil {
+				return e
+			}
+		}
+	}
+	head := originalBodyFieldHead{SlotID: slot, SourceTable: d.Table, RowKey: key, ColumnName: col, TenantID: scope.Tenant, KnowledgeBaseID: scope.KB, KnowledgeID: scope.Knowledge, OwnerKind: scope.OwnerKind, OwnerID: scope.OwnerID, SourceIdentitySHA256: identity, BodyID: id, Revision: prior.Revision + 1, AdmissionID: scope.AdmissionID, SourceLineage: scope.Lineage, OriginalBodyRef: ref}
+	if e := bodyInternal(tx).Clauses(clause.OnConflict{Columns: []clause.Column{{Name: "source_table"}, {Name: "row_key"}, {Name: "column_name"}}, UpdateAll: true}).Create(&head).Error; e != nil {
+		return e
+	}
+	if e := bodyInternal(tx).Table("original_body_field_revisions").Create(&head).Error; e != nil {
+		return e
+	}
+	if e := s.recordBodyParents(tx, body.ID, raw); e != nil {
+		return e
+	}
+	if d.Table == "faq_input_sessions" {
+		row, e := bodySourceRow(tx, d, key)
+		if e != nil {
+			return e
+		}
+		if e := s.recordBodyParents(tx, body.ID, bodyText(row["original_inputs"])); e != nil {
+			return e
+		}
+	}
+	if d.Mode == "vault" {
+		return originalBodyRewrite(tx, d, key, col, id, raw, ref)
+	}
+	return nil
+}
+func (s *OriginalBodyRetentionStore) recordBodyParents(tx *gorm.DB, id, raw string) error {
+	var data any
+	if json.Unmarshal([]byte(raw), &data) != nil {
+		return nil
+	}
+	seen := map[string]bool{}
+	var walk func(any) error
+	walk = func(value any) error {
+		switch v := value.(type) {
+		case []any:
+			for _, child := range v {
+				if e := walk(child); e != nil {
+					return e
+				}
+			}
+		case map[string]any:
+			admission, ok := v["admission_id"].(string)
+			if ok && admission != "" && !seen[admission] && v["knowledge_id"] != nil {
+				var origin knowledgeInputAdmission
+				if e := bodyInternal(tx).Where("admission_id=?", admission).Take(&origin).Error; e != nil {
+					return ErrOriginalBodyUnavailable
+				}
+				if bodyText(v["knowledge_id"]) != origin.KnowledgeID || bodyText(v["knowledge_base_id"]) != origin.KnowledgeBaseID {
+					return ErrOriginalBodyUnavailable
+				}
+				seen[admission] = true
+				if e := bodyInternal(tx).Clauses(clause.OnConflict{DoNothing: true}).Create(&originalBodyParentRef{BodyID: id, TenantID: origin.TenantID, KnowledgeBaseID: origin.KnowledgeBaseID, KnowledgeID: origin.KnowledgeID, AdmissionID: admission}).Error; e != nil {
+					return e
+				}
+			}
+			for _, child := range v {
+				if e := walk(child); e != nil {
+					return e
+				}
+			}
+		}
+		return nil
+	}
+	return walk(data)
+}
+
+// Inventory moves exact known SQL fields without granting a producer origin.
+// Existing unknown/external copies remain independently observable; the scan
+// never signs a legacy generation from a current configuration or empty rows.
+func (s *OriginalBodyRetentionStore) Inventory(ctx context.Context, limit int) (int, error) {
+	if limit <= 0 || limit > 1000 {
+		limit = 100
+	}
+	count := 0
+	for _, d := range originalBodyFields {
+		if !s.db.Migrator().HasTable(d.Table) {
+			continue
+		}
+		var keys []string
+		if e := bodyInternal(s.db.WithContext(ctx)).Table(d.Table).Select("CAST(" + d.Key + " AS TEXT)").Order(d.Key).Limit(limit).Scan(&keys).Error; e != nil {
+			return count, e
+		}
+		for _, key := range keys {
+			e := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+				row, e := bodySourceRow(tx, d, key)
+				if e != nil {
+					return e
+				}
+				scope, e := bodyScopeFromRow(tx, d, key, row)
+				if e != nil {
+					return e
+				}
+				for _, col := range d.Columns {
+					raw, e := bodyFieldValue(row, col)
+					if e != nil {
+						return e
+					}
+					if raw == "" {
+						continue
+					}
+					if e := s.captureField(tx, d, key, col, raw, scope); e != nil {
+						return e
+					}
+				}
+				return nil
+			})
+			if e != nil {
+				return count, e
+			}
+			count++
+		}
+	}
+	return count, nil
+}
+
+var originalBodyCallbackMu sync.Mutex
+
+// Register real producer/read callbacks once. They are inactive before the
+// migration and use the caller's transaction, including SQLite pool size one.
+func InstallOriginalBodyRetentionCallbacks(db *gorm.DB) error {
+	originalBodyCallbackMu.Lock()
+	defer originalBodyCallbackMu.Unlock()
+	if db.Callback().Query().Get("original_body:resolve") != nil {
+		return nil
+	}
+	write := func(tx *gorm.DB) {
+		if os.Getenv("WEKNORA_BODY_CALLBACK_DEBUG") == "1" {
+			fmt.Fprintf(os.Stderr, "body callback table=%s type=%T internal=%v err=%v\n", tx.Statement.Table, tx.Statement.Dest, tx.Statement.Context.Value(originalBodyInternalKey{}), tx.Error)
+		}
+		if tx.Error != nil {
+			return
+		}
+		if inside, _ := tx.Statement.Context.Value(originalBodyInternalKey{}).(bool); inside {
+			return
+		}
+		d, ok := bodyDescriptor(tx.Statement.Table)
+		if !ok {
+			return
+		}
+		feature := originalBodySchemaPresent(tx)
+		if os.Getenv("WEKNORA_BODY_CALLBACK_DEBUG") == "1" {
+			fmt.Fprintf(os.Stderr, "body feature=%v table=%s schema=%v reflect=%v\n", feature, tx.Statement.Table, tx.Statement.Schema != nil, tx.Statement.ReflectValue.Kind())
+		}
+		if !feature {
+			return
+		}
+		store := NewOriginalBodyRetentionStore(tx)
+		if e := store.captureStatement(tx, d); e != nil {
+			tx.AddError(e)
+		}
+	}
+	read := func(tx *gorm.DB) {
+		if tx.Error != nil {
+			return
+		}
+		if inside, _ := tx.Statement.Context.Value(originalBodyInternalKey{}).(bool); inside {
+			return
+		}
+		table := tx.Statement.Table
+		d, ok := bodyDescriptor(table)
+		if !ok && tx.Statement.Schema != nil {
+			d, ok = bodyDescriptor(tx.Statement.Schema.Table)
+		}
+		if !ok {
+			return
+		}
+		if !originalBodySchemaPresent(tx) {
+			return
+		}
+		store := NewOriginalBodyRetentionStore(tx)
+		if e := store.resolveStatement(tx, d); e != nil {
+			tx.AddError(e)
+		}
+	}
+	if e := db.Callback().Create().After("gorm:create").Before("gorm:save_after_associations").Register("original_body:capture", write); e != nil {
+		return e
+	}
+	if e := db.Callback().Update().After("gorm:update").Before("gorm:save_after_associations").Register("original_body:capture", write); e != nil {
+		return e
+	}
+	return db.Callback().Query().After("gorm:query").Before("gorm:after_query").Register("original_body:resolve", read)
+}
+func bodyVisit(value reflect.Value, fn func(reflect.Value) error) error {
+	for value.Kind() == reflect.Pointer || value.Kind() == reflect.Interface {
+		if value.IsNil() {
+			return nil
+		}
+		value = value.Elem()
+	}
+	if value.Kind() == reflect.Slice || value.Kind() == reflect.Array {
+		for n := 0; n < value.Len(); n++ {
+			if e := bodyVisit(value.Index(n), fn); e != nil {
+				return e
+			}
+		}
+		return nil
+	}
+	return fn(value)
+}
+func bodyRecordKey(tx *gorm.DB, d originalBodyFieldDescriptor, v reflect.Value) string {
+	if v.Kind() == reflect.Map {
+		found := v.MapIndex(reflect.ValueOf(d.Key))
+		if found.IsValid() {
+			return bodyText(found.Interface())
+		}
+		return ""
+	}
+	if v.Kind() != reflect.Struct {
+		return ""
+	}
+	if tx.Statement.Schema != nil {
+		if field := tx.Statement.Schema.FieldsByDBName[d.Key]; field != nil {
+			value, _ := field.ValueOf(tx.Statement.Context, v)
+			return bodyText(value)
+		}
+	}
+	return ""
+}
+func (s *OriginalBodyRetentionStore) captureStatement(tx *gorm.DB, d originalBodyFieldDescriptor) error {
+	keys := map[string]bool{}
+	if e := bodyVisit(tx.Statement.ReflectValue, func(v reflect.Value) error {
+		if key := bodyRecordKey(tx, d, v); key != "" {
+			keys[key] = true
+		}
+		return nil
+	}); e != nil {
+		return e
+	}
+	if len(keys) == 0 {
+		if where, ok := tx.Statement.Clauses["WHERE"]; ok {
+			var ids []string
+			if e := bodyInternal(tx).Table(d.Table).Select("CAST(" + bodyQuoted(d.Key) + " AS TEXT)").Where(where.Expression).Limit(1001).Scan(&ids).Error; e != nil {
+				return e
+			}
+			if len(ids) > 1000 {
+				return ErrOriginalBodyUnavailable
+			}
+			for _, id := range ids {
+				keys[id] = true
+			}
+		}
+	}
+	for key := range keys {
+		row, e := bodySourceRow(tx, d, key)
+		if e != nil {
+			return e
+		}
+		scope, e := bodyScopeFromRow(tx, d, key, row)
+		if e != nil {
+			return e
+		}
+		for _, col := range d.Columns {
+			raw, e := bodyFieldValue(row, col)
+			if e != nil {
+				return e
+			}
+			if raw == "" {
+				continue
+			}
+			if e := s.captureField(tx, d, key, col, raw, scope); e != nil {
+				return e
+			}
+		}
+	}
+	return nil
+}
+func bodySelectedField(tx *gorm.DB, column string) bool {
+	for _, omission := range tx.Statement.Omits {
+		if omission == "*" || omission == column {
+			return false
+		}
+	}
+	if len(tx.Statement.Selects) == 0 {
+		return true
+	}
+	for _, selection := range tx.Statement.Selects {
+		for _, part := range strings.Split(selection, ",") {
+			value := strings.TrimSpace(part)
+			value = strings.Trim(value, "\"`")
+			if value == "*" || strings.HasSuffix(value, ".*") {
+				return true
+			}
+			if at := strings.LastIndex(value, "."); at >= 0 {
+				value = strings.Trim(value[at+1:], "\"`")
+			}
+			if value == column {
+				return true
+			}
+		}
+	}
+	return false
+}
+func (s *OriginalBodyRetentionStore) resolveStatement(tx *gorm.DB, d originalBodyFieldDescriptor) error {
+	selected := false
+	for _, field := range d.Columns {
+		if bodySelectedField(tx, bodyFieldColumn(field)) {
+			selected = true
+			break
+		}
+	}
+	if !selected {
+		return nil
+	}
+	return bodyVisit(tx.Statement.ReflectValue, func(v reflect.Value) error {
+		key := bodyRecordKey(tx, d, v)
+		if key == "" {
+			return nil
+		}
+		var heads []originalBodyFieldHead
+		if e := bodyInternal(tx).Where("source_table=? AND row_key=?", d.Table, key).Find(&heads).Error; e != nil {
+			return e
+		}
+		for _, head := range heads {
+			if !bodySelectedField(tx, bodyFieldColumn(head.ColumnName)) {
+				continue
+			}
+			var raw string
+			var field reflect.Value
+			if v.Kind() == reflect.Map {
+				value := v.MapIndex(reflect.ValueOf(bodyFieldColumn(head.ColumnName)))
+				if !value.IsValid() {
+					continue
+				}
+				raw = bodyText(value.Interface())
+			} else if tx.Statement.Schema != nil {
+				f := tx.Statement.Schema.FieldsByDBName[bodyFieldColumn(head.ColumnName)]
+				if f == nil {
+					continue
+				}
+				value, _ := f.ValueOf(tx.Statement.Context, v)
+				switch body := value.(type) {
+				case string:
+					raw = body
+				case []byte:
+					raw = string(body)
+				default:
+					b, _ := json.Marshal(value)
+					raw = string(b)
+				}
+				field = v.FieldByIndex(f.StructField.Index)
+			}
+			if strings.Contains(head.ColumnName, ".") {
+				leaf, e := bodyFieldValue(map[string]any{bodyFieldColumn(head.ColumnName): raw}, head.ColumnName)
+				if e != nil {
+					return e
+				}
+				raw = leaf
+			}
+			if ref, ok := bodyReference(raw); ok {
+				body, e := s.resolveInTx(tx, head, ref)
+				if e != nil {
+					return e
+				}
+				if v.Kind() == reflect.Map {
+					v.SetMapIndex(reflect.ValueOf(head.ColumnName), reflect.ValueOf(body))
+					continue
+				}
+				if !field.CanSet() {
+					return ErrOriginalBodyUnavailable
+				}
+				if field.Kind() == reflect.String {
+					field.SetString(body)
+				} else if field.Kind() == reflect.Slice && field.Type().Elem().Kind() == reflect.Uint8 {
+					field.SetBytes([]byte(body))
+				} else if e = json.Unmarshal([]byte(body), field.Addr().Interface()); e != nil {
+					return e
+				}
+			} else {
+				if e := CheckOriginalBodyAvailableInTx(tx.Statement.Context, tx, d.Table, key); e != nil {
+					return e
+				}
+				if d.Mode == "vault" && raw != "" {
+					return ErrOriginalBodyUnavailable
+				} // inline restore of an original snapshot
+			}
+		}
+		return nil
+	})
+}
