+  dsn='host=gc-db user=gc dbname=gc password='+password+' sslmode=disable'
+  tests='Test(NextcloudActualGC|PostgresNextcloudActualGC|NextcloudActualRunDue|PostgresNextcloudActualRunDue|NextcloudRunDuePhysical|NextcloudGC|PostgresNextcloudGC|NextcloudExactChunkGC|PostgresNextcloudExactChunkGC|NextcloudContentLease|PostgresNextcloudContentLease|Local|Capacity)'
+  go=run('docker','run','-d','--name',name+'-go','--label',label,'--cpus','1','--memory','2g','--network',network,'-v',str(ROOT)+':/app:ro','-v','weknora-go-mod:/go/pkg/mod:ro','-v','weknora-go-build:/root/.cache/go-build','-w','/app','-e','WEKNORA_LEASE_TEST_POSTGRES_DSN='+dsn,'-e','WEKNORA_GC_TEST_POSTGRES_DSN='+dsn,GO,'go','test','-p','1','./internal/application/repository','./internal/application/service/file','./internal/container','-run',tests,'-count=1','-v')
+  go_inspected=json.loads(run('docker','inspect',go))[0];assert go_inspected['HostConfig']['Memory']==2*1024**3 and go_inspected['HostConfig']['NanoCpus']==10**9 and not go_inspected['HostConfig']['PortBindings'];assert any(m['Destination']=='/app' and m['Type']=='bind' and not m['RW'] for m in go_inspected['Mounts'])
+  exit_code=run('docker','wait',go)
+  logged=subprocess.run(['docker','logs',go],capture_output=True,text=True,timeout=30);logs=(logged.stdout+logged.stderr).replace(password,'[redacted]');logpath=output/'tests.log';logpath.write_text(logs);logpath.chmod(0o600)
+  remaining=run('docker','exec',pg,'psql','-U','gc','-d','gc','-At','-c',"SELECT count(*) FROM pg_namespace WHERE nspname LIKE 'content_lease_%' OR nspname LIKE 'gc_bind_%' OR nspname LIKE 'gc_chunk_%'");assert remaining=='0'
+  result.update({'status':'PASS' if exit_code=='0' else 'FAIL','pg_container_id':pg,'go_container_id':go,'network_id':network,'postgres_image':PG,'go_image':GO,'limits':{'postgres':'1 CPU/512 MiB/tmpfs','go':'1 CPU/2 GiB'},'internal_network':True,'host_ports':False,'remaining_nonce_schemas':0,'tests_log_sha256':hashlib.sha256(logs.encode()).hexdigest()})
+ finally:
+  for cid in (go,pg):
+   if cid:
+    item=json.loads(run('docker','inspect',cid))[0];assert item['Config']['Labels']['org.weknora.gc.content.owner']==nonce;run('docker','rm','-f',cid)
+  if network:
+   item=json.loads(run('docker','network','inspect',network))[0];assert item['Labels']['org.weknora.gc.content.owner']==nonce and not item['Containers'];run('docker','network','rm',network)
+  result['cleanup_verified']=True;result['source_finally_clean']=not run('git','-C',str(ROOT),'status','--porcelain=v1','--untracked-files=all');result['source_commit_unchanged']=commit==run('git','-C',str(ROOT),'rev-parse','HEAD');assert result['source_finally_clean'] and result['source_commit_unchanged'];write(output/'evidence.json',result)
+ print(json.dumps({'status':result['status'],'evidence':str(output/'evidence.json')}));return 0 if result['status']=='PASS' else 1
+if __name__=='__main__':raise SystemExit(main())
