diff --git a/internal/application/repository/knowledge_auto_publication_transition.go b/internal/application/repository/knowledge_auto_publication_transition.go
new file mode 100644
index 0000000000000000000000000000000000000000..2989602bb4f2ab9c0fdda0816699738c28822785
--- /dev/null
+++ b/internal/application/repository/knowledge_auto_publication_transition.go
@@ -0,0 +1,148 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/google/uuid"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+type knowledgeAutoPublicationTransition struct {
+	TransitionID                              string `gorm:"primaryKey"`
+	SnapshotID                                string
+	TenantID                                  uint64
+	KnowledgeBaseID, KnowledgeID, AdmissionID string
+	BeforeRevision, AfterRevision             uint64
+	BeforeDigest, AfterDigest                 string
+}
+
+func (knowledgeAutoPublicationTransition) TableName() string {
+	return "knowledge_auto_publication_transitions"
+}
+func knowledgeAutoPublicationRevision(tx *gorm.DB, id string) (uint64, error) {
+	var row struct{ Revision uint64 }
+	if err := tx.Table("knowledge_auto_publication_versions").Where("knowledge_id = ?", id).Take(&row).Error; err != nil {
+		return 0, err
+	}
+	if row.Revision == 0 {
+		return 0, ErrKnowledgeInputChanged
+	}
+	return row.Revision, nil
+}
+
+// Only the real, source-checked publication transaction can write this exact
+// before/after transition. Neither startup nor Auto can fill a missing receipt.
+func recordKnowledgeAutoPublicationTransitionInTx(ctx context.Context, tx *gorm.DB, before, after *types.Knowledge, beforeRevision uint64) error {
+	if before == nil || after == nil || before.ID != after.ID {
+		return ErrKnowledgeInputChanged
+	}
+	var pending []*types.TaskPendingOp
+	if err := tx.Where("tenant_id=? AND task_type=? AND scope=? AND scope_id=? AND op IN ?", before.TenantID, types.TypeKnowledgeAutoTag, types.TaskScopeKnowledge, before.ID, []string{autoTagCompletionOp, autoTagCompletionRunning}).Find(&pending).Error; err != nil {
+		return err
+	}
+	if len(pending) == 0 {
+		return nil
+	}
+	afterRevision, err := knowledgeAutoPublicationRevision(tx, after.ID)
+	if err != nil {
+		return err
+	}
+	beforeDigest, err := KnowledgeInputDigest(before)
+	if err != nil {
+		return err
+	}
+	afterDigest, err := KnowledgeInputDigest(after)
+	if err != nil {
+		return err
+	}
+	for _, op := range pending {
+		var p types.KnowledgeAutoTagPayload
+		if json.Unmarshal(op.Payload, &p) != nil || p.CompletionInput == "" || p.TaskInput == nil {
+			return ErrKnowledgeInputChanged
+		}
+		var manifest knowledgeAutoTagManifest
+		if err := tx.Where("manifest_id=? AND tenant_id=? AND knowledge_base_id=? AND knowledge_id=?", p.CompletionInput, before.TenantID, before.KnowledgeBaseID, before.ID).Take(&manifest).Error; err != nil {
+			return err
+		}
+		var snapshot types.KnowledgeAutoTagInputSnapshot
+		if json.Unmarshal([]byte(manifest.ActualInputs), &snapshot) != nil || snapshot.Original == nil || snapshot.Original.Proof == nil || snapshot.Original.Knowledge == nil {
+			return ErrKnowledgeInputChanged
+		}
+		digest, err := autoTagSnapshotDigest(&snapshot)
+		if err != nil || digest != manifest.InputDigest || snapshot.InputDigest != digest || snapshot.ManifestID != p.CompletionInput {
+			return ErrKnowledgeInputChanged
+		}
+		originalRevision, originalDigest, err := knowledgeAutoPublicationTail(tx, &snapshot)
+		if err != nil || originalDigest != beforeDigest || originalRevision != beforeRevision || snapshot.Original.Proof.AdmissionID != manifest.AdmissionID || p.OriginalInput == nil || p.OriginalInput.AdmissionID != manifest.AdmissionID {
+			return ErrKnowledgeInputChanged
+		}
+		if err := ValidateNextcloudBuildWrite(ctx, tx, before.TenantID, before.KnowledgeBaseID, before.ID); err != nil {
+			return err
+		}
+		// All influencing bodies and original source controls are still checked
+		// using their immutable admission/material receipts in this same tx.
+		input, ok := ctx.Value(knowledgeBuildInputKey{}).(knowledgeBuildInputContext)
+		store, okStore := input.reader.(*KnowledgeInputProvenanceStore)
+		if !ok || !okStore {
+			return types.ErrSourceLineageUnknown
+		}
+		if _, err := store.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: p.TenantID, KnowledgeBaseID: p.KnowledgeBaseID, KnowledgeID: p.KnowledgeID, ChunkIDs: p.OriginalInput.ChunkIDs, Expected: p.OriginalInput}, true); err != nil {
+			return err
+		}
+		receipt := knowledgeAutoPublicationTransition{TransitionID: uuid.NewString(), SnapshotID: snapshot.ManifestID, TenantID: before.TenantID, KnowledgeBaseID: before.KnowledgeBaseID, KnowledgeID: before.ID, AdmissionID: manifest.AdmissionID, BeforeRevision: beforeRevision, AfterRevision: afterRevision, BeforeDigest: beforeDigest, AfterDigest: afterDigest}
+		if err := tx.Create(&receipt).Error; err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func acceptKnowledgeAutoPublicationTransition(tx *gorm.DB, saved, actual *types.KnowledgeAutoTagInputSnapshot) error {
+	if saved.Original == nil || actual.Original == nil || saved.Original.Knowledge == nil || actual.Original.Knowledge == nil {
+		return ErrKnowledgeInputChanged
+	}
+	if saved.Original.Knowledge.Channel != types.ConnectorTypeNextcloud {
+		return nil
+	}
+	if saved.PublicationRevision == actual.PublicationRevision {
+		return nil
+	}
+	revision, digest, err := knowledgeAutoPublicationTail(tx, saved)
+	if err != nil {
+		return err
+	}
+	after, err := KnowledgeInputDigest(actual.Original.Knowledge)
+	if err != nil || revision != actual.PublicationRevision || digest != after {
+		return ErrKnowledgeInputChanged
+	}
+	// Normalize only the exact row committed by this admission's publication
+	// receipt. An external timestamp/ETag/metadata ABA increments the dedicated
+	// counter and cannot reuse this transition even if it restores the bytes.
+	actual.Original.Knowledge = saved.Original.Knowledge
+	actual.PublicationRevision = saved.PublicationRevision
+	return nil
+}
+
+// Immutable, contiguous transitions cover a legitimate publish/unpublish and
+// later retry. Any external update introduces a revision gap, including ABA.
+func knowledgeAutoPublicationTail(tx *gorm.DB, saved *types.KnowledgeAutoTagInputSnapshot) (uint64, string, error) {
+	proof := saved.Original.Proof
+	revision := saved.PublicationRevision
+	digest, err := KnowledgeInputDigest(saved.Original.Knowledge)
+	if err != nil {
+		return 0, "", err
+	}
+	var receipts []knowledgeAutoPublicationTransition
+	if err := tx.Where("snapshot_id=? AND tenant_id=? AND knowledge_base_id=? AND knowledge_id=? AND admission_id=?", saved.ManifestID, proof.TenantID, proof.KnowledgeBaseID, proof.KnowledgeID, proof.AdmissionID).Order("before_revision ASC").Find(&receipts).Error; err != nil {
+		return 0, "", err
+	}
+	for _, receipt := range receipts {
+		if receipt.BeforeRevision != revision || receipt.BeforeDigest != digest || receipt.AfterRevision <= revision {
+			return 0, "", ErrKnowledgeInputChanged
+		}
+		revision, digest = receipt.AfterRevision, receipt.AfterDigest
+	}
+	return revision, digest, nil
+}
diff --git a/internal/application/repository/knowledge_auto_tag_completion_outbox.go b/internal/application/repository/knowledge_auto_tag_completion_outbox.go
new file mode 100644
index 0000000000000000000000000000000000000000..0f33c3e73dca4498cf5375592614ea27c2783eca
--- /dev/null
+++ b/internal/application/repository/knowledge_auto_tag_completion_outbox.go
@@ -0,0 +1,225 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+const autoTagCompletionOp = "auto_tag_completion"
+const autoTagCompletionDone = "auto_tag_done"
+const autoTagCompletionRejected = "auto_tag_rejected"
+const autoTagCompletionRunning = "auto_tag_running"
+
+// SealKnowledgeAutoTagCompletionInTx is only called by the completion winner.
+// The exact final material, candidates, source controls, model/tenant revisions,
+// queue receipt and intent commit together. Recovery never captures new input.
+func (s *KnowledgeInputProvenanceStore) SealKnowledgeAutoTagCompletionInTx(ctx context.Context, tx *gorm.DB, id string, payload types.KnowledgeAutoTagPayload) error {
+	var k types.Knowledge
+	if err := tx.Where("id = ?", id).Take(&k).Error; err != nil {
+		return err
+	}
+	var kb types.KnowledgeBase
+	if err := tx.Where("id = ? AND tenant_id = ?", k.KnowledgeBaseID, k.TenantID).Take(&kb).Error; err != nil {
+		return err
+	}
+	if kb.Type != types.KnowledgeBaseTypeDocument || kb.AutoTagConfig == nil || !kb.AutoTagConfig.Enabled {
+		return nil
+	}
+	original := KnowledgeBuildInputProofFromContext(ctx)
+	if original == nil || original.KnowledgeID != id || original.TenantID != k.TenantID || original.KnowledgeBaseID != kb.ID {
+		return types.ErrSourceLineageUnknown
+	}
+	root := cloneKnowledgeInputProof(original)
+	root.BodyDigest, root.Projection = "", ""
+	root.ChunkIDs = nil
+	var chunks []*types.Chunk
+	if err := tx.Where("tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ? AND chunk_type IN ?", k.TenantID, kb.ID, id, []types.ChunkType{types.ChunkTypeText, types.ChunkTypeImageOCR, types.ChunkTypeImageCaption}).Find(&chunks).Error; err != nil {
+		return err
+	}
+	if len(chunks) == 0 {
+		return nil
+	}
+	ids := make([]string, 0, len(chunks))
+	for _, chunk := range chunks {
+		ids = append(ids, chunk.ID)
+	}
+	actual, err := s.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: k.TenantID, KnowledgeBaseID: kb.ID, KnowledgeID: id, ChunkIDs: ids, Expected: root}, false)
+	if err != nil {
+		return err
+	}
+	snapshot, err := s.captureKnowledgeAutoTagInTx(tx, actual.Proof)
+	if err != nil {
+		return err
+	}
+	if s.displayAuthorityFactory == nil {
+		return types.ErrSourceLineageUnknown
+	}
+	authority := s.displayAuthorityFactory(tx)
+	if authority == nil || authority.db != tx {
+		return types.ErrSourceLineageUnknown
+	}
+	if _, err := authority.authorizeOriginalKnowledgeProducerWrite(ctx, &kb, actual.Proof); err != nil {
+		return err
+	}
+	snapshot.ManifestID = uuid.NewString()
+	snapshot.InputDigest, err = autoTagSnapshotDigest(snapshot)
+	if err != nil {
+		return err
+	}
+	data, err := json.Marshal(snapshot)
+	if err != nil {
+		return err
+	}
+	lineage, err := json.Marshal(snapshot.SourceLineage)
+	if err != nil {
+		return err
+	}
+	if err := tx.Create(&knowledgeAutoTagManifest{ManifestID: snapshot.ManifestID, TenantID: k.TenantID, KnowledgeBaseID: kb.ID, KnowledgeID: id, AdmissionID: actual.Proof.AdmissionID, InputDigest: snapshot.InputDigest, ActualInputs: string(data), SourceLineage: string(lineage)}).Error; err != nil {
+		return err
+	}
+	payload.TenantID, payload.KnowledgeBaseID, payload.KnowledgeID = k.TenantID, kb.ID, id
+	payload.OriginalInput, payload.CompletionInput = actual.Proof, snapshot.ManifestID
+	// Span state belongs to the same SQL connection; do not query a second
+	// connection while the completion transaction owns a SQLite pool of one.
+	if err := tx.Model(&types.KnowledgeProcessingSpan{}).Select("COALESCE(MAX(attempt), 0)").Where("knowledge_id = ?", id).Scan(&payload.Attempt).Error; err != nil {
+		return err
+	}
+	envelope := autoTagActualTaskInput{Kind: "actual_queue_input", Payload: payload}
+	digest, err := KnowledgeInputDigest(envelope)
+	if err != nil {
+		return err
+	}
+	data, err = json.Marshal(envelope)
+	if err != nil {
+		return err
+	}
+	queueID := uuid.NewString()
+	if err := tx.Create(&knowledgeAutoTagManifest{ManifestID: queueID, TenantID: k.TenantID, KnowledgeBaseID: kb.ID, KnowledgeID: id, AdmissionID: actual.Proof.AdmissionID, InputDigest: digest, ActualInputs: string(data), SourceLineage: string(lineage)}).Error; err != nil {
+		return err
+	}
+	payload.TaskInput = &types.KnowledgeAutoTagTaskInputProof{ID: queueID, Digest: digest}
+	data, err = json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	return tx.Create(&types.TaskPendingOp{TenantID: k.TenantID, TaskType: types.TypeKnowledgeAutoTag, Scope: types.TaskScopeKnowledge, ScopeID: id, Op: autoTagCompletionOp, DedupKey: queueID, Payload: data, EnqueuedAt: time.Now().UTC()}).Error
+}
+
+// LoadKnowledgeAutoTagCompletionInput loads the sealed snapshot and restores
+// runtime-only tenant credentials only after checking its original digest.
+func (s *KnowledgeInputProvenanceStore) LoadKnowledgeAutoTagCompletionInput(ctx context.Context, p types.KnowledgeAutoTagPayload) (*types.KnowledgeAutoTagInputSnapshot, error) {
+	if p.CompletionInput == "" || p.OriginalInput == nil {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	var row knowledgeAutoTagManifest
+	if err := s.db.WithContext(ctx).Where("manifest_id = ? AND tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ? AND admission_id = ?", p.CompletionInput, p.TenantID, p.KnowledgeBaseID, p.KnowledgeID, p.OriginalInput.AdmissionID).Take(&row).Error; err != nil {
+		return nil, err
+	}
+	var snapshot types.KnowledgeAutoTagInputSnapshot
+	if json.Unmarshal([]byte(row.ActualInputs), &snapshot) != nil || snapshot.ManifestID != row.ManifestID || snapshot.InputDigest != row.InputDigest {
+		return nil, fmt.Errorf("completion model envelope: %w", ErrKnowledgeInputChanged)
+	}
+	digest, err := autoTagSnapshotDigest(&snapshot)
+	if err != nil || digest != row.InputDigest {
+		return nil, fmt.Errorf("completion model digest: %w", ErrKnowledgeInputChanged)
+	}
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if _, err := s.recheckKnowledgeAutoTagInTx(tx, ctx, &snapshot); err != nil {
+			return err
+		}
+		_, tenant, err := knowledgeAutoTagModelInputs(tx, snapshot.Original.KnowledgeBase)
+		snapshot.Tenant = tenant
+		return err
+	}, knowledgeDisplayWriteOptions(s.db))
+	return &snapshot, err
+}
+
+func (s *KnowledgeInputProvenanceStore) PendingKnowledgeAutoTagCompletions(ctx context.Context, knowledgeID string, limit int) ([]*types.TaskPendingOp, error) {
+	var rows []*types.TaskPendingOp
+	query := s.db.WithContext(ctx).Where("task_type = ? AND scope = ? AND (op = ? OR (op = ? AND claimed_at < ?))", types.TypeKnowledgeAutoTag, types.TaskScopeKnowledge, autoTagCompletionOp, autoTagCompletionRunning, time.Now().UTC().Add(-3*time.Minute))
+	if knowledgeID != "" {
+		query = query.Where("scope_id = ?", knowledgeID)
+	}
+	err := query.Order("CASE WHEN claimed_at IS NULL THEN 0 ELSE 1 END ASC, claimed_at ASC, id ASC").Limit(limit).Find(&rows).Error
+	return rows, err
+}
+
+// Rotate delivered pending rows so an old blocked wrapper cannot starve later
+// intents. For pending rows claimed_at is the last wake-up attempt; consuming
+// changes op and replaces it with the exact consumer claim timestamp.
+func (s *KnowledgeInputProvenanceStore) NoteKnowledgeAutoTagCompletionDelivery(ctx context.Context, id int64) error {
+	return s.db.WithContext(ctx).Model(&types.TaskPendingOp{}).Where("id = ? AND task_type = ? AND op = ?", id, types.TypeKnowledgeAutoTag, autoTagCompletionOp).Update("claimed_at", time.Now().UTC()).Error
+}
+
+// Claim serializes duplicate deliveries. A crashed consumer is reclaimable;
+// terminal rows stay in SQL and cannot be awakened by startup or redelivery.
+func (s *KnowledgeInputProvenanceStore) ClaimKnowledgeAutoTagCompletion(ctx context.Context, p types.KnowledgeAutoTagPayload) (*time.Time, error) {
+	if p.TaskInput == nil || p.CompletionInput == "" {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	now := time.Now().UTC().Truncate(time.Microsecond)
+	res := s.db.WithContext(ctx).Model(&types.TaskPendingOp{}).Where("task_type = ? AND scope = ? AND scope_id = ? AND tenant_id = ? AND dedup_key = ? AND (op = ? OR (op = ? AND claimed_at < ?))", types.TypeKnowledgeAutoTag, types.TaskScopeKnowledge, p.KnowledgeID, p.TenantID, p.TaskInput.ID, autoTagCompletionOp, autoTagCompletionRunning, now.Add(-3*time.Minute)).Updates(map[string]any{"op": autoTagCompletionRunning, "claimed_at": now})
+	if res.Error != nil {
+		return nil, res.Error
+	}
+	if res.RowsAffected > 0 {
+		return &now, nil
+	}
+	var row types.TaskPendingOp
+	if err := s.db.WithContext(ctx).Where("task_type = ? AND scope = ? AND scope_id = ? AND tenant_id = ? AND dedup_key = ?", types.TypeKnowledgeAutoTag, types.TaskScopeKnowledge, p.KnowledgeID, p.TenantID, p.TaskInput.ID).Take(&row).Error; err != nil {
+		return nil, err
+	}
+	if row.Op == autoTagCompletionDone || row.Op == autoTagCompletionRejected || row.Op == autoTagCompletionRunning {
+		return nil, nil
+	}
+	return nil, ErrKnowledgeInputChanged
+}
+
+func (s *KnowledgeInputProvenanceStore) FinishKnowledgeAutoTagCompletion(ctx context.Context, p types.KnowledgeAutoTagPayload, claim time.Time, success, rejected bool) error {
+	op := autoTagCompletionOp
+	if success {
+		op = autoTagCompletionDone
+	} else if rejected {
+		op = autoTagCompletionRejected
+	}
+	updates := map[string]any{"op": op, "claimed_at": nil}
+	if !success {
+		updates["fail_count"] = gorm.Expr("fail_count + 1")
+	}
+	return s.db.WithContext(ctx).Model(&types.TaskPendingOp{}).Where("task_type = ? AND scope = ? AND scope_id = ? AND tenant_id = ? AND dedup_key = ? AND op = ? AND claimed_at = ?", types.TypeKnowledgeAutoTag, types.TaskScopeKnowledge, p.KnowledgeID, p.TenantID, p.TaskInput.ID, autoTagCompletionRunning, claim).Updates(updates).Error
+}
+
+type autoTagCompletionContextKey struct{}
+type autoTagCompletionClaim struct {
+	Payload   types.KnowledgeAutoTagPayload
+	ClaimedAt time.Time
+}
+
+func WithKnowledgeAutoTagCompletion(ctx context.Context, p types.KnowledgeAutoTagPayload, claimedAt time.Time) context.Context {
+	return context.WithValue(ctx, autoTagCompletionContextKey{}, autoTagCompletionClaim{p, claimedAt})
+}
+func finishAutoTagCompletionInTx(ctx context.Context, tx *gorm.DB) error {
+	claimed, ok := ctx.Value(autoTagCompletionContextKey{}).(autoTagCompletionClaim)
+	if !ok {
+		return nil
+	}
+	p, claim := claimed.Payload, claimed.ClaimedAt
+	if p.TaskInput == nil || p.CompletionInput == "" {
+		return types.ErrSourceLineageUnknown
+	}
+	res := tx.Model(&types.TaskPendingOp{}).Where("task_type = ? AND scope = ? AND scope_id = ? AND tenant_id = ? AND dedup_key = ? AND op = ? AND claimed_at = ?", types.TypeKnowledgeAutoTag, types.TaskScopeKnowledge, p.KnowledgeID, p.TenantID, p.TaskInput.ID, autoTagCompletionRunning, claim).Updates(map[string]any{"op": autoTagCompletionDone, "claimed_at": nil})
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected != 1 {
+		return errors.New("automatic tag intent no longer claimed")
+	}
+	return nil
+}
