diff --git a/internal/types/graph_lineage.go b/internal/types/graph_lineage.go
new file mode 100644
index 0000000000000000000000000000000000000000..f75665d3b399cc86a6d97e17d81c56bbf3157fe7
--- /dev/null
+++ b/internal/types/graph_lineage.go
@@ -0,0 +1,111 @@
+package types
+
+import (
+	"context"
+	"encoding/json"
+)
+
+// KnowledgeGraphInputSnapshot is internal material, never hydrated from client
+// JSON. Graph keeps every raw contributor until its receipts are checked.
+type KnowledgeGraphInputSnapshot struct {
+	Recheck       func(context.Context) error `json:"-"`
+	Close         func() error                `json:"-"`
+	Graph         *GraphData                  `json:"-"`
+	Chunks        []*SearchResult             `json:"-"`
+	SourceLineage *SourceLineage              `json:"-"`
+}
+
+// CloneKnowledgeGraphInputSnapshot detaches every actual field before an
+// authorization callback or renderer can touch shared producer-owned values.
+func CloneKnowledgeGraphInputSnapshot(input *KnowledgeGraphInputSnapshot) (*KnowledgeGraphInputSnapshot, error) {
+	if input == nil || input.Graph == nil || input.SourceLineage.RequireComplete() != nil {
+		return nil, ErrGraphSourceReceiptUnknown
+	}
+	out := &KnowledgeGraphInputSnapshot{Recheck: input.Recheck, Close: input.Close}
+	var err error
+	out.SourceLineage, err = UnionSourceLineage(input.SourceLineage)
+	if err != nil {
+		return nil, err
+	}
+	graphCopy := *input.Graph
+	out.Graph = &graphCopy
+	out.Graph.Node = make([]*GraphNode, len(input.Graph.Node))
+	for i, node := range input.Graph.Node {
+		if node == nil {
+			return nil, ErrGraphSourceReceiptUnknown
+		}
+		copy := *node
+		if node.Chunks != nil {
+			copy.Chunks = append([]string{}, node.Chunks...)
+		}
+		if node.Attributes != nil {
+			copy.Attributes = append([]string{}, node.Attributes...)
+		}
+		out.Graph.Node[i] = &copy
+	}
+	out.Graph.Relation = make([]*GraphRelation, len(input.Graph.Relation))
+	for i, edge := range input.Graph.Relation {
+		if edge == nil {
+			return nil, ErrGraphSourceReceiptUnknown
+		}
+		copy := *edge
+		out.Graph.Relation[i] = &copy
+	}
+	out.Graph.InputReceipts = nil
+	out.Graph.SourceLineage, err = UnionSourceLineage(input.Graph.SourceLineage)
+	if err != nil {
+		return nil, err
+	}
+	out.Graph.WireDigest = input.Graph.WireDigest
+	if input.Graph.SourceReceipt != nil {
+		out.Graph.SourceReceipt, err = CopyGraphSourceReceipt(input.Graph.SourceReceipt)
+		if err != nil {
+			return nil, err
+		}
+	}
+	for i, node := range input.Graph.Node {
+		if node == nil {
+			return nil, ErrGraphSourceReceiptUnknown
+		}
+		out.Graph.Node[i].SourceReceipt, err = CopyGraphSourceReceipt(node.SourceReceipt)
+		if err != nil {
+			return nil, err
+		}
+	}
+	for i, edge := range input.Graph.Relation {
+		if edge == nil {
+			return nil, ErrGraphSourceReceiptUnknown
+		}
+		out.Graph.Relation[i].SourceReceipt, err = CopyGraphSourceReceipt(edge.SourceReceipt)
+		if err != nil {
+			return nil, err
+		}
+	}
+	for _, receipt := range input.Graph.InputReceipts {
+		copy, err := CopyGraphSourceReceipt(receipt)
+		if err != nil {
+			return nil, err
+		}
+		out.Graph.InputReceipts = append(out.Graph.InputReceipts, copy)
+	}
+	data, err := json.Marshal(input.Chunks)
+	if err != nil {
+		return nil, err
+	}
+	if err := json.Unmarshal(data, &out.Chunks); err != nil {
+		return nil, err
+	}
+	for i, result := range input.Chunks {
+		if result == nil {
+			return nil, ErrGraphSourceReceiptUnknown
+		}
+		out.Chunks[i].SourceLineage, err = UnionSourceLineage(result.SourceLineage)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if _, err := ValidateGraphMaterial(out.Graph); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
diff --git a/internal/types/graph_prompt_origin.go b/internal/types/graph_prompt_origin.go
new file mode 100644
index 0000000000000000000000000000000000000000..c2e6333c7730e4108232d90cfa9bef91ddd541a8
--- /dev/null
+++ b/internal/types/graph_prompt_origin.go
@@ -0,0 +1,37 @@
+package types
+
+import "encoding/json"
+
+// GraphPromptTemplateOrigin is private producer metadata. A literal default
+// uses a detached code-owned replacement; custom human/config/derived inputs
+// require a trusted writer to bind their exact value and exhaustive lineage.
+type GraphPromptTemplateOrigin struct {
+	Digest        string
+	SourceLineage *SourceLineage
+}
+
+func BindGraphPromptTemplateOrigin(template *PromptTemplateStructured, lineage *SourceLineage) (*PromptTemplateStructured, error) {
+	if template == nil || lineage.RequireComplete() != nil {
+		return nil, ErrGraphSourceReceiptUnknown
+	}
+	encoded, err := json.Marshal(template)
+	if err != nil {
+		return nil, err
+	}
+	var frozen PromptTemplateStructured
+	if err := json.Unmarshal(encoded, &frozen); err != nil {
+		return nil, err
+	}
+	copy, err := UnionSourceLineage(lineage)
+	if err != nil {
+		return nil, err
+	}
+	frozen.SourceOrigin = &GraphPromptTemplateOrigin{Digest: GraphDigest(&frozen), SourceLineage: copy}
+	return &frozen, nil
+}
+func GraphPromptTemplateLineage(template *PromptTemplateStructured) (*SourceLineage, error) {
+	if template == nil || template.SourceOrigin == nil || template.SourceOrigin.Digest != GraphDigest(template) || template.SourceOrigin.SourceLineage.RequireComplete() != nil {
+		return UnknownSourceLineage(), ErrGraphSourceReceiptUnknown
+	}
+	return UnionSourceLineage(template.SourceOrigin.SourceLineage)
+}
diff --git a/internal/types/graph_source_receipt.go b/internal/types/graph_source_receipt.go
new file mode 100644
index 0000000000000000000000000000000000000000..25fa105ff5cc65ea1fbf0326be287cb527d7bc23
--- /dev/null
+++ b/internal/types/graph_source_receipt.go
@@ -0,0 +1,309 @@
+package types
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+)
+
+// GraphSourceReceipt is an immutable original writer receipt, persisted in a
+// private graph property. Public graph JSON (including model output) cannot
+// supply it. The digest binds the exact original body and namespace, not an
+// endpoint chunk's current revision.
+type GraphSourceReceipt struct {
+	OriginalInput   *KnowledgeBuildInputProof `json:"original_input"`
+	Version         int                       `json:"version"`
+	TenantID        uint64                    `json:"tenant_id"`
+	KnowledgeBaseID string                    `json:"knowledge_base_id"`
+	KnowledgeID     string                    `json:"knowledge_id"`
+	BuildGeneration uint64                    `json:"build_generation"`
+	InputDigest     string                    `json:"input_digest"`
+	ConfigDigest    string                    `json:"config_digest"`
+	WireDigest      string                    `json:"wire_digest"`
+	BodyDigest      string                    `json:"body_digest"`
+	SourceLineage   *SourceLineage            `json:"source_lineage"`
+}
+
+var ErrGraphSourceReceiptUnknown = errors.New("graph source receipt is unknown or changed")
+
+func (r *GraphSourceReceipt) Validate() error {
+	if r == nil || r.Version != 1 || r.TenantID == 0 || r.KnowledgeBaseID == "" || r.KnowledgeID == "" || r.BuildGeneration == 0 || r.SourceLineage.RequireComplete() != nil {
+		return ErrGraphSourceReceiptUnknown
+	}
+	if err := checkGraphOriginalInput(r); err != nil {
+		return err
+	}
+	for _, value := range []string{r.InputDigest, r.ConfigDigest, r.WireDigest, r.BodyDigest} {
+		decoded, err := hex.DecodeString(value)
+		if err != nil || len(decoded) != sha256.Size || hex.EncodeToString(decoded) != value {
+			return ErrGraphSourceReceiptUnknown
+		}
+	}
+	return nil
+}
+func GraphDigest(body any) string {
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return ""
+	}
+	sum := sha256.Sum256(payload)
+	return hex.EncodeToString(sum[:])
+}
+func graphBodyDigest(kind string, namespace NameSpace, body any) string {
+	return GraphDigest(struct {
+		Kind      string
+		Namespace NameSpace
+		Body      any
+	}{kind, namespace, body})
+}
+func GraphNodeBodyDigest(namespace NameSpace, node *GraphNode) string {
+	if node == nil {
+		return ""
+	}
+	return graphBodyDigest("node", namespace, struct {
+		Name       string
+		Chunks     []string
+		Attributes []string
+	}{node.Name, node.Chunks, node.Attributes})
+}
+func GraphRelationBodyDigest(namespace NameSpace, relation *GraphRelation) string {
+	if relation == nil {
+		return ""
+	}
+	return graphBodyDigest("relation", namespace, struct {
+		Node1 string
+		Node2 string
+		Type  string
+	}{relation.Node1, relation.Node2, relation.Type})
+}
+func BindGraphSourceReceipt(base *GraphSourceReceipt, bodyDigest string) (*GraphSourceReceipt, error) {
+	if base == nil {
+		return nil, ErrGraphSourceReceiptUnknown
+	}
+	copy := *base
+	var err error
+	copy.SourceLineage, err = UnionSourceLineage(base.SourceLineage)
+	if base.OriginalInput != nil {
+		p := *base.OriginalInput
+		p.ChunkIDs = append([]string(nil), p.ChunkIDs...)
+		p.SourceLineage, err = UnionSourceLineage(p.SourceLineage)
+		copy.OriginalInput = &p
+	}
+	if err != nil {
+		return nil, err
+	}
+	copy.BodyDigest = bodyDigest
+	if err := copy.Validate(); err != nil {
+		return nil, err
+	}
+	return &copy, nil
+}
+func CheckGraphNodeReceipt(namespace NameSpace, node *GraphNode) error {
+	if node == nil || node.SourceReceipt.Validate() != nil || node.SourceReceipt.KnowledgeBaseID != namespace.KnowledgeBase || node.SourceReceipt.KnowledgeID != namespace.Knowledge || node.SourceReceipt.BodyDigest != GraphNodeBodyDigest(namespace, node) {
+		return ErrGraphSourceReceiptUnknown
+	}
+	return nil
+}
+func CheckGraphRelationReceipt(namespace NameSpace, relation *GraphRelation) error {
+	if relation == nil || relation.SourceReceipt.Validate() != nil || relation.SourceReceipt.KnowledgeBaseID != namespace.KnowledgeBase || relation.SourceReceipt.KnowledgeID != namespace.Knowledge || relation.SourceReceipt.BodyDigest != GraphRelationBodyDigest(namespace, relation) {
+		return ErrGraphSourceReceiptUnknown
+	}
+	return nil
+}
+func EncodeGraphSourceReceipt(receipt *GraphSourceReceipt) (string, error) {
+	if err := receipt.Validate(); err != nil {
+		return "", err
+	}
+	b, err := json.Marshal(receipt)
+	if err != nil || len(b) > SourceLineageMaxBytes {
+		return "", ErrGraphSourceReceiptUnknown
+	}
+	return string(b), nil
+}
+func DecodeGraphSourceReceipt(encoded string) (*GraphSourceReceipt, error) {
+	if encoded == "" || len(encoded) > SourceLineageMaxBytes {
+		return nil, ErrGraphSourceReceiptUnknown
+	}
+	// Detect duplicate keys at every depth, including aliases. Receipts only use
+	// canonical ASCII keys and typed lineage has its own stricter decoder.
+	dec := json.NewDecoder(bytes.NewBufferString(encoded))
+	var walk func() error
+	depth := 0
+	walk = func() error {
+		if depth > 16 {
+			return ErrGraphSourceReceiptUnknown
+		}
+		depth++
+		defer func() { depth-- }()
+		token, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		d, ok := token.(json.Delim)
+		if !ok {
+			return nil
+		}
+		switch d {
+		case '{':
+			seen := map[string]bool{}
+			for dec.More() {
+				k, err := dec.Token()
+				if err != nil {
+					return err
+				}
+				s, ok := k.(string)
+				if !ok || seen[s] {
+					return ErrGraphSourceReceiptUnknown
+				}
+				if depth == 1 {
+					switch s {
+					case "version", "original_input", "tenant_id", "knowledge_base_id", "knowledge_id", "build_generation", "input_digest", "config_digest", "wire_digest", "body_digest", "source_lineage":
+					default:
+						return ErrGraphSourceReceiptUnknown
+					}
+				}
+				if depth == 2 {
+					switch s {
+					case "version", "projection", "tenant_id", "knowledge_base_id", "knowledge_id", "admission_id", "build_generation", "input_digest", "config_digest", "body_digest", "chunk_ids", "source_lineage", "state", "sources":
+					default:
+						return ErrGraphSourceReceiptUnknown
+					}
+				}
+				seen[s] = true
+				if err := walk(); err != nil {
+					return err
+				}
+			}
+		case '[':
+			for dec.More() {
+				if err := walk(); err != nil {
+					return err
+				}
+			}
+		default:
+			return ErrGraphSourceReceiptUnknown
+		}
+		_, err = dec.Token()
+		return err
+	}
+	if err := walk(); err != nil {
+		return nil, ErrGraphSourceReceiptUnknown
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return nil, ErrGraphSourceReceiptUnknown
+	}
+	dec = json.NewDecoder(bytes.NewBufferString(encoded))
+	dec.DisallowUnknownFields()
+	var receipt GraphSourceReceipt
+	if err := dec.Decode(&receipt); err != nil {
+		return nil, ErrGraphSourceReceiptUnknown
+	}
+	if err := receipt.Validate(); err != nil {
+		return nil, err
+	}
+	return &receipt, nil
+}
+
+// GraphWriteAuthorization is installed by the real build writer. It checks
+// the original admitted input proof/lease again within the graph transaction.
+// A background task JSON or model output never installs this callback.
+type graphWriteAuthorizationKey struct{}
+
+func WithGraphWriteAuthorization(ctx context.Context, check func(context.Context, *GraphSourceReceipt) error) context.Context {
+	return context.WithValue(ctx, graphWriteAuthorizationKey{}, check)
+}
+func CheckGraphWriteAuthorization(ctx context.Context, receipt *GraphSourceReceipt) error {
+	check, _ := ctx.Value(graphWriteAuthorizationKey{}).(func(context.Context, *GraphSourceReceipt) error)
+	if check == nil || receipt.Validate() != nil {
+		return ErrGraphSourceReceiptUnknown
+	}
+	copy, err := BindGraphSourceReceipt(receipt, receipt.BodyDigest)
+	if err != nil {
+		return err
+	}
+	return check(ctx, copy)
+}
+
+// ValidateGraphMaterial runs before any name-based collapse. Even a duplicate
+// or non-rendered contributor retains its full original input union.
+func ValidateGraphMaterial(graph *GraphData) (*SourceLineage, error) {
+	if graph == nil || graph.SourceLineage.RequireComplete() != nil {
+		return UnknownSourceLineage(), ErrGraphSourceReceiptUnknown
+	}
+	inputs := []*SourceLineage{graph.SourceLineage}
+	for _, receipt := range graph.InputReceipts {
+		if receipt.Validate() != nil {
+			return UnknownSourceLineage(), ErrGraphSourceReceiptUnknown
+		}
+		inputs = append(inputs, receipt.SourceLineage)
+	}
+	for _, node := range graph.Node {
+		if node == nil || node.SourceReceipt == nil {
+			return UnknownSourceLineage(), ErrGraphSourceReceiptUnknown
+		}
+		namespace := NameSpace{KnowledgeBase: node.SourceReceipt.KnowledgeBaseID, Knowledge: node.SourceReceipt.KnowledgeID}
+		if err := CheckGraphNodeReceipt(namespace, node); err != nil {
+			return UnknownSourceLineage(), err
+		}
+		inputs = append(inputs, node.SourceReceipt.SourceLineage)
+	}
+	for _, edge := range graph.Relation {
+		if edge == nil || edge.SourceReceipt == nil {
+			return UnknownSourceLineage(), ErrGraphSourceReceiptUnknown
+		}
+		namespace := NameSpace{KnowledgeBase: edge.SourceReceipt.KnowledgeBaseID, Knowledge: edge.SourceReceipt.KnowledgeID}
+		if err := CheckGraphRelationReceipt(namespace, edge); err != nil {
+			return UnknownSourceLineage(), err
+		}
+		inputs = append(inputs, edge.SourceReceipt.SourceLineage)
+	}
+	union, err := UnionSourceLineage(inputs...)
+	if err != nil || union.RequireComplete() != nil {
+		return UnknownSourceLineage(), ErrGraphSourceReceiptUnknown
+	}
+	return union, nil
+}
+
+func checkGraphOriginalInput(r *GraphSourceReceipt) error {
+	p := r.OriginalInput
+	if p == nil || p.Version != 1 || p.AdmissionID == "" || p.TenantID != r.TenantID || p.KnowledgeBaseID != r.KnowledgeBaseID || p.KnowledgeID != r.KnowledgeID || p.BuildGeneration != r.BuildGeneration || p.InputDigest != r.InputDigest || len(p.ChunkIDs) == 0 || p.SourceLineage.RequireComplete() != nil {
+		return ErrGraphSourceReceiptUnknown
+	}
+	for _, value := range []string{p.InputDigest, p.ConfigDigest, p.BodyDigest} {
+		decoded, err := hex.DecodeString(value)
+		if err != nil || len(decoded) != sha256.Size || hex.EncodeToString(decoded) != value {
+			return ErrGraphSourceReceiptUnknown
+		}
+	}
+	union, err := UnionSourceLineage(r.SourceLineage, p.SourceLineage)
+	if err != nil || !sameRAGSourceLineage(union, r.SourceLineage) {
+		return ErrGraphSourceReceiptUnknown
+	}
+	return nil
+}
+
+// CopyGraphSourceReceipt detaches a storage receipt before current callbacks.
+func CopyGraphSourceReceipt(r *GraphSourceReceipt) (*GraphSourceReceipt, error) {
+	encoded, err := EncodeGraphSourceReceipt(r)
+	if err != nil {
+		return nil, err
+	}
+	return DecodeGraphSourceReceipt(encoded)
+}
+
+func GraphDataBodyDigest(namespace NameSpace, graph *GraphData) string {
+	if graph == nil {
+		return ""
+	}
+	return graphBodyDigest("graph", namespace, graph)
+}
+func CheckGraphDataReceipt(namespace NameSpace, graph *GraphData) error {
+	if graph == nil || graph.SourceReceipt.Validate() != nil || graph.SourceReceipt.KnowledgeBaseID != namespace.KnowledgeBase || graph.SourceReceipt.KnowledgeID != namespace.Knowledge || graph.SourceReceipt.BodyDigest != GraphDataBodyDigest(namespace, graph) {
+		return ErrGraphSourceReceiptUnknown
+	}
+	return nil
+}
diff --git a/internal/types/graph_source_receipt_test.go b/internal/types/graph_source_receipt_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6344b0ac829fb4515e3baf773e1e93a8b31c1c4e
--- /dev/null
+++ b/internal/types/graph_source_receipt_test.go
@@ -0,0 +1,83 @@
+package types
+
+import (
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+)
+
+func graphReceiptFixture(t *testing.T) (NameSpace, *GraphNode) {
+	t.Helper()
+	empty, _ := NewCompleteSourceLineage()
+	namespace := NameSpace{KnowledgeBase: "kb", Knowledge: "doc"}
+	proof := &KnowledgeBuildInputProof{Version: 1, TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: "doc", AdmissionID: "immutable-origin", BuildGeneration: 1, InputDigest: GraphDigest("body"), ConfigDigest: GraphDigest("config"), BodyDigest: GraphDigest("snapshot"), ChunkIDs: []string{"chunk"}, SourceLineage: empty}
+	node := &GraphNode{Name: "entity", Chunks: []string{"chunk"}, Attributes: []string{"fact"}}
+	var err error
+	node.SourceReceipt, err = BindGraphSourceReceipt(&GraphSourceReceipt{Version: 1, OriginalInput: proof, TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: "doc", BuildGeneration: 1, InputDigest: proof.InputDigest, ConfigDigest: GraphDigest("actual template"), WireDigest: GraphDigest("actual messages/options"), SourceLineage: empty}, GraphNodeBodyDigest(namespace, node))
+	require.NoError(t, err)
+	return namespace, node
+}
+func TestKnowledgeGraphReceiptPrivateAndOriginalBinding(t *testing.T) {
+	namespace, node := graphReceiptFixture(t)
+	require.NoError(t, CheckGraphNodeReceipt(namespace, node))
+	encoded, err := EncodeGraphSourceReceipt(node.SourceReceipt)
+	require.NoError(t, err)
+	decoded, err := DecodeGraphSourceReceipt(encoded)
+	require.NoError(t, err)
+	require.Equal(t, node.SourceReceipt, decoded)
+	public, err := json.Marshal(node)
+	require.NoError(t, err)
+	require.NotContains(t, string(public), "source_receipt")
+	var forged GraphNode
+	require.NoError(t, json.Unmarshal([]byte(`{"name":"entity","source_receipt":{"version":1,"source_lineage":{"version":1,"state":"complete","sources":[]}}}`), &forged))
+	require.Nil(t, forged.SourceReceipt)
+	node.Attributes[0] = "changed"
+	require.ErrorIs(t, CheckGraphNodeReceipt(namespace, node), ErrGraphSourceReceiptUnknown)
+}
+func TestKnowledgeGraphReceiptMalformedOriginalAndLegacyClosed(t *testing.T) {
+	for _, mode := range []string{"nil", "generation", "admission", "source unknown", "input digest", "duplicate key", "extra key"} {
+		t.Run(mode, func(t *testing.T) {
+			_, node := graphReceiptFixture(t)
+			r := node.SourceReceipt
+			encoded, err := EncodeGraphSourceReceipt(r)
+			require.NoError(t, err)
+			switch mode {
+			case "nil":
+				r.OriginalInput = nil
+			case "generation":
+				r.OriginalInput.BuildGeneration++
+			case "admission":
+				r.OriginalInput.AdmissionID = ""
+			case "source unknown":
+				r.OriginalInput.SourceLineage = UnknownSourceLineage()
+			case "input digest":
+				r.OriginalInput.InputDigest = GraphDigest("new input")
+			case "duplicate key":
+				encoded = strings.Replace(encoded, `"tenant_id":7`, `"tenant_id":7,"tenant_id":7`, 1)
+			case "extra key":
+				encoded = strings.Replace(encoded, `"version":1`, `"version":1,"fake":true`, 1)
+			}
+			if mode == "duplicate key" || mode == "extra key" {
+				_, err := DecodeGraphSourceReceipt(encoded)
+				require.Error(t, err)
+			} else {
+				require.Error(t, r.Validate())
+			}
+		})
+	}
+}
+func TestKnowledgeGraphPromptOriginRequiresExactActualMaterial(t *testing.T) {
+	empty, _ := NewCompleteSourceLineage()
+	template, err := BindGraphPromptTemplateOrigin(&PromptTemplateStructured{Description: "trusted human raw instructions", Tags: []string{"tag"}, Examples: []GraphData{{Text: "trusted human example", Node: []*GraphNode{{Name: "example"}}}}}, empty)
+	require.NoError(t, err)
+	lineage, err := GraphPromptTemplateLineage(template)
+	require.NoError(t, err)
+	require.Empty(t, lineage.Sources)
+	template.Examples[0].Node[0].Name = "derived name"
+	_, err = GraphPromptTemplateLineage(template)
+	require.Error(t, err)
+	var incoming PromptTemplateStructured
+	require.NoError(t, json.Unmarshal([]byte(`{"description":"x","source_origin":{"source_lineage":{"version":1,"state":"complete","sources":[]}}}`), &incoming))
+	require.Nil(t, incoming.SourceOrigin)
+}
diff --git a/internal/types/history_material_lifetime.go b/internal/types/history_material_lifetime.go
new file mode 100644
index 0000000000000000000000000000000000000000..d5602fa29e235dc458be147414b8d858ec9ef9d5
--- /dev/null
+++ b/internal/types/history_material_lifetime.go
@@ -0,0 +1,40 @@
+package types
+
+import (
+	"context"
+	"sync"
+)
+
+type historyMaterialLifetimeKey struct{}
+
+// A request-local actual material checker. It does not grant source or actor
+// access; those checks remain independent in each original producer guard.
+type HistoryMaterialLifetime struct {
+	Check func() error
+	Close func()
+	once  sync.Once
+}
+
+func WithHistoryMaterialLifetime(ctx context.Context, check func() error, close func()) context.Context {
+	return context.WithValue(ctx, historyMaterialLifetimeKey{}, &HistoryMaterialLifetime{Check: check, Close: close})
+}
+func CheckHistoryMaterialLifetime(ctx context.Context) error {
+	holder, _ := ctx.Value(historyMaterialLifetimeKey{}).(*HistoryMaterialLifetime)
+	if holder == nil {
+		return nil
+	}
+	if holder.Check == nil {
+		return ErrSourceLineageUnknown
+	}
+	return holder.Check()
+}
+func CloseHistoryMaterialLifetime(ctx context.Context) {
+	holder, _ := ctx.Value(historyMaterialLifetimeKey{}).(*HistoryMaterialLifetime)
+	if holder != nil {
+		holder.once.Do(func() {
+			if holder.Close != nil {
+				holder.Close()
+			}
+		})
+	}
+}
