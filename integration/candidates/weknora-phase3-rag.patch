+func gcActualRunDueContract(t *testing.T, pg bool) {
+	for _, mode := range []string{"coverage-missing", "broad-reader", "exact-reader", "build-worker", "late-reader", "provider-failure", "crash-after-unlink", "restore-before-provider", "symlink", "shared", "lost-claim"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := context.Background()
+			store, db, jobID, ref, path := gcActualObjectFixture(t, pg)
+			scope := NextcloudContentScope{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: "old", DataSourceID: "ds", ExternalID: "node"}
+			leases := NewNextcloudContentLeaseStore(db)
+			var held NextcloudContentLease
+			var err error
+			calls := 0
+			if mode == "coverage-missing" {
+				require.NoError(t, db.Exec("DELETE FROM nextcloud_content_lease_coverage WHERE tenant_id=7 AND knowledge_base_id='kb'").Error)
+			}
+			if mode == "broad-reader" {
+				held, err = leases.AcquireKBRead(ctx, 7, "kb", "live-reader", time.Minute)
+				require.NoError(t, err)
+			}
+			if mode == "exact-reader" || mode == "build-worker" {
+				require.NoError(t, db.Exec("UPDATE nextcloud_content_fences SET state='open' WHERE tenant_id=7 AND knowledge_base_id='kb' AND knowledge_id='old'").Error)
+				kind := NextcloudContentReadLease
+				if mode == "build-worker" {
+					kind = NextcloudContentBuildLease
+				}
+				held, err = leases.AcquireKnowledge(ctx, scope, kind, "live-exact", time.Minute)
+				require.NoError(t, err)
+				require.NoError(t, leases.RetireKnowledge(ctx, scope))
+				var fence nextcloudContentFence
+				require.NoError(t, db.Where("tenant_id=7 AND knowledge_base_id='kb' AND knowledge_id='old'").Take(&fence).Error)
+				due := time.UnixMilli(*fence.RetiredAtMS)
+				require.NoError(t, db.Model(&nextcloudGCJob{}).Where("id=?", jobID).Updates(map[string]any{"not_before": due, "original_not_before": due, "next_attempt_at": due}).Error)
+			}
+			if mode == "shared" {
+				var r types.StoredResource
+				require.NoError(t, db.Where("handle=?", strings.Repeat("z", 22)).Take(&r).Error)
+				require.NoError(t, db.Create(&types.ResourceBinding{ResourceID: r.ID, TenantID: 7, OwnerType: "message", OwnerID: "current-shared", Relation: "artifact"}).Error)
+			}
+			if mode == "symlink" {
+				require.NoError(t, os.Remove(path))
+				target := filepath.Join(filepath.Dir(path), "current.txt")
+				require.NoError(t, os.WriteFile(target, []byte("current bytes must survive"), 0600))
+				require.NoError(t, os.Symlink(target, path))
+			}
+			var resource types.StoredResource
+			require.NoError(t, db.Where("handle=?", strings.Repeat("z", 22)).Take(&resource).Error)
+			provider := filesvc.NewBackendScopedFileService("backend", filesvc.NewLocalFileService(filepath.Dir(filepath.Dir(filepath.Dir(path))), ""))
+			deleter := provider.(interfaces.NextcloudPhysicalGCDeleter)
+			store.ConfigureLocalDeletePreparation(func(context.Context, *types.StoredResource) (func(context.Context) (bool, error), error) {
+				if mode == "late-reader" {
+					_, err := leases.AcquireKBRead(ctx, 7, "kb", "post-claim", time.Minute)
+					require.ErrorIs(t, err, ErrNextcloudContentLeaseDenied)
+				}
+				if mode == "lost-claim" {
+					require.NoError(t, db.Exec("UPDATE nextcloud_content_fences SET claim_token='successor-claim' WHERE tenant_id=7 AND knowledge_base_id='kb' AND knowledge_id='old'").Error)
+					require.NoError(t, db.Model(&nextcloudGCItem{}).Where("job_id=? AND kind='source_file'", jobID).Update("lease_token", "successor-claim").Error)
+				}
+				if mode == "restore-before-provider" {
+					require.NoError(t, db.Model(&nextcloudSourceVersion{}).Where("tenant_id=7 AND knowledge_base_id='kb' AND datasource_id='ds' AND external_id='node'").Updates(map[string]any{"state": "published", "candidate_knowledge_id": "old"}).Error)
+				}
+				return func(ioCtx context.Context) (bool, error) {
+					calls++
+					if mode == "provider-failure" && calls == 1 {
+						return false, errors.New("owned provider unavailable")
+					}
+					unlinked, e := deleter.DeleteNextcloudObject(ioCtx, resource.PhysicalPath)
+					if mode == "crash-after-unlink" && calls == 1 && e == nil {
+						return false, errors.New("crash after unlink before DB receipt")
+					}
+					return unlinked, e
+				}, nil
+			})
+			_, err = store.RunDue(ctx, time.Now().Add(time.Second), 10)
+			if mode == "lost-claim" {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+			switch mode {
+			case "coverage-missing", "broad-reader", "exact-reader", "build-worker":
+				require.Zero(t, calls)
+				_, err = os.Stat(path)
+				require.NoError(t, err)
+				if held.ID != "" {
+					require.NoError(t, leases.ReleaseLease(ctx, held.ID))
+				} else {
+					leaseTestCoverKB(t, db, scope)
