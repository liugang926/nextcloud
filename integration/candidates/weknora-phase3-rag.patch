+	return messages, kg, store, db, ctx, session
+}
+func produceActualMessagePair(t *testing.T, messages *messageService, ctx context.Context, session *types.Session) (*types.Message, *types.Message) {
+	t.Helper()
+	user, err := messages.CreateMessage(ctx, &types.Message{SessionID: session.ID, RequestID: "actual-material-request", Role: "user", Content: "new actual original question", IsCompleted: true, ExecutionContext: types.MessageExecutionContext{KnowledgeBaseIDs: []string{"kb"}}})
+	require.NoError(t, err)
+	assistant, err := messages.CreateMessage(ctx, &types.Message{SessionID: session.ID, RequestID: user.RequestID, Role: "assistant", IsCompleted: false, ExecutionContext: user.ExecutionContext})
+	require.NoError(t, err)
+	assistant.Content = "new actual original generated answer"
+	assistant.IsCompleted = true
+	assistant.SourceLineage, _ = types.NewCompleteSourceLineage()
+	require.NoError(t, messages.UpdateMessage(ctx, assistant))
+	return user, assistant
+}
+func TestMessageMaterialActualProducerReadAndDerivedKnowledgeSingleConnection(t *testing.T) {
+	messages, kg, store, db, ctx, session := messageMaterialActualFixture(t)
+	_, assistant := produceActualMessagePair(t, messages, ctx, session)
+	request, err := store.CommittedMessageParentRequest(ctx, 7, session.ID, assistant.ID)
+	require.NoError(t, err)
+	guard, err := messages.beginMessageMaterialRead(ctx, request)
+	require.NoError(t, err)
+	require.NoError(t, guard.Recheck())
+	guard.Close()
+	tenant, _ := types.TenantInfoFromContext(ctx)
+	if tenant == nil {
+		tenant = kg.tenantRepo.(knowledgeInputTenantRepo).tenant
+	}
+	tenant.ChatHistoryConfig = &types.ChatHistoryConfig{Enabled: true, KnowledgeBaseID: "kb", EmbeddingModelID: "embed"}
+	ctx = context.WithValue(ctx, types.TenantInfoContextKey, tenant)
+	messages.IndexMessageToKB(ctx, "foreign cached question", "foreign cached answer", assistant.ID, session.ID)
+	queue := kg.task.(*knowledgeInputQueue)
+	require.Len(t, queue.tasks, 1)
+	var payload types.DocumentProcessPayload
+	require.NoError(t, json.Unmarshal(queue.tasks[0].Payload(), &payload))
+	require.Contains(t, payload.Passages[0], assistant.Content)
+	require.NotContains(t, payload.Passages[0], "foreign cached")
+	result := &types.CommittedHistoryKnowledgeInput{Knowledge: &types.Knowledge{ID: payload.KnowledgeID}, Passages: payload.Passages, Proof: payload.OriginalInput}
+	require.NoError(t, kg.ProcessDocument(context.Background(), asynq.NewTask(types.TypeDocumentProcess, queue.tasks[0].Payload())))
+	var persisted types.Knowledge
+	require.NoError(t, db.Where("id=?", result.Knowledge.ID).Take(&persisted).Error)
+	t.Logf("postworker status=%s error=%s", persisted.ParseStatus, persisted.ErrorMessage)
+	debugCtx, debugErr := kg.resumeKnowledgeInput(context.Background(), result.Proof, result.Passages)
+	require.NoError(t, debugErr)
+	require.NoError(t, requireActualKnowledgeBuildInput(debugCtx), "after actual chunks")
+	closeHistoryMaterialGuard(debugCtx)
+	var count int64
+	require.NoError(t, db.Model(&types.Chunk{}).Where("knowledge_id=?", result.Knowledge.ID).Count(&count).Error)
+	require.Positive(t, count)
+	originalRead, err := messages.beginMessageMaterialRead(ctx, request)
+	require.NoError(t, err)
+	var ids []string
+	require.NoError(t, db.Model(&types.Chunk{}).Where("knowledge_id=?", result.Knowledge.ID).Pluck("id", &ids).Error)
+	snapshot, err := store.CaptureKnowledgeBuildInputs(originalRead.Context(), types.KnowledgeBuildInputCaptureRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: result.Knowledge.ID, ChunkIDs: ids, Expected: result.Proof})
+	require.NoError(t, err)
+	require.NoError(t, snapshot.Proof.SourceLineage.RequireComplete())
+	require.NotEmpty(t, snapshot.Chunks)
+	require.Equal(t, "enabled", snapshot.Knowledge.EnableStatus)
+	require.NoError(t, messages.sourceLineageGuard.Check(originalRead.Context(), snapshot.Proof.SourceLineage, access.LineageReadScope{Targets: []*types.SearchTarget{{Type: types.SearchTargetTypeKnowledgeBase, KnowledgeBaseID: "kb", TenantID: 7}}}))
+	originalRead.Close()
+	require.NoError(t, db.Table("nextcloud_content_leases").Where("kind='read' AND released_at_ms IS NULL").Count(&count).Error)
+	require.Zero(t, count)
+}
+func TestMessageMaterialActualProducerLegacyAndBodyOwnerABAReject(t *testing.T) {
+	for _, change := range []string{"legacy", "content-ABA", "owner-ABA", "caller", "user-revoked", "member-revoked", "execution-ABA", "membership-ABA"} {
+		t.Run(change, func(t *testing.T) {
+			messages, _, store, db, ctx, session := messageMaterialActualFixture(t)
+			_, assistant := produceActualMessagePair(t, messages, ctx, session)
+			request, err := store.CommittedMessageParentRequest(ctx, 7, session.ID, assistant.ID)
+			require.NoError(t, err)
+			guard, err := messages.beginMessageMaterialRead(ctx, request)
+			require.NoError(t, err)
+			defer guard.Close()
+			switch change {
+			case "legacy":
+				legacy := *assistant
+				legacy.ID = "old-unadmitted-message"
+				legacy.RequestID = "old-request"
+				require.NoError(t, db.Create(&legacy).Error)
+				_, err = messages.beginMessageMaterialRead(ctx, types.MessageMaterialReadRequest{TenantID: 7, SessionID: session.ID, MessageIDs: []string{legacy.ID}})
+				require.Error(t, err)
+				return
+			case "execution-ABA":
+				require.NoError(t, db.Model(&types.Message{}).Where("id=?", assistant.ID).Update("execution_context", types.MessageExecutionContext{KnowledgeBaseIDs: []string{"foreign-kb"}}).Error)
+				require.NoError(t, db.Model(&types.Message{}).Where("id=?", assistant.ID).Update("execution_context", assistant.ExecutionContext).Error)
+			case "membership-ABA":
+				other, err := messages.CreateMessage(ctx, &types.Message{SessionID: session.ID, RequestID: "new-foreign-candidate", Role: "user", Content: "new human candidate", IsCompleted: true})
+				require.NoError(t, err)
+				require.NoError(t, db.Delete(other).Error)
+			case "content-ABA":
+				require.NoError(t, db.Model(&types.Message{}).Where("id=?", assistant.ID).Update("content", "foreign transient").Error)
+				require.NoError(t, db.Model(&types.Message{}).Where("id=?", assistant.ID).Update("content", assistant.Content).Error)
+			case "owner-ABA":
+				owner := session.UserID
+				require.NoError(t, db.Model(session).Update("user_id", "other-user").Error)
+				require.NoError(t, db.Model(session).Update("user_id", owner).Error)
+			case "caller":
+				user := &types.User{ID: "same-role-other", TenantID: 7, Username: "other", Email: "other@isolated.test", IsActive: true}
+				require.NoError(t, db.Create(user).Error)
+				require.NoError(t, db.Create(&types.TenantMember{UserID: user.ID, TenantID: 7, Role: types.TenantRoleContributor, Status: types.TenantMemberStatusActive}).Error)
+				other := types.WithPrincipal(types.WithCaller(ctx, types.Caller{TenantID: 7, UserID: user.ID, Role: types.TenantRoleContributor}), types.Principal{Type: types.PrincipalWebUser, ID: user.ID})
+				_, err = messages.beginMessageMaterialRead(other, request)
+				require.Error(t, err)
+				return
+			case "user-revoked":
+				require.NoError(t, db.Model(&types.User{}).Where("id='actual-user'").Update("is_active", false).Error)
+			case "member-revoked":
+				require.NoError(t, db.Model(&types.TenantMember{}).Where("user_id='actual-user' AND tenant_id=7").Update("status", types.TenantMemberStatusSuspended).Error)
+			}
+			require.Error(t, guard.Recheck())
+		})
+	}
+}
+
+func TestMessageMaterialActualSavedReadBoundarySingleConnection(t *testing.T) {
+	messages, _, _, db, ctx, session := messageMaterialActualFixture(t)
