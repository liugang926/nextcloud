@@ -0,0 +1,50 @@
+package repository
+
+import (
+	"fmt"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"strings"
+)
+
+func knowledgeAutoTagModelInputs(tx *gorm.DB, kb *types.KnowledgeBase) (string, *types.Tenant, error) {
+	if kb.AutoTagConfig == nil || !kb.AutoTagConfig.Enabled {
+		return "", nil, nil
+	}
+	id := strings.TrimSpace(kb.AutoTagConfig.ModelID)
+	if id == "" {
+		id = strings.TrimSpace(kb.SummaryModelID)
+	}
+	if id == "" {
+		return "", nil, nil
+	}
+	var model types.Model
+	if err := tx.Where("id = ? AND (tenant_id = ? OR is_builtin = ?)", id, kb.TenantID, true).Take(&model).Error; err != nil {
+		return "", nil, err
+	}
+	if model.Status != types.ModelStatusActive {
+		return "", nil, ErrKnowledgeInputChanged
+	}
+	modelRevision, err := knowledgeEnrichmentRevision(tx, "model", id)
+	if err != nil {
+		return "", nil, err
+	}
+	var tenant types.Tenant
+	if err := tx.Where("id = ?", kb.TenantID).Take(&tenant).Error; err != nil {
+		return "", nil, err
+	}
+	tenantRevision, err := knowledgeEnrichmentRevision(tx, "tenant", fmt.Sprint(kb.TenantID))
+	if err != nil {
+		return "", nil, err
+	}
+	digest, err := knowledgeProducerTenantDigest(&tenant)
+	if err != nil {
+		return "", nil, err
+	}
+	envelope, err := KnowledgeInputDigest(struct {
+		Model                         types.Model
+		ModelRevision, TenantRevision uint64
+		TenantDigest                  string
+	}{model, modelRevision, tenantRevision, digest})
+	return envelope, &tenant, err
+}
diff --git a/internal/application/repository/knowledge_auto_tag_task_input.go b/internal/application/repository/knowledge_auto_tag_task_input.go
new file mode 100644
index 0000000000000000000000000000000000000000..e743c62d71b09ac2ace417eed2d7e4a2d88d6dbe
--- /dev/null
+++ b/internal/application/repository/knowledge_auto_tag_task_input.go
@@ -0,0 +1,85 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+type autoTagActualTaskInput struct {
+	Kind    string
+	Payload types.KnowledgeAutoTagPayload
+}
+
+func (s *KnowledgeInputProvenanceStore) AdmitKnowledgeAutoTagTaskInput(ctx context.Context, p types.KnowledgeAutoTagPayload) (*types.KnowledgeAutoTagTaskInputProof, error) {
+	if p.TaskInput != nil || p.OriginalInput == nil || p.OriginalInput.BodyDigest == "" || p.TenantID != p.OriginalInput.TenantID || p.KnowledgeBaseID != p.OriginalInput.KnowledgeBaseID || p.KnowledgeID != p.OriginalInput.KnowledgeID {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	if err := s.RecheckKnowledgeBuildInputs(ctx, p.OriginalInput); err != nil {
+		return nil, err
+	}
+	envelope := autoTagActualTaskInput{Kind: "actual_queue_input", Payload: p}
+	digest, err := KnowledgeInputDigest(envelope)
+	if err != nil {
+		return nil, err
+	}
+	data, err := json.Marshal(envelope)
+	if err != nil {
+		return nil, err
+	}
+	lineage, err := json.Marshal(p.OriginalInput.SourceLineage)
+	if err != nil {
+		return nil, err
+	}
+	id := uuid.NewString()
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		actual, err := s.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: p.TenantID, KnowledgeBaseID: p.KnowledgeBaseID, KnowledgeID: p.KnowledgeID, ChunkIDs: p.OriginalInput.ChunkIDs, Expected: p.OriginalInput}, true)
+		if err != nil {
+			return err
+		}
+		if s.displayAuthorityFactory == nil {
+			return types.ErrSourceLineageUnknown
+		}
+		authority := s.displayAuthorityFactory(tx)
+		if authority == nil || authority.db != tx {
+			return types.ErrSourceLineageUnknown
+		}
+		if _, err := authority.authorizeOriginalKnowledgeProducerWrite(ctx, actual.KnowledgeBase, p.OriginalInput); err != nil {
+			return err
+		}
+		return tx.Create(&knowledgeAutoTagManifest{ManifestID: id, TenantID: p.TenantID, KnowledgeBaseID: p.KnowledgeBaseID, KnowledgeID: p.KnowledgeID, AdmissionID: p.OriginalInput.AdmissionID, InputDigest: digest, ActualInputs: string(data), SourceLineage: string(lineage)}).Error
+	}, knowledgeDisplayWriteOptions(s.db))
+	if err != nil {
+		return nil, err
+	}
+	return &types.KnowledgeAutoTagTaskInputProof{ID: id, Digest: digest}, nil
+}
+func (s *KnowledgeInputProvenanceStore) VerifyKnowledgeAutoTagTaskInput(ctx context.Context, p types.KnowledgeAutoTagPayload) error {
+	if p.TaskInput == nil || p.OriginalInput == nil {
+		return types.ErrSourceLineageUnknown
+	}
+	var row knowledgeAutoTagManifest
+	if err := s.db.WithContext(ctx).Where("manifest_id = ? AND tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ? AND admission_id = ?", p.TaskInput.ID, p.TenantID, p.KnowledgeBaseID, p.KnowledgeID, p.OriginalInput.AdmissionID).Take(&row).Error; err != nil {
+		return err
+	}
+	if p.TaskInput.Digest != row.InputDigest {
+		return ErrKnowledgeInputChanged
+	}
+	p.TaskInput = nil
+	got := autoTagActualTaskInput{Kind: "actual_queue_input", Payload: p}
+	digest, err := KnowledgeInputDigest(got)
+	if err != nil || digest != row.InputDigest {
+		return ErrKnowledgeInputChanged
+	}
+	var saved autoTagActualTaskInput
+	if json.Unmarshal([]byte(row.ActualInputs), &saved) != nil || saved.Kind != "actual_queue_input" {
+		return ErrKnowledgeInputChanged
+	}
+	stored, err := KnowledgeInputDigest(saved)
+	if err != nil || stored != digest {
+		return ErrKnowledgeInputChanged
+	}
+	return nil
+}
diff --git a/internal/application/repository/knowledge_build_actor.go b/internal/application/repository/knowledge_build_actor.go
new file mode 100644
index 0000000000000000000000000000000000000000..d5410e270721de3a9da086202752d91b25621974
--- /dev/null
+++ b/internal/application/repository/knowledge_build_actor.go
@@ -0,0 +1,379 @@
+package repository
+
+import (
+	"context"
+	"fmt"
+	"reflect"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+type knowledgeBuildActorSelector struct {
+	AdmissionID    string `gorm:"primaryKey"`
+	CallerTenantID uint64
+	UserID         string
+	PrincipalType  string
+	PrincipalID    string
+	APIKeyID       *uint64
+}
+
+type knowledgeBuildActorContextKey struct{}
+type knowledgeBuildWritePurposeContextKey struct{}
+
+func (s *KnowledgeInputProvenanceStore) recheckKnowledgeWorkerActor(ctx context.Context, proof *types.KnowledgeBuildInputProof) error {
+	if marker, ok := ctx.Value(knowledgeCurrentProducerWriteKey{}).(knowledgeCurrentProducerWrite); ok {
+		if proof == nil || marker.tenant != proof.TenantID || marker.kb != proof.KnowledgeBaseID {
+			return ErrKnowledgeInputChanged
+		}
+		fresh, err := s.refreshKnowledgeCurrentProducerWrite(ctx, marker)
+		if err != nil {
+			return err
+		}
+		a, _ := types.PrincipalFromContext(ctx)
+		b, _ := types.PrincipalFromContext(fresh)
+		if a != b || types.CallerFromContext(ctx) != types.CallerFromContext(fresh) {
+			return ErrKnowledgeInputChanged
+		}
+		return nil
+	}
+
+	if producer, ok := ctx.Value(knowledgeProducerActorContextKey{}).(*types.KnowledgeProducerInputProof); ok {
+		fresh, err := s.RestoreKnowledgeProducerActor(ctx, proof, producer)
+		if err != nil {
+			return err
+		}
+		a, _ := types.PrincipalFromContext(ctx)
+		b, _ := types.PrincipalFromContext(fresh)
+		if a != b || types.CallerFromContext(ctx) != types.CallerFromContext(fresh) {
+			return ErrKnowledgeInputChanged
+		}
+		return nil
+	}
+	id, _ := ctx.Value(knowledgeBuildActorContextKey{}).(string)
+	if id == "" {
+		return nil
+	}
+	if proof == nil || id != proof.AdmissionID {
+		return ErrKnowledgeInputChanged
+	}
+	fresh, err := s.RestoreKnowledgeBuildActor(ctx, proof)
+	if err != nil {
+		return err
+	}
+	if types.CallerFromContext(ctx) != types.CallerFromContext(fresh) {
+		return ErrKnowledgeInputChanged
+	}
+	oldPrincipal, _ := types.PrincipalFromContext(ctx)
+	newPrincipal, _ := types.PrincipalFromContext(fresh)
+	if oldPrincipal != newPrincipal {
+		return ErrKnowledgeInputChanged
+	}
+	oldKey, oldOK := types.TenantAPIKeyScopeFromContext(ctx)
+	newKey, newOK := types.TenantAPIKeyScopeFromContext(fresh)
+	if oldOK != newOK || !reflect.DeepEqual(oldKey, newKey) {
+		return ErrKnowledgeInputChanged
+	}
+	return nil
+}
+
+func (knowledgeBuildActorSelector) TableName() string { return "knowledge_input_actor_selectors" }
+
+func captureKnowledgeActorSelector(ctx context.Context, admissionID string) (knowledgeBuildActorSelector, error) {
+	if ctx == nil {
+		return knowledgeBuildActorSelector{}, types.ErrSourceLineageUnknown
+	}
+	caller, capturedCaller := ctx.Value(types.CallerContextKey).(types.Caller)
+	principal, ok := ctx.Value(types.PrincipalContextKey).(types.Principal)
+	selector := knowledgeBuildActorSelector{AdmissionID: admissionID, CallerTenantID: caller.TenantID, UserID: caller.UserID, PrincipalType: principal.Type, PrincipalID: principal.ID}
+	if !capturedCaller || !ok || !principal.Valid() || principal != principal.Normalize() || caller.TenantID == 0 {
+		return selector, types.ErrSourceLineageUnknown
+	}
+	switch principal.Type {
+	case types.PrincipalWebUser:
+		_, machine := types.TenantAPIKeyScopeFromContext(ctx)
+		if caller.UserID == "" || principal.ID != caller.UserID || types.IsSyntheticUserID(caller.UserID) || machine {
+			return selector, ErrKnowledgeInputChanged
+		}
+	case types.PrincipalAPITenant, types.PrincipalAPIExternalUser:
+		scope, ok := types.TenantAPIKeyScopeFromContext(ctx)
+		if !ok || scope.KeyID == 0 || scope.IsPlatform() {
+			return selector, ErrKnowledgeInputChanged
+		}
+		selector.UserID = ""
+		key := scope.KeyID
+		selector.APIKeyID = &key
+	default:
+		return selector, types.ErrSourceLineageUnknown
+	}
+	return selector, nil
+}
+
+func ConfigureKnowledgeInputActorGroupAccess(store *KnowledgeInputProvenanceStore, groups interfaces.GroupAccessService) {
+	store.actorGroups = groups
+}
+
+func ConfigureKnowledgeInputActorShares(store *KnowledgeInputProvenanceStore, shares access.KBShareLookup) {
+	store.actorShares = shares
+}
+
+// RestoreKnowledgeBuildActorIfRequired is the trusted worker boundary. It
+// reloads the immutable actor selector for actor-bound original admissions;
+// ordinary and Nextcloud admissions keep their existing execution context.
+func RestoreKnowledgeBuildActorIfRequired(ctx context.Context, reader interfaces.KnowledgeBuildInputReader, proof *types.KnowledgeBuildInputProof) (context.Context, error) {
+	if reader == nil || proof == nil {
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	probe, ok := reader.(interface {
+		KnowledgeBuildActorRequired(context.Context, *types.KnowledgeBuildInputProof) (bool, error)
+	})
+	if !ok {
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	required, err := probe.KnowledgeBuildActorRequired(ctx, proof)
+	if err != nil || !required {
+		return ctx, err
+	}
+	restorer, ok := reader.(interface {
+		RestoreKnowledgeBuildActor(context.Context, *types.KnowledgeBuildInputProof) (context.Context, error)
+	})
+	if !ok {
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	return restorer.RestoreKnowledgeBuildActor(ctx, proof)
+}
+
+func (s *KnowledgeInputProvenanceStore) KnowledgeBuildActorRequired(ctx context.Context, proof *types.KnowledgeBuildInputProof) (bool, error) {
+	if proof == nil {
+		return false, types.ErrSourceLineageUnknown
+	}
+	var admission knowledgeInputAdmission
+	if err := s.db.WithContext(ctx).Where("admission_id = ? AND tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ?", proof.AdmissionID, proof.TenantID, proof.KnowledgeBaseID, proof.KnowledgeID).Take(&admission).Error; err != nil {
+		return false, err
+	}
+	var count int64
+	if err := s.db.WithContext(ctx).Model(&knowledgeBuildActorSelector{}).Where("admission_id = ?", proof.AdmissionID).Count(&count).Error; err != nil {
+		return false, err
+	}
+	return admission.OriginKind == "history" || count == 1, nil
+}
+
+// RestoreKnowledgeBuildActor loads the original immutable selector and current
+// active account/key/membership. Persisted roles or owner strings never grant
+// authority. KB/file/parent permissions are still freshly authorized by their
+// mandatory scoped guards after this reconstruction.
+func (s *KnowledgeInputProvenanceStore) RestoreKnowledgeBuildActor(ctx context.Context, proof *types.KnowledgeBuildInputProof) (context.Context, error) {
+	if proof == nil || proof.AdmissionID == "" {
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	var actor knowledgeBuildActorSelector
+	if err := s.db.WithContext(ctx).Where("admission_id = ?", proof.AdmissionID).Take(&actor).Error; err != nil {
+		return ctx, err
+	}
+	var admission knowledgeInputAdmission
+	if err := s.db.WithContext(ctx).Where("admission_id = ? AND tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ?", proof.AdmissionID, proof.TenantID, proof.KnowledgeBaseID, proof.KnowledgeID).Take(&admission).Error; err != nil {
+		return ctx, err
+	}
+	if admission.BuildGeneration != proof.BuildGeneration || admission.InputDigest != proof.InputDigest {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	fresh, err := s.restoreCurrentKnowledgeActor(ctx, actor, proof.TenantID)
+	if err != nil {
+		return ctx, err
+	}
+	var kb types.KnowledgeBase
+	if err := s.db.WithContext(fresh).Where("id = ? AND tenant_id = ?", proof.KnowledgeBaseID, proof.TenantID).Take(&kb).Error; err != nil {
+		return ctx, err
+	}
+	fresh, err = s.authorizeKnowledgeActorWrite(fresh, &kb)
+	if err != nil {
+		return ctx, err
+	}
+	fresh = context.WithValue(fresh, knowledgeBuildWritePurposeContextKey{}, cloneKnowledgeInputProof(proof))
+	return context.WithValue(fresh, knowledgeBuildActorContextKey{}, proof.AdmissionID), nil
+}
+
+// AuthorizeCurrentKnowledgeInputWrite checks a current authenticated request's
+// exact actor against a server-loaded KB. It never restores another admission's
+// actor. Bind this store and its group/share lookups to the writer transaction
+// when the authorized producer publishes a receipt in that transaction.
+func (s *KnowledgeInputProvenanceStore) AuthorizeCurrentKnowledgeInputWrite(ctx context.Context, kb *types.KnowledgeBase) (context.Context, error) {
+	if kb == nil || kb.ID == "" || kb.TenantID == 0 {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	actor, err := captureKnowledgeActorSelector(ctx, "")
+	if err != nil {
+		return ctx, err
+	}
+	fresh, err := s.restoreCurrentKnowledgeActor(ctx, actor, kb.TenantID)
+	if err != nil {
+		return ctx, err
+	}
+	var actual types.KnowledgeBase
+	if err := s.db.WithContext(fresh).Where("id = ? AND tenant_id = ?", kb.ID, kb.TenantID).Take(&actual).Error; err != nil {
+		return ctx, err
+	}
+	return s.authorizeKnowledgeActorWrite(fresh, &actual)
+}
+
+// authorizeOriginalKnowledgeProducerWrite is confined to derived producer
+// commits. The exact private Nextcloud lease and persisted original admission
+// authorize only this worker's generation; public readers never call it.
+func (s *KnowledgeInputProvenanceStore) authorizeOriginalKnowledgeProducerWrite(ctx context.Context, kb *types.KnowledgeBase, original *types.KnowledgeBuildInputProof) (context.Context, error) {
+	if kb == nil || original == nil || original.TenantID != kb.TenantID || original.KnowledgeBaseID != kb.ID {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	if !NextcloudBuildLeasePresent(ctx, original.TenantID, original.KnowledgeBaseID, original.KnowledgeID) {
+		return s.AuthorizeCurrentKnowledgeInputWrite(ctx, kb)
+	}
+	bound := KnowledgeBuildInputProofFromContext(ctx)
+	if bound == nil || bound.AdmissionID != original.AdmissionID || bound.InputDigest != original.InputDigest || bound.BuildGeneration != original.BuildGeneration || bound.KnowledgeID != original.KnowledgeID || bound.TenantID != original.TenantID || bound.KnowledgeBaseID != original.KnowledgeBaseID {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	if err := ValidateNextcloudBuildWrite(ctx, s.db, original.TenantID, original.KnowledgeBaseID, original.KnowledgeID); err != nil {
+		return ctx, err
+	}
+	var k types.Knowledge
+	if err := s.db.WithContext(ctx).Where("id = ? AND tenant_id = ? AND knowledge_base_id = ?", original.KnowledgeID, original.TenantID, original.KnowledgeBaseID).Take(&k).Error; err != nil {
+		return ctx, err
+	}
+	admission, _, _, err := s.admissionInTx(s.db.WithContext(ctx), &k, original)
+	if err != nil {
+		return ctx, err
+	}
+	if admission.OriginKind != "nextcloud" {
+		return ctx, ErrKnowledgeInputChanged
+	}
+	if err := s.recheckKnowledgeWorkerActor(ctx, original); err != nil {
+		return ctx, err
+	}
+	return ctx, nil
+}
+
+func (s *KnowledgeInputProvenanceStore) authorizeKnowledgeActorWrite(ctx context.Context, kb *types.KnowledgeBase) (context.Context, error) {
+	caller := types.CallerFromContext(ctx)
+	if scope, ok := types.TenantAPIKeyScopeFromContext(ctx); ok {
+		if requirement, bound := types.APIKeyOperationRequirementFromContext(ctx); bound && !requirement.Allows(scope) {
+			return ctx, access.ErrForbidden
+		}
+		if !scope.FullAccess && !scope.HasCapability(types.APIKeyCapabilityIngest) {
+			return ctx, access.ErrForbidden
+		}
+	} else if !caller.Role.HasPermission(types.TenantRoleContributor) {
+		return ctx, access.ErrForbidden
+	}
+	var shares access.KBShareLookup
+	if caller.UserID != "" {
+		shares = s.actorShares
+	}
+	grant, err := access.ResolveKB(ctx, access.KBRequest{Caller: caller}, kb, types.OrgRoleEditor, shares, nil)
+	if err != nil {
+		return ctx, err
+	}
+	if s.actorGroups == nil {
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	permission, err := s.actorGroups.EffectivePermission(ctx, kb.TenantID, types.GroupResourceTypeKnowledgeBase, kb.ID, types.ResourceActionEdit, time.Now().UTC())
+	if err != nil {
+		return ctx, err
+	}
+	if !permission.Allowed {
+		return ctx, access.ErrForbidden
+	}
+	fresh := grant.Context(ctx)
+	if err := access.RequireKBWrite(fresh, kb); err != nil {
+		return ctx, err
+	}
+	if _, machine := types.TenantAPIKeyScopeFromContext(fresh); machine {
+		if _, routeBound := types.APIKeyOperationRequirementFromContext(fresh); !routeBound {
+			// This current, exact KB write has already been authorized. Its
+			// worker may inspect the original admitted inputs to complete the
+			// write. An HTTP request keeps its exact route capability policy.
+			fresh = types.WithAPIKeyOperationRequirement(fresh, types.APIKeyOperationRequirement{RequireFullAccess: true, Capabilities: []types.APIKeyCapability{types.APIKeyCapabilityIngest}})
+		}
+	}
+	return fresh, nil
+}
+
+func (s *KnowledgeInputProvenanceStore) restoreCurrentKnowledgeActor(ctx context.Context, actor knowledgeBuildActorSelector, executionTenant uint64) (context.Context, error) {
+	principal := types.Principal{Type: actor.PrincipalType, ID: actor.PrincipalID}
+	caller := types.Caller{TenantID: actor.CallerTenantID, UserID: actor.UserID, Role: types.TenantRoleViewer}
+	// Drop any cached request/task grants. They are not reconstructed authority.
+	ctx = context.WithValue(ctx, types.KBGrantsContextKey, nil)
+	ctx = context.WithValue(ctx, types.TenantAPIKeyScopeContextKey, nil)
+	ctx = context.WithValue(ctx, types.UserIDContextKey, "")
+	ctx = context.WithValue(ctx, types.UserContextKey, nil)
+	ctx = context.WithValue(ctx, types.SystemAdminContextKey, false)
+	ctx = context.WithValue(ctx, types.TenantRoleContextKey, types.TenantRoleViewer)
+	switch actor.PrincipalType {
+	case types.PrincipalWebUser:
+		if actor.UserID == "" || actor.PrincipalID != actor.UserID || actor.APIKeyID != nil {
+			return ctx, ErrKnowledgeInputChanged
+		}
+		var user types.User
+		if err := s.db.WithContext(ctx).Where("id = ? AND is_active = ?", actor.UserID, true).Take(&user).Error; err != nil {
+			return ctx, err
+		}
+		if s.actorGroups != nil {
+			effective, err := s.actorGroups.EffectiveTenantRole(ctx, user.ID, actor.CallerTenantID, time.Now().UTC())
+			if err != nil {
+				return ctx, err
+			}
+			if !effective.Member || !effective.Role.IsValid() {
+				return ctx, ErrKnowledgeInputChanged
+			}
+			caller.Role = effective.Role
+		} else {
+			var member types.TenantMember
+			if err := s.db.WithContext(ctx).Where("user_id = ? AND tenant_id = ? AND status = ?", user.ID, actor.CallerTenantID, types.TenantMemberStatusActive).Take(&member).Error; err != nil {
+				return ctx, err
+			}
+			if !member.Role.IsValid() {
+				return ctx, ErrKnowledgeInputChanged
+			}
+			caller.Role = member.Role
+		}
+		ctx = context.WithValue(ctx, types.UserIDContextKey, user.ID)
+	case types.PrincipalAPITenant, types.PrincipalAPIExternalUser:
+		if actor.APIKeyID == nil || actor.UserID != "" {
+			return ctx, ErrKnowledgeInputChanged
+		}
+		var key types.TenantAPIKey
+		if err := s.db.WithContext(ctx).Where("id = ? AND tenant_id = ? AND revoked_at IS NULL", *actor.APIKeyID, actor.CallerTenantID).Take(&key).Error; err != nil {
+			return ctx, err
+		}
+		if key.IsPlatform() || key.ExpiresAt != nil && !key.ExpiresAt.After(time.Now().UTC()) {
+			return ctx, ErrKnowledgeInputChanged
+		}
+		if actor.PrincipalType == types.PrincipalAPITenant && actor.PrincipalID != fmt.Sprintf("%d", actor.CallerTenantID) {
+			return ctx, ErrKnowledgeInputChanged
+		}
+		if actor.PrincipalType == types.PrincipalAPIExternalUser {
+			prefix := fmt.Sprintf("%d:", actor.CallerTenantID)
+			if !strings.HasPrefix(actor.PrincipalID, prefix) || strings.TrimSpace(strings.TrimPrefix(actor.PrincipalID, prefix)) == "" {
+				return ctx, ErrKnowledgeInputChanged
+			}
+		}
+		scope := types.TenantAPIKeyScope{KeyID: key.ID, Name: key.Name, ScopeType: key.ScopeType, FullAccess: key.FullAccess, KnowledgeBaseIDs: key.KnowledgeBaseIDs, Capabilities: key.Capabilities}
+		ctx = types.WithTenantAPIKeyScope(ctx, scope)
+		// Match the authenticated machine boundary: FullAccess is a current DB
+		// credential capability, rather than an invented workspace-owner user.
+		if key.FullAccess {
+			caller.Role = types.TenantRoleOwner
+		}
+	default:
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	ctx = types.WithCaller(ctx, caller)
+	ctx = types.WithPrincipal(ctx, principal)
+	ctx = context.WithValue(ctx, types.TenantRoleContextKey, caller.Role)
+	ctx = types.WithExecutionTenant(ctx, executionTenant)
+	return ctx, nil
+}
+
+var _ interface {
+	RestoreKnowledgeBuildActor(context.Context, *types.KnowledgeBuildInputProof) (context.Context, error)
+} = (*KnowledgeInputProvenanceStore)(nil)
diff --git a/internal/application/repository/knowledge_collection_auxiliary.go b/internal/application/repository/knowledge_collection_auxiliary.go
new file mode 100644
index 0000000000000000000000000000000000000000..36cf084fa34a22fe4515663863d560cf30368d55
--- /dev/null
+++ b/internal/application/repository/knowledge_collection_auxiliary.go
@@ -0,0 +1,197 @@
+package repository
+
+import (
+	"reflect"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+// These helpers deliberately use their caller's RR/SQLite transaction. Each
+// producer keeps its own original bounded lineage; the collection authorizer
+// checks current caller/source permission for every proof separately.
+func captureKnowledgeCollectionAuxiliary(tx *gorm.DB, scopes []types.KnowledgeSearchScope, candidates []*types.Knowledge) (*types.KnowledgeCollectionAuxiliary, error) {
+	return captureKnowledgeCollectionAuxiliaryWithNames(tx, scopes, candidates, nil)
+}
+
+// A nil name selector is the complete collection path. Explicit-ID metadata
+// uses a non-nil selector to verify only KB display names it actually consumed.
+func captureKnowledgeCollectionAuxiliaryWithNames(tx *gorm.DB, scopes []types.KnowledgeSearchScope, candidates []*types.Knowledge, consumeNames map[string]bool) (*types.KnowledgeCollectionAuxiliary, error) {
+	aux := &types.KnowledgeCollectionAuxiliary{Proofs: []*types.KnowledgeCollectionAuxiliaryProof{}, KnowledgeBaseNames: map[string]string{}, Tags: map[string][]*types.KnowledgeTag{}, Relations: []*types.KnowledgeTagRelation{}}
+	allowed := map[string]uint64{}
+	kbIDs := []string{}
+	for _, scope := range scopes {
+		if previous, ok := allowed[scope.KBID]; ok {
+			if previous != scope.TenantID {
+				return nil, ErrKnowledgeInputChanged
+			}
+			continue
+		}
+		allowed[scope.KBID] = scope.TenantID
+		kbIDs = append(kbIDs, scope.KBID)
+	}
+	knowledgeIDs := []string{}
+	for _, k := range candidates {
+		if k == nil || allowed[k.KnowledgeBaseID] != k.TenantID {
+			return nil, ErrKnowledgeInputChanged
+		}
+		knowledgeIDs = append(knowledgeIDs, k.ID)
+	}
+	allRelations := []*types.KnowledgeTagRelation{}
+	for first := 0; first < len(knowledgeIDs); first += 500 {
+		end := min(first+500, len(knowledgeIDs))
+		var rows []*types.KnowledgeTagRelation
+		if err := tx.Where("knowledge_id IN ?", knowledgeIDs[first:end]).Order("knowledge_id ASC,tag_id ASC").Find(&rows).Error; err != nil {
+			return nil, err
+		}
+		allRelations = append(allRelations, rows...)
+	}
+	byKnowledge := map[string][]*types.KnowledgeTagRelation{}
+	tagIDs := []string{}
+	unique := map[string]bool{}
+	for _, relation := range allRelations {
+		byKnowledge[relation.KnowledgeID] = append(byKnowledge[relation.KnowledgeID], relation)
+		if !unique[relation.TagID] {
+			unique[relation.TagID] = true
+			tagIDs = append(tagIDs, relation.TagID)
+		}
+	}
+	tagsByID := map[string]*types.KnowledgeTag{}
+	for first := 0; first < len(tagIDs); first += 500 {
+		end := min(first+500, len(tagIDs))
+		var rows []*types.KnowledgeTag
+		if err := tx.Where("id IN ?", tagIDs[first:end]).Find(&rows).Error; err != nil {
+			return nil, err
+		}
+		for _, tag := range rows {
+			tagsByID[tag.ID] = tag
+		}
+	}
+	cachedTx, err := cacheKnowledgeDisplayInputs(tx, append(append(kbIDs, knowledgeIDs...), tagIDs...))
+	if err != nil {
+		return nil, err
+	}
+	tx = cachedTx
+	var kbs []*types.KnowledgeBase
+	for first := 0; first < len(kbIDs); first += 500 {
+		end := min(first+500, len(kbIDs))
+		var rows []*types.KnowledgeBase
+		if err := tx.Where("id IN ?", kbIDs[first:end]).Find(&rows).Error; err != nil {
+			return nil, err
+		}
+		kbs = append(kbs, rows...)
+	}
+	if len(kbs) != len(allowed) {
+		return nil, ErrKnowledgeInputChanged
+	}
+	for _, kb := range kbs {
+		if allowed[kb.ID] != kb.TenantID {
+			return nil, ErrKnowledgeInputChanged
+		}
+		if consumeNames != nil && !consumeNames[kb.ID] {
+			continue
+		}
+		proof, err := readKnowledgeDisplayOrigin(tx, "kb-name", kb.ID, kb.TenantID, kb.ID, kb.Name)
+		if err != nil {
+			return nil, err
+		}
+		aux.KnowledgeBaseNames[kb.ID] = kb.Name
+		aux.Proofs = append(aux.Proofs, proof)
+	}
+	seenTags := map[string]bool{}
+	for _, k := range candidates {
+		if k == nil || allowed[k.KnowledgeBaseID] != k.TenantID {
+			return nil, ErrKnowledgeInputChanged
+		}
+		relations := byKnowledge[k.ID]
+		ids := make([]string, 0, len(relations))
+		for _, relation := range relations {
+			ids = append(ids, relation.TagID)
+		}
+		revision, err := knowledgeDisplayRevision(tx, "relations", k.ID)
+		if err != nil {
+			return nil, err
+		}
+		var membership *types.KnowledgeCollectionAuxiliaryProof
+		if len(relations) > 0 {
+			membership, err = readKnowledgeDisplayOrigin(tx, "relations", k.ID, k.TenantID, k.KnowledgeBaseID, ids)
+			if err != nil {
+				return nil, err
+			}
+		} else {
+			// An absent relation contains no source-bearing display value. Its
+			// monotonic version still binds membership, including add/delete ABA.
+			lineage, _ := types.NewCompleteSourceLineage()
+			digest, err := KnowledgeInputDigest(knowledgeDisplayBody("relations", k.ID, k.TenantID, k.KnowledgeBaseID, ids))
+			if err != nil {
+				return nil, err
+			}
+			membership = &types.KnowledgeCollectionAuxiliaryProof{Kind: "relations", ID: k.ID, TenantID: k.TenantID, KnowledgeBaseID: k.KnowledgeBaseID, Revision: revision, Digest: digest, SourceLineage: lineage}
+		}
+		aux.Proofs = append(aux.Proofs, membership)
+		aux.Tags[k.ID] = []*types.KnowledgeTag{}
+		for _, relation := range relations {
+			stored := tagsByID[relation.TagID]
+			if stored == nil || stored.TenantID != k.TenantID || stored.KnowledgeBaseID != k.KnowledgeBaseID {
+				return nil, ErrKnowledgeInputChanged
+			}
+			tag := *stored
+			aux.Tags[k.ID] = append(aux.Tags[k.ID], &tag)
+			aux.Relations = append(aux.Relations, relation)
+			if seenTags[tag.ID] {
+				continue
+			}
+			seenTags[tag.ID] = true
+			for _, field := range []string{"name", "color", "sort_order"} {
+				proof, err := readKnowledgeDisplayOrigin(tx, "tag-"+field, tag.ID, tag.TenantID, tag.KnowledgeBaseID, tagDisplayFieldValue(&tag, field))
+				if err != nil {
+					return nil, err
+				}
+				aux.Proofs = append(aux.Proofs, proof)
+			}
+			// The structural row envelope has no additional text producer. Its
+			// name/color/order origins are the separate proofs above, each checked
+			// independently so unrelated producers never hit a collection union cap.
+			lineage, _ := types.NewCompleteSourceLineage()
+			envelopeRevision, err := knowledgeDisplayRevision(tx, "tag-envelope", tag.ID)
+			if err != nil {
+				return nil, err
+			}
+			digest, err := KnowledgeInputDigest(&tag)
+			if err != nil {
+				return nil, err
+			}
+			aux.Proofs = append(aux.Proofs, &types.KnowledgeCollectionAuxiliaryProof{Kind: "tag-envelope", ID: tag.ID, TenantID: tag.TenantID, KnowledgeBaseID: tag.KnowledgeBaseID, Revision: envelopeRevision, Digest: digest, SourceLineage: lineage})
+		}
+	}
+	sort.Slice(aux.Proofs, func(i, j int) bool {
+		a, b := aux.Proofs[i], aux.Proofs[j]
+		if a.Kind != b.Kind {
+			return a.Kind < b.Kind
+		}
+		return a.ID < b.ID
+	})
+	sort.Slice(aux.Relations, func(i, j int) bool {
+		a, b := aux.Relations[i], aux.Relations[j]
+		if a.KnowledgeID != b.KnowledgeID {
+			return a.KnowledgeID < b.KnowledgeID
+		}
+		return a.TagID < b.TagID
+	})
+	return aux, nil
+}
+
+func recheckKnowledgeCollectionAuxiliary(tx *gorm.DB, scopes []types.KnowledgeSearchScope, candidates []*types.Knowledge, expected *types.KnowledgeCollectionAuxiliary) error {
+	if expected == nil {
+		return types.ErrSourceLineageUnknown
+	}
+	actual, err := captureKnowledgeCollectionAuxiliary(tx, scopes, candidates)
+	if err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(actual, expected) {
+		return ErrKnowledgeInputChanged
+	}
+	return nil
+}
diff --git a/internal/application/repository/knowledge_collection_output.go b/internal/application/repository/knowledge_collection_output.go
new file mode 100644
index 0000000000000000000000000000000000000000..485ba38905f4bca0e979b3ad3397840277626240
--- /dev/null
+++ b/internal/application/repository/knowledge_collection_output.go
@@ -0,0 +1,351 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sort"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// collectionTransaction supplies a single coherent database view for every
+// candidate, original producer receipt, control checkpoint and selection.
+func (s *KnowledgeInputProvenanceStore) collectionTransaction(ctx context.Context, fn func(*gorm.DB) error) error {
+	if ctx == nil || s == nil || s.db == nil {
+		return types.ErrSourceLineageUnknown
+	}
+	options := &sql.TxOptions{ReadOnly: true}
+	switch s.db.Dialector.Name() {
+	case "postgres":
+		options.Isolation = sql.LevelRepeatableRead
+	case "sqlite":
+	default:
+		return ErrKnowledgeInputChanged
+	}
+	if _, nested := s.db.Statement.ConnPool.(gorm.TxCommitter); nested {
+		return ErrKnowledgeInputChanged
+	}
+	return s.db.WithContext(ctx).Transaction(fn, options)
+}
+
+func collectionScopes(request types.KnowledgeCollectionReadRequest) ([]types.KnowledgeSearchScope, error) {
+	out := append([]types.KnowledgeSearchScope{}, request.Scopes...)
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].TenantID != out[j].TenantID {
+			return out[i].TenantID < out[j].TenantID
+		}
+		return out[i].KBID < out[j].KBID
+	})
+	for i, scope := range out {
+		if scope.TenantID == 0 || scope.KBID == "" || i > 0 && scope == out[i-1] {
+			return nil, types.ErrSourceLineageUnknown
+		}
+	}
+	return out, nil
+}
+
+func collectionRevision(tx *gorm.DB, scope types.KnowledgeSearchScope) (uint64, error) {
+	var row struct{ Revision uint64 }
+	if err := tx.Table("knowledge_collection_scope_versions").Where("tenant_id = ? AND knowledge_base_id = ?", scope.TenantID, scope.KBID).Take(&row).Error; err != nil {
+		return 0, err
+	}
+	if row.Revision == 0 {
+		return 0, ErrKnowledgeInputChanged
+	}
+	return row.Revision, nil
+}
+
+func collectionProof(tx *gorm.DB, k *types.Knowledge, a *knowledgeInputAdmission, lineage *types.SourceLineage) (*types.KnowledgeBuildInputProof, error) {
+	digest, err := knowledgeMaterialDigest(k)
+	if err != nil {
+		return nil, err
+	}
+	revision, err := inputRowRevision(tx, "knowledge", k.ID)
+	if err != nil {
+		return nil, err
+	}
+	body, err := KnowledgeInputDigest([]string{a.AdmissionID, a.RootDigest, a.ConfigDigest, digest, fmt.Sprint(revision)})
+	if err != nil {
+		return nil, err
+	}
+	return &types.KnowledgeBuildInputProof{Version: 1, TenantID: k.TenantID, KnowledgeBaseID: k.KnowledgeBaseID, KnowledgeID: k.ID, AdmissionID: a.AdmissionID, BuildGeneration: a.BuildGeneration, InputDigest: a.InputDigest, ConfigDigest: a.ConfigDigest, BodyDigest: body, ChunkIDs: []string{}, SourceLineage: lineage}, nil
+}
+
+// No caller-provided predicate is evaluated here. All candidate bodies start
+// from their persisted original admission, including candidates that will not
+// be displayed and documents excluded by the subsequent operational filters.
+func (s *KnowledgeInputProvenanceStore) CaptureKnowledgeCollectionInputs(ctx context.Context, request types.KnowledgeCollectionReadRequest) (*types.KnowledgeCollectionInputSnapshot, error) {
+	scopes, err := collectionScopes(request)
+	if err != nil {
+		return nil, err
+	}
+	result := &types.KnowledgeCollectionInputSnapshot{Scopes: []types.KnowledgeCollectionScopeCheckpoint{}, Candidates: []*types.KnowledgeCollectionCandidate{}}
+	err = s.collectionTransaction(ctx, func(tx *gorm.DB) error {
+		if err := s.checkFAQImportReadSetPlanInTx(tx); err != nil {
+			return err
+		}
+		var candidates []*types.Knowledge
+		for _, scope := range scopes {
+			var kb types.KnowledgeBase
+			if err := tx.Where("id = ? AND tenant_id = ?", scope.KBID, scope.TenantID).Take(&kb).Error; err != nil {
+				return err
+			}
+			configLineage, err := readKnowledgeConfigurationOrigin(tx, &kb)
+			if err != nil {
+				return err
+			}
+			configRevision, err := knowledgeConfigurationControlRevision(tx, kb.ID)
+			if err != nil {
+				return err
+			}
+			configDigest, err := knowledgeConfigurationOriginDigest(&kb)
+			if err != nil {
+				return err
+			}
+			revision, err := collectionRevision(tx, scope)
+			if err != nil {
+				return err
+			}
+			result.Scopes = append(result.Scopes, types.KnowledgeCollectionScopeCheckpoint{Scope: scope, Revision: revision, ConfigurationRevision: configRevision, ConfigurationDigest: configDigest, ConfigurationLineage: configLineage})
+			// Batches bound SQL result hydration without imposing a permanent KB
+			// size ceiling. They all share this transaction's original snapshot.
+			last := ""
+			for {
+				var rows []*types.Knowledge
+				q := tx.Where("tenant_id = ? AND knowledge_base_id = ?", scope.TenantID, scope.KBID)
+				if last != "" {
+					q = q.Where("id > ?", last)
+				}
+				if err := q.Order("id ASC").Limit(256).Find(&rows).Error; err != nil {
+					return err
+				}
+				for _, k := range rows {
+					a, _, lineage, err := s.admissionInTx(tx, k, nil)
+					if err != nil {
+						return err
+					}
+					proof, err := collectionProof(tx, k, a, lineage)
+					if err != nil {
+						return err
+					}
+					result.Candidates = append(result.Candidates, &types.KnowledgeCollectionCandidate{Knowledge: k, Proof: proof})
+					candidates = append(candidates, k)
+				}
+				if len(rows) < 256 {
+					break
+				}
+				last = rows[len(rows)-1].ID
+			}
+		}
+		var err error
+		result.Auxiliary, err = captureKnowledgeCollectionAuxiliary(tx, scopes, candidates)
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func (s *KnowledgeInputProvenanceStore) recheckCollectionInTx(tx *gorm.DB, snapshot *types.KnowledgeCollectionInputSnapshot) error {
+	if snapshot == nil {
+		return types.ErrSourceLineageUnknown
+	}
+	var scopes []types.KnowledgeSearchScope
+	var candidates []*types.Knowledge
+	index := 0
+	for _, checkpoint := range snapshot.Scopes {
+		scope := checkpoint.Scope
+		scopes = append(scopes, scope)
+		revision, err := collectionRevision(tx, scope)
+		if err != nil {
+			return err
+		}
+		if revision != checkpoint.Revision {
+			return ErrKnowledgeInputChanged
+		}
+		var kb types.KnowledgeBase
+		if err := tx.Where("id = ? AND tenant_id = ?", scope.KBID, scope.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		lineage, err := readKnowledgeConfigurationOrigin(tx, &kb)
+		if err != nil {
+			return err
+		}
+		configRevision, err := knowledgeConfigurationControlRevision(tx, kb.ID)
+		if err != nil {
+			return err
+		}
+		configDigest, err := knowledgeConfigurationOriginDigest(&kb)
+		if err != nil {
+			return err
+		}
+		if configRevision != checkpoint.ConfigurationRevision || configDigest != checkpoint.ConfigurationDigest || !reflect.DeepEqual(lineage, checkpoint.ConfigurationLineage) {
+			return ErrKnowledgeInputChanged
+		}
+		last := ""
+		for {
+			var rows []*types.Knowledge
+			q := tx.Where("tenant_id = ? AND knowledge_base_id = ?", scope.TenantID, scope.KBID)
+			if last != "" {
+				q = q.Where("id > ?", last)
+			}
+			if err := q.Order("id ASC").Limit(256).Find(&rows).Error; err != nil {
+				return err
+			}
+			for _, current := range rows {
+				if index >= len(snapshot.Candidates) {
+					return ErrKnowledgeInputChanged
+				}
+				entry := snapshot.Candidates[index]
+				index++
+				if entry == nil || entry.Knowledge == nil || entry.Proof == nil || entry.Proof.Projection != "" || len(entry.Proof.ChunkIDs) != 0 {
+					return types.ErrSourceLineageUnknown
+				}
+				old, err := json.Marshal(entry.Knowledge)
+				if err != nil {
+					return err
+				}
+				body, err := json.Marshal(current)
+				if err != nil {
+					return err
+				}
+				if string(old) != string(body) {
+					return ErrKnowledgeInputChanged
+				}
+				a, _, lineage, err := s.admissionInTx(tx, current, entry.Proof)
+				if err != nil {
+					return err
+				}
+				proof, err := collectionProof(tx, current, a, lineage)
+				if err != nil {
+					return err
+				}
+				if !reflect.DeepEqual(proof, entry.Proof) {
+					return ErrKnowledgeInputChanged
+				}
+				candidates = append(candidates, current)
+			}
+			if len(rows) < 256 {
+				break
+			}
+			last = rows[len(rows)-1].ID
+		}
+	}
+	if index != len(snapshot.Candidates) {
+		return ErrKnowledgeInputChanged
+	}
+	if _, err := collectionScopes(types.KnowledgeCollectionReadRequest{Scopes: scopes}); err != nil {
+		return err
+	}
+	return recheckKnowledgeCollectionAuxiliary(tx, scopes, candidates, snapshot.Auxiliary)
+}
+
+func (s *KnowledgeInputProvenanceStore) selectCollectionInTx(ctx context.Context, tx *gorm.DB, snapshot *types.KnowledgeCollectionInputSnapshot, request types.KnowledgeCollectionSelectionRequest) (*types.KnowledgeCollectionSelection, error) {
+	result := &types.KnowledgeCollectionSelection{Request: request, Knowledge: []*types.Knowledge{}}
+	repo := &knowledgeRepository{db: tx}
+	var err error
+	switch request.Mode {
+	case "list":
+		if len(snapshot.Scopes) != 1 {
+			return nil, types.ErrSourceLineageUnknown
+		}
+		scope := snapshot.Scopes[0].Scope
+		result.Knowledge, result.Total, err = repo.ListPagedKnowledgeByKnowledgeBaseID(ctx, scope.TenantID, scope.KBID, &request.Page, request.Filter)
+		result.Page, result.PageSize = request.Page.GetPage(), request.Page.Limit()
+	case "folders":
+		if len(snapshot.Scopes) != 1 {
+			return nil, types.ErrSourceLineageUnknown
+		}
+		scope := snapshot.Scopes[0].Scope
+		var counts []*types.KnowledgeFolderCount
+		counts, err = repo.ListKnowledgeFolderCounts(ctx, scope.TenantID, scope.KBID)
+		result.Folders = types.BuildKnowledgeFolderTree(counts)
+	case "search":
+		var scopes []types.KnowledgeSearchScope
+		for _, checkpoint := range snapshot.Scopes {
+			scopes = append(scopes, checkpoint.Scope)
+		}
+		result.Knowledge, result.HasMore, result.Total, err = repo.SearchKnowledgeInScopes(ctx, scopes, request.Keyword, request.Offset, request.Limit, request.FileTypes)
+	default:
+		return nil, types.ErrSourceLineageUnknown
+	}
+	if err != nil {
+		return nil, err
+	}
+	for _, k := range result.Knowledge {
+		// Display producers are separately bound to their original receipts.
+		k.KnowledgeBaseName = ""
+		// These asynchronous diagnostic producers do not have original material
+		// receipts. Their strings must not ride a document's admission.
+		k.ErrorMessage = ""
+		if k.Type == types.KnowledgeTypeFAQ && len(k.LastFAQImportResult) > 0 && string(k.LastFAQImportResult) != "null" {
+			proof, readErr := s.captureFAQImportOutputInTx(tx, types.FAQImportOutputReadRequest{TenantID: k.TenantID, KnowledgeBaseID: k.KnowledgeBaseID, KnowledgeID: k.ID, Kind: "result"})
+			if readErr != nil {
+				return nil, readErr
+			}
+			result.FAQImportResults = append(result.FAQImportResults, proof)
+		} else {
+			k.LastFAQImportResult = nil
+		}
+		if snapshot.Auxiliary != nil {
+			if request.Mode == "search" {
+				k.KnowledgeBaseName = snapshot.Auxiliary.KnowledgeBaseNames[k.KnowledgeBaseID]
+			}
+			if request.Mode == "list" {
+				k.Tags = snapshot.Auxiliary.Tags[k.ID]
+			}
+		}
+	}
+	return result, nil
+}
+
+// Select is called only after the request's original candidates have passed
+// live authorization. Filtering, total, has_more and folder aggregation run in
+// the same local snapshot as the complete membership/material recheck.
+func (s *KnowledgeInputProvenanceStore) SelectKnowledgeCollectionInputs(ctx context.Context, snapshot *types.KnowledgeCollectionInputSnapshot, request types.KnowledgeCollectionSelectionRequest) (*types.KnowledgeCollectionSelection, error) {
+	var result *types.KnowledgeCollectionSelection
+	err := s.collectionTransaction(ctx, func(tx *gorm.DB) error {
+		if err := s.recheckCollectionInTx(tx, snapshot); err != nil {
+			return err
+		}
+		var err error
+		result, err = s.selectCollectionInTx(ctx, tx, snapshot, request)
+		return err
+	})
+	return result, err
+}
+
+func (s *KnowledgeInputProvenanceStore) RecheckKnowledgeCollectionInputs(ctx context.Context, snapshot *types.KnowledgeCollectionInputSnapshot, selection *types.KnowledgeCollectionSelection) error {
+	return s.collectionTransaction(ctx, func(tx *gorm.DB) error {
+		if err := s.recheckCollectionInTx(tx, snapshot); err != nil {
+			return err
+		}
+		if selection == nil {
+			return nil
+		}
+		current, err := s.selectCollectionInTx(ctx, tx, snapshot, selection.Request)
+		if err != nil {
+			return err
+		}
+		expected, err := json.Marshal(selection)
+		if err != nil {
+			return err
+		}
+		actual, err := json.Marshal(current)
+		if err != nil {
+			return err
+		}
+		if string(expected) != string(actual) {
+			return ErrKnowledgeInputChanged
+		}
+		return nil
+	})
+}
+
+var _ interfaces.KnowledgeCollectionInputReader = (*KnowledgeInputProvenanceStore)(nil)
