index 0000000000000000000000000000000000000000..5bae510a14d99a6ba63c15eff8e7814c9302c028
--- /dev/null
+++ b/cmd/publication-recovery/main_test.go
@@ -0,0 +1,38 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRecoveryPrivateInputAndExclusiveReceipt(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0700))
+	key := filepath.Join(dir, "key")
+	require.NoError(t, os.WriteFile(key, []byte("operator evidence"), 0600))
+	b, e := privateFile(key)
+	require.NoError(t, e)
+	require.Equal(t, "operator evidence", string(b))
+	link := filepath.Join(dir, "alias")
+	require.NoError(t, os.Symlink(key, link))
+	_, e = privateFile(link)
+	require.Error(t, e)
+	require.NoError(t, os.Chmod(key, 0644))
+	_, e = privateFile(key)
+	require.Error(t, e)
+	require.NoError(t, os.Chmod(key, 0600))
+	hard := filepath.Join(dir, "hardlink")
+	require.NoError(t, os.Link(key, hard))
+	_, e = privateFile(key)
+	require.Error(t, e)
+	require.NoError(t, os.Remove(hard))
+	output := filepath.Join(dir, "receipt")
+	require.NoError(t, writePrivate(output, []byte("receipt")))
+	require.Error(t, writePrivate(output, []byte("replacement")))
+	b, e = privateFile(output)
+	require.NoError(t, e)
+	require.Equal(t, "receipt", string(b))
+}
