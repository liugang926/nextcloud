+			require.NoError(t, db.Create(&types.User{ID: "body-admin", TenantID: 7, Username: "body-admin", Email: "body@example.test", IsActive: true}).Error)
+			require.NoError(t, db.Create(&types.TenantMember{TenantID: 7, UserID: "body-admin", Role: types.TenantRoleAdmin, Status: types.TenantMemberStatusActive}).Error)
+			factory := func(tx *gorm.DB) *KnowledgeInputProvenanceStore {
+				actor := NewKnowledgeInputProvenanceStore(tx)
+				ConfigureKnowledgeInputActorGroupAccess(actor, displayTestGroups{db: tx})
