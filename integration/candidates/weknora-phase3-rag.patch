+func (q *nextcloudUncertainTestQueue) Enqueue(_ *asynq.Task, opts ...asynq.Option) (*asynq.TaskInfo, error) {
+	for _, opt := range opts {
+		if opt.Type() == asynq.TaskIDOpt {
