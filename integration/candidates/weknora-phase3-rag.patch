+func TestTagOutputPostgresWholeSetABA(t *testing.T) { runTagOutputABA(t, true) }
+func runTagCommittedFields(t *testing.T, pg bool) {
+	store, db, ctx, tags, _, _ := displayTestFixture(t, pg)
+	marked := WithTagCommittedOutput(ctx)
