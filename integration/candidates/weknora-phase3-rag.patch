+type NextcloudCapacityWriteIntent struct {
+	Token                                                             string `gorm:"primaryKey"`
+	KnowledgeID, WriterID, PhysicalPath, RootIdentity, ScopeID, State string
+	ObservedBytes                                                     int64
+	SHA256                                                            string `gorm:"column:sha256"`
