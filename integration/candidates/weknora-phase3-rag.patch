+	find := func() error {
+		_, err := lookup.FindPublished(context.Background(), "instance", "binding", 77, "etag-1")
+		return err
+	}
+	require.ErrorIs(t, find(), ErrNextcloudAskTargetNotFound)
+	chunk := &types.Chunk{ID: "chunk-77", TenantID: 7, KnowledgeBaseID: "kb",
