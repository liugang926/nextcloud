+	require.NoError(t, db.QueryRow(lineageMigrationQuery(dialect, `SELECT count(*)
+		FROM nextcloud_source_tombstones WHERE tenant_id = ? AND scope_type = ? AND scope_id = ?`), tenant, scope, id).Scan(&count))
