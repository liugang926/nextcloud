diff --git a/internal/application/service/file/local_gc_path_replacement_test.go b/internal/application/service/file/local_gc_path_replacement_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f0529247e448e8e4fe465e4fc1fc10bc77789b4
--- /dev/null
+++ b/internal/application/service/file/local_gc_path_replacement_test.go
@@ -0,0 +1,124 @@
+//go:build linux || darwin
+
+package file
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalGCReplacementIsMovedAndRestoredWithoutUnlink(t *testing.T) {
+	base := t.TempDir()
+	s := &localFileService{baseDir: base}
+	path := filepath.Join(base, "7", "old", "1790000000000000000.txt")
+	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0700))
+	require.NoError(t, os.WriteFile(path, []byte("old source"), 0600))
+	root, _, _, e := s.capacityRoot()
+	require.NoError(t, e)
+	defer unix.Close(root)
+	parent, e := unix.Open(filepath.Dir(path), unix.O_RDONLY|unix.O_DIRECTORY, 0)
+	require.NoError(t, e)
+	defer unix.Close(parent)
+	var original unix.Stat_t
+	require.NoError(t, unix.Fstatat(parent, filepath.Base(path), &original, unix.AT_SYMLINK_NOFOLLOW))
+	replacement := path + ".new"
+	require.NoError(t, os.WriteFile(replacement, []byte("current replacement survives"), 0600))
+	require.NoError(t, os.Rename(replacement, path))
+	unlinked, e := gcQuarantineUnlink(context.Background(), root, parent, filepath.Base(path), "local://7/old/1790000000000000000.txt", original)
+	require.Error(t, e)
+	require.False(t, unlinked)
+	bytes, e := os.ReadFile(path)
+	require.NoError(t, e)
+	require.Equal(t, []byte("current replacement survives"), bytes)
+}
+func TestLocalGCPathFenceCoversLegacyActualWriter(t *testing.T) {
+	base := t.TempDir()
+	s := &localFileService{baseDir: base}
+	path := filepath.Join(base, "7", "old", "1790000000000000000.txt")
+	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0700))
+	require.NoError(t, os.WriteFile(path, []byte("held original"), 0600))
+	fence, e := s.physicalPathFence(path)
+	require.NoError(t, e)
+	unlinked, e := s.DeleteNextcloudObject(context.Background(), "local://7/old/1790000000000000000.txt")
+	require.Error(t, e)
+	require.False(t, unlinked)
+	require.NoError(t, fence.Close())
+	unlinked, e = s.DeleteNextcloudObject(context.Background(), "local://7/old/1790000000000000000.txt")
+	require.NoError(t, e)
+	require.True(t, unlinked)
+	_, e = os.Stat(path)
+	require.ErrorIs(t, e, os.ErrNotExist)
+}
+func TestLocalGCHoldingReceiptResumesExactInode(t *testing.T) {
+	base := t.TempDir()
+	s := &localFileService{baseDir: base}
+	path := filepath.Join(base, "7", "old", "legacy.txt")
+	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0700))
+	require.NoError(t, os.WriteFile(path, []byte("held bytes"), 0600))
+	root, _, _, e := s.capacityRoot()
+	require.NoError(t, e)
+	defer unix.Close(root)
+	parent, e := unix.Open(filepath.Dir(path), unix.O_RDONLY|unix.O_DIRECTORY, 0)
+	require.NoError(t, e)
+	defer unix.Close(parent)
+	var st unix.Stat_t
+	require.NoError(t, unix.Fstatat(parent, "legacy.txt", &st, unix.AT_SYMLINK_NOFOLLOW))
+	holding, e := gcQuarantineDirectory(root)
+	require.NoError(t, e)
+	defer unix.Close(holding)
+	receipt, obj := gcHoldingNames("local://7/old/legacy.txt")
+	require.NoError(t, gcPersistMoveReceipt(holding, receipt, localGCMoveReceipt{"local://7/old/legacy.txt", uint64(st.Dev), uint64(st.Ino)}))
+	require.NoError(t, gcRenameExclusive(parent, "legacy.txt", holding, obj))
+	// A crash at this point loses no object identity and does not require an
+	// operator to certify a newly observed inode at the original pathname.
+	unlinked, e := s.DeleteNextcloudObject(context.Background(), "local://7/old/legacy.txt")
+	require.NoError(t, e)
+	require.True(t, unlinked)
+	var after unix.Stat_t
+	require.ErrorIs(t, unix.Fstatat(holding, obj, &after, unix.AT_SYMLINK_NOFOLLOW), unix.ENOENT)
+}
+
+func TestLocalGCHoldingSubprocessCrash(t *testing.T) {
+	if base := os.Getenv("WEKNORA_GC_HOLDING_CHILD"); base != "" {
+		s := &localFileService{baseDir: base}
+		root, _, _, e := s.capacityRoot()
+		require.NoError(t, e)
+		parent, e := unix.Open(filepath.Join(base, "7", "old"), unix.O_RDONLY|unix.O_DIRECTORY, 0)
+		require.NoError(t, e)
+		holding, e := gcQuarantineDirectory(root)
+		require.NoError(t, e)
+		var st unix.Stat_t
+		require.NoError(t, unix.Fstatat(parent, "crash.txt", &st, unix.AT_SYMLINK_NOFOLLOW))
+		receipt, obj := gcHoldingNames("local://7/old/crash.txt")
+		require.NoError(t, gcPersistMoveReceipt(holding, receipt, localGCMoveReceipt{"local://7/old/crash.txt", uint64(st.Dev), uint64(st.Ino)}))
+		require.NoError(t, gcRenameExclusive(parent, "crash.txt", holding, obj))
+		require.NoError(t, unix.Fsync(parent))
+		require.NoError(t, unix.Fsync(holding))
+		os.Exit(79)
+	}
+	base := t.TempDir()
+	path := filepath.Join(base, "7", "old", "crash.txt")
+	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0700))
+	require.NoError(t, os.WriteFile(path, []byte("owned crash bytes"), 0600))
+	child := exec.Command(os.Args[0], "-test.run=^TestLocalGCHoldingSubprocessCrash$")
+	child.Env = append(os.Environ(), "WEKNORA_GC_HOLDING_CHILD="+base)
+	err := child.Run()
+	var exit *exec.ExitError
+	require.ErrorAs(t, err, &exit)
+	require.Equal(t, 79, exit.ExitCode())
+	s := &localFileService{baseDir: base}
+	unlinked, err := s.DeleteNextcloudObject(context.Background(), "local://7/old/crash.txt")
+	require.NoError(t, err)
+	require.True(t, unlinked)
+	unlinked, err = s.DeleteNextcloudObject(context.Background(), "local://7/old/crash.txt")
+	require.NoError(t, err)
+	require.False(t, unlinked)
+	entries, err := os.ReadDir(filepath.Join(base, ".gc-exact-holding"))
+	require.NoError(t, err)
+	require.Empty(t, entries)
+}
diff --git a/internal/application/service/file/local_gc_quarantine_unix.go b/internal/application/service/file/local_gc_quarantine_unix.go
new file mode 100644
index 0000000000000000000000000000000000000000..9564bff3edfcbaf8ed447b2e3c25703055ada2b1
--- /dev/null
+++ b/internal/application/service/file/local_gc_quarantine_unix.go
@@ -0,0 +1,180 @@
+//go:build linux || darwin
+
+package file
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"golang.org/x/sys/unix"
+	"os"
+)
+
+type localGCMoveReceipt struct {
+	Path          string
+	Device, Inode uint64
+}
+
+func gcResumeHolding(ctx context.Context, root int, path string) (bool, bool, error) {
+	holding, e := gcQuarantineDirectory(root)
+	if e != nil {
+		return false, false, e
+	}
+	defer unix.Close(holding)
+	receiptName, objectName := gcHoldingNames(path)
+	receipt, e := gcReadMoveReceipt(holding, receiptName)
+	if errors.Is(e, unix.ENOENT) {
+		return false, false, nil
+	}
+	if e != nil {
+		return false, false, e
+	}
+	if receipt.Path != path {
+		return false, false, errors.New("GC holding receipt scope mismatch")
+	}
+	var held unix.Stat_t
+	if e = unix.Fstatat(holding, objectName, &held, unix.AT_SYMLINK_NOFOLLOW); errors.Is(e, unix.ENOENT) {
+		return false, false, nil
+	}
+	if e != nil {
+		return false, false, e
+	}
+	if uint64(held.Dev) != receipt.Device || uint64(held.Ino) != receipt.Inode || held.Nlink != 1 || held.Mode&unix.S_IFMT != unix.S_IFREG {
+		return false, false, errors.New("GC holding inode changed")
+	}
+	if e = ctx.Err(); e != nil {
+		return false, false, e
+	}
+	if e = unix.Unlinkat(holding, objectName, 0); e != nil {
+		return false, false, e
+	}
+	if e = unix.Fsync(holding); e != nil {
+		return false, false, e
+	}
+	if e = unix.Unlinkat(holding, receiptName, 0); e != nil {
+		return false, false, e
+	}
+	if e = unix.Fsync(holding); e != nil {
+		return false, false, e
+	}
+	return true, true, nil
+}
+func gcQuarantineDirectory(root int) (int, error) {
+	fd, e := capacityDirectory(root, ".gc-exact-holding", true)
+	if e != nil {
+		return -1, e
+	}
+	var st unix.Stat_t
+	if e = unix.Fstat(fd, &st); e != nil || int(st.Uid) != os.Geteuid() || st.Mode&0777 != 0700 {
+		unix.Close(fd)
+		return -1, errors.New("GC holding directory not private")
+	}
+	return fd, nil
+}
+func gcHoldingNames(path string) (string, string) {
+	hash := sha256.Sum256([]byte(path))
+	name := hex.EncodeToString(hash[:])
+	return name + ".receipt", name + ".object"
+}
+func gcReadMoveReceipt(dir int, name string) (localGCMoveReceipt, error) {
+	var r localGCMoveReceipt
+	fd, e := unix.Openat(dir, name, unix.O_RDONLY|unix.O_NOFOLLOW, 0)
+	if e != nil {
+		return r, e
+	}
+	f := os.NewFile(uintptr(fd), name)
+	defer f.Close()
+	var st unix.Stat_t
+	if e = unix.Fstat(fd, &st); e != nil || st.Nlink != 1 || st.Mode&unix.S_IFMT != unix.S_IFREG || st.Mode&0777 != 0600 || int(st.Uid) != os.Geteuid() || st.Size > 4096 {
+		return r, errors.New("GC holding receipt unavailable")
+	}
+	b := make([]byte, st.Size)
+	n, e := f.Read(b)
+	if e != nil || int64(n) != st.Size {
+		return r, errors.New("GC holding receipt incomplete")
+	}
+	e = json.Unmarshal(b, &r)
+	return r, e
+}
+func gcPersistMoveReceipt(dir int, name string, r localGCMoveReceipt) error {
+	fd, e := unix.Openat(dir, name, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_NOFOLLOW, 0600)
+	if e != nil {
+		return e
+	}
+	f := os.NewFile(uintptr(fd), name)
+	defer f.Close()
+	b, e := json.Marshal(r)
+	if e != nil {
+		return e
+	}
+	if _, e = f.Write(b); e != nil {
+		return e
+	}
+	if e = f.Sync(); e != nil {
+		return e
+	}
+	return unix.Fsync(dir)
+}
+
+// A rename isolates the pathname atomically before any unlink. Only the exact
+// pinned inode in the owned private holding directory can be destroyed. A
+// replacement is restored without overwrite or retained there for review.
+func gcQuarantineUnlink(ctx context.Context, root, parent int, filename, path string, before unix.Stat_t) (bool, error) {
+	holding, e := gcQuarantineDirectory(root)
+	if e != nil {
+		return false, e
+	}
+	defer unix.Close(holding)
+	receiptName, objectName := gcHoldingNames(path)
+	receipt, e := gcReadMoveReceipt(holding, receiptName)
+	if errors.Is(e, unix.ENOENT) {
+		receipt = localGCMoveReceipt{path, uint64(before.Dev), uint64(before.Ino)}
+		if e = gcPersistMoveReceipt(holding, receiptName, receipt); e != nil {
+			return false, e
+		}
+	} else if e != nil {
+		return false, e
+	}
+	if receipt.Path != path || receipt.Device == 0 || receipt.Inode == 0 {
+		return false, errors.New("GC holding receipt scope mismatch")
+	}
+	var held unix.Stat_t
+	if e = unix.Fstatat(holding, objectName, &held, unix.AT_SYMLINK_NOFOLLOW); errors.Is(e, unix.ENOENT) {
+		if e = gcRenameExclusive(parent, filename, holding, objectName); e != nil {
+			return false, e
+		}
+		if e = unix.Fsync(parent); e != nil {
+			return false, e
+		}
+		if e = unix.Fsync(holding); e != nil {
+			return false, e
+		}
+		if e = unix.Fstatat(holding, objectName, &held, unix.AT_SYMLINK_NOFOLLOW); e != nil {
+			return false, e
+		}
+	} else if e != nil {
+		return false, e
+	}
+	if uint64(held.Dev) != receipt.Device || uint64(held.Ino) != receipt.Inode || held.Nlink != 1 || held.Mode&unix.S_IFMT != unix.S_IFREG {
+		_ = gcRenameExclusive(holding, objectName, parent, filename)
+		return false, errors.New("GC same-path replacement refused; bytes retained")
+	}
+	if e = ctx.Err(); e != nil {
+		return false, e
+	}
+	if e = unix.Unlinkat(holding, objectName, 0); e != nil {
+		return false, e
+	}
+	if e = unix.Fsync(holding); e != nil {
+		return false, e
+	}
+	if e = unix.Unlinkat(holding, receiptName, 0); e != nil {
+		return false, e
+	}
+	if e = unix.Fsync(holding); e != nil {
+		return false, e
+	}
+	return true, nil
+}
