+const (
+	nextcloudGCIndexWindow    = time.Hour
+	nextcloudGCFailedWindow   = 24 * time.Hour
+	nextcloudGCOriginalWindow = 7 * 24 * time.Hour
+	nextcloudGCRetryWindow    = time.Hour
+	nextcloudGCDerivedBatch   = 1000
+)
