+	}
+	for _, candidate := range []struct {
+		knowledgeID string
+		kind        NextcloudContentLeaseKind
+	}{
+		{scope.KnowledgeID, NextcloudContentBuildLease},
+		{"", NextcloudContentReadLease},
+	} {
