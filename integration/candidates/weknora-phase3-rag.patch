+	leaseTestCoverKB(t, db, scope)
+
+	nowMS, err := nextcloudLeaseNowMS(db)
+	require.NoError(t, err)
+	addLateLease := func(knowledgeID string, kind NextcloudContentLeaseKind) NextcloudContentLease {
+		t.Helper()
