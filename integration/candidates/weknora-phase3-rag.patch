+}
+
+func ragTestReadToken(lease NextcloudContentLease) *types.RAGExactReadLease {
+	return &types.RAGExactReadLease{ID: lease.ID, TenantID: lease.TenantID, KnowledgeBaseID: lease.KnowledgeBaseID,
+		KnowledgeID: lease.KnowledgeID, Kind: string(lease.Kind), Epoch: lease.Epoch, OwnerID: lease.OwnerID, ExpiresAt: lease.ExpiresAt}
