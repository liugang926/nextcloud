+func neoGraphFixture(t *testing.T) (context.Context, neo4j.Driver, interfaces.RetrieveGraphRepository, types.NameSpace) {
+	t.Helper()
+	dsn := os.Getenv("WEKNORA_KG_TEST_NEO4J_URI")
