+	name := "auto_span_unselected_changed_after_header"
+	require.NoError(t, db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
+		if fired || tx.Statement.Context.Value(autoSpanSnapshotPauseKey{}) != true || tx.Statement.Table != "knowledges" {
+			return
+		}
+		fired = true
+		require.NoError(t, db.Model(&types.KnowledgeTag{}).Where("id='span-nonmatch'").Update("name", "concurrent unselected candidate").Error)
+	}))
