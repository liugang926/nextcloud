+func bodyProtocolSourceWindows(t *testing.T, pg bool) {
+	for _, mode := range []string{"current", "one-hour-open", "one-hour-expired", "failed-open", "failed-expired", "cancelled-retry", "source-unreachable", "confirmed-delete", "whole-binding-withdrawal"} {
+		t.Run(mode, func(t *testing.T) {
+			db, s := bodyProtocolFixture(t, pg)
+			require.NoError(t, db.AutoMigrate(&nextcloudSourceVersion{}, &nextcloudContentFence{}, &NextcloudIndexedWithdrawal{}, &types.DataSource{}))
+			require.NoError(t, db.Create(&types.DataSource{ID: "stable-source", TenantID: 7, KnowledgeBaseID: "kb", Name: "owned source", Status: types.DataSourceStatusActive}).Error)
+			require.NoError(t, db.Exec("UPDATE knowledges SET channel='nextcloud',parse_status='completed',pending_subtasks_count=0 WHERE id='one'").Error)
+			now, e := nextcloudLeaseNowMS(bodyInternal(db))
+			require.NoError(t, e)
+			retired := now - int64(2*time.Hour/time.Millisecond)
+			if mode == "one-hour-open" {
+				retired = now - int64(30*time.Minute/time.Millisecond)
+			}
+			if mode == "failed-expired" {
+				retired = now - int64(25*time.Hour/time.Millisecond)
+			}
+			candidate, state := "new", "published"
+			if mode == "current" {
+				candidate = "one"
+			}
+			if mode == "confirmed-delete" {
+				candidate = ""
+				state = "tombstone"
+				retired = now - 1
+			}
+			require.NoError(t, db.Create(&nextcloudSourceVersion{TenantID: 7, KnowledgeBaseID: "kb", DataSourceID: "stable-source", ExternalID: "stable-file", CandidateKnowledgeID: candidate, State: state}).Error)
+			require.NoError(t, db.Create(&nextcloudContentFence{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: "one", State: "retired", RetiredAtMS: &retired}).Error)
+			if strings.HasPrefix(mode, "failed-") {
+				require.NoError(t, db.Exec("UPDATE knowledges SET parse_status='failed' WHERE id='one'").Error)
+			}
+			if mode == "cancelled-retry" {
+				require.NoError(t, db.Exec("UPDATE knowledges SET parse_status='cancelled',pending_subtasks_count=1 WHERE id='one'").Error)
+			}
+			if mode == "source-unreachable" {
+				require.NoError(t, db.Exec("UPDATE data_sources SET status='error'").Error)
+			}
+			if mode == "whole-binding-withdrawal" {
+				retired = now - 1
+				require.NoError(t, db.Exec("UPDATE nextcloud_content_fences SET retired_at_ms=?", retired).Error)
+				require.NoError(t, db.Create(&NextcloudIndexedWithdrawal{OperationID: "owned-withdraw", TenantID: 7, KnowledgeBaseID: "kb", DataSourceID: "stable-source", State: "withdrawn_inventory_incomplete"}).Error)
+			}
+			// Protocol eligibility reads the actual source state and DB clock; the
+			// lower-level unit calls no scheduler and sets no production coverage.
+			id := bodyProtocolCreate(t, db, "window-owner", "one")
+			var body originalBodyPayload
+			require.NoError(t, bodyInternal(db).Where("id=?", id).Take(&body).Error)
+			var heads []originalBodyFieldHead
+			require.NoError(t, bodyInternal(db).Table("original_body_field_revisions").Where("body_id=?", id).Find(&heads).Error)
+			deadline, e := s.bodyEligibility(db, body, heads, now)
+			switch mode {
+			case "current", "cancelled-retry", "source-unreachable":
+				require.ErrorIs(t, e, ErrOriginalBodyRetained)
+			case "one-hour-open", "failed-open":
+				require.NoError(t, e)
+				require.Greater(t, deadline, now)
+			default:
+				require.NoError(t, e)
+				require.LessOrEqual(t, deadline, now)
+			}
+		})
+	}
+}
