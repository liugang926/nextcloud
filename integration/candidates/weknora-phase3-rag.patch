+				end.Status = types.SpanStatusFailed
+				end.FinishedAt = &now
+				require.Error(t, repo.Upsert(other, &end))
+				return
+			}
+			require.Error(t, store.RecheckSpanOutputInputs(context.Background(), before))
+		})
+	}
+}
