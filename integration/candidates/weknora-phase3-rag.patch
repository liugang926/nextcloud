+func validKnowledgeTemplate(purpose, content string) error {
+	if (purpose != "summary" && purpose != "question") || strings.TrimSpace(content) == "" || !utf8.ValidString(content) || len(content) > 32768 {
+		return ErrKnowledgeInputChanged
+	}
+	return nil
