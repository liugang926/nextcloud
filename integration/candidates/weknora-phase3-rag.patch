+// ShareOriginalBodyFieldInTx is an internal exact copy operation. The target
+// producer has already persisted the same body bytes under its own authority;
+// this only deduplicates storage and creates an additional incoming owner.
+// It cannot introduce cached text, cross-tenant sharing, or a purged body ID.
+func (s *OriginalBodyRetentionStore) ShareOriginalBodyFieldInTx(ctx context.Context, tx *gorm.DB, bodyID, table, key, col string) error {
+	d, ok := bodyDescriptor(table)
+	if !ok || d.Mode != "vault" {
+		return ErrOriginalBodyUnavailable
+	}
+	allowed := false
+	for _, field := range d.Columns {
+		if field == col {
+			allowed = true
+		}
+	}
+	if !allowed {
+		return ErrOriginalBodyUnavailable
+	}
+	if e := s.checkJournalInTx(tx); e != nil {
+		return e
+	}
+	if e := s.checkExternalBody(bodyID); e != nil {
+		return e
+	}
+	var source originalBodyPayload
+	if e := bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=?", bodyID).Take(&source).Error; e != nil {
+		return e
+	}
+	if source.State != "live" || source.Payload == nil || bodySHA([]byte(*source.Payload)) != source.BodySHA256 {
+		return ErrOriginalBodyUnavailable
+	}
+	row, e := bodySourceRow(tx, d, key)
+	if e != nil {
+		return e
+	}
+	scope, e := bodyScopeFromRow(tx, d, key, row)
+	if e != nil {
+		return e
+	}
+	if scope.Tenant != source.TenantID {
+		return ErrOriginalBodyUnavailable
+	}
+	var target originalBodyFieldHead
+	if e := bodyInternal(tx).Where("source_table=? AND row_key=? AND column_name=?", table, key, col).Take(&target).Error; e != nil {
+		return e
+	}
+	ref, ok := bodyReference(bodyText(row[col]))
+	if !ok {
+		return ErrOriginalBodyUnavailable
+	}
+	raw, e := s.resolveInTx(tx, target, ref)
+	if e != nil {
+		return e
+	}
+	if bodySHA([]byte(raw)) != source.BodySHA256 {
+		return ErrOriginalBodyUnavailable
+	}
+	target.BodyID = source.ID
+	target.Revision++
+	target.OriginalBodyRef = bodyRefString(target.SlotID, source.ID, source.BodySHA256)
+	if e := bodyInternal(tx).Model(&originalBodyFieldHead{}).Where("slot_id=?", target.SlotID).Updates(map[string]any{"body_id": target.BodyID, "revision": target.Revision, "original_body_ref": target.OriginalBodyRef}).Error; e != nil {
+		return e
+	}
+	if e := bodyInternal(tx).Table("original_body_field_revisions").Create(&target).Error; e != nil {
+		return e
+	}
+	return originalBodyRewrite(tx, d, key, col, source.ID, bodyText(row[col]), target.OriginalBodyRef)
+}
+
+func legacyParentMessageBodies(raw string) (string, error) {
+	if raw == "" || raw == "null" {
+		return "", nil
+	}
+	var snapshots []map[string]json.RawMessage
+	if strings.HasPrefix(strings.TrimSpace(raw), "{") {
+		var snapshot map[string]json.RawMessage
+		if e := json.Unmarshal([]byte(raw), &snapshot); e != nil {
+			return "", e
+		}
+		snapshots = append(snapshots, snapshot)
+	} else if e := json.Unmarshal([]byte(raw), &snapshots); e != nil {
+		return "", e
+	}
+	copies := []json.RawMessage{}
+	for _, snapshot := range snapshots {
+		bytes := snapshot["Messages"]
+		if len(bytes) == 0 || string(bytes) == "null" || string(bytes) == "[]" {
+			continue
+		}
+		var messages []json.RawMessage
+		if e := json.Unmarshal(bytes, &messages); e != nil {
+			return "", e
+		}
+		if len(messages) > 0 {
+			copies = append(copies, bytes)
+		}
+	}
+	if len(copies) == 0 {
+		return "", nil
+	}
+	data, e := json.Marshal(copies)
+	return string(data), e
+}
diff --git a/internal/application/repository/original_body_journal.go b/internal/application/repository/original_body_journal.go
new file mode 100644
index 0000000000000000000000000000000000000000..15fe97f6146f19c1c7f87c81e76c935bff3bbdbb
--- /dev/null
+++ b/internal/application/repository/original_body_journal.go
@@ -0,0 +1,350 @@
+package repository
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"os"
+	"path/filepath"
+	"strconv"
+	"syscall"
+)
+
+type OriginalBodyJournalPaths struct{ Directory, KeyPath, PinPath string }
+type originalBodyJournal struct{ paths OriginalBodyJournalPaths }
+type originalBodyJournalEvent struct {
+	Sequence                                                                  int64  `json:"sequence"`
+	PreviousSHA256                                                            string `json:"previous_sha256"`
+	BodyID, BodySHA256, ScopeSHA256                                           string
+	JournalID                                                                 string
+	TenantID                                                                  uint64
+	Fields                                                                    []string
+	BeforeBytes, BodyDeadlineMS, MetadataDeadlineMS, RecordedAtMS, PurgeEpoch int64
+	Signature, HeadSHA256                                                     string
+}
+type originalBodyJournalPin struct {
+	Sequence                         int64
+	HeadSHA256, Signature, JournalID string
+}
+type originalBodyJournalHead struct {
+	ID         int `gorm:"primaryKey"`
+	Sequence   int64
+	HeadSHA256 string
+	JournalID  string
+}
+
+func (originalBodyJournalHead) TableName() string { return "original_body_journal_heads" }
+func originalBodyJournalFromEnv() *originalBodyJournal {
+	p := OriginalBodyJournalPaths{os.Getenv("WEKNORA_ORIGINAL_BODY_JOURNAL_DIRECTORY"), os.Getenv("WEKNORA_ORIGINAL_BODY_JOURNAL_KEY"), os.Getenv("WEKNORA_ORIGINAL_BODY_JOURNAL_PIN")}
+	if p.Directory == "" && p.KeyPath == "" && p.PinPath == "" {
+		return nil
+	}
+	return &originalBodyJournal{p}
+}
+func (s *OriginalBodyRetentionStore) ConfigureJournal(paths OriginalBodyJournalPaths) {
+	s.journal = &originalBodyJournal{paths}
+}
+func bodyPrivateFile(path string, mode os.FileMode) ([]byte, error) {
+	if !filepath.IsAbs(path) {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	parent, e := filepath.EvalSymlinks(filepath.Dir(path))
+	if e != nil || parent != filepath.Dir(path) {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	st, e := os.Lstat(path)
+	if e != nil {
+		return nil, e
+	}
+	if !st.Mode().IsRegular() || st.Mode().Perm() != mode {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	if actual, ok := st.Sys().(*syscall.Stat_t); !ok || int(actual.Uid) != os.Geteuid() || actual.Nlink != 1 {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	if st.Size() > 64*1024*1024 {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	return os.ReadFile(path)
+}
+func (j *originalBodyJournal) key() ([]byte, error) {
+	if j == nil {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	resolved, e := filepath.EvalSymlinks(j.paths.Directory)
+	if e != nil || resolved != j.paths.Directory {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	st, e := os.Lstat(resolved)
+	if e != nil || !st.IsDir() || st.Mode().Perm() != 0700 {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	if actual, ok := st.Sys().(*syscall.Stat_t); !ok || int(actual.Uid) != os.Geteuid() {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	key, e := bodyPrivateFile(j.paths.KeyPath, 0600)
+	if e != nil || len(key) < 32 {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	return key, nil
+}
+func bodyMAC(key, data []byte) string {
+	m := hmac.New(sha256.New, key)
+	m.Write(data)
+	return hex.EncodeToString(m.Sum(nil))
+}
+func bodyEventCore(event originalBodyJournalEvent) []byte {
+	event.Signature = ""
+	event.HeadSHA256 = ""
+	b, _ := json.Marshal(event)
+	return b
+}
+func bodyPinMAC(key []byte, p originalBodyJournalPin) string {
+	return bodyMAC(key, []byte("body-pin-v1\n"+p.JournalID+"\n"+strconv.FormatInt(p.Sequence, 10)+"\n"+p.HeadSHA256))
+}
+func (j *originalBodyJournal) read() ([]originalBodyJournalEvent, originalBodyJournalPin, error) {
+	var pin originalBodyJournalPin
+	key, e := j.key()
+	if e != nil {
+		return nil, pin, e
+	}
+	raw, e := bodyPrivateFile(filepath.Join(j.paths.Directory, "purge-ledger.json"), 0600)
+	if e != nil {
+		return nil, pin, e
+	}
+	var events []originalBodyJournalEvent
+	if json.Unmarshal(raw, &events) != nil {
+		return nil, pin, ErrOriginalBodyUnavailable
+	}
+	head := ""
+	for n, event := range events {
+		if event.Sequence != int64(n+1) || event.PreviousSHA256 != head || !hmac.Equal([]byte(event.Signature), []byte(bodyMAC(key, bodyEventCore(event)))) {
+			return nil, pin, ErrOriginalBodyUnavailable
+		}
+		head = bodySHA(append(bodyEventCore(event), []byte(event.Signature)...))
+		if event.HeadSHA256 != head {
+			return nil, pin, ErrOriginalBodyUnavailable
+		}
+	}
+	raw, e = bodyPrivateFile(j.paths.PinPath, 0600)
+	if e != nil {
+		return nil, pin, e
+	}
+	if json.Unmarshal(raw, &pin) != nil || pin.JournalID == "" || pin.Sequence < 0 || pin.Sequence > int64(len(events)) || !hmac.Equal([]byte(pin.Signature), []byte(bodyPinMAC(key, pin))) {
+		return nil, pin, ErrOriginalBodyUnavailable
+	}
+	for _, event := range events {
+		if event.JournalID != pin.JournalID {
+			return nil, pin, ErrOriginalBodyUnavailable
+		}
+	}
+	pinnedHead := ""
+	if pin.Sequence > 0 {
+		pinnedHead = events[pin.Sequence-1].HeadSHA256
+	}
+	if pin.HeadSHA256 != pinnedHead {
+		return nil, pin, ErrOriginalBodyUnavailable
+	}
+	if pin.Sequence < int64(len(events)) {
+		// A durable authenticated tail with an older pin is the interrupted
+		// append boundary. Verify its pinned prefix before advancing the pin.
+		pin = originalBodyJournalPin{Sequence: int64(len(events)), HeadSHA256: head, JournalID: pin.JournalID}
+		pin.Signature = bodyPinMAC(key, pin)
+		data, _ := json.Marshal(pin)
+		if e := bodyWritePrivateAtomic(j.paths.PinPath, data); e != nil {
+			return nil, pin, e
+		}
+	}
+	return events, pin, nil
+}
+func bodyWritePrivateAtomic(path string, data []byte) error {
+	parent, e := filepath.EvalSymlinks(filepath.Dir(path))
+	if e != nil || parent != filepath.Dir(path) {
+		return ErrOriginalBodyUnavailable
+	}
+	if st, e := os.Lstat(path); e == nil {
+		if !st.Mode().IsRegular() || st.Mode().Perm() != 0600 {
+			return ErrOriginalBodyUnavailable
+		}
+	} else if !errors.Is(e, os.ErrNotExist) {
+		return e
+	}
+	temp, e := os.CreateTemp(parent, ".body-journal-")
+	if e != nil {
+		return e
+	}
+	name := temp.Name()
+	defer os.Remove(name)
+	if e = temp.Chmod(0600); e != nil {
+		temp.Close()
+		return e
+	}
+	if _, e = temp.Write(data); e != nil {
+		temp.Close()
+		return e
+	}
+	if e = temp.Sync(); e != nil {
+		temp.Close()
+		return e
+	}
+	if e = temp.Close(); e != nil {
+		return e
+	}
+	if e = os.Rename(name, path); e != nil {
+		return e
+	}
+	dir, e := os.Open(parent)
+	if e != nil {
+		return e
+	}
+	defer dir.Close()
+	return dir.Sync()
+}
+
+// Explicit owned initialization; a conflicting marker/file is never adopted.
+func (s *OriginalBodyRetentionStore) InitializeJournal() error {
+	if !originalBodySchemaPresent(s.db) {
+		return ErrOriginalBodyUnavailable
+	}
+	key, e := s.journal.key()
+	if e != nil {
+		return e
+	}
+	path := filepath.Join(s.journal.paths.Directory, "purge-ledger.json")
+	for _, p := range []string{path, s.journal.paths.PinPath} {
+		if _, e := os.Lstat(p); !errors.Is(e, os.ErrNotExist) {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return s.db.Transaction(func(tx *gorm.DB) error {
+		var head originalBodyJournalHead
+		if e := bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=1").Take(&head).Error; e != nil {
+			return e
+		}
+		if head.Sequence != 0 || head.HeadSHA256 != "" || head.JournalID != "" {
+			return ErrOriginalBodyUnavailable
+		}
+		var count int64
+		if e := bodyInternal(tx).Model(&originalBodyPayload{}).Where("state<>'live'").Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 0 {
+			return ErrOriginalBodyUnavailable
+		}
+		if e := bodyInternal(tx).Model(&originalBodyPurgeReceipt{}).Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 0 {
+			return ErrOriginalBodyUnavailable
+		}
+		pin := originalBodyJournalPin{JournalID: uuid.NewString()}
+		pin.Signature = bodyPinMAC(key, pin)
+		if e := bodyWritePrivateAtomic(path, []byte("[]")); e != nil {
+			return e
+		}
+		data, _ := json.Marshal(pin)
+		if e := bodyWritePrivateAtomic(s.journal.paths.PinPath, data); e != nil {
+			return e
+		}
+		return bodyInternal(tx).Model(&head).Where("sequence=0 AND journal_id='' AND head_sha256=''").Update("journal_id", pin.JournalID).Error
+	})
+}
+func (s *OriginalBodyRetentionStore) checkJournalInTx(tx *gorm.DB) error {
+	var head originalBodyJournalHead
+	if e := bodyInternal(tx).Where("id=1").Take(&head).Error; e != nil {
+		return e
+	}
+	if s.journal == nil {
+		return ErrOriginalBodyUnavailable
+	}
+	_, pin, e := s.journal.read()
+	if e != nil {
+		return e
+	}
+	if pin.JournalID != head.JournalID || pin.Sequence != head.Sequence || pin.HeadSHA256 != head.HeadSHA256 {
+		return ErrOriginalBodyUnavailable
+	}
+	return nil
+}
+func (s *OriginalBodyRetentionStore) checkExternalBody(id string) error {
+	if s.journal == nil {
+		return nil
+	}
+	events, _, e := s.journal.read()
+	if e != nil {
+		return e
+	}
+	for _, event := range events {
+		if event.BodyID == id {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	return nil
+}
+func (j *originalBodyJournal) append(event originalBodyJournalEvent) (originalBodyJournalEvent, error) {
+	events, pin, e := j.read()
+	if e != nil {
+		return event, e
+	}
+	key, e := j.key()
+	if e != nil {
+		return event, e
+	}
+	lock, e := os.OpenFile(filepath.Join(j.paths.Directory, "writer.lock"), os.O_CREATE|os.O_RDWR, 0600)
+	if e != nil {
+		return event, e
+	}
+	defer lock.Close()
+	if e = syscall.Flock(int(lock.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); e != nil {
+		return event, e
+	}
+	events, pin, e = j.read()
+	if e != nil {
+		return event, e
+	}
+	for _, old := range events {
+		if old.BodyID == event.BodyID {
+			if old.BodySHA256 != event.BodySHA256 || old.ScopeSHA256 != event.ScopeSHA256 {
+				return event, ErrOriginalBodyUnavailable
+			}
+			return old, nil
+		}
+	}
+	event.JournalID = pin.JournalID
+	event.Sequence = pin.Sequence + 1
+	event.PreviousSHA256 = pin.HeadSHA256
+	event.Signature = bodyMAC(key, bodyEventCore(event))
+	event.HeadSHA256 = bodySHA(append(bodyEventCore(event), []byte(event.Signature)...))
+	events = append(events, event)
+	raw, e := json.Marshal(events)
+	if e != nil {
+		return event, e
+	}
+	if e = bodyWritePrivateAtomic(filepath.Join(j.paths.Directory, "purge-ledger.json"), raw); e != nil {
+		return event, e
+	}
+	pin = originalBodyJournalPin{Sequence: event.Sequence, HeadSHA256: event.HeadSHA256, JournalID: pin.JournalID}
+	pin.Signature = bodyPinMAC(key, pin)
+	raw, _ = json.Marshal(pin)
+	return event, bodyWritePrivateAtomic(j.paths.PinPath, raw)
+}
+
+var _ = fmt.Sprintf
+
+// VerifyJournalReady fails startup after a restore until external decisions
+// have been reconciled. Initialization is an explicit operator action.
+func (s *OriginalBodyRetentionStore) VerifyJournalReady() error {
+	if !originalBodySchemaPresent(s.db) {
+		return ErrOriginalBodyUnavailable
+	}
+	if e := verifyBodyLeaseScopeSchema(bodyInternal(s.db)); e != nil {
+		return e
+	}
+	return s.checkJournalInTx(bodyInternal(s.db))
+}
diff --git a/internal/application/repository/original_body_message_scopes.go b/internal/application/repository/original_body_message_scopes.go
new file mode 100644
index 0000000000000000000000000000000000000000..91517906793ab81fa3ba236eedcb29d717bd1cf3
--- /dev/null
+++ b/internal/application/repository/original_body_message_scopes.go
@@ -0,0 +1,327 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// A body gets a complete marker only at its actual authenticated producer.
+// The empty KB row records completeness; a lone marker means no KB scope. No
+// marker means unknown, not an empty set inferred from current metadata.
+type originalBodyLeaseScope struct {
+	BodyID          string `gorm:"primaryKey"`
+	TenantID        uint64 `gorm:"primaryKey"`
+	KnowledgeBaseID string `gorm:"primaryKey"`
+}
+
+func (originalBodyLeaseScope) TableName() string { return "original_body_lease_scopes" }
+
+const originalBodyLeaseScopeDDL = `CREATE TABLE IF NOT EXISTS original_body_lease_scopes(body_id TEXT NOT NULL REFERENCES original_body_payloads(id),tenant_id BIGINT NOT NULL,knowledge_base_id TEXT NOT NULL,PRIMARY KEY(body_id,tenant_id,knowledge_base_id))`
+
+// Explicit offline forward schema step for already-installed unpublished
+// migration 152/71. It never backfills scope markers from current pointers.
+func (s *OriginalBodyRetentionStore) UpgradeLeaseScopeSchema() error {
+	if !originalBodySchemaPresent(s.db) {
+		return ErrOriginalBodyUnavailable
+	}
+	return bodyInternal(s.db).Transaction(func(tx *gorm.DB) error {
+		if e := tx.Exec(originalBodyLeaseScopeDDL).Error; e != nil {
+			return e
+		}
+		if tx.Dialector.Name() == "postgres" {
+			if e := tx.Exec(`CREATE OR REPLACE FUNCTION original_body_lease_scope_immutable() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'immutable original body lease scope'; END $$`).Error; e != nil {
+				return e
+			}
+			if e := tx.Exec(`DROP TRIGGER IF EXISTS original_body_lease_scope_immutable ON original_body_lease_scopes`).Error; e != nil {
+				return e
+			}
+			return tx.Exec(`CREATE TRIGGER original_body_lease_scope_immutable BEFORE UPDATE OR DELETE ON original_body_lease_scopes FOR EACH ROW EXECUTE FUNCTION original_body_lease_scope_immutable()`).Error
+		}
+		if tx.Dialector.Name() != "sqlite" {
+			return ErrOriginalBodyUnavailable
+		}
+		for _, event := range []string{"UPDATE", "DELETE"} {
+			if e := tx.Exec("CREATE TRIGGER IF NOT EXISTS original_body_lease_scope_immutable_" + strings.ToLower(event) + " BEFORE " + event + " ON original_body_lease_scopes BEGIN SELECT RAISE(ABORT,'immutable original body lease scope'); END").Error; e != nil {
+				return e
+			}
+		}
+		return nil
+	})
+}
+func (s *OriginalBodyRetentionStore) recordMessageLeaseScopes(tx *gorm.DB, id string, d originalBodyFieldDescriptor, key, raw string, scope originalBodyScope) error {
+	if d.Table != "messages" && d.Table != "message_generation_origins" {
+		return nil
+	}
+	_, actualProducer := tx.Statement.Context.Value(messageProducerBoundaryKey{}).(messageProducerBoundary)
+	generated, actualGenerated := tx.Statement.Context.Value(messageGeneratedFieldKey{}).(messageGeneratedFieldBoundary)
+	actualGenerated = actualGenerated && d.Table == "messages" && generated.MessageID == key
+	if !actualProducer && !actualGenerated {
+		return nil
+	}
+	var execution types.MessageExecutionContext
+	var lineage *types.SourceLineage
+	if d.Table == "messages" {
+		row, e := bodySourceRow(tx, d, key)
+		if e != nil {
+			return e
+		}
+		if e = json.Unmarshal([]byte(bodyText(row["execution_context"])), &execution); e != nil {
+			return e
+		}
+		if text := bodyText(row["source_lineage"]); text != "" && text != "null" {
+			if e = json.Unmarshal([]byte(text), &lineage); e != nil {
+				return e
+			}
+		}
+	} else {
+		var envelope struct {
+			Body      *types.Message
+			Execution types.MessageExecutionContext
+			Lineage   *types.SourceLineage
+		}
+		if e := json.Unmarshal([]byte(raw), &envelope); e != nil {
+			return e
+		}
+		if envelope.Body == nil {
+			return nil
+		}
+		execution = envelope.Execution
+		lineage = envelope.Lineage
+	}
+	rows := []originalBodyLeaseScope{{BodyID: id, TenantID: scope.Tenant, KnowledgeBaseID: ""}}
+	kbIDs := append(append([]string{}, execution.KnowledgeBaseIDs...), execution.AgentKnowledgeBaseIDs...)
+	for _, tag := range execution.TagScopes {
+		kbIDs = append(kbIDs, tag.KnowledgeBaseID)
+	}
+	for _, kb := range kbIDs {
+		if kb == "" {
+			continue
+		}
+		var actual struct {
+			TenantID uint64
+			ID       string
+		}
+		if e := bodyInternal(tx).Table("knowledge_bases").Select("tenant_id,id").Where("id=?", kb).Take(&actual).Error; e != nil {
+			return e
+		}
+		if actual.TenantID == 0 {
+			return ErrOriginalBodyUnavailable
+		}
+		rows = append(rows, originalBodyLeaseScope{id, actual.TenantID, actual.ID})
+	}
+	for _, knowledgeID := range execution.KnowledgeIDs {
+		var knowledge struct {
+			TenantID        uint64
+			KnowledgeBaseID string
+		}
+		if e := bodyInternal(tx).Table("knowledges").Select("tenant_id,knowledge_base_id").Where("id=?", knowledgeID).Take(&knowledge).Error; e != nil {
+			return e
+		}
+		if knowledge.TenantID == 0 || knowledge.KnowledgeBaseID == "" {
+			return ErrOriginalBodyUnavailable
+		}
+		rows = append(rows, originalBodyLeaseScope{id, knowledge.TenantID, knowledge.KnowledgeBaseID})
+	}
+	if lineage != nil {
+		for _, source := range lineage.Sources {
+			rows = append(rows, originalBodyLeaseScope{id, source.TenantID, source.KnowledgeBaseID})
+		}
+	}
+	if actualGenerated {
+		for _, parent := range generated.Parents {
+			for _, proof := range parent.Proofs {
+				var original []originalBodyLeaseScope
+				if e := bodyInternal(tx).Table("original_body_lease_scopes s").Select("s.*").Joins("JOIN original_body_field_heads h ON h.body_id=s.body_id").Where("h.source_table='message_generation_origins' AND h.row_key=?", proof.GenerationID).Find(&original).Error; e != nil {
+					return e
+				}
+				if !bodyLeaseScopesComplete(original, proof.TenantID) {
+					return nil
+				} // Do not certify incomplete legacy parents.
+				for _, ref := range original {
+					rows = append(rows, originalBodyLeaseScope{id, ref.TenantID, ref.KnowledgeBaseID})
+				}
+			}
+		}
+		for _, source := range generated.Sources.Sources {
+			rows = append(rows, originalBodyLeaseScope{id, source.TenantID, source.KnowledgeBaseID})
+		}
+	}
+	return bodyInternal(tx).Clauses(clause.OnConflict{DoNothing: true}).Create(&rows).Error
+}
+func originalBodyScopeDigest(tx *gorm.DB, body originalBodyPayload, fields []string, parents []originalBodyParentRef) (string, error) {
+	sort.Strings(fields)
+	var scopes []originalBodyLeaseScope
+	if e := bodyInternal(tx).Where("body_id=?", body.ID).Order("tenant_id,knowledge_base_id").Find(&scopes).Error; e != nil {
+		return "", e
+	}
+	// Preserve the old authenticated format for old events without scope rows.
+	if len(scopes) == 0 {
+		data, e := json.Marshal(struct {
+			Tenant  uint64
+			BodyID  string
+			Fields  []string
+			Parents []originalBodyParentRef
+		}{body.TenantID, body.ID, fields, parents})
+		return bodySHA(data), e
+	}
+	data, e := json.Marshal(struct {
+		Tenant      uint64
+		BodyID      string
+		Fields      []string
+		Parents     []originalBodyParentRef
+		LeaseScopes []originalBodyLeaseScope
+	}{body.TenantID, body.ID, fields, parents, scopes})
+	return bodySHA(data), e
+}
+
+// AcquireMessageBodyReadLeases performs metadata verification and exact body
+// ID claims before the first original/material body read, on one caller-owned
+// transaction. Parent plans are included without loading their message bytes.
+func (s *KnowledgeInputProvenanceStore) AcquireMessageBodyReadLeases(ctx context.Context, plan *types.MessageMaterialReadPlan, owner string, ttl time.Duration, existing ...[]string) ([]string, error) {
+	if !originalBodySchemaPresent(s.db) {
+		return nil, nil
+	}
+	if plan == nil || owner == "" || ttl <= 0 || ttl > 30*time.Minute {
+		return nil, ErrOriginalBodyUnavailable
+	}
+	ids := []string{}
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if e := s.checkMessageMaterialPlanInTx(tx, plan.Request); e != nil {
+			return e
+		}
+		retention := NewOriginalBodyRetentionStore(tx)
+		if e := retention.checkJournalInTx(tx); e != nil {
+			return e
+		}
+		seen := map[string]bool{}
+		if len(existing) > 0 && len(existing[0]) > 0 {
+			now, e := nextcloudLeaseNowMS(bodyInternal(tx))
+			if e != nil {
+				return e
+			}
+			var active []originalBodyLease
+			if e := bodyInternal(tx).Select("body_id").Where("lease_id IN ? AND kind='read' AND released_at_ms IS NULL AND expires_at_ms>?", existing[0], now).Find(&active).Error; e != nil {
+				return e
+			}
+			for _, lease := range active {
+				seen[lease.BodyID] = true
+			}
+		}
+		var claim func(*types.MessageMaterialReadPlan) error
+		claim = func(current *types.MessageMaterialReadPlan) error {
+			for _, parent := range current.ParentPlans {
+				if e := claim(parent); e != nil {
+					return e
+				}
+			}
+			for _, control := range current.Controls {
+				var heads []originalBodyFieldHead
+				if e := bodyInternal(tx).Where("(source_table='messages' AND row_key=?) OR (source_table='message_generation_origins' AND row_key=?)", control.ID, control.GenerationID).Find(&heads).Error; e != nil {
+					return e
+				}
+				for _, head := range heads {
+					if seen[head.BodyID] {
+						continue
+					}
+					seen[head.BodyID] = true
+					id, e := retention.acquireLeaseInTx(tx, head.BodyID, "read", owner, ttl)
+					if e != nil {
+						return e
+					}
+					ids = append(ids, id)
+				}
+			}
+			return nil
+		}
+		return claim(plan)
+	})
+	return ids, err
+}
+func (s *OriginalBodyRetentionStore) RenewLease(ctx context.Context, id string, ttl time.Duration) error {
+	if id == "" || ttl <= 0 || ttl > 30*time.Minute {
+		return ErrOriginalBodyUnavailable
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if e := s.checkJournalInTx(tx); e != nil {
+			return e
+		}
+		now, e := nextcloudLeaseNowMS(bodyInternal(tx))
+		if e != nil {
+			return e
+		}
+		var lease originalBodyLease
+		if e := bodyInternal(tx).Where("lease_id=? AND released_at_ms IS NULL AND expires_at_ms>?", id, now).Take(&lease).Error; e != nil {
+			return e
+		}
+		var body originalBodyPayload
+		if e := bodyInternal(tx).Select("id,state,purge_epoch").Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=?", lease.BodyID).Take(&body).Error; e != nil {
+			return e
+		}
+		if body.State != "live" || body.PurgeEpoch != lease.Epoch {
+			return ErrOriginalBodyUnavailable
+		}
+		if e := s.checkExternalBody(body.ID); e != nil {
+			return e
+		}
+		result := bodyInternal(tx).Model(&originalBodyLease{}).Where("lease_id=? AND released_at_ms IS NULL AND expires_at_ms>?", id, now).Update("expires_at_ms", now+ttl.Milliseconds())
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected != 1 {
+			return ErrOriginalBodyUnavailable
+		}
+		return nil
+	})
+}
+func (s *KnowledgeInputProvenanceStore) RenewMessageBodyReadLease(ctx context.Context, id string, ttl time.Duration) error {
+	return NewOriginalBodyRetentionStore(s.db).RenewLease(ctx, id, ttl)
+}
+func (s *KnowledgeInputProvenanceStore) ReleaseMessageBodyReadLease(ctx context.Context, id string) error {
+	return NewOriginalBodyRetentionStore(s.db).ReleaseLease(ctx, id)
+}
+
+func verifyBodyLeaseScopeSchema(db *gorm.DB) error {
+	if !db.Migrator().HasTable(&originalBodyLeaseScope{}) {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, col := range []string{"body_id", "tenant_id", "knowledge_base_id"} {
+		if !db.Migrator().HasColumn(&originalBodyLeaseScope{}, col) {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	var count int64
+	if db.Dialector.Name() == "postgres" {
+		if e := db.Raw("SELECT count(*) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relname='original_body_lease_scopes' AND n.nspname=current_schema() AND t.tgname='original_body_lease_scope_immutable' AND t.tgenabled<>'D'").Scan(&count).Error; e != nil {
+			return e
+		}
+		if count != 1 {
+			return ErrOriginalBodyUnavailable
+		}
+	} else if db.Dialector.Name() == "sqlite" {
+		if e := db.Raw("SELECT count(*) FROM sqlite_master WHERE type='trigger' AND tbl_name='original_body_lease_scopes' AND name IN ('original_body_lease_scope_immutable_update','original_body_lease_scope_immutable_delete')").Scan(&count).Error; e != nil {
+			return e
+		}
+		if count != 2 {
+			return ErrOriginalBodyUnavailable
+		}
+	} else {
+		return ErrOriginalBodyUnavailable
+	}
+	return nil
+}
+
+func bodyLeaseScopesComplete(rows []originalBodyLeaseScope, tenant uint64) bool {
+	for _, row := range rows {
+		if row.TenantID == tenant && row.KnowledgeBaseID == "" {
+			return true
+		}
+	}
+	return false
+}
