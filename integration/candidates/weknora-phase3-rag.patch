diff --git a/internal/types/knowledge_enrichment_templates.go b/internal/types/knowledge_enrichment_templates.go
new file mode 100644
index 0000000000000000000000000000000000000000..0026eb5d64f54910348169efc230d9538e27e1a3
--- /dev/null
+++ b/internal/types/knowledge_enrichment_templates.go
@@ -0,0 +1,53 @@
+package types
+
+import (
+	"database/sql/driver"
+	"encoding/json"
+)
+
+// KnowledgeEnrichmentTemplates are actual KB configuration inputs. Their
+// origin is the private configuration receipt, never a client lineage claim.
+type KnowledgeEnrichmentTemplates struct {
+	Summary  string `json:"summary,omitempty"`
+	Question string `json:"question,omitempty"`
+}
+
+func (c KnowledgeEnrichmentTemplates) Value() (driver.Value, error) { return json.Marshal(c) }
+func (c *KnowledgeEnrichmentTemplates) Scan(value any) error {
+	if value == nil {
+		return nil
+	}
+	var data []byte
+	switch v := value.(type) {
+	case []byte:
+		data = v
+	case string:
+		data = []byte(v)
+	default:
+		return ErrSourceLineageUnknown
+	}
+	return json.Unmarshal(data, c)
+}
+func (c *KnowledgeEnrichmentTemplates) Content(purpose string) string {
+	if c == nil {
+		return ""
+	}
+	if purpose == "summary" {
+		return c.Summary
+	}
+	if purpose == "question" {
+		return c.Question
+	}
+	return ""
+}
+func (c *KnowledgeEnrichmentTemplates) Set(purpose, content string) error {
+	if purpose == "summary" {
+		c.Summary = content
+		return nil
+	}
+	if purpose == "question" {
+		c.Question = content
+		return nil
+	}
+	return ErrSourceLineageUnknown
+}
