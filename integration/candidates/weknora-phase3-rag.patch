+func (s *KnowledgeInputProvenanceStore) VerifyNextcloudOriginalDocumentTask(ctx context.Context, p types.DocumentProcessPayload) error {
+	original := &types.KnowledgeBuildInputProof{TenantID: p.TenantID, KnowledgeBaseID: p.KnowledgeBaseID, KnowledgeID: p.KnowledgeID}
+	actual, err := readOriginalUploadActual(s.db.WithContext(ctx), original)
+	if err != nil {
+		return err
+	}
+	if actual.TaskControls == nil || p.URL != "" || len(p.Passages) > 0 {
+		return ErrKnowledgeInputChanged
+	}
+	controls := nextcloudOriginalDocumentTaskControls{p.Language, p.FileName, p.FileType, p.EnableMultimodel, p.EnableQuestionGeneration, p.QuestionCount}
+	wanted, err := KnowledgeInputDigest(actual.TaskControls)
+	if err != nil {
+		return err
+	}
+	got, err := KnowledgeInputDigest(controls)
+	if err != nil || wanted != got {
+		return ErrKnowledgeInputChanged
+	}
+	var k types.Knowledge
+	if err := s.db.WithContext(ctx).Where("id = ? AND tenant_id = ? AND knowledge_base_id = ?", p.KnowledgeID, p.TenantID, p.KnowledgeBaseID).Take(&k).Error; err != nil {
+		return err
+	}
+	if p.FilePath != k.FilePath || p.FilePath == "" {
+		return ErrKnowledgeInputChanged
+	}
+	return nil
+}
+func (s *KnowledgeInputProvenanceStore) verifyOriginalUploadInTx(tx *gorm.DB, k *types.Knowledge, input []byte, path string, initial bool) (*nextcloudOriginalUploadInput, error) {
+	var receipt nextcloudOriginalUploadInput
+	if err := tx.Where("knowledge_id = ? AND tenant_id = ? AND knowledge_base_id = ?", k.ID, k.TenantID, k.KnowledgeBaseID).Take(&receipt).Error; err != nil {
+		return nil, err
+	}
+	var actual nextcloudOriginalUploadActual
+	if json.Unmarshal([]byte(receipt.ActualInputs), &actual) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	digest, err := KnowledgeInputDigest(actual)
+	if err != nil || digest != receipt.InputDigest {
+		return nil, ErrKnowledgeInputChanged
+	}
+	_, pair, err := originalUploadSourceInTx(tx, k, nextcloudFetchedArtifactContext{Actual: actual.Artifact, DataSourceID: receipt.DataSourceID})
+	if err != nil {
+		return nil, err
+	}
+	if actual.PairOperation != pair.OperationID || actual.BaseURL != pair.BaseURL || actual.ConfigSHA != pair.ConfigSHA {
+		return nil, ErrKnowledgeInputChanged
+	}
+	revision, err := nextcloudUploadSourceRevision(tx, receipt.DataSourceID)
+	if err != nil || revision != receipt.SourceRevision {
+		return nil, ErrKnowledgeInputChanged
+	}
+	if initial {
+		if err := s.recheckDataSourceNameInput(tx, actual.Name); err != nil {
+			return nil, err
+		}
+		hash := sha256.Sum256(input)
+		if path == "" || path != k.FilePath || receipt.ArtifactDigest != hex.EncodeToString(hash[:]) {
+			return nil, ErrKnowledgeInputChanged
+		}
+		root, err := originalUploadRootDigest(k)
+		if err != nil || root != receipt.RootDigest {
+			return nil, ErrKnowledgeInputChanged
+		}
+		revision, err := knowledgeEnrichmentRevision(tx, "knowledge", k.ID)
+		if err != nil || revision != receipt.RootRevision {
+			return nil, ErrKnowledgeInputChanged
+		}
+		var kb types.KnowledgeBase
+		if err := tx.Where("id = ? AND tenant_id = ?", k.KnowledgeBaseID, k.TenantID).Take(&kb).Error; err != nil {
+			return nil, err
+		}
+		digest, err := knowledgeConfigDigest(&kb, k)
+		if err != nil || digest != receipt.ConfigDigest {
+			return nil, ErrKnowledgeInputChanged
+		}
+		revision, err = knowledgeConfigurationControlRevision(tx, kb.ID)
+		if err != nil || revision != receipt.ConfigRevision {
+			return nil, ErrKnowledgeInputChanged
+		}
+		routing, err := knowledgeEnrichmentRoutingDigest(&kb)
+		if err != nil || routing != receipt.RoutingDigest {
+			return nil, ErrKnowledgeInputChanged
+		}
+		routingRevision, err := knowledgeEnrichmentRevision(tx, "routing", kb.ID)
+		if err != nil || routingRevision != receipt.RoutingRevision {
+			return nil, ErrKnowledgeInputChanged
+		}
+		var tenant types.Tenant
+		if err := tx.Where("id = ?", k.TenantID).Take(&tenant).Error; err != nil {
+			return nil, err
+		}
+		digest, err = knowledgeProducerTenantDigest(&tenant)
+		if err != nil || digest != receipt.TenantDigest {
+			return nil, ErrKnowledgeInputChanged
+		}
+		revision, err = knowledgeEnrichmentRevision(tx, "tenant", strconv.FormatUint(k.TenantID, 10))
+		if err != nil || revision != receipt.TenantRevision {
+			return nil, ErrKnowledgeInputChanged
+		}
+	}
+	return &receipt, nil
+}
+func (s *KnowledgeInputProvenanceStore) AdmitNextcloudBuildInputsFromOriginalUpload(ctx context.Context, input []byte, path string) (*types.KnowledgeBuildInputProof, error) {
+	_, scope, err := NextcloudBuildInputLease(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var k types.Knowledge
+	if err := s.db.WithContext(ctx).Where("id = ? AND tenant_id = ? AND knowledge_base_id = ?", scope.KnowledgeID, scope.TenantID, scope.KnowledgeBaseID).Take(&k).Error; err != nil {
+		return nil, err
+	}
+	receipt, err := s.verifyOriginalUploadInTx(s.db.WithContext(ctx), &k, input, path, true)
+	if err != nil {
+		return nil, err
+	}
+	var actual nextcloudOriginalUploadActual
+	if json.Unmarshal([]byte(receipt.ActualInputs), &actual) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	ds, _, err := originalUploadSourceInTx(s.db.WithContext(ctx), &k, nextcloudFetchedArtifactContext{Actual: actual.Artifact, DataSourceID: receipt.DataSourceID})
+	if err != nil {
+		return nil, err
+	}
+	cfg, err := ds.ParseConfig()
+	if err != nil {
+		return nil, err
+	}
+	cfg.Type = ds.Type
+	id, err := strconv.ParseInt(actual.Artifact.FileID, 10, 64)
+	if err != nil {
+		return nil, err
+	}
+	if err := nextcloud.CheckCurrentPublication(ctx, cfg, actual.Artifact.InstanceID, actual.Artifact.BindingID, id, actual.Artifact.ETag, actual.Artifact.Path); err != nil {
+		return nil, err
+	}
+	return s.AdmitNextcloudBuildInputs(context.WithValue(ctx, nextcloudOriginalUploadBuildKey{}, path), input)
+}
diff --git a/internal/application/repository/nextcloud_profile_write_fence_pg_test.go b/internal/application/repository/nextcloud_profile_write_fence_pg_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ce04983e3f813150fd9291b86db751726647e1dd
--- /dev/null
+++ b/internal/application/repository/nextcloud_profile_write_fence_pg_test.go
@@ -0,0 +1,63 @@
+package repository
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPostgresNextcloudProfileWriteWaitsForSourceMarker(t *testing.T) {
+	// leaseTestPostgres gives this test its own schema in disposable PostgreSQL.
+	db := leaseTestPostgres(t)
+	require.NoError(t, db.Exec(`CREATE TABLE knowledge_bases (
+		id TEXT PRIMARY KEY, generated_profile JSONB,
+		ever_had_nextcloud_source BOOLEAN NOT NULL DEFAULT FALSE,
+		updated_at TIMESTAMPTZ,
+		deleted_at TIMESTAMPTZ
+	)`).Error)
+	require.NoError(t, db.Exec(`INSERT INTO knowledge_bases (id) VALUES ('racing'), ('ordinary')`).Error)
+	profiles := NewKnowledgeBaseRepository(db)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+
+	// Registration holds the KB row while it marks source provenance. The
+	// generated-profile write must wait and then re-evaluate its WHERE clause.
+	mark := db.WithContext(ctx).Begin()
+	require.NoError(t, mark.Error)
+	defer mark.Rollback()
+	require.NoError(t, mark.Exec(`UPDATE knowledge_bases
+		SET ever_had_nextcloud_source = TRUE WHERE id = 'racing'`).Error)
+	started := make(chan struct{})
+	finished := make(chan error, 1)
+	go func() {
+		close(started)
+		finished <- profiles.UpdateKnowledgeBaseGeneratedProfile(ctx, "racing",
+			&types.KnowledgeBaseProfile{Gist: "stale generated profile"})
+	}()
+	<-started
+	select {
+	case err := <-finished:
+		t.Fatalf("profile write crossed uncommitted source marker: %v", err)
+	case <-time.After(100 * time.Millisecond):
+	}
+	require.NoError(t, mark.Commit().Error)
+	select {
+	case err := <-finished:
+		require.ErrorIs(t, err, types.ErrKnowledgeBaseProfileUnsupported)
+	case <-ctx.Done():
+		t.Fatal("profile write did not resume after source marker committed")
+	}
+	var stored string
+	require.NoError(t, db.Raw(`SELECT COALESCE(generated_profile::TEXT, '')
+		FROM knowledge_bases WHERE id = 'racing'`).Scan(&stored).Error)
+	require.Empty(t, stored)
+
+	require.NoError(t, profiles.UpdateKnowledgeBaseGeneratedProfile(ctx, "ordinary",
+		&types.KnowledgeBaseProfile{Gist: "ordinary profile"}))
+	require.NoError(t, db.Raw(`SELECT generated_profile::TEXT
+		FROM knowledge_bases WHERE id = 'ordinary'`).Scan(&stored).Error)
+	require.Contains(t, stored, "ordinary profile")
+}
diff --git a/internal/application/repository/nextcloud_publication_recovery.go b/internal/application/repository/nextcloud_publication_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..46a4ac1c2f643622ac9fd5f5320108a77b8083a0
--- /dev/null
+++ b/internal/application/repository/nextcloud_publication_recovery.go
@@ -0,0 +1,863 @@
+package repository
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/datasource/connector/nextcloud"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+var ErrNextcloudRecoveryDenied = errors.New("Nextcloud publication recovery evidence denied")
+var recoveryHash = regexp.MustCompile(`^[a-f0-9]{64}$`)
+var recoveryID = regexp.MustCompile(`^[A-Za-z0-9_-]{1,128}$`)
+var recoveryStream = regexp.MustCompile(`^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$`)
+
+type NextcloudRecoveryPlan struct {
+	SchemaVersion                       int                        `json:"schema_version"`
+	InstanceID                          string                     `json:"instance_id"`
+	StreamID                            string                     `json:"stream_id"`
+	CheckpointRecordSHA256              string                     `json:"checkpoint_record_sha256"`
+	RecoveryRecordSHA256                string                     `json:"recovery_record_sha256"`
+	CheckpointSequence                  string                     `json:"checkpoint_sequence"`
+	CheckpointDatabaseChainSHA256       string                     `json:"checkpoint_database_chain_sha256"`
+	ThroughSequence                     string                     `json:"through_sequence"`
+	ThroughDatabaseChainSHA256          string                     `json:"through_database_chain_sha256"`
+	DatabasePrefixHashes                map[string]string          `json:"database_prefix_hashes"`
+	CloseBindings                       []NextcloudRecoveryBinding `json:"close_bindings"`
+	WithdrawFiles                       []NextcloudRecoveryFile    `json:"withdraw_files"`
+	AuthoritativeReconciliationRequired bool                       `json:"authoritative_reconciliation_required"`
+	IngressReopenPermitted              bool                       `json:"ingress_reopen_permitted"`
+	digest                              string
+	raw                                 string
+}
+
+type NextcloudRecoveryBinding struct {
+	BindingID    string `json:"binding_id"`
+	LastSequence string `json:"last_sequence"`
+}
+type NextcloudRecoveryFile struct {
+	BindingID    string `json:"binding_id"`
+	FileID       string `json:"file_id"`
+	LastSequence string `json:"last_sequence"`
+}
+
+type NextcloudRecoveryAnchor struct {
+	InstanceID          string `json:"instance_id"`
+	StreamID            string `json:"stream_id"`
+	RecordSHA256        string `json:"record_sha256"`
+	Sequence            string `json:"sequence"`
+	DatabaseChainSHA256 string `json:"database_chain_sha256"`
+}
+
+// This tuple is always read from the pairing registry, never reconstructed from
+// client metadata. The externally pinned backup inventory binds every field.
+type NextcloudRecoveryPair struct {
+	OperationID      string `json:"operation_id"`
+	TenantID         uint64 `json:"tenant_id"`
+	KnowledgeBaseID  string `json:"knowledge_base_id"`
+	DataSourceID     string `json:"datasource_id"`
+	InstanceID       string `json:"instance_id"`
+	BindingID        string `json:"binding_id"`
+	BaseURL          string `json:"base_url"`
+	ConfigSHA256     string `json:"config_sha256"`
+	PublicationEpoch int64  `json:"publication_epoch"`
+	KeyID            string `json:"key_id"`
+	State            string `json:"state"`
+}
+
+type NextcloudRecoveryInventory struct {
+	SchemaVersion     int                     `json:"schema_version"`
+	Anchor            NextcloudRecoveryAnchor `json:"anchor"`
+	Pairs             []NextcloudRecoveryPair `json:"pairs"`
+	SourceStateSHA256 string                  `json:"source_state_sha256"`
+}
+
+type NextcloudRecoveryReceipt struct {
+	PlanSHA256             string    `json:"plan_sha256" gorm:"primaryKey"`
+	InstanceID             string    `json:"instance_id"`
+	StreamID               string    `json:"stream_id"`
+	CheckpointRecordSHA256 string    `json:"checkpoint_record_sha256"`
+	RecoveryRecordSHA256   string    `json:"recovery_record_sha256"`
+	CheckpointSequence     int64     `json:"checkpoint_sequence"`
+	ThroughSequence        int64     `json:"through_sequence"`
+	InventorySHA256        string    `json:"inventory_sha256"`
+	PlanJSON               string    `json:"-"`
+	PairCount              int       `json:"pair_count"`
+	ClosedAt               time.Time `json:"closed_at"`
+}
+
+func (NextcloudRecoveryReceipt) TableName() string { return "nextcloud_publication_recovery_receipts" }
+
+type nextcloudRecoveryScope struct {
+	PlanSHA256             string `gorm:"primaryKey"`
+	OperationID            string `gorm:"primaryKey"`
+	TenantID               uint64
+	KnowledgeBaseID        string
+	DataSourceID           string `gorm:"column:datasource_id"`
+	InstanceID             string
+	BindingID              string
+	PairSHA256             string
+	RetiredGenerationsJSON string
+	ClosedKBEpoch          int64
+	State                  string
+	ReconciliationSHA256   string
+	ReconciliationJSON     string
+	ReconciledAt           *time.Time
+}
+
+func (nextcloudRecoveryScope) TableName() string { return "nextcloud_publication_recovery_scopes" }
+
+type NextcloudRecoveryReconciliationReceipt struct {
+	PlanSHA256           string                     `json:"plan_sha256"`
+	OperationID          string                     `json:"operation_id"`
+	PairSHA256           string                     `json:"pair_sha256"`
+	ReconciliationSHA256 string                     `json:"reconciliation_sha256"`
+	Manifest             nextcloud.RecoveryManifest `json:"manifest"`
+	ReconciledAt         time.Time                  `json:"reconciled_at"`
+}
+
+type nextcloudRecoveryRetiredGeneration struct {
+	KnowledgeID string `json:"knowledge_id"`
+	Epoch       int64  `json:"epoch"`
+}
+
+type nextcloudRecoveryRevision struct {
+	TenantID             uint64
+	KnowledgeBaseID      string
+	DataSourceID         string `gorm:"column:datasource_id"`
+	ExternalID           string
+	Revision             int64
+	DesiredETag          string `gorm:"column:desired_etag"`
+	CandidateKnowledgeID string
+	State                string
+	SourceUpdatedAt      time.Time
+	RecordedAt           time.Time
+	LegacyHistoryUnknown bool
+}
+
+type NextcloudPublicationRecoveryStore struct{ db *gorm.DB }
+
+func NewNextcloudPublicationRecoveryStore(db *gorm.DB) *NextcloudPublicationRecoveryStore {
+	return &NextcloudPublicationRecoveryStore{db}
+}
+func recoverySHA(data []byte) string { hash := sha256.Sum256(data); return hex.EncodeToString(hash[:]) }
+func recoveryJSONSHA(v any) (string, error) {
+	b, e := json.Marshal(v)
+	if e != nil {
+		return "", e
+	}
+	return recoverySHA(b), nil
+}
+func recoverySequence(v string) (int64, error) {
+	n, e := strconv.ParseInt(v, 10, 64)
+	if e != nil || n < 0 || strconv.FormatInt(n, 10) != v {
+		return 0, ErrNextcloudRecoveryDenied
+	}
+	return n, nil
+}
+
+// Reject duplicate keys even in nested objects. DisallowUnknownFields alone
+// accepts duplicate fields and makes signed scope parsing ambiguous.
+func recoveryStrictJSON(data []byte, out any) error {
+	if len(data) == 0 || len(data) > 16<<20 {
+		return ErrNextcloudRecoveryDenied
+	}
+	d := json.NewDecoder(bytes.NewReader(data))
+	var walk func() error
+	walk = func() error {
+		token, e := d.Token()
+		if e != nil {
+			return e
+		}
+		delim, ok := token.(json.Delim)
+		if !ok {
+			return nil
+		}
+		switch delim {
+		case '{':
+			seen := map[string]bool{}
+			for d.More() {
+				k, e := d.Token()
+				if e != nil {
+					return e
+				}
+				key, ok := k.(string)
+				if !ok || seen[key] {
+					return ErrNextcloudRecoveryDenied
+				}
+				seen[key] = true
+				if e = walk(); e != nil {
+					return e
+				}
+			}
+			_, e = d.Token()
+			return e
+		case '[':
+			for d.More() {
+				if e = walk(); e != nil {
+					return e
+				}
+			}
+			_, e = d.Token()
+			return e
+		}
+		return ErrNextcloudRecoveryDenied
+	}
+	if e := walk(); e != nil {
+		return ErrNextcloudRecoveryDenied
+	}
+	if _, e := d.Token(); e != io.EOF {
+		return ErrNextcloudRecoveryDenied
+	}
+	d = json.NewDecoder(bytes.NewReader(data))
+	d.DisallowUnknownFields()
+	if e := d.Decode(out); e != nil {
+		return ErrNextcloudRecoveryDenied
+	}
+	return nil
+}
+
+// Verifies exactly the signed plan bytes emitted by the external Python journal.
+// Callers cannot manufacture a verified plan by filling an exported struct.
+func VerifyNextcloudRecoveryPlan(envelope, key []byte) (*NextcloudRecoveryPlan, error) {
+	var signed struct {
+		Plan       string `json:"plan"`
+		HMACSHA256 string `json:"hmac_sha256"`
+	}
+	if len(key) != 32 || recoveryStrictJSON(envelope, &signed) != nil || !recoveryHash.MatchString(signed.HMACSHA256) {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	signature, _ := hex.DecodeString(signed.HMACSHA256)
+	mac := hmac.New(sha256.New, key)
+	mac.Write([]byte(signed.Plan))
+	if !hmac.Equal(signature, mac.Sum(nil)) {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	var fields map[string]json.RawMessage
+	if json.Unmarshal([]byte(signed.Plan), &fields) != nil || len(fields) != 14 {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	for _, value := range fields {
+		if bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+	}
+	var p NextcloudRecoveryPlan
+	if recoveryStrictJSON([]byte(signed.Plan), &p) != nil {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	start, e := recoverySequence(p.CheckpointSequence)
+	if e != nil {
+		return nil, e
+	}
+	end, e := recoverySequence(p.ThroughSequence)
+	if e != nil || end < start || end-start > 1000000 || p.SchemaVersion != 1 || !recoveryID.MatchString(p.InstanceID) || len(p.InstanceID) > 64 || !recoveryStream.MatchString(p.StreamID) || !p.AuthoritativeReconciliationRequired || p.IngressReopenPermitted {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	for _, v := range []string{p.CheckpointRecordSHA256, p.RecoveryRecordSHA256, p.CheckpointDatabaseChainSHA256, p.ThroughDatabaseChainSHA256} {
+		if !recoveryHash.MatchString(v) {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+	}
+	if len(p.DatabasePrefixHashes) != int(end-start+1) || p.DatabasePrefixHashes[p.CheckpointSequence] != p.CheckpointDatabaseChainSHA256 || p.DatabasePrefixHashes[p.ThroughSequence] != p.ThroughDatabaseChainSHA256 {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	for i := start; i <= end; i++ {
+		if !recoveryHash.MatchString(p.DatabasePrefixHashes[strconv.FormatInt(i, 10)]) {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		if i == math.MaxInt64 {
+			break
+		}
+	}
+	bindings := map[string]int64{}
+	previous := ""
+	for _, b := range p.CloseBindings {
+		seq, e := recoverySequence(b.LastSequence)
+		if e != nil || seq <= start || seq > end || !recoveryID.MatchString(b.BindingID) || b.BindingID <= previous {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		bindings[b.BindingID] = seq
+		previous = b.BindingID
+	}
+	previous = ""
+	previousFile := ""
+	for _, f := range p.WithdrawFiles {
+		seq, e := recoverySequence(f.LastSequence)
+		fid, fe := recoverySequence(f.FileID)
+		if e != nil || fe != nil || fid < 1 || seq <= start || seq > end || bindings[f.BindingID] < seq || f.BindingID < previous || (f.BindingID == previous && f.FileID <= previousFile) {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		previous = f.BindingID
+		previousFile = f.FileID
+	}
+	p.digest = recoverySHA([]byte(signed.Plan))
+	p.raw = signed.Plan
+	return &p, nil
+}
+
+func recoveryPair(p NextcloudSourcePairing) NextcloudRecoveryPair {
+	return NextcloudRecoveryPair{p.OperationID, p.TenantID, p.KnowledgeBaseID, p.DataSourceID, p.InstanceID, p.BindingID, p.BaseURL, p.ConfigSHA, p.PublicationEpoch, p.KeyID, p.State}
+}
+
+// Capture inventories the actual local DB. It must be retained and independently
+// pinned outside restored volumes together with the external checkpoint anchor.
+func (s *NextcloudPublicationRecoveryStore) Capture(ctx context.Context, anchor NextcloudRecoveryAnchor) (*NextcloudRecoveryInventory, error) {
+	if !recoveryID.MatchString(anchor.InstanceID) || !recoveryStream.MatchString(anchor.StreamID) || !recoveryHash.MatchString(anchor.RecordSHA256) || !recoveryHash.MatchString(anchor.DatabaseChainSHA256) {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	if _, e := recoverySequence(anchor.Sequence); e != nil {
+		return nil, e
+	}
+	var result *NextcloudRecoveryInventory
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var pairs []NextcloudSourcePairing
+		if e := tx.Where("nextcloud_instance_id=?", anchor.InstanceID).Order("operation_id").Find(&pairs).Error; e != nil {
+			return e
+		}
+		now, e := nextcloudLeaseNowMS(tx)
+		if e != nil {
+			return e
+		}
+		for _, p := range pairs {
+			if _, e = nextcloudLockKBFence(tx, p.TenantID, p.KnowledgeBaseID, now); e != nil {
+				return e
+			}
+		}
+		result, e = s.captureInTx(tx, anchor)
+		return e
+	})
+	return result, err
+}
+
+func (s *NextcloudPublicationRecoveryStore) captureInTx(tx *gorm.DB, a NextcloudRecoveryAnchor) (*NextcloudRecoveryInventory, error) {
+	var pairs []NextcloudSourcePairing
+	if e := tx.Where("nextcloud_instance_id = ?", a.InstanceID).Order("operation_id").Find(&pairs).Error; e != nil {
+		return nil, e
+	}
+	if len(pairs) == 0 {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	// A source whose instance cannot be resolved cannot be classified as absent.
+	var unpaired int64
+	if e := tx.Table("data_sources ds").Where("ds.type = ? AND ds.deleted_at IS NULL AND NOT EXISTS (SELECT 1 FROM nextcloud_source_pairings p WHERE p.datasource_id=ds.id AND p.tenant_id=ds.tenant_id AND p.knowledge_base_id=ds.knowledge_base_id)", types.ConnectorTypeNextcloud).Count(&unpaired).Error; e != nil {
+		return nil, e
+	}
+	if unpaired != 0 {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	inv := &NextcloudRecoveryInventory{SchemaVersion: 1, Anchor: a, Pairs: make([]NextcloudRecoveryPair, 0, len(pairs))}
+	states := make([]any, 0, len(pairs))
+	for _, p := range pairs {
+		if p.TenantID == 0 || p.TenantID > math.MaxInt64 || p.OperationID == "" || p.KnowledgeBaseID == "" || p.DataSourceID == "" || p.PublicationEpoch < 0 || p.KeyID == "" || (p.State != "active" && p.State != "pending") {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		var kb types.KnowledgeBase
+		if e := tx.Select("id", "tenant_id", "deleted_at").Where("id=? AND tenant_id=? AND deleted_at IS NULL", p.KnowledgeBaseID, p.TenantID).Take(&kb).Error; e != nil {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		var ds types.DataSource
+		if e := tx.Where("id=? AND tenant_id=? AND knowledge_base_id=? AND type=? AND deleted_at IS NULL", p.DataSourceID, p.TenantID, p.KnowledgeBaseID, types.ConnectorTypeNextcloud).Take(&ds).Error; e != nil {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		base, hash, binding, e := NextcloudEventDataSourceIdentity(ds.Config)
+		parsed, parseErr := ds.ParseConfig()
+		configuredKey := ""
+		if parsed != nil {
+			configuredKey, _ = parsed.Credentials["key_id"].(string)
+		}
+		if parseErr != nil || configuredKey != p.KeyID || e != nil || base != p.BaseURL || hash != p.ConfigSHA || binding != p.BindingID {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		var versions []nextcloudSourceVersion
+		if e = tx.Where("tenant_id=? AND knowledge_base_id=? AND datasource_id=?", p.TenantID, p.KnowledgeBaseID, p.DataSourceID).Order("external_id").Find(&versions).Error; e != nil {
+			return nil, e
+		}
+		var revisions []nextcloudRecoveryRevision
+		if e = tx.Table("nextcloud_source_revisions").Where("tenant_id=? AND knowledge_base_id=? AND datasource_id=?", p.TenantID, p.KnowledgeBaseID, p.DataSourceID).Order("external_id,revision").Find(&revisions).Error; e != nil {
+			return nil, e
+		}
+		latest := map[string]nextcloudRecoveryRevision{}
+		for _, revision := range revisions {
+			prior := latest[revision.ExternalID]
+			if revision.Revision != prior.Revision+1 {
+				return nil, ErrNextcloudRecoveryDenied
+			}
+			latest[revision.ExternalID] = revision
+		}
+		for _, version := range versions {
+			revision, ok := latest[version.ExternalID]
+			if !ok || revision.DesiredETag != version.DesiredETag || revision.CandidateKnowledgeID != version.CandidateKnowledgeID || revision.State != version.State || !revision.SourceUpdatedAt.Equal(version.UpdatedAt) {
+				return nil, ErrNextcloudRecoveryDenied
+			}
+		}
+		if len(latest) != len(versions) {
+			return nil, ErrNextcloudRecoveryDenied
+		}
+		var rows []types.Knowledge
+		if e = tx.Unscoped().Where("tenant_id=? AND knowledge_base_id=? AND channel=?", p.TenantID, p.KnowledgeBaseID, types.ConnectorTypeNextcloud).Order("id").Find(&rows).Error; e != nil {
+			return nil, e
+		}
+		rowIDs := map[string]bool{}
+		knowledge := make([]any, 0, len(rows))
+		for _, k := range rows {
+			m, e := strictLineageKnowledgeMetadata(k.Metadata)
+			fid, fe := recoverySequence(m["nextcloud_file_id"])
+			if e != nil || fe != nil || fid < 1 || m["datasource_id"] != p.DataSourceID || m["nextcloud_instance_id"] != p.InstanceID || m["nextcloud_binding_id"] != p.BindingID || m["source_resource_id"] != p.BindingID || m["external_id"] != "nextcloud:"+p.InstanceID+":"+m["nextcloud_file_id"] {
+				return nil, ErrNextcloudRecoveryDenied
+			}
+			rowIDs[k.ID] = true
+			knowledge = append(knowledge, struct {
+				ID                        string
+				Metadata                  types.JSON
+				FilePath, FileType        string
+				StorageSize               int64
+				ParseStatus, EnableStatus string
+				Deleted                   bool
+			}{k.ID, k.Metadata, k.FilePath, k.FileType, k.StorageSize, k.ParseStatus, k.EnableStatus, k.DeletedAt.Valid})
+		}
+		for _, v := range versions {
+			suffix := strings.TrimPrefix(v.ExternalID, "nextcloud:"+p.InstanceID+":")
+			fid, fe := recoverySequence(suffix)
+			if fe != nil || fid < 1 || suffix == v.ExternalID || (v.CandidateKnowledgeID != "" && !rowIDs[v.CandidateKnowledgeID]) {
+				return nil, ErrNextcloudRecoveryDenied
+			}
+		}
+		var fences []nextcloudContentFence
+		if e = tx.Where("tenant_id=? AND knowledge_base_id=?", p.TenantID, p.KnowledgeBaseID).Order("knowledge_id").Find(&fences).Error; e != nil {
+			return nil, e
+		}
+		inv.Pairs = append(inv.Pairs, recoveryPair(p))
+		states = append(states, struct {
+			Pair      NextcloudRecoveryPair
+			Status    string
+			Versions  []nextcloudSourceVersion
+			Revisions []nextcloudRecoveryRevision
+			Knowledge []any
+			Fences    []nextcloudContentFence
+		}{recoveryPair(p), ds.Status, versions, revisions, knowledge, fences})
+	}
+	var e error
+	inv.SourceStateSHA256, e = recoveryJSONSHA(states)
+	return inv, e
+}
+
+func DecodeNextcloudRecoveryInventory(data []byte, pin string) (*NextcloudRecoveryInventory, error) {
+	if !recoveryHash.MatchString(pin) || recoverySHA(data) != pin {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	var inv NextcloudRecoveryInventory
+	if recoveryStrictJSON(data, &inv) != nil || inv.SchemaVersion != 1 || len(inv.Pairs) == 0 || !recoveryHash.MatchString(inv.SourceStateSHA256) {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	return &inv, nil
+}
+
+// Apply retires every restored pair for the anchored instance, including pairs
+// untouched by the replay interval. It preserves rows and physical objects.
+func (s *NextcloudPublicationRecoveryStore) Apply(ctx context.Context, p *NextcloudRecoveryPlan, inv *NextcloudRecoveryInventory, pin string) (*NextcloudRecoveryReceipt, error) {
+	if p == nil || p.digest == "" || p.raw == "" || recoverySHA([]byte(p.raw)) != p.digest || inv == nil {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	var original NextcloudRecoveryPlan
+	if recoveryStrictJSON([]byte(p.raw), &original) != nil {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	provided, _ := recoveryJSONSHA(p)
+	verified, _ := recoveryJSONSHA(original)
+	if provided != verified {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	ih, e := recoveryJSONSHA(inv)
+	if e != nil || ih != pin || inv.SchemaVersion != 1 || inv.Anchor.InstanceID != p.InstanceID || inv.Anchor.StreamID != p.StreamID || inv.Anchor.RecordSHA256 != p.CheckpointRecordSHA256 || inv.Anchor.Sequence != p.CheckpointSequence || inv.Anchor.DatabaseChainSHA256 != p.CheckpointDatabaseChainSHA256 {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	var result NextcloudRecoveryReceipt
+	e = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// Serialize with every writer before checking the pinned restored snapshot.
+		nowMS, e := nextcloudLeaseNowMS(tx)
+		if e != nil {
+			return e
+		}
+		for _, pair := range inv.Pairs {
+			if _, e := nextcloudLockKBFence(tx, pair.TenantID, pair.KnowledgeBaseID, nowMS); e != nil {
+				return e
+			}
+		}
+		var existing NextcloudRecoveryReceipt
+		er := tx.Where("instance_id=? AND stream_id=? AND checkpoint_record_sha256=?", p.InstanceID, p.StreamID, p.CheckpointRecordSHA256).Take(&existing).Error
+		if er == nil {
+			if existing.PlanSHA256 != p.digest || existing.InventorySHA256 != pin {
+				return ErrNextcloudRecoveryDenied
+			}
+			existing.ClosedAt = existing.ClosedAt.UTC()
+			result = existing
+			return s.checkReceiptScopes(tx, existing, inv)
+		}
+		if !errors.Is(er, gorm.ErrRecordNotFound) {
+			return er
+		}
+		var prior int64
+		if e := tx.Model(&NextcloudRecoveryReceipt{}).Where("instance_id=? AND (stream_id<>? OR through_sequence>?)", p.InstanceID, p.StreamID, mustRecoverySequence(p.CheckpointSequence)).Count(&prior).Error; e != nil {
+			return e
+		}
+		if prior != 0 {
+			return ErrNextcloudRecoveryDenied
+		}
+		current, e := s.captureInTx(tx, inv.Anchor)
+		if e != nil {
+			return e
+		}
+		actual, e := recoveryJSONSHA(current)
+		if e != nil || actual != pin {
+			return ErrNextcloudRecoveryDenied
+		}
+		// Unknown interval bindings are proven absent only after the complete paired
+		// source registry and pinned inventory have matched. They authorize nothing.
+		now := time.Now().UTC().Truncate(time.Microsecond)
+		leases := NewNextcloudContentLeaseStore(s.db)
+		result = NextcloudRecoveryReceipt{p.digest, p.InstanceID, p.StreamID, p.CheckpointRecordSHA256, p.RecoveryRecordSHA256, mustRecoverySequence(p.CheckpointSequence), mustRecoverySequence(p.ThroughSequence), pin, p.raw, len(inv.Pairs), now}
+		if e := tx.Create(&result).Error; e != nil {
+			return e
+		}
+		for _, pair := range inv.Pairs {
+			var rows []types.Knowledge
+			if e := tx.Unscoped().Where("tenant_id=? AND knowledge_base_id=? AND channel=?", pair.TenantID, pair.KnowledgeBaseID, types.ConnectorTypeNextcloud).Order("id").Find(&rows).Error; e != nil {
+				return e
+			}
+			for _, row := range rows {
+				metadata, e := strictLineageKnowledgeMetadata(row.Metadata)
+				if e != nil {
+					return e
+				}
+				scope := NextcloudContentScope{pair.TenantID, pair.KnowledgeBaseID, row.ID, pair.DataSourceID, metadata["external_id"]}
+				if e = leases.RetireKnowledgeInTx(ctx, tx, scope); e != nil {
+					return e
+				}
+				if e = writeNextcloudETag(tx, &row, ""); e != nil {
+					return e
+				}
+			}
+			if e := tx.Model(&nextcloudSourceVersion{}).Where("tenant_id=? AND knowledge_base_id=? AND datasource_id=?", pair.TenantID, pair.KnowledgeBaseID, pair.DataSourceID).Updates(map[string]any{"state": "tombstone", "candidate_knowledge_id": "", "desired_etag": "", "updated_at": now}).Error; e != nil {
+				return e
+			}
+			for _, file := range p.WithdrawFiles {
+				if file.BindingID != pair.BindingID {
+					continue
+				}
+				v := nextcloudSourceVersion{TenantID: pair.TenantID, KnowledgeBaseID: pair.KnowledgeBaseID, DataSourceID: pair.DataSourceID, ExternalID: "nextcloud:" + pair.InstanceID + ":" + file.FileID, State: "tombstone", UpdatedAt: now}
+				if e := tx.Where("tenant_id=? AND knowledge_base_id=? AND datasource_id=? AND external_id=?", v.TenantID, v.KnowledgeBaseID, v.DataSourceID, v.ExternalID).FirstOrCreate(&v).Error; e != nil {
+					return e
+				}
+			}
+			if e := leases.RetireKBInTx(ctx, tx, pair.TenantID, pair.KnowledgeBaseID); e != nil {
+				return e
+			}
+			// Restored GC claims are as stale as restored workers. Revoke their epochs
+			// without touching objects; unknown external inventory cannot be collected.
+			if e := tx.Exec("UPDATE nextcloud_content_fences SET state='retired',epoch=epoch+1,claim_token='',claim_until_ms=NULL,retired_at_ms=?,updated_at_ms=? WHERE tenant_id=? AND knowledge_base_id=? AND state='deleting'", nowMS, nowMS, pair.TenantID, pair.KnowledgeBaseID).Error; e != nil {
+				return e
+			}
+			if e := tx.Exec("DELETE FROM nextcloud_content_lease_coverage WHERE tenant_id=? AND knowledge_base_id=?", pair.TenantID, pair.KnowledgeBaseID).Error; e != nil {
+				return e
+			}
+			if e := tx.Model(&types.DataSource{}).Where("id=? AND tenant_id=?", pair.DataSourceID, pair.TenantID).Update("status", types.DataSourceStatusPaused).Error; e != nil {
+				return e
+			}
+			if e := tx.Model(&types.SyncLog{}).Where("data_source_id=? AND tenant_id=? AND status=?", pair.DataSourceID, pair.TenantID, types.SyncLogStatusRunning).Updates(map[string]any{"status": types.SyncLogStatusCanceled, "finished_at": now, "worker_active": false, "worker_attempt_token": "", "error_message": "publication_recovery_closed"}).Error; e != nil {
+				return e
+			}
+			if e := tx.Table("nextcloud_candidate_retry_jobs").Where("datasource_id=? AND tenant_id=?", pair.DataSourceID, pair.TenantID).Updates(map[string]any{"state": "manual", "lease_token": nil, "lease_until": nil, "sync_log_id": nil, "last_error_code": "publication_recovery_closed", "updated_at": now}).Error; e != nil {
+				return e
+			}
+			var kbFence nextcloudContentFence
+			if e := tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", pair.TenantID, pair.KnowledgeBaseID).Take(&kbFence).Error; e != nil {
+				return e
+			}
+			retired := make([]nextcloudRecoveryRetiredGeneration, 0, len(rows))
+			for _, row := range rows {
+				var fence nextcloudContentFence
+				if e := tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=?", pair.TenantID, pair.KnowledgeBaseID, row.ID).Take(&fence).Error; e != nil {
+					return e
+				}
+				if fence.State == "open" {
+					return ErrNextcloudRecoveryDenied
+				}
+				retired = append(retired, nextcloudRecoveryRetiredGeneration{row.ID, fence.Epoch})
+			}
+			retiredJSON, e := json.Marshal(retired)
+			if e != nil {
+				return e
+			}
+			pairHash, e := recoveryJSONSHA(pair)
+			if e != nil {
+				return e
+			}
+			if e = tx.Create(&nextcloudRecoveryScope{PlanSHA256: p.digest, OperationID: pair.OperationID, TenantID: pair.TenantID, KnowledgeBaseID: pair.KnowledgeBaseID, DataSourceID: pair.DataSourceID, InstanceID: pair.InstanceID, BindingID: pair.BindingID, PairSHA256: pairHash, RetiredGenerationsJSON: string(retiredJSON), ClosedKBEpoch: kbFence.Epoch, State: "closed"}).Error; e != nil {
+				return e
+			}
+		}
+		return nil
+	})
+	if e != nil {
+		return nil, e
+	}
+	return &result, nil
+}
+func mustRecoverySequence(v string) int64 { n, _ := recoverySequence(v); return n }
+func (s *NextcloudPublicationRecoveryStore) checkReceiptScopes(tx *gorm.DB, r NextcloudRecoveryReceipt, inv *NextcloudRecoveryInventory) error {
+	var scopes []nextcloudRecoveryScope
+	if e := tx.Where("plan_sha256=?", r.PlanSHA256).Find(&scopes).Error; e != nil {
+		return e
+	}
+	if len(scopes) != len(inv.Pairs) || len(scopes) != r.PairCount {
+		return ErrNextcloudRecoveryDenied
+	}
+	for _, pair := range inv.Pairs {
+		var current NextcloudSourcePairing
+		if e := tx.Where("operation_id=? AND tenant_id=?", pair.OperationID, pair.TenantID).Take(&current).Error; e != nil {
+			return ErrNextcloudRecoveryDenied
+		}
+		currentHash, _ := recoveryJSONSHA(recoveryPair(current))
+		hash, _ := recoveryJSONSHA(pair)
+		if currentHash != hash {
+			return ErrNextcloudRecoveryDenied
+		}
+		found := false
+		for _, scope := range scopes {
+			if scope.OperationID == pair.OperationID && scope.PairSHA256 == hash {
+				found = true
+			}
+		}
+		if !found {
+			return ErrNextcloudRecoveryDenied
+		}
+		for _, scope := range scopes {
+			if scope.OperationID == pair.OperationID {
+				if e := s.checkRecoveryScopeInTx(tx, scope); e != nil {
+					return e
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// Reconcile is available only to the local maintenance CLI. It probes the
+// persisted machine configuration itself; no request boolean, URL or personal
+// impersonation can supply its identity/complete-manifest evidence. This permits
+// NEW generations. Global ingress and authoritative directory checks remain an
+// independent cross-service recovery gate.
+func (s *NextcloudPublicationRecoveryStore) Reconcile(ctx context.Context, planSHA, operationID string) (*NextcloudRecoveryReconciliationReceipt, error) {
+	var scope nextcloudRecoveryScope
+	var receipt NextcloudRecoveryReceipt
+	if !recoveryHash.MatchString(planSHA) || operationID == "" {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	if e := s.db.WithContext(ctx).Where("plan_sha256=? AND operation_id=?", planSHA, operationID).Take(&scope).Error; e != nil {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	if e := s.db.WithContext(ctx).Where("plan_sha256=?", planSHA).Take(&receipt).Error; e != nil {
+		return nil, e
+	}
+	var pair NextcloudSourcePairing
+	var ds types.DataSource
+	if e := s.db.WithContext(ctx).Where("operation_id=? AND tenant_id=?", operationID, scope.TenantID).Take(&pair).Error; e != nil {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	hash, _ := recoveryJSONSHA(recoveryPair(pair))
+	if hash != scope.PairSHA256 || pair.State != "active" {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	if e := s.db.WithContext(ctx).Where("id=? AND tenant_id=? AND knowledge_base_id=? AND deleted_at IS NULL", scope.DataSourceID, scope.TenantID, scope.KnowledgeBaseID).Take(&ds).Error; e != nil {
+		return nil, e
+	}
+	base, configSHA, binding, e := NextcloudEventDataSourceIdentity(ds.Config)
+	if e != nil || base != pair.BaseURL || configSHA != pair.ConfigSHA || binding != pair.BindingID {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	cfg, e := ds.ParseConfig()
+	if e != nil {
+		return nil, e
+	}
+	cfg.Type = types.ConnectorTypeNextcloud
+	remotePair := nextcloud.SourcePairingCommit{OperationID: pair.OperationID, InstanceID: pair.InstanceID, BindingID: pair.BindingID, TenantID: pair.TenantID, KnowledgeBaseID: pair.KnowledgeBaseID, DataSourceID: pair.DataSourceID}
+	if e = nextcloud.CommitSourcePairing(ctx, cfg, remotePair); e != nil {
+		return nil, e
+	}
+	observed, e := nextcloud.InspectRecoveryManifest(ctx, cfg)
+	if e != nil {
+		return nil, e
+	}
+	if observed.Identity.InstanceID != pair.InstanceID || observed.Identity.BindingID != pair.BindingID || observed.Identity.BaseURL != pair.BaseURL || observed.Identity.PublicationState != "active" || observed.Identity.PublicationEpoch <= pair.PublicationEpoch {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	var plan NextcloudRecoveryPlan
+	if recoveryStrictJSON([]byte(receipt.PlanJSON), &plan) != nil {
+		return nil, ErrNextcloudRecoveryDenied
+	}
+	for _, withdraw := range plan.WithdrawFiles {
+		if withdraw.BindingID != pair.BindingID {
+			continue
+		}
+		for _, file := range observed.Files {
+			if strconv.FormatInt(file.FileID, 10) == withdraw.FileID {
+				return nil, ErrNextcloudRecoveryDenied
+			}
+		}
+	}
+	evidenceSHA, e := recoveryJSONSHA(struct {
+		PlanSHA256, PairSHA256 string
+		Manifest               nextcloud.RecoveryManifest
+	}{planSHA, scope.PairSHA256, observed})
+	if e != nil {
+		return nil, e
+	}
+	if e = nextcloud.CommitSourcePairing(ctx, cfg, remotePair); e != nil {
+		return nil, e
+	}
+	result := &NextcloudRecoveryReconciliationReceipt{PlanSHA256: planSHA, OperationID: operationID, PairSHA256: scope.PairSHA256, ReconciliationSHA256: evidenceSHA, Manifest: observed}
+	e = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		nowMS, e := nextcloudLeaseNowMS(tx)
+		if e != nil {
+			return e
+		}
+		fence, e := nextcloudLockKBFence(tx, scope.TenantID, scope.KnowledgeBaseID, nowMS)
+		if e != nil {
+			return e
+		}
+		var current nextcloudRecoveryScope
+		if e = tx.Where("plan_sha256=? AND operation_id=?", planSHA, operationID).Take(&current).Error; e != nil {
+			return e
+		}
+		var currentPair NextcloudSourcePairing
+		if e = tx.Where("operation_id=?", operationID).Take(&currentPair).Error; e != nil {
+			return e
+		}
+		ph, _ := recoveryJSONSHA(recoveryPair(currentPair))
+		if ph != scope.PairSHA256 {
+			return ErrNextcloudRecoveryDenied
+		}
+		if e = s.checkRecoveryScopeInTx(tx, current); e != nil {
+			return e
+		}
+		if current.State == "reconciled" {
+			if current.ReconciliationSHA256 != evidenceSHA || current.ReconciledAt == nil || current.ReconciliationJSON == "" {
+				return ErrNextcloudRecoveryDenied
+			}
+			if recoveryStrictJSON([]byte(current.ReconciliationJSON), result) != nil {
+				return ErrNextcloudRecoveryDenied
+			}
+			return nil
+		}
+		var currentDS types.DataSource
+		if e = tx.Where("id=? AND tenant_id=? AND knowledge_base_id=? AND status=? AND deleted_at IS NULL", scope.DataSourceID, scope.TenantID, scope.KnowledgeBaseID, types.DataSourceStatusPaused).Take(&currentDS).Error; e != nil {
+			return ErrNextcloudRecoveryDenied
+		}
+		currentBase, currentSHA, currentBinding, e := NextcloudEventDataSourceIdentity(currentDS.Config)
+		if e != nil || currentBase != pair.BaseURL || currentSHA != pair.ConfigSHA || currentBinding != pair.BindingID {
+			return ErrNextcloudRecoveryDenied
+		}
+		if current.State != "closed" || fence.State != "retired" || fence.Epoch == math.MaxInt64 {
+			return ErrNextcloudRecoveryDenied
+		}
+		// Leave unknown physical/GC coverage blocked after rollback. Reconciliation
+		// must not turn retirement into permission to erase unobserved copies.
+		if e = tx.Exec("DELETE FROM nextcloud_content_lease_coverage WHERE tenant_id=? AND knowledge_base_id=?", scope.TenantID, scope.KnowledgeBaseID).Error; e != nil {
+			return e
+		}
+		now := time.Now().UTC().Truncate(time.Microsecond)
+		result.ReconciledAt = now
+		resultJSON, e := json.Marshal(result)
+		if e != nil {
+			return e
+		}
+		if e = tx.Model(&nextcloudRecoveryScope{}).Where("plan_sha256=? AND operation_id=? AND state='closed'", planSHA, operationID).Updates(map[string]any{"state": "reconciled", "reconciliation_sha256": evidenceSHA, "reconciliation_json": string(resultJSON), "reconciled_at": now}).Error; e != nil {
+			return e
+		}
+		if e = tx.Exec("UPDATE nextcloud_content_fences SET state='open',epoch=epoch+1,retired_at_ms=NULL,updated_at_ms=? WHERE tenant_id=? AND knowledge_base_id=? AND knowledge_id='' AND state='retired'", nowMS, scope.TenantID, scope.KnowledgeBaseID).Error; e != nil {
+			return e
+		}
+		// Reset stale deletion cursors: old generations stay tombstoned; the next
+		// sync must download and stage the current authoritative files as new IDs.
+		update := tx.Model(&types.DataSource{}).Where("id=? AND tenant_id=? AND status=?", scope.DataSourceID, scope.TenantID, types.DataSourceStatusPaused).Updates(map[string]any{"status": types.DataSourceStatusActive, "last_sync_cursor": nil})
+		if update.Error != nil {
+			return update.Error
+		}
+		if update.RowsAffected != 1 {
+			return ErrNextcloudRecoveryDenied
+		}
+		return nil
+	})
+	if e != nil {
+		return nil, e
+	}
+	return result, nil
+}
+
+// A receipt is not proof that a partial restore preserved its closed rows. Every
+// retry checks the retired generations and monotone KB epoch persisted at close.
+func (s *NextcloudPublicationRecoveryStore) checkRecoveryScopeInTx(tx *gorm.DB, scope nextcloudRecoveryScope) error {
+	var retired []nextcloudRecoveryRetiredGeneration
+	if scope.ClosedKBEpoch <= 0 || scope.RetiredGenerationsJSON == "" || recoveryStrictJSON([]byte(scope.RetiredGenerationsJSON), &retired) != nil {
+		return ErrNextcloudRecoveryDenied
+	}
+	var kb nextcloudContentFence
+	if e := tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", scope.TenantID, scope.KnowledgeBaseID).Take(&kb).Error; e != nil {
+		return ErrNextcloudRecoveryDenied
+	}
+	if kb.Epoch < scope.ClosedKBEpoch || (scope.State == "closed" && kb.State == "open") || (scope.State == "reconciled" && kb.Epoch <= scope.ClosedKBEpoch) {
+		return ErrNextcloudRecoveryDenied
+	}
+	for _, generation := range retired {
+		var f nextcloudContentFence
+		if generation.KnowledgeID == "" || generation.Epoch <= 0 {
+			return ErrNextcloudRecoveryDenied
+		}
+		if e := tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=? AND datasource_id=?", scope.TenantID, scope.KnowledgeBaseID, generation.KnowledgeID, scope.DataSourceID).Take(&f).Error; e != nil {
+			return ErrNextcloudRecoveryDenied
+		}
+		if f.State == "open" || f.Epoch < generation.Epoch {
+			return ErrNextcloudRecoveryDenied
+		}
+	}
+	if scope.State == "closed" {
+		var ds types.DataSource
+		if e := tx.Where("id=? AND tenant_id=? AND knowledge_base_id=? AND deleted_at IS NULL", scope.DataSourceID, scope.TenantID, scope.KnowledgeBaseID).Take(&ds).Error; e != nil || ds.Status != types.DataSourceStatusPaused {
+			return ErrNextcloudRecoveryDenied
+		}
+		var count int64
+		if e := tx.Model(&nextcloudSourceVersion{}).Where("tenant_id=? AND knowledge_base_id=? AND datasource_id=? AND state<>'tombstone'", scope.TenantID, scope.KnowledgeBaseID, scope.DataSourceID).Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 0 {
+			return ErrNextcloudRecoveryDenied
+		}
+		if e := tx.Unscoped().Model(&types.Knowledge{}).Where("tenant_id=? AND knowledge_base_id=? AND channel=? AND COALESCE(metadata->>'nextcloud_etag','')<>''", scope.TenantID, scope.KnowledgeBaseID, types.ConnectorTypeNextcloud).Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 0 {
+			return ErrNextcloudRecoveryDenied
+		}
+		if e := tx.Model(&types.SyncLog{}).Where("tenant_id=? AND data_source_id=? AND status=?", scope.TenantID, scope.DataSourceID, types.SyncLogStatusRunning).Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 0 {
+			return ErrNextcloudRecoveryDenied
+		}
+	}
+	return nil
+}
