+		chunk := &types.Chunk{ID: "chunk-" + id, TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: id, Content: "actual " + id, ChunkType: types.ChunkTypeText, IsEnabled: true, IndexStatus: "ready"}
