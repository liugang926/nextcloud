+		TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: knowledge.ID, DataSourceID: "ds", ExternalID: "nextcloud:instance:77"}, NextcloudContentReadLease, "rag-reader", time.Minute)
+	require.NoError(t, err)
