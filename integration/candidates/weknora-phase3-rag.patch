+func TestPostgresKnowledgeInputCaptureCoherentBodyAndMutationBeforeRelease(t *testing.T) {
+	store, db := knowledgeInputPostgresFixture(t)
+	ctx, k, c, _ := createAdmittedManual(t, store, db)
+	baseline, err := store.CaptureKnowledgeBuildInputs(ctx, types.KnowledgeBuildInputCaptureRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, ChunkIDs: []string{c.ID}})
+	require.NoError(t, err)
+	fired := false
+	name := "knowledge_input_body_changed_after_header"
+	require.NoError(t, db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
+		if fired || tx.Statement.Context.Value(knowledgeInputSnapshotPauseKey{}) != true || tx.Statement.Table != "knowledges" {
+			return
+		}
+		fired = true
+		require.NoError(t, db.Model(&types.Chunk{}).Where("id = ?", c.ID).Update("content", "new generic body").Error)
+	}))
+	t.Cleanup(func() { _ = db.Callback().Query().Remove(name) })
+	rows, err := store.CaptureKnowledgeBuildInputs(context.WithValue(ctx, knowledgeInputSnapshotPauseKey{}, true), types.KnowledgeBuildInputCaptureRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, ChunkIDs: []string{c.ID}})
+	require.NoError(t, err)
+	require.True(t, fired)
+	require.Equal(t, c.Content, rows.Chunks[0].Content, "one RR snapshot binds actual old body and its original receipt")
+	require.Equal(t, baseline.Proof.BodyDigest, rows.Proof.BodyDigest)
+	require.Error(t, store.RecheckKnowledgeBuildInputs(ctx, rows.Proof), "the model/output checkpoint rejects the committed change")
+	require.NoError(t, db.Model(&types.Chunk{}).Where("id = ?", c.ID).Update("content", c.Content).Error)
+	require.Error(t, store.RecheckKnowledgeBuildInputs(ctx, baseline.Proof), "rollback of text cannot roll back monotonic original material version")
