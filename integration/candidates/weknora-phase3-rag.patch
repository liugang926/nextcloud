+			before, err := store.CaptureSpanOutputInputs(context.Background(), types.SpanOutputReadRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, Attempt: 1})
+			require.NoError(t, err)
+			switch mutation {
+			case "candidate name ABA":
+				require.NoError(t, db.Model(&types.KnowledgeTag{}).Where("id='span-nonmatch'").Update("name", "changed unselected").Error)
+				require.NoError(t, db.Model(&types.KnowledgeTag{}).Where("id='span-nonmatch'").Update("name", "actual human span-nonmatch").Error)
+			case "relationship ABA":
+				require.NoError(t, db.Create(&types.KnowledgeTagRelation{KnowledgeID: k.ID, TagID: "span-nonmatch"}).Error)
+				require.NoError(t, db.Where("knowledge_id=? AND tag_id='span-nonmatch'", k.ID).Delete(&types.KnowledgeTagRelation{}).Error)
+			case "human origin substitution":
+				require.NoError(t, knowledge.SetKnowledgeTags(WithIndependentKnowledgeTagAssignmentInput(ctx, map[string][]string{k.ID: {"span-nonmatch"}}), k.ID, []string{"span-nonmatch"}))
+			case "extra manifest replacement":
+				data, err := json.Marshal(manifest)
+				require.NoError(t, err)
+				var forged types.KnowledgeAutoTagInputSnapshot
+				require.NoError(t, json.Unmarshal(data, &forged))
+				forged.ManifestID = "not-the-original-run"
+				other, err := WithSpanAutoTagOriginalInput(ctx, store, &forged)
