+func messageMaterialActualFixture(t *testing.T) (*messageService, *knowledgeService, *repository.KnowledgeInputProvenanceStore, *gorm.DB, context.Context, *types.Session) {
+	t.Helper()
+	kg, store, db, ctx, _, _, _ := historyActorIntegrationFixture(t, "web")
+	closeHistoryMaterialGuard(ctx)
+	ctx = types.WithExecutionTenant(types.WithPrincipal(types.WithCaller(context.Background(), types.CallerFromContext(ctx)), types.Principal{Type: types.PrincipalWebUser, ID: types.CallerFromContext(ctx).UserID}), 7)
+	if !db.Migrator().HasColumn(&types.Message{}, "artifacts") {
+		require.NoError(t, db.Exec("ALTER TABLE messages ADD COLUMN artifacts TEXT").Error)
+	}
+	for _, name := range []string{"000023_message_artifacts_table.up.sql", "000026_message_artifacts_deleted_at.up.sql", "000046_nextcloud_content_leases.up.sql", "000070_message_original_materials.up.sql"} {
+		table := map[string]string{"000023_message_artifacts_table.up.sql": "message_artifacts", "000026_message_artifacts_deleted_at.up.sql": "message_artifacts", "000046_nextcloud_content_leases.up.sql": "nextcloud_content_leases", "000070_message_original_materials.up.sql": "message_generation_origins"}[name]
+		if db.Migrator().HasTable(table) {
+			continue
+		}
+		ddl, err := os.ReadFile("../../../migrations/sqlite/" + name)
+		require.NoError(t, err)
+		require.NoError(t, db.Exec(string(ddl)).Error)
+	}
+	groups := NewGroupAccessService(repository.NewGroupAccessRepository(db))
+	factory := func(tx *gorm.DB) *repository.KnowledgeInputProvenanceStore {
+		authority := repository.NewKnowledgeInputProvenanceStore(tx)
+		repository.ConfigureKnowledgeInputActorGroupAccess(authority, NewGroupAccessService(repository.NewGroupAccessRepository(tx)))
+		return authority
+	}
+	repository.ConfigureKnowledgeDisplayInputWriters(store, repository.NewKnowledgeTagRepository(db), kg.repo, factory)
+	kbs := &knowledgeBaseService{repo: repository.NewKnowledgeBaseRepository(db)}
+	guard := access.NewNextcloudSourceLineageGuard(kg.repo.(access.NextcloudLineageSnapshotLookup), kbs, nil, nil, groups, nil, store)
+	messages := &messageService{messageRepo: repository.NewMessageRepository(db), sessionRepo: repository.NewSessionRepository(db), sourceLineageGuard: guard, kbService: kbs, knowService: kg}
+	ConfigureMessageMaterialProvenance(messages, store)
+	ctx = context.WithValue(ctx, types.UserIDContextKey, types.CallerFromContext(ctx).UserID)
+	session := &types.Session{ID: "actual-new-message-session", TenantID: 7, UserID: types.CallerFromContext(ctx).UserID}
+	require.NoError(t, db.Create(session).Error)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(1)
+	sqlDB.SetMaxIdleConns(1)
+	var kb types.KnowledgeBase
+	require.NoError(t, db.Where("id='kb'").Take(&kb).Error)
+	grant, err := access.ResolveKB(ctx, access.KBRequest{Caller: types.CallerFromContext(ctx)}, &kb, types.OrgRoleEditor, nil, nil)
+	require.NoError(t, err)
+	ctx = grant.Context(ctx)
