+	}
+	routing, err := knowledgeEnrichmentRoutingDigest(kb)
+	if err != nil || routing != original.RoutingDigest {
+		return ErrKnowledgeInputChanged
+	}
+	routingRev, err := knowledgeEnrichmentRevision(tx, "routing", kb.ID)
