+		return engine
+	}
+	ctx := types.WithCaller(context.Background(), types.Caller{TenantID: 3, UserID: "original-person"})
+	ctx = types.WithPrincipal(ctx, types.Principal{Type: types.PrincipalWebUser, ID: "original-person"})
