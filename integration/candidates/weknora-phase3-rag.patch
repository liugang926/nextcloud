+)
+
+func installSpanInputs(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	if db.Dialector.Name() == "sqlite" {
+		require.NoError(t, db.Exec(spansTestDDL).Error)
+	} else {
+		require.NoError(t, db.AutoMigrate(&types.KnowledgeProcessingSpan{}))
+		require.NoError(t, db.Exec("CREATE UNIQUE INDEX IF NOT EXISTS span_test_unique_tuple ON knowledge_processing_spans(knowledge_id,attempt,span_id)").Error)
+	}
+	path := "../../../migrations/sqlite/000057_processing_span_original_inputs.up.sql"
+	if db.Dialector.Name() == "postgres" {
+		path = "../../../migrations/versioned/000138_processing_span_original_inputs.up.sql"
+	}
+	script, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.NoError(t, db.Exec(string(script)).Error)
+}
+func spanFixture(t *testing.T) (*KnowledgeInputProvenanceStore, *gorm.DB, context.Context, *types.Knowledge, *types.Chunk, KnowledgeSpanRepository) {
+	t.Helper()
+	store, db := knowledgeInputFixture(t)
+	ctx, k, c, _ := createAdmittedManual(t, store, db)
+	installSpanInputs(t, db)
+	return store, db, ctx, k, c, NewKnowledgeSpanRepository(db)
+}
+func startOriginalSpan(t *testing.T, repo KnowledgeSpanRepository, ctx context.Context, kid string, attempt int, id, parent, kind string) *types.KnowledgeProcessingSpan {
+	t.Helper()
+	now := time.Now()
+	row := &types.KnowledgeProcessingSpan{KnowledgeID: kid, Attempt: attempt, SpanID: id, ParentSpanID: parent, Name: "actual span", Kind: kind, Status: types.SpanStatusRunning, Input: types.JSONMap{"actual": "original input body"}, Metadata: types.JSONMap{"control": "actual Start control"}, StartedAt: &now}
+	require.NoError(t, repo.Upsert(ctx, row))
+	require.NotEmpty(t, row.WriteToken)
+	return row
+}
+func finishOriginalSpan(t *testing.T, repo KnowledgeSpanRepository, ctx context.Context, start *types.KnowledgeProcessingSpan) {
+	t.Helper()
+	now := time.Now()
+	end := *start
+	end.Input = nil
+	end.Metadata = nil
+	end.Status = types.SpanStatusFailed
+	end.FinishedAt = &now
+	end.Output = types.JSONMap{"actual": "original output body"}
+	end.ErrorCode = "ACTUAL_FAILURE"
+	end.ErrorMessage = "original error body"
+	end.ErrorDetail = "private original error detail"
+	require.NoError(t, repo.Upsert(ctx, &end))
+}
+func captureOriginalSpans(t *testing.T, store *KnowledgeInputProvenanceStore, k *types.Knowledge, attempt int) *types.SpanOutputInputSnapshot {
+	t.Helper()
+	snapshot, err := store.CaptureSpanOutputInputs(context.Background(), types.SpanOutputReadRequest{TenantID: k.TenantID, KnowledgeBaseID: k.KnowledgeBaseID, KnowledgeID: k.ID, Attempt: attempt})
+	require.NoError(t, err)
+	return snapshot
+}
+func TestSpanOriginalStartTerminalAtomicReceiptAndManifest(t *testing.T) {
+	store, db, ctx, k, c, repo := spanFixture(t)
+	root := startOriginalSpan(t, repo, ctx, k.ID, 1, "root", "", types.SpanKindRoot)
+	child := startOriginalSpan(t, repo, ctx, k.ID, 1, "child", root.SpanID, types.SpanKindGeneration)
+	child.Input["actual"] = "caller later mutates input"
+	finishOriginalSpan(t, repo, ctx, child)
+	snapshot := captureOriginalSpans(t, store, k, 1)
+	require.Len(t, snapshot.Rows, 2)
+	actual := snapshot.Rows[1]
+	require.Equal(t, "complete", actual.ContentProvenance)
+	require.Equal(t, "original input body", actual.Input["actual"])
+	require.Equal(t, "actual Start control", actual.Metadata["control"])
+	require.Equal(t, "original output body", actual.Output["actual"])
+	require.Equal(t, "original error body", actual.ErrorMessage)
