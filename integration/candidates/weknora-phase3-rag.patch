+	payload := &types.FAQEntryPayload{StandardQuestion: "  original whitespace question  ", SimilarQuestions: []string{"  actual similar question  "}, Answers: []string{"  actual answer  "}, IsEnabled: boolFAQ(false), IsRecommended: boolFAQ(false)}
