+func autoSpanFixture(t *testing.T, pg, derived bool) (*KnowledgeInputProvenanceStore, *gorm.DB, context.Context, *types.Knowledge, interfaces.KnowledgeRepository, *types.KnowledgeAutoTagInputSnapshot, *types.KnowledgeProcessingSpan, KnowledgeSpanRepository) {
