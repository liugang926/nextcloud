+func TestBatchDownloadBufferChecksAuthorizationBeforeReleasingBytes(t *testing.T) {
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	checks := 0
+	revoked := false
