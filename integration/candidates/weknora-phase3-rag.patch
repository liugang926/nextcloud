+	var after spanStartManifest
+	require.NoError(t, db.Where("run_token=?", row.WriteToken).Take(&after).Error)
+	require.Equal(t, original, after, "End retains the exact original Begin manifest and run token")
+	// Operational status changes do not change the model's consumed body.
+	require.NoError(t, db.Model(&types.Knowledge{}).Where("id=?", k.ID).Updates(map[string]any{"parse_status": types.ParseStatusCompleted, "updated_at": time.Now()}).Error)
+	require.NoError(t, store.RecheckSpanOutputInputs(context.Background(), snapshot))
+	source := manifest.SourceLineage.Sources[0]
+	require.NoError(t, NewNextcloudContentLeaseStore(db).RetireKnowledge(ctx, NextcloudContentScope{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: source.KnowledgeID, DataSourceID: source.DataSourceID, ExternalID: source.ExternalID}))
+	_, err = store.CaptureSpanOutputInputs(context.Background(), types.SpanOutputReadRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, Attempt: 1})
+	require.Error(t, err, "unselected candidate source withdrawal closes span counters/errors")
