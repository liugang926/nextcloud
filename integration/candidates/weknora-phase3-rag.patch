+func TestNextcloudPublicationGuardAllowsOnlyFreshAuthorizedIdentity(t *testing.T) {
+	guard, ctx, knowledge := publicationFixture(t)
+	if err := guard.CheckKnowledge(ctx, knowledge); err != nil {
