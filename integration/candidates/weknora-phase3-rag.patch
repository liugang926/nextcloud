+func (a *safeCurrentTurnAgent) CreateAgentEngine(_ context.Context, cfg *types.AgentConfig, _ chat.Chat, _ rerank.Reranker, _ *event.EventBus, _, _ string) (interfaces.AgentEngine, error) {
