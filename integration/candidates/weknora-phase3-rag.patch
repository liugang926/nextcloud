+	data, err := json.Marshal(proof)
+	if err != nil {
+		return err
+	}
+	var copy types.KnowledgeBuildInputProof
+	if err := json.Unmarshal(data, &copy); err != nil {
+		return err
+	}
+	return reader.RecheckKnowledgeBuildInputs(ctx, &copy)
+}
