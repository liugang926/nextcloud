+// ReconcileExternalPurge replays verified external decisions after a failed
+// DB ACK or database restore. It never clears an actual current owner, active
+// lease, changed tuple or unexpired recovery artifact to make the pins match.
+func (s *OriginalBodyRetentionStore) ReconcileExternalPurge(ctx context.Context) (int, error) {
+	if s.journal == nil {
+		return 0, ErrOriginalBodyUnavailable
+	}
+	events, pin, e := s.journal.read()
+	if e != nil {
+		return 0, e
+	}
+	count := 0
+	e = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var head originalBodyJournalHead
+		if e := bodyInternal(tx).Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=1").Take(&head).Error; e != nil {
+			return e
+		}
+		if head.JournalID != pin.JournalID || head.Sequence > pin.Sequence {
+			return ErrOriginalBodyUnavailable
+		}
+		for _, event := range events {
+			var body originalBodyPayload
+			if e := bodyInternal(tx).Where("id=?", event.BodyID).Take(&body).Error; e != nil {
+				return e
+			}
+			if body.BodySHA256 != event.BodySHA256 || body.TenantID != event.TenantID {
+				return ErrOriginalBodyUnavailable
+			}
+			var heads []originalBodyFieldHead
+			if e := bodyInternal(tx).Table("original_body_field_revisions").Where("body_id=?", body.ID).Order("source_table,row_key,column_name,revision").Find(&heads).Error; e != nil {
+				return e
+			}
+			var parents []originalBodyParentRef
+			if e := bodyInternal(tx).Where("body_id=?", body.ID).Order("tenant_id,knowledge_base_id,knowledge_id,admission_id").Find(&parents).Error; e != nil {
+				return e
+			}
+			fields := []string{}
+			for _, h := range heads {
+				fields = append(fields, h.SourceIdentitySHA256)
+			}
+			sort.Strings(fields)
+			scopeSHA, e := originalBodyScopeDigest(tx, body, fields, parents)
+			if e != nil {
+				return e
+			}
+			if scopeSHA != event.ScopeSHA256 {
+				return ErrOriginalBodyUnavailable
+			}
+			if body.State == "purged" {
+				if body.Payload != nil {
+					return ErrOriginalBodyUnavailable
+				}
+				var receipt originalBodyPurgeReceipt
+				if e := bodyInternal(tx).Where("body_id=?", body.ID).Take(&receipt).Error; e != nil {
+					return e
+				}
+				if receipt.JournalSequence != event.Sequence || receipt.JournalHeadSHA256 != event.HeadSHA256 {
+					return ErrOriginalBodyUnavailable
+				}
+				// A prior DB receipt does not authenticate restored physical
+				// bytes. Validate every still-owned field before idempotence.
+				for _, field := range heads {
+					var current originalBodyFieldHead
+					if e := bodyInternal(tx).Where("slot_id=?", field.SlotID).Take(&current).Error; e != nil {
+						return e
+					}
+					if current.BodyID != body.ID {
+						continue
+					}
+					d, ok := bodyDescriptor(field.SourceTable)
+					if !ok {
+						return ErrOriginalBodyUnavailable
+					}
+					row, e := bodySourceRow(tx, d, field.RowKey)
+					if errors.Is(e, gorm.ErrRecordNotFound) {
+						continue
+					}
+					if e != nil {
+						return e
+					}
+					raw, e := bodyFieldValue(row, field.ColumnName)
+					if e != nil {
+						return e
+					}
+					if d.Mode == "vault" {
+						if raw != field.OriginalBodyRef {
+							return ErrOriginalBodyUnavailable
+						}
+					} else if raw != "" && raw != "null" {
+						return ErrOriginalBodyUnavailable
+					}
+				}
+				continue
+			}
+			if e := s.lockBodyScopes(tx, heads, parents); e != nil {
+				return e
+			}
+			now, e := nextcloudLeaseNowMS(bodyInternal(tx))
+			if e != nil {
+				return e
+			}
+			if event.BodyDeadlineMS > now {
+				return ErrOriginalBodyRetained
+			}
+			var active int64
+			if e := bodyInternal(tx).Model(&originalBodyLease{}).Where("body_id=? AND released_at_ms IS NULL AND expires_at_ms>?", body.ID, now).Count(&active).Error; e != nil {
+				return e
+			}
+			if active != 0 {
+				return ErrOriginalBodyRetained
+			}
+			for _, h := range heads {
+				current, _, e := s.fieldCurrent(tx, h, now)
+				if e != nil {
+					return e
+				}
+				if current {
+					return ErrOriginalBodyRetained
+				}
+			}
+			if body.StorageKind == "vault" {
+				if body.Payload == nil || bodySHA([]byte(*body.Payload)) != event.BodySHA256 {
+					return ErrOriginalBodyUnavailable
+				}
+			}
+			cleared := int64(0)
+			if body.StorageKind == "inline" {
+				for _, h := range heads {
+					var current originalBodyFieldHead
+					if e := bodyInternal(tx).Where("slot_id=?", h.SlotID).Take(&current).Error; e != nil {
+						return e
+					}
+					if current.BodyID != body.ID {
+						continue
+					}
+					d, ok := bodyDescriptor(h.SourceTable)
+					if !ok || d.Mode == "unsupported" {
+						return ErrOriginalBodyRetained
+					}
+					row, e := bodySourceRow(tx, d, h.RowKey)
+					if errors.Is(e, gorm.ErrRecordNotFound) {
+						continue
+					}
+					if e != nil {
+						return e
+					}
+					raw, e := bodyFieldValue(row, h.ColumnName)
+					if e != nil {
+						return e
+					}
+					if bodySHA([]byte(raw)) != body.BodySHA256 {
+						return ErrOriginalBodyUnavailable
+					}
+					empty := ""
+					if jsonCol, e := originalBodyColumnIsJSON(tx, d.Table, h.ColumnName); e != nil {
+						return e
+					} else if jsonCol && !strings.Contains(h.ColumnName, ".") {
+						empty = "null"
+					}
+					if e := originalBodyRewrite(tx, d, h.RowKey, h.ColumnName, body.ID, raw, empty); e != nil {
+						return e
+					}
+					cleared++
+				}
+			}
+			if e := bodyInternal(tx).Model(&body).Updates(map[string]any{"state": "purged", "payload": nil, "purge_epoch": event.PurgeEpoch, "body_deadline_ms": event.BodyDeadlineMS, "metadata_deadline_ms": event.MetadataDeadlineMS}).Error; e != nil {
+				return e
+			}
+			receipt := originalBodyPurgeReceipt{BodyID: body.ID, BodySHA256: event.BodySHA256, ScopeSHA256: event.ScopeSHA256, BeforeBytes: event.BeforeBytes, AfterBytes: 0, ClearedFields: cleared, JournalSequence: event.Sequence, JournalHeadSHA256: event.HeadSHA256, PurgeToken: "external-replay", PurgeEpoch: event.PurgeEpoch, CompletedAtMS: now}
+			if e := bodyInternal(tx).Create(&receipt).Error; e != nil {
+				return e
+			}
+			count++
+		}
+		return bodyInternal(tx).Model(&head).Updates(map[string]any{"sequence": pin.Sequence, "head_sha256": pin.HeadSHA256}).Error
+	})
+	return count, e
+}
diff --git a/internal/application/repository/original_body_retention.go b/internal/application/repository/original_body_retention.go
new file mode 100644
index 0000000000000000000000000000000000000000..636c05d5d99f818dfa599e541d097b8e9be5ded9
--- /dev/null
+++ b/internal/application/repository/original_body_retention.go
@@ -0,0 +1,214 @@
+package repository
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"time"
+)
+
+var ErrOriginalBodyUnavailable = errors.New("original body is unavailable or retention evidence changed")
+var ErrOriginalBodyRetained = errors.New("original body has a current owner, lease, unexpired recovery or unknown copy")
+
+type originalBodyPayload struct {
+	ID                                              string `gorm:"primaryKey"`
+	TenantID                                        uint64
+	BodySHA256                                      string
+	OriginDomainSHA256                              string
+	Payload                                         *string
+	BodyBytes                                       int64
+	StorageKind, State                              string
+	CreatedAtMS, LastCheckedAtMS                    int64
+	RetiredAtMS, BodyDeadlineMS, MetadataDeadlineMS *int64
+	PurgeToken                                      string
+	PurgeEpoch                                      int64
+}
+
+func (originalBodyPayload) TableName() string { return "original_body_payloads" }
+
+type originalBodyFieldHead struct {
+	SlotID                                                                         string `gorm:"primaryKey"`
+	SourceTable, RowKey, ColumnName                                                string
+	TenantID                                                                       uint64
+	KnowledgeBaseID, KnowledgeID, OwnerKind, OwnerID, SourceIdentitySHA256, BodyID string
+	Revision                                                                       int64
+	AdmissionID, SourceLineage, OriginalBodyRef                                    string
+}
+
+func (originalBodyFieldHead) TableName() string { return "original_body_field_heads" }
+
+type originalBodyParentRef struct {
+	BodyID                                    string `gorm:"primaryKey"`
+	TenantID                                  uint64 `gorm:"primaryKey"`
+	KnowledgeBaseID, KnowledgeID, AdmissionID string `gorm:"primaryKey"`
+}
+
+func (originalBodyParentRef) TableName() string { return "original_body_parent_refs" }
+
+type originalBodyLease struct {
+	LeaseID               string `gorm:"primaryKey"`
+	BodyID, Kind, OwnerID string
+	Epoch, ExpiresAtMS    int64
+	ReleasedAtMS          *int64
+}
+
+func (originalBodyLease) TableName() string { return "original_body_leases" }
+
+type originalBodyPurgeReceipt struct {
+	BodyID                                                  string `gorm:"primaryKey"`
+	BodySHA256, ScopeSHA256                                 string
+	BeforeBytes, AfterBytes, ClearedFields, JournalSequence int64
+	JournalHeadSHA256, PurgeToken                           string
+	PurgeEpoch, CompletedAtMS                               int64
+}
+
+func (originalBodyPurgeReceipt) TableName() string { return "original_body_purge_receipts" }
+
+type originalBodyReference struct {
+	Version int    `json:"_original_body_version"`
+	SlotID  string `json:"slot_id"`
+	BodyID  string `json:"body_id"`
+	SHA256  string `json:"sha256"`
+}
+type originalBodyScope struct {
+	Tenant                                                  uint64
+	KB, Knowledge, OwnerKind, OwnerID, AdmissionID, Lineage string
+}
+type OriginalBodyRetentionStore struct {
+	db      *gorm.DB
+	journal *originalBodyJournal
+}
+
+func NewOriginalBodyRetentionStore(db *gorm.DB) *OriginalBodyRetentionStore {
+	return &OriginalBodyRetentionStore{db: db, journal: originalBodyJournalFromEnv()}
+}
+func bodySHA(data []byte) string { sum := sha256.Sum256(data); return hex.EncodeToString(sum[:]) }
+func bodyInternal(tx *gorm.DB) *gorm.DB {
+	return tx.Session(&gorm.Session{NewDB: true, Context: context.WithValue(tx.Statement.Context, originalBodyInternalKey{}, true)})
+}
+
+type originalBodyInternalKey struct{}
+
+// Shared with actual material/history consumers, including message generation
+// origins. This never authenticates cached body by loading a newer current row.
+func CheckOriginalBodyAvailableInTx(ctx context.Context, tx *gorm.DB, table, rowID string) error {
+	if !originalBodySchemaPresent(tx) {
+		return nil
+	}
+	store := NewOriginalBodyRetentionStore(tx)
+	if e := store.checkJournalInTx(tx); e != nil {
+		return e
+	}
+	var heads []originalBodyFieldHead
+	if e := bodyInternal(tx).Where("source_table=? AND row_key=?", table, rowID).Find(&heads).Error; e != nil {
+		return e
+	}
+	if len(heads) == 0 {
+		if descriptor, ok := bodyDescriptor(table); ok && descriptor.Mode == "vault" {
+			return ErrOriginalBodyUnavailable
+		}
+	}
+	for _, head := range heads {
+		var body originalBodyPayload
+		if e := bodyInternal(tx).Select("id,state").Where("id=?", head.BodyID).Take(&body).Error; e != nil {
+			return e
+		}
+		if body.State != "live" {
+			return ErrOriginalBodyUnavailable
+		}
+		if e := store.checkExternalBody(body.ID); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+func (s *OriginalBodyRetentionStore) resolveInTx(tx *gorm.DB, head originalBodyFieldHead, ref originalBodyReference) (string, error) {
+	if ref.Version != 1 || ref.SlotID != head.SlotID || ref.BodyID != head.BodyID {
+		return "", ErrOriginalBodyUnavailable
+	}
+	if e := s.checkJournalInTx(tx); e != nil {
+		return "", e
+	}
+	var body originalBodyPayload
+	if e := bodyInternal(tx).Where("id=?", ref.BodyID).Take(&body).Error; e != nil {
+		return "", e
+	}
+	if body.State != "live" || body.BodySHA256 != ref.SHA256 || body.Payload == nil || bodySHA([]byte(*body.Payload)) != body.BodySHA256 {
+		return "", ErrOriginalBodyUnavailable
+	}
+	if e := s.checkExternalBody(body.ID); e != nil {
+		return "", e
+	}
+	return *body.Payload, nil
+}
+func (s *OriginalBodyRetentionStore) AcquireLease(ctx context.Context, bodyID, kind, owner string, ttl time.Duration) (string, error) {
+	if bodyID == "" || owner == "" || (kind != "read" && kind != "build") || ttl <= 0 || ttl > 30*time.Minute {
+		return "", ErrOriginalBodyUnavailable
+	}
+	var id string
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var e error
+		id, e = s.acquireLeaseInTx(tx, bodyID, kind, owner, ttl)
+		return e
+	})
+	return id, err
+}
+func (s *OriginalBodyRetentionStore) acquireLeaseInTx(tx *gorm.DB, bodyID, kind, owner string, ttl time.Duration) (string, error) {
+	if e := s.checkJournalInTx(tx); e != nil {
+		return "", e
+	}
+	if e := s.checkExternalBody(bodyID); e != nil {
+		return "", e
+	}
+	var body originalBodyPayload
+	if e := bodyInternal(tx).Select("id,state,purge_epoch").Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=?", bodyID).Take(&body).Error; e != nil {
+		return "", e
+	}
+	if body.State != "live" {
+		return "", ErrOriginalBodyUnavailable
+	}
+	now, e := nextcloudLeaseNowMS(bodyInternal(tx))
+	if e != nil {
+		return "", e
+	}
+	id := uuid.NewString()
+	return id, bodyInternal(tx).Create(&originalBodyLease{LeaseID: id, BodyID: bodyID, Kind: kind, OwnerID: owner, Epoch: body.PurgeEpoch, ExpiresAtMS: now + ttl.Milliseconds()}).Error
+}
+func (s *OriginalBodyRetentionStore) ReleaseLease(ctx context.Context, id string) error {
+	now, e := nextcloudLeaseNowMS(bodyInternal(s.db))
+	if e != nil {
+		return e
+	}
+	return bodyInternal(s.db.WithContext(ctx)).Model(&originalBodyLease{}).Where("lease_id=? AND released_at_ms IS NULL", id).Update("released_at_ms", now).Error
+}
+func bodyRefString(slot, id, sha string) string {
+	b, _ := json.Marshal(originalBodyReference{1, slot, id, sha})
+	return string(b)
+}
+func bodyReference(raw string) (originalBodyReference, bool) {
+	var ref originalBodyReference
+	e := json.Unmarshal([]byte(raw), &ref)
+	return ref, e == nil && ref.Version == 1 && ref.SlotID != "" && ref.BodyID != "" && ref.SHA256 != ""
+}
+func bodyIdentity(table, key, col string, scope originalBodyScope) string {
+	return bodySHA([]byte(fmt.Sprintf("%s\x00%s\x00%s\x00%d\x00%s\x00%s\x00%s\x00%s", table, key, col, scope.Tenant, scope.KB, scope.Knowledge, scope.OwnerKind, scope.OwnerID)))
+}
+func originalBodyTimePointer(v int64) *int64 { return &v }
+
+var _ = types.ConnectorTypeNextcloud
+
+type originalBodyGCItem struct {
+	JobID, BodyID                       string `gorm:"primaryKey"`
+	TenantID                            uint64
+	KnowledgeBaseID, KnowledgeID, State string
+	EstimatedBytes, CreatedAtMS         int64
+}
+
+func (originalBodyGCItem) TableName() string { return "original_body_gc_items" }
diff --git a/internal/application/repository/original_body_rewrite.go b/internal/application/repository/original_body_rewrite.go
new file mode 100644
index 0000000000000000000000000000000000000000..12e6845091be79f00498f5a2f880d9622a58d147
--- /dev/null
+++ b/internal/application/repository/original_body_rewrite.go
@@ -0,0 +1,217 @@
+package repository
+
+import (
+	"fmt"
+	"gorm.io/gorm"
+	"strings"
+)
+
+func bodyQuoted(id string) string        { return `"` + strings.ReplaceAll(id, `"`, `""`) + `"` }
+func bodySQLLiteral(value string) string { return "'" + strings.ReplaceAll(value, "'", "''") + "'" }
+func originalBodyColumnIsJSON(tx *gorm.DB, table, col string) (bool, error) {
+	columns, e := bodyInternal(tx).Migrator().ColumnTypes(table)
+	if e != nil {
+		return false, e
+	}
+	for _, c := range columns {
+		if c.Name() == bodyFieldColumn(col) {
+			name := strings.ToLower(c.DatabaseTypeName())
+			return strings.Contains(name, "json"), nil
+		}
+	}
+	return false, nil
+}
+func originalBodyRewrite(tx *gorm.DB, d originalBodyFieldDescriptor, key, col, id, old, new string) error {
+	internal := bodyInternal(tx)
+	if strings.Contains(col, ".") {
+		row, e := bodySourceRow(tx, d, key)
+		if e != nil {
+			return e
+		}
+		stored := bodyText(row[bodyFieldColumn(col)])
+		updated, e := bodyNestedReplace(stored, col, old, new)
+		if e != nil {
+			return e
+		}
+		if tx.Dialector.Name() == "postgres" {
+			if e := internal.Raw("SELECT CAST(? AS jsonb)::text", updated).Scan(&updated).Error; e != nil {
+				return e
+			}
+		}
+		old, new, col = stored, updated, bodyFieldColumn(col)
+	}
+	if e := internal.Exec("INSERT INTO original_body_rewrite_authorities(source_table,row_key,column_name,body_id,old_value,new_value) VALUES(?,?,?,?,?,?)", d.Table, key, col, id, old, new).Error; e != nil {
+		return e
+	}
+	query := "UPDATE " + bodyQuoted(d.Table) + " SET " + bodyQuoted(col) + "=? WHERE CAST(" + bodyQuoted(d.Key) + " AS TEXT)=?"
+	result := internal.Exec(query, new, key)
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 1 {
+		return ErrOriginalBodyUnavailable
+	}
+	return internal.Exec("DELETE FROM original_body_rewrite_authorities WHERE source_table=? AND row_key=? AND column_name=?", d.Table, key, col).Error
+}
+
+// Only a same-transaction, exact old bytes -> exact reference/empty-body move
+// can bypass an immutable or semantic version trigger. All metadata columns
+// and every other body field must compare equal. Delete triggers are preserved.
+func InstallOriginalBodyRetentionTriggers(db *gorm.DB) error {
+	if !db.Migrator().HasTable(&originalBodyPayload{}) {
+		return nil
+	}
+	if db.Dialector.Name() == "postgres" {
+		return installPostgresBodyRewrite(db)
+	}
+	if db.Dialector.Name() != "sqlite" {
+		return ErrOriginalBodyUnavailable
+	}
+	for _, d := range originalBodyFields {
+		if !db.Migrator().HasTable(d.Table) {
+			continue
+		}
+		columns, e := bodyInternal(db).Migrator().ColumnTypes(d.Table)
+		if e != nil {
+			return e
+		}
+		known := map[string]bool{}
+		for _, c := range columns {
+			known[c.Name()] = true
+		}
+		permitted := []string{}
+		for _, field := range d.Columns {
+			col := bodyFieldColumn(field)
+			if !known[col] {
+				continue
+			}
+			eq := []string{}
+			for _, other := range columns {
+				if other.Name() != col {
+					eq = append(eq, "NEW."+bodyQuoted(other.Name())+" IS OLD."+bodyQuoted(other.Name()))
+				}
+			}
+			a := "EXISTS (SELECT 1 FROM original_body_rewrite_authorities a JOIN original_body_payloads p ON p.id=a.body_id WHERE a.source_table=" + bodySQLLiteral(d.Table) + " AND a.row_key=CAST(OLD." + bodyQuoted(d.Key) + " AS TEXT) AND a.column_name=" + bodySQLLiteral(col) + " AND a.old_value=OLD." + bodyQuoted(col) + " AND a.new_value=NEW." + bodyQuoted(col) + ")"
+			permitted = append(permitted, "("+strings.Join(eq, " AND ")+" AND "+a+")")
+		}
+		if len(permitted) == 0 {
+			continue
+		}
+		permit := strings.Join(permitted, " OR ")
+		var triggers []struct{ Name, SQL string }
+		if e := bodyInternal(db).Raw("SELECT name,sql FROM sqlite_master WHERE type='trigger' AND tbl_name=?", d.Table).Scan(&triggers).Error; e != nil {
+			return e
+		}
+		for _, trigger := range triggers {
+			upper := strings.ToUpper(trigger.SQL)
+			if strings.Contains(upper, "ORIGINAL_BODY_REWRITE_AUTHORITIES") || !strings.Contains(upper, "UPDATE ON") && !strings.Contains(upper, "UPDATE OF ") {
+				continue
+			}
+			begin := strings.Index(upper, " BEGIN")
+			if begin < 0 {
+				begin = strings.Index(upper, "\nBEGIN")
+			}
+			if begin < 0 {
+				return fmt.Errorf("unsupported original body trigger syntax")
+			}
+			prefix, suffix := trigger.SQL[:begin], trigger.SQL[begin:]
+			pUpper := strings.ToUpper(prefix)
+			when := strings.Index(pUpper, " WHEN ")
+			if when < 0 {
+				when = strings.Index(pUpper, "\nWHEN ")
+			}
+			if when >= 0 {
+				oldCondition := strings.TrimSpace(prefix[when+6:])
+				prefix = prefix[:when] + " WHEN (" + oldCondition + ") AND NOT (" + permit + ")"
+			} else {
+				prefix += " WHEN NOT (" + permit + ")"
+			}
+			if e := bodyInternal(db).Transaction(func(tx *gorm.DB) error {
+				if e := tx.Exec("DROP TRIGGER " + bodyQuoted(trigger.Name)).Error; e != nil {
+					return e
+				}
+				return tx.Exec(prefix + suffix).Error
+			}); e != nil {
+				return e
+			}
+		}
+	}
+	return nil
+}
+func installPostgresBodyRewrite(db *gorm.DB) error {
+	// Replacing one trigger function preserves every existing trigger binding.
+	// A wrapper calls the original function for all non-protocol writes; exact
+	// physical field moves return NEW and leave semantic counters unchanged.
+	for _, d := range originalBodyFields {
+		if !db.Migrator().HasTable(d.Table) {
+			continue
+		}
+		columns, e := bodyInternal(db).Migrator().ColumnTypes(d.Table)
+		if e != nil {
+			return e
+		}
+		known := map[string]bool{}
+		for _, c := range columns {
+			known[c.Name()] = true
+		}
+		conditions := []string{}
+		for _, field := range d.Columns {
+			col := bodyFieldColumn(field)
+			if !known[col] {
+				continue
+			}
+			// to_jsonb(row)->> handles both text and canonical json/jsonb values.
+			conditions = append(conditions, "((to_jsonb(NEW)-"+bodySQLLiteral(col)+")=(to_jsonb(OLD)-"+bodySQLLiteral(col)+") AND EXISTS(SELECT 1 FROM original_body_rewrite_authorities a JOIN original_body_payloads p ON p.id=a.body_id WHERE a.source_table="+bodySQLLiteral(d.Table)+" AND a.row_key=to_jsonb(OLD)->>"+bodySQLLiteral(d.Key)+" AND a.column_name="+bodySQLLiteral(col)+" AND a.old_value=COALESCE(to_jsonb(OLD)->>"+bodySQLLiteral(col)+",'null') AND a.new_value=COALESCE(to_jsonb(NEW)->>"+bodySQLLiteral(col)+",'null')))")
+		}
+		if len(conditions) == 0 {
+			continue
+		}
+		var triggers []struct{ Name, Definition, Function string }
+		q := `SELECT t.tgname AS name,pg_get_triggerdef(t.oid) AS definition,pg_get_functiondef(t.tgfoid) AS function FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relname=? AND n.nspname=current_schema() AND NOT t.tgisinternal`
+		if e := bodyInternal(db).Raw(q, d.Table).Scan(&triggers).Error; e != nil {
+			return e
+		}
+		for _, trigger := range triggers {
+			if strings.Contains(trigger.Function, "original_body_rewrite_authorities") || !strings.Contains(trigger.Definition, "UPDATE") {
+				continue
+			}
+			// Clone the exact original trigger body to a per-trigger wrapper; inserting
+			// the narrow guard before BEGIN cannot affect the original policy branches.
+			begin := strings.Index(strings.ToUpper(trigger.Function), "BEGIN")
+			if begin < 0 {
+				return fmt.Errorf("unsupported original body trigger language")
+			}
+			start := strings.Index(trigger.Function, "$function$")
+			end := strings.LastIndex(trigger.Function, "$function$")
+			if start < 0 || end <= start {
+				return fmt.Errorf("unsupported original body function quoting")
+			}
+			original := trigger.Function[start+len("$function$") : end]
+			localBegin := strings.Index(strings.ToUpper(original), "BEGIN")
+			if localBegin < 0 {
+				return fmt.Errorf("unsupported original body trigger language")
+			}
+			guarded := original[:localBegin] + "BEGIN IF TG_OP='UPDATE' AND (" + strings.Join(conditions, " OR ") + ") THEN RETURN NEW; END IF;" + original[localBegin+len("BEGIN"):]
+			name := "original_body_" + bodySHA([]byte(d.Table + "/" + trigger.Name))[:20]
+			sql := "CREATE OR REPLACE FUNCTION " + bodyQuoted(name) + "() RETURNS trigger LANGUAGE plpgsql AS $body$ " + guarded + " $body$"
+			if e := bodyInternal(db).Exec(sql).Error; e != nil {
+				return e
+			}
+			definition := trigger.Definition
+			exec := strings.LastIndex(definition, " EXECUTE ")
+			if exec < 0 {
+				return fmt.Errorf("unsupported original body trigger binding")
+			}
+			definition = definition[:exec] + " EXECUTE FUNCTION " + bodyQuoted(name) + "()"
+			if e := bodyInternal(db).Transaction(func(tx *gorm.DB) error {
+				if e := tx.Exec("DROP TRIGGER " + bodyQuoted(trigger.Name) + " ON " + bodyQuoted(d.Table)).Error; e != nil {
+					return e
+				}
+				return tx.Exec(definition).Error
+			}); e != nil {
+				return e
+			}
+		}
+	}
+	return nil
+}
diff --git a/internal/application/repository/rag_chunk_snapshot.go b/internal/application/repository/rag_chunk_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..bec97fcb1ac714c2f7cb63b491e1c3a7341be4c0
--- /dev/null
+++ b/internal/application/repository/rag_chunk_snapshot.go
@@ -0,0 +1,251 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"math"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// RAGChunkReadRequest identifies server-resolved rows, never supplied text.
+// Lease is the original exact read lease held before content hydration.
+// ExpectedLineage is required when augmenting an already captured result.
+type RAGChunkReadRequest = types.RAGChunkReadRequest
+type RAGChunkInputSnapshot = types.RAGChunkInputSnapshot
+
+// OrdinaryRAGInputProofLookup is a trusted server dependency. Implementations
+// must read persisted producer provenance in tx and bind it to these exact
+// content/metadata rows (including their revision or digest). Request fields,
+// channel, absence of a source and current history-KB settings are not proof.
+// Missing legacy or orphan derivative provenance remains unknown.
+type OrdinaryRAGInputProofLookup interface {
+	ReadOrdinaryRAGInputLineage(context.Context, *gorm.DB, *types.Knowledge, *types.Chunk) (*types.SourceLineage, error)
+}
+
+type ControlledRAGInputProofLookup interface {
+	ReadControlledRAGInputLineage(context.Context, *gorm.DB, *types.Knowledge, *types.Chunk, *types.SourceLineage) (*types.SourceLineage, error)
+}
+
+type RAGChunkSnapshotLookup = interfaces.RAGChunkSnapshotReader
+
+type RAGChunkSnapshotReader struct {
+	db       *gorm.DB
+	ordinary OrdinaryRAGInputProofLookup
+}
+
+func NewRAGChunkSnapshotReader(db *gorm.DB, ordinary OrdinaryRAGInputProofLookup) *RAGChunkSnapshotReader {
+	return &RAGChunkSnapshotReader{db: db, ordinary: ordinary}
+}
+
+// HydrateRAGChunkSnapshots reloads the actual material and original source
+// identity in one snapshot. An index result supplies IDs/scores only; its text
+// can never receive the current publication's identity through this API.
+// The caller still authorizes current grants/publication and verifies leases
+// after hydration and before every model/output boundary.
+func (r *RAGChunkSnapshotReader) HydrateRAGChunkSnapshots(ctx context.Context, requests []RAGChunkReadRequest) ([]RAGChunkInputSnapshot, error) {
+	if ctx == nil || r == nil || r.db == nil {
+		return nil, ErrNextcloudLineageSnapshotStore
+	}
+	if len(requests) > types.SourceLineageMaxSources {
+		return nil, types.ErrSourceLineageLimit
+	}
+	if len(requests) == 0 {
+		return []RAGChunkInputSnapshot{}, nil
+	}
+	options := &sql.TxOptions{ReadOnly: true}
+	switch r.db.Dialector.Name() {
+	case "postgres":
+		options.Isolation = sql.LevelRepeatableRead
+	case "sqlite":
+	default:
+		return nil, ErrNextcloudLineageSnapshotStore
+	}
+	// GORM nested Transaction uses a savepoint and ignores TxOptions. A caller's
+	// weaker transaction cannot silently remove this reader's snapshot contract.
+	if _, nested := r.db.Statement.ConnPool.(gorm.TxCommitter); nested {
+		return nil, ErrNextcloudLineageSnapshotStore
+	}
+	var out []RAGChunkInputSnapshot
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		resolver := &knowledgeRepository{db: tx}
+		seen := map[string]bool{}
+		for _, request := range requests {
+			if request.TenantID == 0 || request.TenantID > math.MaxInt64 || request.KnowledgeBaseID == "" || request.KnowledgeID == "" || (len(request.ChunkIDs) == 0 && !request.MetadataOnly) || (len(request.ChunkIDs) != 0 && request.MetadataOnly) {
+				return ErrNextcloudLineageSnapshotDenied
+			}
+			var knowledge types.Knowledge
+			if err := tx.Where("id = ? AND tenant_id = ? AND knowledge_base_id = ?", request.KnowledgeID, request.TenantID, request.KnowledgeBaseID).Take(&knowledge).Error; err != nil {
+				return lineageSnapshotReadError(err)
+			}
+			if !request.MetadataOnly && (knowledge.ParseStatus != types.ParseStatusCompleted || knowledge.EnableStatus != "enabled") {
+				return ErrNextcloudLineageSnapshotDenied
+			}
+			var kb types.KnowledgeBase
+			if err := tx.Select("id", "tenant_id", "deleted_at").Where("id = ? AND tenant_id = ?", request.KnowledgeBaseID, request.TenantID).Take(&kb).Error; err != nil {
+				return lineageSnapshotReadError(err)
+			}
+			controlled, err := ragKnowledgeIsControlled(tx, &knowledge)
+			if err != nil {
+				return err
+			}
+			var sourceLineage *types.SourceLineage
+			if controlled {
+				current, identity, err := resolver.resolveNextcloudSourceLineageInTx(tx, request.TenantID, request.KnowledgeBaseID, request.KnowledgeID)
+				if err != nil {
+					return err
+				}
+				if err := verifyRAGExactLease(tx, request, identity); err != nil {
+					return err
+				}
+				knowledge = *current
+				sourceLineage, err = types.NewCompleteSourceLineage(identity)
+				if err != nil {
+					return err
+				}
+				if request.ExpectedLineage != nil {
+					if request.ExpectedLineage.RequireComplete() != nil {
+						return types.ErrSourceLineageUnknown
+					}
+					originalFound := false
+					for _, original := range request.ExpectedLineage.Sources {
+						if original.TenantID == identity.TenantID && original.KnowledgeBaseID == identity.KnowledgeBaseID && original.KnowledgeID == identity.KnowledgeID {
+							if original != identity {
+								return ErrNextcloudLineageSnapshotDenied
+							}
+							originalFound = true
+						}
+					}
+					if !originalFound {
+						return ErrNextcloudLineageSnapshotDenied
+					}
+				}
+			}
+			chunkIDs := request.ChunkIDs
+			if request.MetadataOnly {
+				chunkIDs = []string{""}
+			}
+			for _, id := range chunkIDs {
+				var chunk *types.Chunk
+				if !request.MetadataOnly {
+					if id == "" || seen[id] {
+						return ErrNextcloudLineageSnapshotDenied
+					}
+					seen[id] = true
+					if len(seen) > 4096 {
+						return types.ErrSourceLineageLimit
+					}
+					chunk = &types.Chunk{}
+					if err := tx.Where("id = ? AND tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ?", id, request.TenantID, request.KnowledgeBaseID, request.KnowledgeID).Take(chunk).Error; err != nil {
+						return lineageSnapshotReadError(err)
+					}
+					if !chunk.IsEnabled || chunk.IndexStatus == "processing" || chunk.IndexStatus == "failed" {
+						return ErrNextcloudLineageSnapshotDenied
+					}
+				}
+				lineage := sourceLineage
+				if controlled && r.ordinary != nil {
+					proof, ok := r.ordinary.(ControlledRAGInputProofLookup)
+					if !ok {
+						lineage = types.UnknownSourceLineage()
+					} else {
+						var err error
+						lineage, err = proof.ReadControlledRAGInputLineage(ctx, tx, &knowledge, chunk, sourceLineage)
+						if err != nil {
+							return err
+						}
+						if lineage == nil {
+							lineage = types.UnknownSourceLineage()
+						}
+						if err := lineage.Validate(); err != nil {
+							return err
+						}
+					}
+				}
+				if !controlled {
+					lineage = types.UnknownSourceLineage()
+					if r.ordinary != nil {
+						var err error
+						lineage, err = r.ordinary.ReadOrdinaryRAGInputLineage(ctx, tx, &knowledge, chunk)
+						if err != nil {
+							return err
+						}
+						if lineage == nil {
+							lineage = types.UnknownSourceLineage()
+						}
+						if err := lineage.Validate(); err != nil {
+							return err
+						}
+					}
+				}
+				if request.ExpectedLineage != nil {
+					var err error
+					lineage, err = types.UnionSourceLineage(request.ExpectedLineage, lineage)
+					if err != nil {
+						return err
+					}
+				}
+				copyLineage, err := types.UnionSourceLineage(lineage)
+				if err != nil {
+					return err
+				}
+				copyKnowledge := knowledge
+				out = append(out, RAGChunkInputSnapshot{Knowledge: &copyKnowledge, Chunk: chunk, SourceLineage: copyLineage})
+			}
+		}
+		return nil
+	}, options)
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func ragKnowledgeIsControlled(tx *gorm.DB, knowledge *types.Knowledge) (bool, error) {
+	var metadata map[string]json.RawMessage
+	if len(knowledge.Metadata) != 0 {
+		if err := json.Unmarshal(knowledge.Metadata, &metadata); err != nil {
+			return false, ErrNextcloudLineageSnapshotDenied
+		}
+	}
+	if knowledge.Channel == types.ConnectorTypeNextcloud || metadata["nextcloud_instance_id"] != nil || metadata["nextcloud_binding_id"] != nil || metadata["nextcloud_file_id"] != nil {
+		return true, nil
+	}
+	// An erased channel/metadata marker must not recertify a retained source row
+	// as ordinary. This is exact-document positive evidence, not a never proof.
+	var versions, revisions int64
+	if err := tx.Table("nextcloud_source_versions").Where("candidate_knowledge_id = ?", knowledge.ID).Count(&versions).Error; err != nil {
+		return false, lineageSnapshotReadError(err)
+	}
+	if err := tx.Table("nextcloud_source_revisions").Where("candidate_knowledge_id = ?", knowledge.ID).Count(&revisions).Error; err != nil {
+		return false, lineageSnapshotReadError(err)
+	}
+	return versions > 0 || revisions > 0, nil
+}
+
+func verifyRAGExactLease(tx *gorm.DB, request RAGChunkReadRequest, identity types.SourceIdentity) error {
+	lease := request.Lease
+	if lease == nil || lease.ID == "" || lease.OwnerID == "" || lease.Kind != string(NextcloudContentReadLease) || lease.Epoch <= 0 ||
+		lease.TenantID != request.TenantID || lease.KnowledgeBaseID != request.KnowledgeBaseID || lease.KnowledgeID != request.KnowledgeID || uint64(lease.Epoch) != identity.Revision {
+		return ErrNextcloudContentLeaseDenied
+	}
+	var row nextcloudContentLeaseRow
+	if err := tx.Where("lease_id = ?", lease.ID).Take(&row).Error; err != nil {
+		return lineageSnapshotReadError(err)
+	}
+	nowMS, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return fmt.Errorf("%w: lease clock", ErrNextcloudLineageSnapshotStore)
+	}
+	if row.TenantID != lease.TenantID || row.KnowledgeBaseID != lease.KnowledgeBaseID || row.KnowledgeID != lease.KnowledgeID ||
+		row.Kind != string(lease.Kind) || row.OwnerID != lease.OwnerID || row.Epoch != lease.Epoch || row.ReleasedAtMS != nil || row.ExpiresAtMS <= nowMS {
+		return ErrNextcloudContentLeaseDenied
+	}
+	return nil
+}
+
+var _ RAGChunkSnapshotLookup = (*RAGChunkSnapshotReader)(nil)
