+func runKnowledgeTrustedTemplates(t *testing.T, pg bool) {
+	for _, mode := range []string{"new actual admin template", "new exact code template", "derived all actual parents", "parent body ABA", "model ABA", "admin revoke", "unknown old custom YAML", "old config no adoption"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newEnrichmentTestFixture(t, pg)
+			applyEnrichmentTemplateMigration(t, f, pg)
+			svc := NewKnowledgeEnrichmentTemplateService(f.store, f.s.repo, f.s.modelService, f.guard, repository.NewNextcloudContentLeaseStore(f.db))
+			_, _, e := f.s.repo.FinalizeSubtask(f.build, f.k.ID)
+			require.NoError(t, e)
+			switch mode {
+			case "new actual admin template":
+				_, e = svc.SetIndependentTemplate(f.ctx, 7, "kb", "summary", "A newly authored actual summary template in {{language}}.")
+			case "new exact code template":
+				_, e = svc.InstallCodeTemplate(context.Background(), 7, "kb", "summary", "An exact code-owned summary instruction in {{language}}.")
+			case "unknown old custom YAML":
+				f.s.config.Conversation.GenerateSummaryPrompt = "unproved legacy operator text"
+				require.False(t, f.post.enqueueSummaryGenerationTask(f.build, types.KnowledgePostProcessPayload{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: f.k.ID}, 0))
+				require.Zero(t, f.model.calls)
+				return
+			case "old config no adoption":
+				require.NoError(t, f.db.Model(&types.KnowledgeBase{}).Where("id='kb'").Update("enrichment_templates", types.JSON(`{"summary":"unproved old current row"}`)).Error)
+				_, e = svc.SetIndependentTemplate(f.ctx, 7, "kb", "summary", "new literal cannot recertify unknown retained controls")
+				require.Error(t, e)
+				require.Zero(t, f.model.calls)
+				return
+			default:
+				if mode == "parent body ABA" {
+					f.model.beforeReturn = func() {
+						old := f.chunks[0].Content
+						require.NoError(t, f.db.Model(&types.Chunk{}).Where("id = ?", f.chunks[0].ID).Update("content", "changed").Error)
+						require.NoError(t, f.db.Model(&types.Chunk{}).Where("id = ?", f.chunks[0].ID).Update("content", old).Error)
+					}
+				}
+				if mode == "model ABA" {
+					f.model.beforeReturn = func() {
+						require.NoError(t, f.db.Model(&types.Model{}).Where("id='summary'").Update("name", "changed").Error)
+						require.NoError(t, f.db.Model(&types.Model{}).Where("id='summary'").Update("name", "local summary").Error)
+					}
+				}
+				if mode == "admin revoke" {
+					f.model.beforeReturn = func() {
+						require.NoError(t, f.db.Model(&types.TenantMember{}).Where("user_id='enrich-human'").Update("role", types.TenantRoleViewer).Error)
+					}
+				}
+				_, e = svc.GenerateDerivedTemplate(f.ctx, 7, "kb", "summary", []string{f.k.ID})
+				require.Equal(t, 1, f.model.calls)
+			}
+			if mode == "parent body ABA" || mode == "model ABA" || mode == "admin revoke" {
+				require.Error(t, e)
+				var kb types.KnowledgeBase
+				require.NoError(t, f.db.Where("id='kb'").Take(&kb).Error)
+				require.Nil(t, kb.EnrichmentTemplates)
+				return
+			}
+			require.NoError(t, e)
+			old := f.k
+			require.Error(t, f.store.RecheckKnowledgeBuildInputs(f.build, repository.KnowledgeBuildInputProofFromContext(f.build)), "old original config is never re-stamped")
+			ctx := newTemplateArtifact(t, f, "template-new-artifact")
+			f.s.config.Conversation.GenerateSummaryPrompt = "unknown global YAML is not the proved override"
+			require.True(t, f.post.enqueueSummaryGenerationTask(ctx, types.KnowledgePostProcessPayload{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: f.k.ID, Language: "en-US"}, 0))
+			require.NoError(t, f.s.ProcessSummaryGeneration(context.Background(), f.queue.tasks[len(f.queue.tasks)-1]))
+			assertEnrichmentReadable(t, f, []string{f.chunks[0].ID})
+			require.NotEqual(t, old.ID, f.k.ID)
+		})
+	}
+}
