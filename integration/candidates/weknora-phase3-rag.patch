+package session
+
+import (
+	"context"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/stretchr/testify/require"
+)
+
+type rawUserLineageMessages struct {
+	interfaces.MessageService
+	created *types.Message
+}
+
+func (s *rawUserLineageMessages) CreateMessage(_ context.Context, message *types.Message) (*types.Message, error) {
+	s.created = message
+	return message, nil
+}
+
+func TestRawUserInputLineageActualRequestWriterAdmitsOnlyPureText(t *testing.T) {
+	for _, mode := range []string{"raw text", "image", "attachment"} {
+		t.Run(mode, func(t *testing.T) {
+			messages := &rawUserLineageMessages{}
+			handler := &Handler{messageService: messages}
+			var images types.MessageImages
+			var attachments types.MessageAttachments
+			if mode == "image" {
+				images = types.MessageImages{{URL: "resource://opaque", Caption: "uncaptured caption"}}
+			}
+			if mode == "attachment" {
+				attachments = types.MessageAttachments{{FileName: "opaque attachment"}}
+			}
+			created, err := handler.createUserMessage(context.Background(), "session", "original raw request text", "request", nil, images, attachments, "web", nil)
+			require.NoError(t, err)
+			require.Equal(t, "original raw request text", created.Content)
+			require.True(t, created.IsCompleted)
+			require.Equal(t, "user", created.Role)
+			require.NotNil(t, created.SourceLineage)
+			if mode == "raw text" {
+				require.NoError(t, created.SourceLineage.RequireComplete())
+				require.Empty(t, created.SourceLineage.Sources)
+			} else {
+				require.ErrorIs(t, created.SourceLineage.RequireComplete(), types.ErrSourceLineageUnknown)
+			}
+		})
+	}
+}
diff --git a/internal/handler/session/native_live_replay.go b/internal/handler/session/native_live_replay.go
new file mode 100644
index 0000000000000000000000000000000000000000..ab02a5c6eee266c4e29fbd069e59b542c2d1177c
--- /dev/null
+++ b/internal/handler/session/native_live_replay.go
@@ -0,0 +1,494 @@
+package session
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"sync"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/storageurl"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/gin-contrib/sse"
+	"github.com/gin-gonic/gin"
+)
+
+const nativeLiveFrameTTL = 2 * time.Minute
+const nativeLiveMaxBytes = 8 << 20
+
+type nativeLiveMaterialService interface {
+	HasOriginalMessageMaterialStore() bool
+	MessageNativeLiveIdentity(context.Context, string, string) (*types.Message, string, error)
+	CaptureNativeLiveMaterialParents(context.Context) ([]*types.MessageMaterialSnapshot, error)
+	BeginNativeLiveMaterialReceiver(context.Context, []*types.MessageMaterialSnapshot) (func() error, func(), error)
+	CheckNativeLiveIdentity(context.Context, *types.Message, string) error
+	CheckNativeLiveFramePublication(context.Context, *types.Message, *types.SourceLineage) error
+	BeginNativeLiveFrameSources(context.Context, *types.Message, *types.SourceLineage) (func() error, func(), error)
+}
+
+type nativeLiveKey struct {
+	Service                                      nativeLiveMaterialService
+	Tenant                                       uint64
+	Owner, Session, Message, Request, Generation string
+}
+type nativeLiveFrame struct {
+	Sequence       uint64
+	Body           []byte
+	Digest         [32]byte
+	Parents        []byte
+	Lineage        []byte
+	StaticTerminal bool
+	Expires        time.Time
+}
+type nativeLiveRun struct {
+	mu       sync.Mutex
+	key      nativeLiveKey
+	control  *types.Message
+	frames   []nativeLiveFrame
+	sequence uint64
+	bytes    int
+	expires  time.Time
+	timer    *time.Timer
+	closed   bool
+}
+
+var nativeLiveRuns = struct {
+	sync.Mutex
+	items map[nativeLiveKey]*nativeLiveRun
+}{items: make(map[nativeLiveKey]*nativeLiveRun)}
+
+func nativeLiveOwner(ctx context.Context) string {
+	if principal, ok := types.PrincipalFromContext(ctx); ok && principal.Type == types.PrincipalWebUser {
+		return principal.ID
+	}
+	return types.SessionOwnerIDFromContext(ctx)
+}
+
+func eraseNativeLiveRun(run *nativeLiveRun) {
+	nativeLiveRuns.Lock()
+	if nativeLiveRuns.items[run.key] == run {
+		delete(nativeLiveRuns.items, run.key)
+	}
+	nativeLiveRuns.Unlock()
+	run.mu.Lock()
+	run.closed = true
+	for i := range run.frames {
+		run.frames[i].Body = nil
+		run.frames[i].Parents = nil
+		run.frames[i].Lineage = nil
+	}
+	run.frames = nil
+	run.bytes = 0
+	if run.timer != nil {
+		run.timer.Stop()
+	}
+	run.mu.Unlock()
+}
+
+type nativeLiveAppender struct {
+	interfaces.StreamManager
+	service         nativeLiveMaterialService
+	producer        context.Context
+	run             *nativeLiveRun
+	registrationErr error
+}
+
+func (h *Handler) nativeLiveStreamManager(ctx context.Context, tenant uint64, session, message, request string) interfaces.StreamManager {
+	actual, ok := h.messageService.(nativeLiveMaterialService)
+	if !ok || !actual.HasOriginalMessageMaterialStore() {
+		return h.streamManager
+	}
+	appender := &nativeLiveAppender{StreamManager: h.streamManager, service: actual, producer: ctx}
+	control, generation, err := actual.MessageNativeLiveIdentity(ctx, session, message)
+	if err != nil {
+		appender.registrationErr = err
+		return appender
+	}
+	if control == nil || control.IsCompleted || control.Role != "assistant" || control.RequestID != request || generation == "" || nativeLiveOwner(ctx) == "" {
+		appender.registrationErr = access.ErrNextcloudPublicationUnavailable
+		return appender
+	}
+	// The metadata API already checked this exact owner in its authority tx.
+	key := nativeLiveKey{actual, tenant, nativeLiveOwner(ctx), session, message, request, generation}
+	copy, err := cloneNativeLiveControl(control)
+	if err != nil {
+		appender.registrationErr = err
+		return appender
+	}
+	run := &nativeLiveRun{key: key, control: copy, expires: time.Now().Add(nativeLiveFrameTTL)}
+	nativeLiveRuns.Lock()
+	prior := nativeLiveRuns.items[key]
+	if prior == nil {
+		nativeLiveRuns.items[key] = run
+	} else {
+		run = prior
+	}
+	nativeLiveRuns.Unlock()
+	run.mu.Lock()
+	if run.timer == nil {
+		run.timer = time.AfterFunc(nativeLiveFrameTTL, func() { eraseNativeLiveRun(run) })
+	}
+	run.mu.Unlock()
+	appender.run = run
+	return appender
+}
+
+func cloneNativeLiveControl(original *types.Message) (*types.Message, error) {
+	encoded, err := json.Marshal(struct {
+		Body        *types.Message
+		Execution   types.MessageExecutionContext
+		AgentTenant uint64
+	}{original, original.ExecutionContext, original.AgentTenantID})
+	if err != nil {
+		return nil, err
+	}
+	var copy struct {
+		Body        *types.Message
+		Execution   types.MessageExecutionContext
+		AgentTenant uint64
+	}
+	if err := json.Unmarshal(encoded, &copy); err != nil {
+		return nil, err
+	}
+	copy.Body.ExecutionContext = copy.Execution
+	copy.Body.AgentTenantID = copy.AgentTenant
+	return copy.Body, nil
+}
+
+func (a *nativeLiveAppender) AppendEvent(ctx context.Context, session, message string, frame interfaces.StreamEvent) error {
+	// Completed rows have their own saved-original receipt and replay path.
+	if frame.Type == types.ResponseTypeComplete {
+		if a.registrationErr != nil {
+			return a.registrationErr
+		}
+		if a.run == nil || session != a.run.key.Session || message != a.run.key.Message {
+			return access.ErrNextcloudPublicationUnavailable
+		}
+		current, generation, err := a.service.MessageNativeLiveIdentity(ctx, session, message)
+		if err != nil {
+			return err
+		}
+		if current == nil || !current.IsCompleted || generation != a.run.key.Generation || current.RequestID != a.run.key.Request {
+			return access.ErrNextcloudPublicationDenied
+		}
+		err = a.StreamManager.AppendEvent(ctx, session, message, frame)
+		if err == nil && a.run != nil {
+			eraseNativeLiveRun(a.run)
+		}
+		return err
+	}
+	if a.registrationErr != nil {
+		return a.registrationErr
+	}
+	if a.run == nil || session != a.run.key.Session || message != a.run.key.Message {
+		return access.ErrNextcloudPublicationUnavailable
+	}
+	static := frame.Type == types.ResponseTypeError && frame.Done
+	var parents []*types.MessageMaterialSnapshot
+	if static {
+		// Only a fixed code-origin terminal recipe enters the native registry.
+		// The raw provider/error metadata is never stored as authenticated bytes.
+		frame = interfaces.StreamEvent{ID: frame.ID, Type: types.ResponseTypeError, Content: "Generation could not complete; please retry after checking access", Done: true, Timestamp: time.Now(), Data: map[string]interface{}{"error_code": "generation_failed"}}
+	} else {
+		if frame.SourceLineage.RequireComplete() != nil {
+			return access.ErrNextcloudPublicationDenied
+		}
+		var err error
+		parents, err = a.service.CaptureNativeLiveMaterialParents(a.producer)
+		if err != nil {
+			return err
+		}
+		if len(parents) == 0 {
+			return access.ErrNextcloudPublicationUnavailable
+		}
+		for _, parent := range parents {
+			if parent == nil || parent.Messages != nil {
+				return access.ErrNextcloudPublicationDenied
+			}
+		}
+		if err := a.service.CheckNativeLiveIdentity(a.producer, a.run.control, a.run.key.Generation); err != nil {
+			return err
+		}
+		if err := a.service.CheckNativeLiveFramePublication(a.producer, a.run.control, frame.SourceLineage); err != nil {
+			return err
+		}
+	}
+	if frame.Timestamp.IsZero() {
+		frame.Timestamp = time.Now()
+	}
+	body, err := json.Marshal(frame)
+	if err != nil {
+		return err
+	}
+	parentBytes, err := json.Marshal(parents)
+	if err != nil {
+		return err
+	}
+	lineageBytes, err := json.Marshal(frame.SourceLineage)
+	if err != nil {
+		return err
+	}
+	run := a.run
+	run.mu.Lock()
+	if run.closed || time.Now().After(run.expires) || run.bytes+len(body)+len(parentBytes)+len(lineageBytes) > nativeLiveMaxBytes {
+		run.mu.Unlock()
+		eraseNativeLiveRun(run)
+		return access.ErrNextcloudPublicationUnavailable
+	}
+	// Freeze and publish in actual append order; delta event IDs repeat.
+	err = a.StreamManager.AppendEvent(ctx, session, message, frame)
+	if err == nil {
+		run.sequence++
+		now := time.Now()
+		kept := run.frames[:0]
+		for i := range run.frames {
+			old := run.frames[i]
+			if old.Expires.After(now) {
+				kept = append(kept, old)
+			} else {
+				run.bytes -= len(old.Body) + len(old.Parents) + len(old.Lineage)
+				run.frames[i].Body = nil
+				run.frames[i].Parents = nil
+				run.frames[i].Lineage = nil
+			}
+		}
+		run.frames = append(kept, nativeLiveFrame{Sequence: run.sequence, Body: body, Digest: sha256.Sum256(body), Parents: parentBytes, Lineage: lineageBytes, StaticTerminal: static, Expires: now.Add(nativeLiveFrameTTL)})
+		run.bytes += len(body) + len(parentBytes) + len(lineageBytes)
+		run.expires = now.Add(nativeLiveFrameTTL)
+		run.timer.Reset(nativeLiveFrameTTL)
+	}
+	run.mu.Unlock()
+	return err
+}
+
+func (run *nativeLiveRun) read(after uint64) ([]nativeLiveFrame, error) {
+	run.mu.Lock()
+	defer run.mu.Unlock()
+	if run.closed || time.Now().After(run.expires) {
+		return nil, access.ErrNextcloudPublicationUnavailable
+	}
+	result := []nativeLiveFrame{}
+	for _, entry := range run.frames {
+		if entry.Sequence <= after {
+			continue
+		}
+		if time.Now().After(entry.Expires) {
+			return nil, access.ErrNextcloudPublicationUnavailable
+		}
+		copy := entry
+		copy.Body = nil // Scope and original proof are acquired before body access.
+		copy.Parents = append([]byte(nil), entry.Parents...)
+		copy.Lineage = append([]byte(nil), entry.Lineage...)
+		result = append(result, copy)
+	}
+	return result, nil
+}
+
+func (run *nativeLiveRun) readBody(metadata nativeLiveFrame) ([]byte, error) {
+	run.mu.Lock()
+	defer run.mu.Unlock()
+	if run.closed || time.Now().After(run.expires) {
+		return nil, access.ErrNextcloudPublicationUnavailable
+	}
+	for _, current := range run.frames {
+		if current.Sequence != metadata.Sequence {
+			continue
+		}
+		if time.Now().After(current.Expires) || current.Digest != metadata.Digest || !current.Expires.Equal(metadata.Expires) || !bytes.Equal(current.Parents, metadata.Parents) || !bytes.Equal(current.Lineage, metadata.Lineage) || current.StaticTerminal != metadata.StaticTerminal {
+			return nil, access.ErrNextcloudPublicationDenied
+		}
+		if sha256.Sum256(current.Body) != current.Digest {
+			return nil, access.ErrNextcloudPublicationDenied
+		}
+		return append([]byte(nil), current.Body...), nil
+	}
+	return nil, access.ErrNextcloudPublicationUnavailable
+}
+
+func (h *Handler) tryNativeLiveReplay(ctx context.Context, c *gin.Context, session, message string, rewriter *storageurl.StreamRewriter) bool {
+	actual, ok := h.messageService.(nativeLiveMaterialService)
+	if !ok || !actual.HasOriginalMessageMaterialStore() {
+		return false
+	}
+	control, generation, err := actual.MessageNativeLiveIdentity(ctx, session, message)
+	if err != nil {
+		_ = c.Error(nativeSavedReplayHTTPError(err))
+		return true
+	}
+	if control == nil {
+		_ = c.Error(nativeSavedReplayHTTPError(access.ErrNextcloudPublicationUnavailable))
+		return true
+	}
+	if control.IsCompleted {
+		return h.tryNativeSavedReplay(ctx, c, session, message, rewriter)
+	}
+	tenant := types.MustTenantIDFromContext(ctx)
+	key := nativeLiveKey{actual, tenant, nativeLiveOwner(ctx), session, message, control.RequestID, generation}
+	nativeLiveRuns.Lock()
+	run := nativeLiveRuns.items[key]
+	nativeLiveRuns.Unlock()
+	if run == nil {
+		_ = c.Error(nativeSavedReplayHTTPError(access.ErrNextcloudPublicationUnavailable))
+		return true
+	}
+	prior := c.Writer
+	defer func() { c.Writer = prior }()
+	checks := []func() error{}
+	closes := []func(){}
+	parentHeld := map[[32]byte]bool{}
+	sourceHeld := map[[32]byte]bool{}
+	defer func() {
+		for i := len(closes) - 1; i >= 0; i-- {
+			closes[i]()
+		}
+	}()
+	check := func() error {
+		if err := actual.CheckNativeLiveIdentity(ctx, run.control, generation); err != nil {
+			return err
+		}
+		for _, check := range checks {
+			if err := check(); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	writer := &nativeSavedReplayWriter{ResponseWriter: prior, ctx: c.Request.Context(), check: check}
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+	var offset uint64
+	for {
+		current, currentGeneration, err := actual.MessageNativeLiveIdentity(ctx, session, message)
+		if err != nil {
+			if !c.Writer.Written() {
+				_ = c.Error(nativeSavedReplayHTTPError(err))
+			}
+			return true
+		}
+		if currentGeneration != generation {
+			return true
+		}
+		if current.IsCompleted {
+			// Discard the old live holdback and acquire the completed saved receipt.
+			c.Writer = prior
+			fresh, err := h.resolveStreamRewriter(c)
+			if err == nil {
+				h.tryNativeSavedReplay(ctx, c, session, message, fresh)
+			}
+			return true
+		}
+		entries, err := run.read(offset)
+		if err != nil {
+			if !c.Writer.Written() {
+				_ = c.Error(nativeSavedReplayHTTPError(err))
+			}
+			return true
+		}
+		for _, entry := range entries {
+			if !entry.StaticTerminal {
+				var parents []*types.MessageMaterialSnapshot
+				if err := json.Unmarshal(entry.Parents, &parents); err != nil {
+					return true
+				}
+				parentKey := sha256.Sum256(entry.Parents)
+				if !parentHeld[parentKey] {
+					parentCheck, parentClose, err := actual.BeginNativeLiveMaterialReceiver(ctx, parents)
+					if err != nil {
+						current, _, controlErr := actual.MessageNativeLiveIdentity(ctx, session, message)
+						if controlErr == nil && current.IsCompleted {
+							c.Writer = prior
+							fresh, _ := h.resolveStreamRewriter(c)
+							h.tryNativeSavedReplay(ctx, c, session, message, fresh)
+						}
+						return true
+					}
+					if parentCheck == nil || parentClose == nil {
+						if parentClose != nil {
+							parentClose()
+						}
+						return true
+					}
+					closes = append(closes, parentClose)
+					checks = append(checks, parentCheck)
+					parentHeld[parentKey] = true
+				}
+				var lineage *types.SourceLineage
+				if err := json.Unmarshal(entry.Lineage, &lineage); err != nil {
+					return true
+				}
+				sourceKey := sha256.Sum256(entry.Lineage)
+				if !sourceHeld[sourceKey] {
+					sourceCheck, sourceClose, err := actual.BeginNativeLiveFrameSources(ctx, run.control, lineage)
+					if err != nil {
+						return true
+					}
+					if sourceCheck == nil || sourceClose == nil {
+						if sourceClose != nil {
+							sourceClose()
+						}
+						return true
+					}
+					closes = append(closes, sourceClose)
+					checks = append(checks, sourceCheck)
+					sourceHeld[sourceKey] = true
+				}
+			}
+			if entry.StaticTerminal {
+				writer.check = func() error { return actual.CheckNativeLiveIdentity(ctx, run.control, generation) }
+			} else {
+				writer.check = check
+			}
+			if err := writer.beforeWrite(); err != nil {
+				return true
+			}
+			body, err := run.readBody(entry)
+			if err != nil {
+				return true
+			}
+			var frame interfaces.StreamEvent
+			if err := json.Unmarshal(body, &frame); err != nil {
+				return true
+			}
+			frameCheck := writer.check
+			writer.check = func() error {
+				if err := frameCheck(); err != nil {
+					return err
+				}
+				if _, err := run.readBody(entry); err != nil {
+					return err
+				}
+				return nil
+			}
+			c.Writer = writer
+			if err := writer.check(); err != nil {
+				return true
+			}
+			setSSEHeaders(c)
+			if entry.StaticTerminal {
+				emitSafeTerminalGenerationError(c, control.RequestID)
+				return true
+			}
+			response := buildStreamResponseFor(ctx, frame, control.RequestID, rewriter)
+			var encoded bytes.Buffer
+			if err := sse.Encode(&encoded, sse.Event{Event: "message", Data: response}); err != nil {
+				return true
+			}
+			if _, err := writer.Write(encoded.Bytes()); err != nil {
+				return true
+			}
+			writer.Flush()
+			if writer.denied != nil {
+				return true
+			}
+			offset = entry.Sequence
+		}
+		select {
+		case <-c.Request.Context().Done():
+			return true
+		case <-ticker.C:
+		}
+	}
+}
diff --git a/internal/handler/session/native_live_replay_test.go b/internal/handler/session/native_live_replay_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2d8c80a150584a9fe23e6a4c99938128b275d639
--- /dev/null
+++ b/internal/handler/session/native_live_replay_test.go
@@ -0,0 +1,39 @@
+package session
+
+import (
+	"crypto/sha256"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNativeLiveMetadataPeekExpiryAndBodyIdentityRecheck(t *testing.T) {
+	for _, mode := range []string{"expired_after_peek", "body_changed_after_peek", "lineage_changed_after_peek", "closed_after_peek"} {
+		t.Run(mode, func(t *testing.T) {
+			body := []byte(`{"content":"native actual producer bytes"}`)
+			entry := nativeLiveFrame{Sequence: 1, Body: body, Digest: sha256.Sum256(body), Parents: []byte(`[{"metadata_digest":"original"}]`), Lineage: []byte(`{"version":1,"state":"complete","sources":[]}`), Expires: time.Now().Add(time.Minute)}
+			run := &nativeLiveRun{frames: []nativeLiveFrame{entry}, expires: time.Now().Add(time.Minute)}
+			metadata, err := run.read(0)
+			require.NoError(t, err)
+			require.Len(t, metadata, 1)
+			require.Nil(t, metadata[0].Body, "metadata planning must not copy raw native frame bytes before leases")
+			switch mode {
+			case "expired_after_peek":
+				run.frames[0].Expires = time.Now().Add(-time.Second)
+			case "body_changed_after_peek":
+				run.frames[0].Body = []byte(`{"content":"foreign bytes"}`)
+			case "lineage_changed_after_peek":
+				run.frames[0].Lineage = []byte(`{"version":1,"state":"unknown","sources":[]}`)
+			case "closed_after_peek":
+				eraseNativeLiveRun(run)
+			}
+			_, err = run.readBody(metadata[0])
+			require.Error(t, err, "an old metadata plan must never certify changed or expired native bytes")
+			if mode == "closed_after_peek" {
+				require.Empty(t, run.frames)
+				require.Zero(t, run.bytes)
+			}
+		})
+	}
+}
diff --git a/internal/handler/session/native_saved_replay.go b/internal/handler/session/native_saved_replay.go
new file mode 100644
index 0000000000000000000000000000000000000000..fce42a9d819bf31baaf9406f2f9bdbeeb28782cf
--- /dev/null
+++ b/internal/handler/session/native_saved_replay.go
@@ -0,0 +1,195 @@
+package session
+
+import (
+	"bytes"
+	"context"
+	stderrors "errors"
+	"fmt"
+
+	agenttools "github.com/Tencent/WeKnora/internal/agent/tools"
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/errors"
+	"github.com/Tencent/WeKnora/internal/storageurl"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/gin-contrib/sse"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+type completedMessageMaterialReplay interface {
+	BeginCompletedMessageMaterialReplay(context.Context, string, string) (*types.Message, func() error, func(), error)
+}
+
+// A nil native message means the service checked current control metadata and
+// found a running turn. A completed row without an original receipt is an error.
+func (h *Handler) tryNativeSavedReplay(ctx context.Context, c *gin.Context, sessionID, messageID string, rewriter *storageurl.StreamRewriter) bool {
+	reader, ok := h.messageService.(completedMessageMaterialReplay)
+	if !ok {
+		return false
+	}
+	message, check, closeRead, err := reader.BeginCompletedMessageMaterialReplay(ctx, sessionID, messageID)
+	if closeRead != nil {
+		defer closeRead()
+	}
+	if err != nil {
+		_ = c.Error(nativeSavedReplayHTTPError(err))
+		return true
+	}
+	if message == nil {
+		return false
+	}
+	if check == nil || closeRead == nil || !message.IsCompleted || message.Role != "assistant" || message.ID != messageID || message.SessionID != sessionID || message.SourceLineage.RequireComplete() != nil {
+		_ = c.Error(nativeSavedReplayHTTPError(access.ErrNextcloudPublicationUnavailable))
+		return true
+	}
+	if err := check(); err != nil {
+		_ = c.Error(nativeSavedReplayHTTPError(err))
+		return true
+	}
+	if err := emitNativeSavedReplay(ctx, c, message, check, rewriter); err != nil && !c.Writer.Written() {
+		_ = c.Error(nativeSavedReplayHTTPError(err))
+	}
+	return true
+}
+
+// Every value below comes from the typed original material capture. Transient
+// Redis events, session titles, attachments of another message, and artifact
+// rows have no receipt in this capture and supply no reconstructed fields.
+func nativeSavedReplayEvents(message *types.Message) []interfaces.StreamEvent {
+	events := []interfaces.StreamEvent{{ID: "saved-query-" + message.ID, Type: types.ResponseTypeAgentQuery, Timestamp: message.CreatedAt, Data: map[string]interface{}{
+		"session_id": message.SessionID, "assistant_message_id": message.ID, "assistant_created_at": message.CreatedAt,
+	}}}
+	appendEvent := func(id string, kind types.ResponseType, content string, done bool, data map[string]interface{}) {
+		events = append(events, interfaces.StreamEvent{ID: id, Type: kind, Content: content, Done: done, Timestamp: message.CreatedAt, Data: data})
+	}
+	for index, step := range message.AgentSteps {
+		stepID := fmt.Sprintf("saved-step-%s-%d", message.ID, index)
+		if step.Thought != "" {
+			appendEvent(stepID+"-thought", types.ResponseTypeThinking, step.Thought, true, map[string]interface{}{"event_id": stepID + "-thought"})
+		}
+		if step.ReasoningContent != "" && step.ReasoningContent != step.Thought {
+			appendEvent(stepID+"-reasoning", types.ResponseTypeThinking, step.ReasoningContent, true, map[string]interface{}{"event_id": stepID + "-reasoning"})
+		}
+		for callIndex, call := range step.ToolCalls {
+			callID := fmt.Sprintf("%s-call-%d", stepID, callIndex)
+			name := call.ExecutionName()
+			appendEvent(callID, types.ResponseTypeToolCall, fmt.Sprintf("Calling tool: %s", name), false, map[string]interface{}{
+				"tool_name": name, "tool_call_id": call.ID, "arguments": agenttools.SanitizeSandboxFileCallArgs(name, call.ExecutionArgs()),
+			})
+			if call.Result != nil {
+				result := call.Result
+				data := agenttools.SanitizeToolResultForClient(name, result)
+				data["tool_name"], data["tool_call_id"] = name, call.ID
+				data["success"], data["error"], data["duration_ms"] = result.Success, result.Error, call.Duration
+				appendEvent(callID+"-result", types.ResponseTypeToolResult, agenttools.StreamContentForToolResult(name, result.Success, result.Error, result.Data), false, data)
+			}
+			if call.Reflection != "" {
+				appendEvent(callID+"-reflection", types.ResponseTypeReflection, call.Reflection, true, map[string]interface{}{"event_id": callID + "-reflection", "tool_call_id": call.ID})
+			}
+		}
+	}
+	if len(message.KnowledgeReferences) > 0 {
+		appendEvent("saved-references-"+message.ID, types.ResponseTypeReferences, "", false, map[string]interface{}{"references": message.KnowledgeReferences})
+	}
+	answerID := "saved-answer-" + message.ID
+	appendEvent(answerID, types.ResponseTypeAnswer, message.Content, true, map[string]interface{}{"event_id": answerID, "is_fallback": message.IsFallback})
+	appendEvent("saved-complete-"+message.ID, types.ResponseTypeComplete, "", true, map[string]interface{}{
+		"final_content": message.Content, "total_steps": len(message.AgentSteps), "total_duration_ms": message.AgentDurationMs, "usage": message.Usage,
+	})
+	events[len(events)-1].Usage = message.Usage
+	return events
+}
+
+func emitNativeSavedReplay(ctx context.Context, c *gin.Context, message *types.Message, check func() error, rewriter *storageurl.StreamRewriter) error {
+	prior := c.Writer
+	writer := &nativeSavedReplayWriter{ResponseWriter: prior, ctx: ctx, check: check}
+	c.Writer = writer
+	defer func() { c.Writer = prior }()
+	setSSEHeaders(c)
+	for _, frame := range nativeSavedReplayEvents(message) {
+		// Serialize the whole frame, including public resource rewrites, before
+		// the final original-material check at the actual HTTP write boundary.
+		response := buildStreamResponseFor(ctx, frame, message.RequestID, rewriter)
+		var encoded bytes.Buffer
+		if err := sse.Encode(&encoded, sse.Event{Event: "message", Data: response}); err != nil {
+			return err
+		}
+		if _, err := writer.Write(encoded.Bytes()); err != nil {
+			return err
+		}
+		writer.Flush()
+		if writer.denied != nil {
+			return writer.denied
+		}
+	}
+	return nil
+}
+
+type nativeSavedReplayWriter struct {
+	gin.ResponseWriter
+	ctx    context.Context
+	check  func() error
+	denied error
+}
+
+func (w *nativeSavedReplayWriter) beforeWrite() error {
+	if w.denied == nil {
+		w.denied = w.ctx.Err()
+	}
+	if w.denied == nil {
+		w.denied = w.check()
+	}
+	return w.denied
+}
+func (w *nativeSavedReplayWriter) deny(err error) {
+	if w.ResponseWriter.Written() {
+		return
+	}
+	app, _ := errors.IsAppError(nativeSavedReplayHTTPError(err))
+	w.ResponseWriter.Header().Del("Content-Type")
+	w.ResponseWriter.Header().Del("Content-Length")
+	w.ResponseWriter.WriteHeader(app.HTTPCode)
+	w.ResponseWriter.WriteHeaderNow()
+}
+func (w *nativeSavedReplayWriter) Write(body []byte) (int, error) {
+	if err := w.beforeWrite(); err != nil {
+		w.deny(err)
+		return 0, err
+	}
+	return w.ResponseWriter.Write(body)
+}
+func (w *nativeSavedReplayWriter) WriteString(body string) (int, error) {
+	return w.Write([]byte(body))
+}
+func (w *nativeSavedReplayWriter) WriteHeaderNow() {
+	if err := w.beforeWrite(); err != nil {
+		w.deny(err)
+		return
+	}
+	w.ResponseWriter.WriteHeaderNow()
+}
+func (w *nativeSavedReplayWriter) Flush() {
+	if err := w.beforeWrite(); err != nil {
+		w.deny(err)
+		return
+	}
+	w.ResponseWriter.Flush()
+}
+
+func nativeSavedReplayHTTPError(err error) error {
+	if stderrors.Is(err, errors.ErrSessionNotFound) || stderrors.Is(err, gorm.ErrRecordNotFound) {
+		return errors.NewNotFoundError("Session or message not found")
+	}
+	if stderrors.Is(err, repository.ErrKnowledgeInputChanged) || stderrors.Is(err, types.ErrSourceLineageUnknown) || stderrors.Is(err, repository.ErrNextcloudContentGCUncovered) {
+		return errors.NewServiceUnavailableError("Saved message original material is unavailable")
+	}
+	if stderrors.Is(err, access.ErrForbidden) || stderrors.Is(err, access.ErrNextcloudPublicationDenied) {
+		return errors.NewForbiddenError("Current source access is required")
+	}
+	if stderrors.Is(err, access.ErrNextcloudPublicationUnavailable) {
+		return errors.NewServiceUnavailableError("Cannot verify original saved message access")
+	}
+	return errors.NewServiceUnavailableError("Saved message original material is unavailable")
+}
diff --git a/internal/handler/session/nextcloud_raw_search.go b/internal/handler/session/nextcloud_raw_search.go
new file mode 100644
index 0000000000000000000000000000000000000000..042909bb98d66c0e222699a6f8e9dd8faab07ee1
--- /dev/null
+++ b/internal/handler/session/nextcloud_raw_search.go
@@ -0,0 +1,327 @@
+package session
+
+import (
+	"context"
+	stderrors "errors"
+	"math"
+	"net/http"
+	"reflect"
+	"strconv"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/application/access"
+	"github.com/Tencent/WeKnora/internal/application/readlease"
+	"github.com/Tencent/WeKnora/internal/application/repository"
+	"github.com/Tencent/WeKnora/internal/errors"
+	"github.com/Tencent/WeKnora/internal/middleware"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/gin-gonic/gin"
+)
+
+func rawSearchPotentialSource(result *types.SearchResult) bool {
+	if result == nil {
+		return false
+	}
+	metadata := result.Metadata
+	return result.KnowledgeChannel == types.ConnectorTypeNextcloud ||
+		metadata["datasource_id"] != "" || metadata["nextcloud_instance_id"] != "" ||
+		metadata["nextcloud_binding_id"] != "" || metadata["nextcloud_file_id"] != ""
+}
+
+func rawSearchLeaseHTTPError(err error) error {
+	if stderrors.Is(err, repository.ErrNextcloudContentLeaseDenied) ||
+		stderrors.Is(err, repository.ErrNextcloudContentLeaseExpired) {
+		return errors.NewForbiddenError("Nextcloud content is no longer available")
+	}
+	return errors.NewServiceUnavailableError("Cannot verify current Nextcloud content lease")
+}
+
+// Resolve every requested search target to a trusted KB before retrieval.
+// An unresolvable direct document or tag scope cannot be searched without a
+// KB-wide lease, so the request fails closed instead of using a late lease.
+func (h *Handler) beginRawSearchRead(c *gin.Context, kbIDs, knowledgeIDs []string,
+	tagScopes []types.TagScope,
+) (*readlease.NextcloudReadGuard, error) {
+	// Hand-built legacy test handlers may omit the store for ordinary results.
+	// A source result still fails closed in protectRawSearchResults. Production
+	// always configures the durable store before registering this route.
+	if h.searchContentLeases == nil {
+		return nil, nil
+	}
+	if h.knowledgebaseService == nil || h.searchKnowledgeService == nil {
+		return nil, errors.NewServiceUnavailableError("Cannot resolve knowledge search lease scopes")
+	}
+	allKBIDs := make(map[string]bool)
+	for _, kbID := range kbIDs {
+		if kbID == "" {
+			return nil, errors.NewBadRequestError("Knowledge base ID cannot be empty")
+		}
+		allKBIDs[kbID] = true
+	}
+	for _, scope := range tagScopes {
+		if scope.KnowledgeBaseID == "" {
+			return nil, errors.NewBadRequestError("Tag scope requires a knowledge base")
+		}
+		allKBIDs[scope.KnowledgeBaseID] = true
+	}
+	for _, id := range knowledgeIDs {
+		if id == "" {
+			return nil, errors.NewBadRequestError("Knowledge ID cannot be empty")
+		}
+		row, err := h.searchKnowledgeService.GetKnowledgeByIDOnly(c.Request.Context(), id)
+		if err != nil || row == nil || row.ID != id || row.KnowledgeBaseID == "" {
+			return nil, errors.NewForbiddenError("Cannot resolve knowledge search target")
+		}
+		allKBIDs[row.KnowledgeBaseID] = true
+	}
+	if len(allKBIDs) == 0 {
+		return nil, errors.NewBadRequestError("Knowledge search requires a knowledge base")
+	}
+	scopes := make([]readlease.NextcloudKBReadScope, 0, len(allKBIDs))
+	for kbID := range allKBIDs {
+		kb, err := h.knowledgebaseService.GetKnowledgeBaseByIDOnly(c.Request.Context(), kbID)
+		if err != nil || kb == nil || kb.ID != kbID || kb.TenantID == 0 {
+			return nil, errors.NewForbiddenError("Cannot resolve knowledge search target")
+		}
+		if err := h.checkCurrentRawSearchKBAccess(c.Request.Context(), c,
+			&types.Knowledge{KnowledgeBaseID: kb.ID, TenantID: kb.TenantID}); err != nil {
+			return nil, err
+		}
+		scopes = append(scopes, readlease.NextcloudKBReadScope{TenantID: kb.TenantID, KBID: kb.ID})
+	}
+	guard, err := readlease.BeginNextcloudKBRead(c.Request.Context(), h.searchContentLeases, scopes)
+	if err != nil {
+		return nil, rawSearchLeaseHTTPError(err)
+	}
+	return guard, nil
+}
+
+// Re-resolve every result with a persisted document ID so a missing
+// channel/metadata field cannot turn a Nextcloud chunk into an unguarded row.
+// Upgrade the existing broad lease to exact generation leases before output.
+func (h *Handler) protectRawSearchResults(c *gin.Context,
+	guard *readlease.NextcloudReadGuard, results []*types.SearchResult,
+) error {
+	rows, err := h.checkCurrentRawSearchResults(c.Request.Context(), c, results)
+	if err != nil || len(rows) == 0 {
+		return err
+	}
+	if guard == nil {
+		return errors.NewServiceUnavailableError("Nextcloud content lease store unavailable")
+	}
+	for _, row := range rows {
+		if err := guard.PinKnowledge(row); err != nil {
+			return rawSearchLeaseHTTPError(err)
+		}
+	}
+	if err := guard.Verify(); err != nil {
+		return rawSearchLeaseHTTPError(err)
+	}
+	return nil
+}
+
+func (h *Handler) checkCurrentRawSearchResults(ctx context.Context, c *gin.Context,
+	results []*types.SearchResult,
+) ([]*types.Knowledge, error) {
+	rows := make([]*types.Knowledge, 0)
+	seen := make(map[string]*types.Knowledge)
+	for _, result := range results {
+		if result == nil {
+			return nil, errors.NewServiceUnavailableError("Cannot verify search result identity")
+		}
+		if result.KnowledgeID == "" {
+			return nil, errors.NewServiceUnavailableError("Cannot verify search result identity")
+		}
+		if h.searchKnowledgeService == nil {
+			return nil, errors.NewServiceUnavailableError("Cannot verify search result source")
+		}
+		row := seen[result.KnowledgeID]
+		if row == nil {
+			var err error
+			row, err = h.searchKnowledgeService.GetKnowledgeByIDOnly(ctx, result.KnowledgeID)
+			if err != nil || row == nil || row.ID != result.KnowledgeID {
+				return nil, errors.NewForbiddenError("Search result source is no longer available")
+			}
+			seen[result.KnowledgeID] = row
+		}
+		scope, source, err := readlease.NextcloudKnowledgeLeaseScope(row)
+		if err != nil {
+			return nil, errors.NewServiceUnavailableError("Cannot verify source result identity")
+		}
+		if !source && !rawSearchPotentialSource(result) {
+			continue
+		}
+		if result.KnowledgeBaseID != row.KnowledgeBaseID ||
+			result.KnowledgeChannel != row.Channel ||
+			!rawSearchMetadataMatchesSource(result.Metadata, row.GetMetadata()) {
+			return nil, errors.NewForbiddenError("Search result source changed")
+		}
+		checker, ok := h.searchKnowledgeService.(interface {
+			CheckKnowledgePublication(context.Context, *types.Knowledge) error
+		})
+		if !ok {
+			return nil, errors.NewServiceUnavailableError("Cannot verify current source publication")
+		}
+		if source {
+			if err := h.checkCurrentRawSearchKBAccess(ctx, c, row); err != nil {
+				return nil, err
+			}
+		}
+		if err := checker.CheckKnowledgePublication(ctx, row); err != nil {
+			if stderrors.Is(err, access.ErrNextcloudPublicationUnavailable) {
+				return nil, errors.NewServiceUnavailableError("Cannot verify current Nextcloud file access")
+			}
+			return nil, errors.NewForbiddenError("Current Nextcloud file access is required")
+		}
+		if source && scope.KnowledgeID != "" {
+			// Duplicate chunks share one generation lease; the guard itself
+			// deduplicates PinKnowledge for the same persisted source tuple.
+			rows = append(rows, row)
+		}
+	}
+	return rows, nil
+}
+
+// Reranking adds score diagnostics to the result, not to the persisted source.
+// Preserve every source key exactly, including any persisted score key. Only
+// the two finite numeric diagnostics produced by PluginRerank may be extra;
+// unknown additions and source-key changes still fail closed. Neither map is
+// changed, and nil/empty retain the previous exact-match distinction.
+func rawSearchMetadataMatchesSource(result, source map[string]string) bool {
+	if result == nil || source == nil {
+		return reflect.DeepEqual(result, source)
+	}
+	for key, value := range source {
+		actual, exists := result[key]
+		if !exists || actual != value {
+			return false
+		}
+	}
+	for key, value := range result {
+		if _, persisted := source[key]; persisted {
+			continue
+		}
+		if key != "base_score" && key != "model_score" {
+			return false
+		}
+		score, err := strconv.ParseFloat(value, 64)
+		if err != nil || math.IsNaN(score) || math.IsInf(score, 0) {
+			return false
+		}
+	}
+	return true
+}
+
+func (h *Handler) checkCurrentRawSearchKBAccess(ctx context.Context, c *gin.Context,
+	row *types.Knowledge,
+) error {
+	if h.knowledgebaseService == nil || row == nil {
+		return errors.NewServiceUnavailableError("Cannot verify current knowledge base access")
+	}
+	ids := []string(nil)
+	if row.ID != "" {
+		ids = []string{row.ID}
+	}
+	if err := types.AuthorizeTenantAPIKeyKnowledgeTargets(ctx,
+		[]string{row.KnowledgeBaseID}, ids); err != nil {
+		return err
+	}
+	kb, err := h.knowledgebaseService.GetKnowledgeBaseByIDOnly(ctx, row.KnowledgeBaseID)
+	if err != nil || kb == nil || kb.ID != row.KnowledgeBaseID || kb.TenantID != row.TenantID {
+		return errors.NewServiceUnavailableError("Cannot verify current knowledge base access")
+	}
+	grant, err := access.ResolveKB(ctx, middleware.KBAccessRequest(c), kb,
+		types.OrgRoleViewer, h.kbShareService, h.agentShareService)
+	if err != nil || grant == nil || grant.EffectiveTenantID != row.TenantID {
+		return errors.NewForbiddenError("Current knowledge base access is required")
+	}
+	if h.groupAccess != nil {
+		permission, groupErr := h.groupAccess.EffectivePermission(ctx, kb.TenantID,
+			types.GroupResourceTypeKnowledgeBase, kb.ID, types.ResourceActionRead, time.Now().UTC())
+		if groupErr != nil {
+			return errors.NewServiceUnavailableError("Cannot verify current directory group access")
+		}
+		if !permission.Allowed {
+			return errors.NewForbiddenError("Current directory group access is required")
+		}
+	}
+	return nil
+}
+
+// Gin may send headers before the JSON body. Verify at both boundaries so a
+// revoked result cannot be reported as a successful empty 200 or written
+// after it was rendered in memory.
+type rawSearchAuthorizationWriter struct {
+	gin.ResponseWriter
+	guard  *readlease.NextcloudReadGuard
+	check  func(context.Context) error
+	denied error
+}
+
+func (w *rawSearchAuthorizationWriter) beforeWrite() error {
+	// Once this response was denied it must not resume if a later check
+	// succeeds. Before the first denial every boundary still checks afresh.
+	if w.denied != nil {
+		return w.denied
+	}
+	if err := w.guard.Verify(); err != nil {
+		w.denied = rawSearchLeaseHTTPError(err)
+		return w.denied
+	}
+	w.denied = w.check(w.guard.Context())
+	return w.denied
+}
+
+func (w *rawSearchAuthorizationWriter) denyWrite(err error) {
+	if w.ResponseWriter.Written() {
+		return
+	}
+	status := http.StatusForbidden
+	if appErr, ok := errors.IsAppError(err); ok {
+		status = appErr.HTTPCode
+	}
+	w.ResponseWriter.Header().Del("Content-Type")
+	w.ResponseWriter.Header().Del("Content-Length")
+	w.ResponseWriter.WriteHeader(status)
+	w.ResponseWriter.WriteHeaderNow()
+}
+
+func (w *rawSearchAuthorizationWriter) WriteHeader(code int) {
+	if err := w.beforeWrite(); err != nil {
+		w.denyWrite(err)
+		return
+	}
+	w.ResponseWriter.WriteHeader(code)
+}
+
+func (w *rawSearchAuthorizationWriter) WriteHeaderNow() {
+	if err := w.beforeWrite(); err != nil {
+		w.denyWrite(err)
+		return
+	}
+	w.ResponseWriter.WriteHeaderNow()
+}
+
+func (w *rawSearchAuthorizationWriter) Write(p []byte) (int, error) {
+	if err := w.beforeWrite(); err != nil {
+		w.denyWrite(err)
+		return 0, err
+	}
+	return w.ResponseWriter.Write(p)
+}
+
+func (w *rawSearchAuthorizationWriter) WriteString(s string) (int, error) {
+	if err := w.beforeWrite(); err != nil {
+		w.denyWrite(err)
+		return 0, err
+	}
+	return w.ResponseWriter.WriteString(s)
+}
+
+func guardRawSearchResponseWrites(c *gin.Context, guard *readlease.NextcloudReadGuard,
+	check func(context.Context) error,
+) func() {
+	prior := c.Writer
+	c.Writer = &rawSearchAuthorizationWriter{ResponseWriter: prior, guard: guard, check: check}
+	return func() { c.Writer = prior }
+}
