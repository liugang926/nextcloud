+type knowledgeInputAdmission struct {
+	AdmissionID     string `gorm:"primaryKey"`
+	TenantID        uint64
+	KnowledgeBaseID string
+	KnowledgeID     string
+	BuildGeneration uint64
+	OriginKind      string
