+	actual, err := store.CaptureKnowledgeOutputInputs(ctx, types.KnowledgeBuildInputCaptureRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, ChunkIDs: []string{"manual-chunk"}})
+	require.NoError(t, err)
+	manifest, err := store.CaptureKnowledgeAutoTagInputs(ctx, actual.Proof)
+	require.NoError(t, err)
