--- /dev/null
+++ b/internal/application/access/nextcloud_publication_test.go
@@ -0,0 +1,218 @@
+package access
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/datasource/connector/nextcloud"
