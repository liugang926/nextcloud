+func bodyProtocolDatabaseRollback(t *testing.T, pg bool) {
+	db, s := bodyProtocolFixture(t, pg)
+	ctx := context.Background()
+	_, e := s.Inventory(ctx, 100)
+	require.NoError(t, e)
