+	baseline, e := store.CaptureTagOutputInputs(ctx, request)
+	require.NoError(t, e)
+	fired := false
+	name := "tag_output_rr_membership_change"
+	require.NoError(t, db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
