+		}
+		return &kb, nil
+	}}
+	h := NewNextcloudEventConnectionHandler(repository.NewNextcloudEventInboxRepository(db), NewDataSourceHandler(service, kbService))
+	h.inspect = func(context.Context, *types.DataSourceConfig) (nextcloud.PairingIdentity, error) {
+		return nextcloud.PairingIdentity{InstanceID: testEventInstance, BindingID: testEventBinding, BaseURL: "https://nextcloud.example.test", PublicationState: "active", PublicationEpoch: 1}, nil
+	}
+	router.Use(func(c *gin.Context) {
+		if tenantID, ok := c.Request.Context().Value(types.TenantIDContextKey).(uint64); ok {
+			c.Set(types.TenantIDContextKey.String(), tenantID)
