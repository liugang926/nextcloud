+		mac.Write([]byte(raw))
+		envelope, _ := json.Marshal(map[string]string{"plan": raw, "hmac_sha256": hex.EncodeToString(mac.Sum(nil))})
+		_, e := VerifyNextcloudRecoveryPlan(envelope, key)
