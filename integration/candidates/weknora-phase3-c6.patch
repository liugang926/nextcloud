+					require.NoError(t, db.Model(&types.Knowledge{}).Where("id='document'").Update("metadata", k.Metadata).Error)
+				case "membership":
+					require.NoError(t, db.Create(&types.KnowledgeProcessingSpan{KnowledgeID: k.ID, Attempt: 1, SpanID: "late-unknown", Name: "SECRET new unknown input", Kind: types.SpanKindSubSpan, Status: types.SpanStatusDone}).Error)
+				}
+			}
+			w := serveSpanHTTP(h, a, "/knowledge/document/spans")
+			require.Equal(t, 403, w.Code, w.Body.String())
+			require.NotContains(t, w.Body.String(), "original Start input")
+			require.NotContains(t, w.Body.String(), "actual original model error")
+			require.NotContains(t, w.Body.String(), "SECRET")
+		})
+	}
+}
