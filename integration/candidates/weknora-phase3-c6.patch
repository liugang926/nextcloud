@@ -0,0 +1,60 @@
+package chatpipeline
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+func (p *PluginExtractEntity) onLineageExtractEntity(ctx context.Context, manage *types.ChatManage, next func() *PluginError) *PluginError {
+	turn := types.RAGSourceLineageFromContext(ctx)
+	fail := func(err error) *PluginError {
+		if turn != nil {
+			_ = turn.Add(types.UnknownSourceLineage())
+		}
+		return ErrModelCall.WithError(err)
+	}
+	if turn == nil {
+		return fail(types.ErrSourceLineageUnknown)
+	}
+	templateLineage, err := types.GraphPromptTemplateLineage(p.template)
+	if err != nil {
+		return fail(err)
+	}
+	// No raw ExtractConfig examples/names are read on the query path. The graph
+	// writer receipts account its extraction config. Server-resolved target
+	// selectors control this read and are reauthorized by the graph reader.
+	if err := turn.Add(templateLineage); err != nil {
+		return fail(err)
+	}
+	input, err := turn.CheckedSnapshot(ctx)
+	if err != nil {
+		return fail(err)
+	}
+	model, err := p.modelService.GetChatModel(ctx, manage.ChatModelID)
+	if err != nil {
+		return fail(err)
+	}
+	extractor := NewExtractor(model, p.template)
+	graph, err := extractor.ExtractSourceLineage(ctx, manage.Query, input, templateLineage, func(ctx context.Context, lineage *types.SourceLineage) error {
+		if err := turn.Add(lineage); err != nil {
+			return err
+		}
+		return turn.Check(ctx)
+	})
+	if err != nil {
+		return fail(err)
+	}
+	if err := turn.Add(graph.SourceLineage); err != nil {
+		return fail(err)
+	}
+	if err := turn.Check(ctx); err != nil {
+		return fail(err)
+	}
+	manage.Entity = []string{}
+	for _, node := range graph.Node {
+		manage.Entity = append(manage.Entity, node.Name)
+	}
+	manage.EntityKBIDs = manage.SearchTargets.GetAllKnowledgeBaseIDs()
+	manage.EntityKnowledge = map[string]string{}
+	return next()
+}
diff --git a/internal/application/service/chat_pipeline/extract_source_lineage.go b/internal/application/service/chat_pipeline/extract_source_lineage.go
new file mode 100644
index 0000000000000000000000000000000000000000..e4464451050d0fba0a6de75456477aa54421bb67
--- /dev/null
+++ b/internal/application/service/chat_pipeline/extract_source_lineage.go
@@ -0,0 +1,86 @@
+package chatpipeline
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/Tencent/WeKnora/internal/models/chat"
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// ExtractSourceLineage detaches the exact rendered messages and options before
+// current authorization. Both successful and citation-free model responses
+// inherit the full body/config/control input union. No model-supplied receipt
+// or claim of independence is accepted.
+func (e *Extractor) ExtractSourceLineage(ctx context.Context, content string, contentLineage, templateLineage *types.SourceLineage, check func(context.Context, *types.SourceLineage) error) (*types.GraphData, error) {
+	lineage, err := types.UnionSourceLineage(contentLineage, templateLineage)
+	if err != nil || lineage.RequireComplete() != nil || check == nil {
+		return nil, types.ErrGraphSourceReceiptUnknown
+	}
+	generator := NewQAPromptGenerator(e.formater, e.template)
+	messages := generator.Render(ctx, content)
+	for i := range messages {
+		messages[i].SourceLineage, err = types.UnionSourceLineage(lineage)
+		if err != nil {
+			return nil, err
+		}
+	}
+	// Rendered extraction messages contain only controlled strings. JSON copies
+	// the options' nested buffers/pointers before an authorization callback runs.
+	encoded, err := json.Marshal(e.chatOpt)
+	if err != nil {
+		return nil, err
+	}
+	var options chat.ChatOptions
+	if err := json.Unmarshal(encoded, &options); err != nil {
+		return nil, err
+	}
+	wireDigest := types.GraphDigest(struct {
+		Messages []chat.Message
+		Options  chat.ChatOptions
+		ModelID  string
+	}{messages, options, e.chat.GetModelID()})
+	if wireDigest == "" {
+		return nil, types.ErrGraphSourceReceiptUnknown
+	}
+	detached, err := types.UnionSourceLineage(lineage)
+	if err != nil {
+		return nil, err
+	}
+	if err := check(ctx, detached); err != nil {
+		return nil, err
+	}
+	// The callback receives a copy; it cannot reduce the real inherited union.
+	response, err := e.chat.Chat(types.WithLLMCallMetadata(ctx, "entity_extraction", ""), messages, &options)
+	if err != nil {
+		return nil, err
+	}
+	if response == nil {
+		return nil, types.ErrGraphSourceReceiptUnknown
+	}
+	detached, err = types.UnionSourceLineage(lineage)
+	if err != nil {
+		return nil, err
+	}
+	if err := check(ctx, detached); err != nil {
+		return nil, err
+	}
+	graph, err := e.formater.ParseGraph(ctx, response.Content)
+	if err != nil {
+		return nil, err
+	}
+	graph.SourceLineage, err = types.UnionSourceLineage(lineage)
+	if err != nil {
+		return nil, err
+	}
+	graph.WireDigest = wireDigest
+	// Parsing/control transforms and their diagnostics remain source-derived.
+	detached, err = types.UnionSourceLineage(lineage)
+	if err != nil {
+		return nil, err
+	}
+	if err := check(ctx, detached); err != nil {
+		return nil, err
+	}
+	return graph, nil
+}
