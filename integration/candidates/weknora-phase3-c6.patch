+		scope.kbID, scope.knowledgeID, scope.sourceIDs).Pluck("id", &ids).Error; err != nil {
+		return err
+	}
+	now := time.Now().UTC()
+	for _, id := range ids {
+		if err := tx.Exec(`INSERT INTO nextcloud_gc_items
+			(job_id, kind, object_ref, state, created_at, updated_at)
+			VALUES (?, 'postgres_embedding', ?, 'pending', ?, ?)
