+func (s *KnowledgeInputProvenanceStore) CaptureKnowledgeEnrichmentTemplateInputs(ctx context.Context, tenant uint64, kbID, purpose string, parents []*types.ChunkOutputInputSnapshot) (*KnowledgeEnrichmentTemplateInputSnapshot, error) {
+	if len(parents) == 0 || len(parents) > 32 || (purpose != "summary" && purpose != "question") {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	kb, configLineage, err := s.ReadKnowledgeTemplateConfiguration(ctx, tenant, kbID)
+	if err != nil {
+		return nil, err
+	}
+	ctx, err = s.authorizeKnowledgeTemplateWrite(ctx, kb)
+	if err != nil {
+		return nil, err
+	}
+	actor, err := captureKnowledgeActorSelector(ctx, "")
+	if err != nil {
+		return nil, err
+	}
+	lineage, err := types.UnionSourceLineage(configLineage)
+	if err != nil {
+		return nil, err
+	}
+	actual := []templateParentInput{}
+	for _, parent := range parents {
+		if err := s.RecheckChunkOutputInputs(ctx, parent); err != nil {
+			return nil, err
+		}
+		if err := s.RecheckKnowledgeBuildInputs(ctx, parent.Proof); err != nil {
+			return nil, err
+		}
+		lineage, err = types.UnionSourceLineage(lineage, parent.Proof.SourceLineage)
+		if err != nil {
+			return nil, err
+		}
+		actual = append(actual, templateParentInput{parent.Knowledge, parent.Chunks, parent.Proof, parent.AllChunks})
+	}
+	var model types.Model
+	if err := s.db.WithContext(ctx).Where("id = ? AND (tenant_id = ? OR is_builtin = ?)", kb.SummaryModelID, tenant, true).Take(&model).Error; err != nil {
+		return nil, err
+	}
+	modelDigest, err := KnowledgeInputDigest(&model)
+	if err != nil {
+		return nil, err
+	}
+	modelRevision, err := knowledgeEnrichmentRevision(s.db, "model", model.ID)
+	if err != nil {
+		return nil, err
+	}
+	configDigest, err := knowledgeConfigurationOriginDigest(kb)
+	if err != nil {
+		return nil, err
+	}
+	configRevision, err := knowledgeConfigurationControlRevision(s.db, kbID)
+	if err != nil {
+		return nil, err
+	}
+	var tenantRow types.Tenant
+	if err := s.db.WithContext(ctx).Where("id = ?", tenant).Take(&tenantRow).Error; err != nil {
+		return nil, err
+	}
+	tenantDigest, err := knowledgeProducerTenantDigest(&tenantRow)
+	if err != nil {
+		return nil, err
+	}
+	tenantRevision, err := knowledgeEnrichmentRevision(s.db, "tenant", fmt.Sprint(tenant))
+	if err != nil {
+		return nil, err
+	}
+	parentJSON, err := json.Marshal(actual)
+	if err != nil {
+		return nil, err
+	}
+	actorJSON, err := json.Marshal(actor)
+	if err != nil {
+		return nil, err
+	}
+	lineageJSON, err := json.Marshal(lineage)
+	if err != nil {
+		return nil, err
+	}
+	inputDigest, err := KnowledgeInputDigest(actual)
+	if err != nil {
+		return nil, err
+	}
+	row := knowledgeTemplateInput{ID: uuid.NewString(), TenantID: tenant, KnowledgeBaseID: kbID, Purpose: purpose, ModelID: model.ID, ModelDigest: modelDigest, ModelRevision: modelRevision, ConfigDigest: configDigest, ConfigRevision: configRevision, TenantDigest: tenantDigest, TenantRevision: tenantRevision, ActorSelector: string(actorJSON), Parents: string(parentJSON), SourceLineage: string(lineageJSON), InputDigest: inputDigest}
+	if err := s.db.WithContext(ctx).Create(&row).Error; err != nil {
+		return nil, err
+	}
+	return &KnowledgeEnrichmentTemplateInputSnapshot{row.ID, row.ModelID, purpose, &tenantRow, parents, lineage}, nil
+}
+func (s *KnowledgeInputProvenanceStore) recheckTemplateInputInTx(ctx context.Context, tx *gorm.DB, id string) (*knowledgeTemplateInput, error) {
+	var row knowledgeTemplateInput
+	if err := tx.Where("id = ?", id).Take(&row).Error; err != nil {
+		return nil, err
+	}
+	var actor knowledgeBuildActorSelector
+	if json.Unmarshal([]byte(row.ActorSelector), &actor) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	authority := s.templateAuthority(tx)
+	if authority == nil {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	fresh, err := authority.restoreCurrentKnowledgeActor(ctx, actor, row.TenantID)
+	if err != nil {
+		return nil, err
+	}
+	a, _ := types.PrincipalFromContext(ctx)
+	b, _ := types.PrincipalFromContext(fresh)
+	if a != b || types.CallerFromContext(ctx) != types.CallerFromContext(fresh) {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var kb types.KnowledgeBase
+	if err := tx.Where("id = ? AND tenant_id = ?", row.KnowledgeBaseID, row.TenantID).Take(&kb).Error; err != nil {
+		return nil, err
+	}
+	if _, err := authority.authorizeKnowledgeTemplateWrite(fresh, &kb); err != nil {
+		return nil, err
+	}
+	digest, err := knowledgeConfigurationOriginDigest(&kb)
+	if err != nil {
+		return nil, err
+	}
+	rev, err := knowledgeConfigurationControlRevision(tx, kb.ID)
+	if err != nil {
+		return nil, err
+	}
+	if digest != row.ConfigDigest || rev != row.ConfigRevision {
+		return nil, ErrKnowledgeInputChanged
+	}
+	if _, err := readKnowledgeConfigurationOrigin(tx, &kb); err != nil {
+		return nil, err
+	}
+	var model types.Model
+	if err := tx.Where("id = ? AND (tenant_id = ? OR is_builtin = ?)", row.ModelID, row.TenantID, true).Take(&model).Error; err != nil {
+		return nil, err
+	}
+	digest, err = KnowledgeInputDigest(&model)
+	if err != nil {
+		return nil, err
+	}
+	rev, err = knowledgeEnrichmentRevision(tx, "model", model.ID)
+	if err != nil {
+		return nil, err
+	}
+	if digest != row.ModelDigest || rev != row.ModelRevision {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var tenant types.Tenant
+	if err := tx.Where("id = ?", row.TenantID).Take(&tenant).Error; err != nil {
+		return nil, err
+	}
+	digest, err = knowledgeProducerTenantDigest(&tenant)
+	if err != nil {
+		return nil, err
+	}
+	rev, err = knowledgeEnrichmentRevision(tx, "tenant", fmt.Sprint(tenant.ID))
+	if err != nil {
+		return nil, err
+	}
+	if digest != row.TenantDigest || rev != row.TenantRevision {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var parents []templateParentInput
+	if json.Unmarshal([]byte(row.Parents), &parents) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	for _, parent := range parents {
+		p := parent.Proof
+		if p == nil || parent.Knowledge == nil {
+			return nil, ErrKnowledgeInputChanged
+		}
+		_, err := s.captureKnowledgeBuildSnapshotInTx(tx, types.KnowledgeBuildInputCaptureRequest{TenantID: p.TenantID, KnowledgeBaseID: p.KnowledgeBaseID, KnowledgeID: p.KnowledgeID, ChunkIDs: p.ChunkIDs, Expected: p}, true)
+		if err != nil {
+			return nil, err
+		}
+		if parent.AllChunks {
+			var ids []string
+			if err := tx.Model(&types.Chunk{}).Where("tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ?", p.TenantID, p.KnowledgeBaseID, p.KnowledgeID).Order("id ASC").Pluck("id", &ids).Error; err != nil {
+				return nil, err
+			}
+			if !reflect.DeepEqual(ids, p.ChunkIDs) {
+				return nil, ErrKnowledgeInputChanged
+			}
+		}
+	}
+	return &row, ctx.Err()
+}
+func (s *KnowledgeInputProvenanceStore) RecheckKnowledgeEnrichmentTemplateInputs(ctx context.Context, id string) error {
+	var row knowledgeTemplateInput
+	if err := s.db.WithContext(ctx).Where("id = ?", id).Take(&row).Error; err != nil {
+		return err
+	}
+	var parents []templateParentInput
+	if json.Unmarshal([]byte(row.Parents), &parents) != nil {
+		return ErrKnowledgeInputChanged
+	}
+	for _, p := range parents {
+		if err := s.RecheckChunkOutputInputs(ctx, &types.ChunkOutputInputSnapshot{Knowledge: p.Knowledge, Chunks: p.Chunks, Proof: p.Proof, AllChunks: p.AllChunks}); err != nil {
+			return err
+		}
+		if err := s.RecheckKnowledgeBuildInputs(ctx, p.Proof); err != nil {
+			return err
+		}
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error { _, err := s.recheckTemplateInputInTx(ctx, tx, id); return err }, knowledgeDisplayWriteOptions(s.db))
+}
+func (s *KnowledgeInputProvenanceStore) CaptureKnowledgeTemplateModelResult(ctx context.Context, id, content string) (*KnowledgeEnrichmentTemplateModelResult, error) {
+	if err := s.RecheckKnowledgeEnrichmentTemplateInputs(ctx, id); err != nil {
+		return nil, err
+	}
+	var input knowledgeTemplateInput
+	if err := s.db.WithContext(ctx).Where("id = ?", id).Take(&input).Error; err != nil {
+		return nil, err
+	}
+	if err := validKnowledgeTemplate(input.Purpose, content); err != nil {
+		return nil, err
+	}
+	digest, err := KnowledgeInputDigest(content)
+	if err != nil {
+		return nil, err
+	}
+	result := knowledgeTemplateResult{uuid.NewString(), id, digest}
+	if err := s.db.WithContext(ctx).Create(&result).Error; err != nil {
+		return nil, err
+	}
+	return &KnowledgeEnrichmentTemplateModelResult{id, result.ID, content}, nil
+}
+func (s *KnowledgeInputProvenanceStore) CommitDerivedKnowledgeEnrichmentTemplate(ctx context.Context, result *KnowledgeEnrichmentTemplateModelResult) (*types.KnowledgeBase, error) {
+	if result == nil {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	if err := s.RecheckKnowledgeEnrichmentTemplateInputs(ctx, result.inputID); err != nil {
+		return nil, err
+	}
+	var kbResult *types.KnowledgeBase
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, err := s.recheckTemplateInputInTx(ctx, tx, result.inputID)
+		if err != nil {
+			return err
+		}
+		var output knowledgeTemplateResult
+		if err := tx.Where("id = ? AND input_id = ?", result.resultID, result.inputID).Take(&output).Error; err != nil {
+			return err
+		}
+		digest, err := KnowledgeInputDigest(result.content)
+		if err != nil {
+			return err
+		}
+		if digest != output.OutputDigest {
+			return ErrKnowledgeInputChanged
+		}
+		var kb types.KnowledgeBase
+		if err := tx.Where("id = ? AND tenant_id = ?", row.KnowledgeBaseID, row.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		previous, err := readKnowledgeConfigurationOrigin(tx, &kb)
+		if err != nil {
+			return err
+		}
+		var inputs types.SourceLineage
+		if json.Unmarshal([]byte(row.SourceLineage), &inputs) != nil {
+			return ErrKnowledgeInputChanged
+		}
+		lineage, err := types.UnionSourceLineage(previous, &inputs)
+		if err != nil {
+			return err
+		}
+		if kb.EnrichmentTemplates == nil {
+			kb.EnrichmentTemplates = &types.KnowledgeEnrichmentTemplates{}
+		}
+		if err := kb.EnrichmentTemplates.Set(row.Purpose, result.content); err != nil {
+			return err
+		}
+		if err := tx.Model(&types.KnowledgeBase{}).Where("id = ? AND tenant_id = ?", kb.ID, kb.TenantID).Update("enrichment_templates", kb.EnrichmentTemplates).Error; err != nil {
+			return err
+		}
+		if err := tx.Where("id = ?", kb.ID).Take(&kb).Error; err != nil {
+			return err
+		}
+		if err := admitKnowledgeConfigurationOrigin(tx, &kb, knowledgeInputOrigin{lineage, "derived"}); err != nil {
+			return err
+		}
+		kbResult = &kb
+		return nil
+	}, knowledgeDisplayWriteOptions(s.db))
+	return kbResult, err
+}
+
+func (s *KnowledgeInputProvenanceStore) AuthorizeKnowledgeTemplateConfigurationEdit(ctx context.Context, kb *types.KnowledgeBase) (context.Context, error) {
+	return s.authorizeKnowledgeTemplateWrite(ctx, kb)
+}
+func (s *KnowledgeInputProvenanceStore) ReadKnowledgeEnrichmentTemplateInputs(ctx context.Context, id string) (*KnowledgeEnrichmentTemplateInputSnapshot, error) {
+	if err := s.RecheckKnowledgeEnrichmentTemplateInputs(ctx, id); err != nil {
+		return nil, err
+	}
+	var row knowledgeTemplateInput
+	if err := s.db.WithContext(ctx).Where("id = ?", id).Take(&row).Error; err != nil {
+		return nil, err
+	}
+	var saved []templateParentInput
+	if json.Unmarshal([]byte(row.Parents), &saved) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	parents := []*types.ChunkOutputInputSnapshot{}
+	for _, p := range saved {
+		parents = append(parents, &types.ChunkOutputInputSnapshot{Knowledge: p.Knowledge, Chunks: p.Chunks, Proof: p.Proof, AllChunks: p.AllChunks})
+	}
+	var lineage types.SourceLineage
+	if json.Unmarshal([]byte(row.SourceLineage), &lineage) != nil {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var tenant types.Tenant
+	if err := s.db.WithContext(ctx).Where("id = ?", row.TenantID).Take(&tenant).Error; err != nil {
+		return nil, err
+	}
+	return &KnowledgeEnrichmentTemplateInputSnapshot{row.ID, row.ModelID, row.Purpose, &tenant, parents, &lineage}, nil
+}
+
+func (s *KnowledgeInputProvenanceStore) KnowledgeTemplateConfigurationStamp(ctx context.Context, tenant uint64, id string) (uint64, string, error) {
+	var kb types.KnowledgeBase
+	if err := s.db.WithContext(ctx).Where("id = ? AND tenant_id = ?", id, tenant).Take(&kb).Error; err != nil {
+		return 0, "", err
+	}
+	revision, err := knowledgeConfigurationControlRevision(s.db.WithContext(ctx), id)
+	if err != nil {
+		return 0, "", err
+	}
+	digest, err := knowledgeConfigurationOriginDigest(&kb)
+	return revision, digest, err
+}
diff --git a/internal/application/repository/knowledge_history_input.go b/internal/application/repository/knowledge_history_input.go
new file mode 100644
index 0000000000000000000000000000000000000000..ff2d2233ca7e7db09b88eb7bd635e9276208b214
--- /dev/null
+++ b/internal/application/repository/knowledge_history_input.go
@@ -0,0 +1,191 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type knowledgeInputHistoryParents struct {
+	AdmissionID        string `gorm:"primaryKey"`
+	TenantID           uint64
+	SessionID          string
+	AssistantMessageID string
+	UserMessageID      string
+	RequestID          string
+	AssistantRevision  uint64
+	UserRevision       uint64
+	AssistantDigest    string
+	UserDigest         string
+}
+
+func (knowledgeInputHistoryParents) TableName() string { return "knowledge_input_history_parents" }
+
+func ConfigureKnowledgeInputHistoryVerifier(store *KnowledgeInputProvenanceStore, verifier interfaces.MessageSourceLineageVerifier) {
+	store.messageVerifier = verifier
+}
+func historyMessageInputDigest(message *types.Message) (string, error) {
+	return KnowledgeInputDigest(struct {
+		ID, Session, Request, Role, Content, Agent, Model string
+		AgentTenant                                       uint64
+		Complete                                          bool
+		Lineage                                           *types.SourceLineage
+		Execution                                         types.MessageExecutionContext
+	}{message.ID, message.SessionID, message.RequestID, message.Role, message.Content, message.AgentID, message.ModelID, message.AgentTenantID, message.IsCompleted, message.SourceLineage, message.ExecutionContext})
+}
+func historyMessageInputRevision(tx *gorm.DB, id string) (uint64, error) {
+	var row struct{ Revision uint64 }
+	if err := tx.Table("knowledge_input_message_versions").Where("message_id = ?", id).Take(&row).Error; err != nil {
+		return 0, err
+	}
+	if row.Revision == 0 {
+		return 0, ErrKnowledgeInputChanged
+	}
+	return row.Revision, nil
+}
+
+func (s *KnowledgeInputProvenanceStore) verifyCommittedHistoryParents(tx *gorm.DB, k *types.Knowledge, a *knowledgeInputAdmission) error {
+	batch, ok := s.messageVerifier.(interfaces.MessageSourceLineageBatchVerifier)
+	if !ok {
+		return types.ErrSourceLineageUnknown
+	}
+	var parent knowledgeInputHistoryParents
+	if err := tx.Where("admission_id = ? AND tenant_id = ?", a.AdmissionID, k.TenantID).Take(&parent).Error; err != nil {
+		return err
+	}
+	var session types.Session
+	if err := tx.Where("id = ? AND tenant_id = ?", parent.SessionID, parent.TenantID).Take(&session).Error; err != nil {
+		return err
+	}
+	messages := make([]*types.Message, 0, 2)
+	for _, item := range []struct {
+		ID, Role, Digest string
+		Revision         uint64
+	}{{parent.AssistantMessageID, "assistant", parent.AssistantDigest, parent.AssistantRevision}, {parent.UserMessageID, "user", parent.UserDigest, parent.UserRevision}} {
+		var message types.Message
+		if err := tx.Where("id = ? AND session_id = ? AND request_id = ? AND role = ?", item.ID, parent.SessionID, parent.RequestID, item.Role).Take(&message).Error; err != nil {
+			return err
+		}
+		if !message.IsCompleted || message.SourceLineage.RequireComplete() != nil || (item.Role == "assistant" && message.KnowledgeID != k.ID) {
+			return ErrKnowledgeInputChanged
+		}
+		digest, err := historyMessageInputDigest(&message)
+		if err != nil {
+			return err
+		}
+		revision, err := historyMessageInputRevision(tx, message.ID)
+		if err != nil {
+			return err
+		}
+		if digest != item.Digest || revision != item.Revision {
+			return ErrKnowledgeInputChanged
+		}
+		messages = append(messages, &message)
+	}
+	return batch.CheckMessagePublications(tx.Statement.Context, messages)
+}
+
+var historyInputThinkBlocks = regexp.MustCompile(`(?s)<think>.*?</think>`)
+
+// CreateCommittedHistoryKnowledgeInput reads the complete assistant and its
+// unique original paired user, binds their exact envelopes/revisions, creates
+// the child and links the message in one transaction. No caller text is used.
+func (s *KnowledgeInputProvenanceStore) CreateCommittedHistoryKnowledgeInput(ctx context.Context, request types.CommittedHistoryKnowledgeInputRequest) (*types.CommittedHistoryKnowledgeInput, error) {
+	batch, ok := s.messageVerifier.(interfaces.MessageSourceLineageBatchVerifier)
+	if !ok || request.TenantID == 0 || request.KnowledgeBaseID == "" || request.SessionID == "" || request.AssistantMessageID == "" {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	options := &sql.TxOptions{}
+	if s.db.Dialector.Name() == "postgres" {
+		options.Isolation = sql.LevelRepeatableRead
+	}
+	var result *types.CommittedHistoryKnowledgeInput
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var session types.Session
+		if err := tx.Where("id = ? AND tenant_id = ?", request.SessionID, request.TenantID).Take(&session).Error; err != nil {
+			return err
+		}
+		var assistant types.Message
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id = ? AND session_id = ? AND role = 'assistant'", request.AssistantMessageID, request.SessionID).Take(&assistant).Error; err != nil {
+			return err
+		}
+		if !assistant.IsCompleted || assistant.RequestID == "" || assistant.KnowledgeID != "" || assistant.SourceLineage.RequireComplete() != nil {
+			return nilHistoryInputError()
+		}
+		var users []*types.Message
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("session_id = ? AND request_id = ? AND role = 'user'", request.SessionID, assistant.RequestID).Limit(2).Find(&users).Error; err != nil {
+			return err
+		}
+		if len(users) != 1 || !users[0].IsCompleted || users[0].SourceLineage.RequireComplete() != nil {
+			return nilHistoryInputError()
+		}
+		user := users[0]
+		if err := batch.CheckMessagePublications(ctx, []*types.Message{&assistant, user}); err != nil {
+			return err
+		}
+		lineage, err := types.UnionSourceLineage(assistant.SourceLineage, user.SourceLineage)
+		if err != nil {
+			return err
+		}
+		var kb types.KnowledgeBase
+		if err := tx.Where("id = ? AND tenant_id = ?", request.KnowledgeBaseID, request.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		answer := strings.TrimSpace(historyInputThinkBlocks.ReplaceAllString(assistant.Content, ""))
+		passages := []string{fmt.Sprintf("[Session: %s]\nQ: %s\nA: %s", session.ID, user.Content, answer)}
+		knowledge := &types.Knowledge{ID: uuid.NewString(), TenantID: request.TenantID, KnowledgeBaseID: kb.ID, Type: "passage", Channel: "internal_history", ParseStatus: types.ParseStatusPending, EnableStatus: "disabled", EmbeddingModelID: kb.EmbeddingModelID, CustomMetadata: types.JSON(`{}`)}
+		if err := tx.Create(knowledge).Error; err != nil {
+			return err
+		}
+		proof, err := s.admitInTx(ctx, tx, knowledge, &kb, passages, knowledgeInputOrigin{lineage, "history"})
+		if err != nil {
+			return err
+		}
+		link := tx.Model(&types.Message{}).Where("id = ? AND session_id = ? AND knowledge_id = ?", assistant.ID, session.ID, assistant.KnowledgeID).Update("knowledge_id", knowledge.ID)
+		if link.Error != nil {
+			return link.Error
+		}
+		if link.RowsAffected != 1 {
+			return ErrKnowledgeInputChanged
+		}
+		assistant.KnowledgeID = knowledge.ID
+		assistantDigest, err := historyMessageInputDigest(&assistant)
+		if err != nil {
+			return err
+		}
+		userDigest, err := historyMessageInputDigest(user)
+		if err != nil {
+			return err
+		}
+		assistantVersion, err := historyMessageInputRevision(tx, assistant.ID)
+		if err != nil {
+			return err
+		}
+		userVersion, err := historyMessageInputRevision(tx, user.ID)
+		if err != nil {
+			return err
+		}
+		parent := knowledgeInputHistoryParents{proof.AdmissionID, request.TenantID, session.ID, assistant.ID, user.ID, assistant.RequestID, assistantVersion, userVersion, assistantDigest, userDigest}
+		if err := tx.Create(&parent).Error; err != nil {
+			return err
+		}
+		if err := s.verifyCommittedHistoryParents(tx, knowledge, &knowledgeInputAdmission{AdmissionID: proof.AdmissionID}); err != nil {
+			return err
+		}
+		result = &types.CommittedHistoryKnowledgeInput{Knowledge: knowledge, Passages: passages, Proof: proof, Assistant: &assistant, User: user}
+		return nil
+	}, options)
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+func nilHistoryInputError() error { return ErrKnowledgeInputChanged }
