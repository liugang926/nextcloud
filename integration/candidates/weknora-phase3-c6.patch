+func autoSpanFixture(t *testing.T, pg, derived bool) (*KnowledgeInputProvenanceStore, *gorm.DB, context.Context, *types.Knowledge, interfaces.KnowledgeRepository, *types.KnowledgeAutoTagInputSnapshot, *types.KnowledgeProcessingSpan, KnowledgeSpanRepository) {
+	t.Helper()
+	store, db, ctx, tags, knowledge, k := displayTestFixture(t, pg)
+	_ = displayTag(t, tags, ctx, "span-match")
+	if derived {
+		sourceID := "candidate"
+		if pg {
+			sourceID = "doc-a"
+		}
+		_, source, err := knowledge.(*knowledgeRepository).ResolveNextcloudSourceLineage(ctx, 7, "kb", sourceID)
+		require.NoError(t, err)
+		lineage, err := types.NewCompleteSourceLineage(source)
+		require.NoError(t, err)
+		origin, err := WithDerivedKnowledgeInput(ctx, lineage)
+		require.NoError(t, err)
+		input := &types.Knowledge{ID: "span-candidate-origin", TenantID: 7, KnowledgeBaseID: "kb", Type: types.KnowledgeTypeManual, Channel: "web", CustomMetadata: types.JSON(`{}`), ParseStatus: types.ParseStatusCompleted, EnableStatus: "enabled"}
+		proof, err := store.CreateKnowledgeWithInput(origin, input, "actual unselected candidate origin")
+		require.NoError(t, err)
+		producer, err := WithDerivedKnowledgeDisplayInput(ctx, proof)
+		require.NoError(t, err)
+		require.NoError(t, tags.Create(producer, &types.KnowledgeTag{ID: "span-nonmatch", TenantID: 7, KnowledgeBaseID: "kb", Name: "unselected sourced candidate", SortOrder: 8}))
+	} else {
+		_ = displayTag(t, tags, ctx, "span-nonmatch")
+	}
+	actual, err := store.CaptureKnowledgeOutputInputs(ctx, types.KnowledgeBuildInputCaptureRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, ChunkIDs: []string{"manual-chunk"}})
+	require.NoError(t, err)
+	manifest, err := store.CaptureKnowledgeAutoTagInputs(ctx, actual.Proof)
+	require.NoError(t, err)
+	installSpanInputs(t, db)
+	repo := NewKnowledgeSpanRepository(db)
+	ctx = WithKnowledgeBuildInputProof(ctx, store, actual.Proof)
+	root := startOriginalSpan(t, repo, ctx, k.ID, 1, "root", "", types.SpanKindRoot)
+	ctx, err = WithSpanAutoTagOriginalInput(ctx, store, manifest)
+	require.NoError(t, err)
+	now := time.Now()
+	row := &types.KnowledgeProcessingSpan{KnowledgeID: k.ID, Attempt: 1, SpanID: "auto-classifier", ParentSpanID: root.SpanID, Name: autoTagProducerSpanName, Kind: types.SpanKindSubSpan, Status: types.SpanStatusRunning, StartedAt: &now, Input: types.JSONMap{"candidate_count": len(manifest.Tags)}}
+	require.NoError(t, repo.Upsert(ctx, row))
+	require.NotEmpty(t, row.WriteToken)
