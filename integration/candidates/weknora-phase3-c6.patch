+// Tag resolution is part of the exact FAQ operation. New names/defaults are
+// written with their actual operation's union, and only that own addition may
+// advance the original candidate manifest.
+func (s *KnowledgeInputProvenanceStore) ResolveFAQInputTag(ctx context.Context, entry *types.FAQEntryPayload) (string, error) {
+	if err := s.CheckFAQInput(ctx); err != nil {
+		return "", err
+	}
+	var tagID string
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		session, snapshot, err := s.faqSessionInTx(ctx, tx)
+		if err != nil {
+			return err
+		}
+		var operation types.FAQInputOperation
+		if err := json.Unmarshal([]byte(session.InputBody), &operation); err != nil {
+			return err
+		}
+		allowed := false
+		matches := func(candidate *types.FAQEntryPayload) {
+			if candidate != nil && candidate.TagID == entry.TagID && candidate.TagName == entry.TagName {
+				allowed = true
+			}
+		}
+		matches(operation.Entry)
+		if operation.Batch != nil {
+			for i := range operation.Batch.Entries {
+				matches(&operation.Batch.Entries[i])
+			}
+		}
+		if !allowed {
+			return ErrKnowledgeInputChanged
+		}
+		if entry.TagID != 0 {
+			for _, tag := range snapshot.Tags {
+				if tag.SeqID == entry.TagID {
+					tagID = tag.ID
+					return nil
+				}
+			}
+			return ErrKnowledgeInputChanged
+		}
+		name := strings.TrimSpace(entry.TagName)
+		if name == "" {
+			name = types.UntaggedTagName
+		}
+		for _, tag := range snapshot.Tags {
+			if tag.Name == name {
+				tagID = tag.ID
+				return nil
+			}
+		}
+		now := time.Now()
+		tag := &types.KnowledgeTag{ID: uuid.NewString(), TenantID: session.TenantID, KnowledgeBaseID: session.KnowledgeBaseID, Name: name, CreatedAt: now, UpdatedAt: now}
+		if name == types.UntaggedTagName {
+			tag.SortOrder = -1
+		}
+		if err := tx.Create(tag).Error; err != nil {
+			return err
+		}
+		var kb types.KnowledgeBase
+		if err := tx.Where("id=? AND tenant_id=?", session.KnowledgeBaseID, session.TenantID).Take(&kb).Error; err != nil {
+			return err
+		}
+		var lineage types.SourceLineage
+		if err := json.Unmarshal([]byte(session.SourceLineage), &lineage); err != nil {
+			return err
+		}
+		var tagInput any = operation
+		originKind := session.OriginKind
+		if strings.TrimSpace(entry.TagName) == "" {
+			fixed, _ := types.NewCompleteSourceLineage()
+			lineage = *fixed
+			originKind = "derived"
+			tagInput = struct {
+				Producer, Name, Color string
+				SortOrder             int
+			}{"faq-default-tag-fixed-code-v1", types.UntaggedTagName, "", -1}
+		}
+		for _, field := range []string{"name", "color", "sort_order"} {
+			if err := admitKnowledgeDisplayOrigin(tx, ctx, "tag-"+field, tag.ID, &kb, tagDisplayFieldValue(tag, field), tagInput, &lineage, originKind); err != nil {
+				return err
+			}
+		}
+		tagID = tag.ID
+		return s.advanceFAQSessionInTx(tx, session)
+	}, knowledgeDisplayWriteOptions(s.db))
+	return tagID, err
+}
diff --git a/internal/application/repository/faq_input_manifest.go b/internal/application/repository/faq_input_manifest.go
new file mode 100644
index 0000000000000000000000000000000000000000..1b379b8e2ae59183e6bde2d697888e4ac95b329e
--- /dev/null
+++ b/internal/application/repository/faq_input_manifest.go
@@ -0,0 +1,336 @@
+package repository
+
+import (
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+func faqInputMetadata(entry *types.FAQEntryPayload) *types.FAQChunkMetadata {
+	strategy := types.AnswerStrategyAll
+	if entry.AnswerStrategy != nil && *entry.AnswerStrategy != "" {
+		strategy = *entry.AnswerStrategy
+	}
+	meta := &types.FAQChunkMetadata{StandardQuestion: strings.TrimSpace(entry.StandardQuestion), SimilarQuestions: entry.SimilarQuestions, NegativeQuestions: entry.NegativeQuestions, Answers: entry.Answers, AnswerStrategy: strategy, Version: 1, Source: "faq"}
+	meta.Sanitize()
+	return meta
+}
+func faqOriginalContent(meta *types.FAQChunkMetadata, kb *types.KnowledgeBase) string {
+	copy := *kb
+	copy.EnsureDefaults()
+	var b strings.Builder
+	fmt.Fprintf(&b, "Q: %s\n", meta.StandardQuestion)
+	if len(meta.SimilarQuestions) > 0 {
+		b.WriteString("Similar Questions:\n")
+		for _, q := range meta.SimilarQuestions {
+			fmt.Fprintf(&b, "- %s\n", q)
+		}
+	}
+	if copy.FAQConfig != nil && copy.FAQConfig.IndexMode == types.FAQIndexModeQuestionAnswer && len(meta.Answers) > 0 {
+		b.WriteString("Answers:\n")
+		for _, a := range meta.Answers {
+			fmt.Fprintf(&b, "- %s\n", a)
+		}
+	}
+	return b.String()
+}
+func faqComparable(c *types.Chunk) *types.Chunk {
+	copy := *c
+	copy.CreatedAt = time.Time{}
+	copy.UpdatedAt = time.Time{}
+	return &copy
+}
+func faqUnionStrings(a, b []string) []string {
+	return types.SanitizeStrings(append(append([]string{}, a...), b...))
+}
+func faqManifestTag(snapshot *types.FAQInputSnapshot, entry *types.FAQEntryPayload) (string, error) {
+	name := strings.TrimSpace(entry.TagName)
+	if name == "" {
+		name = types.UntaggedTagName
+	}
+	for _, tag := range snapshot.Tags {
+		if entry.TagID > 0 && tag.SeqID == entry.TagID || entry.TagID == 0 && tag.Name == name {
+			return tag.ID, nil
+		}
+	}
+	return "", ErrKnowledgeInputChanged
+}
+func faqManifestFieldPatch(snapshot *types.FAQInputSnapshot, chunk *types.Chunk, patch types.FAQEntryFieldsUpdate) error {
+	if patch.IsEnabled != nil {
+		chunk.IsEnabled = *patch.IsEnabled
+	}
+	if patch.IsRecommended != nil {
+		if *patch.IsRecommended {
+			chunk.Flags = chunk.Flags.SetFlag(types.ChunkFlagRecommended)
+		} else {
+			chunk.Flags = chunk.Flags.ClearFlag(types.ChunkFlagRecommended)
+		}
+	}
+	if patch.TagID != nil {
+		chunk.TagID = ""
+		if *patch.TagID > 0 {
+			for _, tag := range snapshot.Tags {
+				if tag.SeqID == *patch.TagID {
+					chunk.TagID = tag.ID
+				}
+			}
+			if chunk.TagID == "" {
+				return ErrKnowledgeInputChanged
+			}
+		}
+	}
+	return nil
+}
+
+// The immutable original input and original catalog determine every permitted
+// write. Rechecking arbitrary current text or accepting a projection cannot
+// authorize a new body. Own later status updates are a separate exact case.
+func validateFAQProducerOutputs(session *faqInputSessionRow, current *types.FAQInputSnapshot, outputs []*types.Chunk, create bool) error {
+	var op types.FAQInputOperation
+	if err := json.Unmarshal([]byte(session.InputBody), &op); err != nil {
+		return err
+	}
+	var original types.FAQInputSnapshot
+	if err := json.Unmarshal([]byte(session.OriginalSnapshot), &original); err != nil {
+		return err
+	}
+	oldRows := map[string]*types.Chunk{}
+	currentRows := map[string]*types.Chunk{}
+	currentProofs := map[string]*types.FAQEntryInputProof{}
+	for _, c := range original.Chunks {
+		oldRows[c.ID] = c
+	}
+	for _, c := range current.Chunks {
+		currentRows[c.ID] = c
+	}
+	for _, p := range current.Proofs {
+		currentProofs[p.ChunkID] = p
+	}
+	for _, out := range outputs {
+		if previous := currentRows[out.ID]; previous != nil && !create {
+			if p := currentProofs[out.ID]; p != nil && p.SessionID == session.ID && previous.Status == int(types.ChunkStatusStored) && out.Status == int(types.ChunkStatusIndexed) {
+				expected := faqComparable(previous)
+				expected.Status = out.Status
+				if faqInputEqual(expected, faqComparable(out)) && expected.SourceContent == out.SourceContent && expected.ContextHeader == out.ContextHeader {
+					continue
+				}
+			}
+		}
+		old := oldRows[out.ID]
+		var expected *types.Chunk
+		var entry *types.FAQEntryPayload
+		if create {
+			if old != nil || (op.Kind != "create" && op.Kind != "import") {
+				return ErrKnowledgeInputChanged
+			}
+			if op.Kind == "create" {
+				entry = op.Entry
+			} else if op.Batch != nil {
+				for i := range op.Batch.Entries {
+					if faqInputMetadata(&op.Batch.Entries[i]).StandardQuestion == faqChunkStandard(out) {
+						entry = &op.Batch.Entries[i]
+						break
+					}
+				}
+			}
+			if entry == nil {
+				return ErrKnowledgeInputChanged
+			}
+			tag, err := faqManifestTag(current, entry)
+			if err != nil {
+				return err
+			}
+			expected = &types.Chunk{ID: out.ID, TenantID: session.TenantID, KnowledgeBaseID: session.KnowledgeBaseID, KnowledgeID: out.KnowledgeID, ChunkType: types.ChunkTypeFAQ, TagID: tag, IsEnabled: true, Flags: types.ChunkFlagRecommended, Status: int(types.ChunkStatusStored), IndexStatus: "ready"}
+			if entry.ID != nil && *entry.ID > 0 {
+				expected.SeqID = *entry.ID
+			}
+			if expected.SeqID != out.SeqID {
+				return ErrKnowledgeInputChanged
+			}
+			if entry.IsEnabled != nil {
+				expected.IsEnabled = *entry.IsEnabled
+			}
+			if entry.IsRecommended != nil && !*entry.IsRecommended {
+				expected.Flags = 0
+			}
+			meta := faqInputMetadata(entry)
+			if err := expected.SetFAQMetadata(meta); err != nil {
+				return err
+			}
+			expected.Content = faqOriginalContent(meta, current.KnowledgeBase)
+		} else {
+			if old == nil {
+				return ErrKnowledgeInputChanged
+			}
+			expected = faqComparable(old)
+			switch op.Kind {
+			case "update":
+				if old.SeqID != op.EntrySeqID || op.Entry == nil {
+					return ErrKnowledgeInputChanged
+				}
+				entry = op.Entry
+				meta := faqInputMetadata(entry)
+				before, err := old.FAQMetadata()
+				if err != nil {
+					return err
+				}
+				meta.Version = before.Version + 1
+				if err := expected.SetFAQMetadata(meta); err != nil {
+					return err
+				}
+				expected.Content = faqOriginalContent(meta, current.KnowledgeBase)
+				expected.TagID = ""
+				if entry.TagID > 0 {
+					tag, err := faqManifestTag(current, entry)
+					if err != nil {
+						return err
+					}
+					expected.TagID = tag
+				}
+				if entry.IsEnabled != nil {
+					expected.IsEnabled = *entry.IsEnabled
+				}
+				if entry.IsRecommended != nil {
+					if *entry.IsRecommended {
+						expected.Flags = expected.Flags.SetFlag(types.ChunkFlagRecommended)
+					} else {
+						expected.Flags = expected.Flags.ClearFlag(types.ChunkFlagRecommended)
+					}
+				}
+			case "similar":
+				if old.SeqID != op.EntrySeqID {
+					return ErrKnowledgeInputChanged
+				}
+				meta, err := old.FAQMetadata()
+				if err != nil {
+					return err
+				}
+				addition := []string{}
+				seen := map[string]bool{meta.StandardQuestion: true}
+				for _, q := range meta.SimilarQuestions {
+					seen[q] = true
+				}
+				for _, q := range op.Questions {
+					q = strings.TrimSpace(q)
+					if q != "" && !seen[q] {
+						addition = append(addition, q)
+						seen[q] = true
+					}
+				}
+				meta.SimilarQuestions = append(meta.SimilarQuestions, addition...)
+				meta.Version++
+				if err := expected.SetFAQMetadata(meta); err != nil {
+					return err
+				}
+				expected.Content = faqOriginalContent(meta, current.KnowledgeBase)
+			case "enabled":
+				if op.EntryID != old.ID || op.Enabled == nil {
+					return ErrKnowledgeInputChanged
+				}
+				expected.IsEnabled = *op.Enabled
+			case "tag":
+				if op.EntryID != old.ID {
+					return ErrKnowledgeInputChanged
+				}
+				expected.TagID = ""
+				if op.TagID != nil {
+					expected.TagID = *op.TagID
+				}
+			case "fields":
+				if op.Fields == nil {
+					return ErrKnowledgeInputChanged
+				}
+				excluded := false
+				for _, id := range op.Fields.ExcludeIDs {
+					if id == old.SeqID {
+						excluded = true
+					}
+				}
+				if !excluded {
+					for _, seq := range sortedFAQManifestTags(op.Fields.ByTag) {
+						for _, tag := range current.Tags {
+							if tag.SeqID == seq && expected.TagID == tag.ID {
+								if err := faqManifestFieldPatch(current, expected, op.Fields.ByTag[seq]); err != nil {
+									return err
+								}
+							}
+						}
+					}
+				}
+				if patch, ok := op.Fields.ByID[old.SeqID]; ok {
+					if err := faqManifestFieldPatch(current, expected, patch); err != nil {
+						return err
+					}
+				}
+			case "import":
+				if op.Batch == nil {
+					return ErrKnowledgeInputChanged
+				}
+				before, err := old.FAQMetadata()
+				if err != nil {
+					return err
+				}
+				for i := range op.Batch.Entries {
+					if faqInputMetadata(&op.Batch.Entries[i]).StandardQuestion == before.StandardQuestion {
+						entry = &op.Batch.Entries[i]
+						break
+					}
+				}
+				if entry == nil {
+					return ErrKnowledgeInputChanged
+				}
+				meta := faqInputMetadata(entry)
+				meta.Version = before.Version + 1
+				meta.Source = before.Source
+				meta.SimilarQuestions = faqUnionStrings(before.SimilarQuestions, meta.SimilarQuestions)
+				meta.NegativeQuestions = faqUnionStrings(before.NegativeQuestions, meta.NegativeQuestions)
+				if err := expected.SetFAQMetadata(meta); err != nil {
+					return err
+				}
+				expected.Content = faqOriginalContent(meta, current.KnowledgeBase)
+				if entry.IsEnabled != nil {
+					expected.IsEnabled = *entry.IsEnabled
+				}
+				if entry.IsRecommended != nil {
+					if *entry.IsRecommended {
+						expected.Flags = expected.Flags.SetFlag(types.ChunkFlagRecommended)
+					} else {
+						expected.Flags = expected.Flags.ClearFlag(types.ChunkFlagRecommended)
+					}
+				}
+			default:
+				return ErrKnowledgeInputChanged
+			}
+		}
+		if !faqInputEqual(faqComparable(expected), faqComparable(out)) || expected.SourceContent != out.SourceContent || expected.ContextHeader != out.ContextHeader {
+			a, b := reflect.ValueOf(*faqComparable(expected)), reflect.ValueOf(*faqComparable(out))
+			for i := 0; i < a.NumField(); i++ {
+				if !reflect.DeepEqual(a.Field(i).Interface(), b.Field(i).Interface()) {
+					return fmt.Errorf("%w: FAQ producer field %s changed", ErrKnowledgeInputChanged, a.Type().Field(i).Name)
+				}
+			}
+			return ErrKnowledgeInputChanged
+		}
+	}
+	return nil
+}
+func faqChunkStandard(c *types.Chunk) string {
+	meta, err := c.FAQMetadata()
+	if err != nil || meta == nil {
+		return ""
+	}
+	return meta.StandardQuestion
+}
+func sortedFAQManifestTags(values map[int64]types.FAQEntryFieldsUpdate) []int64 {
+	ids := make([]int64, 0, len(values))
+	for id := range values {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+	return ids
+}
diff --git a/internal/application/repository/faq_read_leases.go b/internal/application/repository/faq_read_leases.go
new file mode 100644
index 0000000000000000000000000000000000000000..053a714e30da46c2bbd11cceef6ae46c5d6f621e
--- /dev/null
+++ b/internal/application/repository/faq_read_leases.go
@@ -0,0 +1,79 @@
+package repository
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+type faqReadLeaseCoverageKey struct{}
+type faqReadLeaseCoverage struct{ Leases []NextcloudContentLease }
+
+// IDs here are private server state. Every capture verifies their actual SQL
+// row, owner, scope, epoch, expiry and open fence in its existing transaction.
+// Merely binding plan metadata or manufacturing a lease struct cannot cover a read.
+func WithFAQReadLeaseCoverage(ctx context.Context, leases []NextcloudContentLease) (context.Context, error) {
+	if len(leases) == 0 || len(leases) > 16384 {
+		return ctx, ErrNextcloudContentLeaseInvalid
+	}
+	actual := append([]NextcloudContentLease{}, leases...)
+	for _, lease := range actual {
+		if lease.ID == "" || lease.OwnerID == "" || lease.Kind != NextcloudContentReadLease {
+			return ctx, ErrNextcloudContentLeaseInvalid
+		}
+	}
+	return context.WithValue(ctx, faqReadLeaseCoverageKey{}, faqReadLeaseCoverage{actual}), nil
+}
+
+func validateFAQReadLeaseCoverageInTx(tx *gorm.DB, scopes []types.KnowledgeSearchScope, lineage *types.SourceLineage) error {
+	coverage, ok := tx.Statement.Context.Value(faqReadLeaseCoverageKey{}).(faqReadLeaseCoverage)
+	if !ok || len(coverage.Leases) == 0 || lineage.RequireComplete() != nil {
+		return ErrNextcloudContentGCUncovered
+	}
+	now, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return err
+	}
+	broad := map[string]bool{}
+	exact := map[string]uint64{}
+	for _, given := range coverage.Leases {
+		var row nextcloudContentLeaseRow
+		if err := tx.Where("lease_id=?", given.ID).Take(&row).Error; err != nil {
+			return ErrNextcloudContentLeaseExpired
+		}
+		if row.Kind != string(NextcloudContentReadLease) || row.ReleasedAtMS != nil || row.ExpiresAtMS <= now || row.OwnerID != given.OwnerID || row.TenantID != given.TenantID || row.KnowledgeBaseID != given.KnowledgeBaseID || row.KnowledgeID != given.KnowledgeID || row.Epoch != given.Epoch {
+			return ErrNextcloudContentLeaseExpired
+		}
+		var kb nextcloudContentFence
+		if err := tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=''", row.TenantID, row.KnowledgeBaseID).Take(&kb).Error; err != nil || kb.State != "open" {
+			return ErrNextcloudContentLeaseDenied
+		}
+		key := fmt.Sprintf("%d:%s", row.TenantID, row.KnowledgeBaseID)
+		if row.KnowledgeID == "" {
+			if kb.Epoch != row.Epoch {
+				return ErrNextcloudContentLeaseDenied
+			}
+			broad[key] = true
+		} else {
+			var fence nextcloudContentFence
+			if err := tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=?", row.TenantID, row.KnowledgeBaseID, row.KnowledgeID).Take(&fence).Error; err != nil || fence.State != "open" || fence.Epoch != row.Epoch {
+				return ErrNextcloudContentLeaseDenied
+			}
+			exact[fmt.Sprintf("%s:%s:%s:%s", key, row.KnowledgeID, fence.DataSourceID, fence.ExternalID)] = uint64(row.Epoch)
+		}
+	}
+	for _, scope := range scopes {
+		if !broad[fmt.Sprintf("%d:%s", scope.TenantID, scope.KBID)] {
+			return ErrNextcloudContentGCUncovered
+		}
+	}
+	for _, source := range lineage.Sources {
+		key := fmt.Sprintf("%d:%s:%s:%s:%s", source.TenantID, source.KnowledgeBaseID, source.KnowledgeID, source.DataSourceID, source.ExternalID)
+		if exact[key] != source.Revision {
+			return ErrNextcloudContentGCUncovered
+		}
+	}
+	return nil
+}
diff --git a/internal/application/repository/faq_read_plan.go b/internal/application/repository/faq_read_plan.go
new file mode 100644
index 0000000000000000000000000000000000000000..d582040ecd70ac3fe0adcb90dad75ed1c26dbe5b
--- /dev/null
+++ b/internal/application/repository/faq_read_plan.go
@@ -0,0 +1,267 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+)
+
+type faqInputReadPlanKey struct{}
+type faqInputReadPlanBinding struct {
+	sync.Mutex
+	Plan *types.FAQInputReadPlan
+}
+
+func WithFAQInputReadPlan(ctx context.Context, plan *types.FAQInputReadPlan) (context.Context, error) {
+	if plan == nil || plan.MetadataDigest == "" || len(plan.Scopes) == 0 {
+		return ctx, types.ErrSourceLineageUnknown
+	}
+	body, err := json.Marshal(plan)
+	if err != nil {
+		return ctx, err
+	}
+	var actual types.FAQInputReadPlan
+	if err = json.Unmarshal(body, &actual); err != nil {
+		return ctx, err
+	}
+	return context.WithValue(ctx, faqInputReadPlanKey{}, &faqInputReadPlanBinding{Plan: &actual}), nil
+}
+
+func (s *KnowledgeInputProvenanceStore) PeekFAQInputReadPlan(ctx context.Context, request types.FAQInputReadRequest) (*types.FAQInputReadPlan, error) {
+	var plan *types.FAQInputReadPlan
+	err := s.collectionTransaction(ctx, func(tx *gorm.DB) error {
+		var err error
+		plan, err = s.peekFAQInputReadPlanInTx(tx, request)
+		return err
+	})
+	return plan, err
+}
+
+func (s *KnowledgeInputProvenanceStore) PeekFAQTagReadPlan(ctx context.Context, tenant uint64, kb string) (*types.FAQInputReadPlan, error) {
+	var row struct{ Type string }
+	if err := s.db.WithContext(ctx).Table("knowledge_bases").Select("type").Where("tenant_id=? AND id=? AND deleted_at IS NULL", tenant, kb).Take(&row).Error; err != nil {
+		return nil, err
+	}
+	if row.Type != types.KnowledgeBaseTypeFAQ {
+		return nil, nil
+	}
+	return s.PeekFAQInputReadPlan(ctx, types.FAQInputReadRequest{TenantID: tenant, KnowledgeBaseID: kb, AllEntries: true})
+}
+
+func (s *KnowledgeInputProvenanceStore) checkFAQInputReadPlanInTx(tx *gorm.DB, request types.FAQInputReadRequest) error {
+	binding, ok := tx.Statement.Context.Value(faqInputReadPlanKey{}).(*faqInputReadPlanBinding)
+	if !ok {
+		return nil
+	}
+	binding.Lock()
+	defer binding.Unlock()
+	expected := binding.Plan
+	if expected == nil || expected.Request.TenantID != request.TenantID || expected.Request.KnowledgeBaseID != request.KnowledgeBaseID {
+		return ErrKnowledgeInputChanged
+	}
+	if !expected.Request.AllEntries && !faqInputEqual(expected.Request, request) {
+		return ErrKnowledgeInputChanged
+	}
+	actual, err := s.peekFAQInputReadPlanInTx(tx, expected.Request)
+	if err != nil {
+		return err
+	}
+	if !faqInputEqual(actual, expected) {
+		return ErrKnowledgeInputChanged
+	}
+	return validateFAQReadLeaseCoverageInTx(tx, actual.Scopes, actual.SourceLineage)
+}
+
+// Only an actual own producer's atomic write recipe may advance its request's
+// plan. Foreign body/membership changes still fail the original pre-write check.
+func (s *KnowledgeInputProvenanceStore) advanceFAQReadPlanAfterOwnWriteInTx(tx *gorm.DB, session *faqInputSessionRow) error {
+	binding, ok := tx.Statement.Context.Value(faqInputReadPlanKey{}).(*faqInputReadPlanBinding)
+	if !ok {
+		return nil
+	}
+	active, ok := tx.Statement.Context.Value(faqInputSessionKey{}).(faqInputSession)
+	if !ok || active.Store != s || active.ID != session.ID {
+		return types.ErrSourceLineageUnknown
+	}
+	binding.Lock()
+	defer binding.Unlock()
+	actual, err := s.peekFAQInputReadPlanInTx(tx, binding.Plan.Request)
+	if err != nil {
+		return err
+	}
+	if err = validateFAQReadLeaseCoverageInTx(tx, actual.Scopes, actual.SourceLineage); err != nil {
+		return err
+	}
+	binding.Plan = actual
+	return nil
+}
+
+// This probe selects row IDs, revisions and immutable source/parent envelopes.
+// Entry text, FAQ metadata, tag names, prompt/config body and parent chunks are
+// read only after the caller acquires all scopes and binds the returned plan.
+func (s *KnowledgeInputProvenanceStore) peekFAQInputReadPlanInTx(tx *gorm.DB, request types.FAQInputReadRequest) (*types.FAQInputReadPlan, error) {
+	if request.TenantID == 0 || request.KnowledgeBaseID == "" {
+		return nil, types.ErrSourceLineageUnknown
+	}
+	scopes := map[string]types.KnowledgeSearchScope{}
+	var lineages []*types.SourceLineage
+	add := func(tenant uint64, kb string) error {
+		if tenant == 0 || kb == "" {
+			return types.ErrSourceLineageUnknown
+		}
+		scopes[fmt.Sprintf("%d:%s", tenant, kb)] = types.KnowledgeSearchScope{TenantID: tenant, KBID: kb}
+		return nil
+	}
+	lineageScopes := func(raw string) error {
+		var lineage types.SourceLineage
+		if err := json.Unmarshal([]byte(raw), &lineage); err != nil {
+			return err
+		}
+		if err := lineage.RequireComplete(); err != nil {
+			return err
+		}
+		lineages = append(lineages, &lineage)
+		for _, source := range lineage.Sources {
+			if err := add(source.TenantID, source.KnowledgeBaseID); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := add(request.TenantID, request.KnowledgeBaseID); err != nil {
+		return nil, err
+	}
+	var config knowledgeConfigurationInputOrigin
+	err := tx.Table("knowledge_config_input_origins o").Select("o.*").Joins("JOIN knowledge_configuration_control_versions v ON v.knowledge_base_id=o.knowledge_base_id AND v.revision=o.config_revision").Where("o.tenant_id=? AND o.knowledge_base_id=?", request.TenantID, request.KnowledgeBaseID).Take(&config).Error
+	if err != nil {
+		return nil, err
+	}
+	if err = lineageScopes(config.SourceLineage); err != nil {
+		return nil, err
+	}
+	var scopeRevision uint64
+	if request.AllEntries {
+		var version struct{ Revision uint64 }
+		if err := tx.Table("faq_input_scope_versions").Where("tenant_id=? AND knowledge_base_id=?", request.TenantID, request.KnowledgeBaseID).Take(&version).Error; err != nil {
+			return nil, err
+		}
+		scopeRevision = version.Revision
+	}
+	var catalogs []struct {
+		ID                        string
+		Revision, ControlRevision uint64
+	}
+	if err := tx.Table("knowledges k").Select("k.id,v.revision,cv.revision AS control_revision").Joins("LEFT JOIN knowledge_input_row_versions v ON v.row_kind='knowledge' AND v.row_id=k.id").Joins("LEFT JOIN faq_catalog_control_versions cv ON cv.knowledge_id=k.id").Where("k.tenant_id=? AND k.knowledge_base_id=? AND k.type=? AND k.deleted_at IS NULL", request.TenantID, request.KnowledgeBaseID, types.KnowledgeTypeFAQ).Order("k.id").Scan(&catalogs).Error; err != nil {
+		return nil, err
+	}
+	if len(catalogs) > 1 {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var entries []struct{ ID, KnowledgeID, TagID string }
+	q := tx.Table("chunks").Select("id,knowledge_id,tag_id").Where("tenant_id=? AND knowledge_base_id=? AND chunk_type=? AND deleted_at IS NULL", request.TenantID, request.KnowledgeBaseID, types.ChunkTypeFAQ)
+	if !request.AllEntries {
+		q = q.Where("id IN ?", request.ChunkIDs)
+	}
+	if err := q.Order("id").Scan(&entries).Error; err != nil {
+		return nil, err
+	}
+	if !request.AllEntries && len(entries) != len(request.ChunkIDs) {
+		return nil, ErrKnowledgeInputChanged
+	}
+	var proofs []struct {
+		ChunkID, AdmissionID, SessionID, KnowledgeID, SourceLineage, OriginalInputs, BodyDigest string
+		Revision, CurrentRevision                                                               uint64
+	}
+	if len(entries) > 0 {
+		ids := make([]string, 0, len(entries))
+		for _, entry := range entries {
+			ids = append(ids, entry.ID)
+		}
+		err := tx.Table("faq_entry_material_receipts m").Select("m.chunk_id,m.admission_id,m.revision,m.body_digest,a.session_id,a.knowledge_id,a.source_lineage,s.original_inputs,v.revision AS current_revision").Joins("JOIN faq_entry_input_admissions a ON a.id=m.admission_id AND a.chunk_id=m.chunk_id").Joins("JOIN faq_input_sessions s ON s.id=a.session_id").Joins("JOIN faq_input_row_versions v ON v.chunk_id=m.chunk_id").Where("m.chunk_id IN ? AND a.tenant_id=? AND a.knowledge_base_id=?", ids, request.TenantID, request.KnowledgeBaseID).Order("m.chunk_id").Scan(&proofs).Error
+		if err != nil {
+			return nil, err
+		}
+		if len(proofs) != len(entries) {
+			return nil, types.ErrSourceLineageUnknown
+		}
+	}
+	for i, proof := range proofs {
+		if proof.KnowledgeID != entries[i].KnowledgeID || proof.Revision != proof.CurrentRevision {
+			return nil, ErrKnowledgeInputChanged
+		}
+		if err := lineageScopes(proof.SourceLineage); err != nil {
+			return nil, err
+		}
+		var parents []*types.KnowledgeBuildInputProof
+		if err := json.Unmarshal([]byte(proof.OriginalInputs), &parents); err != nil {
+			return nil, err
+		}
+		if len(parents) > 4096 {
+			return nil, types.ErrSourceLineageLimit
+		}
+		for _, parent := range parents {
+			if parent == nil || parent.BodyDigest == "" || parent.Projection != "" || parent.SourceLineage.RequireComplete() != nil {
+				return nil, types.ErrSourceLineageUnknown
+			}
+			if err := add(parent.TenantID, parent.KnowledgeBaseID); err != nil {
+				return nil, err
+			}
+			lineages = append(lineages, parent.SourceLineage)
+			for _, source := range parent.SourceLineage.Sources {
+				if err := add(source.TenantID, source.KnowledgeBaseID); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+	var tags []struct {
+		ID, Kind, OriginID, SourceLineage string
+		Revision                          uint64
+	}
+	tagQuery := tx.Table("knowledge_tags t").Select("t.id,v.kind,o.origin_id,o.source_lineage,v.revision").Joins("JOIN knowledge_display_versions v ON v.kind IN ('tag-name','tag-color','tag-sort_order','tag-envelope') AND v.row_id=t.id").Joins("JOIN knowledge_display_input_origins o ON o.kind=v.kind AND o.row_id=t.id AND o.revision=v.revision").Where("t.tenant_id=? AND t.knowledge_base_id=?", request.TenantID, request.KnowledgeBaseID)
+	if !request.AllEntries {
+		ids := make([]string, 0, len(entries))
+		for _, entry := range entries {
+			if entry.TagID != "" {
+				ids = append(ids, entry.TagID)
+			}
+		}
+		tagQuery = tagQuery.Where("t.id IN ?", ids)
+	}
+	if err := tagQuery.Order("t.id,v.kind").Scan(&tags).Error; err != nil {
+		return nil, err
+	}
+	for _, tag := range tags {
+		if err := lineageScopes(tag.SourceLineage); err != nil {
+			return nil, err
+		}
+	}
+	digest, err := KnowledgeInputDigest(struct {
+		Request                         types.FAQInputReadRequest
+		Config                          knowledgeConfigurationInputOrigin
+		ScopeRevision                   uint64
+		Catalogs, Entries, Proofs, Tags any
+	}{request, config, scopeRevision, catalogs, entries, proofs, tags})
+	if err != nil {
+		return nil, err
+	}
+	lineage, err := types.UnionSourceLineage(lineages...)
+	if err != nil {
+		return nil, err
+	}
+	plan := &types.FAQInputReadPlan{Request: request, MetadataDigest: digest, SourceLineage: lineage}
+	keys := make([]string, 0, len(scopes))
+	for key := range scopes {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		plan.Scopes = append(plan.Scopes, scopes[key])
+	}
+	return plan, nil
+}
