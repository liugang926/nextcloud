+	require.NoError(t, db.QueryRow(`SELECT revision, legacy_history_unknown
+		FROM nextcloud_source_revisions WHERE external_id = 'nextcloud:instance:77'
+		ORDER BY revision DESC LIMIT 1`).Scan(&revision, &unknown))
