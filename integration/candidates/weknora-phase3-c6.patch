+    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
diff --git a/migrations/versioned/000121_nextcloud_gc_object_claim.down.sql b/migrations/versioned/000121_nextcloud_gc_object_claim.down.sql
