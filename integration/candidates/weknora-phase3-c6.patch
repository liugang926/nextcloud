+	search.SetRAGChunkSnapshotReader(repository.NewRAGChunkSnapshotReader(db, nil))
+	return search, kbs, svc
+}
+
+func TestAgentLineageSearchActualTextTitleReachRerankAndOutput(t *testing.T) {
