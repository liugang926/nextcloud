+func (s *twoPhaseSource) Read(p []byte) (int, error) {
+	switch s.step {
+	case 0:
+		s.step++
+		return copy(p, "first"), nil
+	case 1:
+		s.step++
+		if s.second != nil {
+			s.second()
+		}
+		return copy(p, "second"), nil
+	default:
+		return 0, io.EOF
+	}
+}
