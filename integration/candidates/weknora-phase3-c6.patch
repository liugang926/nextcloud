+type collectionPostgresPauseKey struct{}
+
+func TestPostgresKnowledgeCollectionRRWholeSetAndAbsenceABA(t *testing.T) {
+	for _, change := range []string{"non_returned_body", "body_aba", "membership_aba", "config_aba", "source_withdraw"} {
+		t.Run(change, func(t *testing.T) {
+			store, db := collectionPostgresFixture(t)
+			ctx := context.Background()
+			baseline, err := store.CaptureKnowledgeCollectionInputs(ctx, types.KnowledgeCollectionReadRequest{Scopes: []types.KnowledgeSearchScope{{TenantID: 7, KBID: "kb"}}})
+			require.NoError(t, err)
+			fired := false
+			name := "collection_whole_set_changed"
+			require.NoError(t, db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
+				if fired || tx.Statement.Context.Value(collectionPostgresPauseKey{}) != true || tx.Statement.Table != "knowledges" {
+					return
+				}
+				fired = true
+				switch change {
+				case "non_returned_body", "body_aba":
+					require.NoError(t, db.Exec("UPDATE knowledges SET title='different' WHERE id='doc-b'").Error)
+					if change == "body_aba" {
+						require.NoError(t, db.Exec("UPDATE knowledges SET title='' WHERE id='doc-b'").Error)
+					}
+				case "membership_aba":
+					require.NoError(t, db.Create(&types.Knowledge{ID: "transient", TenantID: 7, KnowledgeBaseID: "kb", Type: "manual", Channel: "web", CustomMetadata: types.JSON(`{}`)}).Error)
+					require.NoError(t, db.Unscoped().Where("id='transient'").Delete(&types.Knowledge{}).Error)
+				case "config_aba":
+					require.NoError(t, db.Exec("UPDATE knowledge_bases SET summary_model_id='new' WHERE id='kb'").Error)
+					require.NoError(t, db.Exec("UPDATE knowledge_bases SET summary_model_id='summary' WHERE id='kb'").Error)
+				case "source_withdraw":
+					require.NoError(t, NewNextcloudContentLeaseStore(db).RetireKnowledge(context.Background(), NextcloudContentScope{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: "doc-b", DataSourceID: "ds", ExternalID: "nextcloud:instance:78"}))
+				}
+			}))
+			t.Cleanup(func() { _ = db.Callback().Query().Remove(name) })
+			captured, err := store.CaptureKnowledgeCollectionInputs(context.WithValue(ctx, collectionPostgresPauseKey{}, true), types.KnowledgeCollectionReadRequest{Scopes: []types.KnowledgeSearchScope{{TenantID: 7, KBID: "kb"}}})
+			require.NoError(t, err)
+			require.True(t, fired)
+			require.Equal(t, baseline, captured, "the full original set is read coherently under PostgreSQL RR")
+			require.Error(t, store.RecheckKnowledgeCollectionInputs(ctx, captured, nil), "release must reject committed change, including a non-returned candidate or transient membership ABA")
+		})
+	}
