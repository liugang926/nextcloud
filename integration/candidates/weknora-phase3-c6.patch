+	require.NoError(t, repo.Upsert(context.Background(), root))
+	unknown := &types.KnowledgeProcessingSpan{KnowledgeID: k.ID, Attempt: 1, SpanID: "reader", ParentSpanID: root.SpanID, Name: types.StageDocReader, Kind: types.SpanKindStage, Status: types.SpanStatusDone, Input: types.JSONMap{"old": "OLD unproved input"}, Output: types.JSONMap{"old": "OLD unproved output"}, Metadata: types.JSONMap{"old": "OLD unproved controls"}, ErrorMessage: "OLD unproved error", StartedAt: &now}
+	require.NoError(t, repo.Upsert(context.Background(), unknown))
