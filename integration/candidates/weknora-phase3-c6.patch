+		}
+		if err != nil {
+			return nil, err
+		}
+		filtered = append(filtered, message)
 	}
+	if err := s.checkMessageSourceLineageBatch(ctx, filtered, nil); err != nil {
+		return nil, err
+	}
+	return rawUserContentOnly(filtered), nil
 }
 
