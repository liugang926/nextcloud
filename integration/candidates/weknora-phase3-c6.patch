+	knowledge.onCheck = func(n int32) error {
+		if n == 3 {
+			return access.ErrNextcloudPublicationDenied
+		}
+		return nil
+	}
+	w := rawSearchResponse(h, `{"query":"synthetic","knowledge_base_ids":["kb-1"]}`)
