+// FailedCandidateRetryStatus gives an administrator a static reason code and
+// exact generation selectors without returning content or parser error text.
+func (r *NextcloudSourcePairingRepository) FailedCandidateRetryStatus(ctx context.Context,
+	pair NextcloudSourcePairing, fileID int64,
+) (NextcloudCandidateRetryStatus, error) {
+	var status NextcloudCandidateRetryStatus
+	if pair.State != "active" || fileID < 1 {
+		return status, ErrNextcloudSourcePairingConflict
+	}
+	status.FileID = strconv.FormatInt(fileID, 10)
+	externalID := "nextcloud:" + pair.InstanceID + ":" + status.FileID
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var currentPair NextcloudSourcePairing
+		if err := tx.Where("operation_id = ? AND tenant_id = ? AND state = 'active'",
+			pair.OperationID, pair.TenantID).Take(&currentPair).Error; err != nil ||
+			currentPair.KnowledgeBaseID != pair.KnowledgeBaseID ||
+			currentPair.DataSourceID != pair.DataSourceID || currentPair.InstanceID != pair.InstanceID ||
+			currentPair.BindingID != pair.BindingID || currentPair.BaseURL != pair.BaseURL ||
+			currentPair.ConfigSHA != pair.ConfigSHA {
+			return ErrNextcloudSourcePairingConflict
+		}
+		var ds types.DataSource
+		if err := tx.Where("id = ? AND tenant_id = ? AND knowledge_base_id = ? AND type = ? AND status = ? AND deleted_at IS NULL",
+			pair.DataSourceID, pair.TenantID, pair.KnowledgeBaseID,
+			types.ConnectorTypeNextcloud, types.DataSourceStatusActive).Take(&ds).Error; err != nil {
+			return ErrNextcloudSourcePairingConflict
+		}
+		base, hash, binding, err := NextcloudEventDataSourceIdentity(ds.Config)
+		if err != nil || base != currentPair.BaseURL || hash != currentPair.ConfigSHA ||
+			binding != currentPair.BindingID {
+			return ErrNextcloudSourcePairingConflict
+		}
+		var version nextcloudSourceVersion
+		if err := nextcloudVersionQuery(tx, pair.TenantID, pair.KnowledgeBaseID,
+			pair.DataSourceID, externalID).Take(&version).Error; err != nil || version.State != "staging" {
+			return ErrNextcloudSourcePairingConflict
+		}
+		var candidate types.Knowledge
+		if err := tx.Where("id = ? AND tenant_id = ? AND knowledge_base_id = ? AND channel = ? AND parse_status = ? AND deleted_at IS NULL",
+			version.CandidateKnowledgeID, pair.TenantID, pair.KnowledgeBaseID,
+			types.ConnectorTypeNextcloud, types.ParseStatusFailed).Take(&candidate).Error; err != nil {
+			return ErrNextcloudSourcePairingConflict
+		}
+		metadata, err := nextcloudMetadata(&candidate)
+		if err != nil || nextcloudMetadataString(metadata, "datasource_id") != pair.DataSourceID ||
+			nextcloudMetadataString(metadata, "external_id") != externalID ||
+			nextcloudMetadataString(metadata, "nextcloud_instance_id") != pair.InstanceID ||
+			nextcloudMetadataString(metadata, "nextcloud_binding_id") != pair.BindingID ||
+			nextcloudMetadataString(metadata, "nextcloud_file_id") != status.FileID ||
+			nextcloudMetadataString(metadata, "nextcloud_target_etag") != version.DesiredETag {
+			return ErrNextcloudSourcePairingConflict
+		}
+		status.SourceETag, status.CandidateID = version.DesiredETag, version.CandidateKnowledgeID
+		status.FirstStagedAt = version.UpdatedAt
+		status.NextAttemptAt = candidate.UpdatedAt.Add(candidateRetryDelay(externalID, version.CandidateKnowledgeID, 1))
+		status.State, status.LastErrorCode = "retry", "parse_failed"
+		var job nextcloudCandidateRetryJob
+		err = tx.Where("tenant_id = ? AND knowledge_base_id = ? AND datasource_id = ? AND external_id = ?",
+			pair.TenantID, pair.KnowledgeBaseID, pair.DataSourceID, externalID).Take(&job).Error
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if job.DesiredETag == version.DesiredETag && job.FailedCandidateID == version.CandidateKnowledgeID {
+			status.State, status.AttemptCount = job.State, job.AttemptCount
+			status.FirstStagedAt, status.NextAttemptAt = job.FirstStagedAt, job.NextAttemptAt
+			status.LastErrorCode = job.LastErrorCode
+		}
+		return nil
+	})
+	return status, err
+}
diff --git a/internal/application/repository/nextcloud_capacity.go b/internal/application/repository/nextcloud_capacity.go
new file mode 100644
index 0000000000000000000000000000000000000000..5a52a670b381af3b8aa5085900c7f968ae71e992
--- /dev/null
+++ b/internal/application/repository/nextcloud_capacity.go
@@ -0,0 +1,344 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"math"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+var (
+	ErrNextcloudCapacityUnavailable = errors.New("Nextcloud storage capacity is unavailable")
+	ErrNextcloudCapacityPaused      = errors.New("Nextcloud AI ingestion is paused by capacity")
+	ErrNextcloudRetentionQuota      = errors.New("Nextcloud knowledge base retention quota exceeded")
+)
+
+type NextcloudCapacityPolicy struct {
+	TenantID            uint64 `gorm:"primaryKey"`
+	KnowledgeBaseID     string `gorm:"primaryKey"`
+	RetentionQuotaBytes int64
+	WarningPercent      int
+	PausePercent        int
+}
+
+func (NextcloudCapacityPolicy) TableName() string { return "nextcloud_capacity_policies" }
+
+type capacityScope struct {
+	ScopeID        string `gorm:"primaryKey"`
+	TotalBytes     int64
+	AvailableBytes int64
+	MeasuredAtMS   int64
+	State          string
+	Revision       int64
+}
+
+func (capacityScope) TableName() string { return "nextcloud_capacity_scopes" }
+
+type NextcloudCapacityReservation struct {
+	Token           string `gorm:"primaryKey"`
+	ScopeID         string
+	TenantID        uint64
+	KnowledgeBaseID string
+	BackendID       string
+	RequestKey      string
+	Bytes           int64
+	State           string
+	LeaseUntilMS    int64
+	CreatedAtMS     int64
+	CommittedAtMS   int64
+	ProtocolVersion int
+}
+
+func (NextcloudCapacityReservation) TableName() string { return "nextcloud_capacity_reservations" }
+
+type NextcloudCapacityStore struct{ db *gorm.DB }
+
+func NewNextcloudCapacityStore(db *gorm.DB) *NextcloudCapacityStore {
+	return &NextcloudCapacityStore{db: db}
+}
+
+func (s *NextcloudCapacityStore) SetPolicy(ctx context.Context, p NextcloudCapacityPolicy) error {
+	if p.TenantID == 0 || p.KnowledgeBaseID == "" || p.RetentionQuotaBytes < 0 || p.WarningPercent <= 0 || p.WarningPercent >= p.PausePercent || p.PausePercent > 100 {
+		return ErrNextcloudCapacityUnavailable
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var kb types.KnowledgeBase
+		if err := tx.Where("tenant_id=? AND id=?", p.TenantID, p.KnowledgeBaseID).Take(&kb).Error; err != nil {
+			return err
+		}
+		return tx.Clauses(clause.OnConflict{Columns: []clause.Column{{Name: "tenant_id"}, {Name: "knowledge_base_id"}}, DoUpdates: clause.AssignmentColumns([]string{"retention_quota_bytes", "warning_percent", "pause_percent"})}).Create(&p).Error
+	})
+}
+func validCapacity(m types.StorageCapacity, now time.Time) bool {
+	return len(m.ScopeID) == 64 && m.TotalBytes > 0 && m.AvailableBytes >= 0 && m.AvailableBytes <= m.TotalBytes && !m.MeasuredAt.After(now.Add(time.Second)) && now.Sub(m.MeasuredAt) <= 30*time.Second
+}
+func addBytes(a, b int64) (int64, error) {
+	if a < 0 || b < 0 || a > math.MaxInt64-b {
+		return 0, ErrNextcloudCapacityUnavailable
+	}
+	return a + b, nil
+}
+func threshold(total int64, percent int) int64 {
+	return total/100*int64(percent) + (total%100*int64(percent))/100
+}
+
+// Reserve serializes disk-wide and KB quota admissions. A measurement failure
+// closes new AI work, without deleting any active or retained object.
+func (s *NextcloudCapacityStore) Reserve(ctx context.Context, tenant uint64, kb, backend, key string, bytes int64, m types.StorageCapacity) (*NextcloudCapacityReservation, error) {
+	return s.reserve(ctx, tenant, kb, backend, key, bytes, m, 0)
+}
+func (s *NextcloudCapacityStore) ReserveDurable(ctx context.Context, tenant uint64, kb, backend, key string, bytes int64, m types.StorageCapacity) (*NextcloudCapacityReservation, error) {
+	return s.reserve(ctx, tenant, kb, backend, key, bytes, m, 1)
+}
+func (s *NextcloudCapacityStore) reserve(ctx context.Context, tenant uint64, kb, backend, key string, bytes int64, m types.StorageCapacity, protocol int) (*NextcloudCapacityReservation, error) {
+	if s == nil || s.db == nil || tenant == 0 || kb == "" || backend == "" || key == "" || len(key) > 512 || bytes <= 0 {
+		return nil, ErrNextcloudCapacityUnavailable
+	}
+	var result *NextcloudCapacityReservation
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		nowMS, err := nextcloudLeaseNowMS(tx)
+		if err != nil {
+			return err
+		}
+		now := time.UnixMilli(nowMS)
+		if !validCapacity(m, now) {
+			return ErrNextcloudCapacityUnavailable
+		}
+		scope := capacityScope{ScopeID: m.ScopeID, TotalBytes: m.TotalBytes, AvailableBytes: m.AvailableBytes, MeasuredAtMS: m.MeasuredAt.UnixMilli(), State: "normal", Revision: 1}
+		if err := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&scope).Error; err != nil {
+			return err
+		}
+		// UPDATE also acquires a writer lock on SQLite before any quota reads.
+		if err := tx.Model(&capacityScope{}).Where("scope_id=?", m.ScopeID).UpdateColumn("revision", gorm.Expr("revision+1")).Error; err != nil {
+			return err
+		}
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("scope_id=?", m.ScopeID).Take(&scope).Error; err != nil {
+			return err
+		}
+		var row types.KnowledgeBase
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=? AND tenant_id=?", kb, tenant).Take(&row).Error; err != nil {
+			return err
+		}
+		if row.StorageBackendID == nil || *row.StorageBackendID != backend {
+			return ErrNextcloudCapacityUnavailable
+		}
+		policy := NextcloudCapacityPolicy{TenantID: tenant, KnowledgeBaseID: kb, WarningPercent: 80, PausePercent: 90}
+		if err := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&policy).Error; err != nil {
+			return err
+		}
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("tenant_id=? AND knowledge_base_id=?", tenant, kb).Take(&policy).Error; err != nil {
+			return err
+		}
+		var existing NextcloudCapacityReservation
+		err = tx.Where("tenant_id=? AND knowledge_base_id=? AND request_key=?", tenant, kb, key).Take(&existing).Error
+		duplicate := err == nil
+		if duplicate {
+			if existing.ProtocolVersion != protocol || existing.ScopeID != m.ScopeID || existing.BackendID != backend || existing.Bytes != bytes || existing.State != "pending" || existing.LeaseUntilMS <= nowMS {
+				return ErrNextcloudCapacityUnavailable
+			}
+		} else if !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+
+		var diskPending, kbPending int64
+		if err := tx.Model(&NextcloudCapacityReservation{}).Where("scope_id=? AND (state='pending' OR (state='committed' AND committed_at_ms>=?))", m.ScopeID, m.MeasuredAt.UnixMilli()-1000).Select("COALESCE(SUM(bytes),0)").Scan(&diskPending).Error; err != nil {
+			return err
+		}
+		if err := tx.Model(&NextcloudCapacityReservation{}).Where("tenant_id=? AND knowledge_base_id=? AND state='pending'", tenant, kb).Select("COALESCE(SUM(bytes),0)").Scan(&kbPending).Error; err != nil {
+			return err
+		}
+		// Expired reservations remain charged: a crashed upload may own bytes not
+		// yet catalogued. Reconciliation, rather than time alone, releases them.
+		used := m.TotalBytes - m.AvailableBytes
+		projected, err := addBytes(used, diskPending)
+		if err != nil {
+			return err
+		}
+		additional := bytes
+		if duplicate {
+			additional = 0
+		}
+		projected, err = addBytes(projected, additional)
+		if err != nil {
+			return err
+		}
+		state := "normal"
+		if projected >= threshold(m.TotalBytes, policy.WarningPercent) {
+			state = "warning"
+		}
+		if projected >= threshold(m.TotalBytes, policy.PausePercent) || diskPending > m.AvailableBytes || additional > m.AvailableBytes-diskPending {
+			return ErrNextcloudCapacityPaused
+		}
+		var logical int64
+		if err := tx.Raw(`SELECT COALESCE(SUM(r.size),0) FROM resources r WHERE r.tenant_id=? AND r.storage_backend_id=? AND r.state<>'deleted' AND EXISTS (SELECT 1 FROM resource_bindings b JOIN knowledges k ON k.id=b.owner_id AND k.tenant_id=r.tenant_id WHERE b.resource_id=r.id AND b.owner_type='knowledge' AND k.knowledge_base_id=?)`, tenant, backend, kb).Scan(&logical).Error; err != nil {
+			return err
+		}
+		var orphan int64
+		if err := tx.Raw("SELECT COALESCE(SUM(i.orphan_charge_bytes),0) FROM nextcloud_capacity_write_intents i JOIN nextcloud_capacity_reservations r ON r.token=i.token WHERE r.tenant_id=? AND r.knowledge_base_id=? AND i.state='charged'", tenant, kb).Scan(&orphan).Error; err != nil {
+			return err
+		}
+		logical, err = addBytes(logical, orphan)
+		if err != nil {
+			return err
+		}
+		retained, err := addBytes(logical, kbPending)
+		if err != nil {
+			return err
+		}
+		retained, err = addBytes(retained, additional)
+		if err != nil {
+			return err
+		}
+		if policy.RetentionQuotaBytes > 0 && retained > policy.RetentionQuotaBytes {
+			return ErrNextcloudRetentionQuota
+		}
+		if err := tx.Model(&scope).Updates(map[string]any{"total_bytes": m.TotalBytes, "available_bytes": m.AvailableBytes, "measured_at_ms": m.MeasuredAt.UnixMilli(), "state": state}).Error; err != nil {
+			return err
+		}
+		if duplicate {
+			result = &existing
+			return nil
+		}
+		reservation := NextcloudCapacityReservation{Token: uuid.NewString(), ScopeID: m.ScopeID, TenantID: tenant, KnowledgeBaseID: kb, BackendID: backend, RequestKey: key, Bytes: bytes, State: "pending", LeaseUntilMS: now.Add(15 * time.Minute).UnixMilli(), CreatedAtMS: nowMS, ProtocolVersion: protocol}
+		if err := tx.Create(&reservation).Error; err != nil {
+			return err
+		}
+		result = &reservation
+		return nil
+	})
+	return result, err
+}
+
+func (s *NextcloudCapacityStore) Finish(ctx context.Context, r *NextcloudCapacityReservation, knowledge string, success bool) error {
+	if r != nil && r.ProtocolVersion == 1 {
+		return s.FinishDurable(ctx, r, knowledge, success)
+	}
+	if r == nil || r.Token == "" {
+		return ErrNextcloudCapacityUnavailable
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var row NextcloudCapacityReservation
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("token=?", r.Token).Take(&row).Error; err != nil {
+			return err
+		}
+		if row.TenantID != r.TenantID || row.KnowledgeBaseID != r.KnowledgeBaseID || row.BackendID != r.BackendID || row.Bytes != r.Bytes {
+			return ErrNextcloudCapacityUnavailable
+		}
+		if row.State == "committed" && success {
+			return nil
+		}
+		if row.State != "pending" {
+			return ErrNextcloudCapacityUnavailable
+		}
+		if !success {
+			return nil
+		} // retained until storage/no-owner reconciliation proves release safe
+		var count int64
+		if err := tx.Raw(`SELECT COUNT(*) FROM resource_bindings b JOIN resources s ON s.id=b.resource_id JOIN knowledges k ON k.id=b.owner_id WHERE b.owner_type='knowledge' AND b.owner_id=? AND k.tenant_id=? AND k.knowledge_base_id=? AND s.tenant_id=k.tenant_id AND s.storage_backend_id=? AND s.state='active' AND s.size>=?`, knowledge, row.TenantID, row.KnowledgeBaseID, row.BackendID, row.Bytes).Scan(&count).Error; err != nil {
+			return err
+		}
+		if count != 1 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		now, err := nextcloudLeaseNowMS(tx)
+		if err != nil {
+			return err
+		}
+		return tx.Model(&row).Updates(map[string]any{"state": "committed", "committed_at_ms": now}).Error
+	})
+}
+
+// Observe persists actual measurement even when the next admission is denied.
+func (s *NextcloudCapacityStore) Observe(ctx context.Context, m types.StorageCapacity) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		ms, err := nextcloudLeaseNowMS(tx)
+		if err != nil {
+			return err
+		}
+		if !validCapacity(m, time.UnixMilli(ms)) {
+			return ErrNextcloudCapacityUnavailable
+		}
+		state := "normal"
+		used := m.TotalBytes - m.AvailableBytes
+		if used >= threshold(m.TotalBytes, 90) {
+			state = "paused"
+		} else if used >= threshold(m.TotalBytes, 80) {
+			state = "warning"
+		}
+		row := capacityScope{ScopeID: m.ScopeID, TotalBytes: m.TotalBytes, AvailableBytes: m.AvailableBytes, MeasuredAtMS: m.MeasuredAt.UnixMilli(), State: state, Revision: 1}
+		return tx.Clauses(clause.OnConflict{Columns: []clause.Column{{Name: "scope_id"}}, DoUpdates: clause.Assignments(map[string]any{"total_bytes": m.TotalBytes, "available_bytes": m.AvailableBytes, "measured_at_ms": m.MeasuredAt.UnixMilli(), "state": state, "revision": gorm.Expr("nextcloud_capacity_scopes.revision+1")})}).Create(&row).Error
+	})
+}
+
+type NextcloudCapacityStatus struct {
+	Policy               NextcloudCapacityPolicy `json:"policy"`
+	ScopeID              string                  `json:"scope_id"`
+	TotalBytes           int64                   `json:"physical_total_bytes"`
+	AvailableBytes       int64                   `json:"physical_available_bytes"`
+	MeasuredAtMS         int64                   `json:"measured_at_ms"`
+	PendingBytes         int64                   `json:"reserved_bytes"`
+	State                string                  `json:"state"`
+	LogicalRetainedBytes int64                   `json:"logical_retained_bytes"`
+	OrphanChargeBytes    int64                   `json:"orphan_charge_bytes"`
+}
+
+func (s *NextcloudCapacityStore) Status(ctx context.Context, tenant uint64, kb, backend string, m types.StorageCapacity) (NextcloudCapacityStatus, error) {
+	result := NextcloudCapacityStatus{ScopeID: m.ScopeID, TotalBytes: m.TotalBytes, AvailableBytes: m.AvailableBytes, MeasuredAtMS: m.MeasuredAt.UnixMilli()}
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		now, err := nextcloudLeaseNowMS(tx)
+		if err != nil {
+			return err
+		}
+		if !validCapacity(m, time.UnixMilli(now)) {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var row types.KnowledgeBase
+		if err := tx.Where("tenant_id=? AND id=?", tenant, kb).Take(&row).Error; err != nil {
+			return err
+		}
+		if row.StorageBackendID == nil || *row.StorageBackendID != backend {
+			return ErrNextcloudCapacityUnavailable
+		}
+		result.Policy = NextcloudCapacityPolicy{TenantID: tenant, KnowledgeBaseID: kb, WarningPercent: 80, PausePercent: 90}
+		if err := tx.Where("tenant_id=? AND knowledge_base_id=?", tenant, kb).Take(&result.Policy).Error; err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		if err := tx.Model(&NextcloudCapacityReservation{}).Where("scope_id=? AND (state='pending' OR (state='committed' AND committed_at_ms>=?))", m.ScopeID, m.MeasuredAt.UnixMilli()-1000).Select("COALESCE(SUM(bytes),0)").Scan(&result.PendingBytes).Error; err != nil {
+			return err
+		}
+		if err := tx.Raw(`SELECT COALESCE(SUM(r.size),0) FROM resources r WHERE r.tenant_id=? AND r.storage_backend_id=? AND r.state<>'deleted' AND EXISTS (SELECT 1 FROM resource_bindings b JOIN knowledges k ON k.id=b.owner_id AND k.tenant_id=r.tenant_id WHERE b.resource_id=r.id AND b.owner_type='knowledge' AND k.knowledge_base_id=?)`, tenant, backend, kb).Scan(&result.LogicalRetainedBytes).Error; err != nil {
+			return err
+		}
+		if err := tx.Raw("SELECT COALESCE(SUM(i.orphan_charge_bytes),0) FROM nextcloud_capacity_write_intents i JOIN nextcloud_capacity_reservations r ON r.token=i.token WHERE r.tenant_id=? AND r.knowledge_base_id=? AND i.state='charged'", tenant, kb).Scan(&result.OrphanChargeBytes).Error; err != nil {
+			return err
+		}
+		result.LogicalRetainedBytes, err = addBytes(result.LogicalRetainedBytes, result.OrphanChargeBytes)
+		if err != nil {
+			return err
+		}
+		projected, err := addBytes(m.TotalBytes-m.AvailableBytes, result.PendingBytes)
+		if err != nil {
+			return err
+		}
+		result.State = "normal"
+		if projected >= threshold(m.TotalBytes, result.Policy.PausePercent) {
+			result.State = "paused"
+		} else if projected >= threshold(m.TotalBytes, result.Policy.WarningPercent) {
+			result.State = "warning"
+		}
+		if quota := result.Policy.RetentionQuotaBytes; quota > 0 {
+			if result.LogicalRetainedBytes >= quota {
+				result.State = "paused"
+			} else if result.State == "normal" && result.LogicalRetainedBytes >= threshold(quota, result.Policy.WarningPercent) {
+				result.State = "warning"
+			}
+		}
+		return nil
+	})
+	return result, err
+}
diff --git a/internal/application/repository/nextcloud_capacity_intents.go b/internal/application/repository/nextcloud_capacity_intents.go
new file mode 100644
index 0000000000000000000000000000000000000000..eabaaede2fa4f9e99dcadb67906030cae2bbcd87
--- /dev/null
+++ b/internal/application/repository/nextcloud_capacity_intents.go
@@ -0,0 +1,349 @@
+package repository
+
+import (
+	"context"
+	"errors"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"strconv"
+	"strings"
+)
+
+type NextcloudCapacityWriteIntent struct {
+	Token                                                             string `gorm:"primaryKey"`
+	KnowledgeID, WriterID, PhysicalPath, RootIdentity, ScopeID, State string
+	ObservedBytes                                                     int64
+	SHA256                                                            string `gorm:"column:sha256"`
+	ObjectIdentity                                                    string
+	ResourceID                                                        string
+	OrphanChargeBytes, UpdatedAtMS                                    int64
+}
+
+func (NextcloudCapacityWriteIntent) TableName() string { return "nextcloud_capacity_write_intents" }
+func (s *NextcloudCapacityStore) lockDurable(tx *gorm.DB, r *NextcloudCapacityReservation) (NextcloudCapacityReservation, int64, error) {
+	var row NextcloudCapacityReservation
+	if r == nil {
+		return row, 0, ErrNextcloudCapacityUnavailable
+	}
+	// A writer lock is obtained on SQLite before reading state as well.
+	if e := tx.Model(&NextcloudCapacityReservation{}).Where("token=?", r.Token).UpdateColumn("token", gorm.Expr("token")).Error; e != nil {
+		return row, 0, e
+	}
+	if e := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("token=?", r.Token).Take(&row).Error; e != nil {
+		return row, 0, e
+	}
+	if row.ProtocolVersion != 1 || row.TenantID != r.TenantID || row.KnowledgeBaseID != r.KnowledgeBaseID || row.BackendID != r.BackendID || row.ScopeID != r.ScopeID {
+		return row, 0, ErrNextcloudCapacityUnavailable
+	}
+	var kb types.KnowledgeBase
+	if e := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id=? AND tenant_id=?", row.KnowledgeBaseID, row.TenantID).Take(&kb).Error; e != nil {
+		return row, 0, e
+	}
+	if kb.StorageBackendID == nil || *kb.StorageBackendID != row.BackendID {
+		return row, 0, ErrNextcloudCapacityUnavailable
+	}
+	now, e := nextcloudLeaseNowMS(tx)
+	return row, now, e
+}
+func (s *NextcloudCapacityStore) PrepareLocal(ctx context.Context, r *NextcloudCapacityReservation, writer, knowledge, path, root, scope string, size int64) error {
+	backend, inner, ok := types.ParseStorageBackendPath(path)
+	if r == nil || writer == "" || knowledge == "" || !ok || backend != r.BackendID || !strings.HasPrefix(inner, "local://") || len(root) != 64 || scope != r.ScopeID || size != r.Bytes {
+		return ErrNextcloudCapacityUnavailable
+	}
+	parts := strings.Split(strings.TrimPrefix(inner, "local://"), "/")
+	if len(parts) != 3 || parts[0] != strconv.FormatUint(r.TenantID, 10) || parts[1] != knowledge || !strings.HasPrefix(parts[2], "capacity-"+r.Token) {
+		return ErrNextcloudCapacityUnavailable
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State != "pending" || row.LeaseUntilMS <= now {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var count int64
+		if e = tx.Model(&NextcloudCapacityWriteIntent{}).Where("token=?", r.Token).Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 0 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		return tx.Create(&NextcloudCapacityWriteIntent{Token: r.Token, KnowledgeID: knowledge, WriterID: writer, PhysicalPath: path, RootIdentity: root, ScopeID: scope, State: "prepared", UpdatedAtMS: now}).Error
+	})
+}
+func (s *NextcloudCapacityStore) ValidateWriter(ctx context.Context, r *NextcloudCapacityReservation, writer, path, knowledge string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State != "pending" || row.LeaseUntilMS <= now {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var i NextcloudCapacityWriteIntent
+		if e = tx.Where("token=?", r.Token).Take(&i).Error; e != nil {
+			return e
+		}
+		if i.WriterID != writer || i.PhysicalPath != path || (knowledge != "" && i.KnowledgeID != knowledge) || (i.State != "prepared" && i.State != "writing" && i.State != "written" && i.State != "cataloged") {
+			return ErrNextcloudCapacityUnavailable
+		}
+		return nil
+	})
+}
+func (s *NextcloudCapacityStore) LocalCreated(ctx context.Context, r *NextcloudCapacityReservation, writer, path, identity string) error {
+	if len(identity) != 64 {
+		return ErrNextcloudCapacityUnavailable
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State != "pending" || row.LeaseUntilMS <= now {
+			return ErrNextcloudCapacityUnavailable
+		}
+		u := tx.Model(&NextcloudCapacityWriteIntent{}).Where("token=? AND writer_id=? AND physical_path=? AND state='prepared' AND object_identity=''", row.Token, writer, path).Updates(map[string]any{"state": "writing", "object_identity": identity, "updated_at_ms": now})
+		if u.Error != nil {
+			return u.Error
+		}
+		if u.RowsAffected != 1 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		return nil
+	})
+}
+func (s *NextcloudCapacityStore) PhysicalWritten(ctx context.Context, r *NextcloudCapacityReservation, writer, path string, size int64, hash string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State != "pending" || row.LeaseUntilMS <= now || size != row.Bytes || len(hash) != 64 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		update := tx.Model(&NextcloudCapacityWriteIntent{}).Where("token=? AND writer_id=? AND physical_path=? AND state='writing'", r.Token, writer, path).Updates(map[string]any{"state": "written", "observed_bytes": size, "sha256": hash, "updated_at_ms": now})
+		if update.Error != nil {
+			return update.Error
+		}
+		if update.RowsAffected != 1 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		return nil
+	})
+}
+func (s *NextcloudCapacityStore) Cataloged(ctx context.Context, r *NextcloudCapacityReservation, writer, path, knowledge, ref string) error {
+	handle, ok := types.ParseResourcePath(ref)
+	if !ok {
+		return ErrNextcloudCapacityUnavailable
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State != "pending" || row.LeaseUntilMS <= now {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var resource types.StoredResource
+		if e = tx.Where("handle=? AND tenant_id=? AND storage_backend_id=? AND physical_path=? AND provider='local' AND state='active'", handle, row.TenantID, row.BackendID, path).Take(&resource).Error; e != nil {
+			return e
+		}
+		if resource.Size != row.Bytes {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var count int64
+		if e = tx.Model(&types.ResourceBinding{}).Where("resource_id=? AND tenant_id=? AND owner_type='knowledge' AND owner_id=? AND relation='source_file'", resource.ID, row.TenantID, knowledge).Count(&count).Error; e != nil {
+			return e
+		}
+		if count != 1 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		u := tx.Model(&NextcloudCapacityWriteIntent{}).Where("token=? AND writer_id=? AND physical_path=? AND knowledge_id=? AND state='written'", row.Token, writer, path, knowledge).Updates(map[string]any{"state": "cataloged", "resource_id": resource.ID, "updated_at_ms": now})
+		if u.Error != nil {
+			return u.Error
+		}
+		if u.RowsAffected != 1 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		return nil
+	})
+}
+
+// Cancel is proof from the new protocol's absence of a pre-IO intent. Old
+// reservations remain unknown and can never be retrospectively certified.
+func (s *NextcloudCapacityStore) CancelUnstarted(ctx context.Context, r *NextcloudCapacityReservation) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, _, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State == "cancelled" {
+			return nil
+		}
+		if row.State != "pending" {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var n int64
+		if e = tx.Model(&NextcloudCapacityWriteIntent{}).Where("token=?", row.Token).Count(&n).Error; e != nil {
+			return e
+		}
+		if n != 0 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		return tx.Model(&row).Update("state", "cancelled").Error
+	})
+}
+func (s *NextcloudCapacityStore) MarkWriteFailed(ctx context.Context, r *NextcloudCapacityReservation, writer string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State != "pending" {
+			return nil
+		}
+		return tx.Model(&NextcloudCapacityWriteIntent{}).Where("token=? AND writer_id=? AND state IN ('prepared','writing','written','cataloged')", row.Token, writer).Updates(map[string]any{"state": "failed", "updated_at_ms": now}).Error
+	})
+}
+func (s *NextcloudCapacityStore) Intent(ctx context.Context, r *NextcloudCapacityReservation) (NextcloudCapacityWriteIntent, error) {
+	var i NextcloudCapacityWriteIntent
+	if r == nil || r.ProtocolVersion != 1 {
+		return i, ErrNextcloudCapacityUnavailable
+	}
+	e := s.db.WithContext(ctx).Where("token=?", r.Token).Take(&i).Error
+	return i, e
+}
+
+// Called only while the exact local provider holds its exclusive OS fence.
+// An object is never deleted here. Existing owner claims stay authoritative.
+func (s *NextcloudCapacityStore) ReconcileLocal(ctx context.Context, r *NextcloudCapacityReservation, expected NextcloudCapacityWriteIntent, o types.CapacityLocalObject) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		var i NextcloudCapacityWriteIntent
+		if e = tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("token=?", row.Token).Take(&i).Error; e != nil {
+			return e
+		}
+		if i.Token != expected.Token || i.WriterID != expected.WriterID || i.KnowledgeID != expected.KnowledgeID || i.PhysicalPath != expected.PhysicalPath || i.RootIdentity != o.RootIdentity || i.ScopeID != o.ScopeID || o.Token != row.Token || o.BackendID != row.BackendID || o.PhysicalPath != i.PhysicalPath || o.Size < 0 || o.Size > row.Bytes {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var resources []types.StoredResource
+		if e = tx.Unscoped().Clauses(clause.Locking{Strength: "UPDATE"}).Where("physical_path=?", i.PhysicalPath).Find(&resources).Error; e != nil {
+			return e
+		}
+		if len(resources) > 1 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var owners int64
+		own := false
+		resourceID := ""
+		for _, resource := range resources {
+			if resource.TenantID != row.TenantID || resource.StorageBackendID != row.BackendID || resource.Provider != "local" {
+				return ErrNextcloudCapacityUnavailable
+			}
+			if e = tx.Model(&types.ResourceBinding{}).Where("resource_id=?", resource.ID).Count(&owners).Error; e != nil {
+				return e
+			}
+			var k types.Knowledge
+			ke := tx.Where("id=? AND tenant_id=? AND knowledge_base_id=?", i.KnowledgeID, row.TenantID, row.KnowledgeBaseID).Take(&k).Error
+			var count int64
+			if e = tx.Model(&types.ResourceBinding{}).Where("resource_id=? AND tenant_id=? AND owner_type='knowledge' AND owner_id=? AND relation='source_file'", resource.ID, row.TenantID, i.KnowledgeID).Count(&count).Error; e != nil {
+				return e
+			}
+			own = ke == nil && count == 1 && resource.State == types.ResourceStateActive && resource.Size == o.Size && k.FilePath == types.BuildResourcePath(resource.Handle)
+			if ke != nil && !errors.Is(ke, gorm.ErrRecordNotFound) {
+				return ke
+			}
+			resourceID = resource.ID
+		}
+		if o.Exists && (i.ObjectIdentity == "" || i.ObjectIdentity != o.ObjectIdentity || (i.SHA256 != "" && i.SHA256 != o.SHA256)) {
+			return ErrNextcloudCapacityUnavailable
+		}
+		if i.State == "charged" {
+			if row.State != "committed" {
+				return ErrNextcloudCapacityUnavailable
+			}
+			if !o.Exists || o.Size != i.ObservedBytes || o.SHA256 != i.SHA256 {
+				return ErrNextcloudCapacityUnavailable
+			}
+			return nil
+		}
+		if i.State == "released" {
+			if row.State != "released" {
+				return ErrNextcloudCapacityUnavailable
+			}
+			if o.Exists || owners != 0 {
+				return ErrNextcloudCapacityUnavailable
+			}
+			return nil
+		}
+		if row.State != "pending" {
+			return ErrNextcloudCapacityUnavailable
+		}
+		if !o.Exists {
+			if owners != 0 {
+				return ErrNextcloudCapacityUnavailable
+			}
+			if e = tx.Model(&i).Updates(map[string]any{"state": "released", "updated_at_ms": now}).Error; e != nil {
+				return e
+			}
+			return tx.Model(&row).Update("state", "released").Error
+		}
+		orphan := o.Size
+		if own {
+			orphan = 0
+		}
+		if e = tx.Model(&i).Updates(map[string]any{"state": "charged", "observed_bytes": o.Size, "sha256": o.SHA256, "resource_id": resourceID, "orphan_charge_bytes": orphan, "updated_at_ms": now}).Error; e != nil {
+			return e
+		}
+		// Keep the original reserved bytes as an immutable admission receipt. A
+		// fresh provider measurement supersedes its temporary disk buffer; the
+		// exact orphan object remains charged to the original KB indefinitely.
+		return tx.Model(&row).Updates(map[string]any{"state": "committed", "committed_at_ms": now}).Error
+	})
+}
+func (s *NextcloudCapacityStore) FinishDurable(ctx context.Context, r *NextcloudCapacityReservation, k string, success bool) error {
+	if !success {
+		return s.CancelUnstarted(ctx, r)
+	}
+	i, e := s.Intent(ctx, r)
+	if errors.Is(e, gorm.ErrRecordNotFound) {
+		return s.CancelUnstarted(ctx, r)
+	}
+	if e != nil {
+		return e
+	}
+	if i.KnowledgeID != k || i.State != "cataloged" {
+		return ErrNextcloudCapacityUnavailable
+	}
+	// The writer still holds the provider lock. The catalog must match the
+	// intended knowledge and physical object; recovery uses fresh observation.
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, now, e := s.lockDurable(tx, r)
+		if e != nil {
+			return e
+		}
+		if row.State != "pending" || row.LeaseUntilMS <= now {
+			return ErrNextcloudCapacityUnavailable
+		}
+		var count int64
+		var resource types.StoredResource
+		if e = tx.Where("id=?", i.ResourceID).Take(&resource).Error; e != nil {
+			return e
+		}
+		if e = tx.Raw("SELECT COUNT(*) FROM resources s JOIN resource_bindings b ON b.resource_id=s.id JOIN knowledges k ON k.id=b.owner_id AND k.tenant_id=s.tenant_id WHERE s.id=? AND s.tenant_id=? AND s.storage_backend_id=? AND s.physical_path=? AND s.state='active' AND s.size=? AND b.owner_type='knowledge' AND b.relation='source_file' AND k.id=? AND k.knowledge_base_id=? AND k.file_path=?", i.ResourceID, row.TenantID, row.BackendID, i.PhysicalPath, i.ObservedBytes, k, row.KnowledgeBaseID, types.BuildResourcePath(resource.Handle)).Scan(&count).Error; e != nil {
+			return e
+		}
+		if count != 1 {
+			return ErrNextcloudCapacityUnavailable
+		}
+		if e = tx.Model(&i).Updates(map[string]any{"state": "charged", "orphan_charge_bytes": 0, "updated_at_ms": now}).Error; e != nil {
+			return e
+		}
+		return tx.Model(&row).Updates(map[string]any{"state": "committed", "committed_at_ms": now}).Error
+	})
+}
