+		}
+	}
+	if log.RecoveryVersion == 1 && log.QueueTaskID == "" {
+		log.QueueTaskID = datasource.NextcloudSyncTaskID(log.ID)
+	}
 	r.logs[log.ID] = log
 	return nil
 }
