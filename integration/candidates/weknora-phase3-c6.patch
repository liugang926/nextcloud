+type autoSpanSnapshotPauseKey struct{}
+
+func TestAutoSpanPostgresCoherentAdditionalInputsAndFinalRecheck(t *testing.T) {
+	store, db, ctx, k, knowledge, manifest, row, repo := autoSpanFixture(t, true, false)
+	writer, err := WithKnowledgeAutoTagInput(ctx, store, manifest)
+	require.NoError(t, err)
+	require.NoError(t, knowledge.AddKnowledgeTagRelations(writer, 7, "kb", k.ID, []string{"span-match"}))
+	finishOriginalSpan(t, repo, ctx, row)
+	before, err := store.CaptureSpanOutputInputs(context.Background(), types.SpanOutputReadRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, Attempt: 1})
+	require.NoError(t, err)
+	fired := false
+	name := "auto_span_unselected_changed_after_header"
+	require.NoError(t, db.Callback().Query().After("gorm:query").Register(name, func(tx *gorm.DB) {
+		if fired || tx.Statement.Context.Value(autoSpanSnapshotPauseKey{}) != true || tx.Statement.Table != "knowledges" {
+			return
+		}
+		fired = true
+		require.NoError(t, db.Model(&types.KnowledgeTag{}).Where("id='span-nonmatch'").Update("name", "concurrent unselected candidate").Error)
+	}))
+	t.Cleanup(func() { _ = db.Callback().Query().Remove(name) })
+	actual, err := store.CaptureSpanOutputInputs(context.WithValue(context.Background(), autoSpanSnapshotPauseKey{}, true), types.SpanOutputReadRequest{TenantID: 7, KnowledgeBaseID: "kb", KnowledgeID: k.ID, Attempt: 1})
+	require.NoError(t, err)
+	require.True(t, fired)
+	require.Equal(t, before.Receipt, actual.Receipt)
+	require.Equal(t, "complete", actual.Rows[1].ContentProvenance)
+	require.Error(t, store.RecheckSpanOutputInputs(context.Background(), actual), "one RR snapshot keeps the original span body/additional receipts coherent; the final checkpoint rejects committed unselected input mutation")
+}
