diff --git a/internal/types/rag_source_lineage.go b/internal/types/rag_source_lineage.go
new file mode 100644
index 0000000000000000000000000000000000000000..2d988d8b7fd623b363284c1c473411e4a9531fb8
--- /dev/null
+++ b/internal/types/rag_source_lineage.go
@@ -0,0 +1,115 @@
+package types
+
+import (
+	"context"
+	"sync"
+)
+
+type ragLineageContextKey struct{}
+
+// RAGSourceLineage is a request-local accumulator for accounted ordinary RAG
+// adapters. It is shared by parallel readers and never serialized or supplied
+// to a model. A model response inherits the union of all earlier inputs.
+type RAGSourceLineage struct {
+	mu        sync.Mutex
+	lineage   *SourceLineage
+	revision  uint64
+	authorize func(context.Context, *SourceLineage) error
+}
+
+func NewRAGSourceLineage(authorize func(context.Context, *SourceLineage) error) *RAGSourceLineage {
+	lineage, _ := NewCompleteSourceLineage()
+	return &RAGSourceLineage{lineage: lineage, authorize: authorize}
+}
+
+func WithRAGSourceLineage(ctx context.Context, turn *RAGSourceLineage) context.Context {
+	return context.WithValue(ctx, ragLineageContextKey{}, turn)
+}
+
+func RAGSourceLineageFromContext(ctx context.Context) *RAGSourceLineage {
+	if ctx == nil {
+		return nil
+	}
+	turn, _ := ctx.Value(ragLineageContextKey{}).(*RAGSourceLineage)
+	return turn
+}
+
+func (t *RAGSourceLineage) Add(inputs ...*SourceLineage) error {
+	if t == nil {
+		return ErrSourceLineageUnknown
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	var err error
+	before := t.lineage
+	t.lineage, err = UnionSourceLineage(append([]*SourceLineage{t.lineage}, inputs...)...)
+	if !sameRAGSourceLineage(before, t.lineage) {
+		t.revision++
+	}
+	return err
+}
+
+func sameRAGSourceLineage(a, b *SourceLineage) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	if a.Version != b.Version || a.State != b.State || len(a.Sources) != len(b.Sources) {
+		return false
+	}
+	for i := range a.Sources {
+		if a.Sources[i] != b.Sources[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func (t *RAGSourceLineage) Snapshot() *SourceLineage {
+	if t == nil {
+		return nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	copy, _ := UnionSourceLineage(t.lineage)
+	return copy
+}
+
+func (t *RAGSourceLineage) Check(ctx context.Context) error {
+	_, err := t.CheckedSnapshot(ctx)
+	return err
+}
+
+// CheckedSnapshot returns the exact envelope authorized by the callback. A
+// concurrent reader cannot add an unchecked source between check and emission.
+// Bounded retries fail closed rather than prolong an operation indefinitely.
+func (t *RAGSourceLineage) CheckedSnapshot(ctx context.Context) (*SourceLineage, error) {
+	if t == nil || t.authorize == nil {
+		return UnknownSourceLineage(), ErrSourceLineageUnknown
+	}
+	for attempt := 0; attempt < 32; attempt++ {
+		t.mu.Lock()
+		lineage, _ := UnionSourceLineage(t.lineage)
+		revision := t.revision
+		t.mu.Unlock()
+		if err := lineage.RequireComplete(); err != nil {
+			return UnknownSourceLineage(), err
+		}
+		if err := t.authorize(ctx, lineage); err != nil {
+			return UnknownSourceLineage(), err
+		}
+		t.mu.Lock()
+		stable := revision == t.revision
+		t.mu.Unlock()
+		if stable {
+			return lineage, nil
+		}
+	}
+	return UnknownSourceLineage(), ErrSourceLineageUnknown
+}
+
+// SourceIndependentDerivativesAllowed applies only to committed, accounted
+// source-independent answers. Source-aware passage/memory/suggestion adapters
+// are required before controlled or unknown answers may be copied there.
+func SourceIndependentDerivativesAllowed(message *Message) bool {
+	return message != nil && message.IsCompleted && message.SourceLineage.RequireComplete() == nil && len(message.SourceLineage.Sources) == 0
+}
diff --git a/internal/types/rag_source_lineage_test.go b/internal/types/rag_source_lineage_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bcecf490e0608e2d57a34eba684ffcfc3fd2ea18
--- /dev/null
+++ b/internal/types/rag_source_lineage_test.go
@@ -0,0 +1,83 @@
+package types
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+)
+
+func TestRAGSourceLineageConcurrentInputsPreserveUnknown(t *testing.T) {
+	ctx := context.Background()
+	turn := NewRAGSourceLineage(func(context.Context, *SourceLineage) error { return nil })
+	var wg sync.WaitGroup
+	for _, etag := range []string{"old", "new"} {
+		wg.Add(1)
+		go func(etag string) {
+			defer wg.Done()
+			proof, _ := NewCompleteSourceLineage(lineageTestIdentity("1", etag))
+			_ = turn.Add(proof)
+		}(etag)
+	}
+	wg.Wait()
+	if len(turn.Snapshot().Sources) != 2 || turn.Check(ctx) != nil {
+		t.Fatal("lost a real input generation")
+	}
+	snapshot := turn.Snapshot()
+	snapshot.Sources[0].ETag = "mutated"
+	if turn.Snapshot().Sources[0].ETag == "mutated" {
+		t.Fatal("prefix proof aliases the accumulator")
+	}
+	_ = turn.Add(nil)
+	if !errors.Is(turn.Check(ctx), ErrSourceLineageUnknown) {
+		t.Fatal("uncovered input was certified")
+	}
+	proof, _ := NewCompleteSourceLineage()
+	_ = turn.Add(proof)
+	if !errors.Is(turn.Check(ctx), ErrSourceLineageUnknown) {
+		t.Fatal("empty later input removed unknown")
+	}
+}
+
+func TestRAGSourceLineageUsesCurrentAuthorizationAtEveryBoundary(t *testing.T) {
+	revoked := false
+	denied := errors.New("revoked")
+	turn := NewRAGSourceLineage(func(context.Context, *SourceLineage) error {
+		if revoked {
+			return denied
+		}
+		return nil
+	})
+	ctx := WithRAGSourceLineage(context.Background(), turn)
+	if RAGSourceLineageFromContext(ctx) != turn || turn.Check(ctx) != nil {
+		t.Fatal("fresh accounted text failed")
+	}
+	revoked = true
+	if !errors.Is(turn.Check(ctx), denied) {
+		t.Fatal("prefix reused a previous grant")
+	}
+	if NewRAGSourceLineage(nil).Check(ctx) == nil {
+		t.Fatal("missing authorizer allowed a turn")
+	}
+}
+
+func TestRAGSourceLineageCheckedSnapshotReauthorizesConcurrentSourceAddition(t *testing.T) {
+	var turn *RAGSourceLineage
+	calls := 0
+	turn = NewRAGSourceLineage(func(_ context.Context, proof *SourceLineage) error {
+		calls++
+		if calls == 1 {
+			input, _ := NewCompleteSourceLineage(lineageTestIdentity("2", "etag"))
+			_ = turn.Add(input) // Commit a second input while the first check runs.
+			return nil
+		}
+		if len(proof.Sources) != 1 {
+			t.Fatal("new actual input was not checked")
+		}
+		return errors.New("second source revoked")
+	})
+	proof, err := turn.CheckedSnapshot(context.Background())
+	if err == nil || proof.RequireComplete() == nil || calls != 2 {
+		t.Fatal("published an unchecked added source")
+	}
+}
