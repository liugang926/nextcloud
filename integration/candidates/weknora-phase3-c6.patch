+
+// writeIndexRows keeps the lease fence, source-version check, vector insertion,
+// and any late exact-ID GC inventory in one PostgreSQL transaction. A write
+// cannot commit after the source transition has retired its generation.
+func (g *pgRepository) writeIndexRows(ctx context.Context, infos []*types.IndexInfo,
+	rows []*pgVector, ignoreConflicts bool,
+) error {
+	return g.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		scopes, err := g.guardNextcloudVectorWrites(ctx, tx, infos)
+		if err != nil {
+			return err
+		}
+		insert := tx
+		if ignoreConflicts {
+			insert = insert.Clauses(clause.OnConflict{DoNothing: true})
+		}
+		if err := insert.Create(rows).Error; err != nil {
+			return err
+		}
+		for _, scope := range scopes {
+			var written []*pgVector
+			if err := tx.Where("knowledge_base_id=? AND knowledge_id=? AND source_id IN ?", scope.kbID, scope.knowledgeID, scope.sourceIDs).Find(&written).Error; err != nil {
+				return err
+			}
+			uniqueSources := map[string]bool{}
+			for _, id := range scope.sourceIDs {
+				uniqueSources[id] = true
+			}
+			if len(written) != len(uniqueSources) {
+				return apprepo.ErrNextcloudContentLeaseDenied
+			}
+			for _, row := range written {
+				if err := apprepo.RecordNextcloudDerivedArtifactInTx(ctx, tx, row.KnowledgeID, row.KnowledgeBaseID, "postgres_embedding", strconv.FormatUint(uint64(row.ID), 10), int64(row.Dimension)); err != nil {
+					return err
+				}
+			}
+			if err := g.inventoryNextcloudVectorIDs(tx, scope); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
