+	revoked := false
+	a.checker = outputCheckerFunc(func(context.Context, *types.SourceLineage, access.LineageReadScope) error {
+		if revoked {
+			return access.ErrNextcloudPublicationDenied
+		}
+		return nil
+	})
+	guard, err := a.Begin(context.Background(), []*types.Knowledge{row})
