+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+func nextcloudEndpointTestConfig(t *testing.T, baseURL, token string) types.JSON {
+	t.Helper()
+	config := map[string]interface{}{
+		"type":         types.ConnectorTypeNextcloud,
+		"settings":     map[string]interface{}{"base_url": baseURL},
+		"resource_ids": []string{"dev-published"},
+		"credentials":  map[string]interface{}{},
+	}
+	if token != "" {
+		config["credentials"] = map[string]interface{}{"token": token}
+	}
+	encoded, err := json.Marshal(config)
+	require.NoError(t, err)
+	return types.JSON(encoded)
+}
+
+func TestNextcloudCredentialAndEndpointUpdatesCannotCombineAcrossStaleWriters(t *testing.T) {
+	db := provenanceTestDB(t)
+	require.NoError(t, db.Exec("INSERT INTO knowledge_bases (id, tenant_id) VALUES ('kb', 7)").Error)
+	repo := NewDataSourceRepository(db)
+	ctx := context.Background()
+	base := "https://trusted.example"
+	old := &types.DataSource{ID: "paired", TenantID: 7, KnowledgeBaseID: "kb",
+		Type: types.ConnectorTypeNextcloud, Config: nextcloudEndpointTestConfig(t, base, "private-token")}
+	require.NoError(t, repo.Create(ctx, old))
+
+	update := func(updateCtx context.Context, url, token string) error {
+		return repo.Update(updateCtx, &types.DataSource{ID: old.ID, TenantID: old.TenantID,
+			KnowledgeBaseID: old.KnowledgeBaseID, Type: old.Type,
+			Config: nextcloudEndpointTestConfig(t, url, token)})
+	}
+	storedURL := func() string {
+		t.Helper()
+		stored, err := repo.FindByID(ctx, old.ID)
+		require.NoError(t, err)
+		parsed, err := stored.ParseConfig()
+		require.NoError(t, err)
+		value, _ := parsed.Settings["base_url"].(string)
+		return value
+	}
+
+	require.ErrorContains(t, update(ctx, "https://attacker.example", "private-token"), "base URL")
+	require.ErrorContains(t, update(ctx, "https://attacker.example", ""), "base URL")
+	require.Equal(t, base, storedURL())
+
+	// Clearing first permits a legitimate endpoint edit. A credential writer
+	// that read the old URL before this edit must then fail under the KB lock.
+	require.NoError(t, update(WithNextcloudCredentialWrite(ctx), base, ""))
+	require.NoError(t, update(ctx, base, "private-token"),
+		"a stale ordinary update should preserve the committed revocation")
+	staleResult, err := repo.FindByID(ctx, old.ID)
+	require.NoError(t, err)
+	staleConfig, err := staleResult.ParseConfig()
+	require.NoError(t, err)
+	require.Empty(t, staleConfig.Credentials, "stale ordinary PUT or sync status must not revive a token")
+	require.NoError(t, update(ctx, "https://attacker.example", ""))
+	require.ErrorContains(t, update(WithNextcloudCredentialWrite(ctx), base, "new-token"), "base URL")
+	require.Equal(t, "https://attacker.example", storedURL())
+	stored, err := repo.FindByID(ctx, old.ID)
+	require.NoError(t, err)
+	parsed, err := stored.ParseConfig()
+	require.NoError(t, err)
+	require.Empty(t, parsed.Credentials)
+	require.NotContains(t, strings.ToLower(string(stored.Config)), "new-token")
+}
diff --git a/internal/application/repository/nextcloud_derived_artifacts.go b/internal/application/repository/nextcloud_derived_artifacts.go
new file mode 100644
index 0000000000000000000000000000000000000000..d639c27fb209952c3d91ba136fece63fb0c8ecee
--- /dev/null
+++ b/internal/application/repository/nextcloud_derived_artifacts.go
@@ -0,0 +1,112 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/Tencent/WeKnora/internal/types"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"strconv"
+)
+
+type nextcloudDerivedArtifact struct {
+	TenantID                                          uint64 `gorm:"primaryKey"`
+	KnowledgeBaseID, KnowledgeID, ItemKind, ObjectRef string `gorm:"primaryKey"`
+	PlanSHA256, IdentitySHA256                        string
+	Dimension, WrittenAtMS                            int64
+}
+
+func (nextcloudDerivedArtifact) TableName() string { return "nextcloud_derived_write_artifacts" }
+
+// Called in the actual row-write transaction. The immutable identity ledger is
+// exhaustive for this protocol's supported local writers; historic rows cannot
+// be backfilled from a later config, empty scan, or garbage-collection attempt.
+func RecordNextcloudDerivedArtifactInTx(ctx context.Context, tx *gorm.DB, knowledgeID, kbID, kind, ref string, dimension int64) error {
+	if !tx.Migrator().HasTable(&nextcloudDerivedArtifact{}) {
+		return nil
+	}
+	var k types.Knowledge
+	e := tx.Unscoped().Where("id=? AND knowledge_base_id=?", knowledgeID, kbID).Take(&k).Error
+	if errors.Is(e, gorm.ErrRecordNotFound) {
+		return CheckNextcloudBuildIdentity(ctx, 0, "", "")
+	}
+	if e != nil {
+		return e
+	}
+	if k.Channel != types.ConnectorTypeNextcloud {
+		return nil
+	}
+	if ref == "" || !NextcloudBuildLeasePresent(ctx, k.TenantID, kbID, knowledgeID) {
+		return ErrNextcloudContentLeaseInvalid
+	}
+	if e = ValidateNextcloudBuildWrite(ctx, tx, k.TenantID, kbID, knowledgeID); e != nil {
+		return e
+	}
+	var plan nextcloudDerivedBackendPlan
+	if e = tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=?", k.TenantID, kbID, knowledgeID).Take(&plan).Error; e != nil {
+		return ErrNextcloudContentGCUncovered
+	}
+	var backend nextcloudBackendSelection
+	if recoverySHA([]byte(plan.BackendPlan)) != plan.PlanSHA256 || json.Unmarshal([]byte(plan.BackendPlan), &backend) != nil {
+		return ErrNextcloudContentLeaseDenied
+	}
+	if kind != "derived_chunk" {
+		expected := string(types.PostgresRetrieverEngineType)
+		if kind == "sqlite_embedding" {
+			expected = string(types.SQLiteRetrieverEngineType)
+		}
+		found := false
+		for _, v := range backend.Engines {
+			if v == expected {
+				found = true
+			}
+		}
+		if !found {
+			return ErrNextcloudContentLeaseDenied
+		}
+	}
+	identity := strconv.FormatUint(k.TenantID, 10) + "\x00" + kbID + "\x00" + knowledgeID + "\x00" + kind + "\x00" + ref + "\x00" + strconv.FormatInt(dimension, 10) + "\x00" + plan.PlanSHA256
+	now, e := nextcloudLeaseNowMS(tx)
+	if e != nil {
+		return e
+	}
+	artifact := nextcloudDerivedArtifact{TenantID: k.TenantID, KnowledgeBaseID: kbID, KnowledgeID: knowledgeID, ItemKind: kind, ObjectRef: ref, PlanSHA256: plan.PlanSHA256, IdentitySHA256: recoverySHA([]byte(identity)), Dimension: dimension, WrittenAtMS: now}
+	if e = tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&artifact).Error; e != nil {
+		return e
+	}
+	var actual nextcloudDerivedArtifact
+	if e = tx.Where("tenant_id=? AND knowledge_base_id=? AND knowledge_id=? AND item_kind=? AND object_ref=?", k.TenantID, kbID, knowledgeID, kind, ref).Take(&actual).Error; e != nil {
+		return e
+	}
+	if actual.IdentitySHA256 != artifact.IdentitySHA256 {
+		return ErrNextcloudContentLeaseDenied
+	}
+	return nil
+}
+
+// Cross-owner NC chunk pointers are not an ownership transfer. The immutable
+// writer ledger keeps this rejection effective even after the original row is
+// collected, preventing a late independent writer from reviving a stale ID.
+func guardNextcloudDerivedChunkReferences(tx *gorm.DB, chunks []*types.Chunk) error {
+	if !tx.Migrator().HasTable(&nextcloudDerivedArtifact{}) {
+		return nil
+	}
+	for _, chunk := range chunks {
+		for _, ref := range []string{chunk.ParentChunkID, chunk.PreChunkID, chunk.NextChunkID} {
+			if ref == "" {
+				continue
+			}
+			var owners []nextcloudDerivedArtifact
+			if e := tx.Where("item_kind='derived_chunk' AND object_ref=?", ref).Find(&owners).Error; e != nil {
+				return e
+			}
+			for _, owner := range owners {
+				if owner.TenantID != chunk.TenantID || owner.KnowledgeBaseID != chunk.KnowledgeBaseID || owner.KnowledgeID != chunk.KnowledgeID {
+					return ErrNextcloudContentLeaseDenied
+				}
+			}
+		}
+	}
+	return nil
+}
diff --git a/internal/application/repository/nextcloud_derived_backend_plan.go b/internal/application/repository/nextcloud_derived_backend_plan.go
new file mode 100644
index 0000000000000000000000000000000000000000..09f0a0a5f62dad52b6a5b9b21f49ff4049e78bef
