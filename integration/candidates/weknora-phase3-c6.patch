+type ragOriginTestProof struct{}
+
+func ragTestInputDigest(k *types.Knowledge, c *types.Chunk) string {
+	payload, _ := json.Marshal(struct {
+		Title    string
+		Metadata types.JSON
+		Chunk    *types.Chunk
+	}{k.Title, k.Metadata, c})
+	sum := sha256.Sum256(payload)
+	return hex.EncodeToString(sum[:])
+}
+
+func (ragOriginTestProof) ReadOrdinaryRAGInputLineage(ctx context.Context, tx *gorm.DB, k *types.Knowledge, c *types.Chunk) (*types.SourceLineage, error) {
+	var proof struct{ Digest string }
+	query := tx.WithContext(ctx).Table("rag_test_origin_proofs").Where("knowledge_id = ? AND chunk_id = ?", k.ID, c.ID).Take(&proof)
+	if query.Error == gorm.ErrRecordNotFound {
+		return types.UnknownSourceLineage(), nil
+	}
+	if query.Error != nil {
+		return nil, query.Error
+	}
+	if proof.Digest != ragTestInputDigest(k, c) {
+		return types.UnknownSourceLineage(), nil
+	}
+	return types.NewCompleteSourceLineage()
+}
