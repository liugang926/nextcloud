+	h, a, db, k, _, tracker, ctx := spanHTTPFixture(t)
+	root, attempt, err := tracker.OpenAttempt(context.Background(), k.ID, "SECRET legacy trace link")
+	require.NoError(t, err)
+	stage := tracker.BeginStage(context.Background(), k.ID, attempt, types.StagePostProcess, types.JSONMap{"body": "SECRET legacy input"})
+	child := tracker.BeginSubSpan(context.Background(), stage, "SECRET dynamic span name", types.SpanKindGeneration, types.JSONMap{"body": "SECRET legacy child input"})
+	tracker.FailSpan(ctx, child, "SECRET legacy error code", "SECRET legacy error message", nil)
