+	require.Equal(t, http.StatusOK, w.Code, w.Body.String())
+	require.Contains(t, w.Body.String(), result.Content)
+	require.Zero(t, knowledge.checks.Load())
+	require.Equal(t, "local_value", result.Metadata["local_key"])
+}
