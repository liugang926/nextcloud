+				signedNextcloudEventRequestWithKey(t, credential.Secret, credential.KeyID,
+					stale, strings.Repeat("b", 32))).Code)
+			require.NoError(t, db.Exec(`UPDATE nextcloud_event_dispatch SET state = 'blocked',
