+	setCursor(now.Unix())
+	require.NoError(t, db.Exec(`UPDATE nextcloud_event_dispatch
+		SET state = 'queued', next_attempt_at = ? WHERE connection_id = 'event-connection'`,
+		now.Add(-time.Second)).Error)
