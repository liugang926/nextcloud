+package repository
+
+import (
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+	"github.com/stretchr/testify/require"
+)
+
+func nextcloudWithdrawalInventorySQLiteDB(t *testing.T) *sql.DB {
+	t.Helper()
+	db, err := sql.Open("sqlite3", "file:"+filepath.Join(t.TempDir(), "withdrawal.db")+"?_foreign_keys=on")
+	require.NoError(t, err)
+	db.SetMaxOpenConns(1)
+	t.Cleanup(func() { _ = db.Close() })
+	_, err = db.Exec(`CREATE TABLE nextcloud_source_pairings (operation_id TEXT PRIMARY KEY);
+		CREATE TABLE nextcloud_source_decommissions (pair_operation_id TEXT NOT NULL);
+		CREATE TABLE data_sources (id TEXT PRIMARY KEY, status TEXT NOT NULL);
+		INSERT INTO nextcloud_source_pairings (operation_id) VALUES ('pair');
+		INSERT INTO data_sources (id, status) VALUES ('ds', 'paused')`)
+	require.NoError(t, err)
+	script, err := os.ReadFile("../../../migrations/sqlite/000044_nextcloud_indexed_withdrawal.up.sql")
+	require.NoError(t, err)
+	_, err = db.Exec(string(script))
+	require.NoError(t, err)
+	_, err = db.Exec(`INSERT INTO nextcloud_indexed_withdrawals
+		(operation_id, pair_operation_id, tenant_id, knowledge_base_id,
+		 datasource_id, nextcloud_instance_id, binding_id, publication_epoch, key_id)
+		VALUES ('withdrawal', 'pair', 7, 'kb', 'ds', 'instance', 'binding', 1, 'key');
+		INSERT INTO nextcloud_indexed_withdrawal_items
+		(operation_id, kind, object_ref, knowledge_id)
+		VALUES ('withdrawal', 'source_version', 'source', 'current')`)
+	require.NoError(t, err)
+	return db
+}
+
+func TestSQLiteNextcloudWithdrawalRevisionInventoryMigration(t *testing.T) {
+	for _, keepRevision := range []bool{false, true} {
+		t.Run(map[bool]string{false: "reversible_empty", true: "retained_revision"}[keepRevision],
+			func(t *testing.T) {
+				db := nextcloudWithdrawalInventorySQLiteDB(t)
+				up, err := os.ReadFile("../../../migrations/sqlite/000048_nextcloud_withdrawal_revision_inventory.up.sql")
+				require.NoError(t, err)
+				_, err = db.Exec(string(up))
+				require.NoError(t, err)
+				var count int
+				require.NoError(t, db.QueryRow(`SELECT COUNT(*) FROM nextcloud_indexed_withdrawal_items
+					WHERE operation_id = 'withdrawal' AND kind = 'source_version'
+					AND object_ref = 'source' AND knowledge_id = 'current'`).Scan(&count))
+				require.Equal(t, 1, count, "the old inventory must survive the table rebuild")
+				_, err = db.Exec(`UPDATE nextcloud_indexed_withdrawal_items SET knowledge_id = 'forged'
+					WHERE operation_id = 'withdrawal'`)
+				require.ErrorContains(t, err, "nextcloud_indexed_withdrawal_item_immutable")
+				if keepRevision {
+					_, err = db.Exec(`INSERT INTO nextcloud_indexed_withdrawal_items
+						(operation_id, kind, object_ref, knowledge_id)
+						VALUES ('withdrawal', 'source_revision', '["source",2]', 'old-copy')`)
+					require.NoError(t, err)
+				}
+				down, err := os.ReadFile("../../../migrations/sqlite/000048_nextcloud_withdrawal_revision_inventory.down.sql")
+				require.NoError(t, err)
+				_, err = db.Exec(string(down))
+				if keepRevision {
+					require.Error(t, err, "observed revisions must block a destructive downgrade")
+					require.NoError(t, db.QueryRow(`SELECT COUNT(*) FROM nextcloud_indexed_withdrawal_items
+						WHERE kind = 'source_revision'`).Scan(&count))
+					require.Equal(t, 1, count)
+					return
+				}
+				require.NoError(t, err)
+				_, err = db.Exec(`INSERT INTO nextcloud_indexed_withdrawal_items
+					(operation_id, kind, object_ref, knowledge_id)
+					VALUES ('withdrawal', 'source_revision', '["source",2]', 'old-copy')`)
+				require.Error(t, err, "the old schema must reject the new inventory kind")
+				require.NoError(t, db.QueryRow(`SELECT COUNT(*) FROM nextcloud_indexed_withdrawal_items
+					WHERE kind = 'source_version'`).Scan(&count))
+				require.Equal(t, 1, count)
+			})
+	}
+}
diff --git a/internal/application/repository/rag_chunk_snapshot.go b/internal/application/repository/rag_chunk_snapshot.go
new file mode 100644
index 0000000000000000000000000000000000000000..bec97fcb1ac714c2f7cb63b491e1c3a7341be4c0
--- /dev/null
+++ b/internal/application/repository/rag_chunk_snapshot.go
@@ -0,0 +1,251 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"math"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+	"gorm.io/gorm"
+)
+
+// RAGChunkReadRequest identifies server-resolved rows, never supplied text.
+// Lease is the original exact read lease held before content hydration.
+// ExpectedLineage is required when augmenting an already captured result.
+type RAGChunkReadRequest = types.RAGChunkReadRequest
+type RAGChunkInputSnapshot = types.RAGChunkInputSnapshot
+
+// OrdinaryRAGInputProofLookup is a trusted server dependency. Implementations
+// must read persisted producer provenance in tx and bind it to these exact
+// content/metadata rows (including their revision or digest). Request fields,
+// channel, absence of a source and current history-KB settings are not proof.
+// Missing legacy or orphan derivative provenance remains unknown.
+type OrdinaryRAGInputProofLookup interface {
+	ReadOrdinaryRAGInputLineage(context.Context, *gorm.DB, *types.Knowledge, *types.Chunk) (*types.SourceLineage, error)
+}
+
+type ControlledRAGInputProofLookup interface {
+	ReadControlledRAGInputLineage(context.Context, *gorm.DB, *types.Knowledge, *types.Chunk, *types.SourceLineage) (*types.SourceLineage, error)
+}
+
+type RAGChunkSnapshotLookup = interfaces.RAGChunkSnapshotReader
+
+type RAGChunkSnapshotReader struct {
+	db       *gorm.DB
+	ordinary OrdinaryRAGInputProofLookup
+}
+
+func NewRAGChunkSnapshotReader(db *gorm.DB, ordinary OrdinaryRAGInputProofLookup) *RAGChunkSnapshotReader {
+	return &RAGChunkSnapshotReader{db: db, ordinary: ordinary}
+}
+
+// HydrateRAGChunkSnapshots reloads the actual material and original source
+// identity in one snapshot. An index result supplies IDs/scores only; its text
+// can never receive the current publication's identity through this API.
+// The caller still authorizes current grants/publication and verifies leases
+// after hydration and before every model/output boundary.
+func (r *RAGChunkSnapshotReader) HydrateRAGChunkSnapshots(ctx context.Context, requests []RAGChunkReadRequest) ([]RAGChunkInputSnapshot, error) {
+	if ctx == nil || r == nil || r.db == nil {
+		return nil, ErrNextcloudLineageSnapshotStore
+	}
+	if len(requests) > types.SourceLineageMaxSources {
+		return nil, types.ErrSourceLineageLimit
+	}
+	if len(requests) == 0 {
+		return []RAGChunkInputSnapshot{}, nil
+	}
+	options := &sql.TxOptions{ReadOnly: true}
+	switch r.db.Dialector.Name() {
+	case "postgres":
+		options.Isolation = sql.LevelRepeatableRead
+	case "sqlite":
+	default:
+		return nil, ErrNextcloudLineageSnapshotStore
+	}
+	// GORM nested Transaction uses a savepoint and ignores TxOptions. A caller's
+	// weaker transaction cannot silently remove this reader's snapshot contract.
+	if _, nested := r.db.Statement.ConnPool.(gorm.TxCommitter); nested {
+		return nil, ErrNextcloudLineageSnapshotStore
+	}
+	var out []RAGChunkInputSnapshot
+	err := r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		resolver := &knowledgeRepository{db: tx}
+		seen := map[string]bool{}
+		for _, request := range requests {
+			if request.TenantID == 0 || request.TenantID > math.MaxInt64 || request.KnowledgeBaseID == "" || request.KnowledgeID == "" || (len(request.ChunkIDs) == 0 && !request.MetadataOnly) || (len(request.ChunkIDs) != 0 && request.MetadataOnly) {
+				return ErrNextcloudLineageSnapshotDenied
+			}
+			var knowledge types.Knowledge
+			if err := tx.Where("id = ? AND tenant_id = ? AND knowledge_base_id = ?", request.KnowledgeID, request.TenantID, request.KnowledgeBaseID).Take(&knowledge).Error; err != nil {
+				return lineageSnapshotReadError(err)
+			}
+			if !request.MetadataOnly && (knowledge.ParseStatus != types.ParseStatusCompleted || knowledge.EnableStatus != "enabled") {
+				return ErrNextcloudLineageSnapshotDenied
+			}
+			var kb types.KnowledgeBase
+			if err := tx.Select("id", "tenant_id", "deleted_at").Where("id = ? AND tenant_id = ?", request.KnowledgeBaseID, request.TenantID).Take(&kb).Error; err != nil {
+				return lineageSnapshotReadError(err)
+			}
+			controlled, err := ragKnowledgeIsControlled(tx, &knowledge)
+			if err != nil {
+				return err
+			}
+			var sourceLineage *types.SourceLineage
+			if controlled {
+				current, identity, err := resolver.resolveNextcloudSourceLineageInTx(tx, request.TenantID, request.KnowledgeBaseID, request.KnowledgeID)
+				if err != nil {
+					return err
+				}
+				if err := verifyRAGExactLease(tx, request, identity); err != nil {
+					return err
+				}
+				knowledge = *current
+				sourceLineage, err = types.NewCompleteSourceLineage(identity)
+				if err != nil {
+					return err
+				}
+				if request.ExpectedLineage != nil {
+					if request.ExpectedLineage.RequireComplete() != nil {
+						return types.ErrSourceLineageUnknown
+					}
+					originalFound := false
+					for _, original := range request.ExpectedLineage.Sources {
+						if original.TenantID == identity.TenantID && original.KnowledgeBaseID == identity.KnowledgeBaseID && original.KnowledgeID == identity.KnowledgeID {
+							if original != identity {
+								return ErrNextcloudLineageSnapshotDenied
+							}
+							originalFound = true
+						}
+					}
+					if !originalFound {
+						return ErrNextcloudLineageSnapshotDenied
+					}
+				}
+			}
+			chunkIDs := request.ChunkIDs
+			if request.MetadataOnly {
+				chunkIDs = []string{""}
+			}
+			for _, id := range chunkIDs {
+				var chunk *types.Chunk
+				if !request.MetadataOnly {
+					if id == "" || seen[id] {
+						return ErrNextcloudLineageSnapshotDenied
+					}
+					seen[id] = true
+					if len(seen) > 4096 {
+						return types.ErrSourceLineageLimit
+					}
+					chunk = &types.Chunk{}
+					if err := tx.Where("id = ? AND tenant_id = ? AND knowledge_base_id = ? AND knowledge_id = ?", id, request.TenantID, request.KnowledgeBaseID, request.KnowledgeID).Take(chunk).Error; err != nil {
+						return lineageSnapshotReadError(err)
+					}
+					if !chunk.IsEnabled || chunk.IndexStatus == "processing" || chunk.IndexStatus == "failed" {
+						return ErrNextcloudLineageSnapshotDenied
+					}
+				}
+				lineage := sourceLineage
+				if controlled && r.ordinary != nil {
+					proof, ok := r.ordinary.(ControlledRAGInputProofLookup)
+					if !ok {
+						lineage = types.UnknownSourceLineage()
+					} else {
+						var err error
+						lineage, err = proof.ReadControlledRAGInputLineage(ctx, tx, &knowledge, chunk, sourceLineage)
+						if err != nil {
+							return err
+						}
+						if lineage == nil {
+							lineage = types.UnknownSourceLineage()
+						}
+						if err := lineage.Validate(); err != nil {
+							return err
+						}
+					}
+				}
+				if !controlled {
+					lineage = types.UnknownSourceLineage()
+					if r.ordinary != nil {
+						var err error
+						lineage, err = r.ordinary.ReadOrdinaryRAGInputLineage(ctx, tx, &knowledge, chunk)
+						if err != nil {
+							return err
+						}
+						if lineage == nil {
+							lineage = types.UnknownSourceLineage()
+						}
+						if err := lineage.Validate(); err != nil {
+							return err
+						}
+					}
+				}
+				if request.ExpectedLineage != nil {
+					var err error
+					lineage, err = types.UnionSourceLineage(request.ExpectedLineage, lineage)
+					if err != nil {
+						return err
+					}
+				}
+				copyLineage, err := types.UnionSourceLineage(lineage)
+				if err != nil {
+					return err
+				}
+				copyKnowledge := knowledge
+				out = append(out, RAGChunkInputSnapshot{Knowledge: &copyKnowledge, Chunk: chunk, SourceLineage: copyLineage})
+			}
+		}
+		return nil
+	}, options)
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func ragKnowledgeIsControlled(tx *gorm.DB, knowledge *types.Knowledge) (bool, error) {
+	var metadata map[string]json.RawMessage
+	if len(knowledge.Metadata) != 0 {
+		if err := json.Unmarshal(knowledge.Metadata, &metadata); err != nil {
+			return false, ErrNextcloudLineageSnapshotDenied
+		}
+	}
+	if knowledge.Channel == types.ConnectorTypeNextcloud || metadata["nextcloud_instance_id"] != nil || metadata["nextcloud_binding_id"] != nil || metadata["nextcloud_file_id"] != nil {
+		return true, nil
+	}
+	// An erased channel/metadata marker must not recertify a retained source row
+	// as ordinary. This is exact-document positive evidence, not a never proof.
+	var versions, revisions int64
+	if err := tx.Table("nextcloud_source_versions").Where("candidate_knowledge_id = ?", knowledge.ID).Count(&versions).Error; err != nil {
+		return false, lineageSnapshotReadError(err)
+	}
+	if err := tx.Table("nextcloud_source_revisions").Where("candidate_knowledge_id = ?", knowledge.ID).Count(&revisions).Error; err != nil {
+		return false, lineageSnapshotReadError(err)
+	}
+	return versions > 0 || revisions > 0, nil
+}
+
+func verifyRAGExactLease(tx *gorm.DB, request RAGChunkReadRequest, identity types.SourceIdentity) error {
+	lease := request.Lease
+	if lease == nil || lease.ID == "" || lease.OwnerID == "" || lease.Kind != string(NextcloudContentReadLease) || lease.Epoch <= 0 ||
+		lease.TenantID != request.TenantID || lease.KnowledgeBaseID != request.KnowledgeBaseID || lease.KnowledgeID != request.KnowledgeID || uint64(lease.Epoch) != identity.Revision {
+		return ErrNextcloudContentLeaseDenied
+	}
+	var row nextcloudContentLeaseRow
+	if err := tx.Where("lease_id = ?", lease.ID).Take(&row).Error; err != nil {
+		return lineageSnapshotReadError(err)
+	}
+	nowMS, err := nextcloudLeaseNowMS(tx)
+	if err != nil {
+		return fmt.Errorf("%w: lease clock", ErrNextcloudLineageSnapshotStore)
+	}
+	if row.TenantID != lease.TenantID || row.KnowledgeBaseID != lease.KnowledgeBaseID || row.KnowledgeID != lease.KnowledgeID ||
+		row.Kind != string(lease.Kind) || row.OwnerID != lease.OwnerID || row.Epoch != lease.Epoch || row.ReleasedAtMS != nil || row.ExpiresAtMS <= nowMS {
+		return ErrNextcloudContentLeaseDenied
+	}
+	return nil
+}
+
+var _ RAGChunkSnapshotLookup = (*RAGChunkSnapshotReader)(nil)
