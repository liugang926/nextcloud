+			child := startOriginalSpan(t, repo, ctx, k.ID, 1, "child", root.SpanID, types.SpanKindGeneration)
+			finishOriginalSpan(t, repo, ctx, child)
+			saved := captureOriginalSpans(t, store, k, 1)
+			switch mode {
+			case "span body":
+				require.NoError(t, db.Exec("UPDATE knowledge_processing_spans SET error_message='changed' WHERE span_id='child'").Error)
+				require.NoError(t, db.Exec("UPDATE knowledge_processing_spans SET error_message='original error body' WHERE span_id='child'").Error)
+			case "chunk input":
+				require.NoError(t, db.Model(&types.Chunk{}).Where("id = ?", c.ID).Update("content", "changed").Error)
+				require.NoError(t, db.Model(&types.Chunk{}).Where("id = ?", c.ID).Update("content", c.Content).Error)
+			case "chunk metadata":
+				require.NoError(t, db.Model(&types.Chunk{}).Where("id = ?", c.ID).Update("metadata", types.JSON(`{"source":"changed"}`)).Error)
+				require.NoError(t, db.Model(&types.Chunk{}).Where("id = ?", c.ID).Update("metadata", c.Metadata).Error)
+			case "parser controls":
+				require.NoError(t, db.Exec("UPDATE knowledge_bases SET summary_model_id='changed' WHERE id='kb'").Error)
+				require.NoError(t, db.Exec("UPDATE knowledge_bases SET summary_model_id='summary' WHERE id='kb'").Error)
+			case "input artifact":
+				require.NoError(t, db.Model(&types.Knowledge{}).Where("id = ?", k.ID).Update("metadata", types.JSON(`{"manual":{"content":"changed"}}`)).Error)
+				require.NoError(t, db.Model(&types.Knowledge{}).Where("id = ?", k.ID).Update("metadata", k.Metadata).Error)
+			case "tuple":
+				require.NoError(t, db.Exec("UPDATE knowledge_processing_spans SET parent_span_id='other-attempt' WHERE span_id='child'").Error)
+			}
+			require.Error(t, store.RecheckSpanOutputInputs(context.Background(), saved))
+			actual, err := store.CaptureSpanOutputInputs(context.Background(), types.SpanOutputReadRequest{TenantID: 7, KnowledgeBaseID: k.KnowledgeBaseID, KnowledgeID: k.ID, Attempt: 1})
+			if mode == "span body" || mode == "tuple" {
+				require.NoError(t, err)
+				require.Equal(t, "unknown", actual.Rows[1].ContentProvenance)
+				require.Empty(t, actual.Rows[1].Input)
+				require.Empty(t, actual.Rows[1].Output)
+				require.Empty(t, actual.Rows[1].ErrorMessage)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+}
