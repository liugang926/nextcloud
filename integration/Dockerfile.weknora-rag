FROM weknora-ldap-app:rag-pdf-builtin-59671fac
ARG WEKNORA_SOURCE_COMMIT
ARG WEKNORA_PATCH_SHA
ARG WEKNORA_REVISION
LABEL org.opencontainers.image.revision="${WEKNORA_SOURCE_COMMIT}" \
      io.github.liugang926.weknora.nextcloud-patch-sha256="${WEKNORA_PATCH_SHA}"
ENV WEKNORA_BUILD_COMMIT="${WEKNORA_REVISION}"

# Keep the binary and migrations from the same patched source snapshot.
RUN rm -rf /app/migrations
COPY nextcloud-integration-bin /app/WeKnora
COPY migrations/ /app/migrations/
